test_lun_slot_conflict_refused() {
    reset_mocks
    live_restored_empty
    register_pools_with_map
    # A different backstore already holds threeamigos LUN 0 live.
    _mock_backstores=$(bs_line vm-999-disk-0 /dev/zvol/threeamigos/proxmox/vm-999-disk-0)$'\n'
    _mock_luns_1=$(lun_line 0 vm-999-disk-0)
    _mock_zvols_threeamigos+=("threeamigos/proxmox/vm-999-disk-0")
    assume_yes=true
    test_start "LUN slot held by another backstore is refused, never remapped"

    run_main
    local tlog hlog
    tlog=$(targetcli_log_content)
    hlog=$(helper_log_content)

    local ok=true
    [[ "$_main_rc" -eq 1 ]] || ok=false
    log_has "LUN 0 on threeamigos is held by vm-999-disk-0" || ok=false
    [[ "$tlog" != *"/backstores/block create vm-101-disk-0"* ]] || ok=false
    # The healthy nvme1 item still reconciles.
    [[ "$tlog" == *"/backstores/block create vm-205-disk-3"* ]] || ok=false
    # Partial reconcile: pool map preserved, no refresh.
    log_has "Pool LUN map left unchanged" || ok=false
    [[ "$hlog" != *"export"* ]] || ok=false
    # The VM ref for the refused item is reported with map identity.
    log_has "VM 101 (testvm) scsi0 references threeamigos LUN 0" || ok=false
    log_has "still missing (map: vm-101-disk-0; refused)" || ok=false

    if [[ "$ok" == true ]]; then
        test_pass
    else
        test_fail "rc=$_main_rc — conflict not refused per item"
    fi
}

