vm_gather_cmd() { printf '%s\n' "${_mock_vm_records:-}"; }

# read_json_string_field spawns python3 per call; the reconcile suite calls
# it several times per run (newest-map discovery). The python original is
# covered by test-export-iscsi-state — use an equivalent awk reader here to
# keep this suite inside the time budget.
read_json_string_field() {
    local file="$1" field="$2"
    [[ -f "$file" ]] || return 0
    awk -v f="\"${field}\":" '
        {
            line = $0
            sub(/^[[:space:]]*/, "", line)
            if (index(line, f) == 1) {
                val = substr(line, length(f) + 1)
                sub(/^[[:space:]]*/, "", val)
                gsub(/^"|"$/, "", val)
                print val
                exit
            }
        }' "$file"
}

# ------------------------------------------------------------------
# Fixtures
# ------------------------------------------------------------------
_scratch_root=""
_helper_log=""
_manifest_file=""
_encrypted_file=""
_mock_vm_records=""
_helper_scripts=()

bs_line() { printf '  o- %s ........ [%s (1.0GiB) write-thru activated]' "$1" "$2"; }
lun_line() { printf '  | o- lun%s  [block/%s (/dev/zvol/x) (default_tg_pt_gp)]' "$1" "$2"; }

# Live topology after a bare-metal restore: targets exist, nothing exported.
live_restored_empty() {
    _mock_backstores=""
    _mock_luns_1=""
    _mock_luns_2=""
    _mock_acls_1=""
    _mock_acls_2=""
    _mock_iscsi_ls=$'o- iscsi ............ [Targets: 2]\n  o- '"${IQN1}"$' [TPGs: 1]\n  o- '
    _mock_iscsi_ls+="${IQN2}"
    _mock_iscsi_ls+=$' [TPGs: 1]'
}

# Live topology matching the map exactly.
live_healthy() {
    live_restored_empty
    local b1 b2
    b1=$(bs_line vm-101-disk-0 /dev/zvol/threeamigos/proxmox/vm-101-disk-0)
    b2=$(bs_line vm-205-disk-3 /dev/zvol/NVME1/proxmox/vm-205-disk-3)
    _mock_backstores="${b1}"$'\n'"${b2}"$'\n'
    _mock_luns_1=$(lun_line 0 vm-101-disk-0)
    _mock_luns_2=$(lun_line 5 vm-205-disk-3)
    _mock_acls_1="  o- ${INIT1} .......... [Mapped LUNs: 1]"
}

# The canonical two-target map (matching export-iscsi-state's format),
# rendered once and copied per use (host overrides swap one line).
render_base_map_json() {
    python3 - <<'PYEOF'
import json
m = {
    "version": 1,
    "generated": "2026-10-23T10:00:00+00:00",
    "host": "stewie",
    "iqn_prefix": "iqn.2026-02.local.stewie",
    "storage_ip": "192.168.100.1",
    "targets": {
        "iqn.2026-02.local.stewie:threeamigos": {
            "acls": ["iqn.2026-02.local.tweety"],
            "luns": {"0": "vm-101-disk-0"}},
        "iqn.2026-02.local.stewie:nvme1": {
            "acls": [],
            "luns": {"5": "vm-205-disk-3"}}},
    "backstores": {
        "vm-101-disk-0": {
            "dev": "/dev/zvol/threeamigos/proxmox/vm-101-disk-0",
            "target": "iqn.2026-02.local.stewie:threeamigos",
            "lun": 0},
        "vm-205-disk-3": {
            "dev": "/dev/zvol/NVME1/proxmox/vm-205-disk-3",
            "target": "iqn.2026-02.local.stewie:nvme1",
            "lun": 5}}}
print(json.dumps(m, indent=2))
PYEOF
}
_BASE_MAP_JSON=$(render_base_map_json)

write_base_map() {
    local dst="$1"
    if [[ "${MAP_HOST:-stewie}" == "stewie" ]]; then
        printf '%s\n' "$_BASE_MAP_JSON" > "$dst"
    else
        printf '%s\n' "$_BASE_MAP_JSON" | sed "s/\"host\": \"stewie\"/\"host\": \"${MAP_HOST}\"/" \
            > "$dst"
    fi
}

# Register both pools as online with a zfsutilities dataset + the base map.
register_pools_with_map() {
    _scratch_root=$(mktemp -d)
    local pool mnt
    for pool in threeamigos NVME1; do
        mnt="${_scratch_root}/${pool}"
        mkdir -p "$mnt"
        _mock_zfs_mountpoint["${pool}/zfsutilities"]="$mnt"
        write_base_map "${mnt}/iscsi-state.json"
    done
    _mock_zpool_list=$'threeamigos\nNVME1'
    _mock_zvols_threeamigos=("threeamigos/proxmox/vm-101-disk-0")
    _mock_zvols_nvme1=("NVME1/proxmox/vm-205-disk-3")
    _mock_vm_records=$(printf 'VM|threeamigos:0|101|testvm|scsi0\nVM|nvme1:5|205|archvm|scsi0')
}

# Create mock helper scripts (safe-iscsi-save / export-iscsi-state /
# rescan-storage) that log their invocation and the suppression env.
make_mock_helper() {
    local tag="$1"
    local p
    p=$(mktemp)
    {
        echo '#!/usr/bin/bash'
        echo "printf '%s\\n' '${tag}' >> '$_helper_log'"
        echo 'if [[ -n "${SAFE_ISCSI_SAVE_SKIP_EXPORT_ISCSI_STATE:-}" ]]; then' \
            "printf 'SUPPRESSED\\n' >> '$_helper_log'; fi"
    } > "$p"
    chmod +x "$p"
    printf '%s' "$p"
}

reset_mocks() {
    [[ -n "$_targetcli_log" && -f "$_targetcli_log" ]] && rm -f "$_targetcli_log"
    _targetcli_log=$(mktemp)
    local _old_helper_log="$_helper_log"
    _helper_log=$(mktemp)
    [[ -n "$_old_helper_log" && -f "$_old_helper_log" ]] && rm -f "$_old_helper_log"
    local _old
    for _old in "${_helper_scripts[@]:-}"; do
        rm -f "$_old"
    done
    _helper_scripts=()

    _targetcli_calls=()
    _mock_backstores=""
    _mock_iscsi_ls=""
    _mock_luns_1=""
    _mock_luns_2=""
    _mock_acls_1=""
    _mock_acls_2=""
    _mock_gen_acls_1="1"
    _mock_gen_acls_2="1"
    _mock_zfs_mountpoint=()
    _mock_encryption=()
    _mock_zvols_threeamigos=()
    _mock_zvols_nvme1=()
    _mock_zpool_list=""
    _mock_vm_records=""
    [[ -n "$_scratch_root" && -d "$_scratch_root" ]] && rm -rf "$_scratch_root"
    _scratch_root=""
    [[ -n "$_manifest_file" && -f "$_manifest_file" ]] && rm -f "$_manifest_file"
    [[ -n "$_encrypted_file" && -f "$_encrypted_file" ]] && rm -f "$_encrypted_file"
    _manifest_file=$(mktemp)
    _encrypted_file=$(mktemp)
    printf '# encrypted LUNs\n' > "$_encrypted_file"
    RECONCILE_ISCSI_STATE_MANIFEST="$_manifest_file"
    export ISCSI_ENCRYPTED_CONF="$_encrypted_file"
    local p
    p=$(make_mock_helper save); _helper_scripts+=("$p")
    RECONCILE_ISCSI_STATE_SAFE_ISCSI_SAVE="$p"
    p=$(make_mock_helper export); _helper_scripts+=("$p")
    RECONCILE_ISCSI_STATE_EXPORT_ISCSI_STATE="$p"
    p=$(make_mock_helper rescan); _helper_scripts+=("$p")
    RECONCILE_ISCSI_STATE_RESCAN_STORAGE="$p"
    dry_run=false
    assume_yes=false
    map_from=""
}

targetcli_log_content() {
    [[ -f "$_targetcli_log" ]] && cat "$_targetcli_log" || true
}

helper_log_content() {
    [[ -f "$_helper_log" ]] && cat "$_helper_log" || true
}

# Run main() capturing combined output. The script under test re-sources
# bin/bashinit when eval'd, which reinstates the real log_msg (stderr + long
# prefix), so assertions grep the captured output rather than the test log.
run_main() {
    _main_rc=0
    _main_out=$(main 2>&1) || _main_rc=$?
}

log_has() {
    [[ "$_main_out" == *"$1"* ]]
}

