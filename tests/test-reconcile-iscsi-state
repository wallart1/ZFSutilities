test_clean_restore() {
    reset_mocks
    live_restored_empty
    register_pools_with_map
    assume_yes=true
    test_start "Clean restore recreates backstores and LUNs at recorded numbers"

    run_main
    local tlog hlog
    tlog=$(targetcli_log_content)
    hlog=$(helper_log_content)

    local ok=true
    [[ "$_main_rc" -eq 0 ]] || ok=false
    local c1="/backstores/block create vm-101-disk-0" \
        c1d=" /dev/zvol/threeamigos/proxmox/vm-101-disk-0" \
        c2="/backstores/block create vm-205-disk-3" \
        c2d=" /dev/zvol/NVME1/proxmox/vm-205-disk-3" \
        m1="/iscsi/${IQN1}/tpg1/luns create /backstores/block/vm-101-disk-0 0" \
        m2="/iscsi/${IQN2}/tpg1/luns create /backstores/block/vm-205-disk-3 5"
    [[ "$tlog" == *"${c1}${c1d}"* ]] || ok=false
    [[ "$tlog" == *"${c2}${c2d}"* ]] || ok=false
    [[ "$tlog" == *"$m1"* ]] || ok=false
    [[ "$tlog" == *"$m2"* ]] || ok=false
    [[ "$tlog" == *"emulate_tpu=1"* ]] || ok=false
    # Manifest regenerated from the ensured set.
    grep -qxF "vm-101-disk-0" "$_manifest_file" || ok=false
    grep -qxF "vm-205-disk-3" "$_manifest_file" || ok=false
    # Finishes: save (hook suppressed), map refresh, rescan.
    [[ "$hlog" == *"save"* ]] || ok=false
    [[ "$hlog" == *"SUPPRESSED"* ]] || ok=false
    [[ "$hlog" == *"export"* ]] || ok=false
    [[ "$hlog" == *"rescan"* ]] || ok=false
    # Demo-mode ACL note (the threeamigos ACL missing live self-generates).
    log_has "demo-mode ACLs" || ok=false
    # Both VM refs resolve after the reconcile.
    log_has "still missing" && ok=false

    if [[ "$ok" == true ]]; then
        test_pass
    else
        test_fail "rc=$_main_rc — clean restore did not fully reconcile"
    fi
}

