#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154,SC2016,SC2028
# test-reconcile-iscsi-state — Unit tests for the map-driven LUN reconcile.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Mocks
# ------------------------------------------------------------------

IQN1="iqn.2026-02.local.stewie:threeamigos"
IQN2="iqn.2026-02.local.stewie:nvme1"
INIT1="iqn.2026-02.local.tweety"

# Mock node-lib.sh behavior
NODE_MODE="two-node"
storage_host="stewie"
compute_host="tweety"
storage_ip="192.168.100.1"
iqn_prefix="iqn.2026-02.local.stewie"
declare -A POOL_TARGET=(
    ["threeamigos"]="threeamigos"
    ["NVME1"]="nvme1"
)
is_single_node() { [[ "$NODE_MODE" == "single-node" ]]; }
is_two_node()    { [[ "$NODE_MODE" == "two-node" ]]; }
pool_to_target() {
    local pool="$1"
    local short="${POOL_TARGET[$pool]:-}"
    [[ -n "$short" ]] && echo "${iqn_prefix}:${short}"
}
pool_list() { printf '%s\n' "${!POOL_TARGET[@]}"; }
is_known_pool() { [[ -n "${POOL_TARGET[$1]:-}" ]]; }

# The evaluated script calls find_zfsutility_script to locate rootcheck;
# point node-lib at /dev/null (mocks above) and source the real lib parsers.
find_zfsutility_script() { echo "/dev/null"; }

# targetcli mock: query answers from the _mock_* fixtures, create calls
# captured to a log file (main() runs in a command-substitution subshell, so
# array updates would be lost) and applied to the fixtures so post-apply
# re-collection inside main() sees the new topology.
_targetcli_log=""
_targetcli_calls=()
_mock_backstores=""
_mock_iscsi_ls=""
_mock_luns_1=""
_mock_luns_2=""
_mock_acls_1=""
_mock_acls_2=""
_mock_gen_acls_1="1"
_mock_gen_acls_2="1"

targetcli() {
    [[ -n "$_targetcli_log" ]] && printf '%s\n' "$*" >> "$_targetcli_log"
    _targetcli_calls+=("$*")
    local args="$*"
    case "$args" in
        "/backstores/block ls")
            [[ -n "$_mock_backstores" ]] && printf '%s\n' "$_mock_backstores"
            ;;
        "/iscsi ls")
            [[ -n "$_mock_iscsi_ls" ]] && printf '%s\n' "$_mock_iscsi_ls"
            ;;
        "/iscsi/${IQN1}/tpg1/luns ls")
            [[ -n "$_mock_luns_1" ]] && printf '%s\n' "$_mock_luns_1"
            ;;
        "/iscsi/${IQN2}/tpg1/luns ls")
            [[ -n "$_mock_luns_2" ]] && printf '%s\n' "$_mock_luns_2"
            ;;
        "/iscsi/${IQN1}/tpg1/acls ls")
            [[ -n "$_mock_acls_1" ]] && printf '%s\n' "$_mock_acls_1"
            ;;
        "/iscsi/${IQN2}/tpg1/acls ls")
            [[ -n "$_mock_acls_2" ]] && printf '%s\n' "$_mock_acls_2"
            ;;
        "/iscsi/${IQN1}/tpg1 get attribute generate_node_acls")
            printf 'generate_node_acls=%s\n' "${_mock_gen_acls_1:-1}"
            ;;
        "/iscsi/${IQN2}/tpg1 get attribute generate_node_acls")
            printf 'generate_node_acls=%s\n' "${_mock_gen_acls_2:-1}"
            ;;
    esac

    # Create effects (mock fidelity: state must evolve like real targetcli).
    if [[ "$1" == "/backstores/block" && "$2" == "create" ]]; then
        _mock_backstores+="  o- ${3} ........ [${4} (1.0GiB) write-thru activated]"$'\n'
        return 0
    fi
    if [[ "$2" == "create" && "$1" == "/iscsi/${IQN1}/tpg1/luns" ]]; then
        _mock_luns_1+="  | o- lun${4}  [block/${3##*/} (/dev/zvol/x) (default_tg_pt_gp)]"$'\n'
        return 0
    fi
    if [[ "$2" == "create" && "$1" == "/iscsi/${IQN2}/tpg1/luns" ]]; then
        _mock_luns_2+="  | o- lun${4}  [block/${3##*/} (/dev/zvol/x) (default_tg_pt_gp)]"$'\n'
        return 0
    fi
    if [[ "$2" == "create" && "$1" == "/iscsi/${IQN1}/tpg1/acls" ]]; then
        _mock_acls_1+="  o- ${3} .......... [Mapped LUNs: 0]"$'\n'
        return 0
    fi
    if [[ "$2" == "create" && "$1" == "/iscsi/${IQN2}/tpg1/acls" ]]; then
        _mock_acls_2+="  o- ${3} .......... [Mapped LUNs: 0]"$'\n'
        return 0
    fi
    return 0
}

# ZFS mock: zvol discovery, state-dataset mountpoints, encryption property.
declare -A _mock_zfs_mountpoint=()
declare -A _mock_encryption=()
_mock_zvols_threeamigos=()
_mock_zvols_nvme1=()
_mock_zpool_list=""

zfs() {
    if [[ "$1" == "list" && "$2" == "-H" && "$3" == "-o" ]]; then
        if [[ "$5" == "-r" ]]; then
            case "$6" in
                threeamigos/proxmox) printf '%s\n' "${_mock_zvols_threeamigos[@]:-}" ;;
                NVME1/proxmox)       printf '%s\n' "${_mock_zvols_nvme1[@]:-}" ;;
            esac
            return 0
        fi
        if [[ "$4" == "mountpoint" ]]; then
            if [[ -n "${_mock_zfs_mountpoint[$5]:-}" ]]; then
                printf '%s\n' "${_mock_zfs_mountpoint[$5]}"
                return 0
            fi
            return 1
        fi
        return 0
    fi
    if [[ "$1" == "get" && "$2 $3 $4" == "-H -o value" && "$5" == "encryption" ]]; then
        printf '%s\n' "${_mock_encryption[$6]:-off}"
        return 0
    fi
    return 0
}

zpool() {
    [[ "$1 $2" == "list -Ho" ]] && printf '%s\n' "${_mock_zpool_list:-}"
    return 0
}

