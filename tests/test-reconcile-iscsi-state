    test_start "reconcile-iscsi-state sources with mocked dependencies"
    if declare -f main >/dev/null 2>&1 \
        && declare -f plan_reconciliation >/dev/null 2>&1 \
        && declare -f vm_cross_check >/dev/null 2>&1; then
        test_pass
    else
        test_fail "main/plan/cross-check functions should be defined after sourcing"
    fi
}

test_single_node_silent_exit() {
    test_start "Single-node mode exits silently at source time"
    local rc=0 out
    out=$( NODE_MODE="single-node" eval "$script_text" 2>/dev/null ) || rc=$?
    if [[ "$rc" -eq 0 && -z "$out" ]]; then
        test_pass
    else
        test_fail "Expected silent exit 0, got rc=$rc out='$out'"
    fi
}

