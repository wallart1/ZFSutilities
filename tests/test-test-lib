#!/usr/bin/bash
# test-test-lib — Verify test-lib.sh reporting helpers.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"


test_pass_counter_is_idempotent() {
    test_start "pass counter is idempotent"
    local result
    result=$(
        TESTS_PASSED=0
        { test_pass; test_pass; } >/dev/null 2>&1
        echo "$TESTS_PASSED"
    )
    assert_equals "1" "$result"
}


test_fail_counter_is_idempotent() {
    test_start "fail counter is idempotent"
    local result
    result=$(
        TESTS_FAILED=0
        { test_fail "first"; test_fail "second"; } >/dev/null 2>&1
        echo "$TESTS_FAILED"
    )
    assert_equals "1" "$result"
}


test_skip_counter_is_idempotent() {
    test_start "skip counter is idempotent"
    local result
    result=$(
        TESTS_SKIPPED=0
        { test_skip "first"; test_skip "second"; } >/dev/null 2>&1
        echo "$TESTS_SKIPPED"
    )
    assert_equals "1" "$result"
}


test_late_failure_counts_as_failure() {
    test_start "late failure after early pass counts as failure"
    local result
    result=$(
        TESTS_PASSED=0 TESTS_FAILED=0
        { test_start "inner"; test_pass; test_fail "oops"; } >/dev/null 2>&1
        echo "PASSED=$TESTS_PASSED FAILED=$TESTS_FAILED"
    )
    assert_equals "PASSED=0 FAILED=1" "$result"
}


# Run a child suite that sources test-lib.sh and reports its PID, so the
# parent can locate the child's per-PID /tmp artifacts. Prints "PID=<pid>".
_child_suite() {
    local libdir
    libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash -c "
        source '${libdir}/test-lib.sh'
        echo \"PID=\$\$\"
        $1
    " 2>&1
}

test_green_suite_removes_its_tmp_artifacts() {
    test_start "green suite removes its log and mock-state dir at exit"
    local out pid
    out=$(_child_suite 'test_summary')
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    if [[ ! -e "/tmp/zfsutilities-test-${pid}.log" \
          && ! -e "/tmp/mock_zfs_state_${pid}" ]]; then
        test_pass
    else
        test_fail "Artifacts for PID ${pid} were not removed at suite exit"
    fi
}

test_failed_suite_retains_log_but_removes_state_dir() {
    test_start "failed suite retains its log and removes the mock-state dir"
    local out pid
    out=$(_child_suite 'test_start "inner"; test_fail "boom"; test_summary')
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    local log="/tmp/zfsutilities-test-${pid}.log"
    if [[ -f "$log" && ! -e "/tmp/mock_zfs_state_${pid}" ]] \
        && grep -q "retained for post-mortem" <<<"$out"; then
        test_pass
    else
        test_fail "Failed suite should keep only its log (PID ${pid})"
    fi
    rm -f "$log"
}

test_suite_exit_status_preserved_through_cleanup() {
    test_start "suite exit status survives the EXIT cleanup trap"
    local out rc pid
    out=$(_child_suite 'exit 42')
    rc=$?
    # A suite exiting before test_summary counts as crashed, so its log is
    # retained by design; this test must reap that log itself.
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    rm -f "/tmp/zfsutilities-test-${pid}.log"
    assert_rc 42 "$rc"
}

test_source_reaps_orphaned_state_dirs() {
    test_start "sourcing test-lib reaps orphaned (dead-pid) state dirs"
    # A suite killed through an untrapped signal cannot run its EXIT-trap
    # cleanup; the next suite to source test-lib must reap that leftover.
    local dead_pid orphan out
    dead_pid=$(bash -c 'echo $$')
    orphan="/tmp/mock_zfs_state_${dead_pid}"
    mkdir -p "$orphan"
    : > "$orphan/marker"
    out=$(_child_suite 'test_summary')
    if [[ -e "$orphan" ]]; then
        rm -rf "$orphan"
        test_fail "Orphaned state dir for dead pid ${dead_pid} survived a" \
            "re-source. Child output: $out"
        return
    fi
    test_pass
}

test_source_keeps_live_suite_state_dirs() {
    test_start "the orphan sweep never removes a live suite's state dir"
    local libdir holder_log holder_pid inner_pid
    libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    holder_log="$(mktemp)"
    bash -c "
        source '${libdir}/test-lib.sh'
        echo \"\$\$\" > '${holder_log}'
        sleep 3
        exit 0
    " >/dev/null 2>&1 &
    holder_pid=$!
    for _ in $(seq 1 50); do
        [[ -s "$holder_log" ]] && break
        sleep 0.05
    done
    inner_pid="$(cat "$holder_log" 2>/dev/null || true)"
    if [[ -z "$inner_pid" ]]; then
        wait "$holder_pid" 2>/dev/null
        rm -f "$holder_log"
        test_fail "Holder suite never reported its pid"
        return
    fi
    # A second suite sourcing test-lib runs the sweep while the holder is
    # alive; the holder's dir must survive it and vanish only at its exit.
    _child_suite 'test_summary' >/dev/null
    if [[ ! -d "/tmp/mock_zfs_state_${inner_pid}" ]]; then
        kill "$holder_pid" 2>/dev/null
        wait "$holder_pid" 2>/dev/null
        rm -f "$holder_log"
        test_fail "Sweep removed the state dir of live suite pid ${inner_pid}"
        return
    fi
    wait "$holder_pid" 2>/dev/null
    # The holder exits without test_summary, so by design it retains its
    # (empty) log — reap it here like the exit-status test does.
    rm -f "/tmp/zfsutilities-test-${inner_pid}.log"
    if [[ -e "/tmp/mock_zfs_state_${inner_pid}" ]]; then
        rm -rf "/tmp/mock_zfs_state_${inner_pid}"
        rm -f "$holder_log"
        test_fail "Holder suite pid ${inner_pid} did not clean up its own dir"
        return
    fi
    rm -f "$holder_log"
    test_pass
}

test_pass_counter_is_idempotent
test_fail_counter_is_idempotent
test_skip_counter_is_idempotent
test_late_failure_counts_as_failure
test_green_suite_removes_its_tmp_artifacts
test_failed_suite_retains_log_but_removes_state_dir
test_suite_exit_status_preserved_through_cleanup
test_source_reaps_orphaned_state_dirs
test_source_keeps_live_suite_state_dirs

test_summary
