#!/usr/bin/bash
# test-test-lib — Verify test-lib.sh reporting helpers and the zfs mock's
# dataset-listing semantics (root filtering, receive persistence).

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"


test_pass_counter_is_idempotent() {
    test_start "pass counter is idempotent"
    local result
    result=$(
        TESTS_PASSED=0
        { test_pass; test_pass; } >/dev/null 2>&1
        echo "$TESTS_PASSED"
    )
    assert_equals "1" "$result"
}


test_fail_counter_is_idempotent() {
    test_start "fail counter is idempotent"
    local result
    result=$(
        TESTS_FAILED=0
        { test_fail "first"; test_fail "second"; } >/dev/null 2>&1
        echo "$TESTS_FAILED"
    )
    assert_equals "1" "$result"
}


test_skip_counter_is_idempotent() {
    test_start "skip counter is idempotent"
    local result
    result=$(
        TESTS_SKIPPED=0
        { test_skip "first"; test_skip "second"; } >/dev/null 2>&1
        echo "$TESTS_SKIPPED"
    )
    assert_equals "1" "$result"
}


test_late_failure_counts_as_failure() {
    test_start "late failure after early pass counts as failure"
    local result
    result=$(
        TESTS_PASSED=0 TESTS_FAILED=0
        { test_start "inner"; test_pass; test_fail "oops"; } >/dev/null 2>&1
        echo "PASSED=$TESTS_PASSED FAILED=$TESTS_FAILED"
    )
    assert_equals "PASSED=0 FAILED=1" "$result"
}


# Run a child suite that sources test-lib.sh and reports its PID, so the
# parent can locate the child's per-PID /tmp artifacts. Prints "PID=<pid>".
_child_suite() {
    local libdir
    libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    bash -c "
        source '${libdir}/test-lib.sh'
        echo \"PID=\$\$\"
        $1
    " 2>&1
}

test_green_suite_removes_its_tmp_artifacts() {
    test_start "green suite removes its log and mock-state dir at exit"
    local out pid
    out=$(_child_suite 'test_summary')
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    if [[ ! -e "/tmp/zfsutilities-test-${pid}.log" \
          && ! -e "/tmp/mock_zfs_state_${pid}" ]]; then
        test_pass
    else
        test_fail "Artifacts for PID ${pid} were not removed at suite exit"
    fi
}

test_failed_suite_retains_log_but_removes_state_dir() {
    test_start "failed suite retains its log and removes the mock-state dir"
    local out pid
    out=$(_child_suite 'test_start "inner"; test_fail "boom"; test_summary')
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    local log="/tmp/zfsutilities-test-${pid}.log"
    if [[ -f "$log" && ! -e "/tmp/mock_zfs_state_${pid}" ]] \
        && grep -q "retained for post-mortem" <<<"$out"; then
        test_pass
    else
        test_fail "Failed suite should keep only its log (PID ${pid})"
    fi
    rm -f "$log"
}

test_suite_exit_status_preserved_through_cleanup() {
    test_start "suite exit status survives the EXIT cleanup trap"
    local out rc pid
    out=$(_child_suite 'exit 42')
    rc=$?
    # A suite exiting before test_summary counts as crashed, so its log is
    # retained by design; this test must reap that log itself.
    pid=$(sed -n 's/^PID=//p' <<<"$out")
    rm -f "/tmp/zfsutilities-test-${pid}.log"
    assert_rc 42 "$rc"
}

test_source_reaps_orphaned_state_dirs() {
    test_start "sourcing test-lib reaps orphaned (dead-pid) state dirs"
    # A suite killed through an untrapped signal cannot run its EXIT-trap
    # cleanup; the next suite to source test-lib must reap that leftover.
    local dead_pid orphan out
    dead_pid=$(bash -c 'echo $$')
    orphan="/tmp/mock_zfs_state_${dead_pid}"
    mkdir -p "$orphan"
    : > "$orphan/marker"
    out=$(_child_suite 'test_summary')
    if [[ -e "$orphan" ]]; then
        rm -rf "$orphan"
        test_fail "Orphaned state dir for dead pid ${dead_pid} survived a" \
            "re-source. Child output: $out"
        return
    fi
    test_pass
}

test_source_keeps_live_suite_state_dirs() {
    test_start "the orphan sweep never removes a live suite's state dir"
    local libdir holder_log holder_pid inner_pid
    libdir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    holder_log="$(mktemp)"
    bash -c "
        source '${libdir}/test-lib.sh'
        echo \"\$\$\" > '${holder_log}'
        sleep 3
        exit 0
    " >/dev/null 2>&1 &
    holder_pid=$!
    for _ in $(seq 1 50); do
        [[ -s "$holder_log" ]] && break
        sleep 0.05
    done
    inner_pid="$(cat "$holder_log" 2>/dev/null || true)"
    if [[ -z "$inner_pid" ]]; then
        wait "$holder_pid" 2>/dev/null
        rm -f "$holder_log"
        test_fail "Holder suite never reported its pid"
        return
    fi
    # A second suite sourcing test-lib runs the sweep while the holder is
    # alive; the holder's dir must survive it and vanish only at its exit.
    _child_suite 'test_summary' >/dev/null
    if [[ ! -d "/tmp/mock_zfs_state_${inner_pid}" ]]; then
        kill "$holder_pid" 2>/dev/null
        wait "$holder_pid" 2>/dev/null
        rm -f "$holder_log"
        test_fail "Sweep removed the state dir of live suite pid ${inner_pid}"
        return
    fi
    wait "$holder_pid" 2>/dev/null
    # The holder exits without test_summary, so by design it retains its
    # (empty) log — reap it here like the exit-status test does.
    rm -f "/tmp/zfsutilities-test-${inner_pid}.log"
    if [[ -e "/tmp/mock_zfs_state_${inner_pid}" ]]; then
        rm -rf "/tmp/mock_zfs_state_${inner_pid}"
        rm -f "$holder_log"
        test_fail "Holder suite pid ${inner_pid} did not clean up its own dir"
        return
    fi
    rm -f "$holder_log"
    test_pass
}

test_rooted_listing_filters_to_the_requested_root() {
    test_start "rooted zfs list returns only the root and its descendants"
    _reset_zfs_mock_world
    _mock_zfs_fs_list=$'poolA/src/data\npoolA/src/other\npoolB/dest/data'
    local out rc
    out=$(zfs list -Hrt filesystem -o name poolA/src 2>/dev/null); rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "rooted listing failed: rc=$rc"
        return
    fi
    assert_equals $'poolA/src/data\npoolA/src/other' "$out"
}

test_rooted_listing_of_unknown_root_fails() {
    test_start "rooted zfs list fails when the root exists nowhere"
    _reset_zfs_mock_world
    _mock_zfs_fs_list=$'poolA/src/data'
    local out rc
    out=$(zfs list -Hrt filesystem -o name poolB/nowhere 2>/dev/null); rc=$?
    if [[ $rc -eq 0 || -n "$out" ]]; then
        test_fail "unknown root must fail with no output; rc=$rc out=[$out]"
        return
    fi
    test_pass
}

test_rooted_listing_knows_root_from_existence_model() {
    test_start "a root registered only in the existence model lists as itself"
    _reset_zfs_mock_world
    _mock_zfs_fs_list=$'poolA/src/data'
    _mock_zfs_datasets["poolB/lone"]=1
    local out rc
    out=$(zfs list -Hrt filesystem -o name poolB/lone 2>/dev/null); rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "existence-only root must succeed: rc=$rc"
        return
    fi
    assert_equals "poolB/lone" "$out"
}

test_receive_record_makes_dataset_exist() {
    test_start "a pipelined receive's state-file record proves existence"
    _reset_zfs_mock_world
    _mock_zfs_fs_list=""
    printf '%s\n' "pool/recv/data" >> "$_mock_zfs_state_dir/received-datasets"
    local out rc
    # Plain existence probe (the archive-vm verification shape).
    out=$(zfs list -H "pool/recv/data" 2>/dev/null); rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "receive-created dataset must exist for plain probes: rc=$rc"
        return
    fi
    assert_equals "pool/recv/data" "$out"
    # Rooted probe on the received dataset (completion-state shape).
    out=$(zfs list -H -o name "pool/recv/data" 2>/dev/null); rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "receive-created dataset must be a known listing root: rc=$rc"
        return
    fi
    assert_equals "pool/recv/data" "$out"
}

test_destroy_purges_receive_records() {
    test_start "zfs destroy removes the dataset's (and descendants') receive records"
    _reset_zfs_mock_world
    printf '%s\n' "pool/recv/data" "pool/recv/data/child" "pool/other" \
        >> "$_mock_zfs_state_dir/received-datasets"
    zfs destroy -r "pool/recv/data" >/dev/null 2>&1
    local remaining
    remaining=$(cat "$_mock_zfs_state_dir/received-datasets")
    assert_equals "pool/other" "$remaining"
}

test_unrooted_listing_stays_flat() {
    test_start "listings without a dataset argument keep the whole world"
    _reset_zfs_mock_world
    _mock_zfs_fs_list=$'poolA/src/data\npoolB/dest/data'
    local out rc
    out=$(zfs list -Hrt filesystem -o name 2>/dev/null); rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "unrooted listing failed: rc=$rc"
        return
    fi
    assert_equals $'poolA/src/data\npoolB/dest/data' "$out"
}

# Reset the zfs mock world between the mock-semantics tests, including the
# per-suite receive-record file (each test builds only the records it needs).
_reset_zfs_mock_world() {
    _mock_zfs_fs_list=""
    _mock_zfs_datasets=()
    : > "$_mock_zfs_state_dir/received-datasets"
}

test_pass_counter_is_idempotent
test_fail_counter_is_idempotent
test_skip_counter_is_idempotent
test_late_failure_counts_as_failure
test_green_suite_removes_its_tmp_artifacts
test_failed_suite_retains_log_but_removes_state_dir
test_suite_exit_status_preserved_through_cleanup
test_source_reaps_orphaned_state_dirs
test_source_keeps_live_suite_state_dirs
test_rooted_listing_filters_to_the_requested_root
test_rooted_listing_of_unknown_root_fails
test_rooted_listing_knows_root_from_existence_model
test_receive_record_makes_dataset_exist
test_destroy_purges_receive_records
test_unrooted_listing_stays_flat

test_summary
