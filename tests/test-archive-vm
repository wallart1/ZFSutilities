#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-archive-vm — Unit tests for archive-vm: stopped-VM gate, dependent
# clone reporting/severance, and snapshot/archive handling.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

setup_node_config() {
    local mode="${1:-single-node}"
    NODE_CONF_FILE="$_mock_zfs_state_dir/node.conf"
    if [[ "$mode" == "single-node" ]]; then
        cat > "$NODE_CONF_FILE" << 'EOF'
NODE_MODE=single-node
EOF
    elif [[ "$mode" == "two-node-local" ]]; then
        # The invoking host IS the storage host: on_storage payloads must
        # run locally (no ssh round trip to itself).
        local compute
        compute=$(hostname -s)
        cat > "$NODE_CONF_FILE" << EOF
NODE_MODE="two-node"
STORAGE_HOST="$compute"
COMPUTE_HOST="$compute"
STORAGE_IP="192.168.100.1"
IQN_PREFIX="iqn.2026-02.local.stewie"
declare -A POOL_TARGET=(
    [threeamigos]="threeamigos"
    [NVME1]="nvme1"
)
EOF
    else
        local compute
        compute=$(hostname -s)
        cat > "$NODE_CONF_FILE" << EOF
NODE_MODE="two-node"
STORAGE_HOST="stewie"
COMPUTE_HOST="$compute"
STORAGE_IP="192.168.100.1"
IQN_PREFIX="iqn.2026-02.local.stewie"
declare -A POOL_TARGET=(
    [threeamigos]="threeamigos"
    [NVME1]="nvme1"
)
EOF
    fi
    export NODE_CONF="$NODE_CONF_FILE"
}

setup_pve_config() {
    local pve_dir="$1"
    local vmid="$2"
    local mode="${3:-single-node}"
    mkdir -p "$pve_dir"
    if [[ "$mode" == "single-node" ]]; then
        cat > "${pve_dir}/${vmid}.conf" << EOF
name: test-vm
scsi0: threeamigos:vm-${vmid}-disk-0,size=10G
EOF
    else
        cat > "${pve_dir}/${vmid}.conf" << EOF
name: test-vm
scsi0: ip-192.168.100.1:3260-iscsi-iqn.2026-02.local.stewie:threeamigos-lun-0,size=10G
EOF
    fi
}

# Run archive-vm in a subshell so an exit/die does not kill the test harness.
run_archive() {
    local mode="$1"
    local snapshots="${2:-existing}"
    local pve_dir="$3"
    local archive_base="$4"
    local archive_mount="$5"
    local vmid="$6"
    local stdin_input="${_mock_read_response:-}"
    local ssh_snap_exists="${_mock_ssh_snapshot_exists:-1}"
    local vm_status_mock="${_mock_vm_status:-stopped}"
    local clone_info_mock="${_mock_clone_info:-}"

    # Preserve the mocked date from the outer shell.
    local date_iso="$_mock_date_utc"
    local date_dow="Sun"
    local date_dom="15"

    local capture_dir="$_mock_zfs_state_dir/capture"
    mkdir -p "$capture_dir"
    rm -f "$capture_dir/snapshots" "$capture_dir/ssh" "$capture_dir/ssh-argv" \
        "$capture_dir/severances" "$capture_dir/zfs-argv" \
        "$capture_dir/zfsdelfs" "$capture_dir/rescan" \
        "$capture_dir/remove-vm-disk-argv" \
        "$capture_dir/pace" "$capture_dir/dd" \
        "$capture_dir/tee" "$capture_dir/sha256"

    local sever_stub="$capture_dir/sever-vm-clone-stub"
    cat > "$sever_stub" << 'EOF'
#!/usr/bin/bash
echo "SEVER:$1" >> "$_capture_dir/severances"
EOF
    chmod +x "$sever_stub"

    local zfsdelfs_stub="$capture_dir/zfsdelfs-stub"
    cat > "$zfsdelfs_stub" << 'EOF'
#!/usr/bin/bash
echo "ZFSDE LFS:$*" >> "$_capture_dir/zfsdelfs"
exit "${_mock_zfsdelfs_rc:-0}"
EOF
    chmod +x "$zfsdelfs_stub"

    local rescan_stub="$capture_dir/rescan-storage-stub"
    cat > "$rescan_stub" << 'EOF'
#!/usr/bin/bash
echo "RESCAN" >> "$_capture_dir/rescan"
exit 0
EOF
    chmod +x "$rescan_stub"

    (
        source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
        # Redirect log_msg to stderr so warning assertions can see it.
        log_msg() { echo "$*" >&2; }
        setup_test_env
        mock_date "$date_iso" "$date_dow" "$date_dom"
        setup_node_config "$mode"

        export ARCHIVE_VM_TEST_NO_ROOT=1
        export NODE_LIB="$mydir/lib/node-lib.sh"
        export ARCHIVE_ENGINE_LIB="$mydir/lib/archive-engine.sh"
        export ZFSLOCK_DIR="$_mock_zfs_state_dir/lock"
        mkdir -p "$ZFSLOCK_DIR"

        export PVE_CONF_DIR="$pve_dir"
        export JSON_CONFIG="$_mock_zfs_state_dir/zfsutilities.json"
        # Start every run from an empty JSON config: the state dir is shared
        # across tests, and a rate/path saved by an earlier test must not
        # become the default a later test's empty answer falls back to.
        printf '{}\n' > "$JSON_CONFIG"
        export _mock_zvol="threeamigos/proxmox/vm-${vmid}-disk-0"
        export _mock_zvols_list="${_mock_zvols_list:-$_mock_zvol}"
        export _mock_archive_base="$archive_base"
        export _mock_archive_mount="$archive_mount"
        export _capture_dir="$capture_dir"
        export _mock_ssh_snapshot_exists="$ssh_snap_exists"
        export _mock_ssh_snapshot_error="${_mock_ssh_snapshot_error:-}"
        export _mock_vm_status="$vm_status_mock"
        export _mock_clone_info="$clone_info_mock"
        export _mock_clone_vm_status="${_mock_clone_vm_status:-}"
        export _mock_archive_vmid="$vmid"
        export _mock_sever_stub="$sever_stub"
        export _mock_cp_fail="${_mock_cp_fail:-}"
        export _mock_hash_dst="${_mock_hash_dst:-}"
        export _mock_sha_fail="${_mock_sha_fail:-}"
        export _mock_encryption="${_mock_encryption:-}"
        export _mock_volsize="${_mock_volsize:-}"
        export _mock_snapdev="${_mock_snapdev:-}"
        export _mock_preexisting_archive="${_mock_preexisting_archive:-}"
        export _mock_complete_archive="${_mock_complete_archive:-}"
        export _mock_zfsdelfs_rc="${_mock_zfsdelfs_rc:-}"
        export _mock_remove_vm_disk_rc="${_mock_remove_vm_disk_rc:-}"
        export _mock_step4_zvols_remaining="${_mock_step4_zvols_remaining:-}"
        export _mock_input_hold="${_mock_input_hold:-}"
        export _mock_zfsdelfs_stub="$zfsdelfs_stub"
        export _mock_rescan_stub="$rescan_stub"
        export ZFSUTILITIES_INPUT_HOLD="${_mock_input_hold:-}"

        # Note: ask_yn cannot be mocked here — sourcing archive-vm re-runs
        # bashinit (via ~/bashinit), which unconditionally redefines it.
        # Interactive answers are driven through the subshell's stdin feed
        # ($_mock_read_response) in prompt order.

        # Capture a copy of test-lib's zfs mock so we can wrap it.
        eval "_test_lib_zfs() $(declare -f zfs | tail -n +2)"
        zfs() {
            if [[ "$1" == "snapshot" ]]; then
                echo "SNAP:$2" >> "$_capture_dir/snapshots"
            fi
            if [[ "$1" == "create" ]]; then
                # Real zfs semantics: the dataset exists afterwards, with
                # the creation properties the argv asked for.
                echo "CREATE:$*" >> "$_capture_dir/zfs-argv"
                local -a _cargv=("$@")
                local _ds="${_cargv[-1]}" _i _vbs="" _vs=""
                _mock_zfs_datasets["$_ds"]=1
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$_ds"
                for _i in "$@"; do
                    [[ "$_i" == volblocksize=* ]] && _vbs="${_i#volblocksize=}"
                done
                for ((_i = 0; _i < $((${#_cargv[@]} - 1)); _i++)); do
                    [[ "${_cargv[$_i]}" == "-V" ]] && _vs="${_cargv[$((_i + 1))]}"
                done
                [[ -z "$_vbs" ]] || _mock_zfs_props["${_ds}:volblocksize"]="$_vbs"
                [[ -z "$_vs" ]] || _mock_zfs_props["${_ds}:volsize"]="$_vs"
                return 0
            fi
            if [[ "$1" == "destroy" ]]; then
                echo "DESTROY:$*" >> "$_capture_dir/zfs-argv"
                local -a _dargv=("$@")
                local _ds="${_dargv[-1]}"
                unset '_mock_zfs_datasets[$_ds]' 2>/dev/null || true
                _mock_zfs_fs_list=$(printf '%s\n' "$_mock_zfs_fs_list" \
                    | grep -vxF -- "$_ds") || true
                return 0
            fi
            if [[ "$1" == "set" ]]; then
                echo "SET:$*" >> "$_capture_dir/zfs-argv"
                return 0
            fi
            # Dependent-clone discovery: feed canned name<TAB>origin rows.
            if [[ "$*" == *"list -H -o name,origin"* ]]; then
                [[ -n "${_mock_clone_info:-}" ]] && printf '%s\n' "$_mock_clone_info"
                return 0
            fi
            _test_lib_zfs "$@"
        }

        # Route sever-vm-clone to a stub that records its VMID argument.
        eval "_test_lib_find_script() $(declare -f find_zfsutility_script | tail -n +2)"
        find_zfsutility_script() {
            if [[ "${1:-}" == "sever-vm-clone" ]]; then
                echo "$_mock_sever_stub"
                return 0
            fi
            if [[ "${1:-}" == "zfsdelfs" ]]; then
                echo "$_mock_zfsdelfs_stub"
                return 0
            fi
            if [[ "${1:-}" == "rescan-storage" ]]; then
                echo "$_mock_rescan_stub"
                return 0
            fi
            _test_lib_find_script "$@"
        }

        # Capture ssh invocations and return canned storage-host answers.
        ssh() {
            local has_bash=0 has_s=0 arg stdin=""
            for arg in "$@"; do
                # Two-node payloads may arrive with an env prefix (e.g.
                # "pv_rate_limit='100M' bash -s") as one argv entry.
                [[ "$arg" == "bash" || "$arg" == *"bash -s" ]] && has_bash=1
                [[ "$arg" == "-s" || "$arg" == *"bash -s" ]] && has_s=1
            done

            # Only here-doc SSH fragments provide stdin.  Non-here-doc calls
            # (e.g. remote version-resolution probes or simple remote commands)
            # must not consume the interactive answers fed to this subshell.
            if [[ $has_bash -eq 1 && $has_s -eq 1 ]]; then
                stdin=$(cat)
            fi

            {
                echo "SSH:${*}"
                echo "$stdin"
            } >> "$_capture_dir/ssh"

            if [[ "$*" == *"remove-vm-disk"* ]]; then
                # Step-4 delegation to the storage host. The knob simulates
                # a failed remote run; rc 0 covers both success and an
                # operator decline (remove-vm-disk exits 0 on decline).
                printf '%s\n' "$*" >> "$_capture_dir/remove-vm-disk-argv"
                return "${_mock_remove_vm_disk_rc:-0}"
            fi
            if [[ "$*" == *"zfs list -H -o name '"* ]]; then
                # Step-4 post-condition probe: echo the zvol when the
                # scenario says it was not removed.
                local _rz
                for _rz in ${_mock_step4_zvols_remaining:-}; do
                    if [[ "$*" == *"$_rz"* ]]; then
                        echo "$_rz"
                        return 0
                    fi
                done
                return 0
            fi

            if [[ "$*" == *"zfs get -H -o value mountpoint"* ]]; then
                echo "$_mock_archive_mount"
            elif [[ "$*" == *"realpath"* ]] || [[ "$*" == *"readlink"* ]]; then
                # remote_zfsutility_script resolves the remote active version.
                echo "/usr/local/lib/zfsutilities/current/bin"
            elif [[ $has_bash -eq 1 && $has_s -eq 1 ]]; then
                # Detect two-node target:lun resolution calls from archive-vm.
                local has_target_lun=0 arg
                for arg in "$@"; do
                    if [[ "$arg" == iqn.*:* ]]; then
                        has_target_lun=1
                        break
                    fi
                done
                if [[ $has_target_lun -eq 1 ]]; then
                    # Record the resolution call's argv one per line so
                    # tests can assert the target/lun encoding.
                    printf '%s\n' "$@" >> "$_capture_dir/ssh-argv"
                    local zvol
                    for zvol in $_mock_zvols_list; do
                        echo "$zvol"
                    done
                    return 0
                fi

                if [[ "$stdin" == *"zfs list -H -t snapshot"* ]]; then
                    if [[ "${_mock_ssh_snapshot_error:-}" == "1" ]]; then
                        echo "__ARCHIVE_VM_ERROR__"
                    elif [[ "$_mock_ssh_snapshot_exists" == "1" ]]; then
                        echo "${_mock_zvol}@dailybackup-2026-07-14T07:00-04:00-d"
                    else
                        echo "SNAP:${_mock_zvol}@retire-${_mock_date_utc}-d" \
                            >> "$_capture_dir/snapshots"
                        echo "${_mock_zvol}@retire-${_mock_date_utc}-d"
                    fi
                elif [[ "$stdin" == *"zfs list -H -t volume"* ]]; then
                    echo "$_mock_zvol"
                elif [[ "$stdin" == *"zfs list -H -o name,origin"* ]]; then
                    true
                elif [[ "$stdin" == *"zfs list -H -o name"* ]]; then
                    true
                fi
            fi
            return 0
        }

        scp() { return 0; }
        qm() {
            # Severance checks each dependent clone VM is stopped;
            # _mock_clone_vm_status overrides every VM except the archived one.
            if [[ "${1:-}" == "status" && -n "${_mock_clone_vm_status:-}" \
                && "${2:-}" != "${_mock_archive_vmid:-}" ]]; then
                echo "status: ${_mock_clone_vm_status}"
            else
                echo "status: ${_mock_vm_status:-stopped}"
            fi
        }

        # Device-copy engine mocks. cp records the copy and really copies
        # when the source exists (the config archive step depends on it);
        # /dev/zvol device paths do not exist in the harness.
        cp() {
            echo "CP:$*" >> "$_capture_dir/zfs-argv"
            if [[ -e "$1" ]]; then
                command cp "$@"
            fi
            return 0
        }
        sync() {
            echo "SYNC:$*" >> "$_capture_dir/zfs-argv"
        }
        sha256sum() {
            echo "SHA256:$*" >> "$_capture_dir/sha256"
            if [[ $# -eq 0 ]]; then
                # Stdin form: the in-flight source hash (from the fifo) or
                # the paced destination read-back. Draining stdin first
                # keeps the pipeline alive so _mock_sha_fail exercises
                # the post-copy hash-failure branch, not a SIGPIPE abort.
                cat > /dev/null
                [[ -z "${_mock_sha_fail:-}" ]] || return 1
                printf '%s  -\n' "deadbeef12345678"
                return 0
            fi
            # File-arg form: the unpaced destination read-back; the
            # _mock_hash_dst knob makes the digest differ.
            printf '%s  %s\n' \
                "${_mock_hash_dst:-deadbeef12345678}" "$1"
            return 0
        }
        tee() {
            # In-flight hash fan-out: passthrough, argv recorded.
            echo "TEE:$*" >> "$_capture_dir/tee"
            command tee "$@"
        }
        python3() {
            # Pacer stage (lib/pace_stream.py), argv recorded after the
            # interpreter script path. Only pacer invocations are
            # intercepted; every other python3 caller in the harness
            # (JSON config readers, sidecar helpers) runs for real. A
            # read-head call (-- <src>) takes its input from the named
            # device — which never exists in the harness, so nothing is
            # produced (the same no-copy semantics the cp mock has always
            # had). A call without -- is a mid-pipeline pacing segment and
            # passes stdin through. Neither form may touch the script's
            # stdin: the read head is the first pipeline stage, and its
            # stdin is the interactive answer feed.
            if [[ "${1:-}" != *pace_stream.py ]]; then
                command python3 "$@"
                return $?
            fi
            echo "PACE:${*:2}" >> "$_capture_dir/pace"
            local -a _pyargv=("$@") _pi
            for _pi in "${!_pyargv[@]}"; do
                if [[ "${_pyargv[$_pi]}" == "--" ]]; then
                    [[ -e "${_pyargv[$((_pi + 1))]}" ]] \
                        && cat -- "${_pyargv[$((_pi + 1))]}"
                    return 0
                fi
            done
            cat
        }
        dd() {
            # Device-copy reader/writer, argv recorded. A reader with a
            # named input (if=<src>) reads that device — which never
            # exists in the harness, so nothing is produced and, like the
            # read-head pv, the script's stdin is never consumed. A writer
            # (of=) consumes the stream arriving on the pipe. The
            # _mock_cp_fail knob fails the copy pipeline itself.
            echo "DD:$*" >> "$_capture_dir/dd"
            if [[ -n "${_mock_cp_fail:-}" ]]; then
                return 1
            fi
            local _darg
            for _darg in "$@"; do
                if [[ "$_darg" == if=* ]]; then
                    [[ -e "${_darg#if=}" ]] && cat -- "${_darg#if=}"
                    return 0
                fi
            done
            cat > /dev/null
            return 0
        }
        targetcli() {
            # Canned iSCSI layout for locally-executed storage payloads
            # (invoked-on-storage mode): every mock zvol is exported as
            # lun0 of the threeamigos target.
            case "$1" in
                /iscsi)
                    [[ "${2:-}" == "ls" ]] \
                        && echo "  iqn.2026-02.local.stewie:threeamigos"
                    return 0
                    ;;
                */tpg1/luns)
                    [[ "${2:-}" == "ls" ]] || return 0
                    local _tz
                    for _tz in $_mock_zvols_list; do
                        echo "  lun0 [block/${_tz##*/} (/dev/zvol/${_tz})]"
                    done
                    return 0
                    ;;
                /backstores/block)
                    [[ "${2:-}" == "ls" ]] || return 0
                    local _tz
                    for _tz in $_mock_zvols_list; do
                        echo "  ${_tz##*/}  /dev/zvol/${_tz}  (default_tg_pt)"
                    done
                    return 0
                    ;;
            esac
            return 0
        }

        # Mock ZFS state for all configured zvols. The archive base is part
        # of the listing so parent-chain probes stop walking there.
        _mock_zfs_fs_list=$(echo "$_mock_zvols_list" | tr ' ' '\n')$'\n'"$archive_base"
        _mock_zfs_datasets["$archive_base"]=1
        _mock_zfs_props["${archive_base}:mountpoint"]="$archive_mount"
        local zvol
        for zvol in $_mock_zvols_list; do
            _mock_zfs_datasets["$zvol"]=1
            _mock_zfs_props["${zvol}:volblocksize"]="8K"
            _mock_zfs_props["${zvol}:volsize"]="${_mock_volsize:-10G}"
            _mock_zfs_props["${zvol}:encryption"]="${_mock_encryption:-off}"
            _mock_zfs_props["${zvol}:snapdev"]="${_mock_snapdev:-hidden}"
            if [[ "${_mock_encryption:-off}" != "off" ]]; then
                # Raw receive: the archive dataset arrives with the
                # stream's volblocksize. (zfs receive runs as a pipeline
                # component, so the mock cannot register the dataset
                # itself — its mutations die with the pipeline subshell.)
                _mock_zfs_props["${archive_base}/${zvol}:volblocksize"]="8K"
                _mock_zfs_datasets["${archive_base}/${zvol}"]=1
            fi
            if [[ "$snapshots" == "existing" ]]; then
                _mock_zfs_snap_lists["$zvol"]="${zvol}@dailybackup-2026-07-14T07:00-04:00-d"
            else
                _mock_zfs_snap_lists["$zvol"]=""
            fi
        done
        if [[ "${_mock_preexisting_archive:-}" == "1" ]]; then
            for zvol in $_mock_zvols_list; do
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"${archive_base}/${zvol}"
            done
        fi
        # A "complete" pre-existing archive carries the post-verification
        # @archive snapshot, a METHOD= sidecar, and the volblocksize its
        # method implies (1M for copy archives).
        if [[ "${_mock_complete_archive:-}" == "1" ]]; then
            for zvol in $_mock_zvols_list; do
                local arc_ds="${archive_base}/${zvol}"
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$arc_ds"
                _mock_zfs_datasets["$arc_ds"]=1
                _mock_zfs_props["${arc_ds}:volblocksize"]="1M"
                _mock_zfs_snap_lists["$arc_ds"]="${arc_ds}@archive"
                echo "METHOD=copy" > "${archive_mount}/${zvol}.disk_info"
                echo "8K" > "${archive_mount}/${zvol}.original_volblocksize"
            done
        fi

        # Load the script from a temp file (instead of eval) so archive-vm's
        # own SSH here-doc bodies are read from the file, leaving the
        # subshell's stdin free for the interactive prompts.
        local script_file="$_mock_zfs_state_dir/archive-vm"
        script_text=$(cat "$mydir/bin/archive-vm")
        script_text=$(echo "$script_text" | sed '/^ask_yn() {/,/^}$/d')
        printf '%s\n' "$script_text" > "$script_file"

        # Source the temp file in the current shell so it inherits the mocks
        # defined above (zfs, ssh, qm, etc.).
        source "$script_file" "$vmid"
    ) 2>&1 <<EOF
$stdin_input
EOF
    local rc=$?

    cat "$capture_dir/snapshots" 2>/dev/null || true
    cat "$capture_dir/ssh" 2>/dev/null || true
    cat "$capture_dir/severances" 2>/dev/null || true
    cat "$capture_dir/zfs-argv" 2>/dev/null || true
    cat "$capture_dir/zfsdelfs" 2>/dev/null || true
    cat "$capture_dir/rescan" 2>/dev/null || true
    cat "$capture_dir/remove-vm-disk-argv" 2>/dev/null || true
    cat "$capture_dir/pace" 2>/dev/null || true
    cat "$capture_dir/dd" 2>/dev/null || true
    cat "$capture_dir/tee" 2>/dev/null || true
    cat "$capture_dir/sha256" 2>/dev/null || true
    return $rc
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

reset_mocks() {
    unset _mock_read_response _mock_ssh_snapshot_exists _mock_ssh_snapshot_error
    unset _mock_vm_status _mock_clone_info _mock_zvols_list _mock_clone_vm_status
    unset _mock_cp_fail _mock_hash_dst _mock_sha_fail _mock_encryption \
        _mock_volsize
    unset _mock_snapdev _mock_preexisting_archive _mock_complete_archive
    unset _mock_zfsdelfs_rc _mock_remove_vm_disk_rc _mock_step4_zvols_remaining
    unset _mock_input_hold
}

test_single_node_uses_existing_snapshot() {
    reset_mocks
    test_start "Single-node: existing snapshot is used"

    local vmid="209"
    local pve_dir="$_mock_zfs_state_dir/pve1"
    local archive="$_mock_zfs_state_dir/archive1"
    local mount="$_mock_zfs_state_dir/mount1"
    mkdir -p "$archive" "$mount" "$mount/threeamigos/proxmox" \
        "$(dirname "$mount/etc/pve/qemu-server")"
    setup_pve_config "$pve_dir" "$vmid"
    _mock_read_response="${archive}

y
n"

    local out rc
    out=$(run_archive single-node existing "$pve_dir" "$archive" "$mount" "$vmid")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    local _wrap_rhs="Snapshot to archive: threeamigos/proxmox/vm-${vmid}-disk-0@dailybackup"
    if [[ "$out" == *"$_wrap_rhs"* ]]; then
        test_pass
    else
        test_fail "Existing snapshot not used; output:\n$out"
    fi
}

test_single_node_creates_retire_snapshot() {
    reset_mocks
    test_start "Single-node: retire snapshot created when none exist"

    local vmid="210"
    local pve_dir="$_mock_zfs_state_dir/pve2"
    local archive="$_mock_zfs_state_dir/archive2"
    local mount="$_mock_zfs_state_dir/mount2"
    mkdir -p "$archive" "$mount" "$mount/threeamigos/proxmox" \
        "$(dirname "$mount/etc/pve/qemu-server")"
    setup_pve_config "$pve_dir" "$vmid"
    mock_date "2026-07-14T11:23-04:00" "Mon" "14"
    _mock_read_response="${archive}

y
n"

    local out rc
    out=$(run_archive single-node none "$pve_dir" "$archive" "$mount" "$vmid")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    if [[ "$out" != *"Created retire snapshot"* ]]; then
