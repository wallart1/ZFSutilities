test_missing_pacer_fatals_instead_of_running_unlimited() {
    reset_mocks
    test_start "Unresolvable pacer with a rate set refuses to pace, not to run"

    # Unit level (run_archive always resolves the real pacer beside the
    # engine): archive_pace_pipe must FATAL and leave the pipeline segment
    # empty when archive_pacer cannot resolve the helper — a paced run may
    # never silently fall back to unlimited.
    # shellcheck source=/dev/null
    source "$mydir/lib/archive-engine.sh"
    local _orig_pacer
    _orig_pacer=$(declare -f archive_pacer)
    archive_pacer() { return 1; }
    transfer_rate_limit="100M"
    local rc=0
    archive_pace_pipe 2>/dev/null || rc=$?
    eval "$_orig_pacer"
    transfer_rate_limit=""
    assert_rc 1 "$rc"
    assert_array_len 0 "${pace_pipe[@]}"
    assert_contains "$(cat "${_TEST_LOG_FILE:-/dev/null}")" \
        "FATAL: Rate limit set but pace_stream.py not found"
    test_pass
}

