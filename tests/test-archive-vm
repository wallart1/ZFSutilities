test_sidecar_lun_lookup_grep_survives_slash_prefix() {
    test_start "archive-vm: sidecar LUN lookup matches targetcli's slash-prefixed backstore names"

    # targetcli luns-ls prints "[block/<name> (/dev/...)]" — the name is
    # slash-prefixed, so the found_lun grep must anchor on "block/<name> ".
    # A space-anchored pattern alone never matches (same class as the
    # new-vm-disk F-018 fix); an unanchored name would also match disk-1's
    # line when disk-10 exists.
    local script="$mydir/bin/archive-vm"
    local pipeline
    pipeline=$(sed -n '/found_lun=\$(targetcli/,/head -1)/p' "$script")
    if [[ -z "$pipeline" ]]; then
        test_fail "found_lun pipeline not found in archive-vm"
        return
    fi
    if [[ "$pipeline" != *'grep -F "block/${backstore} "'* ]]; then
        test_fail "Sidecar LUN lookup not slash-anchored:\n$pipeline"
        return
    fi
    if [[ "$pipeline" == *'grep -F " ${backstore} "'* ]]; then
        test_fail "Sidecar LUN lookup still space-anchored:\n$pipeline"
        return
    fi

    test_pass
}

