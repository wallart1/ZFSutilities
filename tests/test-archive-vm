test_running_vm_aborts_before_archive() {
    reset_mocks
    test_start "Running VM: script reports it, instructs stop, and terminates"

    local vmid="230"
    local pve_dir="$_mock_zfs_state_dir/pve10"
    local archive="$_mock_zfs_state_dir/archive10"
    local mount="$_mock_zfs_state_dir/mount10"
    mkdir -p "$archive" "$mount" "$mount/threeamigos/proxmox" \
        "$(dirname "$mount/etc/pve/qemu-server")"
    setup_pve_config "$pve_dir" "$vmid"
    _mock_vm_status="running"
    _mock_read_response="${archive}
y
n"

    local out rc
    out=$(run_archive single-node existing "$pve_dir" "$archive" "$mount" "$vmid")
    rc=$?

    if [[ $rc -eq 0 ]]; then
        test_fail "Expected non-zero exit code; output:\n$out"
        return
    fi
    if [[ "$out" != *"is not stopped (status: running)"* ]]; then
        test_fail "Running-VM report missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"must be stopped before it can be archived"* ]]; then
        test_fail "Stop instruction missing; output:\n$out"
        return
    fi
    if [[ "$out" == *"Snapshot to archive"* || "$out" == *"SNAP:"* ]]; then
        test_fail "Archive proceeded despite running VM; output:\n$out"
        return
    fi
    local sidecar="${mount}/threeamigos/proxmox/vm-${vmid}-disk-0.original_volblocksize"
    if [[ -f "$sidecar" ]]; then
        test_fail "Sidecar written despite running VM"
        return
    fi

    test_pass
}

test_reports_disks_with_dependent_clones() {
    reset_mocks
    test_start "Dependent clones: source disks reported, script promotion offered"

    local vmid="231"
    local pve_dir="$_mock_zfs_state_dir/pve11"
    local archive="$_mock_zfs_state_dir/archive11"
    local mount="$_mock_zfs_state_dir/mount11"
    mkdir -p "$archive" "$mount" "$mount/threeamigos/proxmox" \
        "$(dirname "$mount/etc/pve/qemu-server")"
    setup_pve_config "$pve_dir" "$vmid"
    local src_disk="threeamigos/proxmox/vm-${vmid}-disk-0"
    _mock_clone_info="$(printf \
'threeamigos/proxmox/vm-310-disk-0\t%s@clone-2026-07-30T12:00-0400-c\n'\
'threeamigos/proxmox/vm-315-disk-0\t%s@clone-2026-08-01T09:15-0400-c' \
        "$src_disk" "$src_disk")"
    # stdin answers in prompt order: promote clones=n, archive base path,
    # proceed with archive=y, remove VM=n.
    _mock_read_response="n
${archive}
y
