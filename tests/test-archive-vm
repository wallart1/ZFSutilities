test_copy_hashes_source_in_flight() {
    reset_mocks
    test_start "Copy path: source hashed in flight, destination read back once"

    local vmid="264"
    local pve_dir="$_mock_zfs_state_dir/pve44"
    local archive="$_mock_zfs_state_dir/archive44"
    local mount="$_mock_zfs_state_dir/mount44"
    mkdir -p "$archive" "$mount" "$mount/threeamigos/proxmox" \
        "$(dirname "$mount/etc/pve/qemu-server")"
    setup_pve_config "$pve_dir" "$vmid"
    _mock_zvols_list="threeamigos/proxmox/vm-${vmid}-disk-0"
    _mock_read_response="${archive}

y
n"

    local out rc
    out=$(run_archive single-node existing "$pve_dir" "$archive" "$mount" "$vmid")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    local cp_src cp_dst tee_count stdin_sha src_sha dst_sha
    cp_src="/dev/zvol/threeamigos/proxmox/vm-${vmid}-disk-0@dailybackup-2026-07-14T07:00-04:00-d"
    cp_dst="/dev/zvol/${archive}/threeamigos/proxmox/vm-${vmid}-disk-0"
    # Exactly one tee fan-out: the copy pipeline's hash side-channel.
    tee_count=$(printf '%s\n' "$out" | grep -c '^TEE:')
    if [[ "$tee_count" -ne 1 ]]; then
        test_fail "Expected one in-flight hash fan-out, saw ${tee_count}; output:\n$out"
        return
    fi
    # The source is hashed from the stream (stdin form), never re-read as
    # a file; the only file-argument hash read names the destination.
    stdin_sha=$(printf '%s\n' "$out" | grep -cxF -- 'SHA256:')
    src_sha=$(printf '%s\n' "$out" | grep -cF -- "SHA256:${cp_src}")
    dst_sha=$(printf '%s\n' "$out" | grep -cF -- "SHA256:${cp_dst}")
    if [[ "$stdin_sha" -ne 1 || "$src_sha" -ne 0 || "$dst_sha" -ne 1 ]]; then
        local hash_fail_msg="Hash reads wrong: stdin=${stdin_sha} src=${src_sha}"
        hash_fail_msg+=" dst=${dst_sha}; output:\n$out"
        test_fail "$hash_fail_msg"
        return
    fi
    if [[ "$out" != *"✓ Copy verified (sha256 match)"* ]]; then
        test_fail "Copy verification missing; output:\n$out"
        return
    fi

    test_pass
}

