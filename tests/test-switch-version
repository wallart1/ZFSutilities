test_shipped_fence_units_match_fence_design() {
    test_start "shipped fence units keep the stable-path ExecStart, journal-only env, 5-min cadence"
    local share_dir
    share_dir="$(dirname "$SWITCH_VERSION")/../share/two-node"
    local failed=0
    # The stable bin symlink (not current/) survives version switches, and
    # --recover is the whole point of the unattended fence.
    if ! grep -q '^ExecStart=/usr/local/lib/zfsutilities/bin/check-vm-disk-paths --recover$' \
            "$share_dir/zfsutilities-iscsi-fence.service"; then
        failed=1
        echo "    service ExecStart must use the stable bin path with --recover"
    fi
    # Without INHERIT, bashinit writes a session log per 5-minute tick
    # (288/day) — the journal-churn discipline this unit exists to keep.
    if ! grep -q '^Environment=ZFSUTILITIES_LOG_INHERIT=Y$' \
            "$share_dir/zfsutilities-iscsi-fence.service"; then
        failed=1
        echo "    service must set ZFSUTILITIES_LOG_INHERIT=Y"
    fi
    if ! grep -q '^OnUnitActiveSec=5min$' "$share_dir/zfsutilities-iscsi-fence.timer"; then
        failed=1
        echo "    timer cadence must stay at 5 minutes"
    fi
    if ! grep -q '^WantedBy=timers.target$' "$share_dir/zfsutilities-iscsi-fence.timer"; then
        failed=1
        echo "    timer must install into timers.target"
    fi

    if [[ "$failed" -eq 0 ]]; then
        test_pass
    else
        test_fail "shipped fence units drifted from the fence design"
    fi
}

