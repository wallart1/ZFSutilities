test_list_shows_versions() {
    test_start "switch-version --list shows installed versions and markers"
    local tmpdir
    _setup_switch_env tmpdir

    _make_fake_version "$tmpdir" "0.9.0" ""
    _make_fake_version "$tmpdir" "1.0.0" ""
    _make_fake_version "$tmpdir" "1.1.0" ""
    ln -sfn "versions/1.0.0" "$tmpdir/current"
    ln -sfn "versions/0.9.0" "$tmpdir/previous"

    local output
    output=$(switch_version_main "--list" 2>&1)
    local rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected return code 0, got $rc"
    fi
    if [[ "$output" != *"0.9.0"*"<-- previous"* ]]; then
        failed=1
        echo "    Expected previous marker for 0.9.0"
    fi
    if [[ "$output" != *"1.0.0"*"<-- current"* ]]; then
        failed=1
        echo "    Expected current marker for 1.0.0"
    fi
    if [[ "$output" != *"1.1.0"* ]]; then
        failed=1
        echo "    Expected 1.1.0 in list"
    fi

    _teardown_switch_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "--list did not show versions as expected"
    fi
}

test_switch_version_tolerates_missing_desktop_lib() {
    test_start "switch-version tolerates missing desktop-launcher-lib.sh"
    local tmpdir
    tmpdir=$(mktemp -d)

    # Create an isolated copy of switch-version without the launcher library.
    mkdir -p "$tmpdir/bin"
    cp "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../bin/switch-version" \
        "$tmpdir/bin/switch-version"
    cp "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../bin/bashinit" \
        "$tmpdir/bashinit"
    printf '#!/usr/bin/bash\nrootcheck() { true; }\n' > "$tmpdir/bin/rootcheck"
    chmod +x "$tmpdir/bin/rootcheck"

    # Source the isolated switch-version and exercise the fallback helpers.
    local output
    output=$(HOME="$tmpdir" bash -c \
        "source '$tmpdir/bin/switch-version'; \
         type get_desktop_user >/dev/null 2>&1 && \
         type create_desktop_symlinks >/dev/null 2>&1 && \
         type remove_desktop_symlinks >/dev/null 2>&1 && \
         SUDO_USER=testuser get_desktop_user" 2>&1)
    local rc=$?

    rm -rf "$tmpdir"

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Sourcing switch-version without desktop-launcher-lib.sh failed (rc=$rc)"
    fi
    if [[ "$output" != *"testuser"* ]]; then
        failed=1
        echo "    Fallback get_desktop_user did not return SUDO_USER: '$output'"
    fi
    if [[ "$output" == *"desktop-launcher-lib.sh not found"* ]]; then
        : # expected warning
    else
        failed=1
        echo "    Expected warning about missing desktop-launcher-lib.sh"
    fi

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "Missing desktop-launcher-lib.sh fallback did not work"
    fi
}

test_list_shows_versions
test_switch_version_tolerates_missing_desktop_lib

test_cleanup_obsolete_systemd_artifacts() {
    test_start "install_wiring removes obsolete LUKS-key systemd artifacts"
    local tmpdir
    _setup_switch_env tmpdir

    local systemd_dir="$tmpdir/etc/systemd/system"
    local dropin_dir="$systemd_dir/rtslib-fb-targetctl.service.d"
    mkdir -p "$dropin_dir"
    touch "$systemd_dir/zfs-keys-unlock.service"
    touch "$dropin_dir/wait-for-zfs-keys.conf"

    _make_fake_version "$tmpdir" "A" ""
    ln -sfn "versions/A" "$tmpdir/current"

    export SUDO_USER="testuser"
    export HOME="$tmpdir/home/testuser"
    mkdir -p "$tmpdir/home/testuser"
    getent() {
        if [[ "$1" == "passwd" && "$2" == "testuser" ]]; then
            echo "testuser:x:1000:1000:test:/$tmpdir/home/testuser:/bin/bash"
        fi
    }
    chown() { true; }

    export ZFSUTILITIES_SYSTEMD_DIR="$systemd_dir"
    local _systemctl_calls=()
    systemctl() {
        _systemctl_calls+=("$*")
        return 0
    }

    install_wiring >/dev/null 2>&1
    local rc=$?
    unset -f systemctl getent chown 2>/dev/null || true
    unset ZFSUTILITIES_SYSTEMD_DIR SUDO_USER HOME

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ -f "$systemd_dir/zfs-keys-unlock.service" ]]; then
        failed=1
        echo "    obsolete zfs-keys-unlock.service still present"
    fi
    if [[ -f "$dropin_dir/wait-for-zfs-keys.conf" ]]; then
        failed=1
        echo "    obsolete wait-for-zfs-keys.conf still present"
    fi
    local found_reload=0
    local call
    for call in "${_systemctl_calls[@]}"; do
        if [[ "$call" == "daemon-reload" ]]; then
            found_reload=1
        fi
    done
    if [[ $found_reload -eq 0 ]]; then
        failed=1
        echo "    expected systemctl daemon-reload to be called"
    fi

    _teardown_switch_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "Obsolete systemd artifacts were not cleaned up"
    fi
}

test_cleanup_obsolete_systemd_artifacts

# Helper: build a fake version carrying share/two-node drop-in files with
# the given content tag, so tests can tell versions apart by content.
_make_dropin_version() {
    local version_base="$1" version="$2" tag="$3"
    _make_fake_version "$version_base" "$version" ""
    mkdir -p "$version_base/versions/$version/share/two-node"
    printf 'boot-config-%s\n' "$tag" \
        > "$version_base/versions/$version/share/two-node/rtslib-fb-targetctl-boot-config.conf"
    printf 'pre-start-%s\n' "$tag" \
        > "$version_base/versions/$version/share/two-node/rtslib-fb-targetctl-pre-start-backup.conf"
}

# Helper: put a fake targetctl on PATH so install_rtslib_dropins'
# storage-host gate opens (the dev host has no real one). Prints the stub
# directory — remove it and restore PATH when done.
_make_targetctl_stub() {
    local stub_dir
    stub_dir=$(mktemp -d)
    printf '#!/bin/bash\nexit 0\n' > "$stub_dir/targetctl"
    chmod +x "$stub_dir/targetctl"
    printf '%s' "$stub_dir"
}

test_install_rtslib_dropins_installs_and_refreshes() {
    test_start "install_rtslib_dropins installs and refreshes drop-ins on switch"
    local tmpdir
    _setup_switch_env tmpdir

    _make_dropin_version "$tmpdir" "A" "v1"
    _make_dropin_version "$tmpdir" "B" "v2"
    ln -sfn "versions/A" "$tmpdir/current"

    local systemd_dir="$tmpdir/etc/systemd/system"
    local dropin_dir="$systemd_dir/rtslib-fb-targetctl.service.d"
    export ZFSUTILITIES_SYSTEMD_DIR="$systemd_dir"
    local _systemctl_calls=()
    systemctl() {
        _systemctl_calls+=("$*")
        return 0
    }

    local stub_dir
    stub_dir=$(_make_targetctl_stub)
    local _orig_path="$PATH"
    export PATH="$stub_dir:$PATH"

    load_switch_config
    install_rtslib_dropins
    local failed=0
    if [[ ! -f "$dropin_dir/boot-config.conf" ]]; then
        failed=1
        echo "    boot-config.conf missing after activation of A"
    elif [[ "$(cat "$dropin_dir/boot-config.conf")" != "boot-config-v1" ]]; then
        failed=1
        echo "    boot-config.conf not from activated version A"
    fi
    if [[ ! -f "$dropin_dir/pre-start-backup.conf" ]]; then
        failed=1
        echo "    pre-start-backup.conf missing after activation of A"
    elif [[ "$(cat "$dropin_dir/pre-start-backup.conf")" != "pre-start-v1" ]]; then
        failed=1
        echo "    pre-start-backup.conf not from activated version A"
    fi

    # Switching versions must refresh the drop-ins to the newly activated
    # version's content — the version-skew trap this function exists to fix.
    ln -sfn "versions/B" "$tmpdir/current"
    install_rtslib_dropins
    if [[ "$(cat "$dropin_dir/boot-config.conf" 2>/dev/null)" != "boot-config-v2" ]]; then
        failed=1
        echo "    boot-config.conf not refreshed after switching to B"
    fi
    if [[ "$(cat "$dropin_dir/pre-start-backup.conf" 2>/dev/null)" != "pre-start-v2" ]]; then
        failed=1
        echo "    pre-start-backup.conf not refreshed after switching to B"
    fi

    local _reload_count=0 _call
    for _call in "${_systemctl_calls[@]}"; do
        [[ "$_call" == "daemon-reload" ]] && _reload_count=$((_reload_count + 1))
    done
    if [[ "$_reload_count" -lt 1 ]]; then
        failed=1
        echo "    systemctl daemon-reload never fired"
    fi

    # Identical content is left alone: a re-run must not reload again.
    install_rtslib_dropins
    local _reload_count_after=0
    for _call in "${_systemctl_calls[@]}"; do
        [[ "$_call" == "daemon-reload" ]] && _reload_count_after=$((_reload_count_after + 1))
    done
    if [[ "$_reload_count_after" -ne "$_reload_count" ]]; then
        failed=1
        echo "    daemon-reload fired for identical content"
    fi

    export PATH="$_orig_path"
    rm -rf "$stub_dir"
    unset -f systemctl 2>/dev/null || true
    unset ZFSUTILITIES_SYSTEMD_DIR
    _teardown_switch_env "$tmpdir"

    if [[ "$failed" -eq 0 ]]; then
        test_pass
    else
        test_fail "rtslib drop-ins were not installed/refreshed correctly"
    fi
}

test_install_rtslib_dropins_skips_without_targetctl() {
    test_start "install_rtslib_dropins skips where targetctl is absent"
    local tmpdir
