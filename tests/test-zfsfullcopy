#!/usr/bin/bash
# test-zfsfullcopy — Unit tests for the zfsfullcopy restore helper.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Test helpers
# ------------------------------------------------------------------

_run_zfsfullcopy() {
    local _state_dir="$1"
    shift
    local _mock_bin="$_state_dir/mockbin"
    mkdir -p "$_mock_bin"

    # Copy the script under test into the mock bin directory so helper
    # resolution (via $mydir) finds our stubs instead of the real ones.
    cp "$mydir/bin/zfsfullcopy" "$_mock_bin/zfsfullcopy"

    cat > "$_mock_bin/zfs-send-receive" <<'EOF'
send-receive() {
    echo "send-receive called with: $*" >> "$ZFSFULLCOPY_STATE/send-receive.calls"
    echo "doincrementals=$doincrementals" \
        >> "$ZFSFULLCOPY_STATE/send-receive.calls"
    echo "force=$force" >> "$ZFSFULLCOPY_STATE/send-receive.calls"
    echo "commsnap_mostrecent=$commsnap_mostrecent" \
        >> "$ZFSFULLCOPY_STATE/send-receive.calls"
    echo "sourcefsremovequalifiers=$sourcefsremovequalifiers" \
        >> "$ZFSFULLCOPY_STATE/send-receive.calls"
}
EOF
    cat > "$_mock_bin/zfsoverrides" <<'EOF'
overrides() {
    echo "overrides called with: $*" >> "$ZFSFULLCOPY_STATE/overrides.calls"
    if [[ $# -gt 0 ]]; then
        local overrides="$*"
        eval "$overrides"
    fi
}
EOF
    cat > "$_mock_bin/zfssnapbuild" <<'EOF'
zfssnapbuild() {
    echo "@test-snap"
}
EOF
    cat > "$_mock_bin/bashfatal" <<'EOF'
exit "${1:-8}"
EOF

    cat > "$_mock_bin/zfsreapplyholds" <<'EOF'
reapplyholds_capture() {
    echo "capture: $*" >> "$ZFSFULLCOPY_STATE/reapply.calls"
    if [[ -n "$2" ]]; then
        printf '%s\t%s\n' "${destfs}@placeholder" "kept" > "$2"
    fi
}
reapplyholds_apply() {
    echo "apply: $*" >> "$ZFSFULLCOPY_STATE/reapply.calls"
}
EOF

    (
        # shellcheck disable=SC2034
        # Intentionally set for sourced zfsfullcopy helper.
        ZFSFULLCOPY_STATE="$_state_dir"
        mydir="$_mock_bin"
        # shellcheck source=/dev/null
        source "$_mock_bin/zfsfullcopy"
        zfsfullcopy "$@"
    ) >"$_state_dir/out" 2>"$_state_dir/err"
    echo $? > "$_state_dir/rc"
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_fullcopy_applies_overrides() {
    test_start "zfsfullcopy applies overrides when provided"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_overrides"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir" "someoverride=1"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    if [[ -f "$_state_dir/overrides.calls" ]]; then
        local _expected="overrides called with: someoverride=1"
        assert_contains "$(cat "$_state_dir/overrides.calls")" "$_expected"
    else
        test_fail "overrides was not called"
    fi
}

test_fullcopy_skips_overrides_when_empty() {
    test_start "zfsfullcopy does not call overrides when argument is empty"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_no_overrides"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir" ""
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    if [[ -f "$_state_dir/overrides.calls" ]]; then
        test_fail "overrides should not have been called"
    else
        test_pass
    fi
}

test_fullcopy_defaults_remove_qualifiers() {
    test_start "zfsfullcopy defaults sourcefsremovequalifiers to 0"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_default_qualifiers"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" "sourcefsremovequalifiers=0"
}

test_fullcopy_requires_restoresourcefs() {
    test_start "zfsfullcopy is fatal when restoresourcefs is missing"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_missing_source"
    mkdir -p "$_state_dir"
    destfs="pool/dest" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 8 "$rc"
}

test_fullcopy_requires_destfs() {
    test_start "zfsfullcopy is fatal when destfs is missing"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_missing_dest"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 8 "$rc"
}

test_fullcopy_calls_send_receive_once() {
    test_start "zfsfullcopy invokes send-receive once"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_once"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    local calls
    calls=$(grep -c "send-receive called with" \
        "$_state_dir/send-receive.calls" 2>/dev/null || echo 0)
    if [[ "$calls" -eq 1 ]]; then
        test_pass
    else
        test_fail "Expected 1 send-receive call, got $calls"
    fi
}

test_fullcopy_sets_full_copy_parameters() {
    test_start "zfsfullcopy sets full-copy parameters for send-receive"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_params"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" \
        "doincrementals=N"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" "force=Y"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" \
        "commsnap_mostrecent=OLDEST"
}

test_fullcopy_preserves_target_holds() {
    test_start "zfsfullcopy captures and reapplies target holds"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_preserve_holds"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" _run_zfsfullcopy "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"

    local _calls
    _calls=$(cat "$_state_dir/reapply.calls")
    assert_contains "$_calls" "capture: pool/dest"
    assert_contains "$_calls" "apply: pool/dest"
    local _cap_line _apply_line
    _cap_line=$(grep -n "capture:" "$_state_dir/reapply.calls" | head -n1 | cut -d: -f1)
    _apply_line=$(grep -n "apply:" "$_state_dir/reapply.calls" | head -n1 | cut -d: -f1)
    if [[ "$_cap_line" -lt "$_apply_line" ]]; then
        test_pass
    else
        test_fail "Capture should run before apply"
    fi
}

test_fullcopy_skips_hold_preservation_when_disabled() {
    test_start "zfsfullcopy skips hold preservation when preserve_target_holds=N"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/fullcopy_no_preserve_holds"
    mkdir -p "$_state_dir"
    restoresourcefs="pool/src" destfs="pool/dest" \
        _run_zfsfullcopy "$_state_dir" "preserve_target_holds='N'"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"

    if [[ -f "$_state_dir/reapply.calls" ]]; then
        test_fail "Hold helpers should not be called when disabled"
    else
        test_pass
    fi
}

# ------------------------------------------------------------------
# Run tests
# ------------------------------------------------------------------

test_fullcopy_applies_overrides
test_fullcopy_skips_overrides_when_empty
test_fullcopy_defaults_remove_qualifiers
test_fullcopy_requires_restoresourcefs
test_fullcopy_requires_destfs
test_fullcopy_calls_send_receive_once
test_fullcopy_sets_full_copy_parameters
test_fullcopy_preserves_target_holds
test_fullcopy_skips_hold_preservation_when_disabled

teardown_test_env
test_summary
