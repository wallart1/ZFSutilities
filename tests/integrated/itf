#!/usr/bin/env bash
# tests/integrated/itf — orchestrator CLI for the integrated testing
# environment.
#
# itf plays a first-time end user of ZFSutilities on disposable nested
# guests created on the base Proxmox test VMs.  Everything it does on a
# base system goes through the confinement guard in lib/base-lib.sh; see
# docs/docs/developer-guide/integrated-testing.md for the full model.
#
# Usage:
#   itf preflight                     verify dev + base-host readiness
#   itf guest create NAME [opts]      create (and optionally start) a guest
#   itf guest clone NAME [opts]       full-clone a guest from a baseline
#                                     template (post-install starting
#                                     point; --template picks the profile)
#   itf guest start|stop BASE VMID
#   itf guest destroy BASE VMID
#   itf guest snapshot BASE VMID SNAP
#   itf guest rollback BASE VMID SNAP [--start]
#   itf guest ip BASE VMID [timeout]  discover guest IP via guest agent
#   itf guest wait-ssh IP [timeout]
#   itf guest list [BASE]
#   itf iso fetch [debian|pve]        download installer ISO to dev cache
#   itf iso upload [BASE] [debian|pve]
#                                     upload cached ISO to base ISO storage
#   itf template status               baseline templates presence + stamp
#   itf template build [--base B] [--profile storage|compute]
#                                     [--sw-source ..] [--force]
#                                     rebuild a baseline template (storage:
#                                     Debian + product; compute: PVE from
#                                     the auto-installer ISO)
#   itf template destroy [--base B] [--profile storage|compute]
#                                     remove a baseline template
#   itf journey list                  list available journeys
#   itf journey run NAME              execute a journey under a run report
#   itf watch [TAG]                   tail a run's live report + serial
#                                     transcript (Ctrl-C stops) — the safe
#                                     alternative to opening a PVE console
#   itf status [BASE...]              base + guest + active/recent-run overview
#   itf manual-steps                  what a human must do before running
#   itf version
#
# Environment: ITF_DRY_RUN=1 prints guarded base commands instead of
# executing them.

# Strict mode covers the driver's own plumbing (dispatch, preflight,
# status, list, watch) — any unhandled error fails fast.  The journey and
# template-build entry points below deliberately capture their rc with
# "|| rc=$?": errexit is suppressed for their whole extent, preserving the
# step-failure accumulation and always-finish-the-report contract
# documented in journeys/README.md.
set -euo pipefail

ITF_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/config-lib.sh"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/ssh-lib.sh"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/base-lib.sh"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/guest-lib.sh"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/template-lib.sh"
# shellcheck disable=SC1091
source "$ITF_BIN_DIR/lib/report-lib.sh"

itf_usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//' | sed -n '/^Usage:/,$p'
    exit "${1:-0}"
}

# ---------------------------------------------------------------------------
# preflight
# ---------------------------------------------------------------------------

cmd_preflight() {
    itf_config_load
    itf_report_init preflight || return 1
    local base tool fail_total=0

    for tool in ssh scp curl python3; do
        if command -v "$tool" > /dev/null 2>&1; then
            itf_step pass "dev tool: $tool"
        else
            itf_step fail "dev tool: $tool" "missing on dev"
            fail_total=1
        fi
    done
    if [[ -f "$ITF_SSH_KEY" ]]; then
        itf_step pass "dev ssh public key" "$ITF_SSH_KEY"
    else
        itf_step fail "dev ssh public key" "$ITF_SSH_KEY not found"
        fail_total=1
    fi

    for base in "${ITF_BASE_HOSTS[@]}"; do
        local who
        who="$(itf_base_exec "$base" whoami 2>/dev/null)" || who=""
        if [[ "$who" == "root" ]]; then
            itf_step pass "[$base] ssh + passwordless sudo"
        else
            itf_step fail "[$base] ssh + passwordless sudo" "got '${who:-nothing}'"
            fail_total=1
            continue
        fi

        local ver
        ver="$(itf_read "$base" pveversion 2>/dev/null)" || ver=""
        if [[ -n "$ver" ]]; then
            itf_step pass "[$base] pveversion" "$ver"
        else
            itf_step fail "[$base] pveversion" "no output"
            fail_total=1
        fi

        local sm
        sm="$(itf_pvesm "$base" status 2>/dev/null)" || sm=""
        local st
        for st in "$ITF_GUEST_STORAGE" "$ITF_ISO_STORAGE"; do
            if printf '%s' "$sm" | awk -v s="$st" '$1==s && $3=="active" {f=1} END {exit !f}'; then
                itf_step pass "[$base] storage $st active"
            else
                itf_step fail "[$base] storage $st active" "not found/inactive in pvesm status"
                fail_total=1
            fi
        done

        # Guest-disk headroom: system + pool disk + 10 GiB snapshot margin.
        # pvesm status columns: Name Type Status Total Used Available %
        local avail_kib need_kib
        avail_kib="$(printf '%s' "$sm" | awk -v s="$ITF_GUEST_STORAGE" '$1==s {print $6}')"
        need_kib=$(( (ITF_GUEST_SYSTEM_DISK_GB + ITF_GUEST_POOL_DISK_GB + 10) * 1024 * 1024 ))
        if [[ "$avail_kib" =~ ^[0-9]+$ ]] && (( avail_kib >= need_kib )); then
            itf_step pass "[$base] guest-storage headroom" "$(( avail_kib / 1024 / 1024 )) GiB free"
        else
            itf_step fail "[$base] guest-storage headroom" \
                "need $(( need_kib / 1024 / 1024 )) GiB, have ${avail_kib:-unknown}"
            fail_total=1
        fi

        # Base RAM must cover the guest plus PVE itself.
        local mem_total mem_gib
        mem_total="$(itf_read "$base" free -h 2>/dev/null | awk '/^Mem:/ {print $2}')" \
            || mem_total=""
        mem_gib="${mem_total%Gi}"
        if [[ "$mem_gib" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
            && awk -v have="$mem_gib" -v need="$(( ITF_GUEST_MEMORY_MB / 1024 + 1 ))" \
                'BEGIN { exit !(have >= need) }'; then
            itf_step pass "[$base] base RAM" "$mem_total total"
        else
            itf_step fail "[$base] base RAM" \
                "$mem_total total, need >= $(( ITF_GUEST_MEMORY_MB / 1024 + 1 )) GiB"
            fail_total=1
        fi

        local virtflags
        virtflags="$(itf_read "$base" grep -c -E '(vmx|svm)' /proc/cpuinfo \
            2>/dev/null)" || virtflags=0
        if [[ "$virtflags" =~ ^[0-9]+$ && "$virtflags" -gt 0 ]]; then
            itf_step pass "[$base] nested virtualization" "vmx/svm on $virtflags CPUs"
        else
            itf_step fail "[$base] nested virtualization" "no vmx/svm in /proc/cpuinfo"
            fail_total=1
        fi

        if itf_read "$base" ip link show "$ITF_BRIDGE" > /dev/null 2>&1; then
            itf_step pass "[$base] bridge $ITF_BRIDGE"
        else
            itf_step fail "[$base] bridge $ITF_BRIDGE" "not present"
            fail_total=1
        fi

        if itf_read "$base" test -f "$ITF_ACTION_LOG" 2>/dev/null; then
            itf_step pass "[$base] action log" "$ITF_ACTION_LOG"
        else
            itf_step fail "[$base] action log" "$ITF_ACTION_LOG missing"
            fail_total=1
        fi

        local inrange
        inrange="$(itf_qm "$base" list 2>/dev/null \
            | awk -v f="$ITF_VMID_FIRST" -v l="$ITF_VMID_LAST" \
                'NR>1 && $1>=f && $1<=l {n++} END {print n+0}')" || inrange=""
        itf_step info "[$base] reserved VMIDs in use" \
            "$inrange guests in ${ITF_VMID_FIRST}-${ITF_VMID_LAST}"

        # The Debian installer ISO serves storage-role installs (guests
        # and the storage template); a compute-role base boots the PVE
        # custom ISO, built and uploaded on demand by the template build.
        if [[ "$base" == "${ITF_STORAGE_BASE:-}" ]]; then
            if itf_read "$base" ls -l "$ITF_ISO_DIR/template/iso" 2>/dev/null \
                    | grep -q "$ITF_ISO_NAME"; then
                itf_step pass "[$base] installer ISO" "$ITF_ISO_NAME present"
            else
                itf_step fail "[$base] installer ISO" \
                    "$ITF_ISO_NAME not on $ITF_ISO_DIR/template/iso —" \
                    "run: itf iso fetch && itf iso upload $base"
                fail_total=1
            fi
        else
            itf_step info "[$base] installer ISO" \
                "not required on a compute-role base"
        fi
    done

    # Baseline templates are optional infrastructure: absent is
    # informational (journeys can install from scratch), present but
    # unstamped is broken.  Each profile is expected on its role's base.
    local tmpl_vmid tmpl_stamp
    if [[ -n "${ITF_STORAGE_BASE:-}" ]]; then
        tmpl_vmid="$(itf_template_vmid "$ITF_STORAGE_BASE")" || tmpl_vmid=""
        if [[ -n "$tmpl_vmid" ]]; then
            if tmpl_stamp="$(itf_template_stamp_read "$ITF_STORAGE_BASE" "$tmpl_vmid" \
                    2>/dev/null)"; then
                itf_step pass "[$ITF_STORAGE_BASE] storage template" \
                    "$ITF_TEMPLATE_NAME (vmid $tmpl_vmid): ${tmpl_stamp#itf-stamp| }"
            else
                itf_step fail "[$ITF_STORAGE_BASE] storage template" \
                    "vmid $tmpl_vmid carries no readable itf stamp — rebuild: " \
                    "itf template build --force"
                fail_total=1
            fi
        else
            itf_step info "[$ITF_STORAGE_BASE] storage template" \
                "absent (optional) — create with: itf template build"
        fi
    fi
    if [[ -n "${ITF_COMPUTE_BASE:-}" && -n "${ITF_COMPUTE_TEMPLATE_NAME:-}" ]]; then
        tmpl_vmid="$(itf_template_vmid "$ITF_COMPUTE_BASE" "$ITF_COMPUTE_TEMPLATE_NAME")" \
            || tmpl_vmid=""
        if [[ -n "$tmpl_vmid" ]]; then
            if tmpl_stamp="$(itf_template_stamp_read "$ITF_COMPUTE_BASE" "$tmpl_vmid" \
                    2>/dev/null)"; then
                itf_step pass "[$ITF_COMPUTE_BASE] compute template" \
                    "$ITF_COMPUTE_TEMPLATE_NAME (vmid $tmpl_vmid): ${tmpl_stamp#itf-stamp| }"
            else
                itf_step fail "[$ITF_COMPUTE_BASE] compute template" \
                    "vmid $tmpl_vmid carries no readable itf stamp — rebuild: " \
                    "itf template build --base $ITF_COMPUTE_BASE --profile compute --force"
                fail_total=1
            fi
        else
            itf_step info "[$ITF_COMPUTE_BASE] compute template" \
                "absent (optional) — create with: itf template build --base" \
                "$ITF_COMPUTE_BASE --profile compute"
        fi
    fi

    # Two-node extras: the PVE ISO is consumed on dev (customize rebuilds
    # the boot ISO from it), and nothing on the LAN should already hold
    # the planned point-to-point addresses.
    if [[ -n "${ITF_COMPUTE_BASE:-}" && -n "${ITF_PVE_ISO_NAME:-}" ]]; then
        if [[ -s "$ITF_CACHE_DIR/$ITF_PVE_ISO_NAME" ]]; then
            itf_step pass "[dev] PVE ISO cached" "$ITF_CACHE_DIR/$ITF_PVE_ISO_NAME"
        else
            itf_step fail "[dev] PVE ISO cached" "run: itf iso fetch pve"
            fail_total=1
        fi
    fi
    if [[ -n "${ITF_COMPUTE_BASE:-}" && -n "${ITF_ISCSI_STORAGE_IP:-}" ]]; then
        local neigh p2p
        neigh="$(itf_read "$ITF_COMPUTE_BASE" ip neigh show 2>/dev/null)" || neigh=""
        for p2p in "$ITF_ISCSI_STORAGE_IP" "$ITF_ISCSI_COMPUTE_IP"; do
            if printf '%s\n' "$neigh" | grep -q "^$p2p "; then
                itf_step info "[$ITF_COMPUTE_BASE] P2P IP $p2p" \
                    "already has an ARP entry — verify nothing lives there" \
                    "before a run assigns it statically"
            else
                itf_step pass "[$ITF_COMPUTE_BASE] P2P IP $p2p" "no ARP entry — free"
            fi
        done
    fi

    itf_report_finish > /dev/null || fail_total=1
    echo "itf: preflight result: $ITF_RUN_DIR/report.md"
    return "$fail_total"
}

# ---------------------------------------------------------------------------
# guest
# ---------------------------------------------------------------------------

cmd_guest() {
    itf_config_load
    local sub="${1:-}"
    [[ -z "$sub" ]] && itf_usage 2
    shift

    case "$sub" in
        create)
            (( $# < 1 )) && { echo "usage: itf guest create NAME [opts]" >&2; return 2; }
            itf_guest_create "$@"
            ;;
        clone)
            (( $# < 1 )) && { echo "usage: itf guest clone NAME [opts]" >&2; return 2; }
            itf_guest_clone "$@"
            ;;
        start|stop)
            (( $# < 2 )) && { echo "usage: itf guest $sub BASE VMID" >&2; return 2; }
            "itf_guest_$sub" "$1" "$2"
            ;;
        destroy)
            (( $# < 2 )) && { echo "usage: itf guest destroy BASE VMID" >&2; return 2; }
            itf_guest_destroy "$1" "$2"
            ;;
        snapshot)
            (( $# < 3 )) && { echo "usage: itf guest snapshot BASE VMID SNAP" >&2; return 2; }
            itf_guest_snapshot "$1" "$2" "$3"
            ;;
        rollback)
            (( $# < 3 )) && {
                echo "usage: itf guest rollback BASE VMID SNAP [--start]" >&2
                return 2
            }
            itf_guest_rollback "$1" "$2" "$3" "${4:-}"
            ;;
        ip)
            (( $# < 2 )) && { echo "usage: itf guest ip BASE VMID [timeout]" >&2; return 2; }
            itf_guest_ip "$1" "$2" "${3:-300}"
            ;;
        wait-ssh)
            (( $# < 1 )) && { echo "usage: itf guest wait-ssh IP [timeout]" >&2; return 2; }
            itf_wait_ssh "$1" "${2:-900}"
            ;;
        list)
            local base="${1:-${ITF_BASE_HOSTS[0]}}"
            # An unreachable base prints an empty table, not an abort.
            itf_qm "$base" list | awk -v f="$ITF_VMID_FIRST" -v l="$ITF_VMID_LAST" \
                'NR==1 || ($1>=f && $1<=l)' || true
            ;;
        *)
            echo "itf: unknown guest subcommand: $sub" >&2
            itf_usage 2
            ;;
    esac
}

# ---------------------------------------------------------------------------
# iso / journey / status / watch / manual-steps / version
# ---------------------------------------------------------------------------

cmd_iso() {
    itf_config_load
    local sub="${1:-}"
    case "$sub" in
        fetch) itf_iso_fetch "${2:-debian}" ;;
        upload)
            local base="${2:-${ITF_BASE_HOSTS[0]}}"
            local sel="${3:-debian}"
            case "$sel" in
                debian) itf_iso_upload "$base" "$ITF_ISO_NAME" ;;
                pve) itf_iso_upload "$base" "$ITF_PVE_ISO_NAME" ;;
                *) echo "usage: itf iso upload [BASE] [debian|pve]" >&2; return 2 ;;
            esac
            ;;
        *) echo "usage: itf iso fetch|upload [BASE] [debian|pve]" >&2; return 2 ;;
    esac
}

cmd_template() {
    itf_config_load
    local sub="${1:-}"
    [[ -z "$sub" ]] && {
        echo "usage: itf template status|build|destroy [--base ..] [--profile ..]" >&2
        return 2
    }
    shift
    case "$sub" in
        status) itf_template_status ;;
        build)
            ITF_RUN_CALLER="template:build"
            itf_report_init template-build || return 1
            local rc=0
            itf_template_build "$@" || rc=$?
            itf_report_finish || rc=1
            echo "itf: report: $ITF_RUN_DIR/report.md"
            return "$rc"
            ;;
        destroy) itf_template_destroy "$@" ;;
        *)
            echo "usage: itf template status|build|destroy [--base ..] [--profile ..]" >&2
            return 2
            ;;
    esac
}

cmd_journey() {
    itf_config_load
    local sub="${1:-}"
    case "$sub" in
        list)
            local j
            for j in "$ITF_ROOT"/journeys/*.journey; do
                [[ -f "$j" ]] || continue
                basename "$j" .journey
            done
            ;;
        run)
            local name="${2:-}"
            [[ -z "$name" ]] && { echo "usage: itf journey run NAME" >&2; return 2; }
            local jfile="$ITF_ROOT/journeys/$name.journey"
            [[ -f "$jfile" ]] || { echo "itf: no such journey: $name" >&2; return 2; }
            # shellcheck disable=SC1090
            source "$jfile"
            if [[ $(type -t journey_main 2>/dev/null) != "function" ]]; then
                echo "itf: journey file does not define journey_main: $jfile" >&2
                return 2
            fi
            # Consumed by itf_report_init (report-lib.sh) in this same shell.
            # shellcheck disable=SC2034
            ITF_RUN_CALLER="journey:$name"
            itf_report_init "$name" || return 1
            echo "itf: journey $name running (pid $$) — hands off guest/base" \
                "consoles; watch safely: itf watch"
            local rc=0
            journey_main || rc=$?
            if (( rc != 0 )); then
                itf_step fail "journey $name" "aborted with rc=$rc"
            fi
            itf_report_finish || rc=1
            echo "itf: report: $ITF_RUN_DIR/report.md"
            return "$rc"
            ;;
        *)
            echo "usage: itf journey list|run NAME" >&2
            return 2
            ;;
    esac
}

# _status_print_running <run-dir>
#
# One "active run" line: tag, pid, elapsed time, and the hands-off hint
# that keeps human consoles away from the serial line the orchestrator
# is driving.
_status_print_running() {
    local run="$1" meta="$1/meta.txt"
    local pid started_raw started age
    pid="$(awk -F': *' '/^pid:/{print $2; exit}' "$meta" 2>/dev/null)" || pid=""
    started_raw="$(awk -F': *' '/^started:/{print $2; exit}' "$meta" 2>/dev/null)" \
        || started_raw=""
    started="$(date -u -d "$started_raw" +%s 2>/dev/null)" || started=""
    age=""
    if [[ "$started" =~ ^[0-9]+$ ]]; then
        age=$(( $(date -u +%s) - started ))
        if (( age >= 3600 )); then
            age="$(( age / 3600 ))h$(( (age % 3600) / 60 ))m"
        else
            age="$(( age / 60 ))m"
        fi
    fi
    echo "  $(basename "$run")  pid ${pid:-?}${age:+, ${age} elapsed} — hands off" \
        "guest/base consoles; watch: itf watch"
}

cmd_status() {
    itf_config_load
    local -a bases=("$@")
    (( ${#bases[@]} == 0 )) && bases=("${ITF_BASE_HOSTS[@]}")
    local base
    for base in "${bases[@]}"; do
        echo "== $base =="
        itf_read "$base" pveversion 2>/dev/null || echo "(unreachable)"
        # Unreachable base: header shows (unreachable); empty table, no abort.
        itf_qm "$base" list 2>/dev/null | awk -v f="$ITF_VMID_FIRST" -v l="$ITF_VMID_LAST" \
            'NR==1 || ($1>=f && $1<=l)' || true
    done
    echo "== baseline template =="
    itf_template_status
    echo "== active run =="
    local -a runs=()
    mapfile -t runs < <(ls -1d "$ITF_RUNS_DIR"/run-* 2>/dev/null | sort -r)
    local run state shown=0
    for run in "${runs[@]}"; do
        state="$(itf_run_state "$run")"
        [[ "$state" == "running" ]] || continue
        _status_print_running "$run"
        shown=1
    done
    (( shown )) || echo "  none"
    echo "== recent runs =="
    for run in $(ls -1t "$ITF_RUNS_DIR" 2>/dev/null | head -3); do
        local summary
        summary="$(grep -m1 '^- total:' "$ITF_RUNS_DIR/$run/report.md" 2>/dev/null)" \
            || summary=""
        if [[ -z "$summary" ]] \
                && [[ "$(itf_run_state "$ITF_RUNS_DIR/$run")" == "interrupted" ]]; then
            summary="(interrupted)"
        fi
        echo "$run ${summary:+ → $summary}"
    done
}

cmd_watch() {
    itf_config_load
    local tag="${1:-}"
    local run state
    run="$(itf_watch_resolve "$tag")" || {
        echo "itf: no runs${tag:+ matching '$tag'} found under $ITF_RUNS_DIR" >&2
        return 2
    }
    state="$(itf_run_state "$run")"
    echo "itf: watching $(basename "$run") [$state] — run dir: $run"
    echo "itf: following steps.tsv, report.md, serial-install.log, serial-console.log"
    echo "itf: files yet to be created are picked up as the run writes them"
    echo "itf: Ctrl-C to stop — this reads transcripts only and touches no console"
    # tail -F retries not-yet-existing files; stderr (the cannot-open
    # chatter for files the run has not created yet) is noise, not signal.
    exec tail -n +1 -F \
        "$run/steps.tsv" "$run/report.md" \
        "$run/serial-install.log" "$run/serial-console.log" 2> /dev/null
}

cmd_manual_steps() {
    itf_config_load
    local needed=0
    echo "itf: manual steps currently required:"
    if [[ ! -f "$ITF_ROOT/site/config" ]]; then
        echo "  1. Create the site configuration:"
        echo "       cp $ITF_ROOT/site/config.example $ITF_ROOT/site/config"
        echo "     Edit it for your test environment."
        needed=1
    fi
    if [[ ! -s "$ITF_CACHE_DIR/$ITF_ISO_NAME" ]]; then
        echo "  2. Fetch the installer ISO (automated):"
        echo "       $0 iso fetch"
        needed=1
    fi
    if (( needed == 0 )); then
        echo "  (none — environment looks prepared; run '$0 preflight' for the full check)"
    fi
    echo ""
    echo "itf: standing operator rule — while a journey or preflight run is active:"
    echo "  - never open an itf guest's xterm.js/serial console in the PVE web UI:"
    echo "    the orchestrator drives that same serial line, and interleaved"
    echo "    keystrokes corrupt the install"
    echo "  - guest noVNC is look-don't-touch: no typing, no power buttons"
    echo "  - leave the base VM consoles (${ITF_BASE_HOSTS[*]}) alone entirely —"
    echo "    a human there is root with no guardrails"
    echo "  - check with '$0 status', watch safely with '$0 watch'"
}

cmd_version() {
    local repo_version
    repo_version="$(cat "$ITF_BIN_DIR/../../VERSION" 2>/dev/null || echo unknown)"
    echo "itf (tests/integrated) — repo version $repo_version"
}

main() {
    local cmd="${1:-}"
    [[ -z "$cmd" ]] && itf_usage 2
    shift

    case "$cmd" in
        -h|--help|help) itf_usage 0 ;;
        preflight) cmd_preflight "$@" ;;
        guest) cmd_guest "$@" ;;
        iso) cmd_iso "$@" ;;
        template) cmd_template "$@" ;;
        journey) cmd_journey "$@" ;;
        status) cmd_status "$@" ;;
        watch) cmd_watch "$@" ;;
        manual-steps) cmd_manual_steps "$@" ;;
        version) cmd_version "$@" ;;
        *)
            echo "itf: unknown command: $cmd" >&2
            itf_usage 2
            ;;
    esac
}

main "$@"
