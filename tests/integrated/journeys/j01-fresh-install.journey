#!/usr/bin/env bash
# j01-fresh-install.journey — flagship cycle-1 journey.
#
# A first-time end user on a fresh Debian system: download the latest
# GitHub release, run the prerequisite checker, run the single-node
# installer (answering its prompts), create the documented test pools,
# and verify the installed state.  Later cycles append the daily
# workflow stages (backup, offsite, retention, scrub, restore,
# schedule, GUI smoke).
#
# Guest state required: none — creates and installs its own guest.
# Snapshots produced: os-installed (clean Debian), pools-created.

# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

journey_main() {
    local base="${ITF_BASE_HOSTS[0]}"
    local gname="j01"
    local guest_hostname="itfj01"

    itf_step info "journey start" \
        "j01 fresh install; sw-source=$ITF_SW_SOURCE repo=$ITF_GITHUB_REPO"

    if itf_iso_fetch > /dev/null 2>&1; then
        itf_step pass "installer ISO cached" "$ITF_CACHE_DIR/$ITF_ISO_NAME"
    else
        itf_step fail "installer ISO cached" "itf iso fetch failed"
        return 1
    fi

    # ------------------------------------------------------------------
    # Stage A: OS install (preseed over HTTP, serial console)
    # Stage B: first-time user installs ZFSutilities
    # Stage C: verify the installed state
    # ------------------------------------------------------------------
    # Shared implementations live in common.sh (factored after J02/J03
    # adopted them; Stage D below is J01-specific).

    itf_journey_stage_os "$gname" "$guest_hostname" || return 1
    local vmid="$J_VMID"
    local guest_ip="$J_GUEST_IP"

    itf_journey_stage_install "$guest_ip" || return 1
    itf_journey_verify_installed "$guest_ip"

    # ------------------------------------------------------------------
    # Stage D: the documented three-RAIDZ1 test pools (shared stage; the
    # pool-disk-after-install rationale lives in common.sh)
    # ------------------------------------------------------------------

    itf_journey_stage_test_pools "$gname" "$base" "$vmid" "$guest_ip" || return 1

    itf_step info "journey stage reached" \
        "fresh-install stages complete; daily-workflow stages land in the next cycle"
    return 0
}
