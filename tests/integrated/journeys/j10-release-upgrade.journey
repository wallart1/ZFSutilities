#!/usr/bin/env bash
# j10-release-upgrade.journey — the release-upgrade journey.
#
# Real users upgrade far more often than they fresh-install, and the
# upgrade path (upgrade-zfsutilities -> change scan -> salvage ->
# deploy-version -> switch-version) had no journey coverage.
#
# The stale storage template is the old-version carrier: it full-clones
# into a genuinely installed system running an OLDER product version
# (0.118.0 at authorship), so "clone -> upgrade to the tree under test"
# is a real old-to-new upgrade with zero extra infrastructure.  The
# template must therefore stay STALE — rebuilding it at the latest
# release destroys j10's premise (the version gate below fails fast
# with that hint instead of half-running).
#
# Stage walk: the shared upgrade staging (itf_journey_stage_upgrade_env:
# premise gate, user download, change-scan baseline, served release) ->
# decline the download offer (system untouched) -> inject local
# modifications into the deployed old tree -> run the upgrade (scan
# detects MOD/ADD, lists them, asks, salvages, deploys the new version
# WITHOUT activating) -> verify the deployed-not-activated state and
# the salvage archive -> activate with switch-version -> verify
# wiring/config/version retention -> rerun the upgrade and see
# "Nothing to upgrade".  The upgrader runs FROM the downloaded tree —
# deployments older than 0.125.0, like the template's 0.118.0, have no
# upgrade-zfsutilities on PATH; the command ships in the release that
# introduces it.
#
# dev-tarball source: ZFSUTILITIES_RELEASE_API points the upgrade at an
# itf-served "latest release" (latest.json + a release-shaped tarball of
# the current dev tree — single top-level directory, like a GitHub
# tarball, which the upgrade's extractor requires).  release source: the
# guest talks to real GitHub, the true first-user path.
#
# The old version's change scan needs MANIFEST.sha256 in the deployed
# tree (0.125.0+) or the active version's GitHub tag tarball as the
# pristine baseline — and many released versions were never tagged
# (0.118.0 among them; the F-025 finding: the scan used to be silently
# skipped, now a baseline is captured from the current tree).  When the
# tag is missing, the journey captures the guest's as-deployed active
# tree and serves it via the documented ZFSUTILITIES_TAG_TARBALL_URL
# override, so the scan/salvage machinery is exercised regardless of
# tagging.
#
# Guest state required: post-install baseline template whose product
# version is strictly older than the tree under test.
# Snapshots produced: as-cloned (post-install checkpoint).

# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

journey_main() {
    local gname="j10"
    local vb=/usr/local/lib/zfsutilities

    itf_step info "journey start" \
        "j10 release upgrade; sw-source=$ITF_SW_SOURCE repo=$ITF_GITHUB_REPO"

    # ------------------------------------------------------------------
    # Stage T: clone start from the (deliberately stale) baseline
    # ------------------------------------------------------------------

    itf_journey_stage_from_template "$gname" || return 1
    local guest_ip="$J_GUEST_IP"

    itf_journey_verify_installed "$guest_ip"

    # ------------------------------------------------------------------
    # Stage E: the shared upgrade staging — premise gate, user download,
    # change-scan baseline, served release (common.sh)
    # ------------------------------------------------------------------

    itf_journey_stage_upgrade_env "$gname" || return 1
    local active_version="$J_ACTIVE_VERSION"
    local target_version="$J_TARGET_VERSION"
    local upgrade_cmd="$J_UPGRADE_CMD"

    # ------------------------------------------------------------------
    # Stage D: decline the download offer — nothing must change
    # ------------------------------------------------------------------

    local decline_feed="$ITF_RUN_DIR/upgrade-decline-answers.txt"
    printf 'n\n' > "$decline_feed"
    local dec_log="$ITF_RUN_DIR/guest-upgrade-decline.log"
    itf_guest_exec_feed "$guest_ip" "$decline_feed" "$upgrade_cmd" \
        > "$dec_log" 2>&1
    local dec_rc=$?
    itf_artifact "upgrade-decline-transcript" "$dec_log"
    if [[ $dec_rc -eq 0 ]] && grep -q "Aborted. Nothing was changed." "$dec_log"; then
        itf_step pass "declined upgrade aborts cleanly" \
            "rc=0, \"Aborted. Nothing was changed.\" (see guest-upgrade-decline.log)"
    else
        itf_step fail "declined upgrade aborts cleanly" \
            "rc=$dec_rc — see guest-upgrade-decline.log"
        return 1
    fi

    local dec_script="$ITF_RUN_DIR/guest-decline-verify.sh"
    cat > "$dec_script" <<EOF
set -e
cur=\$(basename "\$(readlink $vb/current)")
echo "active-now: \$cur"
test "\$cur" = "$active_version"
test ! -e "$vb/versions/$target_version"
test ! -e "$vb/salvaged-changes"
echo decline-unchanged-ok
EOF
    itf_guest_put "$guest_ip" "$dec_script" /root/itf-j10-decline.sh > /dev/null 2>&1
    if itf_guest_exec "$guest_ip" "bash /root/itf-j10-decline.sh" \
            > "$ITF_RUN_DIR/guest-decline-verify.log" 2>&1 \
            && grep -q decline-unchanged-ok "$ITF_RUN_DIR/guest-decline-verify.log"; then
        itf_step pass "declined upgrade left system untouched" \
            "active still $active_version, no new version dir, no salvage"
    else
        itf_step fail "declined upgrade left system untouched" \
            "see guest-decline-verify.log"
        return 1
    fi

    # ------------------------------------------------------------------
    # Stage M: inject local modifications a site might carry — the
    # upgrade's change scan must find and later salvage both
    # ------------------------------------------------------------------

    local mod_script="$ITF_RUN_DIR/guest-modify.sh"
    local tweak_bin="$vb/versions/$active_version/bin/itf-local-tweak"
    local tweak_doc="$vb/versions/$active_version/docs/docs/index.md"
    cat > "$mod_script" <<EOF
set -e
printf '\n<!-- itf local tweak (j10) -->\n' >> "$tweak_doc"
printf '#!/bin/bash\n# itf local addition (j10)\n' > "$tweak_bin"
chmod 755 "$tweak_bin"
sha256sum "$tweak_doc" "$tweak_bin"
echo injected-ok
EOF
    itf_guest_put "$guest_ip" "$mod_script" /root/itf-j10-modify.sh > /dev/null 2>&1
    if itf_guest_exec "$guest_ip" "bash /root/itf-j10-modify.sh" \
            > "$ITF_RUN_DIR/guest-modify.log" 2>&1 \
            && grep -q injected-ok "$ITF_RUN_DIR/guest-modify.log"; then
        itf_step pass "local modifications injected" \
            "docs/docs/index.md (modified) + bin/itf-local-tweak (added)"
    else
        itf_step fail "local modifications injected" "see guest-modify.log"
        return 1
    fi
    # The salvaged copy later must carry the LOCAL content — its hash is
    # compared against this one, not against the pristine release.  The
    # log's first line is the ssh host-key banner, so select by path.
    local injected_docs_hash=""
    injected_docs_hash="$(grep 'docs/docs/index.md' "$ITF_RUN_DIR/guest-modify.log" \
        | head -1 | awk '{print $1}')"

    # ------------------------------------------------------------------
    # Stage U: the upgrade — detect, list, ask, salvage, deploy, stop
    # ------------------------------------------------------------------

    # Every interactive prompt on the happy path answers y (download
    # offer; prerequisite remediation, if the new tree's checker finds
    # anything; the archive-changes offer).  Unconsumed lines are
    # harmless; both upgrade prompts default to N, so the y's must be
    # explicit.
    local upgrade_feed="$ITF_RUN_DIR/upgrade-answers.txt"
    printf 'y\ny\ny\ny\ny\ny\n' > "$upgrade_feed"
    local up_log="$ITF_RUN_DIR/guest-upgrade.log"
    itf_guest_exec_feed "$guest_ip" "$upgrade_feed" "$upgrade_cmd" \
        > "$up_log" 2>&1
    local up_rc=$?
    itf_artifact "upgrade-transcript" "$up_log"
    if [[ $up_rc -ne 0 ]]; then
        itf_step fail "upgrade completes" "rc=$up_rc — see guest-upgrade.log"
        return 1
    fi
    # rc alone can't prove the scan saw the injections or that the
    # upgrade stopped before activation — assert the transcript markers.
    local -a markers=(
        "modified:   docs/docs/index.md"
        "added:      bin/itf-local-tweak"
        "Salvaged on"
        "Deployed version:  $target_version — NOT activated"
        "Active version:    $active_version (unchanged on this host)"
        "sudo switch-version $target_version"
    )
    local marker missing_markers=""
    for marker in "${markers[@]}"; do
        grep -qF "$marker" "$up_log" || missing_markers+=" [$marker]"
    done
    if [[ -z "$missing_markers" ]]; then
        itf_step pass "upgrade completes" \
            "scan detected both injections, salvaged, deployed $target_version," \
            "stopped before activation and printed the switch-version command"
    else
        itf_step fail "upgrade completes" \
            "transcript markers missing:$missing_markers — see guest-upgrade.log"
        return 1
    fi

    # ------------------------------------------------------------------
    # Stage W1: deployed-but-NOT-activated state + salvage archive
    # ------------------------------------------------------------------

    local dep_script="$ITF_RUN_DIR/guest-deployed-verify.sh"
    cat > "$dep_script" <<EOF
set -e
cur=\$(basename "\$(readlink $vb/current)")
echo "active-now: \$cur"
test "\$cur" = "$active_version"
test -s "$vb/versions/$target_version/MANIFEST.sha256"
ts_dir="\$(ls -1d $vb/salvaged-changes/$active_version/*/ | head -1)"
test -n "\$ts_dir"
test -f "\$ts_dir/docs/docs/index.md"
test -f "\$ts_dir/bin/itf-local-tweak"
test -f "\$ts_dir/README.txt"
ls "$vb"/salvaged-changes/changes-*.diff > /dev/null
echo "salvaged-dir: \$ts_dir"
sha256sum "\$ts_dir/docs/docs/index.md"
cat "\$ts_dir/README.txt"
echo deployed-state-ok
EOF
    itf_guest_put "$guest_ip" "$dep_script" /root/itf-j10-deployed.sh > /dev/null 2>&1
    local dep_log="$ITF_RUN_DIR/guest-deployed-verify.log"
    if itf_guest_exec "$guest_ip" "bash /root/itf-j10-deployed.sh" \
            > "$dep_log" 2>&1 \
            && grep -q deployed-state-ok "$dep_log"; then
        local salvaged_docs_hash
        salvaged_docs_hash="$(awk '/salvaged-changes.*index.md/{print $1}' "$dep_log")"
        if [[ -n "$injected_docs_hash" && "$salvaged_docs_hash" == "$injected_docs_hash" ]]; then
            itf_step pass "deployed, not activated; salvage archived" \
                "current still $active_version; $target_version + MANIFEST deployed;" \
                "salvaged copies carry the LOCAL content (hash match)"
            itf_artifact "salvage-readme" "$dep_log"
        else
            itf_step fail "deployed, not activated; salvage archived" \
                "salvaged docs hash ${salvaged_docs_hash:-none} != injected $injected_docs_hash"
            return 1
        fi
    else
        itf_step fail "deployed, not activated; salvage archived" \
            "see guest-deployed-verify.log"
        return 1
    fi

    # ------------------------------------------------------------------
    # Stage A: activate — the command the upgrade printed for the user
    # ------------------------------------------------------------------

    local sw_log="$ITF_RUN_DIR/guest-switch.log"
    itf_guest_exec "$guest_ip" "bash -lc 'switch-version $target_version'" \
        > "$sw_log" 2>&1
    local sw_rc=$?
    itf_artifact "switch-transcript" "$sw_log"
    if [[ $sw_rc -eq 0 ]]; then
        itf_step pass "switch-version activates" \
            "rc=0 — the exact command the upgrade printed (see guest-switch.log)"
    else
        itf_step fail "switch-version activates" "rc=$sw_rc — see guest-switch.log"
        return 1
    fi

    # ------------------------------------------------------------------
    # Stage W2: post-upgrade wiring — new version active, old version
    # retained, user config preserved
    # ------------------------------------------------------------------

    local post_script="$ITF_RUN_DIR/guest-post-verify.sh"
    cat > "$post_script" <<EOF
set -e
cur=\$(basename "\$(readlink $vb/current)")
echo "active-now: \$cur"
test "\$cur" = "$target_version"
test -d "$vb/versions/$active_version"
grep -q 'NODE_MODE="single-node"' /etc/zfsutilities/node.conf
test -s /var/lib/zfsutilities/config.json
echo post-upgrade-ok
EOF
    itf_guest_put "$guest_ip" "$post_script" /root/itf-j10-post.sh > /dev/null 2>&1
    if itf_guest_exec "$guest_ip" "bash /root/itf-j10-post.sh" \
            > "$ITF_RUN_DIR/guest-post-verify.log" 2>&1 \
            && grep -q post-upgrade-ok "$ITF_RUN_DIR/guest-post-verify.log"; then
        itf_step pass "post-upgrade state verified" \
            "current -> $target_version; $active_version retained for rollback;" \
            "node.conf and config.json preserved"
    else
        itf_step fail "post-upgrade state verified" "see guest-post-verify.log"
        return 1
    fi
    itf_journey_verify_installed "$guest_ip"

    # ------------------------------------------------------------------
    # Stage R: an up-to-date system must be told so — nothing re-deployed
    # ------------------------------------------------------------------

    local uptodate_feed="$ITF_RUN_DIR/upgrade-uptodate-answers.txt"
    printf '\n' > "$uptodate_feed"
    local upd_log="$ITF_RUN_DIR/guest-upgrade-uptodate.log"
    itf_guest_exec_feed "$guest_ip" "$uptodate_feed" "$upgrade_cmd" \
        > "$upd_log" 2>&1
    local upd_rc=$?
    itf_artifact "upgrade-uptodate-transcript" "$upd_log"
    local upd_active
    # shellcheck disable=SC2016  # the $ expansions run in the guest
    upd_active="$(itf_guest_exec "$guest_ip" \
        'basename "$(readlink /usr/local/lib/zfsutilities/current)"')" || upd_active=""
    if [[ $upd_rc -eq 0 ]] && grep -q "Nothing to upgrade" "$upd_log" \
            && [[ "$upd_active" == "$target_version" ]]; then
        itf_step pass "up-to-date rerun is a no-op" \
            "\"Nothing to upgrade\"; current still $target_version"
    else
        itf_step fail "up-to-date rerun is a no-op" \
            "rc=$upd_rc active=${upd_active:-?} — see guest-upgrade-uptodate.log"
        return 1
    fi

    # The server's job is done; the EXIT-trap guard then skips.
    if [[ -n "${J_PIDFILE2:-}" ]]; then
        itf_http_stop "$J_PIDFILE2"
        J_PIDFILE2=""
    fi

    itf_step info "journey stage reached" \
        "release upgrade validated: decline, scan+salvage, deploy-not-activate," \
        "activate, retention, up-to-date rerun"
    return 0
}
