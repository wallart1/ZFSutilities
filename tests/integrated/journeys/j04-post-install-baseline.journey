#!/usr/bin/env bash
# j04-post-install-baseline.journey — baseline-template validation journey.
#
# Proves the post-install baseline template end to end: a full clone
# comes up as a working installed system (wiring, login PATH, product
# surface), takes the documented test pools, and performs real work
# through the installed product.  This is also the starting pattern for
# the cycle-2 daily-workflow journeys: clone from the template, then
# drive the scenario.
#
# Guest state required: post-install baseline template (itf template build).
# Snapshots produced: as-cloned (post-install checkpoint), pools-created.

# shellcheck source=common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/common.sh"

journey_main() {
    local gname="j04"

    itf_step info "journey start" \
        "j04 post-install baseline; sw-source=$ITF_SW_SOURCE repo=$ITF_GITHUB_REPO"

    # ------------------------------------------------------------------
    # Stages T + D: the single-node lab (clone, installed-state verify,
    # test pools — shared builder in common.sh)
    # ------------------------------------------------------------------

    itf_single_node_lab_main "$gname" || return 1
    local guest_ip="$J_GUEST_IP"

    # ------------------------------------------------------------------
    # Stage W: real work through the installed product
    # ------------------------------------------------------------------

    # The prerequisite checker is the one product CLI a user can run on
    # any installed system with no scenario setup: after a clone it must
    # report everything present and exit 0 — proving the wiring came
    # through the template intact, not just the files.
    local pre_log
    pre_log="$ITF_RUN_DIR/guest-prereq-postclone.log"
    if itf_guest_exec "$guest_ip" \
            "bash -lc 'check-prerequisites --single-node'" > "$pre_log" 2>&1; then
        itf_step pass "product surface works post-clone" \
            "check-prerequisites reports all-present (rc=0)"
        itf_artifact "prereq-postclone" "$pre_log"
    else
        itf_step fail "product surface works post-clone" \
            "see guest-prereq-postclone.log"
        return 1
    fi

    # And the ZFS substrate the product drives: a dataset + snapshot
    # round trip on a test pool, from the login shell the product wired.
    local zfs_log
    zfs_log="$ITF_RUN_DIR/guest-zfs-roundtrip.log"
    # shellcheck disable=SC2016  # the $ expansions run in the guest
    if itf_guest_exec "$guest_ip" '
        set -e
        zfs create zfstest1/j04
        zfs snapshot zfstest1/j04@baseline-check
        zfs list -t snapshot -o name,creation -s creation | tail -3
        zfs destroy zfstest1/j04@baseline-check
        echo "zfs-roundtrip-ok"
    ' > "$zfs_log" 2>&1 && grep -q zfs-roundtrip-ok "$zfs_log"; then
        itf_step pass "ZFS substrate round trip" \
            "dataset + snapshot + destroy on zfstest1 (see guest-zfs-roundtrip.log)"
        itf_artifact "zfs-roundtrip" "$zfs_log"
    else
        itf_step fail "ZFS substrate round trip" "see guest-zfs-roundtrip.log"
        return 1
    fi

    itf_step info "journey stage reached" \
        "post-install baseline validated: clone, wiring, pools, product surface"
    return 0
}
