test_expected_lun_for_zvol_efi_offset_data_disk() {
    test_start "fallback maps a non-EFI data disk when EFI consumes disk-0"

    local tmp_dir pve_dir
    tmp_dir=$(mktemp -d)
    pve_dir="$tmp_dir/qemu-server"
    mkdir -p "$pve_dir"
    cat > "$pve_dir/215.conf" << 'EOF'
efidisk0: /dev/disk/by-path/ip-1.1.1.1:3260-iscsi-iqn.local:threeamigos-lun-30,efitype=4m,size=4M
scsi0: /dev/disk/by-path/ip-1.1.1.1:3260-iscsi-iqn.local:threeamigos-lun-31,size=50G
EOF

    PVE_CONF_DIR="$pve_dir"
    STORAGE_IP="1.1.1.1"
    IQN_PREFIX="iqn.local"
    declare -A POOL_TARGET=([threeamigos]="threeamigos")
    unset '_assigned_config_luns'

    local lun
    lun=$(expected_lun_for_zvol "threeamigos/proxmox/vm-215-disk-0" "215" "0" "4M")
    assert_equals "30" "$lun" || { rm -rf "$tmp_dir"; return; }

    lun=$(expected_lun_for_zvol "threeamigos/proxmox/vm-215-disk-1" "215" "1" "50G")
    assert_equals "31" "$lun"

    rm -rf "$tmp_dir"
}

test_expected_lun_for_zvol_efi_offset_multiple_data_disks() {
    test_start "fallback assigns unused non-EFI LUNs to multiple data disks"

    local tmp_dir pve_dir
    tmp_dir=$(mktemp -d)
    pve_dir="$tmp_dir/qemu-server"
    mkdir -p "$pve_dir"
    cat > "$pve_dir/215.conf" << 'EOF'
efidisk0: /dev/disk/by-path/ip-1.1.1.1:3260-iscsi-iqn.local:threeamigos-lun-30,efitype=4m,size=4M
scsi0: /dev/disk/by-path/ip-1.1.1.1:3260-iscsi-iqn.local:threeamigos-lun-31,size=50G
scsi1: /dev/disk/by-path/ip-1.1.1.1:3260-iscsi-iqn.local:threeamigos-lun-32,size=100G
EOF

    PVE_CONF_DIR="$pve_dir"
    STORAGE_IP="1.1.1.1"
    IQN_PREFIX="iqn.local"
    declare -A POOL_TARGET=([threeamigos]="threeamigos")
    unset '_assigned_config_luns'

    local lun
    # EFI disk consumes zvol disk-0; data disks are disk-5 and disk-6, which do
    # not match scsi0/scsi1 indices, so the fallback path must assign them.
    lun=$(expected_lun_for_zvol "threeamigos/proxmox/vm-215-disk-0" "215" "0" "4M")
    assert_equals "30" "$lun" || { rm -rf "$tmp_dir"; return; }

    lun=$(expected_lun_for_zvol "threeamigos/proxmox/vm-215-disk-5" "215" "5" "50G")
    assert_equals "31" "$lun" || { rm -rf "$tmp_dir"; return; }

    lun=$(expected_lun_for_zvol "threeamigos/proxmox/vm-215-disk-6" "215" "6" "100G")
    assert_equals "32" "$lun"

    rm -rf "$tmp_dir"
}

