# ---------------------------------------------------------------------------
# Regression tests for storage-side helper execution
# ---------------------------------------------------------------------------

_bash_calls=()
_ssh_calls=()

bash() {
    local script
    script=$(cat)
    _bash_calls+=("args=$*|script=${script}")
    return 0
}

ssh() {
    local script
    script=$(cat)
    _ssh_calls+=("args=$*|script=${script}")
    return 0
}

test_run_on_storage_remote_forwards_heredoc() {
    test_start "run_on_storage forwards heredoc and args to remote storage host"

    MY_HOST="tweety"
    STORAGE_HOST="stewie"
    _ssh_calls=()

    run_on_storage "alpha" "beta gamma" <<'EOF'
printf '%s\n' "$1" "$2"
EOF

    assert_equals "1" "${#_ssh_calls[@]}" || return
    assert_contains "${_ssh_calls[0]}" "root@stewie bash -s alpha beta gamma" || return
    assert_contains "${_ssh_calls[0]}" "printf '%s\\n' \"\$1\" \"\$2\""
}

test_run_on_storage_local_forwards_heredoc() {
    test_start "run_on_storage forwards heredoc and args to local storage host"

    MY_HOST="stewie"
    STORAGE_HOST="stewie"
    _bash_calls=()

    run_on_storage "one" "two three" <<'EOF'
echo "$1" "$2"
EOF

    assert_equals "1" "${#_bash_calls[@]}" || return
    assert_contains "${_bash_calls[0]}" "args=-s one two three" || return
    assert_contains "${_bash_calls[0]}" 'echo "$1" "$2"'
}

test_is_local_host() {
    test_start "is_local_host matches the local hostname exactly"

    local rc
    MY_HOST="stewie"
    is_local_host "stewie"; rc=$?
    assert_rc 0 "$rc" || return
    is_local_host "tweety"; rc=$?
    assert_rc 1 "$rc"
}

test_read_compute_file_local() {
    test_start "read_compute_file returns local file contents"

    local tmp_dir expected actual
    tmp_dir=$(mktemp -d)
    expected="scsi0: /dev/disk/by-path/ip-1.1.1.1:3260-lun-0"
    printf '%s\n' "$expected" > "$tmp_dir/100.conf"

    MY_HOST="stewie"
    COMPUTE_HOST="stewie"
    PVE_CONF_DIR="$tmp_dir"
    actual=$(read_compute_file "$tmp_dir/100.conf")
    assert_equals "$expected" "$actual"

    rm -rf "$tmp_dir"
}

test_exec_on_storage_remote_forwards_command() {
    test_start "exec_on_storage forwards command to remote storage host"

    MY_HOST="tweety"
    STORAGE_HOST="stewie"
    _ssh_calls=()

    local _saved_ssh
    _saved_ssh=$(declare -f ssh)
    ssh() {
        _ssh_calls+=("args=$*")
        return 0
    }
    exec_on_storage "targetcli ls /iscsi"
    eval "$_saved_ssh"

    assert_equals "1" "${#_ssh_calls[@]}" || return
    assert_contains "${_ssh_calls[0]}" "root@stewie targetcli ls /iscsi"
}

test_ensure_lun_on_storage_sends_correct_storage_script() {
    test_start "ensure_lun_on_storage forwards correct script and args"

    MY_HOST="stewie"
    STORAGE_HOST="stewie"
    _bash_calls=()
    _mock_zfs_props=()
    _mock_zfs_props["threeamigos/proxmox/vm-215-disk-0:encryption"]="off"

    ensure_lun_on_storage \
        "threeamigos/proxmox/vm-215-disk-0" \
        "iqn.2026-02.local.stewie:threeamigos" \
        "31" \
        "N"

    assert_equals "2" "${#_bash_calls[@]}" || return

    local expected_args
    expected_args="args=-s threeamigos/proxmox/vm-215-disk-0 "
    expected_args+="/dev/zvol/threeamigos/proxmox/vm-215-disk-0 "
    expected_args+="vm-215-disk-0 iqn.2026-02.local.stewie:threeamigos 31 N"
    assert_contains "${_bash_calls[0]}" "$expected_args" || return
    assert_contains "${_bash_calls[0]}" 'ZVOL="$1"' || return
    assert_contains "${_bash_calls[0]}" "targetcli /backstores/block create" || return

    expected_args="args=-s vm-215-disk-0 "
    expected_args+="/dev/zvol/threeamigos/proxmox/vm-215-disk-0 threeamigos N"
    assert_contains "${_bash_calls[1]}" "$expected_args" || return
    assert_contains "${_bash_calls[1]}" 'BSNAME="$1"'
}

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
test_run_on_storage_remote_forwards_heredoc
test_run_on_storage_local_forwards_heredoc
test_is_local_host
test_read_compute_file_local
test_exec_on_storage_remote_forwards_command
test_ensure_lun_on_storage_sends_correct_storage_script

