test_ensure_iscsi_target_stack_already_installed() {
    test_start "ensure_iscsi_target_stack returns 0 when LIO stack is present"

    command() {
        if [[ "$1" == "-v" && "$2" == "targetcli" ]]; then
            return 0
        fi
        # Forward other command invocations to the builtin.
        builtin command "$@"
    }
    systemctl() { [[ "$1" == "cat" && "$2" == "rtslib-fb-targetctl" ]] && return 0 || return 1; }

    local output rc
    output=$(ensure_iscsi_target_stack 2>&1)
    rc=$?

    unset -f command systemctl 2>/dev/null || true

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0 when stack is installed, got $rc"
        return
    fi
    if [[ "$output" != *"targetcli found"* ]] ||\
       [[ "$output" != *"rtslib-fb-targetctl.service found"* ]]; then
        test_fail "Expected found messages in output, got: $output"
        return
    fi
    test_pass
}

test_ensure_iscsi_target_stack_declines_install() {
    test_start "ensure_iscsi_target_stack returns 1 when user declines install"

    command() {
        if [[ "$1" == "-v" && "$2" == "targetcli" ]]; then
            return 1
        fi
        builtin command "$@"
    }
    systemctl() { [[ "$1" == "cat" && "$2" == "rtslib-fb-targetctl" ]] && return 1 || return 0; }
    ask_yn() { return 1; }

    local rc
    ensure_iscsi_target_stack >/dev/null 2>&1
    rc=$?

    unset -f command systemctl ask_yn 2>/dev/null || true

    if [[ $rc -ne 1 ]]; then
        test_fail "Expected rc=1 when user declines, got $rc"
        return
    fi
    test_pass
}

test_ensure_iscsi_target_stack_installs_and_enables() {
    test_start "ensure_iscsi_target_stack installs and enables LIO stack"

    command() {
        if [[ "$1" == "-v" && "$2" == "targetcli" ]]; then
            return 1
        fi
        builtin command "$@"
    }
    systemctl() {
        if [[ "$1" == "cat" && "$2" == "rtslib-fb-targetctl" ]]; then
            return 1
        fi
        return 0
    }
    ask_yn() { return 0; }
    local marker
    marker=$(mktemp)
    apt_install() { echo "$1" > "$marker"; return 0; }

    local output rc
    output=$(ensure_iscsi_target_stack 2>&1)
    rc=$?

    local installed_package=""
    [[ -f "$marker" ]] && installed_package=$(cat "$marker")
    rm -f "$marker"
    unset -f command systemctl ask_yn apt_install 2>/dev/null || true

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0 after successful install, got $rc"
        return
    fi
    if [[ "$installed_package" != "targetcli-fb" ]]; then
        test_fail "Expected apt_install to be called with targetcli-fb, got: $installed_package"
        return
    fi
    if [[ "$output" != *"Enabling rtslib-fb-targetctl.service"* ]]; then
        test_fail "Expected enable output, got: $output"
        return
    fi
    test_pass
}

