test_ensure_open_iscsi_remote_installs_and_enables() {
    test_start "ensure_open_iscsi_remote installs and enables open-iscsi"

    local marker
    marker=$(mktemp)
    ssh() {
        if [[ "$*" == *"command -v iscsiadm"* ]]; then
            echo "check" >> "$marker"
            return 1
        fi
        if [[ "$*" == *"apt-get install"* ]]; then
            echo "install" >> "$marker"
            return 0
        fi
        return 1
    }
    ask_yn() { return 0; }

    local output rc
    output=$(ensure_open_iscsi_remote "compute" 2>&1)
    rc=$?

    local calls=""
    [[ -f "$marker" ]] && calls=$(cat "$marker")
    rm -f "$marker"
    unset -f ssh ask_yn 2>/dev/null || true

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0 after successful install, got $rc"
        return
    fi
    if [[ "$calls" != *"check"* ]]; then
        test_fail "Expected ssh check for iscsiadm"
        return
    fi
    if [[ "$calls" != *"install"* ]]; then
        test_fail "Expected ssh install command"
        return
    fi
    test_pass
}

