test_holding_pool_mode_full_cycle() {
    test_start "holding pool: stage out, destroy + release origin, copy back, swap in"
    sever_have_blkdev \
        || { test_skip "no block device on host for the fake /dev/zvol tree"; return; }
    local vmid=410 env out rc
    env=$(sever_env_new)
    # tank is tight (free 3G < 11G needed for a 10G copy); hold has room.
    sever_seed_pool "$env" tank 3000000000
    sever_seed_pool "$env" holdpool 30000000000
    sever_seed_fs "$env" tank/proxmox
    sever_seed_fs "$env" holdpool
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-0 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-0@clone-origin 8000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        "tank/proxmox/vm-${vmid}-disk-0" 1000000000 10000000000
    local daily="tank/proxmox/vm-${vmid}-disk-0@dailybackup-2026-07-01T07:00Z-d"
    sever_seed_snap "$env" "$daily"
    sever_seed_hold "$env" "$daily" zfsutilities-backup
    sever_devtree_link "$env" "tank/proxmox/vm-${vmid}-disk-0"

    SEVER_STDIN="holdpool
y
y
"
    out=$(sever_run "$env" "$vmid")
    rc=$?
    SEVER_STDIN=""

    if [[ $rc -ne 0 ]]; then
        test_fail "unexpected exit $rc; output:\n$out"
        return
    fi
    # Plan-time tight-space findings.
    assert_contains "$out" "NOT enough"
    assert_contains "$out" "Recommended transfer mode: intermediate holding pool"
    # Transfer-time precheck routes the tight pool's disks to the holding pool.
    local want="Pool tank is tight — its disks' copies stage in the holding pool "
    want+="holdpool."
    assert_contains "$out" "$want"
    assert_contains "$out" "Copy-back space pre-check"
    # feasible: 3G free + 1G diverged + 8G origin snapshot >= 11G needed
    assert_contains "$out" "— feasible."

    # Engine invocations: full into the holding pool, catch-up into it, then
    # the copy-back full into the source-pool temp namespace.
    assert_equals "2" "$(sever_engine_count "$env" full)"
    assert_equals "1" "$(sever_engine_count "$env" catchup)"
    # The holding-pool copy is received twice: the phase-1 full and the
    # cutover catch-up both land in it before the swap.
    assert_equals "2" "$(sever_op_count "$env" RECEIVE \
        "holdpool/sever_${vmid}/vm-${vmid}-disk-0")"
    assert_equals "1" "$(sever_op_count "$env" RECEIVE \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0")"

    # Ordering: destroy original -> destroy confirmed origin -> copy-back
    # receive -> rename into place -> holding copy destroyed.
    local p_destroy p_origin p_recv p_rename p_hfree
    p_destroy=$(sever_op_first "$env" DESTROY "tank/proxmox/vm-${vmid}-disk-0")
    p_origin=$(sever_op_first "$env" DESTROY \
        "tank/proxmox/vm-100-disk-0@clone-origin")
    p_recv=$(sever_op_first "$env" RECEIVE \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0")
    p_rename=$(sever_op_first "$env" RENAME \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0" \
        "tank/proxmox/vm-${vmid}-disk-0")
    p_hfree=$(sever_op_first "$env" DESTROY \
        "holdpool/sever_${vmid}/vm-${vmid}-disk-0")
    if [[ -z "$p_destroy" || -z "$p_origin" || -z "$p_recv" || -z "$p_rename" \
        || -z "$p_hfree" ]]; then
        test_fail "missing expected holding-mode oplog entries:
destroy=$p_destroy origin=$p_origin recv=$p_recv rename=$p_rename hfree=$p_hfree
oplog:
$(cat "$env/state/oplog")
engine:
$(cat "$env/state/enginelog" 2>/dev/null)"
        return
    fi
    if (( p_destroy >= p_origin || p_origin >= p_recv || p_recv >= p_rename \
        || p_rename >= p_hfree )); then
        test_fail "holding-mode ordering violated:
destroy=$p_destroy origin=$p_origin recv=$p_recv rename=$p_rename hfree=$p_hfree
oplog:
$(cat "$env/state/oplog")"
        return
    fi
    test_pass

    # The origin was destroyed at the cutover (the confirmed release), so the
    # report shows it already gone; the swapped-in zvol is origin-free with
    # the hold reapplied.
    assert_contains "$out" "already destroyed; nothing pinned"
    assert_equals "-" "$(sever_field "$env" "tank/proxmox/vm-${vmid}-disk-0" 3)"
    assert_equals "zfsutilities-backup" "$(sever_holds_of "$env" "$daily")"
    if sever_snap_exists "$env" "tank/proxmox/vm-${vmid}-disk-0@${SEVER_CUT_SNAP}"; then
        test_fail "scaffolding snapshot survived the holding-mode swap"
        return
    fi
