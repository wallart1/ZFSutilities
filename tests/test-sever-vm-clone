SEVER_ENV_SEQ=0
# Per-test environment: isolated mock state, lock dir, node.conf, devtree,
# and (for two-node runs) the system-config dir holding the iSCSI manifest
# and encrypted-luns conf the storage-side worker keeps in step. "two" makes
# this host the compute host ("storhost" is the storage host — the ssh stub
# executes the storage side locally against the same mock state).
sever_env_new() {
    ((SEVER_ENV_SEQ++))
    local env="$_mock_zfs_state_dir/env$SEVER_ENV_SEQ"
    mkdir -p "$env/state" "$env/lock" "$env/devtree" "$env/etcz"
    # State-file isolation: cutover aborts (deliberate in the crash tests,
    # unavoidable in a failing run) can leave /tmp/sever-vm-clone-*.state
    # files behind, and the recovery tests locate their state file by
    # globbing /tmp — a stale file from an earlier test or run would be
    # picked up (sorted oldest-first) and --continue would resume from the
    # wrong phase. Every test builds its env before running the script, so
    # sweeping here makes each test start with no sever state files at all.
    rm -f /tmp/sever-vm-clone-*.state*
    if [[ "${1:-single}" == "two" ]]; then
        cat > "$env/node.conf" << EOF
NODE_MODE="two-node"
STORAGE_HOST="storhost"
COMPUTE_HOST="$(hostname -s)"
STORAGE_IP="10.203.0.9"
IQN_PREFIX="iqn.2026-01.test.example"
declare -A POOL_TARGET=(
    [tank]="storage"
)
EOF
    else
        printf 'NODE_MODE=single-node\n' > "$env/node.conf"
    fi
    : > "$env/state/datasets"
    : > "$env/state/snaps"
    : > "$env/state/holds"
    : > "$env/state/pools"
    : > "$env/state/oplog"
    : > "$env/state/enginelog"
    # Full hermetic reset (the env counter does not survive the env=$(...)
    # command substitution, so tests share one env directory): drop every
    # test knob and the two-node capture files the runs append to.
    rm -f "$env/state/zfs_fail" "$env/state/guid_override" \
        "$env/state/engine_fail" "$env/state/engine_drain" \
        "$env/state/keystatus" "$env/state/seq"
    : > "$env/state/sshlog"
    : > "$env/state/tc-backstores"
    : > "$env/state/tc-luns"
    echo "$env"
}

