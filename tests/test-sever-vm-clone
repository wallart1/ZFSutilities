    awk -F'\t' -v d="$2" -v f="$3" '$1==d{print $f; exit}' "$1/state/datasets"
}
sever_ds_exists() {
    awk -F'\t' -v d="$2" '$1==d{f=1} END{exit f?0:1}' "$1/state/datasets"
}
sever_snap_exists() {
    awk -F'\t' -v s="$2" '$1==s{f=1} END{exit f?0:1}' "$1/state/snaps"
}
sever_holds_of() {    # env ds@snap -> tags, one per line
    awk -F'\t' -v s="$2" '$1==s{print $2}' "$1/state/holds"
}

# oplog matchers: line numbers / counts of ops whose leading fields match.
sever_op_first() {    # env f1 [f2 [f3]] -> first matching line number
    local env="$1"; shift
    case $# in
        1) awk -F'\t' -v a="$1" '$1==a{print NR; exit}' "$env/state/oplog" ;;
        2) awk -F'\t' -v a="$1" -v b="$2" '$1==a&&$2==b{print NR; exit}' \
               "$env/state/oplog" ;;
        3) awk -F'\t' -v a="$1" -v b="$2" -v c="$3" \
               '$1==a&&$2==b&&$3==c{print NR; exit}' "$env/state/oplog" ;;
        *) return 2 ;;
    esac
}
sever_op_last() {
    local env="$1"; shift
    case $# in
        1) awk -F'\t' -v a="$1" '$1==a{last=NR} END{print last}' \
               "$env/state/oplog" ;;
        2) awk -F'\t' -v a="$1" -v b="$2" '$1==a&&$2==b{last=NR} END{print last}' \
               "$env/state/oplog" ;;
        3) awk -F'\t' -v a="$1" -v b="$2" -v c="$3" \
               '$1==a&&$2==b&&$3==c{last=NR} END{print last}' \
               "$env/state/oplog" ;;
        *) return 2 ;;
    esac
}
sever_op_count() {
    local env="$1"; shift
    case $# in
        1) awk -F'\t' -v a="$1" '$1==a{n++} END{print n+0}' "$env/state/oplog" ;;
        2) awk -F'\t' -v a="$1" -v b="$2" '$1==a&&$2==b{n++} END{print n+0}' \
               "$env/state/oplog" ;;
        3) awk -F'\t' -v a="$1" -v b="$2" -v c="$3" \
               '$1==a&&$2==b&&$3==c{n++} END{print n+0}' "$env/state/oplog" ;;
        *) return 2 ;;
    esac
}
sever_engine_count() { # env [mode] -> engine invocations
    if [[ ! -f "$1/state/enginelog" ]]; then
        echo 0
        return
    fi
    if [[ -n "${2:-}" ]]; then
        awk -F'\t' -v m="$2" '$2==m{n++} END{print n+0}' "$1/state/enginelog"
    else
        wc -l < "$1/state/enginelog" | tr -d ' '
    fi
}

# oplog matchers by regex (TARGETCLI/SSH-EXEC/SAFE-ISCSI-SAVE/RESCAN-STORAGE
# lines have variable argument shapes, unlike the fixed-field zfs ops).
sever_log_first() {   # env eregex -> first matching line number
    awk -v re="$2" '$0 ~ re {print NR; exit}' "$1/state/oplog"
}
sever_log_last() {    # env eregex -> last matching line number
    awk -v re="$2" '{if ($0 ~ re) last=NR} END{print last}' "$1/state/oplog"
}
sever_log_count() {   # env eregex -> matching line count
    awk -v re="$2" '$0 ~ re {n++} END{print n+0}' "$1/state/oplog"
}

# sshlog matchers: SSH\t<command> lines record every stubbed ssh call;
# SSH-BODY..SSH-BODY-END sections hold the streamed worker scripts.
sever_ssh_count() {   # env substr -> SSH lines containing substr
    [[ -f "$1/state/sshlog" ]] || { echo 0; return; }
    grep -c -- "$2" "$1/state/sshlog" || true
}
sever_ssh_has_body() { # env substr -> 0 when a recorded body contains substr
    [[ -f "$1/state/sshlog" ]] || return 1
    awk '/^SSH-BODY$/{inbody=1; next} /^SSH-BODY-END$/{inbody=0; next}
         inbody && index($0, s) > 0 {found=1} END{exit found?0:1}' \
        s="$2" "$1/state/sshlog"
}
sever_ssh_first() {   # env substr -> first SSH line containing substr
    awk -v s="$2" 'index($0, s) > 0 && $0 ~ /^SSH\t/ {print NR; exit}' \
        "$1/state/sshlog" 2>/dev/null
}
sever_ssh_nth() {     # env substr n -> line number of the nth matching SSH line
    awk -v s="$2" -v n="$3" \
        '$0 ~ /^SSH\t/ && index($0, s) > 0 {c++; if (c==n) {print NR; exit}}' \
        "$1/state/sshlog" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Runner: source the sever-vm-clone copy in a fed-stdin subshell (the
# test-archive-vm pattern), with the mock bin first on PATH.
# ---------------------------------------------------------------------------

sever_run() {
    local env="$1"; shift
    local stdin_data="${SEVER_STDIN:-}"
    (
        export PATH="$SEVER_MOCKBIN:$PATH"
        export MOCK_ZFS_STATE_DIR="$env/state"
        export SEVER_ZVOL_DEV_PREFIX="$env/devtree"
        export ZFSLOCK_DIR="$env/lock"
        export ZFSUTILITIES_LOCK_DIR="$env/lock"
        export ZFSLOCK_REMOTE_DISABLED=1
        export ZFSLOCK_WAIT_INTERVAL=0.01
        export NODE_CONF="$env/node.conf"
        export ZFSUTILITIES_NODE_CONF="$env/node.conf"
        export ZFSUTILITIES_DISABLE_MIGRATION=1
        # iSCSI bookkeeping files the storage-side worker maintains; both
        # are env-overridable in bin/sever-vm-clone (the family convention).
        export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$env/etcz"
        export ISCSI_MANIFEST="$env/etcz/expected-backstores.txt"
        export SEVER_QM_STATUS="${SEVER_QM_STATUS:-stopped}"
        # shellcheck source=tests/test-lib.sh
        source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
        # The file-backed mock CLI on PATH is the single zfs/zpool truth for
        # this process and every child shell; test-lib's function stubs would
        # shadow it, so drop them.
        unset -f zfs zpool
        hash -r
        # qm/pct/ssh/targetcli/udevadm stubs live in the mock bashinit so the
        # sever parent and its child-shell transfer/cutover workers all see
        # the same definitions. SEVER_NO_QM=1 leaves qm undefined there for
        # the Proxmox-guard test, so drop test-lib's copy here as well and
        # export the flag for the child shells.
        if [[ "${SEVER_NO_QM:-}" == "1" ]]; then
            export SEVER_NO_QM=1
            unset -f qm pct
        fi
        # shellcheck source=/dev/null
        source "$SEVER_MOCKBIN/sever-vm-clone" "$@"
    ) 2>&1 <<< "$stdin_data"
}

# Standard single-clone fixture: pool `tank`, origin zvol vm-100-disk-0 with
# @clone-origin, one clone zvol for <vmid>, and a held @dailybackup snapshot
# on the clone (holds must survive the swap).
sever_env_with_clone() {  # vmid -> echoes env; sets SEVER_* helpers' globals
    local vmid="$1"
    local env
    env=$(sever_env_new)
    sever_seed_pool "$env" tank 50000000000
    sever_seed_fs "$env" tank/proxmox
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-0 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-0@clone-origin 8000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        "tank/proxmox/vm-${vmid}-disk-0" 1000000000 10000000000
    sever_seed_snap "$env" "tank/proxmox/vm-${vmid}-disk-0@dailybackup-2026-07-01T07:00Z-d"
    sever_seed_hold "$env" "tank/proxmox/vm-${vmid}-disk-0@dailybackup-2026-07-01T07:00Z-d" \
        zfsutilities-backup
    sever_devtree_link "$env" "tank/proxmox/vm-${vmid}-disk-0"
    echo "$env"
}

SEVER_RUN_SNAP="sever-2025-06-15T14:00Z"            # test-lib's mocked date
