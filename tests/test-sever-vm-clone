__mock_set_size)
    name="$2"; used="$3"; ref="$4"
    awk -F'\t' -v d="$name" -v u="$used" -v r="$ref" \
        '$1==d{$4=u; $5=r} {print}' OFS='\t' "$STATE/datasets" \
        > "$STATE/datasets.next"
    mv "$STATE/datasets.next" "$STATE/datasets"
    exit 0
    ;;
__mock_set_snap_used)
    snap="$2"; used="$3"
    awk -F'\t' -v s="$snap" -v u="$used" '$1==s{$4=u} {print}' OFS='\t' \
        "$STATE/snaps" > "$STATE/snaps.next"
    mv "$STATE/snaps.next" "$STATE/snaps"
    exit 0
    ;;
*)
    exit 0
    ;;
esac
