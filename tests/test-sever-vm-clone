    # --- mock migration engine: the shapes sever-vm-clone drives (full -Rw
    # --- copy, catch-up -Rw -I incremental), performed through the mock CLI's
    # --- send|receive so snapshot GUIDs travel like real replication.
    cat > "$SEVER_MOCKBIN/zfs-migrate-send" << 'MOCKENGINE'
#!/usr/bin/bash
# Mock zfs-migrate-send for tests/test-sever-vm-clone. Sourced by
# sever-vm-clone's "bash -c" engine child with sourcefs/destfs/snapname
# [/fromsnap] assigned. Records each invocation to enginelog and performs
# the copy via the mock zfs CLI. engine_fail ("full"/"catchup" lines) makes
# the engine report an interrupted transfer (rc 8).
set -uo pipefail
STATE="${MOCK_ZFS_STATE_DIR:?MOCK_ZFS_STATE_DIR is not set}"
log_msg() { echo "ENGINE: $*" >&2; }
zfs_migrate_send() {
    local src="${sourcefs:-}" dst="${destfs:-}" snap="${snapname:-}"
    local from="${fromsnap:-}"
    if [[ -z "$src" || -z "$dst" || -z "$snap" ]]; then
        log_msg "FATAL: mock engine requires sourcefs, destfs, snapname."
        return 8
    fi
    local mode="full"
    [[ -n "$from" ]] && mode="catchup"
    printf 'ENGINE\t%s\t%s@%s\t%s\t%s\n' "$mode" "$src" "$snap" "$dst" "$from" \
        >> "$STATE/enginelog"
    # Rate-governance seam: record what the engine child shell sees of the
    # per-enclosure resolver override so tests can prove sever's bash -c
    # engine invocation inherits it (the real engine consults it through
    # lib/transfer-lib.sh; see test-transfer-lib).
    printf 'ENCLOSURE_RATE\t%s\n' "${ZFSUTILITIES_ENCLOSURE_RATE:-}" \
        >> "$STATE/engine_env"
    if [[ -f "$STATE/engine_fail" ]] && grep -qx "$mode" "$STATE/engine_fail"; then
        log_msg "FATAL: ${restart_hint:-sever-vm-clone} transfer interrupted (mock engine failure)."
        return 8
    fi
    local size rc
    if [[ "$mode" == "catchup" ]]; then
        size=$(zfs send -nPRw -I "${src}@${from}" "${src}@${snap}" \
            | awk '/^size/{print $2}')
        zfs send -Rw -I "${src}@${from}" "${src}@${snap}" \
            | zfs receive -u -F -s -v "$dst"
        rc=$?
    else
        size=$(zfs send -nPRw "${src}@${snap}" | awk '/^size/{print $2}')
        zfs send -Rw "${src}@${snap}" | zfs receive -u -F -s -v "$dst"
        rc=$?
    fi
    log_msg "INFO: mock engine ${mode} copy of ${src}@${snap} into ${dst}" \
        "complete (estimate ${size:-0} bytes, rc ${rc})."
    # Test knob engine_drain ("<destfs-prefix>\t<pool>\t<free>"): after a
    # successful copy whose destfs starts with the prefix, rewrite that
    # pool's free space — simulating space drifting between the plan-time
    # estimate and the cutover's fresh-number pre-check.
    if [[ $rc -eq 0 && -f "$STATE/engine_drain" ]]; then
        IFS=$'\t' read -r _pfx _pool _free < "$STATE/engine_drain"
        if [[ "$dst" == "$_pfx"* ]]; then
            awk -F'\t' -v p="$_pool" -v f="$_free" '$1==p{$2=f} {print}' \
                OFS='\t' "$STATE/pools" > "$STATE/pools.next"
            mv "$STATE/pools.next" "$STATE/pools"
        fi
    fi
    return "$rc"
}
