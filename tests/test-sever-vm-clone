    # out into the holding pool. Plan estimate: 3G free + 1G diverged + 8G
    # origin snapshot = 12G >= 11G — feasible on estimate; fresh numbers:
    # 0.5G + 1G + 8G = 9.5G < 11G — the gate must abort the cutover.
    printf 'holdpool/\ttank\t500000000\n' > "$env/state/engine_drain"

    SEVER_STDIN="holdpool
y
y
"
    out=$(sever_run "$env" "$vmid")
    rc=$?
    SEVER_STDIN=""

    assert_rc 1 "$rc"
    assert_contains "$out" "feasible on estimate"
    local want="The copy-back of tank/proxmox/vm-${vmid}-disk-0 would not fit in pool "
    want+="tank — aborting BEFORE destroying anything."
    assert_contains "$out" "$want"
    want="Nothing was destroyed; the fresh copies are safe in the holding pool "
    want+="holdpool."
    assert_contains "$out" "$want"
    # Ordering evidence: the copy-out ran (phase-1 full receive plus the
    # cutover's catch-up receive into the holding pool), and the copy-back
    # never started — the gate sits between them, before every destruction.
    assert_equals "1" "$(sever_engine_count "$env" full)"
    assert_equals "1" "$(sever_engine_count "$env" catchup)"
    assert_equals "2" "$(sever_op_count "$env" RECEIVE \
        "holdpool/sever_${vmid}/vm-${vmid}-disk-0")"
    assert_equals "0" "$(sever_op_count "$env" RECEIVE \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0")"
    assert_equals "0" "$(sever_op_count "$env" DESTROY)"
    assert_equals "0" "$(sever_op_count "$env" RELEASE)"
    # Everything untouched: the original is still a clone with its hold, the
    # origin snapshot survives, the staged copy waits in the holding pool,
    # and the state file is a --continue handle.
    assert_equals "tank/proxmox/vm-100-disk-0@clone-origin" \
        "$(sever_field "$env" "tank/proxmox/vm-${vmid}-disk-0" 3)"
    assert_equals "zfsutilities-backup" "$(sever_holds_of "$env" "$daily")"
    sever_snap_exists "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        && test_pass || test_fail "origin snapshot destroyed by the aborted gate"
    sever_ds_exists "$env" "holdpool/sever_${vmid}/vm-${vmid}-disk-0" \
        && test_pass || test_fail "holding-pool copy missing after the abort"
    if ! ls /tmp/sever-vm-clone-${vmid}-*.state >/dev/null 2>&1; then
        test_fail "no --continue state file left by the aborted gate"
        return
    fi
    test_pass
    rm -f /tmp/sever-vm-clone-${vmid}-*.state*
}

# ---------------------------------------------------------------------------
# Tests: two-node path (ssh stub per the tests/test-archive-vm pattern; the
# storage-side heredoc workers execute locally against the same mock state)
# ---------------------------------------------------------------------------

test_two_node_full_cycle() {
    test_start "two-node: ssh heredoc workers, iSCSI rewire at the same LUN ids, manifest " \
               "bookkeeping, rescan"
    sever_have_blkdev \
        || { test_skip "no block device on host for the fake /dev/zvol tree"; return; }
    local vmid=340 env out rc tgt="iqn.2026-01.test.example:storage"
    local d0="tank/proxmox/vm-340-disk-0" d1="tank/proxmox/vm-340-disk-1"
    env=$(sever_env_new two)
    sever_seed_pool "$env" tank 50000000000
    sever_seed_fs "$env" tank/proxmox
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-0 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-0@clone-origin 8000000000
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-1 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-1@clone-origin2 8000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        "$d0" 1000000000 10000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-1@clone-origin2 \
        "$d1" 1000000000 10000000000
    # disk-0 is encrypted and exported at LUN 1; disk-1 is plain, LUN 0 —
    # deliberately non-monotonic, so a reattach that merely auto-assigned
    # LUN ids could not reproduce the mapping.
    sever_seed_enc "$env" "$d0" aes-256-gcm
    sever_seed_iscsi "$env" "$tgt" "$d0" 1
    sever_seed_iscsi "$env" "$tgt" "$d1" 0
    sever_seed_manifest "$env" vm-340-disk-0 vm-340-disk-1
    sever_seed_encrypted_conf "$env" "vm-340-disk-0:/dev/zvol/${d0}:storage"
    sever_devtree_link "$env" "$d0"
    sever_devtree_link "$env" "$d1"

    # Prompts: proceed; at the origin report confirm disk-0's origin (typed),
    # decline disk-1's.
    SEVER_STDIN="y
y
tank/proxmox/vm-100-disk-0@clone-origin
n
"
    out=$(sever_run "$env" "$vmid")
    rc=$?
    SEVER_STDIN=""

    if [[ $rc -ne 0 ]]; then
        test_fail "unexpected exit $rc; output:\n$out"
        return
    fi
    assert_contains "$out" "Mode: two-node"
    assert_contains "$out" "iSCSI: target storage, LUN 1, backstore vm-340-disk-0."
    assert_contains "$out" "✓ ${d0} re-exported: target storage, LUN 1, backstore vm-340-disk-0."
    assert_contains "$out" "✓ ${d1} re-exported: target storage, LUN 0, backstore vm-340-disk-1."
    if [[ "$out" == *"LUN 1 was taken"* || "$out" == *"LUN 0 was taken"* ]]; then
        test_fail "the same-LUN re-export fell back to auto-assign; output:\n$out"
        return
    fi
    test_pass

    # The storage-host heredocs: discovery gather, transfer worker, per-disk
    # cutover workers, cleanup, and the remote origin destroy all ran over
    # ssh, with their bodies recorded — locks live inside the workers.
    assert_equals "2" "$(sever_ssh_count "$env" " two cutover ")"
    assert_equals "1" "$(sever_ssh_count "$env" " two cleanup ")"
    assert_equals "3" "$(sever_ssh_count "$env" "cat > ")"
    sever_ssh_has_body "$env" \
        "zfs list -H -p -o name,origin,used,referenced,encryption -t volume" \
        && test_pass || test_fail "discovery gather heredoc not captured"
    sever_ssh_has_body "$env" "zfs_migrate_send" \
        && test_pass || test_fail "transfer worker heredoc not captured"
    sever_ssh_has_body "$env" "zfslock_init" \
        && test_pass || test_fail "locks missing from the storage-side workers"
    sever_ssh_has_body "$env" "sev_iscsi_discover" \
        && test_pass || test_fail "cutover worker heredoc lacks the iSCSI discover"
    sever_ssh_has_body "$env" "sev_iscsi_teardown" \
        && test_pass || test_fail "cutover worker heredoc lacks the iSCSI teardown"
    sever_ssh_has_body "$env" "sev_iscsi_reattach" \
        && test_pass || test_fail "cutover worker heredoc lacks the iSCSI reattach"
    sever_ssh_has_body "$env" "sever-vm-clone origin release" \
        && test_pass || test_fail "remote origin-destroy heredoc not captured"

    # The state file travels: each worker run is preceded by its own push.
    local p1 p2 p3 c1 c2 cl
    p1=$(sever_ssh_nth "$env" "cat > " 1)
    c1=$(sever_ssh_nth "$env" " two cutover " 1)
    p2=$(sever_ssh_nth "$env" "cat > " 2)
    c2=$(sever_ssh_nth "$env" " two cutover " 2)
    p3=$(sever_ssh_nth "$env" "cat > " 3)
    cl=$(sever_ssh_nth "$env" " two cleanup " 1)
    if [[ -z "$p1" || -z "$p2" || -z "$p3" || -z "$c1" || -z "$c2" || -z "$cl" ]] \
        || (( p1 >= c1 || c1 >= p2 || p2 >= c2 || c2 >= p3 || p3 >= cl )); then
        test_fail "state-push/worker interleaving wrong: p1=$p1 c1=$c1 p2=$p2 c2=$c2 p3=$p3 cl=$cl
sshlog:
$(cat "$env/state/sshlog")"
        return
    fi
    test_pass

    # Compute-side rewire ordering, per disk: discover → teardown (LUN, then
    # backstore) BEFORE the destroy; re-create and re-export at the SAME LUN
    # id AFTER the rename; safe-iscsi-save per re-export.
    local p_disc p_lun_del p_bs_del p_destroy p_rename p_bs_new p_attr p_lun_new p_save p_rescan
    p_disc=$(sever_log_first "$env" "TARGETCLI\t/backstores/block/vm-340-disk-0 info")
    p_lun_del=$(sever_log_first "$env" "tpg1/luns delete lun1")
    p_bs_del=$(sever_log_first "$env" "TARGETCLI\t/backstores/block delete vm-340-disk-0")
    p_destroy=$(sever_op_first "$env" DESTROY "$d0")
    p_rename=$(sever_op_first "$env" RENAME \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0" "$d0")
    p_bs_new=$(sever_log_first "$env" \
        "TARGETCLI\t/backstores/block create vm-340-disk-0 /dev/zvol/${d0}")
    p_attr=$(sever_log_first "$env" \
        "TARGETCLI\t/backstores/block/vm-340-disk-0 set attribute emulate_tpu=1")
    p_lun_new=$(sever_log_first "$env" \
        "tpg1/luns create /backstores/block/vm-340-disk-0 1")
    p_save=$(sever_log_first "$env" "SAFE-ISCSI-SAVE")
    if [[ -z "$p_disc" || -z "$p_lun_del" || -z "$p_bs_del" || -z "$p_destroy" \
        || -z "$p_rename" || -z "$p_bs_new" || -z "$p_attr" || -z "$p_lun_new" \
        || -z "$p_save" ]]; then
        test_fail "missing two-node oplog entries:
disc=$p_disc lun_del=$p_lun_del bs_del=$p_bs_del destroy=$p_destroy
rename=$p_rename bs_new=$p_bs_new attr=$p_attr lun_new=$p_lun_new save=$p_save
oplog:
$(cat "$env/state/oplog")"
        return
    fi
    if (( p_disc >= p_lun_del || p_lun_del >= p_bs_del || p_bs_del >= p_destroy \
        || p_destroy >= p_rename || p_rename >= p_bs_new || p_bs_new >= p_attr \
        || p_attr >= p_lun_new || p_lun_new >= p_save )); then
        test_fail "two-node rewire ordering violated:
disc=$p_disc lun_del=$p_lun_del bs_del=$p_bs_del destroy=$p_destroy
rename=$p_rename bs_new=$p_bs_new attr=$p_attr lun_new=$p_lun_new save=$p_save
oplog:
$(cat "$env/state/oplog")"
        return
    fi
    test_pass

    # The explicit same-LUN create ran for both disks (the ids travel through
    # the state file, not a re-discovery), and rescan-storage fires once on
    # the compute host at the end — after every re-export.
    assert_equals "1" "$(sever_log_count "$env" \
        "tpg1/luns create /backstores/block/vm-340-disk-1 0")"
    assert_equals "2" "$(sever_log_count "$env" "SAFE-ISCSI-SAVE")"
    p_rescan=$(sever_log_last "$env" "RESCAN-STORAGE")
    if [[ -z "$p_rescan" ]] \
        || (( p_rescan <= $(sever_log_last "$env" "tpg1/luns create") )); then
        test_fail "rescan-storage did not run last; rescan=$p_rescan
oplog:
$(cat "$env/state/oplog")"
        return
    fi
    test_pass

    # The LUN table survived identical: same target, same ids, same backstore
    # names (each exactly once).
    assert_equals "2" "$(sever_iscsi_luns "$env" | grep -c . )"
    sever_iscsi_luns "$env" | grep -qxF "${tgt} 1 vm-340-disk-0" \
        && test_pass || test_fail "LUN 1 not re-exported for vm-340-disk-0"
    sever_iscsi_luns "$env" | grep -qxF "${tgt} 0 vm-340-disk-1" \
        && test_pass || test_fail "LUN 0 not re-exported for vm-340-disk-1"

    # Manifest and encrypted-luns bookkeeping: teardown removed each line,
    # the re-export put it back — the manifest holds both backstores exactly
    # once, and only the encrypted disk's line is in iscsi-encrypted-luns.
    assert_equals "1" "$(grep -c -- "^vm-340-disk-0$" \
        "$env/etcz/expected-backstores.txt")"
    assert_equals "1" "$(grep -c -- "^vm-340-disk-1$" \
        "$env/etcz/expected-backstores.txt")"
    assert_equals "vm-340-disk-0:/dev/zvol/${d0}:storage" \
        "$(cat "$env/etcz/iscsi-encrypted-luns.conf")"
    if grep -q "vm-340-disk-1" "$env/etcz/iscsi-encrypted-luns.conf"; then
        test_fail "plain zvol gained an encrypted-luns line"
        return
    fi
    test_pass

    # The origin report ran over sev_zfs (ssh): disk-0's confirmed origin was
    # destroyed through the storage-host heredoc, disk-1's declined one
    # survives, and both swapped-in zvols are origin-free.
    assert_contains "$out" \
        "tank/proxmox/vm-100-disk-0@clone-origin — unpinned: no clones, no holds"
    assert_contains "$out" "✓ destroyed — its space is released."
    assert_contains "$out" "Left in place."
    sever_snap_exists "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        && test_fail "confirmed origin survived the remote destroy" || test_pass
    sever_snap_exists "$env" tank/proxmox/vm-100-disk-1@clone-origin2 \
        && test_pass || test_fail "declined origin was destroyed anyway"
    assert_equals "-" "$(sever_field "$env" "$d0" 3)"
    assert_equals "-" "$(sever_field "$env" "$d1" 3)"
    rm -f /tmp/sever-vm-clone-${vmid}-*.state*
}

test_two_node_storage_entry_delegates_before_qm_guard() {
    test_start "two-node storage-host entry delegates over ssh before the qm guard runs"
    local env out rc dele
    env=$(sever_env_new)
    # This host is the storage host; the compute host is elsewhere and qm is
    # hidden (the storage host has none). If the qm guard ran before the
    # delegation, the run would die with "requires Proxmox VE" instead.
    cat > "$env/node.conf" << EOF
NODE_MODE="two-node"
STORAGE_HOST="$(hostname -s)"
COMPUTE_HOST="compute-elsewhere"
STORAGE_IP="10.203.0.9"
IQN_PREFIX="iqn.2026-01.test.example"
declare -A POOL_TARGET=(
    [tank]="storage"
)
EOF
    SEVER_NO_QM=1
    out=$(sever_run "$env" 345)
    rc=$?
    SEVER_NO_QM=""
    assert_rc 0 "$rc"
    if [[ "$out" == *"requires Proxmox VE"* ]]; then
        test_fail "the qm guard fired before the storage-host delegation; output:\n$out"
        return
    fi
    test_pass
    # The remote-script probe answered the fake remote bin, and the exec'd
    # delegation captured the forwarded command with its argument.
    sever_ssh_count "$env" "realpath" | grep -qx "1" \
        && test_pass || test_fail "remote bin probe not captured"
    dele=$(grep -m1 "^SSH-EXEC" "$env/state/oplog" || true)
    if [[ -z "$dele" ]]; then
        test_fail "no SSH-EXEC capture; oplog:
$(cat "$env/state/oplog")"
        return
    fi
    assert_contains "$dele" "-t root@compute-elsewhere"
    assert_contains "$dele" "/sever-vm-clone 345"
}

