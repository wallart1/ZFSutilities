# ---------------------------------------------------------------------------
# Tests: discovery, transfer, cutover (same-pool mode)
# ---------------------------------------------------------------------------

test_vmid_mode_severs_all_disks() {
    test_start "vmid form: both disks copied, swapped in order, holds reapplied, origins released"
    sever_have_blkdev \
        || { test_skip "no block device on host for the fake /dev/zvol tree"; return; }
    local vmid=310 env out rc
    env=$(sever_env_new)
    sever_seed_pool "$env" tank 50000000000
    sever_seed_fs "$env" tank/proxmox
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-0 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-0@clone-origin 8000000000
    sever_seed_vol "$env" tank/proxmox/vm-100-disk-1 3000000000 10000000000
    sever_seed_snap "$env" tank/proxmox/vm-100-disk-1@clone-origin2 8000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-0@clone-origin \
        "tank/proxmox/vm-${vmid}-disk-0" 1000000000 10000000000
    sever_seed_clone "$env" tank/proxmox/vm-100-disk-1@clone-origin2 \
        "tank/proxmox/vm-${vmid}-disk-1" 1000000000 10000000000
    local daily="tank/proxmox/vm-${vmid}-disk-0@dailybackup-2026-07-01T07:00Z-d"
    sever_seed_snap "$env" "$daily"
    sever_seed_hold "$env" "$daily" zfsutilities-backup
    sever_devtree_link "$env" "tank/proxmox/vm-${vmid}-disk-0"
    sever_devtree_link "$env" "tank/proxmox/vm-${vmid}-disk-1"

    SEVER_STDIN="y
y
tank/proxmox/vm-100-disk-0@clone-origin
y
tank/proxmox/vm-100-disk-1@clone-origin2
"
    out=$(sever_run "$env" "$vmid")
    rc=$?
    SEVER_STDIN=""

    if [[ $rc -ne 0 ]]; then
        test_fail "unexpected exit $rc; output:\n$out"
        return
    fi
    assert_contains "$out" "VM: ${vmid} (all clone zvols)"
    assert_contains "$out" "tank/proxmox/vm-${vmid}-disk-0"
    assert_contains "$out" "tank/proxmox/vm-${vmid}-disk-1"
    assert_contains "$out" "Phase 1: transfer"
    assert_contains "$out" "Phase 1 complete: fresh copies staged in the temp namespace"
    assert_contains "$out" "Phase 2: cutover"

    # Phase-1 engine invocations: one full copy per disk into the deterministic
    # temp namespace, under the bucket-less @sever-<ts> snapshot.
    assert_equals "2" "$(sever_engine_count "$env" full)"
    assert_equals "1" "$(sever_op_count "$env" SEND full \
        "tank/proxmox/vm-${vmid}-disk-0@${SEVER_RUN_SNAP}")"
    assert_equals "1" "$(sever_op_count "$env" SEND full \
        "tank/proxmox/vm-${vmid}-disk-1@${SEVER_RUN_SNAP}")"
    # Two receives land in disk-0's temp zvol: the phase-1 full copy and the
    # cutover catch-up incremental.
    assert_equals "2" "$(sever_op_count "$env" RECEIVE \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0")"

    # Cutover ordering per disk: hold release -> snapshot sweep on the
    # original (children-first: the dataset destroy refuses while any child
    # snapshot lives, so every @-destroy precedes it) -> dataset destroy ->
    # rename -> udev settle -> post-swap GUID read -> hold reapplied ->
    # post-swap scaffolding cleanup (the renamed-in copy's @sever-* snaps)
    # -> origin-snapshot destroy (typed confirmation) last.
    local p_release p_sweep p_destroy p_rename p_get p_hold p_scaffold p_origin
    p_release=$(sever_op_first "$env" RELEASE zfsutilities-backup "$daily")
    p_sweep=$(sever_op_first "$env" DESTROY "$daily")
    p_destroy=$(sever_op_first "$env" DESTROY "tank/proxmox/vm-${vmid}-disk-0")
    p_rename=$(sever_op_first "$env" RENAME \
        "tank/proxmox/sever_${vmid}/vm-${vmid}-disk-0" \
        "tank/proxmox/vm-${vmid}-disk-0")
    p_get=$(sever_op_last "$env" GET guid \
        "tank/proxmox/vm-${vmid}-disk-0@${SEVER_CUT_SNAP}")
    p_hold=$(sever_op_last "$env" HOLD zfsutilities-backup "$daily")
    p_scaffold=$(sever_op_last "$env" DESTROY \
        "tank/proxmox/vm-${vmid}-disk-0@${SEVER_RUN_SNAP}")
    p_origin=$(sever_op_first "$env" DESTROY \
        "tank/proxmox/vm-100-disk-0@clone-origin")
    if [[ -z "$p_release" || -z "$p_sweep" || -z "$p_destroy" || -z "$p_rename" \
        || -z "$p_get" || -z "$p_hold" || -z "$p_scaffold" || -z "$p_origin" ]]; then
        test_fail "missing expected oplog entries:
release=$p_release sweep=$p_sweep destroy=$p_destroy rename=$p_rename
get=$p_get hold=$p_hold scaffold=$p_scaffold origin=$p_origin
oplog:
$(cat "$env/state/oplog")
engine:
$(cat "$env/state/enginelog" 2>/dev/null)"
        return
    fi
    if (( p_release >= p_sweep || p_sweep >= p_destroy || p_destroy >= p_rename \
        || p_rename >= p_get || p_get >= p_hold || p_hold >= p_scaffold \
        || p_scaffold >= p_origin )); then
        test_fail "cutover ordering violated:
release=$p_release sweep=$p_sweep destroy=$p_destroy rename=$p_rename
get=$p_get hold=$p_hold scaffold=$p_scaffold origin=$p_origin
oplog:
$(cat "$env/state/oplog")"
        return
    fi
    test_pass

    # Children-first sweep pinned by counts: each @sever-* snap is destroyed
    # exactly twice (pre-swap sweep on the original, post-swap scaffolding
    # cleanup on the renamed-in copy), and the held daily snapshot exactly
    # once (sweep only — the copy's daily survives and gets the hold back).
    assert_equals "2" "$(sever_op_count "$env" DESTROY \
        "tank/proxmox/vm-${vmid}-disk-0@${SEVER_RUN_SNAP}")"
    assert_equals "2" "$(sever_op_count "$env" DESTROY \
        "tank/proxmox/vm-${vmid}-disk-0@${SEVER_CUT_SNAP}")"
    assert_equals "1" "$(sever_op_count "$env" DESTROY "$daily")"

    # The udev settle runs between the rename and the post-swap GUID read
    # (both recorded in the mock oplog, as is the settle itself).
    local p_udev
    p_udev=$(sever_op_first "$env" UDEV-SETTLE)
    if [[ -z "$p_udev" ]] || (( p_rename >= p_udev || p_udev >= p_get )); then
        local reason="udev settle not between rename and post-swap GUID read: "
        reason+="rename=$p_rename udev=$p_udev get=$p_get"
        test_fail "$reason"
        return
    fi
    test_pass

    # The swapped-in zvols are origin-free under their own names.
    assert_equals "-" "$(sever_field "$env" "tank/proxmox/vm-${vmid}-disk-0" 3)"
    assert_equals "-" "$(sever_field "$env" "tank/proxmox/vm-${vmid}-disk-1" 3)"

    # Captured holds were reapplied onto the swapped-in zvol.
    assert_equals "zfsutilities-backup" "$(sever_holds_of "$env" "$daily")"

    # Scaffolding snapshots are gone from the new zvol; the daily snapshot
    # (and its hold) survived.
    if sever_snap_exists "$env" "tank/proxmox/vm-${vmid}-disk-0@${SEVER_RUN_SNAP}" \
        || sever_snap_exists "$env" "tank/proxmox/vm-${vmid}-disk-0@${SEVER_CUT_SNAP}"; then
        test_fail "scaffolding snapshots remain on the swapped-in zvol"
        return
    fi
    sever_snap_exists "$env" "$daily" && test_pass \
        || test_fail "daily snapshot lost across the swap"

    # The typed-confirm offers ran for both now-unpinned origins (the report
    # names each one) and both destroys succeeded. The confirmation prompt
    # itself is only rendered when stdin is a terminal, so the accepted
    # confirmations are proven by the released-space lines and the destroys.
    assert_contains "$out" \
        "tank/proxmox/vm-100-disk-0@clone-origin — unpinned: no clones, no holds"
    assert_contains "$out" "its space is released."
    if sever_snap_exists "$env" "tank/proxmox/vm-100-disk-0@clone-origin" \
        || sever_snap_exists "$env" "tank/proxmox/vm-100-disk-1@clone-origin2"; then
        test_fail "confirmed origin snapshots were not destroyed"
        return
    fi
    test_pass

    # Namespaces cleaned up, state file removed, no ssh/targetcli anywhere.
    if sever_ds_exists "$env" "tank/proxmox/sever_${vmid}"; then
        test_fail "temp namespace not removed"
        return
    fi
    assert_contains "$out" "State file removed"
    if [[ "$out" == *"SSH-CALLED"* ]]; then
        test_fail "single-node run invoked ssh"
        return
    fi
    if [[ "$out" == *"TARGETCLI-CALLED"* ]]; then
        test_fail "single-node run invoked targetcli"
        return
    fi
    test_pass
}

