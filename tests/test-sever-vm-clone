#!/usr/bin/bash
# shellcheck disable=SC1090,SC1091,SC2016,SC2034,SC2154
# test-sever-vm-clone — Single-node suite for bin/sever-vm-clone.
#
# sever-vm-clone severs a VM's clone zvols by full copy into fresh origin-free
# zvols swapped in under the same names. This suite exercises the single-node
# flow end to end against a file-backed mock zfs/zpool pair:
#
#   - both argument forms (vmid, and explicit dataset paths)
#   - INFO-skip of non-clone arguments (non-clone zvols, non-zvol datasets)
#   - Phase-1 transfer invocation (full engine copy into the temp namespace)
#     and the tight-space plan/precheck warnings
#   - GUID-mismatch abort before any destruction
#   - cutover ordering: holds capture -> release -> snapshot sweep ->
#     dataset destroy -> rename -> udev wait -> post-swap GUID verify
#   - captured holds reapplied onto the swapped-in zvol
#   - @sever-* scaffolding snapshots destroyed after the swap
#   - origin-snapshot report: typed-confirm destroy offer, still-cloned
#     origins left in place, held origins untouched
#   - crash-window recovery with --continue (before and after the rename)
#     and --rollback (staged copy torn down; refused past the destroy)
#   - holding-pool mode: the full copy-out → feasibility gate → destroy →
#     copy-back → rename cycle, the plan-time infeasible-estimate abort,
#     and the fresh-number feasibility gate aborting after the copy-out
#     with everything left untouched
#   - the two-node path: every storage-host 'ssh bash -s' heredoc (discovery
#     gather, transfer, cutover, cleanup, remote origin destroy) executes
#     locally against the same mock state; assertions cover the heredoc
#     content, LUN-id reuse on backstore recreate, the manifest and
#     encrypted-luns bookkeeping, safe-iscsi-save per re-export,
#     rescan-storage at the end, and the storage-host entry delegating to
#     the compute host before the qm guard runs
#   - usage/validation exits
#
# Harness notes (modeled on tests/test-archive-vm):
#   test-lib.sh provides only zfs list/get/holds + zpool/qm stubs, so this
#   suite builds its own mock bin directory holding a mock `bashinit`
#   (sever-vm-clone's bootstrap finds it next to its copy and its
#   storage-side worker sources it), a file-backed mock `zfs`/`zpool` CLI on
#   PATH (one state tree shared by the suite process, the transfer worker
#   shell, and the migration-engine shell), a mock zfs-migrate-send engine,
#   and mock rootcheck/zfs-diagnose-busy helpers. Helper lookups are routed
#   through a find_zfsutility_script stub at the repo's real node-lib.sh,
#   zfslockmanager, and zfsreapplyholds, so the real lock manager and the
#   real hold capture/release/reapply code run against the mock datasets.
#   The udev wait is satisfied by pointing SEVER_ZVOL_DEV_PREFIX at a fake
#   /dev/zvol tree of symlinks to a real block device ([[ -b ]] follows
#   symlinks); when the host exposes no block device the cutover tests skip.
#
# Two-node harness: the mock bashinit's ssh() stub follows the
# tests/test-archive-vm capture-and-answer pattern, extended to EXECUTE the
# 'ssh root@<storage> bash -s' heredoc workers locally (a test's two hosts
# share one filesystem, so the state/results paths are valid on both): the
# remote-bin probe answers a fake remote path that is rewritten to the mock
# bin dir for worker runs, every call lands in the env's sshlog (bodies
# between SSH-BODY markers), and `exec ssh` (the storage-host delegation,
# which bypasses functions) is caught by a mock ssh executable. A
# file-backed targetcli() models backstores/LUNs, and mock
# safe-iscsi-save/rescan-storage executables record their invocations in
# the oplog; the manifest and encrypted-luns conf live under the env's
# etcz dir via ISCSI_MANIFEST/ZFSUTILITIES_SYSTEM_CONFIG_DIR.
#
# Mock destroy semantics: destroying a dataset refuses while child datasets
# OR child snapshots exist (real zfs rejects `zfs destroy <dataset>` with
# "dataset has children"), so the children-first sweep in
# sever_destroy_dataset is proven necessary, not merely ordered; destroying
# a HELD snapshot also fails, as real zfs does.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ---------------------------------------------------------------------------
# Suite-level mock bin directory (written once per suite run).
# ---------------------------------------------------------------------------

SEVER_MOCKBIN="$_mock_zfs_state_dir/mockbin"
mkdir -p "$SEVER_MOCKBIN"

write_sever_mock_bin() {
    # --- mock bashinit: sever-vm-clone's own bootstrap and the storage-side
    # --- transfer worker both source this; it routes helper lookups.
    cat > "$SEVER_MOCKBIN/bashinit" << EOF
# mock bashinit generated by tests/test-sever-vm-clone
mydir="\$(cd "\$(dirname "\$(realpath "\${BASH_SOURCE[0]}")")" && pwd)"
repo='$mydir'
bashinit() { true; }
log_msg() { echo "INFO: [mock-bashinit] \$*" >&2; }
calledbybash() { [[ "\${BASH_SOURCE[1]}" = "\$0" ]]; }
# Chaining EXIT-trap registration (bin/zfslockmanager's zfslock_init needs
# it; the storage-side worker never sources the real bin/bashinit).
append_exit_trap() {
    local handler="\$1" prev=""
    prev=\$(trap -p EXIT)
    if [[ -n "\$prev" ]]; then
        prev="\${prev#trap -- }"
        prev="\${prev% EXIT}"
        prev="\${prev#\'}"
        prev="\${prev%\'}"
        trap "\$prev; \$handler" EXIT
    else
        trap "\$handler" EXIT
    fi
}
snapname_timestamp() {
    local ts
    ts=\$(date -u -Iminutes)
    printf '%s\n' "\${ts%+00:00}Z"
}
# Real prompt semantics with prompt-order stdin feeding (test-archive-vm's
# approach). The real bin/bashinit redefines these when the lock manager is
# sourced; both implementations read the subshell's fed stdin.
ask_yn() {
    local prompt="\${1:-Continue?}" def="\${2:-N}" response
    read -r response
    [[ -z "\$response" ]] && response="\$def"
    case "\${response,,}" in
        y|yes) return 0 ;;
        *)     return 1 ;;
    esac
}
ask_line() {
    local prompt="\${1:-}" var="\${2:-REPLY}"
    read -r "\$var"
}
# find_zfsutility_script stub: repo copies for the real helpers, suite mocks
# for the engine and the busy-diagnosis/rootcheck helpers.
find_zfsutility_script() {
    local name="\$1"
    case "\$name" in
        node-lib.sh|paths.sh) echo "\$repo/lib/\$name" ;;
        zfslockmanager|zfsreapplyholds) echo "\$repo/bin/\$name" ;;
        zfs-migrate-send|rootcheck|zfs-diagnose-busy) echo "\$mydir/\$name" ;;
        *) echo "mock-bashinit: no route for \$name" >&2; return 1 ;;
    esac
}
source_helper() {
    local p
    p=\$(find_zfsutility_script "\$1") || {
        echo "mock-bashinit: cannot find \$1" >&2; return 1; }
    source "\$p"
}
# Command stubs, defined here (not only in the suite's runner subshell)
# because the storage-side transfer and cutover workers are child shells
# that source this file and must see them too. SEVER_NO_QM=1 hides qm for
# the Proxmox-guard test. sever_wait_zvol_node redirects udevadm's own
# output away, so the settle is recorded in the mock oplog instead — it
# must sit between the rename and the post-swap GUID read.
if [[ "\${SEVER_NO_QM:-}" != "1" ]]; then
    qm() {
        [[ "\${1:-}" == "status" ]] \\
            && echo "status: \${SEVER_QM_STATUS:-stopped}"
        return 0
    }
    pct() { return 0; }
fi
# The fake remote bin path the ssh stub answers for remote_zfsutilities_bin
# probes and rewrites to this mock bin dir when a bash -s worker runs.
sever_fake_remote_bin='/usr/local/lib/zfsutilities/current/bin'
EOF

    # --- two-node stubs (quoted heredoc: no generation-time expansion) ---
    # ssh: the tests/test-archive-vm capture-and-answer pattern, extended to
    # EXECUTE the storage-side 'bash -s' heredoc workers locally against the
    # same mock state (a test's two hosts share one filesystem, so the state
    # and results paths are valid on both). Every call is recorded to
    # $MOCK_ZFS_STATE_DIR/sshlog; 'bash -s' bodies are recorded between
    # SSH-BODY/SSH-BODY-END markers so tests can assert heredoc content.
    # targetcli: file-backed iSCSI state (tc-backstores/tc-luns) with the
    # output shapes the script's anchored parsers read.
    cat >> "$SEVER_MOCKBIN/bashinit" << 'SEVERFUNCS'
udevadm() {
    [[ -n "${MOCK_ZFS_STATE_DIR:-}" ]] \
        && printf 'UDEV-SETTLE\t%s\n' "$*" >> "$MOCK_ZFS_STATE_DIR/oplog"
    return 0
}
ssh() {
    echo "SSH-CALLED: $*" >&2
    local _state="${MOCK_ZFS_STATE_DIR:-}"
    local -a _a=("$@") _rest=()
    # ssh's own options and the destination come first; everything after the
    # root@destination is the remote command. ($@ is 0-indexed here: _a[0]
    # is the first option, not the function name.)
    local _i=0 _arg _dest_seen=0 _joined _k _have_bash_s=0 _body
    while (( _i < ${#_a[@]} )); do
        _arg="${_a[_i]}"
        if [[ "$_dest_seen" != "1" ]]; then
            case "$_arg" in
                -o) (( _i += 2 )); continue ;;
                -t) (( _i += 1 )); continue ;;
                *)  _dest_seen=1; (( _i += 1 )); continue ;;
            esac
        fi
        _rest+=("$_arg")
        (( _i += 1 ))
    done
    _joined="${_rest[*]}"
    [[ -n "$_state" ]] && printf 'SSH\t%s\n' "$_joined" >> "$_state/sshlog"
    if [[ "$_joined" == *"realpath"* || "$_joined" == *"readlink"* ]]; then
        # remote_zfsutilities_bin: the fake remote path, rewritten to the
        # mock bin dir for the bash -s workers below.
        printf '%s\n' "$sever_fake_remote_bin"
        return 0
    fi
    for _k in "${!_rest[@]}"; do
        if [[ "${_rest[_k]}" == "bash" && "${_rest[_k + 1]:-}" == "-s" ]]; then
            _have_bash_s=1
            break
        fi
    done
    if [[ "$_have_bash_s" == "1" ]]; then
        _body="$(cat)"
        [[ -n "$_state" ]] && printf 'SSH-BODY\n%s\nSSH-BODY-END\n' "$_body" \
            >> "$_state/sshlog"
        local -a _w=("${_rest[@]:$((_k + 2))}")
        if [[ "${_w[0]:-}" == "$sever_fake_remote_bin" ]]; then
            _w[0]="$mydir"
        fi
        bash -s "${_w[@]}" <<< "$_body"
        return $?
    fi
    # A remote "cat > path" push is fed from the same path: over real ssh
    # the two are different machines, but executed locally they are one
    # inode, and the > would truncate the very file stdin reads from — so
    # buffer stdin first and feed it back exactly (the trailing-x guard
    # keeps $(cat)'s newline stripping out of the copy).
    if [[ "$_joined" == "cat > "* ]]; then
        local _in
        _in="$(cat; printf x)"
        printf '%s' "${_in%x}" | bash -c "$_joined"
        return $?
    fi
    bash -c "$_joined"
    return $?
}
targetcli() {
    echo "TARGETCLI-CALLED: $*" >&2
    local _state="${MOCK_ZFS_STATE_DIR:-}"
    [[ -n "$_state" ]] || return 0
    printf 'TARGETCLI\t%s\n' "$*" >> "$_state/oplog"
    local _bs="$_state/tc-backstores" _luns="$_state/tc-luns"
    local _tgt _name _lun _next _row
    touch "$_bs" "$_luns"
    case "$1" in
        "/iscsi")
            # $2 == ls: list the targets (one line each; the IQN is a whole
            # whitespace-delimited token, which is what the parser grabs).
            awk -F'\t' '{print $1}' "$_luns" | sort -u \
                | while IFS= read -r _tgt; do
                      [[ -n "$_tgt" ]] || continue
                      printf '  o- %s [TPGs: 1]\n' "$_tgt"
                  done
            ;;
        "/iscsi/"*"/tpg1/luns")
            _tgt="$1"; _tgt="${_tgt#/iscsi/}"; _tgt="${_tgt%/tpg1/luns}"
            case "${2:-}" in
                ls)
                    awk -F'\t' -v t="$_tgt" \
                        '$1==t{printf "  o- lun%s [block/%s (dev)]\n", $2, $3}' \
                        "$_luns"
                    ;;
                create)
                    # $3 = /backstores/block/<name>; $4 = explicit LUN id
                    # (absent: auto-assign max+1). A taken explicit id or an
                    # unknown backstore fails, as real targetcli does.
                    _name="${3#/backstores/block/}"
                    awk -F'\t' -v b="$_name" '$1==b{f=1} END{exit f?0:1}' "$_bs" \
                        || { echo "mock targetcli: no backstore ${_name}" >&2; return 1; }
                    if [[ -n "${4:-}" ]]; then
                        if awk -F'\t' -v t="$_tgt" -v l="$4" \
                                '$1==t && $2==l{f=1} END{exit f?0:1}' "$_luns"; then
                            echo "mock targetcli: LUN $4 already exists" >&2
                            return 1
                        fi
                        printf '%s\t%s\t%s\n' "$_tgt" "$4" "$_name" >> "$_luns"
                    else
                        _next=0
                        while IFS=$'\t' read -r _row _lun _; do
                            [[ "$_row" == "$_tgt" && "$_lun" -gt "$_next" ]] \
                                && _next="$_lun"
                        done < "$_luns"
                        _next=$((_next + 1))
                        printf '%s\t%s\t%s\n' "$_tgt" "$_next" "$_name" >> "$_luns"
                    fi
                    ;;
                delete)
                    _lun="${3#lun}"
                    awk -F'\t' -v t="$_tgt" -v l="$_lun" \
                        '!($1==t && $2==l)' "$_luns" > "${_luns}.next"
                    mv "${_luns}.next" "$_luns"
                    ;;
            esac
            ;;
        "/backstores/block")
            case "${2:-}" in
                ls)
                    awk -F'\t' '{printf "  o- %s (%s)\n", $1, $2}' "$_bs"
                    ;;
                create)
                    awk -F'\t' -v b="$3" '$1==b{f=1} END{exit f?0:1}' "$_bs" \
                        && { echo "mock targetcli: backstore $3 exists" >&2; return 1; }
                    printf '%s\t%s\n' "$3" "$4" >> "$_bs"
                    ;;
                delete)
                    awk -F'\t' -v b="$3" '$1!=b' "$_bs" > "${_bs}.next"
                    mv "${_bs}.next" "$_bs"
                    ;;
            esac
            ;;
        "/backstores/block/"*)
            case "${2:-}" in
                info)
                    _name="$1"; _name="${_name#/backstores/block/}"
                    _row="$(awk -F'\t' -v b="$_name" '$1==b{print $2; exit}' "$_bs")"
                    [[ -n "$_row" ]] || return 1
                    printf 'name: %s\n' "$_name"
                    printf '  dev: %s\n' "$_row"
                    printf '  emulate_tpu: 1\n'
                    ;;
                set)
                    :   # attribute sets always succeed
                    ;;
            esac
            ;;
    esac
    return 0
}
SEVERFUNCS

    # --- mock zfs CLI: file-backed state, every mutating op (and every guid
    # --- read) appended to oplog so tests can assert cutover ordering.
    cat > "$SEVER_MOCKBIN/zfs" << 'MOCKZFS'
#!/usr/bin/bash
# Mock zfs for tests/test-sever-vm-clone — see the suite header.
set -u
STATE="${MOCK_ZFS_STATE_DIR:?MOCK_ZFS_STATE_DIR is not set}"
touch "$STATE/datasets" "$STATE/snaps" "$STATE/holds" "$STATE/oplog"

op() {
    local IFS=$'\t'
    printf '%s\n' "$*" >> "$STATE/oplog"
}
# Zero-fork field extraction (cut would fork once per use; list/get hit
# these paths dozens of times per sever run). Splits on tabs.
fld() {
    local IFS=$'\t'
    # shellcheck disable=SC2206
    local -a f=($1)
    printf '%s' "${f[$2 - 1]:-}"
}
# The @snap part of a snapshot row's first field, without forking awk.
snap_short() {
    local name
    name="$(fld "$1" 1)"
    printf '%s' "${name#*@}"
}

# Hot lookups are pure bash (no awk/cat forks): each sever run performs
# well over a hundred of these, and every exec costs a few milliseconds.
ds_row() {
    local row
    while IFS= read -r row; do
        if [[ "$row" == "$1"$'\t'* ]]; then
            printf '%s\n' "$row"
            return 0
        fi
    done < "$STATE/datasets"
    return 1
}
ds_exists() { [[ -n "$(ds_row "$1")" ]]; }
snap_row() {
    local row
    while IFS= read -r row; do
        if [[ "$row" == "$1"$'\t'* ]]; then
            printf '%s\n' "$row"
            return 0
        fi
    done < "$STATE/snaps"
    return 1
}
snap_exists() { [[ -n "$(snap_row "$1")" ]]; }
next_seq() {
    local n=0
    # 2>/dev/null must precede the input redirect: applied left to right,
    # it also silences the missing-file ENOENT the < would otherwise print
    # on a fresh state tree (the || fallback still catches the failure).
    read -r n 2>/dev/null < "$STATE/seq" || n=0
    n=$((n + 1))
    printf '%s\n' "$n" > "$STATE/seq"
    printf '%s\n' "$n"
}
clones_of() {
    local IFS=$'\t' n _t origin _rest out="" sep=""
    while read -r n _t origin _rest; do
        [[ "$origin" == "$1" ]] || continue
        out+="${sep}${n}"
        sep=","
    done < "$STATE/datasets"
    [[ -n "$out" ]] && printf '%s\n' "$out" || printf -- '-\n'
}

# Test knob zfs_fail: "subcmd:substr" lines; the first mutating operation
# whose argv contains substr fails once (crash-window simulation).
inject_fail() {
    local sub="$1" args="$2" line sub2 substr hit=0
    [[ -f "$STATE/zfs_fail" ]] || return 1
    local tmp="$STATE/zfs_fail.next"
    : > "$tmp"
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        sub2="${line%%:*}"
        substr="${line#*:}"
        if [[ "$hit" -eq 0 && "$sub" == "$sub2" && "$args" == *"$substr"* ]]; then
            hit=1
            op INJECT-FAIL "$sub" "$args"
            continue
        fi
        printf '%s\n' "$line" >> "$tmp"
    done < "$STATE/zfs_fail"
    mv "$tmp" "$STATE/zfs_fail"
    [[ "$hit" -eq 1 ]]
}

render_ds_cols() {
    local row="$1" cols="$2"
    local name type origin used ref enc
    IFS=$'\t' read -r name type origin used ref enc <<< "$row"
    local out="" c
    local IFS=','
    for c in $cols; do
        case "$c" in
            name)       out+="${out:+$'\t'}$name" ;;
            type)       out+="${out:+$'\t'}$type" ;;
            origin)     out+="${out:+$'\t'}$origin" ;;
            used)       out+="${out:+$'\t'}$used" ;;
            referenced) out+="${out:+$'\t'}$ref" ;;
            encryption) out+="${out:+$'\t'}$enc" ;;
            *)          out+="${out:+$'\t'}-" ;;
        esac
    done
    printf '%s\n' "$out"
}

render_snap_cols() {
    local row="$1" cols="$2"
    local name guid crec used
    IFS=$'\t' read -r name guid crec used <<< "$row"
    local out="" c
    local IFS=','
    for c in $cols; do
        case "$c" in
            name)     out+="${out:+$'\t'}$name" ;;
            guid)     out+="${out:+$'\t'}$guid" ;;
            creation) out+="${out:+$'\t'}$crec" ;;
            used)     out+="${out:+$'\t'}$used" ;;
            clones)   out+="${out:+$'\t'}$(clones_of "$name")" ;;
            *)        out+="${out:+$'\t'}-" ;;
        esac
    done
    printf '%s\n' "$out"
}

# Snapshots of one dataset, creation-ascending ($2=1 reverses).
snap_listing() {
    local ds="$1" rev="${2:-0}"
    if [[ "$rev" -eq 1 ]]; then
        awk -F'\t' -v d="$ds" 'index($1, d "@") == 1' "$STATE/snaps" \
            | sort -t$'\t' -k3,3nr
    else
        awk -F'\t' -v d="$ds" 'index($1, d "@") == 1' "$STATE/snaps" \
            | sort -t$'\t' -k3,3n
    fi
}

subcmd="${1:-}"

case "$subcmd" in
list)
    shift
    cols=""; dtype=""; operand=""; recurse=0; rev=0
    while [[ $# -gt 0 ]]; do
        a="$1"
        case "$a" in
            --)
                shift
                [[ $# -gt 0 ]] && operand="$1"
                ;;
            -*)
                letters="${a#-}"
                [[ "$letters" == *r* || "$letters" == *R* ]] && recurse=1
                lastc="${letters: -1}"
                case "$lastc" in
                    o) cols="${2:-}"; shift ;;
                    t) dtype="${2:-}"; shift ;;
                    d) shift ;;
                    S) rev=1; shift ;;
                    s) shift ;;
                esac
                ;;
            *) operand="$a" ;;
        esac
        shift
    done
    if [[ "$operand" == *"@"* ]]; then
        # One named snapshot: existence check (+ optional columns).
        snap_exists "$operand" || exit 1
        if [[ -n "$cols" ]]; then
            render_snap_cols "$(snap_row "$operand")" "$cols"
        else
            echo "$operand"
        fi
        exit 0
    fi
    if [[ "$dtype" == *snap* || "$dtype" == *fs* || "$dtype" == *vol* ]]; then
        if [[ "$dtype" == *snap* ]]; then
            [[ -z "$operand" ]] && exit 0
            snap_listing "$operand" "$rev" \
                | while IFS=$'\t' read -r srow; do
                      render_snap_cols "$srow" "${cols:-name}"
                  done
            exit 0
        fi
        if [[ -n "$operand" ]]; then
            row=$(ds_row "$operand")
            [[ -n "$row" ]] || exit 1
            if [[ "$dtype" == *vol* ]]; then
                [[ "$(fld "$row" 2)" == "volume" ]] || exit 1
            fi
            render_ds_cols "$row" "${cols:-name}"
            exit 0
        fi
        # Top-level scope: plain assignment (this branch exits right after).
        IFS=$'\t'
        f1= f2= f3= f4= f5= f6=
        while read -r f1 f2 f3 f4 f5 f6; do
            [[ "$f2" == "volume" ]] || continue
            render_ds_cols "$f1	$f2	$f3	$f4	$f5	$f6" "${cols:-name}"
        done < "$STATE/datasets"
        exit 0
    fi
    if [[ -n "$operand" ]]; then
        ds_exists "$operand" || exit 1
        if [[ -n "$cols" ]]; then
            render_ds_cols "$(ds_row "$operand")" "$cols"
        else
            echo "$operand"
        fi
        exit 0
    fi
    # All dataset names, one per line (zero forks).
    IFS=$'\t'
    while read -r dname _; do
        printf '%s\n' "$dname"
    done < "$STATE/datasets"
    exit 0
    ;;

get)
    shift
    prop=""; target=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -H*|-p*|-r) ;;
            -o) shift ;;
            *) if [[ -z "$prop" ]]; then prop="$1"; else target="$1"; fi ;;
        esac
        shift
    done
    case "$prop" in
        guid)
            # Only existing snapshots have a GUID; the test knob forces the
            # answer for one that exists (a stale copy, a bad copy-back).
            if snap_exists "$target"; then
                if [[ -f "$STATE/guid_override" ]]; then
                    while IFS='=' read -r otgt oval; do
                        if [[ "$otgt" == "$target" && -n "$oval" ]]; then
                            op GET guid "$target"
                            echo "$oval"
                            exit 0
                        fi
                    done < "$STATE/guid_override"
                fi
                op GET guid "$target"
                fld "$(snap_row "$target")" 2
                exit 0
            fi
            exit 1
            ;;
        used)
            if snap_exists "$target"; then
                fld "$(snap_row "$target")" 4
                exit 0
            fi
            if ds_exists "$target"; then
                fld "$(ds_row "$target")" 4
                exit 0
            fi
            exit 1
            ;;
        referenced)
            ds_exists "$target" || exit 1
            fld "$(ds_row "$target")" 5
            ;;
        encryption)
            ds_exists "$target" || exit 1
            fld "$(ds_row "$target")" 6
            ;;
        keystatus)
            if [[ -f "$STATE/keystatus" ]] \
                && grep -q "^$target=" "$STATE/keystatus"; then
                grep "^$target=" "$STATE/keystatus" | head -1 | cut -d= -f2
            else
                echo available
            fi
            ;;
        origin)
            ds_exists "$target" || exit 1
            # Test knob: force an origin answer for one dataset (a staged
            # copy that "linked" to the still-present origin, or a swapped-
            # in zvol that is still a clone) — the guid_override pattern.
            if [[ -f "$STATE/origin_override" ]]; then
                while IFS='=' read -r otgt oval; do
                    if [[ "$otgt" == "$target" && -n "$oval" ]]; then
                        op GET origin "$target"
                        echo "$oval"
                        exit 0
                    fi
                done < "$STATE/origin_override"
            fi
            op GET origin "$target"
            fld "$(ds_row "$target")" 3
            ;;
        receive_resume_token) echo "-" ;;
        *) echo "-" ;;
    esac
    exit 0
    ;;

holds)
    snap="${!#}"
    awk -F'\t' -v s="$snap" \
        '$1==s{printf "%s\t%s\t2026-01-01T00:00:00\n", $1, $2}' "$STATE/holds"
    exit 0
    ;;

hold)
    inject_fail hold "$*" && exit 1
    tag="$2"; snap="$3"
    snap_exists "$snap" || exit 1
    printf '%s\t%s\n' "$snap" "$tag" >> "$STATE/holds"
    op HOLD "$tag" "$snap"
    exit 0
    ;;

release)
    inject_fail release "$*" && exit 1
    tag="$2"; snap="$3"
    awk -F'\t' -v t="$tag" -v s="$snap" \
        '!($1==s && $2==t)' "$STATE/holds" > "$STATE/holds.next"
    mv "$STATE/holds.next" "$STATE/holds"
    op RELEASE "$tag" "$snap"
    exit 0
    ;;

snapshot)
    inject_fail snapshot "$*" && exit 1
    target="$2"
    ds="${target%@*}"
    ds_exists "$ds" || exit 1
    snap_exists "$target" && exit 1
    n=$(next_seq)
    printf '%s\t%s\t%s\t0\n' "$target" "$n" "$n" >> "$STATE/snaps"
    op SNAPSHOT "$target"
    exit 0
    ;;

destroy)
    inject_fail destroy "$*" && exit 1
    target="$2"
    if [[ "$target" == *"@"* ]]; then
        snap_exists "$target" || exit 1
        if awk -F'\t' -v s="$target" '$1==s{f=1} END{exit f?0:1}' "$STATE/holds"; then
            exit 1   # held snapshots cannot be destroyed
        fi
        awk -F'\t' -v s="$target" '$1!=s' "$STATE/snaps" > "$STATE/snaps.next"
        mv "$STATE/snaps.next" "$STATE/snaps"
        awk -F'\t' -v s="$target" '$1!=s' "$STATE/holds" > "$STATE/holds.next"
        mv "$STATE/holds.next" "$STATE/holds"
        op DESTROY "$target"
        exit 0
    fi
    ds_exists "$target" || exit 1
    # A dataset with child datasets refuses (the namespace-cleanup realism).
    if awk -F'\t' -v d="$target" 'index($1, d "/") == 1{f=1} END{exit f?0:1}' \
            "$STATE/datasets"; then
        exit 1
    fi
    # A dataset with child snapshots refuses too — real zfs rejects
    # `zfs destroy <dataset>` with "dataset has children", which is what
    # makes sever-vm-clone's children-first sever_destroy_dataset
    # load-bearing rather than incidental.
    if awk -F'\t' -v d="$target" 'index($1, d "@") == 1{f=1} END{exit f?0:1}' \
            "$STATE/snaps"; then
        exit 1
    fi
    awk -F'\t' -v d="$target" '$1!=d' "$STATE/datasets" > "$STATE/datasets.next"
    mv "$STATE/datasets.next" "$STATE/datasets"
    awk -F'\t' -v d="$target" 'index($1, d "@")!=1' "$STATE/snaps" \
        > "$STATE/snaps.next"
    mv "$STATE/snaps.next" "$STATE/snaps"
    awk -F'\t' -v d="$target" 'index($1, d "@")!=1' "$STATE/holds" \
        > "$STATE/holds.next"
    mv "$STATE/holds.next" "$STATE/holds"
    op DESTROY "$target"
    exit 0
    ;;

rename)
    inject_fail rename "$*" && exit 1
    old="$2"; new="$3"
    ds_exists "$old" || exit 1
    ds_exists "$new" && exit 1
    awk -F'\t' -v o="$old" -v n="$new" \
        '$1==o{$1=n} {print}' OFS='\t' "$STATE/datasets" > "$STATE/datasets.next"
    mv "$STATE/datasets.next" "$STATE/datasets"
    awk -F'\t' -v o="$old" -v n="$new" \
        'index($1, o "@")==1{$1=n "@" substr($1, length(o)+2)} {print}' \
        OFS='\t' "$STATE/snaps" > "$STATE/snaps.next"
    mv "$STATE/snaps.next" "$STATE/snaps"
    awk -F'\t' -v o="$old" -v n="$new" \
        'index($1, o "@")==1{$1=n "@" substr($1, length(o)+2)} {print}' \
        OFS='\t' "$STATE/holds" > "$STATE/holds.next"
    mv "$STATE/holds.next" "$STATE/holds"
    # Clone origins follow the renamed dataset's snapshots.
    awk -F'\t' -v o="$old" -v n="$new" \
        'index($3, o "@")==1{$3=n "@" substr($3, length(o)+2)} {print}' \
        OFS='\t' "$STATE/datasets" > "$STATE/datasets.next"
    mv "$STATE/datasets.next" "$STATE/datasets"
    op RENAME "$old" "$new"
    exit 0
    ;;

create)
    inject_fail create "$*" && exit 1
    shift
    pflag=0; vsize=""; name=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p) pflag=1 ;;
            -V) vsize="$2"; shift ;;
            --) ;;
            *) name="$1" ;;
        esac
        shift
    done
    [[ -n "$name" ]] || exit 1
    ds_exists "$name" && exit 1
    type="filesystem"
    [[ -n "$vsize" ]] && type="volume"
    if [[ "$pflag" -eq 1 ]]; then
        rest="$name"
        while [[ "$rest" == */* ]]; do
            part="${rest%/*}"
            if ! ds_exists "$part"; then
                printf '%s\tfilesystem\t-\t0\t0\toff\n' "$part" >> "$STATE/datasets"
            fi
            rest="$part"
        done
    else
        parent="${name%/*}"
        [[ "$name" == */* ]] || exit 1
        ds_exists "$parent" || exit 1
    fi
    printf '%s\t%s\t-\t0\t%s\toff\n' "$name" "$type" "${vsize:-0}" \
        >> "$STATE/datasets"
    op CREATE "$name" "$type"
    exit 0
    ;;

clone)
    inject_fail clone "$*" && exit 1
    snap="$2"; name="$3"
    snap_exists "$snap" || exit 1
    ds_exists "$name" && exit 1
    srcds="${snap%@*}"
    srcrow=$(ds_row "$srcds")
    stype=$(fld "$srcrow" 2)
    sref=$(fld "$srcrow" 5)
    senc=$(fld "$srcrow" 6)
    printf '%s\t%s\t%s\t0\t%s\t%s\n' "$name" "$stype" "$snap" "$sref" "$senc" \
        >> "$STATE/datasets"
    op CLONE "$snap" "$name"
    exit 0
    ;;

set)
    inject_fail set "$*" && exit 1
    assignment="$2"; target="${!#}"
    op SET "$assignment" "$target"
    exit 0
    ;;

send)
    # Getopt fidelity, mirroring real zfs (same guard as the
    # test-transfer-lib and test-zfs-migrate-send mocks): an
    # argument-taking option (-i/-I/-t) embedded in a short-option
    # cluster makes the next cluster character its argument, so any
    # snapshot names after it land as extra positionals — real zfs
    # fails with "too many arguments". Such options must be standalone
    # argv words; two operands without one are rejected too.
    shift
    dry=0
    operands=()
    _incr=0
    for a in "$@"; do
        # A short-option cluster (dash + two or more letters) holding
        # i/I/t is exactly the broken form; globs suffice.
        if [[ "$a" == -* && "${#a}" -gt 2 && "$a" == *[iIt]* ]]; then
            echo "too many arguments" >&2
            exit 1
        fi
        [[ "$a" == -n* && "$a" == -* ]] && dry=1
        case "$a" in
            -I|-i|-t) _incr=1 ;;
            -*) ;;
            *) operands+=("$a") ;;
        esac
    done
    if (( ${#operands[@]} > 1 && _incr == 0 )); then
        echo "too many arguments" >&2
        exit 1
    fi
    to="${operands[0]:-}"
    from=""
    if [[ ${#operands[@]} -ge 2 ]]; then from="$to"; to="${operands[1]}"; fi
    [[ -n "$to" ]] || exit 1
    ds="${to%@*}"
    ds_exists "$ds" || exit 1
    torow=$(snap_row "$to")
    [[ -n "$torow" ]] || exit 1
    to_c=$(fld "$torow" 3)
    from_c=0
    if [[ -n "$from" ]]; then
        fromrow=$(snap_row "$from")
        [[ -n "$fromrow" ]] || exit 1
        from_c=$(fld "$fromrow" 3)
    fi
    setrows=$(awk -F'\t' -v d="$ds" -v lo="$from_c" -v hi="$to_c" \
        'index($1, d "@")==1 && $3+0 > lo+0 && $3+0 <= hi+0' "$STATE/snaps" \
        | sort -t$'\t' -k3,3n)
    if [[ "$dry" -eq 1 ]]; then
        size=$(awk -F'\t' '{s+=$4} END{print s+0}' <<< "$setrows")
        [[ "$size" -eq 0 ]] && size=$(fld "$(ds_row "$ds")" 5)
        printf 'size\t%s\n' "$size"
        exit 0
    fi
    dsrow=$(ds_row "$ds")
    printf 'MOCKSTREAM-DS\t%s\t-\t%s\t%s\t%s\n' \
        "$(fld "$dsrow" 2)" "$(fld "$dsrow" 4)" \
        "$(fld "$dsrow" 5)" "$(fld "$dsrow" 6)"
    while IFS=$'\t' read -r srow; do
        printf 'MOCKSTREAM-SNAP\t%s\t%s\t%s\t%s\n' \
            "$(snap_short "$srow")" \
            "$(fld "$srow" 2)" "$(fld "$srow" 3)" \
            "$(fld "$srow" 4)"
    done <<< "$setrows"
    if [[ -n "$from" ]]; then op SEND catchup "$to"; else op SEND full "$to"; fi
    exit 0
    ;;

receive)
    inject_fail receive "$*" && exit 1
    dest="${!#}"
    stream=$(cat)
    [[ "${stream:-}" == MOCKSTREAM-* ]] || {
        echo "mock zfs receive: stdin is not a mock stream" >&2
        exit 1
    }
    header=$(head -1 <<< "$stream")
    IFS=$'\t' read -r _hdr dtype _orig dused dref denc <<< "$header"
    if ! ds_exists "$dest"; then
        printf '%s\t%s\t-\t%s\t%s\t%s\n' \
            "$dest" "$dtype" "$dused" "$dref" "$denc" >> "$STATE/datasets"
    fi
    tail -n +2 <<< "$stream" | while IFS=$'\t' read -r tag snap guid crec used; do
        [[ "$tag" == "MOCKSTREAM-SNAP" ]] || continue
        full="$dest@$snap"
        if snap_exists "$full"; then
            have=$(fld "$(snap_row "$full")" 2)
            if [[ "$have" != "$guid" ]]; then
                # -F receive: roll the mismatching snapshot back to the stream
                awk -F'\t' -v s="$full" -v g="$guid" \
                    '$1==s{$2=g} {print}' OFS='\t' "$STATE/snaps" \
                    > "$STATE/snaps.next"
                mv "$STATE/snaps.next" "$STATE/snaps"
            fi
        else
            printf '%s\t%s\t%s\t%s\n' "$full" "$guid" "$crec" "$used" \
                >> "$STATE/snaps"
        fi
    done
    op RECEIVE "$dest"
    exit 0
    ;;

# ---- mock-only seeding subcommands (never issued by sever-vm-clone) -------
__mock_set_enc)
    name="$2"; val="$3"
    awk -F'\t' -v d="$name" -v e="$val" '$1==d{$6=e} {print}' OFS='\t' \
        "$STATE/datasets" > "$STATE/datasets.next"
