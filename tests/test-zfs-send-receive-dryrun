# Test zfsdelfs failure releases only source lock
# ---------------------------------------------------------------------------

test_full_copy_releases_dest_lock_zfsdelfs_failure() {
    test_start "Full copy releases only source lock when zfsdelfs fails"

    local op_trace="$_mock_zfs_state_dir/full_copy_fail_ops.trace"
    local mock_delfs="$_mock_zfs_state_dir/mock_zfsdelfs_fail"
    _setup_full_copy_lock_test "$op_trace"
    _create_mock_zfsdelfs "$mock_delfs" "$op_trace" 1
    _install_lock_mocks "$op_trace" "$mock_delfs"

    clear_log
    capture_stderr
    local overrides
    overrides="dryrun='N'; autoproceed='Y'; sourcefsremovequalifiers=0; "
    overrides+="doincrementals='N'; force='Y'"
    local rc=0
    # Run in a subshell because the send-receive fatal path calls exit 8,
    # which would otherwise terminate the test shell.
    ( send-receive "srcpool" "destpool" "$overrides" ) || rc=$?
    restore_stderr

    _restore_lock_mocks

    local trace
    trace=$(cat "$op_trace")

    local src_lock_line dest_lock_line first_release_line second_release_line delfs_line
    src_lock_line=$(echo "$trace" | grep -n "wait:srcpool/data" | head -1 | cut -d: -f1)
    dest_lock_line=$(echo "$trace" | grep -n "wait:destpool/srcpool/data" | head -1 | cut -d: -f1)
    first_release_line=$(echo "$trace" | grep -n "release:" | head -1 | cut -d: -f1)
    second_release_line=$(echo "$trace" | grep -n "release:" | tail -1 | cut -d: -f1)
    delfs_line=$(echo "$trace" | grep -n "zfsdelfs destpool/srcpool/data" | head -1 | cut -d: -f1)

    if [[ "$rc" -eq 8 && \
          -n "$src_lock_line" && -n "$dest_lock_line" && \
          -n "$first_release_line" && -n "$second_release_line" && \
          -n "$delfs_line" && \
          "$src_lock_line" -lt "$dest_lock_line" && \
          "$dest_lock_line" -lt "$first_release_line" && \
          "$first_release_line" -lt "$delfs_line" && \
          "$delfs_line" -lt "$second_release_line" ]]; then
        test_pass
    else
        test_fail "Unexpected lock operation order or rc=$rc; trace='$trace'"
    fi
}

