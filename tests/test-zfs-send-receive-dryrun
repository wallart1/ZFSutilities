_setup_full_copy_lock_test() {
    local op_trace="$1"

    reset_mocks
    set_msg_level INFO

    _mock_zfs_fs_list="srcpool/data"
    _mock_zfs_props["srcpool/data:origin"]="-"
    _mock_zfs_props["destpool/srcpool/data:origin"]="-"
