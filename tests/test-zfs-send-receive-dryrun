    _mock_zfs_datasets["destpool/srcpool/data"]=1
    _mock_zfs_snap_lists["srcpool/data"]="srcpool/data@snap1"
    _mock_zfs_snap_lists["destpool/srcpool/data"]="destpool/srcpool/data@snap1"
    _mock_zfs_guid_lists["srcpool/data"]="guid1"
    _mock_zfs_guid_lists["destpool/srcpool/data"]="guid1"
    _mock_zfs_send_size="0"

    nextsnap="@test-2025-06-15T10:00-04:00-d"
    : > "$op_trace"
}

_create_mock_zfsdelfs() {
    local mock_delfs="$1" op_trace="$2" exit_code="${3:-0}"
    cat > "$mock_delfs" <<EOF
#!/usr/bin/bash
echo "zfsdelfs \$*" >> "$op_trace"
exit $exit_code
EOF
    chmod +x "$mock_delfs"
}

_install_lock_mocks() {
    local op_trace="$1" mock_delfs="$2"

    _saved_find=$(declare -f find_zfsutility_script)
    _saved_wait=$(declare -f zfslock_wait_or_resolve)
    _saved_release=$(declare -f zfslock_release)

    find_zfsutility_script() {
        if [[ "$1" == "zfsdelfs" ]]; then
            echo "$mock_delfs"
        else
            eval "$_saved_find"
            find_zfsutility_script "$@"
        fi
    }

    zfslock_wait_or_resolve() {
        echo "wait:$1" >> "$op_trace"
        ZFSLOCK_ID="/tmp/mock_lock_$$"
        return 0
    }
    zfslock_release() {
        echo "release:$*" >> "$op_trace"
    }
}

_restore_lock_mocks() {
    eval "$_saved_find"
    eval "$_saved_wait"
    eval "$_saved_release"
    unset _saved_find _saved_wait _saved_release
}

