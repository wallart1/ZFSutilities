#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfs-diagnose-busy — Unit tests for zfs-diagnose-busy: the report-only
# diagnose, the evidence probes, and the interactive busy resolver ladder.
# iscsi-lib is sourced with ISCSI_LIB_NO_BOOTSTRAP=1 (no bashinit re-run) so
# the resolver's iscsi_unplug_export / vm_* helpers are real and exercised
# against targetcli/ssh function mocks.
#
# Recording mocks append to FILES, not arrays: the probes invoke targetcli/
# ssh/zfs inside pipelines and command substitutions, and an in-memory array
# append made in those subshells never reaches the test shell.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

# Set msg_level to INFO so diagnostic messages are captured
export msg_level="INFO"

old_mydir="$mydir"

# Fixture files the manifest/encrypted-conf helpers read and mutate.
ISCSI_MANIFEST="$(mktemp)"
ISCSI_ENCRYPTED_CONF="$(mktemp)"
export ISCSI_MANIFEST ISCSI_ENCRYPTED_CONF

_MOCK_DIR=$(mktemp -d)

ISCSI_LIB_NO_BOOTSTRAP=1
# shellcheck source=../../lib/iscsi-lib.sh
source "$old_mydir/lib/iscsi-lib.sh"
source "$old_mydir/bin/zfs-diagnose-busy"

# Two-node shape for every status query (iscsi_check_vm_running's ssh
# branch): the vm run state comes from scripted ssh outcomes per test.
compute_host="tweety-test"

# ------------------------------------------------------------------
# Log capture
# ------------------------------------------------------------------
_DIAG_LOG=""
_DIAG_CAPTURE=""

start_capture() {
    _DIAG_CAPTURE=$(mktemp)
    _DIAG_LOG="$_DIAG_CAPTURE"
}

stop_capture() {
    local content=""
    if [[ -f "$_DIAG_LOG" ]]; then
        content=$(cat "$_DIAG_LOG")
        rm -f "$_DIAG_LOG"
    fi
    _DIAG_LOG=""
    _DIAG_CAPTURE=""
    echo "$content"
}

# Redirect log_msg to our capture file by overriding it locally.
log_msg() {
    if [[ -n "$_DIAG_LOG" ]]; then
        echo "$*" >> "$_DIAG_LOG"
    fi
    # Also call the real log_msg so tests see output normally
    command log_msg "$@" 2>/dev/null || true
}

# ------------------------------------------------------------------
# Mock helpers. Call logs are files (subshell-safe); ssh replays scripted
# outcomes from per-line files through a counter file.
# ------------------------------------------------------------------
mock_calls() { cat "$_MOCK_DIR/$1.log" 2>/dev/null || true; }
mock_count() { cat "$_MOCK_DIR/$1.log" 2>/dev/null | grep -c . || true; }

declare -A _mock_zfs_get_values=()
declare -A _mock_zfs_list_values=()
_mock_zfs_holds=""
_mock_qm_status=""
_mock_fuser_out=""
_mock_lsof_out=""
_mock_pgrep_out=""
_mock_targetcli_backstores=""
_mock_targetcli_iscsi=""
_mock_targetcli_luns=""
_mock_zfs_destroy_rc=0
_mock_zfs_release_rc=0
_mock_zfs_receive_rc=0
_busy_answers=()
_busy_prompts=()

reset_mocks() {
    _mock_zfs_get_values=()
    _mock_zfs_list_values=()
    declare -A _mock_zfs_get_values
    declare -A _mock_zfs_list_values
    _mock_zfs_holds=""
    _mock_qm_status=""
    _mock_fuser_out=""
    _mock_lsof_out=""
    _mock_pgrep_out=""
    _mock_targetcli_backstores=""
    _mock_targetcli_iscsi=""
    _mock_targetcli_luns=""
    _mock_zfs_destroy_rc=0
    _mock_zfs_release_rc=0
    _mock_zfs_receive_rc=0
    _busy_answers=()
    _busy_prompts=()
    : > "$ISCSI_MANIFEST"
    : > "$ISCSI_ENCRYPTED_CONF"
    local _m
    for _m in targetcli ssh zfs umount udevadm sleep; do
        : > "$_MOCK_DIR/${_m}.log"
    done
    : > "$_MOCK_DIR/ssh.rc"
    : > "$_MOCK_DIR/ssh.out"
    : > "$_MOCK_DIR/ssh.n"
}

# Script ssh outcomes: each call returns the next rc/outcome line pair.
mock_ssh_script() {
    local rc out
    printf '%s\n' "$1" > "$_MOCK_DIR/ssh.rc"
    printf '%s\n' "$2" > "$_MOCK_DIR/ssh.out"
    : > "$_MOCK_DIR/ssh.n"
}

zfs() {
    echo "$*" >> "$_MOCK_DIR/zfs.log"
    local subcmd="$1"
    shift
    case "$subcmd" in
        get)
            local prop="" dataset=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -H*|-p*) shift ;;
                    -o)
                        if [[ "$2" == "value" ]]; then
                            shift 2
                            continue
                        fi
                        shift 2
                        ;;
                    *)
                        if [[ -z "$prop" ]]; then
                            prop="$1"
                        else
                            dataset="$1"
                        fi
                        shift
                        ;;
                esac
            done
            local key="${dataset}:${prop}"
            if [[ -n "${_mock_zfs_get_values[$key]+x}" ]]; then
                echo "${_mock_zfs_get_values[$key]}"
            else
                echo "-"
            fi
            return 0
            ;;
        list)
            local type="" outcols="" have_listing_opt=0 specific_arg=""
            local arg_idx=1
            while [[ $arg_idx -le $# ]]; do
                local a="${*:$arg_idx:1}"
                case "$a" in
                    -t) type="${*:$((arg_idx+1)):1}";
                        have_listing_opt=1; ((arg_idx+=2)); continue ;;
                    -o) outcols="${*:$((arg_idx+1)):1}";
                        have_listing_opt=1; ((arg_idx+=2)); continue ;;
                    -H*|-d*|-r) have_listing_opt=1; ((arg_idx++)); continue ;;
                    -*) have_listing_opt=1; ((arg_idx++)); continue ;;
                    *) specific_arg="$a"; ((arg_idx++)); continue ;;
                esac
                ((arg_idx++))
            done
            if [[ "$outcols" == "clones" ]]; then
                if [[ -n "${_mock_zfs_list_values[${specific_arg}:clones]+x}" ]]; then
                    echo -e "${_mock_zfs_list_values[${specific_arg}:clones]}"
                fi
                return 0
            fi
            if [[ "$have_listing_opt" -eq 0 && -n "$specific_arg" && "$specific_arg" != -* ]]; then
                if [[ -n "${_mock_zfs_list_values[${specific_arg}:exists]+x}" ]]; then
                    echo "$specific_arg"
                    return 0
                fi
                return 1
            fi
            return 0
            ;;
        holds)
            if [[ -n "$_mock_zfs_holds" ]]; then
                echo -e "$_mock_zfs_holds"
            fi
            return 0
            ;;
        destroy)
            return "$_mock_zfs_destroy_rc"
            ;;
        release)
            return "$_mock_zfs_release_rc"
            ;;
        receive)
            return "$_mock_zfs_receive_rc"
            ;;
    esac
    return 0
}

targetcli() {
    echo "$*" >> "$_MOCK_DIR/targetcli.log"
    local path="$1"
    shift
    case "$path" in
        /backstores/block)
            if [[ "$1" == "ls" ]]; then
                echo "$_mock_targetcli_backstores"
            fi
            ;;
        /iscsi)
            if [[ "$1" == "ls" ]]; then
                echo "$_mock_targetcli_iscsi"
            fi
            ;;
        *)
            if [[ "$path" == /iscsi/*/tpg1/luns && "$1" == "ls" ]]; then
                echo "$_mock_targetcli_luns"
            fi
            ;;
    esac
    return 0
}

qm() {
    if [[ "$1" == "status" ]]; then
        echo "status: $_mock_qm_status"
    fi
    return 0
}

fuser() {
    if [[ -n "$_mock_fuser_out" ]]; then
        echo "$_mock_fuser_out"
        return 0
    fi
    return 1
}

lsof() {
    if [[ -n "$_mock_lsof_out" ]]; then
        echo "$_mock_lsof_out"
        return 0
    fi
    return 1
}

pgrep() {
    if [[ -n "$_mock_pgrep_out" ]]; then
        echo "$_mock_pgrep_out"
        return 0
    fi
    return 1
}

ps() {
    if [[ "$1" == "-p" ]]; then
        echo "proc-$2"
    fi
    return 0
}

ssh() {
    echo "$*" >> "$_MOCK_DIR/ssh.log"
    local n out rc
    n=$(cat "$_MOCK_DIR/ssh.n" 2>/dev/null || echo 0)
    n=$((n + 1))
    echo "$n" > "$_MOCK_DIR/ssh.n"
    rc=$(sed -n "${n}p" "$_MOCK_DIR/ssh.rc" 2>/dev/null)
    out=$(sed -n "${n}p" "$_MOCK_DIR/ssh.out" 2>/dev/null)
    [[ -n "$out" ]] && echo "$out"
    return "${rc:-0}"
}

umount() {
    echo "$*" >> "$_MOCK_DIR/umount.log"
    return 0
}

udevadm() {
    echo "$*" >> "$_MOCK_DIR/udevadm.log"
    return 0
}

sleep() {
    local total
    total=$(cat "$_MOCK_DIR/sleep.log" 2>/dev/null || echo 0)
    echo $((total + $1)) > "$_MOCK_DIR/sleep.log"
    return 0
}

# Default no-op kernel wrappers (tests override to inject evidence).
busy_findmnt_zfs() { :; }
busy_proc_mounts_files() { :; }

# Prompt mocks: interactive tests feed answers in prompt order.
ask_yn() {
    _busy_prompts+=("$1")
    local a="${_busy_answers[0]:-n}"
    _busy_answers=("${_busy_answers[@]:1}")
    case "$a" in
        y|Y|yes) return 0 ;;
        *) return 1 ;;
    esac
}

ask_line() {
    _busy_prompts+=("$1")
    local a="${_busy_answers[0]:-}"
    _busy_answers=("${_busy_answers[@]:1}")
    REPLY="$a"
    return 0
}

# Interactive-mode switch: the resolver asks only when the input-hold
# protocol is active (the harness has no tty).
_input_hold_active() { true; }

interactive_on() {
    unset busyassist
}

interactive_off() {
    busyassist=N
}

# Default to report-only for the harness shell.
interactive_off

