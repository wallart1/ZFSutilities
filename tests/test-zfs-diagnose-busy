test_diagnose_configfs_fallback() {
    test_start "Report: configfs walk finds export without targetcli"
    reset_mocks
    local root _saved_targetcli
    root=$(mktemp -d)
    mkdir -p "$root/target/core/block_backup-disk-7"
    printf '%s\n' "/dev/zvol/pool/proxmox/backup-disk-7" \
        > "$root/target/core/block_backup-disk-7/udev_path"
    BUSY_CONFIGFS_ROOT="$root"
    # Hide targetcli for this test (restore after — unset -f would delete
    # the recording mock for every later test).
    _saved_targetcli=$(declare -f targetcli)
    targetcli() { return 127; }
    start_capture
    diagnose_dataset_busy "pool/proxmox/backup-disk-7"
    local out
    out=$(stop_capture)
    eval "$_saved_targetcli"
    unset BUSY_CONFIGFS_ROOT
    rm -rf "$root"
    if [[ "$out" == *"backup-disk-7"* ]]; then
        test_pass
    else
        test_fail "Expected configfs-found backstore in output, got: $out"
    fi
}

