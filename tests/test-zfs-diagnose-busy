test_resolver_report_only_when_unattended() {
    test_start "Resolver: unattended runs report and return 2"
    reset_mocks
    interactive_off
    _mock_targetcli_backstores="  o- vm-105-disk-0 .........."
    _mock_targetcli_backstores+=" [/dev/zvol/pool/proxmox/vm-105-disk-0 (4GiB)]"
    _mock_targetcli_iscsi="iqn.2026-02.local.stewie:threeamigos"
    _mock_targetcli_luns="  | o- lun0  [block/vm-105-disk-0 (/dev/zvol/...)]"
    local rc calls
    busy_resolve_dataset_busy "pool/proxmox/vm-105-disk-0" \
        "cannot destroy: dataset is busy" >/dev/null 2>&1
    rc=$?
    calls=$(mock_calls targetcli)
    if [[ $rc -eq 2 && "$calls" != *"delete"* && ${#_busy_prompts[@]} -eq 0 ]]; then
        test_pass
    else
        local fail_msg="Expected rc=2, no prompt, no mutation;"
        fail_msg+=" rc=$rc calls=[$calls] prompts=${#_busy_prompts[@]}"
        test_fail "$fail_msg"
    fi
}

test_resolver_nothing_found_offers_retry() {
