# ------------------------------------------------------------------
# Ladder: iSCSI export
# ------------------------------------------------------------------

setup_export_world() {
    _mock_targetcli_backstores=$'  o- vm-105-disk-0 ..........'
    _mock_targetcli_backstores+=$' [/dev/zvol/pool/proxmox/vm-105-disk-0 (4GiB)]\n'
    _mock_targetcli_backstores+=$'  o- vm-101-disk-0 ..........'
    _mock_targetcli_backstores+=$' [/dev/zvol/pool/proxmox/vm-101-disk-0 (4GiB)]'
    _mock_targetcli_iscsi="iqn.2026-02.local.stewie:threeamigos"
    _mock_targetcli_luns="  | o- lun2  [block/vm-105-disk-0 (/dev/zvol/...)]"
    printf '%s\n' "vm-105-disk-0" "vm-101-disk-0" > "$ISCSI_MANIFEST"
}

test_resolver_stale_export_unplugs() {
    test_start "Resolver: leftover export unplugged without any VM impact"
    reset_mocks
    interactive_on
    setup_export_world
    local refs
    refs=$(mktemp)
    printf 'VM|threeamigos:0|101|web-101|scsi0\n' > "$refs"
    ISCSI_DETECT_VM_REFS_FILE="$refs"
    _busy_answers=(y)
    busy_resolve_dataset_busy "pool/proxmox/vm-105-disk-0" "" >/dev/null 2>&1
    local rc=$?
    interactive_off
    rm -f "$refs"
    unset ISCSI_DETECT_VM_REFS_FILE
    local calls manifest_left udev_calls
    calls=$(mock_calls targetcli)
    manifest_left=$(cat "$ISCSI_MANIFEST")
    udev_calls=$(mock_calls udevadm)
    if [[ $rc -eq 0 \
        && "$calls" == *"/iscsi/iqn.2026-02.local.stewie:threeamigos/tpg1/luns delete lun2"* \
        && "$calls" == *"/backstores/block delete vm-105-disk-0"* \
        && "$manifest_left" == *"vm-101-disk-0"* \
        && "$manifest_left" != *"vm-105-disk-0"* \
        && "$udev_calls" == *"settle"* ]]; then
        test_pass
    else
        test_fail "rc=$rc calls=[$calls] manifest=[$manifest_left] udev=[$udev_calls]"
    fi
}

