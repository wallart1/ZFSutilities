test_resolver_running_vm_menu_shutdown_first() {
    test_start "Resolver: running VM menu option 2 — shutdown, detach, unplug"
    reset_mocks
    interactive_on
    setup_export_world
    local refs
    refs=$(mktemp)
    printf 'VM|threeamigos:2|105|web-105|scsi0\n' > "$refs"
    ISCSI_DETECT_VM_REFS_FILE="$refs"
    # ssh outcomes, in order: the report pass's classification (running),
    # the menu's classification (running), option 2's re-check (running),
    # the qm shutdown command (quiet), one running poll, one stopped poll,
    # then the config detach.
    printf '%s\n' "0" "0" "0" "0" "0" "0" "0" > "$_MOCK_DIR/ssh.rc"
    printf '%s\n' "status: running" "status: running" "status: running" "" \
        "status: running" "status: stopped" "" > "$_MOCK_DIR/ssh.out"
    : > "$_MOCK_DIR/ssh.n"
    _busy_answers=(2)
    busy_resolve_dataset_busy "pool/proxmox/vm-105-disk-0" "" >/dev/null 2>&1
    local rc=$?
    interactive_off
    rm -f "$refs"
    unset ISCSI_DETECT_VM_REFS_FILE
    local ssh_calls
    ssh_calls=$(mock_calls ssh)
    if [[ $rc -eq 0 \
        && "$ssh_calls" == *"qm shutdown '105'"* \
        && "$ssh_calls" == *"qm set '105' --delete 'scsi0'"* ]]; then
        test_pass
    else
        test_fail "rc=$rc ssh=[$ssh_calls]"
    fi
}

