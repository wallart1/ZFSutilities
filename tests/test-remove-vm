}

test_single_node_reassigned_not_removed() {
    test_start "Single-node: reassigned zvol referenced by another VM is kept"

    local vmid="330"
    local other_vmid="331"
    local pve_dir="$_mock_zfs_state_dir/pve7"
    setup_pve_config "$pve_dir" "$vmid"
    setup_second_vm_config "$pve_dir" "$other_vmid" \
        "threeamigos:vm-${vmid}-disk-5,size=10G"

    local out rc
    out=$(run_remove single-node "$pve_dir" "$vmid" "y" \
        "threeamigos/proxmox/vm-${vmid}-disk-0 threeamigos/proxmox/vm-${vmid}-disk-5")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    if [[ "$out" != *"Reassigned zvols"* ]]; then
        test_fail "Reassigned warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"referenced by VM ${other_vmid}"* ]]; then
        test_fail "Reassigned zvol does not name the owning VM; output:\n$out"
        return
    fi

    local calls
    calls=$(zfsdelfs_calls)
    if [[ "$calls" != *"vm-${vmid}-disk-0"* ]]; then
        test_fail "Referenced zvol was not destroyed; calls:\n$calls"
        return
    fi
    if [[ "$calls" == *"vm-${vmid}-disk-5"* ]]; then
        test_fail "Reassigned zvol should not have been destroyed; calls:\n$calls"
        return
    fi

    test_pass
}

