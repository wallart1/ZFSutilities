test_two_node_reassigned_not_removed() {
    test_start "Two-node: reassigned zvol referenced by another VM is kept"

    local vmid="340"
    local other_vmid="341"
    local pve_dir="$_mock_zfs_state_dir/pve9"
    # Target VM config has no disk lines; the other VM references lun 0,
    # which maps to the zvol named after the target VM.
    mkdir -p "$pve_dir"
    cat > "${pve_dir}/${vmid}.conf" << EOF
name: test-vm
EOF
    setup_second_vm_config "$pve_dir" "$other_vmid" \
        "/dev/disk/by-path/ip-192.168.100.1:3260-iscsi-iqn.2026-02.local.stewie:threeamigos-lun-0,format=raw,discard=on,iothread=1,size=10G"

    local out rc
    out=$(run_remove two-node "$pve_dir" "$vmid" "y" \
        "threeamigos/proxmox/vm-${vmid}-disk-0")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    if [[ "$out" != *"Reassigned zvols"* ]]; then
        test_fail "Reassigned warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"referenced by VM ${other_vmid}"* ]]; then
        test_fail "Reassigned zvol does not name the owning VM; output:\n$out"
        return
    fi

    local calls
    calls=$(zfsdelfs_calls)
    if [[ -n "$calls" ]]; then
        test_fail "zfsdelfs should not have been called; calls:\n$calls"
        return
    fi

    test_pass
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_rejects_invalid_vmid
test_no_zvols_or_config
test_single_node_lists_zvols_and_removes
test_single_node_aborts_on_no
test_two_node_includes_iscsi_info
test_two_node_removes_via_ssh
test_single_node_orphan_warned_not_removed
test_single_node_cleanup_orphans_removes
test_single_node_reassigned_not_removed
test_single_node_cleanup_orphans_keeps_reassigned
test_two_node_reassigned_not_removed

test_summary
