    local vmid="311"
    local pve_dir="$_mock_zfs_state_dir/pve3"
    setup_pve_config "$pve_dir" "$vmid" two-node

    local out rc
    out=$(run_remove two-node "$pve_dir" "$vmid" "y")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    if [[ "$out" != *"iqn.2026-02.local.stewie:threeamigos"* ]]; then
        test_fail "iSCSI target not listed; output:\n$out"
        return
    fi

    if [[ "$out" != *"LUN 0"* ]]; then
        test_fail "LUN not listed; output:\n$out"
        return
    fi

    test_pass
}

test_two_node_removes_via_ssh() {
    test_start "Two-node: calls zfsdelfs on storage host and saves iSCSI config"

    local vmid="312"
    local pve_dir="$_mock_zfs_state_dir/pve4"
    setup_pve_config "$pve_dir" "$vmid" two-node

    local out rc
    out=$(run_remove two-node "$pve_dir" "$vmid" "y")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    local calls
    calls=$(zfsdelfs_calls)
    if [[ "$calls" != *"threeamigos/proxmox/vm-${vmid}-disk-0"* ]]; then
        test_fail "Remote zfsdelfs call missing; calls:\n$calls"
        return
    fi

    if [[ ! -s "$_mock_zfs_state_dir/capture/iscsi_save" ]]; then
        test_fail "safe-iscsi-save was not called"
        return
    fi

    if [[ ! -s "$_mock_zfs_state_dir/capture/rescan" ]]; then
        test_fail "rescan-storage was not called"
        return
    fi

    test_pass
}

test_single_node_orphan_warned_not_removed() {
    test_start "Single-node: orphaned matching zvol is warned about but kept"

    local vmid="320"
    local pve_dir="$_mock_zfs_state_dir/pve5"
    setup_pve_config "$pve_dir" "$vmid"

    local out rc
    out=$(run_remove single-node "$pve_dir" "$vmid" "y" \
        "threeamigos/proxmox/vm-${vmid}-disk-0 threeamigos/proxmox/vm-${vmid}-disk-5")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi

    if [[ "$out" != *"Orphaned zvols"* ]]; then
        test_fail "Orphan warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"vm-${vmid}-disk-5"* ]]; then
        test_fail "Orphan zvol not listed; output:\n$out"
        return
    fi

    local calls
    calls=$(zfsdelfs_calls)
    if [[ "$calls" != *"vm-${vmid}-disk-0"* ]]; then
        test_fail "Referenced zvol was not destroyed; calls:\n$calls"
        return
    fi
    if [[ "$calls" == *"vm-${vmid}-disk-5"* ]]; then
        test_fail "Orphan zvol should not have been destroyed; calls:\n$calls"
        return
    fi

    test_pass
}

test_single_node_cleanup_orphans_removes() {
    test_start "Single-node: --cleanup-orphans also removes orphaned zvols"

    local vmid="321"
    local pve_dir="$_mock_zfs_state_dir/pve6"
    setup_pve_config "$pve_dir" "$vmid"

    local out rc
    out=$(run_remove single-node "$pve_dir" "$vmid" "y" \
