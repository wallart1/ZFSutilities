    cat > "$prestate/backstores" <<'EOF'
  vm-100-disk-0  /dev/zvol/threeamigos/proxmox/vm-100-disk-0  50G
  vm-101-disk-0  /dev/zvol/threeamigos/proxmox/vm-101-disk-0  50G
EOF
    cat > "$prestate/luns/iqn.2026-02.local.stewie:threeamigos" <<'EOF'
  lun0 block/vm-100-disk-0 (rw) oops
  lun5 block/vm-101-disk-0 (rw) oops
EOF
    _std_acl_prestate "$prestate"

    local result rc=0
    result=$(_run_recover "$confdir" "$tmpdir/save.json" "$prestate") || rc=$?

    # Both mappings count as "already", so no save/rescan runs (CALLS empty),
    # but the missing grants are created.
    if [[ "$rc" -eq 0 ]] \
        && [[ "$result" == *"CALLS:[]"* ]] \
        && [[ "$result" == *"[lun0 block/vm (rw)]"* ]] \
        && [[ "$result" == *"[lun5 block/vm (rw)]"* ]]; then
        test_pass
    else
        test_fail "rc=$rc result=$result"
    fi
    rm -rf "$tmpdir"
}

test_grant_failure_fails_the_entry() {
    test_start "A grant-create failure fails the entry (rc 1); other entries still recover"
    local tmpdir
    tmpdir=$(mktemp -d)
    local confdir="$tmpdir/etc/zfsutilities"
    _std_encrypted_conf "$confdir" "$tmpdir"
    _std_saveconfig "$tmpdir/save.json"
    local prestate="$tmpdir/prestate"
    _std_acl_prestate "$prestate"

    local result rc=0
    result=$(_run_recover "$confdir" "$tmpdir/save.json" "$prestate" "0") || rc=$?

    if [[ "$rc" -ne 0 ]] \
        && [[ "$result" != *"[lun0 block/vm (rw)]"* ]] \
        && [[ "$result" == *"[lun5 block/vm (rw)]"* ]] \
        && [[ "$result" == *"safe-iscsi-save"* ]]; then
        test_pass
    else
        test_fail "rc=$rc result=$result"
    fi
    rm -rf "$tmpdir"
}

