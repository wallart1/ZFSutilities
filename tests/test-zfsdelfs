#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfsdelfs — Unit tests for iSCSI teardown/rebuild and manifest cleanup.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Create a minimal node configuration for the script to source.
# ------------------------------------------------------------------
NODE_CONF_FILE="$_mock_zfs_state_dir/node.conf"
cat > "$NODE_CONF_FILE" << 'EOF'
NODE_MODE=two-node
STORAGE_HOST=stewie
COMPUTE_HOST=tweety
STORAGE_IP=10.0.0.1
IQN_PREFIX=iqn.2026-02.local.stewie
POOL_TARGET=(
    [threeamigos]="threeamigos"
    [NVME1]="nvme1"
)
EOF
NODE_CONF="$NODE_CONF_FILE"

# ------------------------------------------------------------------
# Source zfsdelfs (it will not run delfs because it is being sourced).
# ------------------------------------------------------------------
source "$mydir/bin/zfsdelfs"

# ------------------------------------------------------------------
# Mock targetcli
# ------------------------------------------------------------------
targetcli() {
    case "$*" in
        "/backstores/block ls")
            if [[ "$_mock_backstores" == "empty" ]]; then
                true
            else
                printf '%s\n' "$_mock_backstores"
            fi
            ;;
        "/iscsi/iqn.2026-02.local.stewie:threeamigos/tpg1/luns ls")
            if [[ "$_mock_luns" == "empty" ]]; then
                true
            else
                printf '%s\n' "$_mock_luns"
            fi
            ;;
        "/iscsi ls")
            if [[ "$_mock_targets" == "empty" ]]; then
                true
            else
                printf '%s\n' "$_mock_targets"
            fi
            ;;
        "/backstores/block/vm-100-disk-0 info")
            echo "  UDev path: /dev/zvol/threeamigos/proxmox/vm-100-disk-0"
            ;;
        "/backstores/block/vm-100-disk-0"*"delete")
            _mock_targetcli_calls+=("delete:$1:$2")
            ;;
        "/iscsi/iqn.2026-02.local.stewie:threeamigos/tpg1/luns"*"delete")
            _mock_targetcli_calls+=("delete_lun:$3")
            ;;
        "/backstores/block"*"create")
            _mock_targetcli_calls+=("create:$2:$3")
            ;;
        "/iscsi/iqn.2026-02.local.stewie:threeamigos/tpg1/luns"*"create")
            _mock_targetcli_calls+=("create_lun:$3:$4")
            ;;
        *)
            _mock_targetcli_calls+=("other:$*")
            ;;
    esac
}

# ------------------------------------------------------------------
# Mock ssh and qm
# ------------------------------------------------------------------
ssh() {
    local cmd="${!#}"
    if [[ "$cmd" == *"qm status"* ]]; then
        echo "status: stopped"
    fi
    return 0
}

qm() { echo "status: stopped"; }

# ------------------------------------------------------------------
# Manifest temp files
# ------------------------------------------------------------------
setup_manifests() {
    ISCSI_MANIFEST="$_mock_zfs_state_dir/expected-backstores.txt"
    ISCSI_ENCRYPTED_CONF="$_mock_zfs_state_dir/iscsi-encrypted-luns.conf"
    echo "vm-100-disk-0" > "$ISCSI_MANIFEST"
    local _enc_line="vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos"
    echo "$_enc_line" > "$ISCSI_ENCRYPTED_CONF"
}

# ------------------------------------------------------------------
# Test helpers
# ------------------------------------------------------------------
reset_mocks() {
    _mock_backstores="  vm-100-disk-0     /dev/zvol/threeamigos/proxmox/vm-100-disk-0   50G"
    _mock_luns="  | o- lun0 ................................... [block/vm-100-disk-0]"
    _mock_targets="  iqn.2026-02.local.stewie:threeamigos"
    _mock_targetcli_calls=()
    setup_manifests
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_teardown_removes_expected_backstore() {
    reset_mocks
    test_start "Teardown removes backstore from expected-backstores manifest"

    iscsi_teardown_zvol "threeamigos/proxmox/vm-100-disk-0"
    local rc=$?

    if [[ $rc -eq 0 ]] && ! grep -q "^vm-100-disk-0$" "$ISCSI_MANIFEST"; then
        test_pass
    else
        test_fail "Backstore still in expected-backstores manifest"
    fi
}

test_teardown_removes_encrypted_conf() {
    reset_mocks
    test_start "Teardown removes backstore from encrypted-luns config"

    iscsi_teardown_zvol "threeamigos/proxmox/vm-100-disk-0"
    local rc=$?

    if [[ $rc -eq 0 ]] && ! grep -q "^vm-100-disk-0:" "$ISCSI_ENCRYPTED_CONF"; then
        test_pass
    else
        test_fail "Backstore still in encrypted-luns config"
    fi
}

test_teardown_records_encrypted_flag() {
    reset_mocks
    test_start "Teardown records encrypted flag in ISCSI_TEARDOWN"

    iscsi_teardown_zvol "threeamigos/proxmox/vm-100-disk-0"

    local value="${ISCSI_TEARDOWN["threeamigos/proxmox/vm-100-disk-0"]}"
    if [[ "$value" == *":Y" ]]; then
        test_pass
    else
        test_fail "Expected ISCSI_TEARDOWN value ending in :Y, got '$value'"
    fi
}

test_teardown_records_unencrypted_flag() {
    reset_mocks
    echo "" > "$ISCSI_ENCRYPTED_CONF"  # no encrypted entry
    test_start "Teardown records unencrypted flag when not in encrypted config"

    iscsi_teardown_zvol "threeamigos/proxmox/vm-100-disk-0"

    local value="${ISCSI_TEARDOWN["threeamigos/proxmox/vm-100-disk-0"]}"
    if [[ "$value" == *":N" ]]; then
        test_pass
    else
        test_fail "Expected ISCSI_TEARDOWN value ending in :N, got '$value'"
    fi
}

test_manifest_add_backstore() {
    reset_mocks
    # Empty the manifest so we can verify the add.
    echo "" > "$ISCSI_MANIFEST"
    test_start "manifest_add_backstore adds backstore to expected-backstores manifest"

    manifest_add_backstore "vm-100-disk-0"

    if grep -q "^vm-100-disk-0$" "$ISCSI_MANIFEST"; then
        test_pass
    else
        test_fail "Backstore not added to expected-backstores manifest"
    fi
}

test_encrypted_conf_add_backstore() {
    reset_mocks
    echo "" > "$ISCSI_ENCRYPTED_CONF"
    test_start "encrypted_conf_add_backstore adds backstore to encrypted-luns config"

    encrypted_conf_add_backstore "vm-100-disk-0" \
        "/dev/zvol/threeamigos/proxmox/vm-100-disk-0" \
        "threeamigos"

    local _enc_pat="^vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos"
    if grep -q "$_enc_pat" "$ISCSI_ENCRYPTED_CONF"; then
        test_pass
    else
        test_fail "Backstore not added to encrypted-luns config"
    fi
}

test_teardown_skips_non_vm_disk() {
    reset_mocks
    test_start "Teardown skips datasets not matching vm-<N>-disk-<N>"

    iscsi_teardown_zvol "threeamigos/data"
    local rc=$?

    if [[ $rc -eq 0 && -z "${_mock_targetcli_calls[*]}" ]]; then
        test_pass
    else
        test_fail "Should not touch non-VM datasets"
    fi
}

# ------------------------------------------------------------------
# Locking tests for delfs()
# ------------------------------------------------------------------

run_delfs_locked() {
    local _state_dir="$1"
    local _mock_bin="$_state_dir/mockbin"
    mkdir -p "$_mock_bin"

    # zfsdelfs resolves helpers relative to its own directory ($_zfsdelfs_dir).
    # Run it from a mock bin directory so the locking tests stay isolated from
    # the real helpers.
    cp "$mydir/bin/zfsdelfs" "$_mock_bin/zfsdelfs"

    cat > "$_mock_bin/zfsbuildfsarray" <<'EOF'
buildfsarray() { fsarray=("${_mock_delfs_fsarray[@]}"); }
EOF
    cat > "$_mock_bin/zfsdelallsnaps" <<'EOF'
delallsnaps() { return 0; }
EOF
    cat > "$_mock_bin/zfsoverrides" <<'EOF'
overrides() { true; }
EOF
    cat > "$_mock_bin/zfs-diagnose-busy" <<'EOF'
diagnose_dataset_busy() { true; }
EOF
    cat > "$_mock_bin/zfslockmanager" <<EOF
zfslock_init() { true; }
zfslock_wait_or_resolve() {
    echo "\$1 \$2" >> "$_state_dir/lock.log"
    if [[ "\${_mock_lock_conflict:-}" == "\$1" ]]; then return 1; fi
    ZFSLOCK_ID="$_state_dir/lock_\${1//\\//_}"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF
    cat > "$_state_dir/node.conf" <<'EOF'
NODE_MODE=single-node
EOF

    (
        NODE_CONF="$_state_dir/node.conf"
        mydir="$_mock_bin"
        # shellcheck source=/dev/null
        source "$_mock_bin/zfsdelfs"
        autoproceed='Y'
        _mock_delfs_fsarray=(pool/data)
        mock_zfs_dataset_exists "pool/data"
        (delfs "pool/data" >"$_state_dir/out" 2>"$_state_dir/err")
        echo $? > "$_state_dir/rc"
    )
}

test_delfs_acquires_destroy_lock() {
    reset_mocks
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/delfs_lock_test"
    mkdir -p "$_state_dir"
    : > "$_state_dir/lock.log"
    run_delfs_locked "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    test_start "delfs acquires an x lock on the top-level dataset"
    if [[ "$rc" -eq 0 ]] && [[ -f "$_state_dir/lock.log" ]] &&
        grep -q '^pool/data x$' "$_state_dir/lock.log"; then
        test_pass
    else
        local _log
        _log=$(cat "$_state_dir/lock.log" 2>/dev/null)
        test_fail "Expected rc=0 and x lock on pool/data, got rc=$rc, log=$_log"
    fi
}

test_delfs_aborts_when_locked() {
    reset_mocks
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/delfs_conflict_test"
    mkdir -p "$_state_dir"
    : > "$_state_dir/lock.log"
    (
        export _mock_lock_conflict="pool/data"
        run_delfs_locked "$_state_dir"
    )
    local rc
    rc=$(cat "$_state_dir/rc")
    test_start "delfs aborts when it cannot acquire destroy lock"
    if [[ "$rc" -eq 8 ]]; then
        test_pass
    else
        test_fail "Expected rc=8 when lock conflict, got rc=$rc"
    fi
}

# ------------------------------------------------------------------
# Regression test: direct execution must pass the overrides argument
# ------------------------------------------------------------------

run_delfs_subprocess() {
    local _state_dir="$1"
    local _mock_bin="$_state_dir/mockbin"
    local _mock_home="$_state_dir/home"
    mkdir -p "$_mock_bin" "$_mock_home" "$_state_dir/logs"

    cp "$mydir/bin/zfsdelfs" "$_mock_bin/zfsdelfs"
    # Provide a private ~/bashinit so the subprocess bootstraps itself.
    ln -sfn "$mydir/bin/bashinit" "$_mock_home/bashinit"

    cat > "$_mock_bin/node-lib.sh" <<'EOF'
NODE_MODE=single-node
is_single_node() { return 0; }
is_two_node() { return 1; }
EOF
    cat > "$_mock_bin/zfsbuildfsarray" <<'EOF'
buildfsarray() { fsarray=("${_mock_delfs_fsarray[@]}"); }
EOF
    cat > "$_mock_bin/zfsdelallsnaps" <<'EOF'
delallsnaps() { return 0; }
EOF
    cat > "$_mock_bin/zfsoverrides" <<'EOF'
overrides() { eval "$*"; }
EOF
    cat > "$_mock_bin/zfs-diagnose-busy" <<'EOF'
diagnose_dataset_busy() { true; }
EOF
    cat > "$_mock_bin/zfslockmanager" <<EOF
zfslock_init() { true; }
zfslock_wait_or_resolve() {
    ZFSLOCK_ID="$_state_dir/lock_\${1//\\//_}"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF
    cat > "$_mock_bin/rootcheck" <<'EOF'
rootcheck() { true; }
EOF
    cat > "$_mock_bin/iscsi-lib.sh" <<'EOF'
declare -A ISCSI_TEARDOWN
iscsi_teardown_zvol() { return 0; }
EOF
    cat > "$_state_dir/node.conf" <<'EOF'
NODE_MODE=single-node
EOF
    cat > "$_mock_bin/zfs" <<'EOF'
#!/usr/bin/bash
case "$*" in
    "list -t filesystem,volume pool/data") exit 0 ;;
    "list -H -t snapshot -o clones -r pool/data") echo "-" ;;
    "destroy pool/data") exit 0 ;;
    *) exit 0 ;;
esac
EOF
    chmod +x "$_mock_bin/zfs"

    _mock_delfs_fsarray=(pool/data) \
        HOME="$_mock_home" \
        NODE_CONF="$_state_dir/node.conf" \
        ZFSUTILITIES_BIN_DIR="$_mock_bin" \
        ZFSUTILITIES_DISABLE_MIGRATION=1 \
        ZFSUTILITIES_SESSION_LOG_DIR="$_state_dir/logs" \
        timeout 5 "$_mock_bin/zfsdelfs" "pool/data" '' '' '' "autoproceed='Y'" \
        >"$_state_dir/out" 2>"$_state_dir/err"
    echo $? > "$_state_dir/rc"
}

test_delfs_autoproceed_override_subprocess() {
    reset_mocks
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/delfs_autoproceed_test"
    mkdir -p "$_state_dir"
    run_delfs_subprocess "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    local _combined
    _combined=$(cat "$_state_dir/out" "$_state_dir/err" 2>/dev/null)
    test_start "delfs honors autoproceed='Y' override when executed as subprocess"
    # With the override honored, the interactive "About to delete..." prompt
    # block is skipped entirely. If the override is dropped, that message is
    # emitted and the script then waits at read -p.
    if [[ "$rc" -eq 0 && "$_combined" != *"About to delete"* ]]; then
        test_pass
    else
        test_fail "Expected rc=0 and no 'About to delete' prompt, got rc=$rc, output: $_combined"
    fi
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_teardown_removes_expected_backstore
test_teardown_removes_encrypted_conf
test_teardown_records_encrypted_flag
test_teardown_records_unencrypted_flag
test_manifest_add_backstore
test_encrypted_conf_add_backstore
test_teardown_skips_non_vm_disk
test_delfs_acquires_destroy_lock
test_delfs_aborts_when_locked
test_delfs_autoproceed_override_subprocess

test_summary
