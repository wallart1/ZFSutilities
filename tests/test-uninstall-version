    fi

    _teardown_uninstall_version_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "missing version directory was not rejected"
    fi
}

test_usage_help() {
    test_start "-h and --help print usage"
    local tmpdir
    _setup_uninstall_version_env tmpdir

    local output rc
    output=$("$tmpdir/uninstall-version" -h 2>&1)
    rc=$?

    local failed=0
    if [[ $rc -eq 0 ]]; then
        failed=1
        echo "    Expected non-zero rc for help, got $rc"
    fi
    if [[ "$output" != *"Usage:"* ]]; then
        failed=1
        echo "    usage text missing"
    fi
    if [[ "$output" != *"-y, --yes"* ]]; then
        failed=1
        echo "    -y option description missing"
    fi

    _teardown_uninstall_version_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "help output incorrect"
    fi
}

