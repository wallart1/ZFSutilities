#!/usr/bin/bash
# test-uninstall-version — Verify the version-removal script.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"

setup_test_env

UNINSTALL_VERSION_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../bin/uninstall-version"
[[ -f "$UNINSTALL_VERSION_SCRIPT" ]] || die "Missing: $UNINSTALL_VERSION_SCRIPT"

# Helper: set up a temp environment with an isolated copy of uninstall-version.
# The temp directory is assigned to the caller variable named by $1.
_setup_uninstall_version_env() {
    local _varname="$1"
    local _tmpdir
    _tmpdir=$(mktemp -d)

    export ZFSUTILITIES_VERSION_BASE="$_tmpdir/usr/local/lib/zfsutilities"
    export UNINSTALL_VERSION_TEST_NO_ROOT=1
    export HOME="$_tmpdir/home"
    mkdir -p "$ZFSUTILITIES_VERSION_BASE/versions" "$HOME"

    # Copy the script under test so it sources our fake rootcheck.
    cp "$UNINSTALL_VERSION_SCRIPT" "$_tmpdir/uninstall-version"
    chmod +x "$_tmpdir/uninstall-version"
    printf '#!/usr/bin/bash\nrootcheck() { true; }\n' > "$_tmpdir/rootcheck"
    chmod +x "$_tmpdir/rootcheck"
    # Provide a minimal bashinit so subshells can source it from $HOME.
    printf '#!/usr/bin/bash\nfunction bashinit {\n    mydir=$(dirname "$(realpath "${BASH_SOURCE[1]}")")\n}\nfunction log_msg { echo -e "$*" >&2; }\nfunction find_zfsutility_script {\n    local name="$1"\n    if [[ -f "$mydir/$name" ]]; then realpath "$mydir/$name"; return 0; fi\n    if [[ -f "$mydir/bin/$name" ]]; then realpath "$mydir/bin/$name"; return 0; fi\n    return 1\n}\nfunction source_helper {\n    local name="$1" path\n    path=$(find_zfsutility_script "$name")\n    [[ -n "$path" ]] && source "$path"\n}\nfunction die { log_msg "FATAL: $*"; source "$mydir/bin/bashfatal" "${1:-8}"; }\n' > "$HOME/bashinit"
    printf 'exit "${1:-8}"\n' > "$_tmpdir/bashfatal"

    printf -v "$_varname" '%s' "$_tmpdir"
}

# Helper: clean up a temp environment and unset overrides.
_teardown_uninstall_version_env() {
    local tmpdir="$1"
    unset ZFSUTILITIES_VERSION_BASE
    unset UNINSTALL_VERSION_TEST_NO_ROOT
    unset HOME
    rm -rf "$tmpdir"
}

# Helper: create a fake deployed version directory.
_make_fake_version() {
    local version_base="$1"
    local version="$2"
    mkdir -p "$version_base/versions/$version/bin"
    printf '#!/usr/bin/bash\nexit 0\n' > "$version_base/versions/$version/bin/example"
    chmod +x "$version_base/versions/$version/bin/example"
}

test_default_removes_after_confirmation() {
    test_start "default invocation prompts and removes version on Y"
    local tmpdir
    _setup_uninstall_version_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0"

    local output rc
    output=$(echo "Y" | "$tmpdir/uninstall-version" "1.0.0" 2>&1)
    rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ -d "$ZFSUTILITIES_VERSION_BASE/versions/1.0.0" ]]; then
        failed=1
        echo "    version directory still exists"
    fi
    if [[ "$output" != *"Removed: 1.0.0"* ]]; then
        failed=1
        echo "    expected removal message not found"
    fi

    _teardown_uninstall_version_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "default removal after confirmation failed"
    fi
}

test_default_aborts_after_rejection() {
    test_start "default invocation aborts on N"
    local tmpdir
    _setup_uninstall_version_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0"

    local output rc
    output=$(echo "N" | "$tmpdir/uninstall-version" "1.0.0" 2>&1)
    rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0 for abort, got $rc"
    fi
    if [[ ! -d "$ZFSUTILITIES_VERSION_BASE/versions/1.0.0" ]]; then
        failed=1
        echo "    version directory was removed despite abort"
    fi
    if [[ "$output" != *"Aborted."* ]]; then
        failed=1
        echo "    expected abort message not found"
    fi

    _teardown_uninstall_version_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "abort on N failed"
    fi
}

