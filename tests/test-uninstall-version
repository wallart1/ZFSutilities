test_refuses_active_version() {
    test_start "refuses to remove the currently active version"
    local tmpdir
    _setup_uninstall_version_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0"
    ln -sfn "versions/1.0.0" "$ZFSUTILITIES_VERSION_BASE/current"

    local rc
    "$tmpdir/uninstall-version" -y "1.0.0" >/dev/null 2>&1
    rc=$?

    local failed=0
    if [[ $rc -eq 0 ]]; then
        failed=1
        echo "    Expected non-zero rc, got $rc"
    fi
    if [[ ! -d "$ZFSUTILITIES_VERSION_BASE/versions/1.0.0" ]]; then
        failed=1
        echo "    active version directory was removed"
    fi

    _teardown_uninstall_version_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "active version protection failed"
    fi
}

