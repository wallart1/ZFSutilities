#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# tests/test-zfsdailybackup — Verify pull-step failure handling in zfsdailybackup.
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"

setup_test_env

# zfsdailybackup sources rsync-dailybackup, which is site-specific and not
# shipped. Provide a minimal stub via ZFSUTILITIES_BIN_DIR so the script can
# load without finding the production deployment copy.
RSYNC_HELPER_DIR=$(mktemp -d)
printf '#!/usr/bin/bash\nfunction rsync-dailybackup { :; }\n' \
    > "$RSYNC_HELPER_DIR/rsync-dailybackup"
chmod +x "$RSYNC_HELPER_DIR/rsync-dailybackup"

# Stub node confs covering node-lib's full resolution order, so the suite
# never depends on whatever conf files happen to exist on the test host.
DAILY_CONF_DIR=$(mktemp -d)
mkdir -p "$DAILY_CONF_DIR/fhs"
printf 'NODE_MODE="single-node"\nTHIS_HOST="testhost"\n' \
    > "$DAILY_CONF_DIR/fhs/node.conf"
printf 'NODE_MODE="single-node"\nTHIS_HOST="legacyhost"\n' \
    > "$DAILY_CONF_DIR/legacy-node.conf"
printf 'NODE_MODE="single-node"\nTHIS_HOST="twohost"\n' \
    > "$DAILY_CONF_DIR/legacy-two-node.conf"

# zfsdailybackup / zfssnapbuild stores its nextsnap file under the caller script
# name.  Ensure stale files are gone so zfssnapbuild does not prompt.
rm -f /run/zfsutilities/nextsnap_zfsdailybackup /run/zfsutilities/nextsnap_zfssnapbuild

# Disable everything except the Rocky remote pull step.
_zfsdaily_disabled="pull_tweety='N'; pull_stewie='N'; backup_threeamigos_proxmox='N'; "
_zfsdaily_disabled+="backup_NVME1='N'; prune='N'"
readonly DISABLE_ALL_BUT_ROCKY="$_zfsdaily_disabled"

# Disable all backup steps so helper functions can be exercised in isolation.
_zfsdaily_alloff="pull_rocky='N'; pull_tweety='N'; pull_stewie='N'; "
_zfsdaily_alloff+="backup_threeamigos_proxmox='N'; backup_NVME1='N'; prune='N'"
readonly DISABLE_ALL_STEPS="$_zfsdaily_alloff"

# Common mocks used inside every subshell that sources zfsdailybackup.
_mock_interactive() {
    # Bypass rootcheck so tests run as the current (non-root) user.
    id() { echo 0; }
    # Bypass the "press enter" prompt and, if a stale snapfile exists, make
    # ask_yn treat the response as yes.
    read() {
        local last="${!#}"
        if [[ $# -gt 0 && "$last" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            printf -v "$last" "y"
        fi
        return 0
    }
}

# Run zfsdailybackup in a subshell with the given mocks and overrides.
# Stderr is captured so WARN/INFO log lines can be inspected.
_run_dailybackup() {
    local overrides="$1"
    shift
    local output
    output=$({
        msg_level="INFO"
        _mock_interactive
        while [[ $# -gt 0 ]]; do
            case "$1" in
                scp) shift; eval "scp() { $1; }"; shift ;;
                ssh) shift; eval "ssh() { $1; }"; shift ;;
                *) break ;;
            esac
        done
        mydir="$mydir/bin"
        ZFSUTILITIES_BIN_DIR="$RSYNC_HELPER_DIR"
        ZFSUTILITIES_SYSTEM_CONFIG_DIR="$DAILY_CONF_DIR/fhs"
        ZFSUTILITIES_LEGACY_NODE_CONF="$DAILY_CONF_DIR/legacy-node.conf"
        ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$DAILY_CONF_DIR/legacy-two-node.conf"
        source "$mydir/zfsdailybackup" "$overrides"
    } 2>&1)
    echo "$output"
}

test_remote_pull_push_failure_continues() {
    test_start "Failed remote push logs WARN and backup continues"
    local output
    output=$(_run_dailybackup "$DISABLE_ALL_BUT_ROCKY" scp 'return 1' ssh 'return 255')
    assert_contains "$output" "WARN:"
    assert_contains "$output" "zfsdailybackup completed"
}

test_remote_pull_ssh_failure_continues() {
    test_start "Failed remote ssh pull logs WARN and backup continues"
    local output
    output=$(_run_dailybackup "$DISABLE_ALL_BUT_ROCKY" scp 'return 0' ssh 'return 24')
    assert_contains "$output" "WARN: Pull from Rocky failed"
    assert_contains "$output" "zfsdailybackup completed"
}

test_local_pull_failure_continues() {
    test_start "Failed local pull logs WARN and continues"
    local output
    output=$({
        msg_level="INFO"
        _mock_interactive
        mydir="$mydir/bin"
        ZFSUTILITIES_BIN_DIR="$RSYNC_HELPER_DIR"
        ZFSUTILITIES_SYSTEM_CONFIG_DIR="$DAILY_CONF_DIR/fhs"
        ZFSUTILITIES_LEGACY_NODE_CONF="$DAILY_CONF_DIR/legacy-node.conf"
        ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$DAILY_CONF_DIR/legacy-two-node.conf"
        source "$mydir/zfsdailybackup" "$DISABLE_ALL_STEPS"
        rsync-dailybackup() { return 6; }
        _run_local_pull
    } 2>&1)
    assert_contains "$output" "WARN: Local pull failed"
}

test_dry_run_pull_does_not_execute() {
    test_start "Dry-run mode logs intent and does not execute pull helpers"
    local output
    output=$(_run_dailybackup "dryrun='Y'; $DISABLE_ALL_BUT_ROCKY" ssh 'return 255')
    assert_contains "$output" "Dry-run: Would push rsync scripts to rocky"
    assert_contains "$output" "zfsdailybackup completed"
    # No ssh should have been called in dry-run mode.
    if [[ "$output" == *"Pull from Rocky failed"* ]]; then
        test_fail "Dry-run unexpectedly executed pull helper"
    else
        test_pass
    fi
}

test_node_conf_prefers_fhs_conf() {
    test_start "Node config resolution prefers the FHS conf over legacy paths"
    local output
    output=$({
        msg_level="INFO"
        _mock_interactive
        mydir="$mydir/bin"
        ZFSUTILITIES_BIN_DIR="$RSYNC_HELPER_DIR"
        unset NODE_CONF
        ZFSUTILITIES_SYSTEM_CONFIG_DIR="$DAILY_CONF_DIR/fhs" \
        ZFSUTILITIES_LEGACY_NODE_CONF="$DAILY_CONF_DIR/legacy-node.conf" \
        ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$DAILY_CONF_DIR/legacy-two-node.conf" \
        source "$mydir/zfsdailybackup" "$DISABLE_ALL_STEPS"
        echo "resolved=$NODE_CONF storage=$storage_host"
    } 2>&1)
    assert_contains "$output" "resolved=$DAILY_CONF_DIR/fhs/node.conf"
    assert_contains "$output" "storage=testhost"
}

test_remote_pull_push_failure_continues
test_remote_pull_ssh_failure_continues
test_local_pull_failure_continues
test_dry_run_pull_does_not_execute
test_node_conf_prefers_fhs_conf

rm -f /run/zfsutilities/nextsnap_zfsdailybackup /run/zfsutilities/nextsnap_zfssnapbuild
rm -rf "$RSYNC_HELPER_DIR" "$DAILY_CONF_DIR"
teardown_test_env
test_summary
