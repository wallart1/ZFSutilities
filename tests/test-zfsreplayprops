test_replay_lock_conflict_fails_open() {
    test_start "a destination lock conflict WARNs and skips the dataset"

    reset_state
    add_store backup/tank/zfsutilities-manifests "$_rmock_store"
    add_snap backup/tank/src/data daily-20261102T0500Z-d
    write_manifest "$_rmock_store" tank/src/data daily-20261102T0500Z-d \
        compression=lz4
    local saved_wait saved_release
    saved_wait=$(declare -f zfslock_wait_or_resolve)
    saved_release=$(declare -f zfslock_release)
    zfslock_wait_or_resolve() { return 2; }
    zfslock_release() { echo "zfslock_release $*" >> "$_zfs_capture_file"; }
    local rc=0
    propmanifest_replay backup/tank/src/data tank/src/data || rc=$?
    assert_rc 0 "$rc"
    eval "$saved_wait"
    eval "$saved_release"
    assert_contains "$(get_log)" \
        "WARN: Property replay for tank/src/data skipped (lock conflict on tank/src/data)."
    if grep -q "zfs set" "$_zfs_capture_file"; then
        test_fail "no property may be set on a lock conflict"
        return
    fi
    if [[ "$(grep -c zfslock_release "$_zfs_capture_file")" != "0" ]]; then
        test_fail "release must not run for a lock never acquired"
        return
    fi
    test_pass
}

