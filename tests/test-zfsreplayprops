test_replay_switches_between_stores() {
    test_start "a multi-store run unmounts the previous store before the next"

    reset_state
    local dir1 dir2
    dir1=$(mktemp -d "${TMPDIR:-/tmp}/replayprops_s1.XXXXXX")
    dir2=$(mktemp -d "${TMPDIR:-/tmp}/replayprops_s2.XXXXXX")
    add_store backup/tank/zfsutilities-manifests "$dir1"
    add_store backup/nvme/zfsutilities-manifests "$dir2"
    add_snap backup/tank/src/a daily-20261102T0500Z-d
    add_snap backup/nvme/dsk/b daily-20261102T0500Z-d
    write_manifest "$dir1" tank/src/a daily-20261102T0500Z-d compression=on
    write_manifest "$dir2" nvme/dsk/b daily-20261102T0500Z-d compression=lz4

    propmanifest_replay backup/tank/src/a tank/src/a || true
    propmanifest_replay backup/nvme/dsk/b nvme/dsk/b || true
    propmanifest_finish

    local capture mount_at unmount_at
    capture=$(cat "$_zfs_capture_file")
    mount_at=$(printf '%s\n' "$capture" \
        | grep -n "zfs mount backup/nvme/zfsutilities-manifests" | cut -d: -f1)
    unmount_at=$(printf '%s\n' "$capture" \
        | grep -n "zfs unmount backup/tank/zfsutilities-manifests" | cut -d: -f1)
    if [[ -z "$mount_at" || -z "$unmount_at" || "$unmount_at" -gt "$mount_at" ]]; then
        test_fail "store switch must unmount the old store before the new one: $capture"
        return
    fi
    if [[ "$(grep -c "zfs unmount backup/nvme/zfsutilities-manifests" \
            "$_zfs_capture_file")" != "1" ]]; then
        test_fail "finish must unmount exactly the last store"
        return
    fi
    rm -rf "$dir1" "$dir2"
    test_pass
}

test_replay_corrupt_manifest_fails_open() {
    test_start "a checksum-failed manifest WARNs and sets nothing"

    reset_state
    add_store backup/tank/zfsutilities-manifests "$_rmock_store"
    add_snap backup/tank/src/data daily-20261102T0500Z-d
    local f
    f=$(write_manifest "$_rmock_store" tank/src/data daily-20261102T0500Z-d \
        compression=lz4)
    printf 'recordsize=131072\n' >> "$f"
    local rc=0
    propmanifest_replay backup/tank/src/data tank/src/data || rc=$?
    assert_rc 0 "$rc"
    assert_contains "$(get_log)" \
        "WARN: Property manifest $f failed its sha256 check — replay skipped for tank/src/data."
    if grep -q "zfs set" "$_zfs_capture_file"; then
        test_fail "no property may be set from a corrupt manifest"
        return
    fi
    test_pass
}

# ---------------------------------------------------------------------------
# bin/zfsreplayprops wrapper
# ---------------------------------------------------------------------------
# Sourcing bin/zfsreplayprops enables set -euo pipefail in the sourcing
# shell (house convention), so every wrapper test runs the wrapper inside
# a subshell that stubs source_helper and the helpers it would load, and
# records the propmanifest calls to a file the outer test asserts on.

run_wrapper() {
    (
        source_helper() { :; }
        calledbybash() { return 1; }
        # Mock fidelity: the real remove_leading_qualifiers cuts the first
        # N qualifiers off the dataset name.
        remove_leading_qualifiers() {
            echo "$2" | cut -d'/' -f$(("$1" + 1))-
        }
        propmanifest_replay() {
            echo "replay $1 -> $2" >> "$_rmock_calls_file"
            return 0
        }
        propmanifest_finish() {
            echo "finish" >> "$_rmock_calls_file"
            return 0
        }
        # shellcheck disable=SC1090
        source "$repo_root/bin/zfsreplayprops"
        "$@"
    )
}

test_wrapper_datasets_mapping() {
    test_start "replayprops_datasets maps each fsarray entry to its destination"

    reset_state
    run_wrapper replayprops_datasets tank 2 \
        backup/tank/src/a backup/tank/src/b >/dev/null 2>&1
    local calls
    calls=$(cat "$_rmock_calls_file")
    assert_contains "$calls" "replay backup/tank/src/a -> tank/src/a"
    assert_contains "$calls" "replay backup/tank/src/b -> tank/src/b"
    assert_contains "$calls" "finish"
    if [[ "$(grep -c '^replay ' "$_rmock_calls_file")" != "2" ]]; then
        test_fail "expected exactly two replay calls"
        return
    fi
    test_pass
}

