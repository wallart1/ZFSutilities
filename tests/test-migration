        "$tmpdir/etc-node.conf" "$tmpdir/etc-deploy.conf" \
        "$tmpdir/etc-iscsi.conf" "$tmpdir/etc-two-node.conf"

    # Remove the symlink and recreate the legacy file.
    rm -f "$old_home/.config/zfsutilities.json"
    echo 'second' > "$old_home/.config/zfsutilities.json"

    run_migration "$state_dir" "$etc_dir" "$old_home/.config" \
