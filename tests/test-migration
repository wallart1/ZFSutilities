    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _cfg="$old_home/.config/zfsutilities.json"
    assert_equals "$_wrap_expected" "$([[ -f $_cfg ]] && echo true || echo false)"
    assert_equals "false" "$([[ -e $state_dir/config.json ]] && echo true || echo false)"
    rm -rf "$tmpdir"
}

