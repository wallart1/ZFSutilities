test_migrate_system_config_files() {
    test_start "System config files are migrated and legacy symlinks created"
    local tmpdir state_dir etc_dir old_home
    tmpdir=$(mktemp -d)
    state_dir="$tmpdir/state"
    etc_dir="$tmpdir/etc"
    old_home="$tmpdir/root"
    echo 'NODE_MODE=single-node' > "$tmpdir/etc-node.conf"
    echo 'DEPLOY=test' > "$tmpdir/etc-deploy.conf"
    echo 'lun1:/dev/zvol' > "$tmpdir/etc-iscsi.conf"
    echo 'STORAGE_HOST=a' > "$tmpdir/etc-two-node.conf"

    run_migration "$state_dir" "$etc_dir" "$old_home" \
        "$tmpdir/etc-node.conf" "$tmpdir/etc-deploy.conf" \
        "$tmpdir/etc-iscsi.conf" "$tmpdir/etc-two-node.conf"

    assert_equals "true" "$([[ -L $tmpdir/etc-node.conf ]] && echo true || echo false)"
    assert_equals "true" "$([[ -f $etc_dir/node.conf ]] && echo true || echo false)"
    assert_equals "true" "$([[ -f $etc_dir/deploy.conf ]] && echo true || echo false)"
    assert_equals "true" "$([[ -f $etc_dir/iscsi-encrypted-luns.conf ]] && echo true || echo false)"
    assert_equals "true" "$([[ -f $etc_dir/two-node.conf ]] && echo true || echo false)"
    rm -rf "$tmpdir"
}

test_sentinel_prevents_rerun() {
