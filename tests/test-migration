    local _wrap_expected="$_wrap_expected"
    local _cfg="$old_home/.config/zfsutilities.json"
    assert_equals "$_wrap_expected" "$([[ -L $_cfg ]] && echo true || echo false)"
    rm -rf "$tmpdir"
}

test_disabled_by_environment() {
    test_start "ZFSUTILITIES_DISABLE_MIGRATION prevents migration"
    local tmpdir state_dir etc_dir old_home
    tmpdir=$(mktemp -d)
    state_dir="$tmpdir/state"
    etc_dir="$tmpdir/etc"
    old_home="$tmpdir/root"
    mkdir -p "$old_home/.config"
    echo '{}' > "$old_home/.config/zfsutilities.json"

    (
        export ZFSUTILITIES_DISABLE_MIGRATION=1
        export ZFSUTILITIES_MIGRATION_ALLOW_NONROOT=1
        export ZFSUTILITIES_STATE_DIR="$state_dir"
        export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$etc_dir"
        export ZFSUTILITIES_LEGACY_CONFIG_HOME="$old_home/.config"
        unset ZFSUTILITIES_CONFIG_PATH
        source "$mydir/lib/paths.sh"
