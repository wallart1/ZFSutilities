#!/usr/bin/bash
# shellcheck disable=SC2034
# Tests for the Step-5 one-time migration helper in lib/paths.sh.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"

setup_test_env

# Run migration with temporary directories and the disable flag cleared.
run_migration() {
    (
        export ZFSUTILITIES_DISABLE_MIGRATION=""
        export ZFSUTILITIES_MIGRATION_ALLOW_NONROOT=1
        export ZFSUTILITIES_STATE_DIR="$1"
        export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$2"
        export ZFSUTILITIES_LEGACY_CONFIG_HOME="$3"
        export ZFSUTILITIES_LEGACY_NODE_CONF="$4"
        export ZFSUTILITIES_LEGACY_DEPLOY_CONF="$5"
        export ZFSUTILITIES_LEGACY_ISCSI_ENCRYPTED_CONF="$6"
        export ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$7"
        # Unset derived variables so paths.sh recomposes them from the overrides.
        unset ZFSUTILITIES_CONFIG_PATH ZFSUTILITIES_HISTORY_PATH \
            ZFSUTILITIES_PROFILES_DIR ZFSUTILITIES_SCRUB_STATE_PATH \
            ZFSUTILITIES_NEXTSNAP_FILE ZFSUTILITIES_OFFSITE_NEXTSNAP_FILE \
            ZFSUTILITIES_LEGACY_CONFIG_PATH ZFSUTILITIES_LEGACY_HISTORY_PATH \
            ZFSUTILITIES_LEGACY_PROFILES_DIR ZFSUTILITIES_LEGACY_SCRUB_STATE_PATH \
            ZFSUTILITIES_LEGACY_NEXTSNAP_FILE ZFSUTILITIES_LEGACY_OFFSITE_NEXTSNAP_FILE
        source "$mydir/lib/paths.sh"
        migrate_zfsutilities_state
    )
}

test_migrate_config_file() {
    test_start "Config file is migrated and legacy symlink created"
    local tmpdir state_dir etc_dir old_home
    tmpdir=$(mktemp -d)
    state_dir="$tmpdir/state"
    etc_dir="$tmpdir/etc"
    old_home="$tmpdir/root"
    mkdir -p "$old_home/.config"
    echo '{}' > "$old_home/.config/zfsutilities.json"

    run_migration "$state_dir" "$etc_dir" "$old_home/.config" \
        "$tmpdir/etc-node.conf" "$tmpdir/etc-deploy.conf" \
        "$tmpdir/etc-iscsi.conf" "$tmpdir/etc-two-node.conf"

    local _wrap_expected="true"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _wrap_expected="$_wrap_expected"
    local _cfg="$old_home/.config/zfsutilities.json"
    assert_equals "$_wrap_expected" "$([[ -L $_cfg ]] && echo true || echo false)"
    assert_equals "true" "$([[ -f $state_dir/config.json ]] && echo true || echo false)"
    rm -rf "$tmpdir"
}

