bash
-c
_rh=remote; _rl=/var/log/zfsutilities/rsync-pull.log; ssh -q root@remote 'mkdir -p /var/log/zfsutilities; if [ ! -f /var/log/zfsutilities/rsync-pull.log ] || [ "$(date -r /var/log/zfsutilities/rsync-pull.log +%Y%m%d 2>/dev/null || echo 0)" != "$(date +%Y%m%d)" ]; then : > /var/log/zfsutilities/rsync-pull.log; fi' && rsync --delete --progress -rav '--exclude=**/.gvfs/' '--exclude=**/.cache/doc/' root@remote:/src /dst 2>&1 | ssh -q root@$_rh "cat >> $_rl"; exit ${PIPESTATUS[0]}
