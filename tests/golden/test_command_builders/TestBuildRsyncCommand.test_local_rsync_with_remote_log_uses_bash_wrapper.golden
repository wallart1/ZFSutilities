bash
-c
mkdir -p /var/log/zfsutilities; if [ ! -f /var/log/zfsutilities/rsync-pull.log ] || [ "$(date -r /var/log/zfsutilities/rsync-pull.log +%Y%m%d 2>/dev/null || echo 0)" != "$(date +%Y%m%d)" ]; then : > /var/log/zfsutilities/rsync-pull.log; fi; rsync --delete --progress -rav '--exclude=**/.gvfs/' '--exclude=**/.cache/doc/' /src /dst >> /var/log/zfsutilities/rsync-pull.log 2>&1
