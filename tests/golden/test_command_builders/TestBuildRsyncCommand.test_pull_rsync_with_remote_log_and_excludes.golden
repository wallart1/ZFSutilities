bash
-c
_rh=remote; _rl=/var/log/zfsutilities/rsync-pull.log; _t=$(mktemp); ssh -q root@remote 'mkdir -p /var/log/zfsutilities; if [ ! -f /var/log/zfsutilities/rsync-pull.log ] || [ "$(date -r /var/log/zfsutilities/rsync-pull.log +%Y%m%d 2>/dev/null || echo 0)" != "$(date +%Y%m%d)" ]; then : > /var/log/zfsutilities/rsync-pull.log; fi' && rsync --delete --progress -rav '--exclude=**/.gvfs/' '--exclude=**/.cache/doc/' '--exclude=*.tmp' root@remote:/src /dst 2>&1 | tee "$_t" | ssh -q root@$_rh "cat >> $_rl"; _rc=${PIPESTATUS[0]}; if [ "$_rc" -ne 0 ]; then echo "rsync exited rc=$_rc; last output lines:"; tail -n 15 "$_t"; fi; rm -f "$_t"; exit "$_rc"
