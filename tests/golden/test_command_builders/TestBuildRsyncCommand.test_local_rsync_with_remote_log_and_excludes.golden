bash
-c
mkdir -p /var/log/zfsutilities; ( flock -x 9 || exit 1; if [ ! -f /var/log/zfsutilities/rsync-pull.log ] || [ "$(date -r /var/log/zfsutilities/rsync-pull.log +%Y%m%d 2>/dev/null || echo 0)" != "$(date +%Y%m%d)" ]; then : > /var/log/zfsutilities/rsync-pull.log; fi ) 9>>/var/log/zfsutilities/rsync-pull.log.lock; _t=$(mktemp); ( flock -s 9 || exit 1; rsync --delete --progress -rav '--exclude=**/.gvfs/' '--exclude=**/.cache/doc/' '--exclude=*.tmp' /src /dst 2>&1 | tee "$_t" >> /var/log/zfsutilities/rsync-pull.log; _rc=${PIPESTATUS[0]}; if [ "$_rc" -ne 0 ]; then echo "rsync exited rc=$_rc; last output lines:"; tail -n 15 "$_t"; fi; rm -f "$_t"; exit "$_rc" ) 9>>/var/log/zfsutilities/rsync-pull.log.lock
