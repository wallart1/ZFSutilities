mkdir -p /var/log/zfsutilities; ( flock -x 9 || exit 1; if [ ! -f /var/log/zfsutilities/rsync-pull.log ] || [ "$(date -r /var/log/zfsutilities/rsync-pull.log +%Y%m%d 2>/dev/null || echo 0)" != "$(date +%Y%m%d)" ]; then : > /var/log/zfsutilities/rsync-pull.log; fi ) 9>>/var/log/zfsutilities/rsync-pull.log.lock
