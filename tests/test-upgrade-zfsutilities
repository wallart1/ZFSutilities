test_two_node_node_conf_enumeration() {
    test_start "modern node.conf drives enumeration when no deploy.conf exists"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    _make_fake_release "$tmpdir" 0.1.0
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.1.0 "$tmpdir"

    local rb1="$tmpdir/remote-h1"
    _make_host_state "$rb1" 0.1.0 "$tmpdir"

    # No deploy.conf: enumeration falls back to the node configuration,
    # which install-two-node writes to the modern system config dir (the
    # resolution fixed 2026-10-13 — it used to read only the legacy flat
    # files and silently deploy single-node).
    printf 'NODE_MODE="two-node"\nSTORAGE_HOST="fakehost1"\nCOMPUTE_HOST="fakehost2"\n' \
        > "$ZFSUTILITIES_SYSTEM_CONFIG_DIR/node.conf"
    printf 'fakehost1 %s\nfakehost2 %s\n' "$rb1" "$ZFSUTILITIES_VERSION_BASE" \
        > "$tmpdir/hostmap"
    _write_transport_shims "$tmpdir" "$tmpdir/hostmap"

    output=$(printf 'y\n' | "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc; output tail: ${output: -300}"; }
    [[ "$output" == *"fakehost1"*"No local modifications"* ]] \
        || { failed=1; echo "    fakehost1 (storage) never scanned"; }
    [[ "$output" == *"fakehost2"*"No local modifications"* ]] \
        || { failed=1; echo "    fakehost2 (compute) never scanned"; }
    [[ "$(cat "$FAKE_DEPLOY_MARKER")" == "deploy-version 0.2.0" ]] \
        || { failed=1; echo "    deploy-version not called"; }
    [[ "$output" == *"ssh root@fakehost1 switch-version 0.2.0"* ]] \
        || { failed=1; echo "    storage-host activation hint missing"; }
    [[ "$output" == *"ssh root@fakehost2 switch-version 0.2.0"* ]] \
        || { failed=1; echo "    compute-host activation hint missing"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "node.conf enumeration failed"; fi
}

