#!/usr/bin/bash
# shellcheck disable=SC2016
# test-upgrade-zfsutilities — Verify the self-upgrade orchestrator.
#
# GitHub is faked with file:// URLs pointing at fabricated release
# tarballs; remote deployment targets are faked with PATH shims for ssh
# and rsync that re-execute the real piped upgrade-lib.sh against
# per-host fake version bases, so the remote scan/salvage code paths are
# the production ones and only the transport is mocked.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"

setup_test_env

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UPGRADE_SCRIPT="$REPO/bin/upgrade-zfsutilities"
[[ -f "$UPGRADE_SCRIPT" ]] || die "Missing: $UPGRADE_SCRIPT"

# The library is bashinit-free; source the real one for direct unit tests.
# shellcheck source=../lib/upgrade-lib.sh
source "$REPO/lib/upgrade-lib.sh"

ORIGINAL_PATH="$PATH"

# [[ -f ]] does not glob (SC2144); use compgen for wildcard existence.
_glob_exists() {
    compgen -G "$1" > /dev/null 2>&1
}

# ------------------------------------------------------------------
# Environment scaffolding
# ------------------------------------------------------------------
_setup_upgrade_env() {
    local _varname="$1" _tmpdir
    _tmpdir=$(mktemp -d)
    mkdir -p "$_tmpdir/gh" "$_tmpdir/bin" "$_tmpdir/home" \
        "$_tmpdir/local-base/versions" "$_tmpdir/etc"

    export ZFSUTILITIES_VERSION_BASE="$_tmpdir/local-base"
    export ZFSUTILITIES_REMOTE_VERSION_BASE="$_tmpdir/remote-default"
    export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$_tmpdir/etc"
    export ZFSUTILITIES_RELEASE_API="file://$_tmpdir/gh/latest.json"
    export ZFSUTILITIES_TAG_TARBALL_URL="file://$_tmpdir/gh/tag-v%s.tar.gz"
    export ZFSUTILITIES_RELEASE_HOME="file://$_tmpdir/gh"
    # Suppress this host's real legacy configs so tests never touch real
    # deployment targets.
    export ZFSUTILITIES_LEGACY_DEPLOY_CONF="$_tmpdir/etc/no-deploy.conf"
    export ZFSUTILITIES_LEGACY_NODE_CONF="$_tmpdir/etc/no-node.conf"
    export UPGRADE_ZFSUTILITIES_TEST_NO_ROOT=1
    export HOME="$_tmpdir/home"
    export FAKE_DEPLOY_MARKER="$_tmpdir/deploy.marker"
    export FAKE_SWITCH_MARKER="$_tmpdir/switch.marker"
    export FAKE_PREREQ_MARKER="$_tmpdir/prereq.marker"
    export FAKE_PREREQ_RC="${FAKE_PREREQ_RC:-0}"
    : > "$FAKE_DEPLOY_MARKER"
    : > "$FAKE_SWITCH_MARKER"
    : > "$FAKE_PREREQ_MARKER"

    # Copy the script under test so it sources our fake rootcheck and the
    # real upgrade-lib.sh as siblings.
    cp "$UPGRADE_SCRIPT" "$_tmpdir/upgrade-zfsutilities"
    chmod +x "$_tmpdir/upgrade-zfsutilities"
    cp "$REPO/lib/upgrade-lib.sh" "$_tmpdir/upgrade-lib.sh"
    cp "$REPO/lib/installer-lib.sh" "$_tmpdir/installer-lib.sh"

    # Minimal bashinit providing the functions the orchestrator uses.
    # Quoted heredoc: no expansion, byte-identical to the printf chain it
    # replaced.
    cat > "$HOME/bashinit" << 'BINIT'
#!/usr/bin/bash
function bashinit {
    mydir=$(dirname "$(realpath "${BASH_SOURCE[1]}")")
}
function log_msg { echo -e "$*" >&2; }
function find_zfsutility_script {
    local name="$1"
    if [[ -f "$mydir/$name" ]]; then realpath "$mydir/$name"; return 0; fi
    return 1
}
function source_helper {
    local name="$1" path
    path=$(find_zfsutility_script "$name")
    [[ -n "$path" ]] && source "$path"
}
function die { echo "FATAL: $*" >&2; exit 8; }
function ask_yn {
    local prompt="$1" default="${2:-N}" response
    read -rp "$prompt [y/N]: " response
    response="${response:-$default}"
    case "${response,,}" in
        y|yes) return 0 ;;
        *) return 1 ;;
    esac
}
function append_exit_trap { trap "$1" EXIT; }
BINIT

    export PATH="$_tmpdir/bin:$ORIGINAL_PATH"
    printf -v "$_varname" '%s' "$_tmpdir"
}

_teardown_upgrade_env() {
    local tmpdir="$1"
    export PATH="$ORIGINAL_PATH"
    unset ZFSUTILITIES_VERSION_BASE ZFSUTILITIES_REMOTE_VERSION_BASE \
        ZFSUTILITIES_SYSTEM_CONFIG_DIR ZFSUTILITIES_RELEASE_API \
        ZFSUTILITIES_TAG_TARBALL_URL ZFSUTILITIES_RELEASE_HOME \
        ZFSUTILITIES_LEGACY_DEPLOY_CONF ZFSUTILITIES_LEGACY_NODE_CONF \
        UPGRADE_ZFSUTILITIES_TEST_NO_ROOT FAKE_DEPLOY_MARKER \
        FAKE_SWITCH_MARKER FAKE_PREREQ_MARKER FAKE_PREREQ_RC
    unset HOME
    rm -rf "$tmpdir"
}

# ------------------------------------------------------------------
# Fake GitHub: release tarballs and latest.json
# ------------------------------------------------------------------
_make_fake_release() {
    local tmpdir="$1" version="$2"
    local src="$tmpdir/relsrc-$version/ZFSutilities-v$version"
    rm -rf "$tmpdir/relsrc-$version"
    mkdir -p "$src/bin" "$src/lib" "$src/python" "$src/docs" "$src/share"
    printf 'script-one release %s\n' "$version" > "$src/bin/onescript"
    printf 'helper release %s\n' "$version" > "$src/lib/helper.sh"
    printf 'py release %s\n' "$version" > "$src/python/mod.py"
    printf 'docs %s\n' "$version" > "$src/docs/index.md"
    printf 'share %s\n' "$version" > "$src/share/thing"
    printf '%s\n' "$version" > "$src/VERSION"
    # Repository-only files: never part of the deployed set.
    printf 'repo only\n' > "$src/README.md"
    mkdir -p "$src/tests"
    printf 'test\n' > "$src/tests/dummy"
    # Fake deploy-version: records the invocation and provisions the fake
    # switch-version the orchestrator activates through.
    cat > "$src/bin/deploy-version" << 'DEPLOYEOF'
#!/usr/bin/bash
echo "deploy-version $*" >> "${FAKE_DEPLOY_MARKER:?}"
ver="$1"
vb="${ZFSUTILITIES_VERSION_BASE:?}"
mkdir -p "$vb/versions/$ver/bin"
printf '#!/usr/bin/bash\necho "switch-version $*" >> "${FAKE_SWITCH_MARKER:?}"\n' \
    > "$vb/versions/$ver/bin/switch-version"
chmod +x "$vb/versions/$ver/bin/switch-version"
echo "INFO: fake deploy-version complete for $ver" >&2
DEPLOYEOF
    chmod +x "$src/bin/deploy-version"
    # Stub check-prerequisites: records its arguments for mode assertions
    # and exits FAKE_PREREQ_RC (default 0). The --list-failures re-run the
    # remediation flow makes emits one fixed failure line.
    cat > "$src/bin/check-prerequisites" << 'PREREQEOF'
#!/usr/bin/bash
echo "check-prerequisites $*" >> "${FAKE_PREREQ_MARKER:?}"
if [[ "$*" == *--list-failures* ]]; then
    echo "core|pv|pv|command not found"
    exit 1
fi
exit "${FAKE_PREREQ_RC:-0}"
PREREQEOF
    chmod +x "$src/bin/check-prerequisites"
    tar -czf "$tmpdir/gh/tag-v$version.tar.gz" -C "$tmpdir/relsrc-$version" \
        "ZFSutilities-v$version"
}

_make_latest_json() {
    local tmpdir="$1" tag="$2"
    printf '{"tag_name": "%s", "html_url": "file://%s/gh/releases/%s"}\n' \
        "$tag" "$tmpdir" "$tag" > "$tmpdir/gh/latest.json"
}

# Install the deployed subset of a fake release into a version directory
# (the shape deploy-version produces: bin lib python docs share VERSION).
_install_release() {
    local dest="$1" version="$2" tmpdir="$3"
    local x="$tmpdir/unpack-$RANDOM"
    rm -rf "$x"
    mkdir -p "$x" "$dest"
    tar -xzf "$tmpdir/gh/tag-v$version.tar.gz" -C "$x"
    local src="$x/ZFSutilities-v$version"
    cp -a "$src/bin" "$src/lib" "$src/python" "$src/docs" "$src/share" "$dest/"
    cp -a "$src/VERSION" "$dest/VERSION"
    rm -rf "$x"
}

# Build a host's deployed state: version tree + current symlink + manifest.
_make_host_state() {
    local base="$1" version="$2" tmpdir="$3" with_manifest="${4:-1}"
    mkdir -p "$base/versions/$version"
    _install_release "$base/versions/$version" "$version" "$tmpdir"
    ln -sfn "versions/$version" "$base/current"
    if [[ "$with_manifest" == "1" ]]; then
        upgrade_lib_write_manifest "$base/versions/$version" \
            || die "test manifest write failed"
    fi
}

# ------------------------------------------------------------------
# Fake remote transport: ssh and rsync shims on PATH
# ------------------------------------------------------------------
# _write_transport_shims <tmpdir> <mapfile>
# The map file holds one "host base" line per fake remote host, or
# "host FAIL" for an unreachable host.
_write_transport_shims() {
    local tmpdir="$1" mapfile="$2"

    cat > "$tmpdir/bin/ssh" << 'SSHEOF'
#!/usr/bin/bash
MAP="__MAPFILE__"
base_for() {
    local h="$1" hh bb
    while read -r hh bb; do
        [[ "$hh" == "$h" ]] && { printf '%s' "$bb"; return 0; }
    done < "$MAP"
    return 1
}
args=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-o" ]]; then
        shift 2
    else
        args+=("$1")
        shift
    fi
done
[[ ${#args[@]} -gt 0 ]] || exit 0
host="${args[0]#root@}"
case "${args[1]:-}" in
    true|exit)
        base=$(base_for "$host") || exit 255
        [[ "$base" == "FAIL" ]] && exit 255
        exit 0
        ;;
    bash)
        base=$(base_for "$host") || exit 255
        [[ "$base" == "FAIL" ]] && exit 255
        # Rewrite the standard remote base argument to this host's fake
        # base — the remote driver receives the base as an argument.
        fixed=()
        for a in "${args[@]:4}"; do
            if [[ "$a" == "$ZFSUTILITIES_REMOTE_VERSION_BASE" ]]; then
                a="$base"
            fi
            fixed+=("$a")
        done
        exec bash -s -- "${fixed[@]}"
        ;;
esac
exit 0
SSHEOF
    sed -i "s|__MAPFILE__|$mapfile|g" "$tmpdir/bin/ssh"
    chmod +x "$tmpdir/bin/ssh"

    cat > "$tmpdir/bin/rsync" << 'RSYNCEOF'
#!/usr/bin/bash
MAP="__MAPFILE__"
base_for() {
    local h="$1" hh bb
    while read -r hh bb; do
        [[ "$hh" == "$h" ]] && { printf '%s' "$bb"; return 0; }
    done < "$MAP"
    return 1
}
list="" hostpart=""
for a in "$@"; do
    case "$a" in
        --files-from=*) list="${a#--files-from=}" ;;
        root@*) hostpart="$a" ;;
    esac
done
dest="${@: -1}"
host="${hostpart%%:*}"
host="${host#root@}"
src="${hostpart#*:}"
src="${src%/}"
base=$(base_for "$host") || exit 1
src="${src/#${ZFSUTILITIES_REMOTE_VERSION_BASE}/$base}"
[[ -d "$src" ]] || exit 23
mkdir -p "$dest"
while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ -f "$src/$p" ]] || exit 23
    mkdir -p "$dest/$(dirname "$p")"
    cp -a -- "$src/$p" "$dest/$p"
done < "$list"
exit 0
RSYNCEOF
    sed -i "s|__MAPFILE__|$mapfile|g" "$tmpdir/bin/rsync"
    chmod +x "$tmpdir/bin/rsync"
}

# ------------------------------------------------------------------
# Unit tests against the real library
# ------------------------------------------------------------------
test_json_string_parses_fields() {
    test_start "upgrade_lib_json_string extracts quoted fields and tolerates absence"
    local tmpdir
    tmpdir=$(mktemp -d)
    printf '{"tag_name": "v1.2.3", "tarball_url": "https://h/x.tar.gz", "n": 4}' > "$tmpdir/r.json"
    local failed=0
    [[ "$(upgrade_lib_json_string "$tmpdir/r.json" tag_name)" == "v1.2.3" ]] \
        || { failed=1; echo "    tag_name parse failed"; }
    [[ "$(upgrade_lib_json_string "$tmpdir/r.json" tarball_url)" == "https://h/x.tar.gz" ]] \
        || { failed=1; echo "    tarball_url parse failed"; }
    [[ -z "$(upgrade_lib_json_string "$tmpdir/r.json" missing)" ]] \
        || { failed=1; echo "    missing field should be empty"; }
    rm -rf "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "json parsing broken"; fi
}

test_version_lt_ordering() {
    test_start "upgrade_lib_version_lt compares release versions strictly"
    local failed=0
    upgrade_lib_version_lt 0.9.0 0.10.0 \
        || { failed=1; echo "    0.9.0 should be older than 0.10.0"; }
    upgrade_lib_version_lt 0.10.0 0.10.0 \
        && { failed=1; echo "    equal versions must not compare older"; }
    upgrade_lib_version_lt 0.11.0 0.10.0 \
        && { failed=1; echo "    0.11.0 must not compare older than 0.10.0"; }
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "version comparison broken"; fi
}

test_hash_tree_exclusions() {
    test_start "upgrade_lib_hash_tree excludes built docs, bytecode, and manifests"
    local tmpdir
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/tree/bin" "$tmpdir/tree/docs/site" "$tmpdir/tree/py/__pycache__"
    printf 'a\n' > "$tmpdir/tree/bin/s"
    printf 'b\n' > "$tmpdir/tree/docs/site/index.html"
    printf 'c\n' > "$tmpdir/tree/py/__pycache__/m.pyc"
    printf 'd\n' > "$tmpdir/tree/MANIFEST.sha256"
    local out
    out=$(upgrade_lib_hash_tree "$tmpdir/tree")
    rm -rf "$tmpdir"
    if [[ "$out" == *"bin/s" && "$out" != *"docs/site"* && "$out" != *"pycache"* \
        && "$out" != *"MANIFEST.sha256"* ]]; then
        test_pass
    else
        test_fail "exclusion filter leaked: $out"
    fi
}

test_classify_tags() {
    test_start "upgrade_lib_classify tags modified, added, and removed files"
    local tmpdir
    tmpdir=$(mktemp -d)
    printf 'aaa  keep\nbbb  changed\nccc  gone\n' > "$tmpdir/base"
    printf 'aaa  keep\nzzz  changed\nnew  added\n' > "$tmpdir/tree"
    local out
    out=$(upgrade_lib_classify "$tmpdir/tree" "$tmpdir/base" | sort | tr '\n' ' ')
    rm -rf "$tmpdir"
    if [[ "$out" == "ADD added DEL gone MOD changed " ]]; then
        test_pass
    else
        test_fail "classification wrong: [$out]"
    fi
}

test_json_string_parses_fields
test_version_lt_ordering
test_hash_tree_exclusions
test_classify_tags

# ------------------------------------------------------------------
# Orchestrator behavior
# ------------------------------------------------------------------
test_no_active_version_dies() {
    test_start "no active deployment dies with installer guidance"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    output=$("$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -ne 0 ]] || { failed=1; echo "    expected non-zero rc"; }
    [[ "$output" == *"No active version is deployed"* ]] \
        || { failed=1; echo "    missing guidance message"; }
    [[ "$output" == *"install-single-node"* ]] || { failed=1; echo "    missing installer hint"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "no-active guard failed"; fi
}

test_up_to_date_exits_clean() {
    test_start "matching latest release reports up to date and changes nothing"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.2.0 "$tmpdir"
    output=$(printf 'n\n' | "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc"; }
    [[ "$output" == *"Nothing to upgrade"* ]] \
        || { failed=1; echo "    missing up-to-date message"; }
    [[ -z "$(cat "$FAKE_DEPLOY_MARKER")" ]] || { failed=1; echo "    deploy-version must not run"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "up-to-date path changed something"; fi
}

