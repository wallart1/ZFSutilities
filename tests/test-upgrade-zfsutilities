test_decline_at_deploy_prompt() {
    test_start "declining the deploy prompt leaves every host untouched"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    _make_fake_release "$tmpdir" 0.1.0
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.1.0 "$tmpdir"
    printf 'DEPLOY_GROUP_prod="fakehost1"\n' > "$ZFSUTILITIES_SYSTEM_CONFIG_DIR/deploy.conf"
    printf 'fakehost1 %s/remote-base\n' "$tmpdir" > "$tmpdir/hostmap"
    _write_transport_shims "$tmpdir" "$tmpdir/hostmap"
    _make_host_state "$tmpdir/remote-base" 0.1.0 "$tmpdir"

    output=$(printf 'n\n' | "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc"; }
    [[ "$output" == *"Aborted. Nothing was changed."* ]] \
        || { failed=1; echo "    missing abort message"; }
    [[ -z "$(cat "$FAKE_DEPLOY_MARKER")" ]] || { failed=1; echo "    deploy-version must not run"; }
    [[ ! -d "$ZFSUTILITIES_VERSION_BASE/versions/0.2.0" ]] \
        || { failed=1; echo "    new version dir must not exist"; }
    [[ -z "$(cat "$FAKE_SWITCH_MARKER")" ]] || { failed=1; echo "    switch-version must not run"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "decline path touched something"; fi
}

test_prereq_failure_aborts_before_changes() {
    test_start "declined prerequisite remediation aborts before any changes"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    export FAKE_PREREQ_RC=1
    _make_fake_release "$tmpdir" 0.1.0
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.1.0 "$tmpdir"

    # y: approve the download; n: decline prerequisite remediation.
    output=$(printf 'y\nn\n' | "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -eq 1 ]] || { failed=1; echo "    rc=$rc (want 1)"; }
    [[ "$output" == *"Checking this host against the 0.2.0 prerequisites"* ]] \
        || { failed=1; echo "    missing gate banner"; }
    [[ "$output" == *"Aborted. Nothing was changed."* ]] \
        || { failed=1; echo "    missing abort message"; }
    [[ -n "$(cat "$FAKE_PREREQ_MARKER")" ]] \
        || { failed=1; echo "    staged checker never ran"; }
    [[ -z "$(cat "$FAKE_DEPLOY_MARKER")" ]] || { failed=1; echo "    deploy-version must not run"; }
    [[ ! -d "$ZFSUTILITIES_VERSION_BASE/versions/0.2.0" ]] \
        || { failed=1; echo "    new version dir must not exist"; }
    [[ -z "$(cat "$FAKE_SWITCH_MARKER")" ]] || { failed=1; echo "    switch-version must not run"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "prereq gate touched something"; fi
}

test_prereq_gate_mode_follows_node_conf() {
    test_start "prerequisite gate mode follows the node configuration"
    local tmpdir marker_line failed=0
    _setup_upgrade_env tmpdir
    export FAKE_PREREQ_RC=1
    _make_fake_release "$tmpdir" 0.1.0
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.1.0 "$tmpdir"

    # No node.conf anywhere: the gate defaults to single-node.
    printf 'y\nn\n' | "$tmpdir/upgrade-zfsutilities" &>/dev/null || true
    marker_line=$(head -1 "$FAKE_PREREQ_MARKER")
    [[ "$marker_line" == "check-prerequisites --single-node" ]] \
        || { failed=1; echo "    default mode was: $marker_line"; }

    # A two-node node.conf switches the gate to two-node. The gate aborts
    # (rc=1 path) before target enumeration, so the named hosts are never
    # contacted.
    : > "$FAKE_PREREQ_MARKER"
    printf 'NODE_MODE="two-node"\nSTORAGE_HOST="unusedstorage"\nCOMPUTE_HOST="unusedcompute"\n' \
        > "$ZFSUTILITIES_SYSTEM_CONFIG_DIR/node.conf"
    printf 'y\nn\n' | "$tmpdir/upgrade-zfsutilities" &>/dev/null || true
    marker_line=$(head -1 "$FAKE_PREREQ_MARKER")
    [[ "$marker_line" == "check-prerequisites --two-node" ]] \
        || { failed=1; echo "    two-node mode was: $marker_line"; }

    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "gate mode did not follow node.conf"; fi
}

test_happy_path_clean_tree() {
    test_start "clean local tree upgrades, deploys, and activates"
    local tmpdir output rc
    _setup_upgrade_env tmpdir
    _make_fake_release "$tmpdir" 0.1.0
    _make_fake_release "$tmpdir" 0.2.0
    _make_latest_json "$tmpdir" v0.2.0
    _make_host_state "$ZFSUTILITIES_VERSION_BASE" 0.1.0 "$tmpdir"

    output=$(printf 'y\n' | "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc"; }
    [[ "$output" == *"No local modifications"* ]] \
