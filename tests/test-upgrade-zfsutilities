test_curl_missing_is_fatal() {
    test_start "missing curl dies with an install hint"
    local tmpdir output rc b
    _setup_upgrade_env tmpdir
    mkdir -p "$tmpdir/nocurl"
    for b in bash realpath dirname hostname; do
        ln -s "$(command -v "$b")" "$tmpdir/nocurl/$b"
    done
    output=$(PATH="$tmpdir/nocurl" "$tmpdir/upgrade-zfsutilities" 2>&1)
    rc=$?
    local failed=0
    [[ $rc -ne 0 ]] || { failed=1; echo "    expected non-zero rc"; }
    [[ "$output" == *"curl is required"* ]] || { failed=1; echo "    missing curl message"; }
    _teardown_upgrade_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "curl guard failed"; fi
}

