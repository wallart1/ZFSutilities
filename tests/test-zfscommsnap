#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfscommsnap — Unit tests for zfscommsnap

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

source "$mydir/bin/zfscommsnap"

# =============================================================================
# Helpers
# =============================================================================

reset_mocks() {
    _mock_zfs_snap_list=""
    _mock_zfs_guid_list=""
    _mock_zfs_snap_lists=()
    _mock_zfs_guid_lists=()
    _mock_zfs_props=()
    commsnap_mostrecent=""
    commsnap_find_another=""
}

# =============================================================================
# Tests
# =============================================================================

test_most_recent() {
    echo "=== Most Recent Mode ==="
    reset_mocks
    mock_zfs_snap_list "pool/src@snap3\npool/src@snap2\npool/src@snap1"
    mock_zfs_guid_list "guid3\nguid2\nguid1"
    mock_zfs_prop "pool/src@snap3" "type" "snapshot"
    commsnap_mostrecent="Y"
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    test_start "Returns most recent source snapshot"
    assert_equals "@snap3" "$result"
}

test_oldest() {
    reset_mocks
    mock_zfs_snap_list "pool/src@snap3\npool/src@snap2\npool/src@snap1"
    mock_zfs_guid_list "guid3\nguid2\nguid1"
    mock_zfs_prop "pool/src@snap1" "type" "snapshot"
    commsnap_mostrecent="OLDEST"
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    test_start "Returns oldest source snapshot"
    assert_equals "@snap1" "$result"
}

test_common_found_most_recent() {
    reset_mocks
    mock_zfs_snap_list_for "pool/src" "pool/src@snap3\npool/src@snap2\npool/src@snap1"
    mock_zfs_guid_list_for "pool/src" "guid3\nguid2\nguid1"
    mock_zfs_snap_list_for "pool/dest" "pool/dest@snap2\npool/dest@snap1"
    mock_zfs_guid_list_for "pool/dest" "guid2\nguid1"
    mock_zfs_prop "pool/src@snap2" "type" "snapshot"
    commsnap_mostrecent=""
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    rc=$?
    test_start "Common snap found and is most recent in dest (rc=0)"
    if [[ "$result" == "@snap2" && "$rc" -eq 0 ]]; then
        test_pass
    else
        test_fail "result='$result' rc=$rc"
    fi
}

test_common_found_not_most_recent() {
    reset_mocks
    mock_zfs_snap_list_for "pool/src" "pool/src@snap3\npool/src@snap2\npool/src@snap1"
    mock_zfs_guid_list_for "pool/src" "guid3\nguid2\nguid1"
    mock_zfs_snap_list_for "pool/dest" "pool/dest@snap4\npool/dest@snap2\npool/dest@snap1"
    mock_zfs_guid_list_for "pool/dest" "guid4\nguid2\nguid1"
    mock_zfs_prop "pool/src@snap2" "type" "snapshot"
    commsnap_mostrecent=""
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    rc=$?
    test_start "Common snap found but not most recent in dest (rc=16)"
    if [[ "$result" == "@snap2" && "$rc" -eq 16 ]]; then
        test_pass
    else
        test_fail "result='$result' rc=$rc"
    fi
}

test_no_common() {
    reset_mocks
    mock_zfs_snap_list_for "pool/src" "pool/src@snap3\npool/src@snap2\npool/src@snap1"
    mock_zfs_guid_list_for "pool/src" "guid3\nguid2\nguid1"
    mock_zfs_snap_list_for "pool/dest" "pool/dest@snapA\npool/dest@snapB"
    mock_zfs_guid_list_for "pool/dest" "guidA\nguidB"
    mock_zfs_prop "pool/src@snap3" "type" "snapshot"
    commsnap_mostrecent=""
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    rc=$?
    test_start "No common snap returns most recent source (rc=4)"
    if [[ "$result" == "@snap3" && "$rc" -eq 4 ]]; then
        test_pass
    else
        test_fail "result='$result' rc=$rc"
    fi
}

test_empty_source() {
    reset_mocks
    mock_zfs_snap_list ""
    mock_zfs_guid_list ""
    commsnap_mostrecent=""
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    rc=$?
    test_start "Empty source returns empty and rc=8"
    if [[ -z "$result" && "$rc" -eq 8 ]]; then
        test_pass
    else
        test_fail "result='$result' rc=$rc"
    fi
}

test_bookmark_never_selected_as_common() {
    # A user bookmark sharing a GUID with a destination snapshot must never
    # be selected as the common point. The mock mirrors real zfs type
    # filtering (bookmarks are listed only when -t asks for them) and records
    # the -t argument via a file (zfs runs inside command substitutions). The
    # bookmark is listed first (newest createtxg), so a regression that lists
    # bookmarks would match it and return a '#name'.
    _tol_type_file="$_mock_zfs_state_dir/commsnap-list-type.txt"
    : > "$_tol_type_file"
    zfs() {
        local _type="" _o="" _a _prev="" _ds
        for _a in "$@"; do
            case "$_prev" in
                -t) _type="$_a" ;;
                -o) _o="$_a" ;;
            esac
            _prev="$_a"
        done
        _ds="${!#}"
        printf '%s' "$_type" > "$_tol_type_file"
        [[ "$1" != "list" ]] && return 0
        if [[ "$_ds" == "pool/src" ]]; then
            if [[ "$_type" == *"bookmark"* && "$_o" == "name" ]]; then
                echo "pool/src#mark"
            elif [[ "$_type" == *"snap"* && "$_o" == "name" ]]; then
                echo "pool/src@snapB"
                echo "pool/src@snap1"
            elif [[ "$_type" == *"snap"* && "$_o" == "guid" ]]; then
                echo "guidB"
                echo "guid1"
            fi
        elif [[ "$_ds" == "pool/dest" ]]; then
            if [[ "$_type" == *"snap"* && "$_o" == "name" ]]; then
                echo "pool/dest@oldsnap"
            elif [[ "$_type" == *"snap"* && "$_o" == "guid" ]]; then
                echo "guidB"
            fi
        fi
        return 0
    }
    commsnap_mostrecent=""
    local result
    result=$(getcommonsnap "pool/src" "pool/dest")
    rc=$?
    unset -f zfs 2>/dev/null || true
    local _tol_list_type
    _tol_list_type=$(cat "$_tol_type_file" 2>/dev/null || true)

    test_start "Bookmark sharing a GUID is never the common snapshot"
    if [[ "$_tol_list_type" != "snap" ]]; then
        test_fail "zfs list type was '$_tol_list_type', expected 'snap'"
        return
    fi
    if [[ "$result" == "#"* ]]; then
        test_fail "Bookmark name returned as common point: '$result'"
        return
    fi
    if [[ "$result" == "@oldsnap" && "$rc" -eq 0 ]]; then
        test_pass
    else
        test_fail "result='$result' rc=$rc"
    fi
}

# =============================================================================
# Main
# =============================================================================

main() {
    test_most_recent
    test_oldest
    test_common_found_most_recent
    test_common_found_not_most_recent
    test_no_common
    test_empty_source
    test_bookmark_never_selected_as_common
    teardown_test_env
    test_summary
}

main "$@"
