#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-logging — Verify log_msg writes all messages to the session log file.

mydir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Source the working-tree bashinit directly so we test the current log_msg,
# ask_yn, warn, and die implementations, not the test harness overrides.
source "$mydir/bin/bashinit"
bashinit

# Preserve bashinit's helpers before test-lib.sh replaces log_msg and ask_yn.
_bashinit_log_msg=$(declare -f log_msg)
_bashinit_ask_yn=$(declare -f ask_yn)
_bashinit_warn=$(declare -f warn)
_bashinit_die=$(declare -f die)

source "$mydir/tests/test-lib.sh"
setup_test_env

# Restore bashinit's helpers after test-lib.sh has set up redirects.
# The log_msg tests below intentionally exercise the real bashinit log_msg,
# while the ask_yn/warn/die tests rely on test-lib.sh's log_msg redirect.
eval "$_bashinit_ask_yn"
eval "$_bashinit_warn"
eval "$_bashinit_die"

test_log_msg_writes_all_levels() {
    test_start "log_msg writes all levels to session log file"
    local logfile
    logfile="$(mktemp)"
    export ZFSUTILITIES_LOG_FILE="$logfile"
    export ZFSUTILITIES_LOG_INHERIT="N"
    export msg_level="WARN"

    # Run log_msg in a subshell so the test harness override is not active.
    # Restore ZFSUTILITIES_LOG_FILE after bashinit so log_msg writes to the
    # test file rather than the auto-created session log.
    (
        source ~/bashinit
        bashinit
        export ZFSUTILITIES_LOG_FILE="$logfile"
        export ZFSUTILITIES_LOG_INHERIT="N"
        log_msg "DEBUG: debug message"
        log_msg "VERB: verbose message"
        log_msg "INFO: info message"
        log_msg "WARN: warn message"
        log_msg "FATAL: fatal message"
        log_msg "unprefixed message"
    ) >/dev/null 2>&1

    local content
    content="$(cat "$logfile")"
    local rc=0
    for needle in \
        "DEBUG: debug message" \
        "VERB: verbose message" \
        "INFO: info message" \
        "WARN: warn message" \
        "FATAL: fatal message" \
        "unprefixed message"
    do
        if [[ "$content" != *"$needle"* ]]; then
            test_fail "Missing log line: $needle"
            rc=1
            break
        fi
    done
    if [[ $rc -eq 0 ]]; then
        test_pass
    fi
    rm -f "$logfile"
    # Drop the exports with the file: later subshell tests source the real
    # bashinit, and log_msg appends would recreate the deleted path.
    unset ZFSUTILITIES_LOG_FILE ZFSUTILITIES_LOG_INHERIT msg_level
}

test_log_msg_prints_all_to_stderr() {
    test_start "log_msg prints all messages to stderr"
    export msg_level="WARN"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            log_msg "DEBUG: d"
            log_msg "INFO: i"
            log_msg "WARN: w"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "DEBUG: d"
    assert_contains "$stderr" "INFO: i"
    assert_contains "$stderr" "WARN: w"
}

test_log_msg_no_filtering() {
    test_start "log_msg ignores msg_level environment variable"
    export msg_level="FATAL"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            log_msg "INFO: should appear"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "INFO: should appear"
}

test_log_msg_writes_to_file_when_owned() {
    test_start "log_msg writes to file only when process owns the log"
    local logfile
    logfile="$(mktemp)"
    export ZFSUTILITIES_LOG_FILE="$logfile"
    export ZFSUTILITIES_LOG_INHERIT="Y"

    (
        source ~/bashinit
        bashinit
        log_msg "INFO: inherited process"
    ) >/dev/null 2>&1

    if [[ -s "$logfile" ]]; then
        test_fail "Inherited process should not write to the log file"
    else
        test_pass
    fi
    rm -f "$logfile"
    unset ZFSUTILITIES_LOG_FILE ZFSUTILITIES_LOG_INHERIT msg_level
}

test_log_msg_handles_unset_log_file() {
    test_start "log_msg tolerates an unset ZFSUTILITIES_LOG_FILE"
    local output rc
    output=$(
        (
            unset ZFSUTILITIES_LOG_FILE
            source ~/bashinit
            bashinit
            log_msg "INFO: no log file set"
        ) 2>&1
    ) && rc=0 || rc=$?
    assert_rc 0 "$rc"
    assert_contains "$output" "INFO: no log file set"
}

test_log_msg_short_prefix_on_terminal() {
    test_start "log_msg uses short prefix on a terminal"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            export ZFSUTILITIES_LOG_INHERIT="Y"
            bashinit
            __log_msg_terminal_p() { return 0; }
            log_msg "INFO: terminal message"
        ) 2>&1 >/dev/null
    )"
    assert_equals "INFO: terminal message" "$stderr"
}

test_log_msg_long_prefix_with_flag_on_terminal() {
    test_start "log_msg --long-prefix uses long prefix on a terminal"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            export ZFSUTILITIES_LOG_INHERIT="Y"
            bashinit
            __log_msg_terminal_p() { return 0; }
            log_msg --long-prefix "INFO: long message"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "INFO: long message"
    assert_contains "$stderr" ": INFO: long message"
}

test_log_msg_long_prefix_off_terminal() {
    test_start "log_msg uses long prefix when not on a terminal"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            export ZFSUTILITIES_LOG_INHERIT="Y"
            bashinit
            __log_msg_terminal_p() { return 1; }
            log_msg "INFO: piped message"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "INFO: piped message"
    assert_contains "$stderr" ": INFO: piped message"
}

test_log_msg_log_file_always_long_prefix() {
    test_start "log_msg writes long prefix to session log even on a terminal"
    local logfile
    logfile="$(mktemp)"
    (
        source ~/bashinit
        # Suppress bashinit's auto-created session log so we control the file.
        export ZFSUTILITIES_LOG_INHERIT="Y"
        bashinit
        export ZFSUTILITIES_LOG_FILE="$logfile"
        export ZFSUTILITIES_LOG_INHERIT="N"
        __log_msg_terminal_p() { return 0; }
        log_msg "INFO: logged message"
    ) >/dev/null 2>&1
    local content
    content="$(cat "$logfile")"
    assert_contains "$content" "INFO: logged message"
    assert_contains "$content" ": INFO: logged message"
    rm -f "$logfile"
    unset ZFSUTILITIES_LOG_FILE ZFSUTILITIES_LOG_INHERIT msg_level
}

test_log_msg_msg_level_gate_hides_below_gate() {
    test_start "ZFSUTILITIES_MSG_LEVEL gate hides below-gate messages on stderr"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            export ZFSUTILITIES_MSG_LEVEL="WARN"
            log_msg "DEBUG: d"
            log_msg "VERB: v"
            log_msg "INFO: i"
            log_msg "WARN: w"
            log_msg "FATAL: f"
            log_msg "unlabelled"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "WARN: w"
    assert_contains "$stderr" "FATAL: f"
    assert_contains "$stderr" "unlabelled"
    if [[ "$stderr" == *"DEBUG: d"* || "$stderr" == *"VERB: v"* \
            || "$stderr" == *"INFO: i"* ]]; then
        test_fail "below-gate messages leaked to stderr: $stderr"
    else
        test_pass
    fi
}

test_log_msg_msg_level_gate_invalid_is_noop() {
    test_start "invalid ZFSUTILITIES_MSG_LEVEL gates nothing"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            export ZFSUTILITIES_MSG_LEVEL="BOGUS"
            log_msg "INFO: i"
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "INFO: i"
}

test_log_msg_msg_level_gate_keeps_session_log() {
    test_start "gate suppresses stderr only; the session log keeps everything"
    local logfile
    logfile="$(mktemp)"
    (
        source ~/bashinit
        bashinit
        export ZFSUTILITIES_MSG_LEVEL="WARN"
        export ZFSUTILITIES_LOG_FILE="$logfile"
        export ZFSUTILITIES_LOG_INHERIT="N"
        log_msg "INFO: hidden on stderr, logged"
        log_msg "WARN: visible and logged"
    ) >/dev/null 2>&1
    local content
    content="$(cat "$logfile")"
    assert_contains "$content" "INFO: hidden on stderr, logged"
    assert_contains "$content" "WARN: visible and logged"
    rm -f "$logfile"
    unset ZFSUTILITIES_LOG_FILE ZFSUTILITIES_LOG_INHERIT msg_level
}

test_with_msg_level_scopes_and_restores() {
    test_start "with_msg_level gates only the wrapped call and restores the caller's gate"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            noisy() {
                log_msg "INFO: inside"
                log_msg "WARN: inside-warn"
                return 7
            }
            # Unset before: stays unset after, and the status propagates.
            unset ZFSUTILITIES_MSG_LEVEL
            with_msg_level WARN noisy
            echo "rc=$? after=[${ZFSUTILITIES_MSG_LEVEL-unset}]" >&2
            log_msg "INFO: outside"
            # A caller-set gate is restored, not cleared.
            export ZFSUTILITIES_MSG_LEVEL="FATAL"
            with_msg_level WARN true
            echo "restored=[${ZFSUTILITIES_MSG_LEVEL-unset}]" >&2
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "WARN: inside-warn"
    assert_contains "$stderr" "rc=7 after=[unset]"
    assert_contains "$stderr" "INFO: outside"
    assert_contains "$stderr" "restored=[FATAL]"
    if [[ "$stderr" == *"INFO: inside"* ]]; then
        test_fail "INFO leaked through the scoped WARN gate: $stderr"
    else
        test_pass
    fi
}

test_log_verb_hidden_by_default_but_logged() {
    test_start "log_verb stays off stderr by default; the session log keeps it"
    local logfile
    logfile="$(mktemp)"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            unset ZFSUTILITIES_MSG_LEVEL
            export ZFSUTILITIES_LOG_FILE="$logfile"
            export ZFSUTILITIES_LOG_INHERIT="N"
            log_verb "Created property-manifest dataset" "tank/man"
            echo "env=[${ZFSUTILITIES_MSG_LEVEL-unset}]" >&2
        ) 2>&1 >/dev/null
    )"
    if [[ "$stderr" == *"property-manifest"* ]]; then
        test_fail "log_verb leaked to stderr with no gate set: $stderr"
        rm -f "$logfile"
        return
    fi
    assert_contains "$stderr" "env=[unset]"
    local content
    content="$(cat "$logfile")"
    assert_contains "$content" "VERB: Created property-manifest dataset tank/man"
    rm -f "$logfile"
    unset ZFSUTILITIES_LOG_FILE ZFSUTILITIES_LOG_INHERIT msg_level
}

test_log_verb_respects_an_explicit_gate() {
    test_start "log_verb honors the caller's gate: VERB shows, WARN hides, invalid shows"
    local stderr
    stderr="$(
        (
            source ~/bashinit
            bashinit
            export ZFSUTILITIES_MSG_LEVEL="VERB"
            log_verb "shown under verb"
            export ZFSUTILITIES_MSG_LEVEL="WARN"
            log_verb "hidden under warn"
            export ZFSUTILITIES_MSG_LEVEL="BOGUS"
            log_verb "shown under bogus"
            echo "env-after=[${ZFSUTILITIES_MSG_LEVEL}]" >&2
        ) 2>&1 >/dev/null
    )"
    assert_contains "$stderr" "VERB: shown under verb"
    assert_contains "$stderr" "VERB: shown under bogus"
    assert_contains "$stderr" "env-after=[BOGUS]"
    if [[ "$stderr" == *"hidden under warn"* ]]; then
        test_fail "explicit WARN gate did not hide log_verb: $stderr"
    else
        test_pass
    fi
}

