# warn / die
# ------------------------------------------------------------------------------

test_warn_logs_warning() {
    test_start "warn writes a WARN message"
    clear_test_log_file
    warn "look out"
    local log
    log=$(get_test_log_file)
    assert_contains "$(cat "$log")" "WARN: look out"
}

test_die_logs_fatal_and_exits() {
    test_start "die writes a FATAL message and exits non-zero"
    clear_test_log_file
    local rc
    (die "game over") 2>/dev/null && rc=0 || rc=$?
    assert_rc 1 "$rc"
    local log
    log=$(get_test_log_file)
    assert_contains "$(cat "$log")" "FATAL: game over"
}

