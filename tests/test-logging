test_ask_yn_yes_returns_zero() {
    test_start "ask_yn returns 0 for yes"
    local rc
    rc=0
    printf 'y\n' | ask_yn "Continue?" >/dev/null 2>&1 || rc=$?
    assert_rc 0 "$rc"
}

test_ask_yn_no_returns_one() {
    test_start "ask_yn returns 1 for no"
    local rc
    rc=1
    printf 'n\n' | ask_yn "Continue?" >/dev/null 2>&1 && rc=0
    assert_rc 1 "$rc"
}

test_ask_yn_default_y_uses_enter() {
    test_start "ask_yn default Y returns 0 on empty input"
    local rc
    rc=1
    printf '\n' | ask_yn "Continue?" "Y" >/dev/null 2>&1 && rc=0
    assert_rc 0 "$rc"
}

test_ask_yn_default_n_uses_enter() {
    test_start "ask_yn default N returns 1 on empty input"
    local rc
    rc=0
    printf '\n' | ask_yn "Continue?" "N" >/dev/null 2>&1 || rc=$?
    assert_rc 1 "$rc"
}

test_ask_yn_invalid_then_yes() {
    test_start "ask_yn rejects invalid input then accepts yes"
    local rc
    rc=0
    printf 'maybe\ny\n' | ask_yn "Continue?" >/dev/null 2>&1 || rc=$?
    assert_rc 0 "$rc"
}

