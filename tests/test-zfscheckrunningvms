#!/usr/bin/bash
# test-zfscheckrunningvms — Tests for the zfscheckrunningvms helper.
# shellcheck disable=SC1090,SC1091,SC2034,SC2154,SC2317

# shellcheck source=test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Load the functions from the module under test.
# shellcheck source=/dev/null
source "$REPO_ROOT/bin/zfscheckrunningvms"

test_returns_two_when_tools_missing() {
    test_start "checkrunningvms returns 2 when qm and pct are missing"

    # Ensure qm/pct are not available as functions.
    unset -f qm pct 2>/dev/null || true

    # Override log_msg so we can inspect the output.  Capture rc from inside
    # the command substitution so the || true guard does not mask it.
    local log_output rc
    log_output=$(
        log_msg() { echo "$*"; }
        checkrunningvms "pool/dataset"
        echo "RC=$?"
    )
    rc=$(echo "$log_output" | grep -oP '^RC=\K[0-9]+' || echo "0")
    log_output=$(echo "$log_output" | grep -v '^RC=')

    if [[ "$rc" != "2" ]]; then
        test_fail "Expected return code 2, got $rc"
        return
    fi

    if [[ "$log_output" != *"Proxmox tools (qm/pct) not found"* ]]; then
        test_fail "Expected informative log line about missing Proxmox tools"
        return
    fi

    if [[ "$log_output" != DEBUG:* ]]; then
        test_fail "Expected DEBUG-level message about missing Proxmox tools, got: $log_output"
        return
    fi

    test_pass
}

test_returns_two_for_empty_argument() {
    test_start "checkrunningvms returns 2 for empty dataset argument"

    local log_output rc
    log_output=$(
        log_msg() { echo "$*"; }
        checkrunningvms ""
        echo "RC=$?"
    )
    rc=$(echo "$log_output" | grep -oP '^RC=\K[0-9]+' || echo "0")

    if [[ "$rc" != "2" ]]; then
        test_fail "Expected return code 2, got $rc"
        return
    fi

    test_pass
}

test_returns_zero_when_no_running_vms() {
    test_start "checkrunningvms returns 0 when no VMs are running"

    qm() {
        if [[ "$1" == "list" ]]; then
            echo "VMID NAME                 STATUS    MEM(MB)    BOOTDISK(GB) PID"
            echo "100  vm1                  stopped   4096       50             -"
        fi
    }
    pct() {
        if [[ "$1" == "list" ]]; then
            echo "VMID STATUS    LOCK         NAME"
        fi
    }

    checkrunningvms "pool/dataset" >/dev/null 2>&1 || true
    local rc=$?

    unset -f qm pct 2>/dev/null || true

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected return code 0, got $rc"
        return
    fi

    test_pass
}

test_bookmarks_are_never_enumerated() {
    test_start "User bookmarks are tolerated but never enumerated as VM disks"

    # Mirror real zfs type filtering: the bookmark entry is only listed when
    # the caller explicitly asks for bookmarks, and the -t argument is
    # recorded (via a file — zfs runs inside command substitutions) so the
    # assertions below can pin it down.
    _tol_type_file="$_mock_zfs_state_dir/list-type.txt"
    : > "$_tol_type_file"
    zfs() {
        local _type="" _o="" _a _prev=""
        for _a in "$@"; do
            case "$_prev" in
                -t) _type="$_a" ;;
                -o) _o="$_a" ;;
            esac
            _prev="$_a"
        done
        printf '%s' "$_type" > "$_tol_type_file"
        if [[ "$_type" == *"bookmark"* ]]; then
            echo "pool/vm-100-disk-0#nightly"
            return 0
        fi
        if [[ "$_type" == *"volume"* && "$_o" == "name" ]]; then
            echo "pool/vm-100-disk-0"
        fi
        return 0
    }
    qm() {
        if [[ "$1" == "list" ]]; then
            echo "VMID NAME                 STATUS    MEM(MB)    BOOTDISK(GB) PID"
            echo "100  vm1                  running   4096       50             1234"
        elif [[ "$1" == "config" ]]; then
            echo "scsi0: pool:vm-100-disk-0,size=32G"
        fi
    }
    pct() {
        if [[ "$1" == "list" ]]; then
            echo "VMID STATUS    LOCK         NAME"
        fi
    }

    running_vms=""
    checkrunningvms "pool/dataset" >/dev/null 2>&1 || true
    local _output="$running_vms"

    unset -f zfs qm pct 2>/dev/null || true

    local _recorded_list_type
    _recorded_list_type=$(cat "$_tol_type_file" 2>/dev/null || true)
    if [[ "$_recorded_list_type" == *"bookmark"* || "$_recorded_list_type" == "all" ]]; then
        test_fail "zfs list was asked for bookmarks (type='$_recorded_list_type')"
        return
    fi
    if [[ "$_output" == *"#nightly"* ]]; then
        test_fail "Bookmark name leaked into the running-VM report: $_output"
        return
    fi
    if [[ "$_output" != *"pool/vm-100-disk-0"* ]]; then
        test_fail "Expected the real zvol in the running-VM report, got: $_output"
        return
    fi

    test_pass
}

test_returns_two_when_tools_missing
test_returns_two_for_empty_argument
test_returns_zero_when_no_running_vms
test_bookmarks_are_never_enumerated

test_summary
teardown_test_env
