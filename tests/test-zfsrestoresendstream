#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfsrestoresendstream — Verify lock manager integration.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

old_mydir="$mydir"

# ------------------------------------------------------------------
# Test: Lock is acquired on each destination dataset before receive
# ------------------------------------------------------------------
test_restoresendstream_acquires_locks() {
    test_start "zfsrestoresendstream acquires write lock before each receive"

    local tmpdir
    tmpdir=$(mktemp -d)

    # Copy the script under test and redirect its hard-coded source directory
    # to our temp tree so the test is self-contained.
    cp "$old_mydir/bin/zfsrestoresendstream" "$tmpdir/zfsrestoresendstream"
    sed -i "s|local sourcedir=.*|local sourcedir=\"$tmpdir/source/threeamigos/proxmox\"|" \
        "$tmpdir/zfsrestoresendstream"

    # Stub helpers
    cat > "$tmpdir/rootcheck" << 'EOF'
rootcheck() { true; }
EOF
    cat > "$tmpdir/bashsetx" << 'EOF'
EOF
    cat > "$tmpdir/bashreturn" << 'EOF'
return ${1:-8}
EOF

    local lock_log="$tmpdir/lock_calls.log"
    : > "$lock_log"

    cat > "$tmpdir/zfslockmanager" << EOF
zfslock_init() { true; }
zfslock_wait_or_resolve() {
    echo "\$1 \$2" >> "$lock_log"
    zfslock_id="$tmpdir/lock_\$1"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

    # Source dir and files matching the hard-coded restore pattern.
    mkdir -p "$tmpdir/source/threeamigos/proxmox"
    touch "$tmpdir/source/threeamigos/proxmox/vm-205-disk-0.zfssendstream"
    touch "$tmpdir/source/threeamigos/proxmox/vm-205-disk-1.zfssendstream"

    # Mock zfs and pv so the receive loop runs.
    cat > "$tmpdir/zfs" << 'EOF'
#!/usr/bin/bash
exit 0
EOF
    chmod +x "$tmpdir/zfs"
    cat > "$tmpdir/pv" << 'EOF'
#!/usr/bin/bash
cat
EOF
    chmod +x "$tmpdir/pv"

    local output rc=0
    output=$(
        PATH="$tmpdir:$PATH" bash -c "mydir='$tmpdir'; source '$tmpdir/zfsrestoresendstream'" 2>&1
    ) || rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0, got rc=$rc output: $output"
        rm -rf "$tmpdir"
        return
    fi

    local expected_calls expected_call
    expected_calls=(
        "threeamigos/proxmox/vm-205-disk-0 w"
        "threeamigos/proxmox/vm-205-disk-1 w"
    )
    for expected_call in "${expected_calls[@]}"; do
        if [[ "$(<"$lock_log")" != *"$expected_call"* ]]; then
            test_fail "Missing expected lock call: $expected_call (log: $(<"$lock_log"))"
            rm -rf "$tmpdir"
            return
        fi
    done

    test_pass
    rm -rf "$tmpdir"
}

# ------------------------------------------------------------------
# Test: Enclosure cap paces the receive pipeline (pv | pacer | zfs receive)
# ------------------------------------------------------------------
test_restoresendstream_paces_at_enclosure_cap() {
    test_start "zfsrestoresendstream inserts the pacer between pv and zfs receive"

    local tmpdir
    tmpdir=$(mktemp -d)

    cp "$old_mydir/bin/zfsrestoresendstream" "$tmpdir/zfsrestoresendstream"
    sed -i "s|local sourcedir=.*|local sourcedir=\"$tmpdir/source/threeamigos/proxmox\"|" \
        "$tmpdir/zfsrestoresendstream"

    cat > "$tmpdir/rootcheck" << 'EOF'
rootcheck() { true; }
EOF
    cat > "$tmpdir/bashsetx" << 'EOF'
EOF
    cat > "$tmpdir/bashreturn" << 'EOF'
return ${1:-8}
EOF

    local lock_log="$tmpdir/lock_calls.log"
    : > "$lock_log"
    cat > "$tmpdir/zfslockmanager" << EOF
zfslock_init() { true; }
zfslock_wait_or_resolve() {
    echo "\$1 \$2" >> "$lock_log"
    zfslock_id="$tmpdir/lock_\$1"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

    mkdir -p "$tmpdir/source/threeamigos/proxmox"
    touch "$tmpdir/source/threeamigos/proxmox/vm-205-disk-0.zfssendstream"

    # Recording mocks: zfs captures the receive, python3 captures the pacer
    # stage and passes the stream through (so zfs receive drains it), pv
    # passes through.
    local zfs_log="$tmpdir/zfs_calls.log" pacer_log="$tmpdir/pacer_calls.log"
    : > "$zfs_log"
    : > "$pacer_log"
    cat > "$tmpdir/zfs" << EOF
#!/usr/bin/bash
echo "zfs \$*" >> "$zfs_log"
exit 0
EOF
    chmod +x "$tmpdir/zfs"
    cat > "$tmpdir/pv" << 'EOF'
#!/usr/bin/bash
cat
EOF
    chmod +x "$tmpdir/pv"
    cat > "$tmpdir/python3" << EOF
#!/usr/bin/bash
echo "python3 \$*" >> "$pacer_log"
cat
exit 0
EOF
    chmod +x "$tmpdir/python3"

    # A pacer next to the copied tree's helper dir so the script's
    # find_zfsutility_script locates it (the python3 mock intercepts the
    # exec, so its content is irrelevant).
    echo "# pacer stub" > "$tmpdir/pace_stream.py"

    local output rc=0
    output=$(
        ZFSUTILITIES_TEST_ENCLOSURE_RATE=40M \
        PATH="$tmpdir:$PATH" \
        bash -c "mydir='$tmpdir'; source '$tmpdir/zfsrestoresendstream'" 2>&1
    ) || rc=$?
    local pacer_calls zfs_calls
    pacer_calls=$(cat "$pacer_log" 2>/dev/null)
    zfs_calls=$(cat "$zfs_log" 2>/dev/null)
    rm -rf "$tmpdir"

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0, got rc=$rc output: $output"
        return
    fi
    if [[ "$pacer_calls" != *"pace_stream.py 40M"* ]]; then
        test_fail "Pacer stage missing or wrong rate: '$pacer_calls'"
        return
    fi
    if [[ "$zfs_calls" != *"zfs receive -v threeamigos/proxmox/vm-205-disk-0"* ]]; then
        test_fail "Receive missing: '$zfs_calls'"
        return
    fi
    test_pass
}

# ------------------------------------------------------------------
# Test: Resolver failure fails open (WARN, restore proceeds unpaced)
# ------------------------------------------------------------------
test_restoresendstream_resolver_failure_fails_open() {
    test_start "zfsrestoresendstream WARNs and restores unpaced when the resolver fails"

    local tmpdir
    tmpdir=$(mktemp -d)

    cp "$old_mydir/bin/zfsrestoresendstream" "$tmpdir/zfsrestoresendstream"
    sed -i "s|local sourcedir=.*|local sourcedir=\"$tmpdir/source/threeamigos/proxmox\"|" \
        "$tmpdir/zfsrestoresendstream"

    cat > "$tmpdir/rootcheck" << 'EOF'
rootcheck() { true; }
EOF
    cat > "$tmpdir/bashsetx" << 'EOF'
EOF
    cat > "$tmpdir/bashreturn" << 'EOF'
return ${1:-8}
EOF

    cat > "$tmpdir/zfslockmanager" << 'EOF'
zfslock_init() { true; }
zfslock_wait_or_resolve() {
    zfslock_id="stub-lock"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

    mkdir -p "$tmpdir/source/threeamigos/proxmox"
    touch "$tmpdir/source/threeamigos/proxmox/vm-205-disk-0.zfssendstream"

    # A resolver that fails: the fail-open policy must WARN, drop the cap,
    # and still run the receive — with no pacer stage in the pipeline.
    cat > "$tmpdir/failing_resolver" << 'EOF'
#!/usr/bin/bash
echo "enclosure_rate: simulated discovery failure" >&2
exit 1
EOF
    chmod +x "$tmpdir/failing_resolver"

    local zfs_log="$tmpdir/zfs_calls.log" pacer_log="$tmpdir/pacer_calls.log"
    : > "$zfs_log"
    : > "$pacer_log"
    cat > "$tmpdir/zfs" << EOF
#!/usr/bin/bash
echo "zfs \$*" >> "$zfs_log"
exit 0
EOF
    chmod +x "$tmpdir/zfs"
    cat > "$tmpdir/pv" << 'EOF'
#!/usr/bin/bash
cat
EOF
    chmod +x "$tmpdir/pv"
    cat > "$tmpdir/python3" << EOF
#!/usr/bin/bash
echo "python3 \$*" >> "$pacer_log"
cat
exit 0
EOF
    chmod +x "$tmpdir/python3"
    echo "# pacer stub" > "$tmpdir/pace_stream.py"

    local output rc=0
    output=$(
        ZFSUTILITIES_ENCLOSURE_RATE="$tmpdir/failing_resolver" \
        PATH="$tmpdir:$PATH" \
        bash -c "mydir='$tmpdir'; source '$tmpdir/zfsrestoresendstream'" 2>&1
    ) || rc=$?
    local pacer_calls zfs_calls
    pacer_calls=$(cat "$pacer_log" 2>/dev/null)
    zfs_calls=$(cat "$zfs_log" 2>/dev/null)
    rm -rf "$tmpdir"

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0, got rc=$rc output: $output"
        return
    fi
    if [[ "$output" != *"Enclosure rate resolution failed"* ]]; then
        test_fail "Missing fail-open WARN: '$output'"
        return
    fi
    if [[ -n "$pacer_calls" ]]; then
        test_fail "Pacer ran despite resolver failure: '$pacer_calls'"
        return
    fi
    if [[ "$zfs_calls" != *"zfs receive -v threeamigos/proxmox/vm-205-disk-0"* ]]; then
        test_fail "Receive missing after resolver failure: '$zfs_calls'"
        return
    fi
    test_pass
}

test_restoresendstream_acquires_locks
test_restoresendstream_paces_at_enclosure_cap
test_restoresendstream_resolver_failure_fails_open

test_summary
teardown_test_env
