# ------------------------------------------------------------------
# Production wiring must be handled by switch-version, not deploy-version
# ------------------------------------------------------------------
test_deploy_version_does_not_wire() {
    test_start "deploy-version does not create production wiring"
    local deploy_script
    deploy_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../bin/deploy-version"

    local fail_reason=""
    local _wiring_re="setup_bashinit_symlink|setup_path_config|cleanup_old_symlinks"
    local _symlink_re="ln -s[^\n]*(/root/bashinit|/usr/local/lib/node-lib\.sh|"
    _symlink_re+="/usr/local/lib/two-node-lib\.sh|/usr/local/lib/zfsutilities/bin)"
    if grep -qE "$_wiring_re" "$deploy_script"; then
        fail_reason="deploy-version still defines/calls wiring helpers"
    elif grep -q "/etc/profile.d/zfsutilities.sh" "$deploy_script"; then
        fail_reason="deploy-version still references profile.d config"
    elif grep -q "/etc/sudoers.d/zfsutilities" "$deploy_script"; then
        fail_reason="deploy-version still references sudoers config"
    elif grep -qE "$_symlink_re" "$deploy_script"; then
        fail_reason="deploy-version still creates production symlinks"
    fi

    if [[ -n "$fail_reason" ]]; then
        test_fail "$fail_reason"
    else
        test_pass
    fi
}

test_deploy_version_does_not_wire

# Regression: the variable-casing cleanup renamed VERSION -> version but must
# not rename the repository file, which is VERSION (uppercase).
test_version_file_references_use_uppercase_filename() {
    test_start "deploy/install scripts read the repo VERSION file (uppercase)"
    local repo_root
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

    local fail_reason="" script
    for script in bin/deploy-version bin/install-single-node bin/install-two-node; do
        # A lower-case version filename reference is a casing mistake.
        if grep -qE '\$(mydir|repo_dir)/version"' "$repo_root/$script"; then
            fail_reason="$script references a lower-case version file"
            break
        fi
    done

    # deploy-version reads ./VERSION for the default version and copies it
    # into the deployed version directory.
    if [[ -z "$fail_reason" ]]; then
        if ! grep -q '"\$mydir/VERSION"' "$repo_root/bin/deploy-version"; then
            fail_reason="deploy-version does not read ./VERSION"
        elif ! grep -q 'install -m 0644 "\$mydir/VERSION"' "$repo_root/bin/deploy-version"; then
            fail_reason="deploy-version does not copy ./VERSION into the deployment"
        fi
    fi

    if [[ -n "$fail_reason" ]]; then
        test_fail "$fail_reason"
    else
        test_pass
    fi
}

test_version_file_references_use_uppercase_filename

# F-012: deploy-version must load deployment groups from the location
# install-two-node writes them to (the system config dir), with the legacy
# flat file honored as a fallback.  Reading only the legacy path left
# remote_hosts empty on fresh two-node installs: nothing synced to the
# compute host and the installer's activation ran switch-version on a tree
# that was never copied.  Verified by executing the real script (the
# DEPLOY_VERSION_TEST_NO_ROOT hatch allows non-root suite runs) against a
# fake target host through an ssh shim that records the invocation.

test_deploy_conf_usage_names_both_paths() {
    test_start "usage text names the modern path and the legacy fallback"
    local repo_root
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    if grep -q 'legacy /etc/zfsutilities-deploy.conf also honored' \
        "$repo_root/bin/deploy-version"; then
        test_pass
    else
        test_fail "--help does not mention the legacy fallback"
    fi
}

test_deploy_conf_usage_names_both_paths

