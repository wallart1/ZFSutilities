test_rsync_deletes_stale_files() {
    test_start "rsync --delete removes stale files from destination"
    local tmpdir
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/bin"
    echo '#!/bin/bash' > "$tmpdir/bin/newscript"
    chmod +x "$tmpdir/bin/newscript"
    mkdir -p "$tmpdir/versions/v1/bin"
    echo 'stale' > "$tmpdir/versions/v1/bin/oldscript"
    _test_rsync_copy "$tmpdir/bin" "$tmpdir/versions/v1/bin"
    if [[ -f "$tmpdir/versions/v1/bin/newscript" && ! -f "$tmpdir/versions/v1/bin/oldscript" ]]; then
        test_pass
    else
        test_fail "rsync did not remove stale file or copy new file correctly"
    fi
    rm -rf "$tmpdir"
