# Helper: environment for executing the real deploy-version as non-root.
# Places deploy.conf at the modern location (mode "modern") or only at the
# legacy override path (mode "legacy"). The ssh shim records invocations
# and executes mkdir/rsync --server locally so the sync path is real.
_setup_real_deploy_env() {
    local tmpdir="$1" mode="$2"
    mkdir -p "$tmpdir/base" "$tmpdir/etc" "$tmpdir/bin"
    printf 'DEPLOY_GROUP_prod="fakehost9"\n' > "$tmpdir/group.conf"
    if [[ "$mode" == "modern" ]]; then
        cp "$tmpdir/group.conf" "$tmpdir/etc/deploy.conf"
        export ZFSUTILITIES_LEGACY_DEPLOY_CONF="$tmpdir/etc/no-legacy.conf"
    else
        export ZFSUTILITIES_LEGACY_DEPLOY_CONF="$tmpdir/group.conf"
    fi
    export ZFSUTILITIES_VERSION_BASE="$tmpdir/base"
    export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$tmpdir/etc"
    export ZFSUTILITIES_LEGACY_NODE_CONF="$tmpdir/etc/no-node.conf"
    export DEPLOY_VERSION_TEST_NO_ROOT=1
    export DEPLOY_SHIM_MARKER="$tmpdir/ssh.marker"
    : > "$DEPLOY_SHIM_MARKER"
    cat > "$tmpdir/bin/ssh" << 'SSHEOF'
#!/usr/bin/bash
echo "ssh-shim: $*" >> "${DEPLOY_SHIM_MARKER:?}"
args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -o|-l) shift 2 ;;
        *) args+=("$1"); shift ;;
    esac
done
case "${args[1]:-}" in
    mkdir*)
        bash -c "${args[1]}"
        exit 0
        ;;
    rsync*)
        # args: <host> rsync --server ... — skip both, keep --server onward
        exec rsync "${args[@]:2}"
        ;;
    *)
        exit 0
        ;;
esac
SSHEOF
    chmod +x "$tmpdir/bin/ssh"
    cat > "$tmpdir/bin/mkdocs" << 'MKEOF'
#!/usr/bin/bash
if [[ "$1" == "build" ]]; then
    mkdir -p site
    echo "index" > site/index.html
fi
exit 0
MKEOF
    chmod +x "$tmpdir/bin/mkdocs"
    export PATH="$tmpdir/bin:$PATH"
}

_teardown_real_deploy_env() {
    local tmpdir="$1"
    # PATH restore is handled by the caller before teardown.
    unset ZFSUTILITIES_VERSION_BASE ZFSUTILITIES_SYSTEM_CONFIG_DIR \
        ZFSUTILITIES_LEGACY_DEPLOY_CONF ZFSUTILITIES_LEGACY_NODE_CONF \
        DEPLOY_VERSION_TEST_NO_ROOT DEPLOY_SHIM_MARKER
    rm -rf "$tmpdir"
}

test_deploy_groups_load_from_modern_conf() {
    test_start "deploy groups load from the modern config dir and sync over the shared socket"
    local repo_root tmpdir output rc marker
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    tmpdir=$(mktemp -d)
    local orig_path="$PATH"
    _setup_real_deploy_env "$tmpdir" modern
    export ZFSUTILITIES_SSH_CONTROL_PATH="$tmpdir/ctl-%s.sock"
    output=$(cd "$repo_root" && ./bin/deploy-version 9.9.9 2>&1)
    rc=$?
    marker=$(cat "$DEPLOY_SHIM_MARKER")
    export PATH="$orig_path"
    unset ZFSUTILITIES_SSH_CONTROL_PATH
    _teardown_real_deploy_env "$tmpdir"
    local failed=0
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc output: ${output:0:300}"; }
    [[ "$marker" == *"fakehost9"* ]] || { failed=1; echo "    group host never received the sync"; }
    [[ "$marker" == *"ControlPath=$tmpdir/ctl-fakehost9.sock"* ]] \
        || { failed=1; echo "    shared control socket not used"; }
    [[ "$output" == *"fakehost9 files synced"* ]] \
        || { failed=1; echo "    sync completion line missing"; }
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "modern-conf deploy failed"; fi
}

