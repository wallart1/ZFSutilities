# ------------------------------------------------------------------
# Bin copy logic: scripts now live in bin/ and are copied into the
# versioned deployment (no more per-directory symlinks).
# ------------------------------------------------------------------
_test_bin_copy_logic() {
    local version_dir="$1"
    mkdir -p "$version_dir/bin"

    # Simulate the new deploy_to_host copy of everything in bin/
    for script in "$version_dir/../bin/"*; do
        [[ -f "$script" ]] || continue
        cp -a "$script" "$version_dir/bin/"
    done
}

