# shellcheck source=../lib/upgrade-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/upgrade-lib.sh"

test_shared_conf_resolution() {
    test_start "upgrade_lib_resolve_deploy_conf prefers modern, falls back to legacy"
    local tmpdir resolved
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/etc"
    resolved=$(ZFSUTILITIES_SYSTEM_CONFIG_DIR="$tmpdir/etc" \
        ZFSUTILITIES_LEGACY_DEPLOY_CONF="$tmpdir/no-legacy" \
        upgrade_lib_resolve_deploy_conf)
    if [[ -n "$resolved" ]]; then
        rm -rf "$tmpdir"
        test_fail "expected nothing when no conf exists"
        return
    fi
    printf 'DEPLOY_GROUP_x="h1"\n' > "$tmpdir/legacy.conf"
    resolved=$(ZFSUTILITIES_SYSTEM_CONFIG_DIR="$tmpdir/etc" \
        ZFSUTILITIES_LEGACY_DEPLOY_CONF="$tmpdir/legacy.conf" \
        upgrade_lib_resolve_deploy_conf)
    if [[ "$resolved" != "$tmpdir/legacy.conf" ]]; then
        rm -rf "$tmpdir"
        test_fail "legacy fallback not resolved"
        return
    fi
    printf 'DEPLOY_GROUP_y="h2"\n' > "$tmpdir/etc/deploy.conf"
    resolved=$(ZFSUTILITIES_SYSTEM_CONFIG_DIR="$tmpdir/etc" \
        ZFSUTILITIES_LEGACY_DEPLOY_CONF="$tmpdir/legacy.conf" \
        upgrade_lib_resolve_deploy_conf)
    rm -rf "$tmpdir"
    if [[ "$resolved" == "$tmpdir/etc/deploy.conf" ]]; then
        test_pass
    else
        test_fail "modern conf must win (got: $resolved)"
    fi
}

