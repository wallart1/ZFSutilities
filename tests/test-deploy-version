test_deploy_writes_manifest() {
    test_start "deploy-version records MANIFEST.sha256 for the deployed tree"
    local repo_root tmpdir output rc
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    tmpdir=$(mktemp -d)
    local orig_path="$PATH"
    # The only group host is this host, so no remote sync is attempted.
    _setup_real_deploy_env "$tmpdir" modern
    printf 'DEPLOY_GROUP_prod="%s"\n' "$(hostname -s)" \
        > "$ZFSUTILITIES_SYSTEM_CONFIG_DIR/deploy.conf"
    output=$(cd "$repo_root" && ./bin/deploy-version 9.9.7 2>&1)
    rc=$?
    export PATH="$orig_path"
    local failed=0 vdir="$tmpdir/base/versions/9.9.7"
    [[ $rc -eq 0 ]] || { failed=1; echo "    rc=$rc output: ${output:0:300}"; }
    [[ -f "$vdir/MANIFEST.sha256" ]] || { failed=1; echo "    manifest missing"; }
    [[ -f "$vdir/VERSION" && -d "$vdir/bin" && -d "$vdir/lib" && -d "$vdir/python" \
        && -d "$vdir/docs" && -d "$vdir/share" ]] || { failed=1; echo "    tree incomplete"; }
    if [[ -f "$vdir/MANIFEST.sha256" ]]; then
        if ! diff <(upgrade_lib_hash_tree "$vdir") "$vdir/MANIFEST.sha256" > /dev/null; then
            failed=1
            echo "    manifest does not match a fresh hash of the tree"
        fi
        if grep -q "docs/site\|MANIFEST" "$vdir/MANIFEST.sha256"; then
            failed=1
            echo "    manifest lists excluded files"
        fi
    fi
    _teardown_real_deploy_env "$tmpdir"
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "manifest recording broken"; fi
}

