# A fresh two-node install writes node.conf to the modern system config
# dir; enumeration used to read only the legacy flat files and silently
# fell back to single-node (PREEXISTING fix 2026-10-13). Resolution now
# mirrors node-lib.sh: modern first, legacy fallbacks, NODE_MODE-less
# confs are two-node, no conf at all stays single-node.
test_shared_legacy_hosts_modern_node_conf() {
    test_start "upgrade_lib_legacy_hosts reads the modern node.conf first"
    local tmpdir out
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/etc"
    printf 'NODE_MODE="two-node"\nSTORAGE_HOST="stor1"\nCOMPUTE_HOST="comp1"\n' \
        > "$tmpdir/etc/node.conf"
    printf 'NODE_MODE="two-node"\nSTORAGE_HOST="oldstor"\nCOMPUTE_HOST="oldcomp"\n' \
        > "$tmpdir/legacy-node.conf"
    out=$(ZFSUTILITIES_SYSTEM_CONFIG_DIR="$tmpdir/etc" \
        ZFSUTILITIES_LEGACY_NODE_CONF="$tmpdir/legacy-node.conf" \
        ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$tmpdir/no-two-node.conf" \
        upgrade_lib_legacy_hosts)
    rm -rf "$tmpdir"
    if [[ "$out" == $'two-node\nstor1\ncomp1' ]]; then
        test_pass
