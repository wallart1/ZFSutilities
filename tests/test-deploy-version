# shellcheck disable=SC1090,SC2034,SC2154
# test-deploy-version — Verify directory deployment logic.
#
# deploy-version now copies whole directories (bin/, lib/, python/, docs/,
# share/) into the versioned deployment instead of selecting root-level files.
# These tests replicate that behaviour and validate the post-deployment checks.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"

setup_test_env

# ------------------------------------------------------------------
# Replicate the directory copy logic from deploy-version deploy_to_host
# ------------------------------------------------------------------
_test_rsync_copy() {
    local src_dir="$1"
    local dest_dir="$2"
    mkdir -p "$dest_dir"
    rsync -a --delete \
        --exclude='__pycache__/' \
        --exclude='*.pyc' \
        --exclude='.nfs*' \
        "$src_dir/" "$dest_dir/"
}

test_bin_directory_copied() {
    test_start "bin/ directory is copied into versioned deployment"
    local tmpdir
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/bin"
    echo '#!/bin/bash' > "$tmpdir/bin/myscript"
    chmod +x "$tmpdir/bin/myscript"
    mkdir -p "$tmpdir/versions/v1/bin"
    _test_rsync_copy "$tmpdir/bin" "$tmpdir/versions/v1/bin"
    if [[ -f "$tmpdir/versions/v1/bin/myscript" ]]; then
        test_pass
    else
        test_fail "bin/myscript was not copied into versioned deployment"
    fi
    rm -rf "$tmpdir"
}

