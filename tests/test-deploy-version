# The mkdocs FATAL sites exit through bashfatal, which lives in bin/ — the
# historic "$mydir/bashfatal" path resolved to the repo root and degraded
# into "No such file or directory" noise (PREEXISTING fix 2026-10-13).
test_deploy_docs_build_failure_exits_cleanly() {
    test_start "mkdocs build failure exits 1 through bashfatal without path noise"
    local repo_root tmpdir output rc
    repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
    tmpdir=$(mktemp -d)
    local orig_path="$PATH"
    _setup_real_deploy_env "$tmpdir" modern
    # Replace the working mkdocs stub with one that fails the build; the
    # versioned tree carries the repo's docs/mkdocs.yml, so the build (and
    # the FATAL site behind it) is always reached.
    cat > "$tmpdir/bin/mkdocs" << 'MKEOF'
#!/usr/bin/bash
exit 1
MKEOF
    output=$(cd "$repo_root" && ./bin/deploy-version 9.9.6 2>&1)
    rc=$?
    export PATH="$orig_path"
    _teardown_real_deploy_env "$tmpdir"
    local failed=0
    [[ $rc -eq 1 ]] || { failed=1; echo "    rc=$rc (want 1)"; }
    [[ "$output" == *"FATAL: Documentation build failed."* ]] \
        || { failed=1; echo "    FATAL line missing"; }
    [[ "$output" != *"No such file or directory"* ]] \
        || { failed=1; echo "    bashfatal path noise leaked"; }
    if [[ $failed -eq 0 ]]; then test_pass; else test_fail "docs-build FATAL path broken"; fi
}

