# ---------------------------------------------------------------------------
# declare -gA regression: production loads this file through bashinit's
# source_helper, which sources it inside a function context.
# ---------------------------------------------------------------------------

test_source_helper_context_declares_global_arrays() {
    echo ""
    echo "=== source_helper Loading Context Tests ==="
    test_start "declare -gA arrays survive a bashinit source_helper-style function source"
    local out rc
    out=$(
        # Mirror bashinit's source_helper, which sources helper files from
        # inside a function: without -g the declares would create
        # function-locals that vanish when the loader returns. Unset the
        # arrays first so the globals from the top-level source above cannot
        # mask a missing -g.
        unset _zfslock_pool_target _zfslock_remote_pids _zfslock_remote_hosts
        _zfslock_source_like_helper() { source "$mydir/bin/zfslockmanager"; }
        _zfslock_source_like_helper
        declare -p _zfslock_pool_target _zfslock_remote_pids _zfslock_remote_hosts
    )
    rc=$?
    if [[ $rc -eq 0 ]] && \
       grep -q 'declare -A _zfslock_pool_target' <<< "$out" && \
       grep -q 'declare -A _zfslock_remote_pids' <<< "$out" && \
       grep -q 'declare -A _zfslock_remote_hosts' <<< "$out"; then
        test_pass
    else
        test_fail "arrays not global after function-context source (rc=$rc)"
    fi
}

# ---------------------------------------------------------------------------
# Two-node / remote locking tests
# ---------------------------------------------------------------------------

setup_remote_agent() {
    _remote_lock_dir="$_mock_zfs_state_dir/remote_locks"
    mkdir -p "$_remote_lock_dir/.locks" "$_remote_lock_dir/.pids"

    _remote_bin_dir="$_mock_zfs_state_dir/remote_bin"
    mkdir -p "$_remote_bin_dir"
    _remote_agent="$_remote_bin_dir/zfslockmanager-remote"

    cat > "$_remote_agent" <<EOF
#!/usr/bin/bash
# Run as the "storage node" in this test; do not inherit the compute-side
# two-node override variables, or the agent will try to forward recursively.
unset ZFSLOCK_REMOTE_HOST ZFSLOCK_REMOTE_POOLS ZFSLOCK_REMOTE_BIN ZFSLOCK_THIS_HOST ZFSLOCK_REMOTE_DISABLED
export ZFSLOCK_DIR="$_remote_lock_dir"
export zfslock_locks_dir="$_remote_lock_dir/.locks"
export zfslock_pids_dir="$_remote_lock_dir/.pids"
source "$mydir/bin/bashinit"
bashinit
source "$mydir/bin/zfslockmanager"

cmd_hold() {
    local dataset="\$1" type="\$2" description="\${3:-}"
    zfslock_init
    if ! zfslock_acquire "\$dataset" "\$type" "\$description"; then
        local c_dataset c_type c_pid c_script
        c_dataset=\$(_zfslock_read_field "\$zfslock_conflict_info" "dataset") || c_dataset=""
        c_type=\$(_zfslock_read_field "\$zfslock_conflict_info" "type") || c_type=""
        c_pid=\$(_zfslock_read_field "\$zfslock_conflict_info" "pid") || c_pid=""
        c_script=\$(_zfslock_read_field "\$zfslock_conflict_info" "script") || c_script=""
        echo "CONFLICT dataset=\$c_dataset type=\$c_type pid=\$c_pid script=\$c_script"
        exit 1
    fi
    echo "LOCKED \$zfslock_id"
    sleep infinity
}

cmd_check() {
    local dataset="\$1" type="\$2"
    if zfslock_check "\$dataset" "\$type"; then
        echo '{"available": true}'
    else
        local c_dataset c_type c_pid c_script
        c_dataset=\$(_zfslock_read_field "\$zfslock_conflict_info" "dataset") || c_dataset=""
        c_type=\$(_zfslock_read_field "\$zfslock_conflict_info" "type") || c_type=""
        c_pid=\$(_zfslock_read_field "\$zfslock_conflict_info" "pid") || c_pid=""
        c_script=\$(_zfslock_read_field "\$zfslock_conflict_info" "script") || c_script=""
        printf '{"available": false, "conflict": {"dataset":"%s","type":"%s","pid":"%s","script":"%s","acquired":"","description":""}}\n' \
            "\$c_dataset" "\$c_type" "\$c_pid" "\$c_script"
    fi
}

cmd_release() {
    rm -f "\$1"
}

case "\${1:-}" in
    hold) shift; cmd_hold "\$@" ;;
    check) shift; cmd_check "\$@" ;;
    release) shift; cmd_release "\$@" ;;
    *) echo "ERROR: unknown command \$1" >&2; exit 2 ;;
esac
EOF
    chmod +x "$_remote_agent"
}

test_remote_acquire_and_release() {
    echo ""
    echo "=== Remote Lock Acquire/Release Tests ==="
    cleanup_test_locks
    setup_remote_agent

    # Make the lock manager believe this is the compute node and remotepool lives on remotehost.
    local _orig_remote_exec
    _orig_remote_exec=$(declare -f _zfslock_remote_exec)
    _zfslock_remote_exec() {
        shift
        bash -c "$*"
    }

    export ZFSLOCK_REMOTE_DISABLED=0
    export ZFSLOCK_REMOTE_HOST="remotehost"
    export ZFSLOCK_REMOTE_POOLS="remotepool"
    export ZFSLOCK_REMOTE_BIN="$_remote_bin_dir"
    export ZFSLOCK_THIS_HOST="compute"

    # Force re-load of node config with the test overrides.
    _zfslock_this_host=""
    _zfslock_load_node_config

    test_start "Remote acquire creates lock on storage node"
    if zfslock_acquire "remotepool/dataset" "w" "remote test"; then
        local remote_lockfile="${zfslock_id#REMOTE:}"
        if [[ -f "$remote_lockfile" ]]; then
            test_pass
        else
            test_fail "Remote lock file $remote_lockfile was not created"
        fi
    else
        test_fail "zfslock_acquire returned $rc"
    fi

    test_start "Remote release removes lock on storage node"
    local remote_lockfile="${zfslock_id#REMOTE:}"
    zfslock_release "$zfslock_id"
    if [[ ! -f "$remote_lockfile" ]]; then
        test_pass
    else
        test_fail "Remote lock file $remote_lockfile still exists after release"
    fi

    # Restore original remote exec function.
    if [[ -n "$_orig_remote_exec" ]]; then
        eval "$_orig_remote_exec"
    else
        unset -f _zfslock_remote_exec 2>/dev/null || true
    fi
    zfslock_release_all
    cleanup_test_locks
}

test_remote_conflict() {
    echo ""
    echo "=== Remote Lock Conflict Tests ==="
    cleanup_test_locks
    setup_remote_agent

    local _orig_remote_exec
    _orig_remote_exec=$(declare -f _zfslock_remote_exec)
    _zfslock_remote_exec() {
        shift
        bash -c "$*"
    }

    export ZFSLOCK_REMOTE_DISABLED=0
    export ZFSLOCK_REMOTE_HOST="remotehost"
    export ZFSLOCK_REMOTE_POOLS="remotepool"
    export ZFSLOCK_REMOTE_BIN="$_remote_bin_dir"
    export ZFSLOCK_THIS_HOST="compute"
    _zfslock_this_host=""
    _zfslock_load_node_config

    # Pre-create a remote lock by running the agent directly.
    local holder_script="$_mock_zfs_state_dir/remote_holder.sh"
    cat > "$holder_script" <<EOF
#!/usr/bin/bash
unset ZFSLOCK_REMOTE_HOST ZFSLOCK_REMOTE_POOLS ZFSLOCK_REMOTE_BIN ZFSLOCK_THIS_HOST ZFSLOCK_REMOTE_DISABLED
export ZFSLOCK_DIR="$_remote_lock_dir"
export zfslock_locks_dir="$_remote_lock_dir/.locks"
export zfslock_pids_dir="$_remote_lock_dir/.pids"
source "$mydir/bin/bashinit"
bashinit
source "$mydir/bin/zfslockmanager"
zfslock_init
zfslock_acquire "remotepool/conflict" "w" "holder"
sleep infinity
EOF
    bash "$holder_script" >/dev/null 2>&1 &
    local holder_pid=$!
    # Wait for the holder's lock file instead of sleeping a fixed interval.
    local holder_lockfile="$_remote_lock_dir/.locks/remotepool%2Fconflict.lock"
    local holder_tries=0
    while [[ ! -f "$holder_lockfile" && $holder_tries -lt 100 ]]; do
        sleep 0.05
        ((holder_tries++))
    done

    test_start "Remote acquire detects conflict on storage node"
    local rc
    rc=$(zfslock_acquire "remotepool/conflict" "w" "contender" >/dev/null 2>&1; echo $?)
    if [[ "$rc" -eq 1 ]]; then
        test_pass
    else
        test_fail "Expected rc=1 (conflict), got rc=$rc"
    fi

    kill "$holder_pid" 2>/dev/null
    wait "$holder_pid" 2>/dev/null

    if [[ -n "$_orig_remote_exec" ]]; then
        eval "$_orig_remote_exec"
    else
        unset -f _zfslock_remote_exec 2>/dev/null || true
    fi
    zfslock_release_all
    cleanup_test_locks
}

test_remote_poll_interval_fallback() {
    echo ""
    echo "=== Remote Poll Interval Fallback Tests ==="
    cleanup_test_locks
    setup_remote_agent

    # Same compute-side remote resolution as the other remote tests.
    local _orig_remote_exec
    _orig_remote_exec=$(declare -f _zfslock_remote_exec)
    _zfslock_remote_exec() {
        shift
        bash -c "$*"
    }

    export ZFSLOCK_REMOTE_DISABLED=0
    export ZFSLOCK_REMOTE_HOST="remotehost"
    export ZFSLOCK_REMOTE_POOLS="remotepool"
    export ZFSLOCK_REMOTE_BIN="$_remote_bin_dir"
    export ZFSLOCK_THIS_HOST="compute"
    _zfslock_this_host=""
    _zfslock_load_node_config

    test_start "Invalid remote poll interval reaches sleep as the 0.1 fallback"
    local sleep_log="$_mock_zfs_state_dir/pollfb_sleep_log"
    local response_lockfile="$_remote_lock_dir/.locks/remotepool%2Fpollfb.lock"
    rm -f "$sleep_log" "$response_lockfile"

    # Deterministically exercise exactly one poll iteration: the mocked
    # remote session produces no output of its own; the stubbed sleep delivers
    # the agent's LOCKED response when the poll loop calls sleep.
    local _orig_remote_spawn _orig_sleep
    _orig_remote_spawn=$(declare -f _zfslock_remote_spawn)
    _orig_sleep=$(declare -f sleep)
    _zfslock_remote_spawn() {
        # Fake SSH session: a long-lived pid with no agent output yet.
        command sleep infinity &
        _zfslock_remote_ssh_pid=$!
    }
    sleep() {
        printf '%s\n' "$*" >> "$sleep_log"
        local f
        for f in "$zfslock_locks_dir"/.remote-acquire.*; do
            [[ -f "$f" && ! -s "$f" ]] || continue
            printf 'LOCKED %s\n' "$response_lockfile" > "$f"
        done
    }

    local acquired=1
    if ZFSLOCK_REMOTE_POLL_INTERVAL=abc \
        zfslock_acquire "remotepool/pollfb" "w" "poll fallback test" \
        >/dev/null 2>&1; then
        [[ "$zfslock_id" == "REMOTE:$response_lockfile" ]] || acquired=0
    else
        acquired=0
    fi

    # Restore the overridden functions before releasing so the remote
    # release path (which kills the fake SSH pid) runs unstubbed.
    eval "$_orig_remote_spawn"
    if [[ -n "$_orig_sleep" ]]; then
        eval "$_orig_sleep"
    else
        unset -f sleep 2>/dev/null || true
    fi

    if [[ $acquired == 1 ]] && grep -qx "0.1" "$sleep_log" \
        && ! grep -q "abc" "$sleep_log"; then
        test_pass
    else
        test_fail "acquired=$acquired sleep_log=$(tr '\n' ' ' < "$sleep_log" 2>/dev/null)"
    fi
    zfslock_release "$zfslock_id" 2>/dev/null || true

    if [[ -n "$_orig_remote_exec" ]]; then
        eval "$_orig_remote_exec"
    else
        unset -f _zfslock_remote_exec 2>/dev/null || true
    fi
    zfslock_release_all
    cleanup_test_locks
}

