#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfscleanup — Verify pool selection and fallback behavior.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

old_mydir="$mydir"
mock_mydir=$(mktemp -d)
mydir="$mock_mydir"

cat > "$mock_mydir/rootcheck" <<'EOF'
rootcheck() { true; }
EOF

cat > "$mock_mydir/bashreturn" <<'EOF'
return "${1:-0}"
EOF

cat > "$mock_mydir/zfsconfig" <<'EOF'
zfsconfig_get_pools() {
    printf '%s\n' "${zfscleanup_test_pools[@]}"
}

poolarray() {
    zfspoolarray=()
    while IFS= read -r pool; do
        [[ -n "$pool" ]] && zfspoolarray+=("$pool")
    done < <(zfsconfig_get_pools)
}
EOF

cat > "$mock_mydir/zfsbuildfsarray" <<'EOF'
buildfsarray() {
    zfscleanup_selection+=("${includes[*]:-}|${excludes[*]:-}|${startwith:-}|${endwith:-}")
    local _pool_specific="_mock_fsarray_$1"
    if [[ -n "${!_pool_specific+x}" ]]; then
        eval "fsarray=(\"\${$_pool_specific[@]}\")"
    elif [[ ${#_mock_fsarray[@]} -gt 0 ]]; then
        fsarray=("${_mock_fsarray[@]}")
    else
        fsarray=("$1")
    fi
}
EOF

cat > "$mock_mydir/zfsretain" <<'EOF'
retain() {
    if [[ "$1" == "${_mock_retain_conflict:-}" ]]; then return 1; fi
    if [[ "$1" == "${_mock_retain_error:-}" ]]; then return 8; fi
    zfscleanup_processed+=("$1 $2")
    zfscleanup_retain_tags+=("${releaseholds_tags[*]}")
}
EOF

cat > "$mock_mydir/zfsoverrides" <<'EOF'
overrides() { true; }
EOF

cat > "$mock_mydir/zfslockmanager" <<'EOF'
zfslock_init() { true; }
zfslock_acquire() { zfslock_id="/tmp/mock_lock"; return 0; }
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

source "$old_mydir/bin/zfscleanup"

reset_state() {
    zfscleanup_processed=()
    zfscleanup_retain_tags=()
    zfscleanup_selection=()
    zfscleanup_test_pools=()
    _mock_zpool_list=""
    _mock_fsarray=()
    _mock_fsarray_pool1=()
    _mock_fsarray_pool2=()
    _mock_retain_conflict=""
    _mock_retain_error=""
    autoproceed='Y'
    dryrun='N'
    releaseholds='N'
    releaseholds_tags=()
    includes=()
    excludes=()
    startwith=''
    endwith=''
    prune_datasets=()
}

# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------

test_fallback_when_config_has_no_pools() {
    test_start "Fallback to all online pools when config has no pools"
    reset_state
    _mock_zpool_list=$'tank\nfivebays'
    cleanup "" "" "dailybackup"
    assert_equals "tank @dailybackup fivebays @dailybackup" "${zfscleanup_processed[*]}"
}

test_uses_configured_pools() {
    test_start "Uses pools from JSON config instead of zpool list"
    reset_state
    zfscleanup_test_pools=(tank fivebays)
    _mock_zpool_list=$'otherpool'
    cleanup "" "" "dailybackup"
    assert_equals "tank @dailybackup fivebays @dailybackup" "${zfscleanup_processed[*]}"
}

test_explicit_pool_argument_wins() {
    test_start "Explicit pool argument bypasses config and fallback"
    reset_state
    zfscleanup_test_pools=(ignored1 ignored2)
    _mock_zpool_list=$'ignored3'
    cleanup "tank" "" "dailybackup"
    assert_equals "tank @dailybackup" "${zfscleanup_processed[*]}"
}

test_skips_offline_pools() {
    test_start "Skips configured pools that are offline"
    reset_state
    zfscleanup_test_pools=(tank offlinepool)
    # Make zpool list <pool> fail for the offline pool.
    zpool() {
        if [[ "$1" == "list" && "$2" == "-Ho" && "$3" == "name" ]]; then
            echo -e "$_mock_zpool_list"
            return 0
        fi
        if [[ "$1" == "list" && "$2" == "offlinepool" ]]; then
            return 1
        fi
        return 0
    }
    cleanup "" "" "dailybackup"
    assert_equals "tank @dailybackup" "${zfscleanup_processed[*]}"
}

test_fallback_with_empty_array() {
    test_start "Empty pools array triggers fallback to online pools"
    reset_state
    zfscleanup_test_pools=()
    _mock_zpool_list=$'tank'
    cleanup "" "" "dailybackup"
    assert_equals "tank @dailybackup" "${zfscleanup_processed[*]}"
}

test_continues_after_retain_lock_conflict() {
    test_start "Continues with next dataset when retain reports a lock conflict"
    reset_state
    zfscleanup_test_pools=(pool)
    _mock_zpool_list=$'pool'
    _mock_fsarray=(pool/a pool/b)
    _mock_retain_conflict="pool/a"
    cleanup "" "" "dailybackup"
    assert_equals "pool/b @dailybackup" "${zfscleanup_processed[*]}"
}

test_continues_after_retain_policy_error() {
    test_start "Continues with next dataset when retain returns a policy error"
    reset_state
    zfscleanup_test_pools=(pool)
    _mock_zpool_list=$'pool'
    _mock_fsarray=(pool/a pool/b)
    _mock_retain_error="pool/a"
    cleanup "" "" "dailybackup"
    assert_equals "pool/b @dailybackup" "${zfscleanup_processed[*]}"
}

test_continues_to_next_pool_after_retain_error() {
    test_start "Continues with next pool when retain returns an error"
    reset_state
    zfscleanup_test_pools=(pool1 pool2)
    _mock_zpool_list=$'pool1\npool2'
    _mock_fsarray_pool1=(pool1/a pool1/b)
    _mock_fsarray_pool2=(pool2/a pool2/b)
    _mock_retain_error="pool1/a"
    cleanup "" "" "dailybackup"
    local _wrap_expected="pool1/b @dailybackup pool2/a @dailybackup pool2/b @dailybackup"
    assert_equals "$_wrap_expected" "${zfscleanup_processed[*]}"
}

test_releaseholds_tags_default() {
    test_start "Defaults releaseholds_tags to offsite-* when releaseholds=Y"
    reset_state
    zfscleanup_test_pools=(tank)
    releaseholds='Y'
    cleanup "" "" "dailybackup"
    assert_contains "${zfscleanup_retain_tags[*]}" "offsite-*"
}

test_no_builtin_selection_criteria() {
    test_start "No built-in selection criteria when caller sets none"
    reset_state
    zfscleanup_test_pools=(tank)
    cleanup "" "" "dailybackup"
    assert_equals "|||" "${zfscleanup_selection[0]}"
}

test_caller_selection_criteria_forwarded() {
    test_start "Caller dataset selection criteria are forwarded to buildfsarray"
    reset_state
    zfscleanup_test_pools=(tank fivebays)
    includes=('proxmox')
    excludes=('vm-100' '=tank/scratch')
    startwith='=tank/a'
    endwith='z'
    cleanup "" "" "dailybackup"
    assert_equals "proxmox|vm-100 =tank/scratch|=tank/a|z" "${zfscleanup_selection[0]}"
    assert_equals "proxmox|vm-100 =tank/scratch|=tank/a|z" "${zfscleanup_selection[1]}"
}

test_temp_pool_has_no_builtin_exclude() {
    test_start "temp pool is processed with no built-in excludes"
    reset_state
    zfscleanup_test_pools=(temp)
    cleanup "" "" "dailybackup"
    assert_equals "|||" "${zfscleanup_selection[0]}"
    assert_equals "temp @dailybackup" "${zfscleanup_processed[*]}"
}

test_prune_datasets_mode_skips_pool_discovery() {
    test_start "prune_datasets mode prunes exactly the given datasets"
    reset_state
    zfscleanup_test_pools=(tank fivebays)
    prune_datasets=(fivebays/a fivebays/b)
    cleanup "" "" "dailybackup"
    assert_equals "fivebays/a @dailybackup fivebays/b @dailybackup" "${zfscleanup_processed[*]}"
    assert_equals "0" "${#zfscleanup_selection[@]}"
}

test_prune_datasets_mode_ignores_pool_argument() {
    test_start "prune_datasets mode ignores the pool argument"
    reset_state
    zfscleanup_test_pools=(tank)
    prune_datasets=(dest/x)
    cleanup "tank" "" "dailybackup"
    assert_equals "dest/x @dailybackup" "${zfscleanup_processed[*]}"
}

test_prune_datasets_mode_continues_after_retain_error() {
    test_start "prune_datasets mode continues after a retain error"
    reset_state
    zfscleanup_test_pools=(tank)
    prune_datasets=(dest/x dest/y)
    _mock_retain_error="dest/x"
    cleanup "" "" "dailybackup"
    assert_equals "dest/y @dailybackup" "${zfscleanup_processed[*]}"
}

# -----------------------------------------------------------------------------
# Run tests
# -----------------------------------------------------------------------------

test_fallback_when_config_has_no_pools
test_uses_configured_pools
test_explicit_pool_argument_wins
test_skips_offline_pools
test_fallback_with_empty_array
test_continues_after_retain_lock_conflict
test_continues_after_retain_policy_error
test_continues_to_next_pool_after_retain_error
test_releaseholds_tags_default
test_no_builtin_selection_criteria
test_caller_selection_criteria_forwarded
test_temp_pool_has_no_builtin_exclude
test_prune_datasets_mode_skips_pool_discovery
test_prune_datasets_mode_ignores_pool_argument
test_prune_datasets_mode_continues_after_retain_error

rm -rf "$mock_mydir"
mydir="$old_mydir"

test_summary
teardown_test_env
