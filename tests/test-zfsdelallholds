#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfsdelallholds — Verify selective hold release by tag patterns.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

old_mydir="$mydir"

# Provide a mock lock manager so tests do not require root or a writable
# /run/lock/zfsutilities directory. ZFSUTILITIES_BIN_DIR ensures source_helper
# resolves the mock before the deployed real helper.
_zfsdelallholds_lock_dir=$(mktemp -d)
cat > "$_zfsdelallholds_lock_dir/zfslockmanager" <<'EOF'
zfslock_init() { true; }
zfslock_acquire() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_wait_or_resolve() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF
export ZFSUTILITIES_BIN_DIR="$_zfsdelallholds_lock_dir"

# Source the real helper; it depends only on bashinit (mocked above) and zfs.
source "$old_mydir/bin/zfsdelallholds"

test_no_patterns_releases_all_holds() {
    echo "=== No patterns: releases all holds ==="
    mock_zfs_holds "pool/fs@snap" "offsite-pool" "userhold"
    delallholds "pool/fs@snap"
    test_start "No patterns releases all holds"
    if [[ -z "${_mock_zfs_holds[pool/fs@snap]:-}" ]]; then
        test_pass
    else
        test_fail "Expected all holds released, remaining: ${_mock_zfs_holds[pool/fs@snap]}"
    fi
}

test_single_tag_releases_only_matching() {
    echo "=== Single tag: releases only match ==="
    mock_zfs_holds "pool/fs@snap" "offsite-pool" "userhold"
    delallholds "pool/fs@snap" "offsite-pool"
    test_start "Single tag releases only matching hold"
    if [[ "${_mock_zfs_holds[pool/fs@snap]:-}" == "userhold" ]]; then
        test_pass
    else
        test_fail "Expected userhold remaining, got: ${_mock_zfs_holds[pool/fs@snap]:-}"
    fi
}

test_glob_pattern_releases_matching() {
    echo "=== Glob pattern: releases offsite-* ==="
    mock_zfs_holds "pool/fs@snap" "offsite-pool1" "offsite-pool2" "userhold"
    delallholds "pool/fs@snap" 'offsite-*'
    test_start "Glob pattern releases only offsite-* holds"
    if [[ "${_mock_zfs_holds[pool/fs@snap]:-}" == "userhold" ]]; then
        test_pass
    else
        test_fail "Expected userhold remaining, got: ${_mock_zfs_holds[pool/fs@snap]:-}"
    fi
}

test_reports_remaining_holds() {
    echo "=== Reports remaining holds ==="
    mock_zfs_holds "pool/fs@snap" "offsite-pool" "userhold"
    delallholds "pool/fs@snap" 'offsite-*'
    test_start "Sets zfs_delallholds_remaining_tags for unreleased holds"
    if [[ "$zfs_delallholds_remaining_tags" == "userhold" ]]; then
        test_pass
    else
        test_fail "Expected remaining tags 'userhold', got: '$zfs_delallholds_remaining_tags'"
    fi
}

test_no_holds_returns_zero() {
    echo "=== No holds: returns 0 ==="
    _mock_zfs_holds=()
    delallholds "pool/fs@snap" 'offsite-*'
    test_start "No holds returns zero and clears remaining tags"
    if [[ -z "$zfs_delallholds_remaining_tags" ]]; then
        test_pass
    else
        test_fail "Expected empty remaining tags, got: '$zfs_delallholds_remaining_tags'"
    fi
}

test_multiple_patterns() {
    echo "=== Multiple patterns ==="
    mock_zfs_holds "pool/fs@snap" "offsite-pool" "backup-hold" "userhold"
    delallholds "pool/fs@snap" 'offsite-*' 'backup-*'
    test_start "Multiple patterns release all matching holds"
    if [[ "${_mock_zfs_holds[pool/fs@snap]:-}" == "userhold" ]]; then
        test_pass
    else
        test_fail "Expected userhold remaining, got: ${_mock_zfs_holds[pool/fs@snap]:-}"
    fi
}

test_no_patterns_releases_all_holds
test_single_tag_releases_only_matching
test_glob_pattern_releases_matching
test_reports_remaining_holds
test_no_holds_returns_zero
test_multiple_patterns

test_summary
rm -rf "${_zfsdelallholds_lock_dir:-}"
teardown_test_env
