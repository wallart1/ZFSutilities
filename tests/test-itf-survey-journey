# ------------------------------------------------------------------------------
# Guest clock control: freeze / forward-only fence / restore (guest-lib)
# ------------------------------------------------------------------------------

test_guest_time_fence() {
    test_start "guest time helpers: freeze, forward-only fence, restore"
    local out
    # The fake guest interprets the helpers' command shapes: freeze
    # (set-ntp false) seeds the walk state, set-time mutates last=,
    # restore (set-ntp true) clears it.  FAKE_TIMER=1 makes freeze take
    # the mask branch (the fence timer present on that guest).
    out="$(
        (
            # shellcheck disable=SC1090
            source "$mydir/tests/integrated/lib/guest-lib.sh"
            FAKE_STATE="" FAKE_TIMER=0 FAKE_LOG=""
            itf_guest_exec() {
                local cmd="$2" ep
                case "$cmd" in
                    *"set-ntp true"*)
                        ep="$(printf '%s\n' "$cmd" \
                            | grep -oE 'set-time @[0-9]+' | grep -oE '[0-9]+')"
                        FAKE_LOG+="restore:@$ep;"
                        FAKE_STATE=""
                        ;;
                    *"set-ntp false"*)
                        FAKE_LOG+="freeze:masked=$FAKE_TIMER;"
                        FAKE_STATE="$(printf 'frozen=1\nmasked=%s\nlast=' "$FAKE_TIMER")"
                        ;;
                    *"timedatectl set-time @"*)
                        ep="$(printf '%s\n' "$cmd" \
                            | grep -oE 'set-time @[0-9]+' | grep -oE '[0-9]+')"
                        FAKE_LOG+="set:@$ep;"
                        FAKE_STATE="$(printf 'frozen=1\nmasked=%s\nlast=%s' \
                            "$FAKE_TIMER" "$ep")"
                        ;;
                    *"cat /run/itf/time-walk"*)
                        printf '%s\n' "$FAKE_STATE"
                        ;;
                esac
                return 0
            }
            itf_guest_time_freeze 10.0.0.1 || echo freeze-failed
            itf_guest_time_set 10.0.0.1 1600000000 || echo rewind-failed
            itf_guest_time_set 10.0.0.1 1590000000 2>/dev/null \
                && echo BACKWARD-ALLOWED
            itf_guest_time_set 10.0.0.1 1600000050 || echo forward-failed
            itf_guest_time_set 10.0.0.1 1600000050 2>/dev/null \
                && echo LATERAL-ALLOWED
            itf_guest_time_restore 10.0.0.1 || echo restore-failed
            itf_guest_time_set 10.0.0.1 1700000000 2>/dev/null \
                && echo UNFROZEN-ALLOWED
            echo "log=$FAKE_LOG"
            echo "sets=$(printf '%s\n' "$FAKE_LOG" | grep -o 'set:@' | wc -l)"
        ) 2>/dev/null
    )"
    case "$out" in
        *failed*|*ALLOWED*) test_fail "fence sequence misbehaved: $out"; return ;;
    esac
    assert_contains "$out" "freeze:masked=0"
    assert_contains "$out" "sets=2"   # the rewind + one forward set
    if ! printf '%s\n' "$out" | grep -qE 'restore:@1[0-9]{9}'; then
        test_fail "restore did not set-time from the dev host epoch: $out"
        return
    fi
    # Timer-present guests take the mask branch on freeze.
    out="$(
        (
            # shellcheck disable=SC1090
            source "$mydir/tests/integrated/lib/guest-lib.sh"
            FAKE_STATE="" FAKE_TIMER=1 FAKE_LOG=""
            itf_guest_exec() {
                local cmd="$2" ep
                case "$cmd" in
                    *"set-ntp true"*) FAKE_LOG+="restore;" ; FAKE_STATE="" ;;
                    *"set-ntp false"*)
                        FAKE_LOG+="freeze:masked=$FAKE_TIMER;"
                        FAKE_STATE="$(printf 'frozen=1\nmasked=%s\nlast=' "$FAKE_TIMER")" ;;
                esac
                return 0
            }
            itf_guest_time_freeze 10.0.0.2 || echo freeze-failed
            itf_guest_time_restore 10.0.0.2 || echo restore-failed
            echo "log=$FAKE_LOG"
        ) 2>/dev/null
    )"
    case "$out" in
        *failed*) test_fail "mask-branch freeze/restore failed: $out"; return ;;
    esac
    assert_contains "$out" "freeze:masked=1"
    test_pass
}

test_select_new_creates_archive_and_half_sample() {
    test_start "select (new) archives the list and samples at least half"
    local root run
    root="$(make_itf_root "$tmp_root/root1")"
    run="$tmp_root/run1"; mkdir -p "$run"
    local out
    out="$(_source_survey "$root" "$run" '
        ITF_SURVEY_SEED=unitseed ITF_SURVEY_FRACTION=0.5 \
            itf_survey_select > /dev/null 2>&1
        echo "rc=$?"
        wc -l < "'"$run"'/survey-items.tsv" 2>/dev/null
        test -f "'"$run"'/survey-archive.json" && echo archive=yes
        ls "'"$root"'/survey/archives/" | wc -l
    ')"
    assert_equals "rc=0" "$(echo "$out" | sed -n 1p)" "select rc"
    local cli_total cli_sampled
    cli_total="$(grep -cE $'^cli-[a-z0-9.-]+\tcli\t' "$REAL_SURVEY/universe.tsv")"
    cli_sampled="$(grep -cE $'^cli-\S+\tcli\t' "$run/survey-items.tsv")"
    if (( cli_sampled * 2 < cli_total )); then
        test_fail "sampled $cli_sampled of $cli_total CLI items (<50%)"
        return
    fi
    assert_contains "$out" "archive=yes"
    assert_equals "1" "$(echo "$out" | sed -n 4p | tr -d ' ')" \
        "durable archive copy count"
    test_pass
}

test_select_new_deterministic() {
    test_start "select (new) with a pinned seed is deterministic"
    local root_a root_b run_a run_b
    root_a="$(make_itf_root "$tmp_root/root2a")"
    root_b="$(make_itf_root "$tmp_root/root2b")"
    run_a="$tmp_root/run2a"; mkdir -p "$run_a"
    run_b="$tmp_root/run2b"; mkdir -p "$run_b"
    _source_survey "$root_a" "$run_a" '
        ITF_SURVEY_SEED=unitseed itf_survey_select > /dev/null 2>&1'
    _source_survey "$root_b" "$run_b" '
        ITF_SURVEY_SEED=unitseed itf_survey_select > /dev/null 2>&1'
    if ! diff -u "$run_a/survey-items.tsv" "$run_b/survey-items.tsv"; then
        test_fail "same seed produced different selections"
        return
    fi
    test_pass
}

