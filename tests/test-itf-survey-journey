test_world_stage_dispatches_lived_in() {
    test_start "world stage: lived-in = playground + plan + clock walk + verify"
    local root run anchor
    root="$(make_itf_root "$tmp_root/root12b")"
    run="$tmp_root/run12b"; mkdir -p "$run"
    # Phase A: a real selection pins the world (seed, anchor, archive).
    _source_survey "$root" "$run" '
        ITF_SURVEY_WORLD=lived-in ITF_SURVEY_SEED=unitseed \
            itf_survey_select > /dev/null 2>&1' \
        || { test_fail "selection failed"; return; }
    anchor="$(sed -n 's/^# world-anchor //p' "$run/survey-select.out" | head -1)"
    # Phase B: precompute what the guest will be asked to prove — the
    # plan for the pinned seed/anchor, rendered as the verify pull the
    # stage's comparison consumes (plus the two product runs).
    python3 - "$root/survey/world.py" "$run" "$anchor" <<'PYPRE'
import json, subprocess, sys

world_py, run, anchor = sys.argv[1], sys.argv[2], sys.argv[3]
subprocess.run(
    [sys.executable, world_py, "plan", "--variant", "lived-in",
     "--seed", "unitseed", "--anchor", anchor,
     "--out-json", f"{run}/pre-plan.json", "--out-tsv", f"{run}/pre.tsv"],
    check=True,
)
plan = json.load(open(f"{run}/pre-plan.json"))
base = "zfstest1/survey-run12b"   # rid derives from the run-dir basename
lines = [f'{base}/{r["dataset"]}@{r["name"]} {r["epoch"]}' for r in plan["ladder"]]
last = max(r["epoch"] for r in plan["ladder"]) + 60
for i in range(len(plan["dailybackup"])):
    lines.append(f"{base}/backup-src@dailybackup-run{i} {last + i}")
# The playground's own snapshot on the base dataset (counts in -r).
lines.append(f"{base}@survey-playground {last + 90}")
lines.append("== holds ==")
lines += [
    f'{base}/{r["dataset"]}@{r["name"]} {r["hold"]}'
    for r in plan["ladder"] if r["hold"]
]
lines.append("== recv ==")
for i, e in enumerate(plan["dailybackup"]):
    lines.append(f"{base}-recv@snap{i} {e['epoch']}")
with open(f"{run}/fake-verify.txt", "w") as f:
    f.write("\n".join(lines) + "\n")
PYPRE
    # Phase C: the stage against stubbed transports; dev-side planning
    # (world.py) and the fence run for real.
    local out
    out="$(_source_survey "$root" "$run" '
        # shellcheck disable=SC1090
        source "'"$mydir"'/tests/integrated/lib/guest-lib.sh"
        SURVEY_WORLD=lived-in SURVEY_WORLD_SEED=unitseed
        SURVEY_WORLD_ANCHOR='"$anchor"'
        SURVEY_ARCHIVE="'"$run"'/survey-archive.json"
        FAKE_STATE="" FAKE_LOG="" PUTS=""
        itf_guest_put() { PUTS+="$(basename "$3");"; return 0; }
        itf_guest_exec_feed() { FAKE_LOG+="dailybackup;"; return 0; }
        itf_guest_exec() {
            local cmd="$2" ep
            case "$cmd" in
                *"set-ntp false"*)
                    FAKE_LOG+="freeze;"
                    FAKE_STATE="frozen=1
masked=0
last=" ;;
                *"set-ntp true"*) FAKE_LOG+="restore;"; FAKE_STATE="" ;;
                *"timedatectl set-time @"*)
                    ep="$(printf "%s\n" "$cmd" \
                        | grep -oE "set-time @[0-9]+" | grep -oE "[0-9]+")"
                    FAKE_LOG+="set:$ep;"
                    FAKE_STATE="frozen=1
masked=0
last=$ep" ;;
                *"cat /run/itf/time-walk"*) printf "%s\n" "$FAKE_STATE" ;;
                *"world-stage.sh tree"*) FAKE_LOG+="tree;" ;;
                *"world-stage.sh group"*) FAKE_LOG+="group;" ;;
                *"world-stage.sh clone"*) FAKE_LOG+="clone;" ;;
                *"zfs list -H -t snapshot"*) cat "'"$run"'/fake-verify.txt" ;;
            esac
            return 0
        }
        itf_survey_stage_world 10.0.0.1 > /dev/null 2>&1
        echo "rc=$?"
        echo "steps=$_steps"
        echo "log=$FAKE_LOG"
