test_guest_ip_skips_p2p_pair() {
    test_start "guest IP discovery: the P2P pair never wins the pick"
    local out
    # The P2P interface listed FIRST still loses: the management
    # address is the pick whenever the pair is loaded.
    out="$(
        (
            # shellcheck disable=SC1090
            source "$mydir/tests/integrated/lib/guest-lib.sh"
            itf_qm() {
                printf '[{"name": "eth1", "ip-addresses": [{"ip-address-type": "ipv4", "ip-address": "192.168.101.1"}]}, {"name": "eth0", "ip-addresses": [{"ip-address-type": "ipv4", "ip-address": "192.168.1.55"}]}]\n'
            }
            sleep() { :; }
            ITF_ISCSI_STORAGE_IP=192.168.101.1 ITF_ISCSI_COMPUTE_IP=192.168.101.2 \
                itf_guest_ip base.invalid 8003 30
        ) 2>/dev/null
    )"
    assert_contains "$out" "192.168.1.55"
    # A guest whose ONLY address is the P2P one never yields it: the
    # discovery times out instead (the checkpoint-restart shape from
    # run-20261123-235048 — DHCP not leased yet, static P2P up).
    out="$(
        (
            # shellcheck disable=SC1090
            source "$mydir/tests/integrated/lib/guest-lib.sh"
            itf_qm() {
                printf '[{"name": "eth1", "ip-addresses": [{"ip-address-type": "ipv4", "ip-address": "192.168.101.1"}]}]\n'
            }
            sleep() { :; }
            ITF_ISCSI_STORAGE_IP=192.168.101.1 \
                itf_guest_ip base.invalid 8003 1
            echo "rc=$?"
        ) 2>/dev/null
    )"
    assert_contains "$out" "rc=1"
    # Without the two-node pair loaded, the first address wins as before.
    out="$(
        (
            # shellcheck disable=SC1090
            source "$mydir/tests/integrated/lib/guest-lib.sh"
            itf_qm() {
                printf '[{"name": "eth1", "ip-addresses": [{"ip-address-type": "ipv4", "ip-address": "192.168.101.1"}]}]\n'
            }
            sleep() { :; }
            itf_guest_ip base.invalid 8003 30
        ) 2>/dev/null
    )"
    assert_contains "$out" "192.168.101.1"
    test_pass
}

