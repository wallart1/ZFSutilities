test_world_stage_dispatches_thin() {
    test_start "world stage: thin dispatches the playground + reports cost"
    local root run
    root="$(make_itf_root "$tmp_root/root11")"
    run="$tmp_root/run11"; mkdir -p "$run"
    # The playground pins the payload config's schema version from the
    # enumerated tree, so a fabricated selection marker stands in for a
    # real select here.
    printf '# enum-root %s\n' "$REAL_REPO" > "$run/survey-select.out"
    local out
    out="$(_source_survey "$root" "$run" '
        itf_guest_put() { return 0; }
        itf_guest_exec() { return 0; }
        SURVEY_WORLD=thin
        itf_survey_stage_world 10.0.0.1 > /dev/null 2>&1
        echo "rc=$?"
        echo "steps=$_steps"
    ')"
    assert_contains "$out" "rc=0"
    assert_contains "$out" "pass:survey playground staged"
    assert_contains "$out" "info:survey world staged"
    assert_contains "$out" "variant=thin"
    assert_contains "$out" "elapsed="
    test_pass
}

