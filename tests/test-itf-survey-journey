test_world_restore_paths() {
    test_start "world restore: stale sweep + rollback + verify; restage fallback"
    local root run out
    root="$(make_itf_root "$tmp_root/root24")"
    run="$tmp_root/run24"; mkdir -p "$run"
    printf 'base.invalid 8001 10.0.0.5 j22-run24\n' > "$run/guest-storage.txt"
    printf 'SURVEY_RID=run24\nSURVEY_DS=zfstest1/survey-run24\n' \
        > "$run/survey-env.sh"
    printf '{"ladder": [], "dailybackup": []}\n' > "$run/survey-world-plan.json"
    out="$(_source_survey "$root" "$run" '
        CALLS="" VERIFIED=0
        itf_qm() {
            case "$*" in
                *"listsnapshot 8001"*)
                    printf "\x60-> world-staged  today  1.5 GiB\n"
                    printf "\x60-> full-leg-product  today  0 B\n"
                    printf "\x60-> current  You are here!\n" ;;
                *delsnapshot*) CALLS+="delsnap:$4;" ;;
                *rollback*) CALLS+="rollback:$4;" ;;
            esac
            return 0
        }
        itf_guest_stop() { CALLS+="stop;"; return 0; }
        itf_guest_start() { CALLS+="start;"; return 0; }
        itf_guest_ip() { echo "10.0.0.9"; return 0; }
        itf_wait_ssh() { return 0; }
        _survey_world_verify() { echo "ladder=1 holds=0"; return 0; }
        _survey_world_restore
        echo "rc=$?"
        echo "calls=$CALLS"
        echo "steps=$_steps"
        echo "record=$(cat "'"$run"'/guest-storage.txt")"
    ')"
    assert_contains "$out" "rc=0"
    assert_contains "$out" "delsnap:full-leg-product;"
    assert_contains "$out" "rollback:world-staged;"
    # The pass message carries the (stubbed) verify summary: the
    # rollback must pass the same plan verification the staging ran.
    assert_contains "$out" "pass:world restore"
    assert_contains "$out" "ladder=1 holds=0"
    assert_contains "$out" "record=base.invalid 8001 10.0.0.9 j22-run24"

    # A failed rollback escalates to the deterministic restage: the
    # stale checkpoint is dropped, the world rebuilt, re-checkpointed.
    out="$(_source_survey "$root" "$run" '
        CALLS="" STAGED=0 CKPT=0
        itf_qm() {
            case "$*" in
                *"listsnapshot 8001"*)
                    printf "\x60-> world-staged  today  1.5 GiB\n"
                    printf "\x60-> current  You are here!\n" ;;
                *delsnapshot*) CALLS+="delsnap:$4;" ;;
                *rollback*) CALLS+="rollback:$4;"; return 1 ;;
            esac
            return 0
        }
        itf_guest_stop() { return 0; }
        itf_guest_start() { return 0; }
        itf_guest_ip() { echo "10.0.0.9"; return 0; }
        itf_wait_ssh() { return 0; }
        itf_guest_exec() { return 0; }
        _survey_scratch_destroy() { CALLS+="scratch-destroy;"; return 0; }
        itf_survey_stage_world() { STAGED=1; return 0; }
        _survey_world_checkpoint() { CKPT=1; return 0; }
        _survey_world_restore
        echo "rc=$?"
        echo "calls=$CALLS"
        echo "staged=$STAGED ckpt=$CKPT"
        echo "steps=$_steps"
    ')"
    assert_contains "$out" "rc=0"
    assert_contains "$out" "fail:world restore"
    assert_contains "$out" "pass:world restage"
    assert_contains "$out" "staged=1 ckpt=1"
    assert_contains "$out" "delsnap:world-staged;"
    assert_contains "$out" "scratch-destroy;"
    test_pass
}

