test_archive_size_helpers() {
    test_start "archive_size_bytes / archive_size_human parse and humanize"

    # The engine is a sourced library of function definitions only.
    # shellcheck source=lib/archive-engine.sh
    source "$mydir/lib/archive-engine.sh"

    # <zfs size value>|<expected bytes>; -1 marks an unparseable value.
    # "1.08G"/"2.05T" pin the base-10 decimal law (zfs prints leading
    # zeros; bare bash arithmetic would read "08" as invalid octal);
    # "9E"/"10E" pin the 64-bit wraparound guard.
    local -a byte_cases=(
        "10G|10737418240" "1.50M|1572864" "512K|524288" "1024|1024"
        "3t|3298534883328" "1.5g|1610612736" "2MiB|2097152" "7b|7"
        "1.08G|1159641169" "2.05T|2253998836940" "08G|8589934592"
        "|-1" "abc|-1" "10X|-1" "1.2.3G|-1" "-|-1" "9E|-1" "10E|-1"
    )
    # <bytes>|<expected zfs-style size> ("2T" pins tenths-truncation).
    local -a human_cases=(
        "10737418240|10G" "1572864|1.5M" "524288|512K" "512|512B"
        "1536|1.5K" "3298534883328|3T" "0|0B" "2223697212621|2T"
    )
    local case_row got failures=""
    for case_row in "${byte_cases[@]}"; do
        got=$(archive_size_bytes "${case_row%%|*}") || true
        [[ "$got" == "${case_row##*|}" ]] \
            || failures+="bytes('${case_row%%|*}') = ${got}," \
                " want ${case_row##*|}\n"
    done
    for case_row in "${human_cases[@]}"; do
        got=$(archive_size_human "${case_row%%|*}") || true
        [[ "$got" == "${case_row##*|}" ]] \
            || failures+="human(${case_row%%|*}) = ${got}," \
                " want ${case_row##*|}\n"
    done

    if [[ -n "$failures" ]]; then
        test_fail "size helper mismatches:\n${failures}"
        return
    fi
    test_pass
}

