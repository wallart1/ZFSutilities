    for target in iqn.2026-02.local.stewie:threeamigos iqn.2026-02.local.stewie:nvme1; do
        if [[ "$tc" != *"/iscsi create ${target}"* ]]; then
            test_fail "target not created: ${target}; targetcli log:\n$tc"
            return
        fi
        if [[ "$tc" != *"/iscsi/${target}/tpg1 set attribute authentication=0"* ]] \
            || [[ "$tc" != *"/iscsi/${target}/tpg1 set attribute demo_mode_write_protect=0"* ]] \
            || [[ "$tc" != *"/iscsi/${target}/tpg1/portals create 192.168.100.1:3260"* ]] \
            || [[ "$tc" != *"/iscsi/${target}/tpg1 set attribute generate_node_acls=1"* ]]; then
            test_fail "create recipe incomplete for ${target}; targetcli log:\n$tc"
            return
        fi
        if ! printf '%s\n' "$out" | grep -q "Created iSCSI target ${target}"; then
            test_fail "no creation INFO for ${target}; output:\n$out"
            return
        fi
    done

    # Step 4 discovered the portal and logged in to both mapped targets.
    local adm
    adm=$(printf '%s\n' "$out" | grep '^ISCSIADM:')
    if [[ "$adm" != *"-m discovery -t sendtargets -p 192.168.100.1:3260"* ]]; then
        test_fail "no discovery in Step 4; iscsiadm log:\n$adm"
        return
    fi
    for target in iqn.2026-02.local.stewie:threeamigos iqn.2026-02.local.stewie:nvme1; do
        if [[ "$adm" != *"-m node -T ${target} --login"* ]]; then
            test_fail "no login for ${target}; iscsiadm log:\n$adm"
            return
        fi
    done

    test_pass
}

