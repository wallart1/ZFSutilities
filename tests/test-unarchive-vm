test_restore_hashes_source_in_flight() {
    reset_unretire_mocks
    test_start "Restore copy: source hashed in flight, destination read back once"

    _mock_orig_vmid="904"
    _mock_read_response="
y"
    local pve_dir="$_mock_zfs_state_dir/pve_inflight"
    local archive="$_mock_zfs_state_dir/archive_inflight"
    mkdir -p "$pve_dir"
    setup_archive "$archive" "904" "$pve_dir" copy

    local out rc
    out=$(run_unarchive "$pve_dir" "$archive" 904)
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    local arc="${archive}/threeamigos/proxmox/vm-904-disk-0"
    local tee_count stdin_sha src_sha dst_sha
    # Exactly one tee fan-out: the copy pipeline's hash side-channel.
    tee_count=$(printf '%s\n' "$out" | grep -c '^TEE:')
    if [[ "$tee_count" -ne 1 ]]; then
        test_fail "Expected one in-flight hash fan-out, saw ${tee_count}; output:\n$out"
        return
    fi
    # The source is hashed from the stream (stdin form), never re-read as
    # a file; the only file-argument hash read names the destination.
    local arc_sha_line="SHA256:/dev/zvol/${arc}@snap1"
    local dst_sha_line="SHA256:/dev/zvol/threeamigos/proxmox/vm-904-disk-0"
    stdin_sha=$(printf '%s\n' "$out" | grep -cxF -- 'SHA256:')
    src_sha=$(printf '%s\n' "$out" | grep -cF -- "$arc_sha_line")
    dst_sha=$(printf '%s\n' "$out" | grep -cF -- "$dst_sha_line")
    if [[ "$stdin_sha" -ne 1 || "$src_sha" -ne 0 || "$dst_sha" -ne 1 ]]; then
        local hash_fail_msg="Hash reads wrong: stdin=${stdin_sha} src=${src_sha}"
        hash_fail_msg+=" dst=${dst_sha}; output:\n$out"
        test_fail "$hash_fail_msg"
        return
    fi
    if [[ "$out" != *"✓ Copy verified (sha256 match)"* ]]; then
        test_fail "Copy verification missing; output:\n$out"
        return
    fi

    test_pass
}

