test_list_shows_archived_vms() {
    reset_unretire_mocks
    test_start "--list shows every archived VM with name, disks, and sizes"

    _mock_orig_vmid="904"
    local pve_dir="$_mock_zfs_state_dir/pve_list"
    local archive="$_mock_zfs_state_dir/archive_list"
    mkdir -p "$pve_dir"
    # Two archived VMs: 904 (staged by the harness defaults) and 1005 on
    # the same pool, staged as files here and as a dataset via the knob.
    setup_archive "$archive" "904" "$pve_dir"
    setup_archive "$archive" "1005" "$pve_dir"
    sed -i 's/^name: test-vm$/name: second-vm/' "${archive}${pve_dir}/1005.conf"
    _mock_extra_archived_zvols="${archive}/threeamigos/proxmox/vm-1005-disk-0|4G"

    local out rc
    out=$(run_unarchive "$pve_dir" "$archive" --list)
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"=== Archived VMs under ${archive} ==="* ]]; then
        test_fail "Listing header missing; output:\n$out"
        return
    fi
    local vm904_line="VM 904 — test-vm — 1 disk, 10G total"
    local vm1005_line="VM 1005 — second-vm — 1 disk, 4G total"
    if [[ "$out" != *"$vm904_line"* || "$out" != *"$vm1005_line"* ]]; then
        test_fail "VM summary lines missing; want '${vm904_line}' and"
        test_fail "'${vm1005_line}'; output:\n$out"
        return
    fi
    if [[ "$out" != *"threeamigos/proxmox/vm-904-disk-0  10G"* ]] \
        || [[ "$out" != *"threeamigos/proxmox/vm-1005-disk-0  4G"* ]]; then
        test_fail "Disk lines missing; output:\n$out"
        return
    fi
    # Numeric vmid order: 904 must precede 1005 (lexical order flips them).
    local line904 line1005
    line904=$(printf '%s\n' "$out" | grep -nF "VM 904 — test-vm" \
        | head -1 | cut -d: -f1)
    line1005=$(printf '%s\n' "$out" | grep -nF "VM 1005 — second-vm" \
        | head -1 | cut -d: -f1)
    if [[ -z "$line904" || -z "$line1005" || "$line904" -ge "$line1005" ]]; then
        test_fail "VM order not numeric (904 must precede 1005); output:\n$out"
        return
    fi
    # Listing is read-only: no rate prompt, no restore actions.
    if [[ "$out" == *"Transfer rate limit"* ]]; then
        test_fail "Listing prompted for a rate; output:\n$out"
        return
    fi
    if [[ "$out" == *"CREATE:"* || "$out" == *"DD:"* || "$out" == *"RECEIVE:"* ]]; then
        test_fail "Listing performed restore actions; output:\n$out"
        return
    fi

    test_pass
}

