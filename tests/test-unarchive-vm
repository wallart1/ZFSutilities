#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# SC2128/SC2178: inside run_unarchive's zfs() mock, shellcheck cannot see
# test-lib.sh's `declare -gA _mock_zfs_datasets` (unfollowable source) and
# misinfers the scalar subscript variable _ds as an array.
# shellcheck disable=SC2128,SC2178
# test-unarchive-vm — Unit tests for unarchive-vm new-VMID support.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

setup_node_config() {
    NODE_CONF_FILE="$_mock_zfs_state_dir/node.conf"
    if [[ "${_mock_two_node:-}" == "1" ]]; then
        # Bash-format two-node conf, deliberately matching production shape
        # (declare -A POOL_TARGET), with both hosts resolving to the local
        # stub hostname so on_storage/on_compute take their local branches.
        # _mock_iqn_prefix stages a conf prefix that differs from the live
        # target tree (IQN-prefix drift scenarios).
        cat > "$NODE_CONF_FILE" << EOF
NODE_MODE="two-node"

STORAGE_HOST="zteststor"
COMPUTE_HOST="zteststor"

STORAGE_IP="192.168.100.1"

IQN_PREFIX="${_mock_iqn_prefix:-iqn.2026-02.local.stewie}"

declare -A POOL_TARGET=(
    [threeamigos]="threeamigos"
    [NVME1]="nvme1"
)
EOF
    else
        cat > "$NODE_CONF_FILE" << 'EOF'
NODE_MODE=single-node
EOF
    fi
    export NODE_CONF="$NODE_CONF_FILE"
}

# Provide a mock lock manager so tests do not require root or a writable
# /run/lock/zfsutilities directory. ZFSUTILITIES_BIN_DIR ensures source_helper
# resolves the mock before the deployed real helper.
_unarchive_vm_lock_dir=$(mktemp -d)
cat > "$_unarchive_vm_lock_dir/zfslockmanager" <<'EOF'
zfslock_init() { true; }
zfslock_acquire() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_wait_or_resolve() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF
export ZFSUTILITIES_BIN_DIR="$_unarchive_vm_lock_dir"

setup_archive() {
    local archive_base="$1"
    local vmid="$2"
    local pve_dir="${3:-/etc/pve/qemu-server}"
    local method="${4:-}"

    mkdir -p "${archive_base}${pve_dir}"
    mkdir -p "$archive_base/threeamigos/proxmox"

    # Archived zvol dataset path (under archive base)
    local arc_dataset="${archive_base}/threeamigos/proxmox/vm-${vmid}-disk-0"

    # Sidecar files keyed by the original zvol path. A METHOD= line marks
    # archives made by the hybrid engine; unmarked archives are legacy
    # raw send/receive archives.
    echo "8K" > "${archive_base}/threeamigos/proxmox/vm-${vmid}-disk-0.original_volblocksize"
    echo "DISK_KEY=scsi0" > "${archive_base}/threeamigos/proxmox/vm-${vmid}-disk-0.disk_info"
    if [[ -n "$method" ]]; then
        echo "METHOD=${method}" >> "${archive_base}/threeamigos/proxmox/vm-${vmid}-disk-0.disk_info"
    fi

    # Two-node staging: a second disk on another mapped pool (NVME1), with
    # iSCSI-form disk lines in the archived config — the form Step 3 rewrites
    # LUN-by-LUN on the compute host.
    local scsi0_line="scsi0: threeamigos:vm-${vmid}-disk-0,size=10G"
    local scsi3_line=""
    if [[ "${_mock_two_node:-}" == "1" ]]; then
        mkdir -p "${archive_base}/NVME1/proxmox"
        echo "16K" > "${archive_base}/NVME1/proxmox/vm-${vmid}-disk-3.original_volblocksize"
        {
            echo "DISK_KEY=scsi3"
            [[ -n "$method" ]] && echo "METHOD=${method}"
        } > "${archive_base}/NVME1/proxmox/vm-${vmid}-disk-3.disk_info"
        scsi0_line="scsi0: /dev/disk/by-path/ip-192.168.100.1:3260-iscsi-\
iqn.2026-02.local.stewie:threeamigos-lun-4,format=raw,discard=on,\
iothread=1,size=10G"
        scsi3_line="scsi3: /dev/disk/by-path/ip-192.168.100.1:3260-iscsi-\
iqn.2026-02.local.stewie:nvme1-lun-2,format=raw,discard=on,\
iothread=1,size=350G"
    fi

    # Archived Proxmox config (mirrors the PVE_CONF_DIR layout)
    {
        echo "name: test-vm"
        echo "$scsi0_line"
        [[ -n "$scsi3_line" ]] && echo "$scsi3_line"
        echo "vmgenid: 11111111-1111-1111-1111-111111111111"
        echo "smbios1: uuid=22222222-2222-2222-2222-222222222222"
    } > "${archive_base}${pve_dir}/${vmid}.conf"
}

# Run unarchive-vm in a subshell so an exit/die does not kill the test harness.
run_unarchive() {
    local pve_dir="$1"
    local archive_base="$2"
    shift 2
    local vmid="$1"
    shift
    # --list in the vmid position switches the harness to listing mode: the
    # mock staging below still keys on _mock_orig_vmid, but the script is
    # invoked with only --list (plus any extra args, e.g. a base argument).
    local list_mode=0
    if [[ "$vmid" == "--list" ]]; then
        list_mode=1
        vmid="${_mock_orig_vmid}"
    fi
    local stdin_input="${_mock_read_response:-}"
    local capture_dir="$_mock_zfs_state_dir/capture"
    mkdir -p "$capture_dir"
    rm -f "$capture_dir/zfs-argv" "$capture_dir/pace" "$capture_dir/dd" \
        "$capture_dir/tee" "$capture_dir/sha256" "$capture_dir/pv" \
        "$capture_dir/targetcli" "$capture_dir/ssh" "$capture_dir/iscsiadm" \
        "$capture_dir/iscsi-luns"
    rm -f "$capture_dir"/bs.*
    # Live-target registry for the targetcli stub: by default the
    # conf-constructed targets exist (the legacy "targets present"
    # semantics); _mock_live_targets overrides (empty = bare tree).
    if [[ "${_mock_two_node:-}" == "1" ]]; then
        local live_targets="${_mock_live_targets:-}"
        if [[ -z "${_mock_live_targets+x}" ]]; then
            live_targets=$'iqn.2026-02.local.stewie:threeamigos\niqn.2026-02.local.stewie:nvme1'
        fi
        if [[ -n "$live_targets" ]]; then
            printf '%s\n' "$live_targets" > "$capture_dir/iscsi-targets"
        else
            : > "$capture_dir/iscsi-targets"
        fi
    fi
    (
        source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
        setup_test_env
        setup_node_config
        # Real-ZFS send dry-run size for the progress display's -s total
        # (test-lib's re-source resets _mock_zfs_send_size, so the knob
        # lands through this separate name).
        _mock_zfs_send_size="${_mock_archive_send_size:-10737418240}"
        export PVE_CONF_DIR="$pve_dir"

        # Allow the script to run without root in the test harness, and
        # redirect the deployed node-lib path to the repository copy so tests
        # work without deployment.
        export UNARCHIVE_VM_TEST_NO_ROOT=1
        export NODE_LIB="$mydir/lib/node-lib.sh"
        export ARCHIVE_ENGINE_LIB="$mydir/lib/archive-engine.sh"
        export JSON_CONFIG="$_mock_zfs_state_dir/zfsutilities.json"
        # Empty JSON config per run: the state dir is shared across tests,
        # and a rate limit saved by an earlier test must not leak in.
        # Listing mode seeds archive_path so the no-argument --list form
        # resolves the staged base as the saved default.
        if [[ "$list_mode" == "1" ]]; then
            printf '{"archive_path": "%s"}\n' "$archive_base" > "$JSON_CONFIG"
        else
            printf '{}\n' > "$JSON_CONFIG"
        fi
        export _capture_dir="$capture_dir"
        export _mock_hash_dst="${_mock_hash_dst:-}"
        export _mock_sha_fail="${_mock_sha_fail:-}"

        # Mock zfs state. _mock_empty_archive stages the base dataset with
        # no archived zvols (the empty-listing shape).
        local arc_dataset="${archive_base}/threeamigos/proxmox/vm-${_mock_orig_vmid}-disk-0"
        _mock_zfs_fs_list="${archive_base}"
        _mock_zfs_datasets["${archive_base}"]=1
        _mock_zfs_props["${archive_base}:mountpoint"]="${archive_base}"
        if [[ "${_mock_empty_archive:-}" != "1" ]]; then
            _mock_zfs_fs_list="${_mock_zfs_fs_list}
${arc_dataset}"
            _mock_zfs_props["threeamigos/proxmox/vm-${_mock_orig_vmid}-disk-0:volblocksize"]="8K"
            _mock_zfs_props["${arc_dataset}:volsize"]="10G"
            _mock_zfs_props["${arc_dataset}:snapdev"]="hidden"
            _mock_zfs_snap_lists["${arc_dataset}"]="${arc_dataset}@snap1"
        fi

        # Extra archived zvols for multi-VM listing tests: newline-separated
        # "dataset|volsize" rows (volsize "-" registers the dataset only).
        if [[ -n "${_mock_extra_archived_zvols:-}" ]]; then
            local _row _ds _vs
            while IFS= read -r _row; do
                [[ -n "$_row" ]] || continue
                _ds="${_row%%|*}"
                _vs="${_row#*|}"
                _mock_zfs_datasets["$_ds"]=1
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$_ds"
                [[ -n "$_vs" && "$_vs" != "-" ]] \
                    && _mock_zfs_props["${_ds}:volsize"]="$_vs"
            done <<< "$_mock_extra_archived_zvols"
        fi

        # Record engine zfs/cp/hash activity; creations register datasets
        # and their creation properties, like real zfs.
        eval "_test_lib_zfs() $(declare -f zfs | tail -n +2)"
        zfs() {
            case "$1" in
                create|destroy|set|send|receive)
                    echo "${1^^}:$*" >> "$_capture_dir/zfs-argv"
                    ;;
            esac
            if [[ "$1" == "create" ]]; then
                local -a _cargv=("$@")
                local _ds="${_cargv[-1]}"
                _mock_zfs_datasets["$_ds"]=1
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$_ds"
                return 0
            fi
            if [[ "$1" == "destroy" ]]; then
                local -a _dargv=("$@")
                local _ds="${_dargv[-1]}"
                unset '_mock_zfs_datasets[$_ds]' 2>/dev/null || true
                _mock_zfs_fs_list=$(printf '%s\n' "$_mock_zfs_fs_list" \
                    | grep -vxF -- "$_ds") || true
                return 0
            fi
            if [[ "$1" == "set" || "$1" == "receive" ]]; then
                return 0
            fi
            if [[ "$1" == "send" ]]; then
                # A -n anywhere in the options is the size probe for the
                # progress display; real zfs prints the stream size.
                local _sarg
                for _sarg in "$@"; do
                    case "$_sarg" in
                        -n*) printf 'size\t%s\n' "$_mock_zfs_send_size" ;;
                    esac
                done
                return 0
            fi
            _test_lib_zfs "$@"
        }
        cp() {
            echo "CP:$*" >> "$_capture_dir/zfs-argv"
            if [[ -e "$1" ]]; then
                command cp "$@"
            fi
            return 0
        }
        sync() {
            echo "SYNC:$*" >> "$_capture_dir/zfs-argv"
        }
        sha256sum() {
            echo "SHA256:$*" >> "$_capture_dir/sha256"
            if [[ $# -eq 0 ]]; then
                # Stdin form: the in-flight source hash (from the fifo) or
                # the paced destination read-back. Draining stdin first
                # keeps the pipeline alive so _mock_sha_fail exercises
                # the post-copy hash-failure branch, not a SIGPIPE abort.
                cat > /dev/null
                [[ -z "${_mock_sha_fail:-}" ]] || return 1
                printf '%s  -\n' "deadbeef12345678"
                return 0
            fi
            # File-arg form: the unpaced destination read-back; the
            # _mock_hash_dst knob makes the digest differ.
            printf '%s  %s\n' \
                "${_mock_hash_dst:-deadbeef12345678}" "$1"
            return 0
        }
        tee() {
            # In-flight hash fan-out: passthrough, argv recorded.
            echo "TEE:$*" >> "$_capture_dir/tee"
            command tee "$@"
        }
        python3() {
            # Pacer stage (lib/pace_stream.py), argv recorded after the
            # interpreter script path. Only pacer invocations are
            # intercepted; every other python3 caller in the harness
            # (JSON config readers, sidecar helpers) runs for real. A
            # read-head call (-- <src>) takes its input from the named
            # device — which never exists in the harness, so nothing is
            # produced (the same no-copy semantics the cp mock has always
            # had). A call without -- is a mid-pipeline pacing segment and
            # passes stdin through. Neither form may touch the script's
            # stdin: the read head is the first pipeline stage, and its
            # stdin is the interactive answer feed.
            if [[ "${1:-}" != *pace_stream.py ]]; then
                command python3 "$@"
                return $?
            fi
            echo "PACE:${*:2}" >> "$_capture_dir/pace"
            # Real-CLI contract (pace_stream.py main): <rate> [--] [file] —
            # one to three words after the script, a third only behind
            # "--". The real pacer answers anything else with usage and
            # rc 2, so a pipeline that splices the next stage's words onto
            # the pacer segment must die here as it does in production.
            local -a _pacer_words=("${@:2}")
            if [[ ${#_pacer_words[@]} -lt 1 || ${#_pacer_words[@]} -gt 3 ]] \
                || [[ ${#_pacer_words[@]} -eq 3 && "${_pacer_words[1]}" != "--" ]]; then
                echo "usage: pace_stream.py <rate> [--] [file]" >&2
                return 2
            fi
            local -a _pyargv=("$@") _pi
            for _pi in "${!_pyargv[@]}"; do
                if [[ "${_pyargv[$_pi]}" == "--" ]]; then
                    [[ -e "${_pyargv[$((_pi + 1))]}" ]] \
                        && cat -- "${_pyargv[$((_pi + 1))]}"
                    return 0
                fi
            done
            cat
        }
        dd() {
            # Device-copy reader/writer, argv recorded. A reader with a
            # named input (if=<src>) reads that device — which never
            # exists in the harness, so nothing is produced and, like the
            # read-head pv, the script's stdin is never consumed. A writer
            # (of=) consumes the stream arriving on the pipe.
            echo "DD:$*" >> "$_capture_dir/dd"
            local _darg
            for _darg in "$@"; do
                if [[ "$_darg" == if=* ]]; then
                    [[ -e "${_darg#if=}" ]] && cat -- "${_darg#if=}"
                    return 0
                fi
            done
            cat > /dev/null
            return 0
        }
        pv() {
            # Progress display stage (archive_pv_args), argv recorded. A
            # display stage must never alter the data flow: the stream
            # form passes stdin through, and the file-operand form (the
            # unpaced verify read-back) reads the named device — which
            # never exists in the harness, so nothing is produced, the
            # same law as the dd reader. -B and -s take a value word.
            echo "PV:$*" >> "$_capture_dir/pv"
            local -a _pvargv=("$@")
            local _pvi _pvfile=""
            for ((_pvi = 0; _pvi < ${#_pvargv[@]}; _pvi++)); do
                case "${_pvargv[$_pvi]}" in
                    -B|-s) ((++_pvi)) ;;
                    -*) ;;
                    *) _pvfile="${_pvargv[$_pvi]}" ;;
                esac
            done
            if [[ -n "$_pvfile" ]]; then
                [[ -e "$_pvfile" ]] && cat -- "$_pvfile"
                return 0
            fi
            cat
        }

        # Two-node staging. Storage and compute both resolve to the stub
        # hostname so on_storage/on_compute take their local branches with
        # these mocks visible; the raw ssh probes the orchestrator makes
        # directly against the storage host are answered below. The stub
        # bin dir keeps the payload's own resolutions (bashinit, engine,
        # lock manager, safe-iscsi-save, rescan-storage) inside the harness.
        if [[ "${_mock_two_node:-}" == "1" ]]; then
            _two_node_stub_dir="$_mock_zfs_state_dir/twonode-bin"
            mkdir -p "$_two_node_stub_dir"
            cp "${ZFSUTILITIES_BIN_DIR}/zfslockmanager" "$_two_node_stub_dir/"
            ln -sf "$mydir/bin/bashinit" "$_two_node_stub_dir/bashinit"
            ln -sf "$mydir/lib/archive-engine.sh" \
                "$_two_node_stub_dir/archive-engine.sh"
            printf '#!/usr/bin/bash\nexit 0\n' > "$_two_node_stub_dir/safe-iscsi-save"
            printf '#!/usr/bin/bash\nexit 0\n' > "$_two_node_stub_dir/rescan-storage"
            chmod +x "$_two_node_stub_dir/safe-iscsi-save" \
                "$_two_node_stub_dir/rescan-storage"
            export ZFSUTILITIES_BIN_DIR="$_two_node_stub_dir"

            hostname() {
                if [[ "$1" == "-s" ]]; then
                    echo "zteststor"
                else
                    command hostname "$@"
                fi
            }

            # Answers the orchestrator's direct storage-host probes by running
            # the same operation locally against the mock state. Unhandled
            # commands fail loudly so a new probe shape cannot pass silently.
            # (The calls carry -n; the remote command is the last argv entry.)
            ssh() {
                local cmd="${*: -1}"
                echo "SSH:$cmd" >> "$_capture_dir/ssh"
                local plain="${cmd//\'/}"
                local ds f marker
                case "$plain" in
                    "zfs list -H -o name "*)
                        ds="${plain#zfs list -H -o name }"
                        ds="${ds%% *}"
                        zfs list -H -o name "$ds" 2>/dev/null | grep -qxF -- "$ds"
                        return $?
                        ;;
                    "zfs get -H -o value mountpoint "*)
                        ds="${plain#zfs get -H -o value mountpoint }"
                        ds="${ds%% *}"
                        zfs get -H -o value mountpoint "$ds"
                        return $?
                        ;;
                    "grep -qxF -- "*)
                        # zvol_marked_restored: "<marker> <info-file> 2>/dev/null"
                        marker="${plain#grep -qxF -- }"
                        f="${marker#* }"
                        marker="${marker%% *}"
                        f="${f%% *}"
                        grep -qxF -- "$marker" "$f" 2>/dev/null
                        return $?
                        ;;
                    "[[ -f "*"]]")
                        f="${plain#'[[' -f }"
                        f="${f% ]]*}"
                        f="${f% ]}"
                        [[ -f "$f" ]]
                        return $?
                        ;;
                    "cat "*)
                        f="${plain#cat }"
                        f="${f%% *}"
                        [[ -f "$f" ]] && cat "$f"
                        return 0
                        ;;
                    "grep ^DISK_KEY="*)
                        f="${plain#grep ^DISK_KEY= }"
                        f="${f%% *}"
                        grep '^DISK_KEY=' "$f" 2>/dev/null | cut -d= -f2
                        return $?
                        ;;
                    *)
                        echo "SSH-UNHANDLED:$plain" >> "$_capture_dir/ssh"
                        return 1
                        ;;
                esac
            }

            # Stateful targetcli: backstore markers, a per-target LUN
            # table, and a live-target registry (seeded by run_unarchive);
            # ls output uses the row shape the payload greps
            # ("block/<name> " then lun<N>).
            targetcli() {
                echo "TARGETCLI:$*" >> "$_capture_dir/targetcli"
                local lun_table="$_capture_dir/iscsi-luns"
                local b t n l row
                case "$1 $2" in
                    "/backstores/block ls")
                        for b in "$_capture_dir"/bs.*; do
                            [[ -e "$b" ]] || continue
                            printf '  %s /dev/zvol/x\n' "${b##*/bs.}"
                        done
                        return 0
                        ;;
                    "/backstores/block create")
                        : > "$_capture_dir/bs.$3"
                        return 0
                        ;;
                    "/iscsi ls")
                        # Live-target registry rows in the shape targetcli
                        # prints (the payload's grep -o 'iqn.*' extracts).
                        if [[ -s "$_capture_dir/iscsi-targets" ]]; then
                            echo "o- iscsi ... [Targets: N]"
                            while IFS= read -r t; do
                                [[ -n "$t" ]] || continue
                                printf '  o- %s ... [TPGs: 1]\n' "$t"
                            done < "$_capture_dir/iscsi-targets"
                        fi
                        return 0
                        ;;
                    "/iscsi create")
                        echo "$3" >> "$_capture_dir/iscsi-targets"
                        return 0
                        ;;
                    "/iscsi/"*"/tpg1 get")
                        # Fresh TPGs report explicit-ACL mode, so the
                        # payload's create recipe flips generate_node_acls.
                        if [[ "$3" == "attribute" \
                            && "$4" == "generate_node_acls" ]]; then
                            echo "generate_node_acls=0"
                        fi
                        return 0
                        ;;
                    "/iscsi/"*"/tpg1/luns ls")
                        [[ -f "$lun_table" ]] || return 0
                        while IFS='|' read -r t n l; do
                            [[ "$t" == "$1" ]] || continue
                            printf '  %s block/%s x\n' "$l" "$n"
                        done < "$lun_table"
                        return 0
                        ;;
                    "/iscsi/"*"/tpg1/luns create")
                        : >> "$lun_table"
                        n="${3##*/}"
                        row=$(grep -cF -- "$1|" "$lun_table" 2>/dev/null) || row=0
                        echo "$1|$n|lun${row}" >> "$lun_table"
                        return 0
                        ;;
                    *)
                        return 0
                        ;;
                esac
            }

            # Step 4's discovery/login calls, captured for assertions.
            iscsiadm() {
                echo "ISCSIADM:$*" >> "$_capture_dir/iscsiadm"
                return 0
            }

            # Archive-side mock state for the NVME1 disk-3 dataset, mirroring
            # the threeamigos disk-0 registration above.
            local _arc_ds3="${archive_base}/NVME1/proxmox/vm-${_mock_orig_vmid}-disk-3"
            _mock_zfs_fs_list="${_mock_zfs_fs_list}
${_arc_ds3}"
            _mock_zfs_datasets["$_arc_ds3"]=1
            _mock_zfs_props["NVME1/proxmox/vm-${_mock_orig_vmid}-disk-3:volblocksize"]="16K"
            _mock_zfs_props["${_arc_ds3}:volsize"]="350G"
            _mock_zfs_props["${_arc_ds3}:snapdev"]="hidden"
            _mock_zfs_snap_lists["$_arc_ds3"]="${_arc_ds3}@snap1"
        fi

        # Conflict state.
        if [[ "${_mock_old_config_present:-}" == "1" ]]; then
            touch "${pve_dir}/${_mock_orig_vmid}.conf"
        fi
        # Orphaned zvols elsewhere on the host (backup-chain copies keep the
        # VM-disk naming under another pool): visible in the pool listing,
        # never at this archive's destinations.
        if [[ -n "${_mock_orphan_zvols:-}" ]]; then
            local _orphan
            while IFS= read -r _orphan; do
                [[ -n "$_orphan" ]] || continue
                _mock_zfs_datasets["$_orphan"]=1
                _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$_orphan"
            done <<< "$_mock_orphan_zvols"
        fi

        # Resume state: a destination zvol that already exists, optionally
        # carrying the RESTORED_AS completion marker in the sidecar.
        if [[ "${_mock_dest_zvol_present:-}" == "1" ]]; then
            local dest_zvol="threeamigos/proxmox/vm-${vmid}-disk-0"
            _mock_zfs_datasets["$dest_zvol"]=1
            _mock_zfs_fs_list="${_mock_zfs_fs_list}"$'\n'"$dest_zvol"
            if [[ "${_mock_dest_zvol_marked:-}" == "1" ]]; then
                echo "RESTORED_AS=vm-${vmid}-disk-0" \
                    >> "${archive_base}/threeamigos/proxmox/vm-${_mock_orig_vmid}-disk-0.disk_info"
            fi
        fi

        # Optional explicit destination conflict for the new VMID.
        if [[ "${_mock_new_config_present:-}" == "1" ]]; then
            touch "${pve_dir}/${_mock_new_vmid}.conf"
        fi

        if [[ "$list_mode" == "1" ]]; then
            set -- --list "$@"
        else
            set -- "$vmid" "$archive_base" "$@"
        fi
        source "$mydir/bin/unarchive-vm"
    ) <<< "$stdin_input" 2>&1
    local rc=$?
    cat "$capture_dir/zfs-argv" 2>/dev/null || true
    cat "$capture_dir/pace" 2>/dev/null || true
    cat "$capture_dir/dd" 2>/dev/null || true
    cat "$capture_dir/tee" 2>/dev/null || true
    cat "$capture_dir/sha256" 2>/dev/null || true
    cat "$capture_dir/pv" 2>/dev/null || true
    cat "$capture_dir/targetcli" 2>/dev/null || true
    cat "$capture_dir/ssh" 2>/dev/null || true
