test_copy_method_restores_reblocked() {
    reset_unretire_mocks
    test_start "METHOD=copy: restore reblocks back to the original volblocksize"

    _mock_orig_vmid="904"
    _mock_read_response="y"
    local pve_dir="$_mock_zfs_state_dir/pve7"
    local archive="$_mock_zfs_state_dir/archive7"
    mkdir -p "$pve_dir"
    setup_archive "$archive" "904" "$pve_dir" copy

    local out rc
    out=$(run_unarchive "$pve_dir" "$archive" 904)
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"Restore method: copy (reblock to 8K)"* ]]; then
        test_fail "Copy restore method not reported; output:\n$out"
        return
    fi
    local _create_line="CREATE:create -s -V 10G -o volblocksize=8K"
    _create_line="${_create_line} threeamigos/proxmox/vm-904-disk-0"
    if [[ "$out" != *"${_create_line}"* ]]; then
        test_fail "Restored zvol not created thin at the sidecar volblocksize; output:\n$out"
        return
    fi
    local arc="${archive}/threeamigos/proxmox/vm-904-disk-0"
    local _cp_line="CP:--sparse=always /dev/zvol/${arc}@snap1"
    _cp_line="${_cp_line} /dev/zvol/threeamigos/proxmox/vm-904-disk-0"
    if [[ "$out" != *"${_cp_line}"* ]]; then
        test_fail "Device copy from the archive snapshot not recorded; output:\n$out"
        return
    fi
    if [[ "$out" == *"RECEIVE:"* ]]; then
        test_fail "Raw receive used for a copy-method archive; output:\n$out"
        return
    fi
    if [[ "$out" != *"✓ Copy verified (sha256 match)"* ]]; then
        test_fail "Restore copy verification missing; output:\n$out"
        return
    fi

    test_pass
}

