test_rate_limit_paces_raw_restore() {
    reset_unretire_mocks
    test_start "Rate limit: raw restore runs through a standalone pacer stage"

    _mock_orig_vmid="904"
    _mock_read_response="100M
y"
    local pve_dir="$_mock_zfs_state_dir/pve_rawrate"
    local archive="$_mock_zfs_state_dir/archive_rawrate"
    mkdir -p "$pve_dir"
    setup_archive "$archive" "904" "$pve_dir" raw

    local out rc
    out=$(run_unarchive "$pve_dir" "$archive" 904)
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"Restore method: raw send/receive"* ]]; then
        test_fail "Raw restore method not reported; output:\n$out"
        return
    fi
    # The pacer is its own pipeline segment and gets the rate alone: the
    # real CLI takes <rate> [--] [file] and refuses anything spliced on
    # after it (usage, rc 2), which fails the whole transfer.
    local pace_count
    pace_count=$(printf '%s\n' "$out" | grep -cFx -- "PACE:100M")
    if [[ "$pace_count" -ne 1 ]]; then
        test_fail "Want one bare-rate pacer stage (saw ${pace_count}); output:\n$out"
        return
    fi
    if printf '%s\n' "$out" | grep -q '^PV:'; then
        test_fail "Display stage armed while headless; output:\n$out"
        return
    fi
    if [[ "$out" != *"RECEIVE:receive threeamigos/proxmox/vm-904-disk-0"* ]]; then
        test_fail "Paced stream never reached the receive; output:\n$out"
        return
    fi

    test_pass
}

