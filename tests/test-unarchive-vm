        test_fail "scsi0 not rewritten to the threeamigos target LUN 0: ${lun0_line}; output:\n$out"
        return
    fi
    if [[ "$lun3_line" != "scsi3: /dev/disk/by-path/ip-192.168.100.1:3260-iscsi-\
iqn.2026-02.local.stewie:nvme1-lun-0,format=raw,discard=on,\
iothread=1,size=350G" ]]; then
        test_fail "scsi3 not rewritten to the nvme1 target LUN 0: ${lun3_line}; output:\n$out"
        return
    fi

    # Step 2 must have created both backstores on their pool's target.
    local tc
    tc=$(printf '%s\n' "$out" | grep '^TARGETCLI:')
    if [[ "$tc" != *"/iscsi/iqn.2026-02.local.stewie:threeamigos/tpg1/luns create \
/backstores/block/vm-904-disk-0"* ]]; then
        test_fail "No LUN create on threeamigos target; targetcli log:\n$tc"
        return
    fi
    if [[ "$tc" != *"/iscsi/iqn.2026-02.local.stewie:nvme1/tpg1/luns create \
/backstores/block/vm-904-disk-3"* ]]; then
        test_fail "No LUN create on nvme1 target; targetcli log:\n$tc"
        return
    fi

    test_pass
}

