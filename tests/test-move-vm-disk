#!/usr/bin/bash
# shellcheck disable=SC1090,SC1091,SC2016,SC2034,SC2154
# test-move-vm-disk — Unit tests for move-vm-disk helper functions.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Extract simple helper functions from move-vm-disk.
# ------------------------------------------------------------------
old_mydir="$mydir"
func_text=$(sed -n '/^disk_num_from_key() {/,/^}$/p' "$old_mydir/bin/move-vm-disk" | head -20)
func_text+=$'\n'
func_text+=$(sed -n '/^auto_select_dst_key() {/,/^}$/p' "$old_mydir/bin/move-vm-disk" | head -30)
func_text+=$'\n'
func_text+=$(sed -n '/^_is_valid_vm_id() {/,/^}$/p' "$old_mydir/bin/move-vm-disk")
func_text+=$'\n'
func_text+=$(sed -n '/^_is_valid_disk_key() {/,/^}$/p' "$old_mydir/bin/move-vm-disk")
func_text+=$'\n'
func_text+=$(sed -n '/^write_state() {/,/^}$/p' "$old_mydir/bin/move-vm-disk")
func_text+=$'\n'
func_text+=$(sed -n '/^read_state() {/,/^}$/p' "$old_mydir/bin/move-vm-disk")
func_text+=$'\n'
eval "$func_text"

# Define the manifest helpers locally (they are simple one-liners in move-vm-disk).
manifest_remove() {
    [[ -f "$ISCSI_MANIFEST" ]] && grep -q "^${1}$" "$ISCSI_MANIFEST" \
        && sed -i "/^${1}$/d" "$ISCSI_MANIFEST"
}
manifest_add() {
    [[ -f "$ISCSI_MANIFEST" ]] && ! grep -q "^${1}$" "$ISCSI_MANIFEST" \
        && echo "$1" >> "$ISCSI_MANIFEST"
}
encrypted_remove() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] && grep -q "^${1}:" "$ISCSI_ENCRYPTED_CONF" \
        && sed -i "/^${1}:/d" "$ISCSI_ENCRYPTED_CONF"
}
encrypted_add() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] && ! grep -q "^${1}:" "$ISCSI_ENCRYPTED_CONF" \
        && echo "${1}:${2}:${3}" >> "$ISCSI_ENCRYPTED_CONF"
}

# ------------------------------------------------------------------
# Test helpers
# ------------------------------------------------------------------
setup_manifests() {
    ISCSI_MANIFEST="$_mock_zfs_state_dir/expected-backstores.txt"
    ISCSI_ENCRYPTED_CONF="$_mock_zfs_state_dir/iscsi-encrypted-luns.conf"
    echo "vm-100-disk-0" > "$ISCSI_MANIFEST"
    echo "vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos" \
        > "$ISCSI_ENCRYPTED_CONF"
}

# ------------------------------------------------------------------
# Bootstrap regression tests for storage-side heredocs.
# The heredocs previously used BASH_SOURCE[0] and failed under bash -s.
# ------------------------------------------------------------------

# Extract a specific SSHEOF-delimited heredoc by a unique content marker.
extract_heredoc_by_marker() {
    local marker="$1"
    awk '
        /cat <<.SSHEOF.$/ || /<< .SSHEOF.$/ { in_block=1; next }
        /^SSHEOF$/ {
            in_block=0
            if (block ~ marker) { printf "%s", block }
            block=""
            next
        }
        in_block { block = block $0 "\n" }
    ' marker="$marker" "$old_mydir/bin/move-vm-disk"
}

test_storage_move_heredoc_bootstrap() {
    test_start "storage_move heredoc avoids BASH_SOURCE[0] bootstrap"
    local bootstrap
    bootstrap=$(extract_heredoc_by_marker 'phase=teardown_done')
    if grep -q 'BASH_SOURCE\[0\]' <<< "$bootstrap"; then
        test_fail "storage_move heredoc still uses BASH_SOURCE[0] bootstrap"
        return
    fi
    if ! grep -q 'mydir=\$(realpath /usr/local/lib/zfsutilities/current/bin)' <<< "$bootstrap"; then
        test_fail "storage_move heredoc does not use deployed-path bootstrap"
        return
    fi
    test_pass
}

test_rollback_heredoc_bootstrap() {
    test_start "rollback heredoc avoids BASH_SOURCE[0] bootstrap"
    local bootstrap
    local marker="# Rename zvol back if it exists under the destination name"
    bootstrap=$(extract_heredoc_by_marker "$marker")
    if grep -q 'BASH_SOURCE\[0\]' <<< "$bootstrap"; then
        test_fail "rollback heredoc still uses BASH_SOURCE[0] bootstrap"
        return
    fi
    if ! grep -q 'mydir=\$(realpath /usr/local/lib/zfsutilities/current/bin)' <<< "$bootstrap"; then
        test_fail "rollback heredoc does not use deployed-path bootstrap"
        return
    fi
    test_pass
}

# Static guard for the 0.96.0-casing regression found (and fixed) on
# 2026-10-16: the storage-verification child reads ${pool}, so the ssh
# invocation must pass it as a third argument and the child must bind it.
# The suite has no two-node ssh mock, so the argument hand-off cannot be
# exercised behaviorally — the source scan is the fence that notices a
# dropped argument.
test_verification_child_receives_pool() {
    test_start "storage verification child receives the pool"
    local script="$old_mydir/bin/move-vm-disk"
    if ! grep -q 'bash -s "\$target" "\$srclun" "\$pool"' "$script"; then
        test_fail "verification ssh call no longer passes \$pool"
        return
    fi
    if ! grep -q '^pool="\$3"$' "$script"; then
        test_fail "verification child no longer binds pool from \$3"
        return
    fi
    test_pass
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_disk_num_from_key() {
    test_start "disk_num_from_key extracts numeric suffix"
    local num
    num=$(disk_num_from_key "scsi2")
    assert_equals "2" "$num"
}

test_disk_num_from_key_ide() {
    test_start "disk_num_from_key works for ide keys"
    local num
    num=$(disk_num_from_key "ide1")
    assert_equals "1" "$num"
}

test_auto_select_dst_key() {
    test_start "auto_select_dst_key picks next free scsi slot"
    srckey="scsi0"
    dst_conf="$_mock_zfs_state_dir/dst.conf"
    cat > "$dst_conf" << 'EOF'
scsi0: some-disk
EOF
    local key
    key=$(auto_select_dst_key)
    assert_equals "scsi1" "$key"
}

test_auto_select_dst_key_efidisk() {
    test_start "auto_select_dst_key handles efidisk0"
    srckey="efidisk0"
    dst_conf="$_mock_zfs_state_dir/dst-efi.conf"
    touch "$dst_conf"
    local key
    key=$(auto_select_dst_key)
    assert_equals "efidisk0" "$key"
}

test_manifest_remove() {
    setup_manifests
    test_start "manifest_remove removes backstore from expected-backstores"
    manifest_remove "vm-100-disk-0"
    if ! grep -q "^vm-100-disk-0$" "$ISCSI_MANIFEST"; then
        test_pass
    else
        test_fail "Backstore still in manifest"
    fi
}

test_manifest_add() {
    setup_manifests
    echo "" > "$ISCSI_MANIFEST"
    test_start "manifest_add adds backstore to expected-backstores"
    manifest_add "vm-100-disk-0"
    if grep -q "^vm-100-disk-0$" "$ISCSI_MANIFEST"; then
        test_pass
    else
        test_fail "Backstore not added to manifest"
    fi
}

test_encrypted_remove() {
    setup_manifests
    test_start "encrypted_remove removes backstore from encrypted-luns config"
    encrypted_remove "vm-100-disk-0"
    if ! grep -q "^vm-100-disk-0:" "$ISCSI_ENCRYPTED_CONF"; then
        test_pass
    else
        test_fail "Backstore still in encrypted config"
    fi
}

test_encrypted_add() {
    setup_manifests
    echo "" > "$ISCSI_ENCRYPTED_CONF"
    test_start "encrypted_add adds backstore to encrypted-luns config"
    encrypted_add "vm-100-disk-0" \
        "/dev/zvol/threeamigos/proxmox/vm-100-disk-0" \
        "threeamigos"
    if grep -q "^vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos" \
            "$ISCSI_ENCRYPTED_CONF"; then
        test_pass
    else
        test_fail "Backstore not added to encrypted config"
    fi
}

# ------------------------------------------------------------------
# Validation helper tests
# ------------------------------------------------------------------

test_is_valid_vm_id() {
    test_start "_is_valid_vm_id accepts numeric VM IDs"
    local id
    for id in 100 0 9999; do
        if ! _is_valid_vm_id "$id"; then
            test_fail "Expected '$id' to be accepted"
            return
        fi
    done
    for id in abc 100a "10 0" -1; do
        if _is_valid_vm_id "$id"; then
            test_fail "Expected '$id' to be rejected"
            return
        fi
    done
    test_pass
}

test_is_valid_disk_key() {
    test_start "_is_valid_disk_key accepts bus+number keys"
    # The helper validates key SHAPE (lowercase bus + digits), not the bus
    # set — any lowercase prefix like disk0 is accepted, matching
    # attach-vm-disk's equivalent dst-disk-key validator.
    local key
    for key in scsi0 ide1 virtio7 disk0; do
        if ! _is_valid_disk_key "$key"; then
            test_fail "Expected '$key' to be accepted"
            return
        fi
    done
    for key in scsi scsi0a SCSI0 0scsi; do
        if _is_valid_disk_key "$key"; then
            test_fail "Expected '$key' to be rejected"
            return
        fi
    done
    test_pass
}

test_state_round_trip_no_rename() {
    test_start "write_state/read_state round-trip no_rename"
    local state_file="$_mock_zfs_state_dir/no-rename.state"
    srcvmid=100
    srckey="scsi0"
    dstvmid=200
    dstkey="scsi1"
    srczvol="pool/vm-100-disk-0"
    dstzvol="$srczvol"
    srcbackstore="vm-100-disk-0"
    dstbackstore="$srcbackstore"
    target="iqn.2024-01.com.example:threeamigos"
    targetshort="threeamigos"
    pool="threeamigos"
    srclun=5
    dstlun=""
    phase="started"
    encrypted="N"
    no_rename="Y"
    write_state "$state_file"
    no_rename="X"
    read_state "$state_file"
    assert_equals "Y" "$no_rename"
}

test_usage_includes_no_rename() {
    test_start "usage mentions --no-rename"
    if grep -q -- "--no-rename" "$old_mydir/bin/move-vm-disk"; then
        test_pass
    else
        test_fail "usage does not mention --no-rename"
    fi
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_storage_move_heredoc_bootstrap
test_rollback_heredoc_bootstrap
test_verification_child_receives_pool
test_disk_num_from_key
test_disk_num_from_key_ide
test_auto_select_dst_key
test_auto_select_dst_key_efidisk
test_manifest_remove
test_manifest_add
test_encrypted_remove
test_encrypted_add
test_is_valid_vm_id
test_is_valid_disk_key
test_state_round_trip_no_rename
test_usage_includes_no_rename

test_summary
