#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfsretain — Unit tests for zfsretain

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

# =============================================================================
# Setup mock mydir with stubbed dependencies
# =============================================================================

old_mydir="$mydir"
mock_mydir=$(mktemp -d)
mydir="$mock_mydir"

cat > "$mock_mydir/zfsconfig" << 'EOF'
zfsconfig_get_retention() {
    mock_retention_policy
}
EOF

cat > "$mock_mydir/zfsdelsnap" << 'EOF'
delsnap() {
    _mock_delsnap_calls+=("$1")
    _mock_delsnap_tags+=("${releaseholds_tags[*]}")
    return 0
}
EOF

cat > "$mock_mydir/zfslockmanager" << 'EOF'
zfslock_init() { true; }
zfslock_acquire() {
    _mock_lock_acquisitions+=("$1 $2")
    if [[ "${_mock_lock_conflict:-}" == "$1" ]]; then
        return 1
    fi
    if [[ "${_mock_lock_error:-}" == "$1" ]]; then
        return 2
    fi
    zfslock_id="/tmp/mock_lock_${1//\//_}"
    return 0
}
zfslock_wait_or_resolve() {
    _mock_lock_acquisitions+=("$1 $2")
    # Real zfslock_wait_or_resolve returns:
    #   0 = acquired, 1 = aborted/error, 2 = skipped by user.
    # retain maps rc 2 -> INFO skip and rc 1 -> WARN skip.
    if [[ "${_mock_lock_error:-}" == "$1" ]]; then
        return 1
    fi
    if [[ "${_mock_lock_conflict:-}" == "$1" ]]; then
        return 2
    fi
    zfslock_id="/tmp/mock_lock_${1//\//_}"
    return 0
}
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

source "$old_mydir/bin/zfsretain"

# =============================================================================
# Helpers
# =============================================================================

# Reset mocks between tests
reset_mocks() {
    _mock_delsnap_calls=()
    _mock_delsnap_tags=()
    _mock_zfs_snap_list_creation=""
    _mock_zfs_snap_list=""
    _mock_zfs_props=()
    _mock_lock_acquisitions=()
    _mock_lock_conflict=""
    _mock_lock_error=""
    dryrun="N"
    autoproceed="Y"
    skipbusy="Y"
    releaseholds="N"
    releaseholds_tags=()
    retain_verb="N"
}

# =============================================================================
# Tests
# =============================================================================

test_phase1_same_day() {
    echo "=== Phase 1: Same-day dedup ==="
    reset_mocks
    local _wrap_snaplist=$'pool/fs@dailybackup-2025-03-30T10:00-04:00-d\tSun Mar 30 10:00 2025\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-30T12:00-04:00-d\tSun Mar 30 12:00 2025\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-31T10:00-04:00-d\tMon Mar 31 10:00 2025'
    mock_zfs_snap_list_creation "$_wrap_snaplist"
    local _wrap_snaplist=$'pool/fs@dailybackup-2025-03-30T10:00-04:00-d\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-30T12:00-04:00-d\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-31T10:00-04:00-d'
    mock_zfs_snap_list "$_wrap_snaplist"
    retain "pool/fs" "dailybackup"
    test_start "Removes older same-day snapshot, keeps newer"
    local _removed _kept1 _kept2
    _removed="pool/fs@dailybackup-2025-03-30T10:00-04:00-d"
    _kept1="pool/fs@dailybackup-2025-03-30T12:00-04:00-d"
    _kept2="pool/fs@dailybackup-2025-03-31T10:00-04:00-d"
    if [[ "${_mock_delsnap_calls[*]}" == *"$_removed"* ]] \
        && [[ "${_mock_delsnap_calls[*]}" != *"$_kept1"* ]] \
        && [[ "${_mock_delsnap_calls[*]}" != *"$_kept2"* ]]; then
        test_pass
    else
        test_fail "Unexpected deletions: ${_mock_delsnap_calls[*]}"
    fi
}

