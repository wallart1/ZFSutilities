    # other-label snapshots created between them.
    local _wrap_snaplist=$'pool/fs@dailybackup-2026-10-04T06:00-04:00-w\tSun Oct 4 6:36 2026\n'
    _wrap_snaplist+=$'pool/fs@BaseInstall-2026-10-04T12:25\tSun Oct 4 12:33 2026\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2026-10-04T12:34-04:00-w\tSun Oct 4 12:38 2026\n'
    _wrap_snaplist+=$'pool/fs@ITEinitConf-2026-10-04T17:02\tSun Oct 4 17:04 2026\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2026-10-04T23:07-04:00-w\tSun Oct 4 23:35 2026\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2026-10-05T06:00-04:00-d\tMon Oct 5 6:18 2026'
    mock_zfs_snap_list_creation "$_wrap_snaplist"
    local _wrap_snaplist=$'pool/fs@dailybackup-2026-10-04T06:00-04:00-w\n'
    _wrap_snaplist+=$'pool/fs@BaseInstall-2026-10-04T12:25\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2026-10-04T12:34-04:00-w\n'
