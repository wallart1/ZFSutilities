    mock_zfs_snap_list "$_wrap_snaplist"
    retain "pool/fs" "dailybackup"
    test_start "Same-day 'w' dedup survives interleaved foreign-label snapshots"
    local _rm1 _rm2 _keep_w _keep_d _foreign1 _foreign2
    _rm1="pool/fs@dailybackup-2026-10-04T06:00-04:00-w"
    _rm2="pool/fs@dailybackup-2026-10-04T12:34-04:00-w"
    _keep_w="pool/fs@dailybackup-2026-10-04T23:07-04:00-w"
