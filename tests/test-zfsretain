    echo "=== Phase 2: Bucket overflow ==="
    reset_mocks
    local _wrap_snaplist=$'pool/fs@dailybackup-2025-03-28T10:00-04:00-d\tFri Mar 28 10:00 2025\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-29T10:00-04:00-d\tSat Mar 29 10:00 2025\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-30T10:00-04:00-d\tSun Mar 30 10:00 2025\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-31T10:00-04:00-d\tMon Mar 31 10:00 2025'
    mock_zfs_snap_list_creation "$_wrap_snaplist"
    local _wrap_snaplist=$'pool/fs@dailybackup-2025-03-28T10:00-04:00-d\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-29T10:00-04:00-d\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-30T10:00-04:00-d\n'
    _wrap_snaplist+=$'pool/fs@dailybackup-2025-03-31T10:00-04:00-d'
    mock_zfs_snap_list "$_wrap_snaplist"
    mock_zfs_prop "pool/fs@dailybackup-2025-03-28T10:00-04:00-d" "written" "1024"
    mock_zfs_prop "pool/fs@dailybackup-2025-03-29T10:00-04:00-d" "written" "1024"
    mock_zfs_prop "pool/fs@dailybackup-2025-03-30T10:00-04:00-d" "written" "1024"
    mock_zfs_prop "pool/fs@dailybackup-2025-03-31T10:00-04:00-d" "written" "1024"
    retain "pool/fs" "dailybackup"
    test_start "Deletes oldest daily when bucket overflows"
    if [[ "${_mock_delsnap_calls[*]}" == *"pool/fs@dailybackup-2025-03-28T10:00-04:00-d"* ]]; then
        test_pass
    else
        test_fail "Expected oldest daily deleted, got: ${_mock_delsnap_calls[*]}"
    fi
}

