test_cli_apply_invokes_helper() {
    test_start "CLI --apply invokes reapplyholds_apply"
    mock_zfs_dataset_exists "pool/cli"
    mock_zfs_snap_exists "pool/cli@snap1"
    mock_zfs_snap_list_for "pool/cli" "pool/cli@snap1"

    local _in
    _in="$_mock_zfs_state_dir/cli-apply.tsv"
    printf 'pool/cli@snap1\tappliedtag\n' > "$_in"

    # Run in the current shell so the mock zfs hold state is visible here.
    local rc=0
