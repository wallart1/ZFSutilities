test_no_lock_skips_lock_manager() {
    test_start "no_lock=Y skips the lock manager entirely"
    # Lock stubs that fail the test if called; the migration executor already
    # holds the pool write lock, so hold steps must not lock again.
    local _orig_init _orig_wait _orig_release
    _orig_init=$(declare -f zfslock_init)
    _orig_wait=$(declare -f zfslock_wait_or_resolve)
    _orig_release=$(declare -f zfslock_release)
    zfslock_init() { test_fail "zfslock_init must not be called with no_lock=Y"; return 1; }
    zfslock_wait_or_resolve() {
        test_fail "zfslock_wait_or_resolve must not be called with no_lock=Y"
        return 1
    }
    zfslock_release() { test_fail "zfslock_release must not be called with no_lock=Y"; return 1; }

    mock_zfs_dataset_exists "pool/nolock"
    mock_zfs_snap_exists "pool/nolock@snap1"
    mock_zfs_snap_list_for "pool/nolock" "pool/nolock@snap1"
    mock_zfs_holds "pool/nolock@snap1" "tag1"

    local _tsv="$_mock_zfs_state_dir/nolock.tsv"
    reapplyholds_capture "pool/nolock" "$_tsv" "Y"
    assert_rc 0 "$?"

    reapplyholds_release "pool/nolock" "N" "Y"
    assert_rc 0 "$?"

    printf 'pool/nolock@snap1\ttag1\n' > "$_tsv"
    reapplyholds_apply "pool/nolock" "$_tsv" "N" "Y"
    assert_rc 0 "$?"
    assert_contains "${_mock_zfs_holds[pool/nolock@snap1]}" "tag1"

    # Restore the cooperative stubs for the remaining tests in this suite.
    eval "$_orig_init"
    eval "$_orig_wait"
    eval "$_orig_release"
    test_pass
}

