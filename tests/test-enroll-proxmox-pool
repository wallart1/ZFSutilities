#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-enroll-proxmox-pool — Unit tests for the Proxmox pool enrollment script.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Mocks
# ------------------------------------------------------------------

# Mock node-lib.sh behavior
NODE_MODE="two-node"
storage_host="stewie"
compute_host="tweety"
storage_ip="192.168.100.1"
iqn_prefix="iqn.2026-02.local.stewie"
declare -A pool_target=(
    ["threeamigos"]="threeamigos"
    ["NVME1"]="nvme1"
)
is_single_node() { [[ "$NODE_MODE" == "single-node" ]]; }
is_two_node()    { [[ "$NODE_MODE" == "two-node" ]]; }
pool_to_target() {
    local pool="$1"
    local short="${pool_target[$pool]:-}"
    [[ -n "$short" ]] && echo "${iqn_prefix}:${short}"
}
is_known_pool() { [[ -n "${pool_target[$1]:-}" ]]; }

# Mock hostname so the storage-host check is controllable
_mock_hostname="stewie"
hostname() { printf '%s\n' "$_mock_hostname"; }

# Local pvesm mock (single-node path). 'status' dumps a controllable table;
# any other subcommand (add) is recorded and returns a controllable rc.
_mock_pvesm_status="Name Type Status Total Used
local dir active N/A N/A"
_mock_pvesm_add_rc=0
_mock_pvesm_calls=()
pvesm() {
    if [[ "$1" == "status" ]]; then
        printf '%s\n' "$_mock_pvesm_status"
        return 0
    fi
    _mock_pvesm_calls+=("$*")
    return "$_mock_pvesm_add_rc"
}

# Local zfs mock (single-node path). 'list' succeeds for datasets seeded in
# _mock_datasets; 'create' is recorded and adds to _mock_datasets.
_mock_datasets=()
_mock_zfs_calls=()
zfs() {
    if [[ "$1" == "list" ]]; then
        local ds="${*: -1:1}"
        local d
        for d in "${_mock_datasets[@]}"; do
            [[ "$d" == "$ds" ]] && return 0
        done
        return 1
    fi
    if [[ "$1" == "create" ]]; then
        _mock_zfs_calls+=("create $2")
        _mock_datasets+=("$2")
        return 0
    fi
    return 0
}

# ssh mock (two-node path). Probes, status dumps, and adds are recognized by
# pattern; invocations are recorded (except those inside $(...) subshells).
_mock_ssh_calls=()
_mock_ssh_rc=0
_mock_ssh_pvesm_available=true
_mock_ssh_pvesm_status="Name Type Status Total Used
local dir active N/A N/A"
ssh() {
    _mock_ssh_calls+=("$*")
    if [[ "$*" == *"command -v pvesm"* ]]; then
        [[ "$_mock_ssh_pvesm_available" == true ]] && return 0
        return 1
    fi
    if [[ "$*" == *"pvesm status"* ]]; then
        printf '%s\n' "$_mock_ssh_pvesm_status"
        return 0
    fi
    if [[ "$*" == *"pvesm add"* ]]; then
        return "$_mock_ssh_rc"
    fi
    return 0
}

# The evaluated script calls find_zfsutility_script to locate helpers; point
# every resolution at /dev/null (our mocks above are already in place).
find_zfsutility_script() { echo "/dev/null"; }

# ------------------------------------------------------------------
# Load the script under test into this shell with node-lib mocked.
# The script's own TEST_MODE guard prevents main() from auto-running.
# ------------------------------------------------------------------

ENROLL_PROXMOX_TEST_MODE="Y"
export ENROLL_PROXMOX_NODE_LIB="/dev/null"
script_text=$(cat "$mydir/bin/enroll-proxmox-pool")
eval "$script_text"

# The evaluated script re-sources bashinit, which replaces test-lib.sh's
# log_msg mock with the real implementation. Restore a capturing mock so log
# assertions against get_test_log_file work and test output stays quiet.
log_msg() {
    if [[ "${1:-}" == "--long-prefix" ]]; then
        shift
    fi
    echo "$*" >> "${_TEST_LOG_FILE}" 2>/dev/null || true
}

# ------------------------------------------------------------------
# Test helpers
# ------------------------------------------------------------------

reset_mocks() {
    _mock_hostname="stewie"
    NODE_MODE="two-node"
    storage_ip="192.168.100.1"
    _mock_pvesm_status="Name Type Status Total Used
local dir active N/A N/A"
    _mock_pvesm_add_rc=0
    _mock_pvesm_calls=()
    _mock_datasets=()
    _mock_zfs_calls=()
    _mock_ssh_calls=()
    _mock_ssh_rc=0
    _mock_ssh_pvesm_available=true
    _mock_ssh_pvesm_status="Name Type Status Total Used
local dir active N/A N/A"
    # Restore the default function mocks (individual tests may unset/override).
    pvesm() {
        if [[ "$1" == "status" ]]; then
            printf '%s\n' "$_mock_pvesm_status"
            return 0
        fi
        _mock_pvesm_calls+=("$*")
        # A successful add makes the storage visible in pvesm status.
        if [[ "$1" == "add" && "$_mock_pvesm_add_rc" -eq 0 ]]; then
            _mock_pvesm_status+=$'\n'"$3 $2 active N/A N/A"
        fi
        return "$_mock_pvesm_add_rc"
    }
    zfs() {
        if [[ "$1" == "list" ]]; then
            local ds="${*: -1:1}"
            local d
            for d in "${_mock_datasets[@]}"; do
                [[ "$d" == "$ds" ]] && return 0
            done
            return 1
        fi
        if [[ "$1" == "create" ]]; then
            _mock_zfs_calls+=("create $2")
            _mock_datasets+=("$2")
            return 0
        fi
        return 0
    }
    ssh() {
        _mock_ssh_calls+=("$*")
        if [[ "$*" == *"command -v pvesm"* ]]; then
            [[ "$_mock_ssh_pvesm_available" == true ]] && return 0
            return 1
        fi
        if [[ "$*" == *"pvesm status"* ]]; then
            printf '%s\n' "$_mock_ssh_pvesm_status"
            return 0
        fi
        if [[ "$*" == *"pvesm add"* ]]; then
            # A successful add makes the storage visible in pvesm status.
            if [[ "$_mock_ssh_rc" -eq 0 ]]; then
                local i j id=""
                for ((i = 1; i <= $#; i++)); do
                    if [[ "${!i}" == "iscsi" ]]; then
                        j=$((i + 1))
                        id="${!j}"
                        break
                    fi
                done
                [[ -n "$id" ]] && _mock_ssh_pvesm_status+=$'\n'"$id iscsi active N/A N/A"
            fi
            return "$_mock_ssh_rc"
        fi
        return 0
    }
    clear_test_log_file
}

# Join the recorded mock invocations (of any kind) into one searchable string.
all_mock_calls() {
    printf '%s\n' "${_mock_pvesm_calls[@]}" "${_mock_zfs_calls[@]}" "${_mock_ssh_calls[@]}"
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_script_loads_and_defines_main() {
    test_start "enroll-proxmox-pool sources and defines main()"
    if declare -f main >/dev/null 2>&1 && declare -f pvesm_status_has_id >/dev/null 2>&1; then
        test_pass
    else
        test_fail "main() and pvesm_status_has_id() should be defined after sourcing"
    fi
}

test_pvesm_status_has_id() {
    test_start "pvesm_status_has_id matches the Name column and skips the header"
    local status="Name Type Status Total Used
local dir active N/A N/A
threeamigos zfspool active 100 50"
    pvesm_status_has_id "$status" threeamigos
    assert_rc 0 $?
    pvesm_status_has_id "$status" local
    assert_rc 0 $?
    pvesm_status_has_id "$status" otherpool
    assert_rc 1 $?
    # The header word itself must not count as a storage ID
    pvesm_status_has_id "Name Type Status Total Used" Name
    assert_rc 1 $?
}

test_storage_id_is_valid() {
    test_start "storage_id_is_valid accepts PVE IDs and rejects the rest"
    storage_id_is_valid threeamigos
    assert_rc 0 $?
    storage_id_is_valid iscsi-nvme1
    assert_rc 0 $?
    storage_id_is_valid MyPool_2.0
    assert_rc 0 $?
    storage_id_is_valid "bad id"
    assert_rc 1 $?
    storage_id_is_valid "-lead"
    assert_rc 1 $?
    storage_id_is_valid ""
    assert_rc 1 $?
}

test_single_node_adds_zfspool_storage() {
    reset_mocks
    test_start "single-node: registers a zfspool storage backed by <pool>/proxmox"
    NODE_MODE="single-node"
    _mock_datasets=("threeamigos" "threeamigos/proxmox")

    main threeamigos >/dev/null 2>&1
    assert_rc 0 $?

    assert_equals "1" "${#_mock_pvesm_calls[@]}"
    assert_contains "${_mock_pvesm_calls[0]}" "add zfspool threeamigos"
    assert_contains "${_mock_pvesm_calls[0]}" "--pool threeamigos/proxmox"
    assert_contains "${_mock_pvesm_calls[0]}" "--content images,rootdir"
    assert_contains "${_mock_pvesm_calls[0]}" "--sparse 1"
    assert_equals "0" "${#_mock_zfs_calls[@]}"
    local log
    log=$(cat "$(get_test_log_file)")
    assert_contains "$log" "registered in Proxmox"
}

