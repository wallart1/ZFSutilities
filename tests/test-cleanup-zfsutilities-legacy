test_version_supports_new_layout() {
    test_start "_version_supports_new_layout detects new-layout versions"
    local tmpdir
    _setup_cleanup_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0" "false"
    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "2.0.0" "true"

    local failed=0
    if _version_supports_new_layout "$tmpdir/usr/local/lib/zfsutilities/versions/1.0.0"; then
        failed=1
        echo "    old version incorrectly reported as new-layout"
    fi
    if ! _version_supports_new_layout "$tmpdir/usr/local/lib/zfsutilities/versions/2.0.0"; then
        failed=1
        echo "    new version incorrectly reported as old-layout"
    fi

    _teardown_cleanup_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "new-layout detection failed"
    fi
}

test_remove_versions_refuses_active() {
    test_start "--remove-versions refuses to remove the active version"
    local tmpdir
    _setup_cleanup_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0" "false"
    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "2.0.0" "false"
    ln -sfn "versions/2.0.0" "$ZFSUTILITIES_VERSION_BASE/current"

    main --remove-versions 2.0.0 --yes >/dev/null 2>&1
    local rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ ! -d "$tmpdir/usr/local/lib/zfsutilities/versions/2.0.0" ]]; then
        failed=1
        echo "    active version was removed"
    fi

    _teardown_cleanup_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "active version protection failed"
    fi
}

