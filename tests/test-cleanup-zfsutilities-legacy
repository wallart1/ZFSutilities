test_remove_older_than() {
    test_start "--remove-older-than removes only versions older than reference"
    local tmpdir
    _setup_cleanup_env tmpdir

    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.0.0" "false"
    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "1.5.0" "false"
    _make_fake_version "$ZFSUTILITIES_VERSION_BASE" "2.0.0" "false"
    ln -sfn "versions/2.0.0" "$ZFSUTILITIES_VERSION_BASE/current"

    main --remove-older-than 1.5.0 --yes >/dev/null 2>&1
    local rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ -d "$tmpdir/usr/local/lib/zfsutilities/versions/1.0.0" ]]; then
        failed=1
        echo "    older version 1.0.0 was not removed"
    fi
    if [[ ! -d "$tmpdir/usr/local/lib/zfsutilities/versions/1.5.0" ]]; then
        failed=1
        echo "    boundary version 1.5.0 was incorrectly removed"
    fi
    if [[ ! -d "$tmpdir/usr/local/lib/zfsutilities/versions/2.0.0" ]]; then
        failed=1
        echo "    active version 2.0.0 was removed"
    fi

    _teardown_cleanup_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "remove-older-than failed"
    fi
}

