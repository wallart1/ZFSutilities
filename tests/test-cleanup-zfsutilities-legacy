    test_start "--yes skips prompt and removes symlinks"
    local tmpdir
    _setup_cleanup_env tmpdir
    mock_ask_yn 1

    touch "$tmpdir/var/lib/zfsutilities/config.json"
    _create_legacy_symlinks "$tmpdir"

    main --yes >/dev/null 2>&1
    local rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ -L "$tmpdir/root/.config/zfsutilities.json" ]]; then
        failed=1
        echo "    config symlink still present"
    fi

    _teardown_cleanup_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "--yes symlink removal failed"
    fi
}

test_dry_run_makes_no_changes() {
    test_start "--dry-run prints actions but makes no changes"
    local tmpdir
    _setup_cleanup_env tmpdir

    touch "$tmpdir/var/lib/zfsutilities/config.json"
    _create_legacy_symlinks "$tmpdir"

    local output rc
    output=$(main --dry-run --yes 2>&1)
    rc=$?

    local failed=0
    if [[ $rc -ne 0 ]]; then
        failed=1
        echo "    Expected rc=0, got $rc"
    fi
    if [[ "$output" != *"[DRY-RUN] rm -f"* ]]; then
        failed=1
        echo "    expected dry-run rm output missing"
    fi
    if [[ ! -L "$tmpdir/root/.config/zfsutilities.json" ]]; then
        failed=1
        echo "    symlink was removed during dry run"
    fi

    _teardown_cleanup_env "$tmpdir"

    if [[ $failed -eq 0 ]]; then
        test_pass
    else
        test_fail "dry-run behavior failed"
    fi
}

