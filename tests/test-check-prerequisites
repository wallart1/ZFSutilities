# Create a minimal fake PATH with mock commands so check-prerequisites can run
# to completion without real dependencies.
run_check_prerequisites_with_mock_env() {
    local tmp_bin
    tmp_bin=$(mktemp -d)

    # Core commands
    cat > "$tmp_bin/bash" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "--version" ]] && echo "5.2.0" || true
EOF
    chmod +x "$tmp_bin/bash"

    for cmd in pv rsync smartctl python3 pip3; do
        ln -s /bin/true "$tmp_bin/$cmd"
    done

    # MATPLOTLIB_STUB=absent: python3 succeeds for everything except the
    # matplotlib import probe (drives the optional-chart warn branch).
    if [[ "${MATPLOTLIB_STUB:-present}" == "absent" ]]; then
        # rm first: the loop above left python3 as a symlink, and cat >
        # would follow it into /bin/true instead of replacing it.
        rm -f "$tmp_bin/python3"
        cat > "$tmp_bin/python3" << 'STUB'
#!/usr/bin/bash
for arg in "$@"; do
    [[ "$arg" == *matplotlib* ]] && exit 1
done
exec /bin/true
STUB
        chmod +x "$tmp_bin/python3"
    fi

    # ZFS tooling: ZFS_STUB=absent leaves zfs/zpool out of the stub PATH
    # (drives the contrib-note probe); present otherwise. With
    # ZFS_VOLUMES_FIXTURE set, zfs answers the detection scan
    # (`list -Hp -t volume ...`) from the fixture file instead of /bin/true.
    if [[ "${ZFS_STUB:-present}" != "absent" ]]; then
        if [[ -n "${ZFS_VOLUMES_FIXTURE:-}" ]]; then
            # Builtins only (printf/read): the sealed PATH has no cat, and a
            # 127 from the stub would silently empty the detection scan.
            cat > "$tmp_bin/zfs" << 'EOF'
#!/usr/bin/bash
if [[ "$1 $2" == "list -Hp" && -n "${ZFS_VOLUMES_FIXTURE:-}" ]]; then
    while IFS= read -r _line; do printf '%s\n' "$_line"; done < "$ZFS_VOLUMES_FIXTURE"
    exit 0
fi
exec /bin/true
EOF
            chmod +x "$tmp_bin/zfs"
        else
            ln -s /bin/true "$tmp_bin/zfs"
        fi
        ln -s /bin/true "$tmp_bin/zpool"
    fi

    # apt-cache: stubbed only when APT_CANDIDATE is set ("(none)" or a
    # version string); no stub = apt-cache invisible = the probe is
    # skipped entirely (the no-apt / not-installed degradation path).
    if [[ -n "${APT_CANDIDATE:-}" ]]; then
        cat > "$tmp_bin/apt-cache" << EOF
#!/usr/bin/bash
echo "zfsutils-linux:"
echo "  Installed: (none)"
echo "  Candidate: $APT_CANDIDATE"
EOF
        chmod +x "$tmp_bin/apt-cache"
    fi

    # modinfo drives the zfs-kernel-module functional check
    # (MODINFO_STUB=ok | missing); no stub = kmod invisible = the module
    # probe is skipped.  uname is stubbed unconditionally so the
    # expected headers-package name is deterministic (uname is used
    # nowhere else in the script).
    cat > "$tmp_bin/uname" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "-r" ]] && echo "6.1-test-amd64" || echo Linux
EOF
    chmod +x "$tmp_bin/uname"
    if [[ -n "${MODINFO_STUB:-}" ]]; then
        if [[ "$MODINFO_STUB" == "ok" ]]; then
            ln -s /bin/true "$tmp_bin/modinfo"
        else
            ln -s /bin/false "$tmp_bin/modinfo"
        fi
    fi

    # mkdocs: version comes from MKDOCS_STUB_VERSION ("none" = absent)
    local mkdocs_version="${MKDOCS_STUB_VERSION:-1.6.0}"
    if [[ "$mkdocs_version" != "none" ]]; then
        cat > "$tmp_bin/mkdocs" << EOF
#!/usr/bin/bash
echo "mkdocs, version $mkdocs_version"
EOF
        chmod +x "$tmp_bin/mkdocs"
    fi

    # Real text utilities the script shells out to (check_mkdocs_version,
    # check_apt_pkg); everything else on the host stays invisible. stat,
    # date, realpath, and dirname serve the --two-node post-restore
    # detection (file mtimes, timestamp rendering, lib/iscsi-lib.sh
    # resolution); when any of them is missing the detection skips quietly.
    ln -s /usr/bin/awk "$tmp_bin/awk"
    ln -s /usr/bin/cut "$tmp_bin/cut"
    ln -s /usr/bin/grep "$tmp_bin/grep"
    ln -s "$(command -v stat)" "$tmp_bin/stat"
    ln -s "$(command -v date)" "$tmp_bin/date"
    ln -s "$(command -v realpath)" "$tmp_bin/realpath"
    ln -s "$(command -v dirname)" "$tmp_bin/dirname"

    # Two-node section commands (TWO_NODE_STUB=1): stubbed so a --two-node
    # run can exit 0 and the detection assertions see a clean section.
    if [[ "${TWO_NODE_STUB:-}" == "1" ]]; then
        for cmd in ssh scp targetcli iscsiadm systemctl; do
            ln -s /bin/true "$tmp_bin/$cmd"
        done
    fi

    # dpkg simulates all requested packages as installed
    cat > "$tmp_bin/dpkg" << 'EOF'
#!/usr/bin/bash
if [[ "$1" == "-l" ]]; then
    echo "ii  $2"
fi
EOF
    chmod +x "$tmp_bin/dpkg"

    # pveversion is handled by the caller via PATH order; we leave it absent here.
    # fakeroot is pinned to its absolute path: the PATH= prefix below would
    # otherwise hide it from the command lookup.
    local maybe_fakeroot=()
    if [[ $EUID -ne 0 ]]; then
        if command -v fakeroot >/dev/null 2>&1; then
            maybe_fakeroot=("$(command -v fakeroot)")
        else
            rm -rf "$tmp_bin"
            return 255
        fi
    fi

    # The stub dir is the ONLY PATH entry for the script itself: host-wide
    # installs (an apt python3-mkdocs in /usr/bin, a pip mkdocs in
    # ~/.local/bin) must stay invisible so absent/present variants are
    # deterministic per host.  `env` applies the seal only to the script —
    # a PATH= prefix would also hide fakeroot's own wrapper internals.
    "${maybe_fakeroot[@]}" env PATH="$tmp_bin" "$PREREQ_SCRIPT" "$@"
    local rc=$?
    rm -rf "$tmp_bin"
    return $rc
}

test_matplotlib_optional_warn_when_absent() {
    test_start "matplotlib absence warns (Cairo fallback), never fails"

    local output rc
    output=$(MATPLOTLIB_STUB=absent run_check_prerequisites_with_mock_env --single-node 2>&1)
    rc=$?

    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi

    # Optional component: the run still succeeds.
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 when matplotlib is absent, got $rc"
        return
    fi
    if [[ "$output" != *"matplotlib not installed"* ]]; then
        test_fail "Expected the matplotlib warn line in output"
        return
    fi
    if [[ "$output" != *"python3-matplotlib"* ]]; then
        test_fail "Expected the system-package hint in the warn line"
        return
    fi
    if printf '%s\n' "$output" | grep -q '^gui|matplotlib|'; then
        test_fail "matplotlib absence must not land in the failure list"
        return
    fi
    test_pass
}

