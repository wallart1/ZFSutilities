# ---------------------------------------------------------------------------
# zfs-kernel-module functional check (F-009)
# ---------------------------------------------------------------------------

test_module_row_when_not_built() {
    test_start "zfs present but module not built fails with a headers remediation"

    local output rc row
    output=$(MODINFO_STUB=missing \
             run_check_prerequisites_with_mock_env --single-node --list-failures 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 1 ]]; then
        test_fail "Expected exit 1 with module missing, got $rc"
        return
    fi
    row=$(printf '%s\n' "$output" | grep -m1 '^core|zfs-kernel-module|')
    local expected
    expected="core|zfs-kernel-module|linux-headers-6.1-test-amd64|"
    expected+="kernel module not built (zfs-dkms needs the matching headers)"
    if [[ "$row" != "$expected" ]]; then
        test_fail "Unexpected module row: $row"
        return
    fi
    test_pass
}

test_no_module_row_when_built() {
    test_start "built zfs module passes and adds no failure"

    local output rc
    output=$(MODINFO_STUB=ok \
             run_check_prerequisites_with_mock_env --single-node 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 with module built, got $rc"
        return
    fi
    if [[ "$output" != *"✓ zfs-kernel-module"* || "$output" == *"✗ zfs-kernel-module"* ]]; then
        test_fail "Expected a passing zfs-kernel-module check: $output"
        return
    fi
    test_pass
}

test_module_check_skipped_without_modinfo() {
    test_start "module check silently skipped when modinfo is unavailable"

    local output rc
    output=$(run_check_prerequisites_with_mock_env --single-node 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 without modinfo, got $rc"
        return
    fi
    if [[ "$output" == *"zfs-kernel-module"* ]]; then
        test_fail "zfs-kernel-module must not appear without modinfo"
        return
    fi
    test_pass
}

test_module_row_alongside_missing_zfs_tools() {
    test_start "fresh-Debian shape: zfs tools AND module both remediated"

    local output rc rows
    output=$(ZFS_STUB=absent MODINFO_STUB=missing \
             run_check_prerequisites_with_mock_env --single-node --list-failures 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 1 ]]; then
        test_fail "Expected exit 1, got $rc"
        return
    fi
    rows=$(printf '%s\n' "$output" | grep -c '^core|')
    if [[ "$rows" -lt 3 ]]; then
        test_fail "Expected zfs + zpool + zfs-kernel-module rows, got $rows"
        return
    fi
    if ! printf '%s\n' "$output" | grep -q '^core|zfs|zfsutils-linux|' \
        || ! printf '%s\n' "$output" | grep -q '^core|zfs-kernel-module|linux-headers-'; then
        test_fail "Expected both zfsutils-linux and headers rows: $output"
        return
    fi
    test_pass
}

test_contrib_note_shown_when_no_candidate
test_contrib_note_absent_when_candidate_exists
test_contrib_note_absent_when_zfs_present
test_contrib_note_absent_without_apt_cache
test_module_row_when_not_built
test_no_module_row_when_built
test_module_check_skipped_without_modinfo
