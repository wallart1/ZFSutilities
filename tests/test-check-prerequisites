test_two_node_detection_dead_manifest_entry_warns() {
    test_start "--two-node: manifest entry without a zvol warns"

    local fx output rc
    fx=$(make_detection_fixtures)
    printf 'vm-101-disk-0\nvm-999-disk-0\n' > "$fx/manifest"
    # saveconfig fresh: only the manifest signature fires.
    touch -d @1790000000 "$fx/saveconfig.json"
    touch -d @1790000000 "$fx/manifest"
    output=$(TWO_NODE_STUB=1 \
        ZFS_VOLUMES_FIXTURE="$fx/zvols" \
        ISCSI_SAVECONFIG="$fx/saveconfig.json" \
        ISCSI_MANIFEST="$fx/manifest" \
        run_check_prerequisites_with_mock_env --two-node 2>&1)
    rc=$?
    rm -rf "$fx"

    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 with a detection finding, got $rc"
        return
    fi
    if [[ "$output" != *"manifest expects vm-999-disk-0 but no such VM zvol exists"* ]]; then
        test_fail "Expected the dead-manifest-entry warn line in output"
        return
    fi
    # The fixture's live zvol must NOT warn — this is the proof the scan
    # itself ran (an empty scan would flag every manifest entry).
    if [[ "$output" == *"manifest expects vm-101-disk-0"* ]]; then
        test_fail "Live zvol vm-101-disk-0 must not be reported missing"
        return
    fi
    if [[ "$output" == *"saveconfig.json was last written"* ]]; then
        test_fail "Fresh saveconfig must not produce a stale-file warn"
        return
    fi
    test_pass
}

