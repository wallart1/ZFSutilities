# ---------------------------------------------------------------------------
# Proxmox section output
# ---------------------------------------------------------------------------

# Create a minimal fake PATH with mock commands so check-prerequisites can run
# to completion without real dependencies.
run_check_prerequisites_with_mock_env() {
    local tmp_bin
    tmp_bin=$(mktemp -d)

    # Core commands
    cat > "$tmp_bin/bash" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "--version" ]] && echo "5.2.0" || true
EOF
    chmod +x "$tmp_bin/bash"

    for cmd in pv rsync smartctl python3 pip3; do
        ln -s /bin/true "$tmp_bin/$cmd"
    done

    # ZFS tooling: ZFS_STUB=absent leaves zfs/zpool out of the stub PATH
    # (drives the contrib-note probe); present otherwise.
    if [[ "${ZFS_STUB:-present}" != "absent" ]]; then
        ln -s /bin/true "$tmp_bin/zfs"
        ln -s /bin/true "$tmp_bin/zpool"
    fi

    # apt-cache: stubbed only when APT_CANDIDATE is set ("(none)" or a
    # version string); no stub = apt-cache invisible = the probe is
    # skipped entirely (the no-apt / not-installed degradation path).
    if [[ -n "${APT_CANDIDATE:-}" ]]; then
        cat > "$tmp_bin/apt-cache" << EOF
#!/usr/bin/bash
echo "zfsutils-linux:"
echo "  Installed: (none)"
echo "  Candidate: $APT_CANDIDATE"
EOF
        chmod +x "$tmp_bin/apt-cache"
    fi

    # modinfo drives the zfs-kernel-module functional check
    # (MODINFO_STUB=ok | missing); no stub = kmod invisible = the module
    # probe is skipped.  uname is stubbed unconditionally so the
    # expected headers-package name is deterministic (uname is used
    # nowhere else in the script).
    cat > "$tmp_bin/uname" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "-r" ]] && echo "6.1-test-amd64" || echo Linux
EOF
    chmod +x "$tmp_bin/uname"
    if [[ -n "${MODINFO_STUB:-}" ]]; then
        if [[ "$MODINFO_STUB" == "ok" ]]; then
            ln -s /bin/true "$tmp_bin/modinfo"
        else
            ln -s /bin/false "$tmp_bin/modinfo"
        fi
    fi

    # mkdocs: version comes from MKDOCS_STUB_VERSION ("none" = absent)
    local mkdocs_version="${MKDOCS_STUB_VERSION:-1.6.0}"
    if [[ "$mkdocs_version" != "none" ]]; then
        cat > "$tmp_bin/mkdocs" << EOF
#!/usr/bin/bash
echo "mkdocs, version $mkdocs_version"
EOF
        chmod +x "$tmp_bin/mkdocs"
    fi

    # Real text utilities the script shells out to (check_mkdocs_version,
    # check_apt_pkg); everything else on the host stays invisible.
    ln -s /usr/bin/awk "$tmp_bin/awk"
    ln -s /usr/bin/cut "$tmp_bin/cut"
    ln -s /usr/bin/grep "$tmp_bin/grep"

    # dpkg simulates all requested packages as installed
    cat > "$tmp_bin/dpkg" << 'EOF'
#!/usr/bin/bash
if [[ "$1" == "-l" ]]; then
    echo "ii  $2"
fi
EOF
    chmod +x "$tmp_bin/dpkg"

    # pveversion is handled by the caller via PATH order; we leave it absent here.
    # fakeroot is pinned to its absolute path: the PATH= prefix below would
    # otherwise hide it from the command lookup.
    local maybe_fakeroot=()
    if [[ $EUID -ne 0 ]]; then
        if command -v fakeroot >/dev/null 2>&1; then
            maybe_fakeroot=("$(command -v fakeroot)")
        else
            rm -rf "$tmp_bin"
            return 255
        fi
    fi

    # The stub dir is the ONLY PATH entry for the script itself: host-wide
    # installs (an apt python3-mkdocs in /usr/bin, a pip mkdocs in
    # ~/.local/bin) must stay invisible so absent/present variants are
    # deterministic per host.  `env` applies the seal only to the script —
    # a PATH= prefix would also hide fakeroot's own wrapper internals.
    "${maybe_fakeroot[@]}" env PATH="$tmp_bin" "$PREREQ_SCRIPT" "$@"
    local rc=$?
    rm -rf "$tmp_bin"
    return $rc
}

test_proxmox_absent_warning() {
    test_start "Proxmox absence produces informational warning, not failure"

    local output rc
    output=$(run_check_prerequisites_with_mock_env --single-node 2>&1)
    rc=$?

    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi

    # Should exit 0 because Proxmox is optional.
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 when Proxmox is absent, got $rc"
        return
    fi

    # Should use the updated section title and warning wording.
    if [[ "$output" != *"Proxmox VE / VM tools"* ]]; then
        test_fail "Expected section title 'Proxmox VE / VM tools' in output"
        return
    fi
    if [[ "$output" != *"required only on a two-node compute host"* ]]; then
        test_fail "Expected 'required only on a two-node compute host' warning"
        return
    fi
    test_pass
}

test_proxmox_present_pass() {
    test_start "Proxmox presence reports pveversion pass"

    local tmp_bin
    tmp_bin=$(mktemp -d)

    cat > "$tmp_bin/bash" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "--version" ]] && echo "5.2.0" || true
EOF
    chmod +x "$tmp_bin/bash"
    for cmd in zfs zpool pv rsync smartctl python3 pip3; do
        ln -s /bin/true "$tmp_bin/$cmd"
    done
    cat > "$tmp_bin/mkdocs" << 'EOF'
#!/usr/bin/bash
echo "mkdocs, version 1.6.0"
EOF
    chmod +x "$tmp_bin/mkdocs"
    cat > "$tmp_bin/dpkg" << 'EOF'
#!/usr/bin/bash
[[ "$1" == "-l" ]] && echo "ii  $2"
EOF
    chmod +x "$tmp_bin/dpkg"
    cat > "$tmp_bin/pveversion" << 'EOF'
#!/usr/bin/bash
echo "pve-manager/8.0.0/0d00c89cd4c8d7f5"
EOF
    chmod +x "$tmp_bin/pveversion"

    local output rc
    local maybe_fakeroot=()
    if [[ $EUID -ne 0 ]]; then
        if command -v fakeroot >/dev/null 2>&1; then
            maybe_fakeroot=(fakeroot)
        else
            rm -rf "$tmp_bin"
            test_skip "Requires root or fakeroot"
            return
        fi
    fi
    output=$(PATH="$tmp_bin:$PATH" "${maybe_fakeroot[@]}" "$PREREQ_SCRIPT" --single-node 2>&1)
    rc=$?

    rm -rf "$tmp_bin"

    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 when Proxmox is present, got $rc"
        return
    fi
    if [[ "$output" != *"pveversion:"* ]]; then
        test_fail "Expected pveversion pass line in output"
        return
    fi
    test_pass
}

test_mkdocs_version_absent
test_mkdocs_version_1_x
test_mkdocs_version_2_x
test_mkdocs_version_10_x
test_mkdocs_version_malformed
test_proxmox_absent_warning
test_proxmox_present_pass

test_mkdocs_absent_is_informational() {
    test_start "absent mkdocs warns and does not fail the check"
    local output rc
    output=$(MKDOCS_STUB_VERSION=none run_check_prerequisites_with_mock_env --single-node 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 with mkdocs absent, got $rc"
        return
    fi
    if [[ "$output" != *"⚠ mkdocs not installed"* ]]; then
        test_fail "Expected 'mkdocs not installed' warning in output"
        return
    fi
    if [[ "$output" == *"✗ mkdocs"* ]]; then
        test_fail "mkdocs absence must not produce a failure line"
        return
    fi
    test_pass
}

