test_mkdocs_v2_failure_has_no_apt_package() {
    test_start "mkdocs 2.x fails without an apt package field"
    local output rc row
    output=$(MKDOCS_STUB_VERSION=2.0.1 \
        run_check_prerequisites_with_mock_env --single-node --list-failures 2>&1)
    rc=$?
    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    if [[ $rc -ne 1 ]]; then
        test_fail "Expected exit 1 with mkdocs 2.x, got $rc"
        return
    fi
    row=$(printf '%s\n' "$output" | grep -m1 '^docs|mkdocs|')
    if [[ -z "$row" ]]; then
        test_fail "Expected a docs|mkdocs failure row: $output"
        return
    fi
    local expected
    expected="docs|mkdocs||mkdocs 2.x is incompatible with this project;"
    expected+=" pin to mkdocs<2"
    if [[ "$row" != "$expected" ]]; then
        test_fail "Unexpected row shape (package column must be empty): $row"
        return
    fi
    test_pass
}

test_mkdocs_absent_is_informational
test_mkdocs_absent_not_in_list_failures
test_mkdocs_v2_failure_has_no_apt_package

