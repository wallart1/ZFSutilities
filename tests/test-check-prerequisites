# ---------------------------------------------------------------------------
# --two-node post-restore iSCSI detection (informational warns only)
# ---------------------------------------------------------------------------

# Shared fixture builder: a zvol fixture, a manifest, and a saveconfig whose
# mtimes the caller positions around the zvol creation epoch.
make_detection_fixtures() {
    local dir
    dir=$(mktemp -d)
    printf 'threeamigos/proxmox/vm-101-disk-0\t1780000000\n' > "$dir/zvols"
    printf 'vm-101-disk-0\n' > "$dir/manifest"
    echo '{"storage_objects":[],"targets":[]}' > "$dir/saveconfig.json"
    printf '%s\n' "$dir"
}

test_two_node_detection_stale_saveconfig_warns() {
    test_start "--two-node: saveconfig older than the newest zvol warns"

    local fx output rc
    fx=$(make_detection_fixtures)
    # OS-disk files regressed to before the zvol creation (restore signature).
    touch -d @1760000000 "$fx/saveconfig.json"
    touch -d @1760000000 "$fx/manifest"
    output=$(TWO_NODE_STUB=1 \
        ZFS_VOLUMES_FIXTURE="$fx/zvols" \
        ISCSI_SAVECONFIG="$fx/saveconfig.json" \
        ISCSI_MANIFEST="$fx/manifest" \
        run_check_prerequisites_with_mock_env --two-node 2>&1)
    rc=$?
    rm -rf "$fx"

    if [[ $rc -eq 255 ]]; then
        test_skip "Requires root or fakeroot"
        return
    fi
    # Informational only: warns never fail the gate.
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected exit 0 with detection findings, got $rc"
        return
    fi
    if [[ "$output" != *"iSCSI post-restore detection: saveconfig.json was last written"* ]]; then
        test_fail "Expected the stale-saveconfig warn line in output"
        return
    fi
    if [[ "$output" != *"bare-metal restore signature"* ]]; then
        test_fail "Expected the signature wording in the warn line"
        return
    fi
    if [[ "$output" != *"sudo setup-iscsi-targets"* ]]; then
        test_fail "Expected the pointer to setup-iscsi-targets"
        return
    fi
