    rm -f "$NODE_CONF"
}

test_degraded_refuses_overwrite() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf

    # Record the healthy state first.
    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    [[ "$rc" -eq 0 ]] || {
        test_fail "healthy export failed (rc=$rc)"
        rm -f "$NODE_CONF"
        return
    }

    # Degrade: manifest still expects both backstores, live shows one.
    ISCSI_MANIFEST=$(mktemp)
    printf 'vm-101-disk-0\nvm-205-disk-3\n' > "$ISCSI_MANIFEST"
    _mock_backstores='  o- vm-101-disk-0 ........ [/dev/zvol/threeamigos/proxmox/vm-101-disk-0 '
    _mock_backstores+='(1.0MiB) write-thru activated]'
    _mock_luns_nvme1=""

    test_start "Degraded live state refuses to overwrite the pool map"

    rc=0
    out=$( main 2>/dev/null ) || rc=$?
    local map_file="${_mock_pools_root}/threeamigos/iscsi-state.json"

    if [[ "$rc" -eq 1 ]] && grep -q 'vm-205-disk-3' "$map_file"; then
        test_pass
    else
        test_fail "rc=$rc — degraded export should refuse and keep the healthy map"
    fi
    rm -f "$ISCSI_MANIFEST" "$NODE_CONF"
}

test_degraded_force_records() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf

    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    [[ "$rc" -eq 0 ]] || {
        test_fail "healthy export failed (rc=$rc)"
        rm -f "$NODE_CONF"
        return
    }

    ISCSI_MANIFEST=$(mktemp)
    printf 'vm-101-disk-0\nvm-205-disk-3\n' > "$ISCSI_MANIFEST"
    _mock_backstores='  o- vm-101-disk-0 ........ [/dev/zvol/threeamigos/proxmox/vm-101-disk-0 '
    _mock_backstores+='(1.0MiB) write-thru activated]'
    _mock_luns_nvme1=""
    force_write=true

    test_start "--force records a degraded state over the healthy map"

    rc=0
    out=$( main 2>/dev/null ) || rc=$?
    local map_file="${_mock_pools_root}/threeamigos/iscsi-state.json"

    if [[ "$rc" -eq 0 ]] && ! grep -q 'vm-205-disk-3' "$map_file"; then
        test_pass
    else
        test_fail "rc=$rc — forced export should record the degraded state"
    fi
    rm -f "$ISCSI_MANIFEST" "$NODE_CONF"
}

test_degraded_refuses_via_map_fallback() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf

    # Record the healthy two-backstore state first.
    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    [[ "$rc" -eq 0 ]] || {
        test_fail "healthy export failed (rc=$rc)"
        rm -f "$NODE_CONF"
        return
    }

    # Post-restore shape: the manifest regressed with the OS disk (missing),
    # and only one of the two backstores is live. The fence must fall back
    # to the newest pool map for the expected count.
    ISCSI_MANIFEST="/nonexistent/expected-backstores.txt"
    _mock_backstores='  o- vm-101-disk-0 ........ [/dev/zvol/threeamigos/proxmox/vm-101-disk-0 '
    _mock_backstores+='(1.0MiB) write-thru activated]'
    _mock_luns_nvme1=""

    test_start "Degraded state refuses via map fallback when the manifest is missing"

    rc=0
    out=$( main 2>/dev/null ) || rc=$?
    local map_file="${_mock_pools_root}/threeamigos/iscsi-state.json"

    if [[ "$rc" -eq 1 ]] && grep -q 'vm-205-disk-3' "$map_file"; then
        test_pass
    else
        test_fail "rc=$rc — map-fallback fence should refuse and keep the healthy map"
    fi
    rm -f "$NODE_CONF"
}

test_check_no_drift() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf

    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    [[ "$rc" -eq 0 ]] || {
        test_fail "healthy export failed (rc=$rc)"
        rm -f "$NODE_CONF"
        return
    }

    test_start "--check reports no drift against a fresh map"

    check_only=true
    rc=0
    out=$( main 2>/dev/null ) || rc=$?
    check_only=false

    assert_rc 0 "$rc"
    rm -f "$NODE_CONF"
}

test_check_reports_drift() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf

    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    [[ "$rc" -eq 0 ]] || {
        test_fail "healthy export failed (rc=$rc)"
        rm -f "$NODE_CONF"
        return
    }

    # Manual targetcli edits: nvme1's LUN 5 now points at a different
    # backstore, and the threeamigos ACL was removed.
    _mock_luns_nvme1='  | o- lun5  [block/vm-205-disk-4 '
    _mock_luns_nvme1+='(/dev/zvol/NVME1/proxmox/vm-205-disk-4) (default_tg_pt_gp)]'
    _mock_backstores='  o- vm-101-disk-0 ........ [/dev/zvol/threeamigos/proxmox/vm-101-disk-0 '
    _mock_backstores+='(1.0MiB) write-thru activated]\n  o- vm-205-disk-4 ............ '
    _mock_backstores+='[/dev/zvol/NVME1/proxmox/vm-205-disk-4 (401.0GiB) write-thru activated]'
    _mock_acls_threeamigos=""

    test_start "--check reports LUN and ACL drift, exit 1"

    check_only=true
    local out
    rc=0
    out=$( main 2>/dev/null ) || rc=$?
    check_only=false

    if [[ "$rc" -eq 1 ]] \
        && [[ "$out" == *"LUN 5 moved: map -> vm-205-disk-3, live -> vm-205-disk-4"* ]] \
        && [[ "$out" == *"ACL initiator iqn.2026-02.local.tweety is missing live"* ]]; then
        test_pass
    else
        test_fail "rc=$rc out='$out'"
    fi
    rm -f "$NODE_CONF"
}

test_check_without_map_fails() {
    reset_mocks
    load_healthy_topology
    register_online_pool "threeamigos"
    use_temp_node_conf
    # No export run: no map on any pool.

    test_start "--check with no map on any pool exits 1"

    check_only=true
    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?
    check_only=false

    assert_rc 1 "$rc"
    rm -f "$NODE_CONF"
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_script_loads
test_single_node_silent_exit
test_parse_target_acls
test_state_json_structure
test_golden_state_json
test_unmapped_backstore_dev_only
test_state_written_to_all_online_pools
test_no_temp_files_left_behind
test_dataset_created_on_first_use
test_offline_pool_skipped_with_warning
test_no_pool_written_fails
test_degraded_refuses_overwrite
test_degraded_force_records
test_degraded_refuses_via_map_fallback
test_check_no_drift
test_check_reports_drift
test_check_without_map_fails

[[ -n "$_mock_pools_root" && -d "$_mock_pools_root" ]] && rm -rf "$_mock_pools_root"

test_summary
