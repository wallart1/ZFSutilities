}

test_no_pool_written_fails() {
    reset_mocks
    load_healthy_topology
    # No pools imported at all.
    _mock_zpool_list=""
    use_temp_node_conf
    test_start "Writing to zero pools exits 1"

    local rc=0 out
    out=$( main 2>/dev/null ) || rc=$?

