        && [[ ! -e "${_mock_pools_root}/NVME1" ]] \
        && [[ -f "${_mock_pools_root}/threeamigos/iscsi-state.json" ]]; then
        test_pass
    else
        test_fail "rc=$rc pools_written=$pools_written"
    fi
