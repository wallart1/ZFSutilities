#!/usr/bin/bash
# shellcheck disable=SC2016
# test-node-lib — Unit tests for lib/node-lib.sh helpers.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

# Create a temporary single-node config so sourcing node-lib.sh succeeds without
# touching /etc.
tmp_dir=$(mktemp -d)
node_conf="$tmp_dir/node.conf"
cat > "$node_conf" << 'EOF'
NODE_MODE="single-node"
EOF

export NODE_CONF="$node_conf"

# Source the library under test.  test-lib.sh has already set $mydir to the repo
# root, so node-lib.sh's guarded initializer must preserve it.
source "$mydir/lib/node-lib.sh"

# Reload find_zfsutility_script from the working tree so tests exercise the
# current implementation (including deployment-directory overrides). Preserve
# test-lib.sh's redirected log_msg afterwards.
_test_log_msg_copy=$(declare -f log_msg)
unset -f find_zfsutility_script
source "$mydir/bin/bashinit"
eval "$_test_log_msg_copy"

# ------------------------------------------------------------------------------
# find_zfsutility_script
# ------------------------------------------------------------------------------

test_find_script_lib_directory() {
    test_start "find_zfsutility_script locates a library in lib/"
    local result
    # Simulate a caller in bin/ looking for a library in lib/.
    result=$(mydir="$mydir/bin" find_zfsutility_script "node-lib.sh")
    assert_equals "$mydir/lib/node-lib.sh" "$result"
}

test_find_script_python_from_bin_directory() {
    test_start "find_zfsutility_script locates a script in python/ from bin/"
    local result
    # Simulate a caller in bin/ looking for a script in python/.
    result=$(mydir="$mydir/bin" find_zfsutility_script "profile_runner.py")
    assert_equals "$mydir/python/profile_runner.py" "$result"
}

test_find_script_bin_directory() {
    test_start "find_zfsutility_script locates a script in bin/"
    local result
    # Simulate a caller in bin/ looking for a sibling script.
    result=$(mydir="$mydir/bin" find_zfsutility_script "rescan-storage")
    assert_equals "$mydir/bin/rescan-storage" "$result"
}

test_find_script_bin_directory_clone_script() {
    test_start "find_zfsutility_script locates a clone-support script in bin/"
    local result
    # Simulate a caller in bin/ looking for a sibling script.
    result=$(mydir="$mydir/bin" find_zfsutility_script "archive-vm")
    assert_equals "$mydir/bin/archive-vm" "$result"
}

test_find_script_lib_from_python_directory() {
    test_start "find_zfsutility_script locates lib/ script from python/ dir"
    local result
    result=$(mydir="$mydir/python" find_zfsutility_script "node-lib.sh")
    assert_equals "$mydir/lib/node-lib.sh" "$result"
}

test_find_script_from_bin_directory() {
    test_start "find_zfsutility_script locates lib/ script from bin/ dir"
    local result expected
    expected="$mydir/lib/node-lib.sh"
    result=$(mydir="$mydir/bin" find_zfsutility_script "node-lib.sh")
    assert_equals "$expected" "$result"
}

test_find_script_missing() {
    test_start "find_zfsutility_script fails for a missing script"
    clear_test_log_file
    local result rc
    result=$(find_zfsutility_script "definitely-missing-script" 2>/dev/null)
    rc=$?
    assert_rc 1 "$rc"
    assert_equals "" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "WARN: Could not find sibling script: definitely-missing-script" "$log"; then
        test_pass
    else
        test_fail "Expected WARN log message not found"
    fi
}

# ------------------------------------------------------------------------------
# source_helper
# ------------------------------------------------------------------------------

test_source_helper_sources_existing_script() {
    test_start "source_helper sources an existing sibling script"
    local tmp_bin result
    tmp_bin=$(mktemp -d)
    printf '#!/usr/bin/bash\nTEST_HELPER_WAS_SOURCED=Y\n' > "$tmp_bin/test-helper-script"
    chmod +x "$tmp_bin/test-helper-script"
    result=$(
        mydir="$tmp_bin"
        source_helper "test-helper-script"
        echo "${TEST_HELPER_WAS_SOURCED:-N}"
    )
    rm -rf "$tmp_bin"
    assert_equals "Y" "$result"
}

test_source_helper_exits_for_missing_script() {
    test_start "source_helper exits when sibling script cannot be found"
    local rc=0
    (
        mydir="/nonexistent-directory-$$"
        source_helper "definitely-missing-script" 2>/dev/null
    ) || rc=$?
    assert_rc 8 "$rc"
}

test_source_helper_fallback_returns_when_sourced() {
    test_start "source_helper falls back to bashreturn when bashfatal is missing"
    local tmp_bin rc=0
    tmp_bin=$(mktemp -d)

    # Provide bashreturn but deliberately omit bashfatal in the search paths.
    local _wrap_fmt='#!/usr/bin/bash\nif [[ "${BASH_SOURCE[1]}" != "${0}" ]]; then return '
    _wrap_fmt+='"${1:-0}"; else exit "${1:-0}"; fi\n'
    printf '%b' "$_wrap_fmt" > "$tmp_bin/bashreturn"
    chmod +x "$tmp_bin/bashreturn"

    local caller="$tmp_bin/caller"
    cat > "$caller" <<EOF
#!/usr/bin/bash
export ZFSUTILITIES_BIN_DIR="$tmp_bin"
export ZFSUTILITIES_CURRENT_BIN_DIR="$tmp_bin"
export ZFSUTILITIES_SYSTEM_LIB_DIR="$tmp_bin"
mydir="$tmp_bin"
source_helper "definitely-missing-script"
EOF

    local _saved_mydir="${mydir:-}"
    . "$caller" 2>/dev/null || rc=$?
    mydir="$_saved_mydir"
    unset ZFSUTILITIES_BIN_DIR
    unset ZFSUTILITIES_CURRENT_BIN_DIR
    unset ZFSUTILITIES_SYSTEM_LIB_DIR

    rm -rf "$tmp_bin"
    assert_rc 8 "$rc"
}

# ------------------------------------------------------------------------------
# remote_zfsutilities_bin / remote_zfsutility_script
# ------------------------------------------------------------------------------

# Track SSH invocations so tests can assert on arguments.  A file is used
# because the helper is invoked inside command substitutions, which run in
# subshells and do not propagate array changes to the parent.
_test_ssh_log="$tmp_dir/ssh.log"
_test_ssh_bin_output=""
_test_ssh_rc=0

ssh() {
    printf '%s\n' "$*" >> "$_test_ssh_log"
    if [[ "$_test_ssh_rc" -eq 0 ]]; then
        printf '%s\n' "$_test_ssh_bin_output"
    fi
    return "$_test_ssh_rc"
}

test_remote_zfsutilities_bin_success() {
    test_start "remote_zfsutilities_bin resolves the remote bin path"
    : > "$_test_ssh_log"
    _test_ssh_bin_output="/usr/local/lib/zfsutilities/versions/v1.0.0/bin"
    _test_ssh_rc=0
    local result_file="$tmp_dir/remote_bin.out"
    remote_zfsutilities_bin "stewie" > "$result_file"
    assert_equals "/usr/local/lib/zfsutilities/versions/v1.0.0/bin" "$(cat "$result_file")"
    local call
    call=$(head -n1 "$_test_ssh_log")
    if [[ "$call" == *"root@stewie"* ]] &&\
       [[ "$call" == *"realpath /usr/local/lib/zfsutilities/current/bin"* ]]; then
        test_pass
    else
        test_fail "SSH invocation did not contain expected arguments: $call"
    fi
}

test_remote_zfsutilities_bin_failure() {
    test_start "remote_zfsutilities_bin returns failure when SSH fails"
    _test_ssh_calls=()
    _test_ssh_bin_output=""
    _test_ssh_rc=1
    local result rc
    result=$(remote_zfsutilities_bin "stewie" 2>/dev/null)
    rc=$?
    assert_rc 1 "$rc"
    assert_equals "" "$result"
}

test_remote_zfsutility_script_success() {
    test_start "remote_zfsutility_script returns full path on success"
    _test_ssh_calls=()
    _test_ssh_bin_output="/usr/local/lib/zfsutilities/versions/v1.0.0/bin"
    _test_ssh_rc=0
    local result
    result=$(remote_zfsutility_script "stewie" "repair-iscsi-luns")
    assert_equals "/usr/local/lib/zfsutilities/versions/v1.0.0/bin/repair-iscsi-luns" "$result"
}

test_remote_zfsutility_script_fallback() {
    test_start "remote_zfsutility_script returns bare name on failure"
    _test_ssh_calls=()
    _test_ssh_bin_output=""
    _test_ssh_rc=1
    local result
    result=$(remote_zfsutility_script "stewie" "repair-iscsi-luns")
    assert_equals "repair-iscsi-luns" "$result"
}

# ------------------------------------------------------------------------------
# log_msg fallback / configuration errors
# ------------------------------------------------------------------------------

test_log_msg_fallback_used_before_bashinit() {
    test_start "node-lib.sh provides a log_msg fallback when bashinit is absent"
    # In this test process bashinit has already been loaded, so we cannot
    # directly observe the fallback.  Instead, verify that log_msg is a function
    # and that it produced the expected FATAL output in test_find_script_missing.
    if [[ $(type -t log_msg) == "function" ]]; then
        test_pass
    else
        test_fail "log_msg is not a function"
    fi
}

