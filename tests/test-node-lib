#!/usr/bin/bash
# test-node-lib — Unit tests for lib/node-lib.sh helpers.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

# Create a temporary single-node config so sourcing node-lib.sh succeeds without
# touching /etc.
tmp_dir=$(mktemp -d)
node_conf="$tmp_dir/node.conf"
cat > "$node_conf" << 'EOF'
NODE_MODE="single-node"
EOF

export NODE_CONF="$node_conf"

# Source the library under test.  test-lib.sh has already set $mydir to the repo
# root, so node-lib.sh's guarded initializer must preserve it.
source "$mydir/lib/node-lib.sh"

# Reload find_zfsutility_script from the working tree so tests exercise the
# current implementation (including deployment-directory overrides). Preserve
# test-lib.sh's redirected log_msg afterwards.
_test_log_msg_copy=$(declare -f log_msg)
unset -f find_zfsutility_script
source "$mydir/bin/bashinit"
eval "$_test_log_msg_copy"

# ------------------------------------------------------------------------------
# find_zfsutility_script
# ------------------------------------------------------------------------------

test_find_script_lib_directory() {
    test_start "find_zfsutility_script locates a library in lib/"
    local result
    # Simulate a caller in bin/ looking for a library in lib/.
    result=$(mydir="$mydir/bin" find_zfsutility_script "node-lib.sh")
    assert_equals "$mydir/lib/node-lib.sh" "$result"
}

test_find_script_python_from_bin_directory() {
    test_start "find_zfsutility_script locates a script in python/ from bin/"
    local result
    # Simulate a caller in bin/ looking for a script in python/.
    result=$(mydir="$mydir/bin" find_zfsutility_script "profile_runner.py")
    assert_equals "$mydir/python/profile_runner.py" "$result"
}

test_find_script_bin_directory() {
    test_start "find_zfsutility_script locates a script in bin/"
    local result
    # Simulate a caller in bin/ looking for a sibling script.
    result=$(mydir="$mydir/bin" find_zfsutility_script "rescan-storage")
    assert_equals "$mydir/bin/rescan-storage" "$result"
}

test_find_script_bin_directory_clone_script() {
    test_start "find_zfsutility_script locates a clone-support script in bin/"
    local result
    # Simulate a caller in bin/ looking for a sibling script.
    result=$(mydir="$mydir/bin" find_zfsutility_script "archive-vm")
    assert_equals "$mydir/bin/archive-vm" "$result"
}

test_find_script_lib_from_python_directory() {
    test_start "find_zfsutility_script locates lib/ script from python/ dir"
    local result
    result=$(mydir="$mydir/python" find_zfsutility_script "node-lib.sh")
    assert_equals "$mydir/lib/node-lib.sh" "$result"
}

test_find_script_from_bin_directory() {
    test_start "find_zfsutility_script locates lib/ script from bin/ dir"
    local result expected
    expected="$mydir/lib/node-lib.sh"
    result=$(mydir="$mydir/bin" find_zfsutility_script "node-lib.sh")
    assert_equals "$expected" "$result"
}

test_find_script_missing() {
    test_start "find_zfsutility_script fails for a missing script"
    clear_test_log_file
    local result rc
    result=$(find_zfsutility_script "definitely-missing-script" 2>/dev/null)
    rc=$?
    assert_rc 1 "$rc"
    assert_equals "" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "WARN: Could not find sibling script: definitely-missing-script" "$log"; then
        test_pass
    else
        test_fail "Expected WARN log message not found"
    fi
}

# ------------------------------------------------------------------------------
# remote_zfsutilities_bin / remote_zfsutility_script
# ------------------------------------------------------------------------------

# Track SSH invocations so tests can assert on arguments.  A file is used
# because the helper is invoked inside command substitutions, which run in
# subshells and do not propagate array changes to the parent.
_test_ssh_log="$tmp_dir/ssh.log"
_test_ssh_bin_output=""
_test_ssh_rc=0

ssh() {
    printf '%s\n' "$*" >> "$_test_ssh_log"
    if [[ "$_test_ssh_rc" -eq 0 ]]; then
        printf '%s\n' "$_test_ssh_bin_output"
    fi
    return "$_test_ssh_rc"
}

test_remote_zfsutilities_bin_success() {
    test_start "remote_zfsutilities_bin resolves the remote bin path"
    : > "$_test_ssh_log"
    _test_ssh_bin_output="/usr/local/lib/zfsutilities/versions/v1.0.0/bin"
    _test_ssh_rc=0
    local result_file="$tmp_dir/remote_bin.out"
    remote_zfsutilities_bin "stewie" > "$result_file"
    assert_equals "/usr/local/lib/zfsutilities/versions/v1.0.0/bin" "$(cat "$result_file")"
    local call
    call=$(head -n1 "$_test_ssh_log")
    if [[ "$call" == *"root@stewie"* && "$call" == *"realpath /usr/local/lib/zfsutilities/current/bin"* ]]; then
        test_pass
    else
        test_fail "SSH invocation did not contain expected arguments: $call"
    fi
}

test_remote_zfsutilities_bin_failure() {
    test_start "remote_zfsutilities_bin returns failure when SSH fails"
    _test_ssh_calls=()
    _test_ssh_bin_output=""
    _test_ssh_rc=1
    local result rc
    result=$(remote_zfsutilities_bin "stewie" 2>/dev/null)
    rc=$?
    assert_rc 1 "$rc"
    assert_equals "" "$result"
}

test_remote_zfsutility_script_success() {
    test_start "remote_zfsutility_script returns full path on success"
    _test_ssh_calls=()
    _test_ssh_bin_output="/usr/local/lib/zfsutilities/versions/v1.0.0/bin"
    _test_ssh_rc=0
    local result
    result=$(remote_zfsutility_script "stewie" "repair-iscsi-luns")
    assert_equals "/usr/local/lib/zfsutilities/versions/v1.0.0/bin/repair-iscsi-luns" "$result"
}

test_remote_zfsutility_script_fallback() {
    test_start "remote_zfsutility_script returns bare name on failure"
    _test_ssh_calls=()
    _test_ssh_bin_output=""
    _test_ssh_rc=1
    local result
    result=$(remote_zfsutility_script "stewie" "repair-iscsi-luns")
    assert_equals "repair-iscsi-luns" "$result"
}

# ------------------------------------------------------------------------------
# log_msg fallback / configuration errors
# ------------------------------------------------------------------------------

test_log_msg_fallback_used_before_bashinit() {
    test_start "node-lib.sh provides a log_msg fallback when bashinit is absent"
    # In this test process bashinit has already been loaded, so we cannot
    # directly observe the fallback.  Instead, verify that log_msg is a function
    # and that it produced the expected FATAL output in test_find_script_missing.
    if [[ $(type -t log_msg) == "function" ]]; then
        test_pass
    else
        test_fail "log_msg is not a function"
    fi
}

# ------------------------------------------------------------------------------
# Configuration loading
# ------------------------------------------------------------------------------

two_node_conf="$tmp_dir/two-node.conf"
cat > "$two_node_conf" << 'EOF'
NODE_MODE="two-node"
STORAGE_HOST="stewie"
COMPUTE_HOST="brian"
STORAGE_IP="10.0.0.1"
IQN_PREFIX="iqn.2025-01.com.zfsutilities"
declare -A POOL_TARGET=(
    ["threeamigos"]="threeamigos"
    ["fivebays"]="fivebays"
)
EOF

test_two_node_config_loading() {
    test_start "node-lib.sh loads a temporary two-node config"
    local output
    output=$(
        NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"
        echo "STORAGE_HOST=$STORAGE_HOST"
        echo "COMPUTE_HOST=$COMPUTE_HOST"
        echo "NODE_MODE=$NODE_MODE"
    )
    assert_contains "$output" "STORAGE_HOST=stewie"
    assert_contains "$output" "COMPUTE_HOST=brian"
    assert_contains "$output" "NODE_MODE=two-node"
}

test_single_node_config_loading() {
    test_start "node-lib.sh single-node config sets STORAGE_HOST=COMPUTE_HOST=THIS_HOST"
    local output this_host
    this_host=$(hostname -s)
    output=$(
        NODE_CONF="$node_conf" source "$mydir/lib/node-lib.sh"
        echo "STORAGE_HOST=$STORAGE_HOST"
        echo "COMPUTE_HOST=$COMPUTE_HOST"
    )
    assert_contains "$output" "STORAGE_HOST=$this_host"
    assert_contains "$output" "COMPUTE_HOST=$this_host"
}

# ------------------------------------------------------------------------------
# Pool helpers
# ------------------------------------------------------------------------------

test_pool_to_target_known() {
    test_start "pool_to_target returns full IQN for a known pool"
    local result
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"; pool_to_target "threeamigos")
    assert_equals "iqn.2025-01.com.zfsutilities:threeamigos" "$result"
}

test_pool_to_target_unknown() {
    test_start "pool_to_target fails for an unknown pool"
    clear_test_log_file
    local result rc
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"; pool_to_target "unknownpool" 2>/dev/null)
    rc=$?
    assert_rc 1 "$rc"
    assert_equals "" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "WARN: Unknown pool: unknownpool" "$log"; then
        test_pass
    else
        test_fail "Expected WARN log message not found"
    fi
}

test_pool_list_two_node() {
    test_start "pool_list emits configured pool names in two-node mode"
    local result
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"; pool_list | sort)
    assert_equals "fivebays"$'\n'"threeamigos" "$result"
}

test_pool_list_single_node() {
    test_start "pool_list emits nothing in single-node mode"
    local result
    result=$(NODE_CONF="$node_conf" source "$mydir/lib/node-lib.sh"; pool_list)
    assert_equals "" "$result"
}

test_is_known_pool_known() {
    test_start "is_known_pool returns success for a known pool"
    local rc
    (NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"; is_known_pool "threeamigos")
    rc=$?
    assert_rc 0 "$rc"
}

test_is_known_pool_unknown() {
    test_start "is_known_pool returns failure for an unknown pool"
    local rc
    (NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh"; is_known_pool "unknownpool")
    rc=$?
    assert_rc 1 "$rc"
}

test_is_known_pool_single_node() {
    test_start "is_known_pool returns failure in single-node mode"
    local rc
    (NODE_CONF="$node_conf" source "$mydir/lib/node-lib.sh"; is_known_pool "threeamigos")
    rc=$?
    assert_rc 1 "$rc"
}

# ------------------------------------------------------------------------------
# Clone helpers
# ------------------------------------------------------------------------------

test_gen_mac_format() {
    test_start "gen_mac produces a Proxmox-compatible MAC address"
    local mac
    mac=$(gen_mac)
    if [[ "$mac" =~ ^BC:24:11:[0-9A-F]{2}:[0-9A-F]{2}:[0-9A-F]{2}$ ]]; then
        test_pass
    else
        test_fail "Unexpected MAC format: $mac"
    fi
}

test_gen_mac_is_random() {
    test_start "gen_mac produces different MAC addresses"
    local mac1 mac2
    mac1=$(gen_mac)
    mac2=$(gen_mac)
    assert_equals "different" "$([[ "$mac1" != "$mac2" ]] && echo different || echo same)"
}

test_get_json_archive_path_reads_config() {
    test_start "get_json_archive_path reads archive_path from JSON config"
    local config_path result expected
    config_path="$tmp_dir/archive-config.json"
    expected="/srv/zfs-utilities-archive"
    cat > "$config_path" << EOF
{"archive_path": "$expected"}
EOF
    result=$(JSON_CONFIG="$config_path" get_json_archive_path)
    assert_equals "$expected" "$result"
}

test_get_json_archive_path_missing_key() {
    test_start "get_json_archive_path returns empty when key is missing"
    local config_path result
    config_path="$tmp_dir/no-archive.json"
    echo '{}' > "$config_path"
    result=$(JSON_CONFIG="$config_path" get_json_archive_path)
    assert_equals "" "$result"
}

test_get_json_archive_path_missing_file() {
    test_start "get_json_archive_path returns empty when file is missing"
    local result
    result=$(JSON_CONFIG="$tmp_dir/does-not-exist.json" get_json_archive_path)
    assert_equals "" "$result"
}

# ------------------------------------------------------------------------------
# two-node-lib.sh compatibility wrapper
# ------------------------------------------------------------------------------

test_two_node_lib_wrapper_sources_node_lib() {
    test_start "two-node-lib.sh wrapper exposes node-lib.sh pool helpers"
    local output
    output=$(
        NODE_CONF="$two_node_conf" source "$mydir/lib/two-node-lib.sh"
        echo "target=$(pool_to_target threeamigos)"
        echo "known=$(is_known_pool threeamigos && echo yes || echo no)"
    )
    assert_contains "$output" "target=iqn.2025-01.com.zfsutilities:threeamigos"
    assert_contains "$output" "known=yes"
}

# ------------------------------------------------------------------------------
# find_zfsutility_script edge cases
# ------------------------------------------------------------------------------

test_find_script_returns_absolute_path() {
    test_start "find_zfsutility_script returns an absolute path via realpath"
    local script_dir rel_dir result expected
    script_dir="$tmp_dir/absolute"
    mkdir -p "$script_dir"
    touch "$script_dir/relative-script"
    rel_dir=$(realpath --relative-to="$mydir" "$tmp_dir")
    result=$(cd "$mydir" || exit; mydir="$rel_dir/absolute" find_zfsutility_script "relative-script")
    expected="$tmp_dir/absolute/relative-script"
    assert_equals "$expected" "$result"
}

test_find_script_prefers_same_directory() {
    test_start "find_zfsutility_script prefers same-directory match over parent"
    local subdir result
    subdir="$tmp_dir/parent/child"
    mkdir -p "$subdir"
    touch "$subdir/duplicated"
    touch "$tmp_dir/parent/duplicated"
    result=$(mydir="$subdir" find_zfsutility_script "duplicated")
    assert_equals "$subdir/duplicated" "$result"
}

test_find_script_active_path_bin() {
    test_start "find_zfsutility_script locates a script in the active PATH bin directory"
    local bin_dir result
    bin_dir="$tmp_dir/active-bin"
    mkdir -p "$bin_dir"
    touch "$bin_dir/deployed-script"
    result=$(ZFSUTILITIES_BIN_DIR="$bin_dir" find_zfsutility_script "deployed-script")
    assert_equals "$bin_dir/deployed-script" "$result"
}

test_find_script_current_version_bin() {
    test_start "find_zfsutility_script locates a script in the current version bin directory"
    local current_bin_dir result
    current_bin_dir="$tmp_dir/current-bin"
    mkdir -p "$current_bin_dir"
    touch "$current_bin_dir/versioned-script"
    result=$(ZFSUTILITIES_CURRENT_BIN_DIR="$current_bin_dir" find_zfsutility_script "versioned-script")
    assert_equals "$current_bin_dir/versioned-script" "$result"
}

test_find_script_system_lib_dir() {
    test_start "find_zfsutility_script locates a script in the system library directory"
    local system_lib_dir result
    system_lib_dir="$tmp_dir/system-lib"
    mkdir -p "$system_lib_dir"
    touch "$system_lib_dir/system-script"
    result=$(ZFSUTILITIES_SYSTEM_LIB_DIR="$system_lib_dir" find_zfsutility_script "system-script")
    assert_equals "$system_lib_dir/system-script" "$result"
}

test_bashinit_loads_paths_without_mydir() {
    test_start "bashinit loads lib/paths.sh when mydir is unset"
    local bashinit_path result
    bashinit_path="$mydir/bin/bashinit"
    result=$(
        unset mydir PATHS_LIB
        source "$bashinit_path"
        echo "${ZFSUTILITIES_CONFIG_DIR:-}"
    )
    assert_equals "/etc/zfsutilities" "$result"
}

# ------------------------------------------------------------------------------
# Run tests
# ------------------------------------------------------------------------------

test_two_node_config_loading
test_single_node_config_loading

test_pool_to_target_known
test_pool_to_target_unknown
test_pool_list_two_node
test_pool_list_single_node
test_is_known_pool_known
test_is_known_pool_unknown
test_is_known_pool_single_node

test_find_script_returns_absolute_path
test_find_script_prefers_same_directory
test_find_script_active_path_bin
test_find_script_current_version_bin
test_find_script_system_lib_dir

test_find_script_lib_directory
test_find_script_python_from_bin_directory
test_find_script_bin_directory
test_find_script_bin_directory_clone_script
test_find_script_lib_from_python_directory
test_find_script_from_bin_directory
test_find_script_missing
test_bashinit_loads_paths_without_mydir

test_remote_zfsutilities_bin_success
test_remote_zfsutilities_bin_failure
test_remote_zfsutility_script_success
test_remote_zfsutility_script_fallback

test_log_msg_fallback_used_before_bashinit

test_gen_mac_format
test_gen_mac_is_random
test_get_json_archive_path_reads_config
test_get_json_archive_path_missing_key
test_get_json_archive_path_missing_file
test_two_node_lib_wrapper_sources_node_lib

rm -rf "$tmp_dir"
teardown_test_env
test_summary
