# Convergence write tests operate on a private copy so the shared conf
# files stay pristine across the suite.
converging_conf="$tmp_dir/converging.conf"
write_converging_conf() {
    cat > "$converging_conf" << 'EOF'
NODE_MODE="two-node"
STORAGE_HOST="stewie"
COMPUTE_HOST="brian"
STORAGE_IP="10.0.0.1"
IQN_PREFIX="iqn.2025-01.com.zfsutilities"
declare -A POOL_TARGET=(
    ["threeamigos"]="threeamigos"
)
EOF
}

test_converge_iqn_prefix_rewrites_conf_with_backup() {
    test_start "converge_iqn_prefix rewrites the conf, keeps a backup, updates runtime"
    write_converging_conf
    local result
    result=$(NODE_CONF="$converging_conf" source "$mydir/lib/node-lib.sh";
        converge_iqn_prefix "iqn.2026-02.local.stewie" 2>/dev/null \
            && echo "call=ok" || echo "call=fail"
        echo "runtime=${iqn_prefix}"
        echo "backups=$(find "$tmp_dir" -maxdepth 1 -name 'converging.conf.bak-*' | wc -l)")
    if grep -q '^IQN_PREFIX="iqn.2026-02.local.stewie"$' "$converging_conf"; then
        assert_contains "$result" "call=ok"
    else
        test_fail "IQN_PREFIX line not rewritten in $converging_conf"
        return
    fi
    assert_contains "$result" "runtime=iqn.2026-02.local.stewie"
    assert_contains "$result" "backups=1"
}

test_converge_iqn_prefix_refuses_unchanged_prefix() {
    test_start "converge_iqn_prefix refuses a prefix equal to the current one"
    write_converging_conf
    local result
    result=$(NODE_CONF="$converging_conf" source "$mydir/lib/node-lib.sh";
        converge_iqn_prefix "iqn.2025-01.com.zfsutilities" 2>/dev/null \
            && echo "call=ok" || echo "call=fail")
    assert_contains "$result" "call=fail"
    if grep -q '^IQN_PREFIX="iqn.2025-01.com.zfsutilities"$' "$converging_conf"; then
        test_pass
    else
        test_fail "unchanged-prefix refusal nonetheless rewrote the conf"
    fi
}

test_converge_iqn_prefix_refuses_invalid_prefix() {
    test_start "converge_iqn_prefix refuses a non-IQN value"
    write_converging_conf
    local result
    result=$(NODE_CONF="$converging_conf" source "$mydir/lib/node-lib.sh";
        converge_iqn_prefix "not-an-iqn" 2>/dev/null \
            && echo "call=ok" || echo "call=fail")
    assert_contains "$result" "call=fail"
    if grep -q '^IQN_PREFIX="iqn.2025-01.com.zfsutilities"$' "$converging_conf"; then
        test_pass
    else
        test_fail "invalid-prefix refusal nonetheless rewrote the conf"
    fi
}

test_converge_iqn_prefix_restores_conf_without_prefix_line() {
    test_start "converge_iqn_prefix restores a conf with no IQN_PREFIX line"
    no_prefix_conf="$tmp_dir/no-prefix.conf"
    cat > "$no_prefix_conf" << 'EOF'
NODE_MODE="two-node"
STORAGE_HOST="stewie"
COMPUTE_HOST="brian"
STORAGE_IP="10.0.0.1"
declare -A POOL_TARGET=(
    ["threeamigos"]="threeamigos"
)
EOF
    local before result
    before=$(cat "$no_prefix_conf")
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh";
        node_conf="$no_prefix_conf"
        converge_iqn_prefix "iqn.2026-02.local.stewie" 2>/dev/null \
            && echo "call=ok" || echo "call=fail"
        echo "bakleft=$(find "$tmp_dir" -maxdepth 1 -name 'no-prefix.conf.bak-*' | wc -l)")
    assert_contains "$result" "call=fail"
    assert_contains "$result" "bakleft=0"
    if [[ "$before" == "$(cat "$no_prefix_conf")" ]]; then
        test_pass
    else
        test_fail "conf without IQN_PREFIX was not restored byte-identically"
    fi
}

# Regression for the unarchive-vm Step-2 ssh payload (vm-205 incident): a
# fresh remote shell inherits no pool_to_target, so the payload loads
# node-lib through bashinit's source_helper. The pool map must survive
# source_helper returning — a bare declare would be function-local to
# source_helper's frame and vanish, emptying the map under pool_to_target.
# The child bash starts clean (no inherited functions), like the ssh payload.
test_pool_map_survives_source_helper_load() {
    test_start "pool map survives loading node-lib through source_helper"
    local result rc
    result=$(REPO_BIN="$mydir/bin" NODE_CONF="$two_node_conf" bash -c '
        mydir="$REPO_BIN"
        source "$mydir/bashinit"
