# ------------------------------------------------------------------------------
# probe_target_usage
# ------------------------------------------------------------------------------

# Run probe_target_usage in a mocked subshell and report its output plus
# exit status. Parameters: remote-ssh stdout (printf %b format), remote-ssh
# exit status, local hostname (short), IQN. Everything the probe touches is
# mocked: hostname (storage-host gate), targetcli (ACL/demo context; no
# initiator ACLs, demo mode on), ssh (the compute-host payload), and
# log_msg (echo, so evidence lines are assertable).
run_probe() {
    local _ssh_out="$1" _ssh_rc="$2" _host="$3" _iqn="$4"
    (
        storage_host="zteststor"
        compute_host="ztestcomp"
        hostname() {
            if [[ "$1" == "-s" ]]; then
                printf '%s\n' "$_host"
                return 0
            fi
            command hostname "$@"
        }
        targetcli() {
            case "$*" in
                *generate_node_acls*) printf 'generate_node_acls=1\n' ;;
            esac
            return 0
        }
        ssh() { printf '%b' "$_ssh_out"; return "$_ssh_rc"; }
        log_msg() { echo "$*"; }
        probe_target_usage "$_iqn"
    )
}

_PROBE_IQN="iqn.2099-01.local.zteststor:threeamigos"

test_probe_target_usage_verified_unused() {
    test_start "probe_target_usage returns 0 when nothing references the target"
    local out rc
    out=$(run_probe "SESSIONS:0" 0 "zteststor" "$_PROBE_IQN")
    rc=$?
    if [[ $rc -ne 0 ]]; then
        test_fail "Expected rc=0, got $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"verified unused"* ]]; then
        test_fail "Verified-unused verdict missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"demo-mode ACLs"* ]]; then
        test_fail "Demo-mode ACL context missing; output:\n$out"
