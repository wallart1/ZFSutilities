source "$mydir/bashinit"
bashinit
set -euo pipefail
log_msg "INFO: remote-mode payload alive (vmid=$1, disks=$2)"
echo "PAYLOAD-OK"
PAYLOAD
    )
    rc=$?
    assert_rc 0 "$rc"
