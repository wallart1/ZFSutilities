# IQN-prefix drift fence (storage host + local LIO only): pool_to_target
# warns once when the constructed IQN is absent from the live target tree,
# and stays silent when the tree already carries it. hostname/targetcli are
# overridden so the storage-host gate opens without touching the host.
test_pool_to_target_warns_when_target_missing_in_lio() {
    test_start "pool_to_target warns when the constructed IQN is missing from LIO"
    clear_test_log_file
    local result
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh";
        hostname() { echo stewie; }
        targetcli() { printf 'Target 1: iqn.2026-02.local.stewie:threeamigos\n'; }
        pool_to_target "threeamigos" 2>/dev/null)
    assert_equals "iqn.2025-01.com.zfsutilities:threeamigos" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "does not exist in the local LIO target tree" "$log"; then
        test_pass
    else
        test_fail "Expected LIO drift WARN not logged"
    fi
}

test_pool_to_target_silent_when_target_in_lio() {
    test_start "pool_to_target stays silent when the constructed IQN exists in LIO"
    clear_test_log_file
    local result
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh";
        hostname() { echo stewie; }
        targetcli() { printf 'Target 1: iqn.2025-01.com.zfsutilities:threeamigos\n'; }
        pool_to_target "threeamigos" 2>/dev/null)
    assert_equals "iqn.2025-01.com.zfsutilities:threeamigos" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "does not exist in the local LIO target tree" "$log"; then
        test_fail "LIO drift WARN logged although the target exists"
    else
        test_pass
    fi
}

# The warn path must never fire off the storage host (the compute host has
# no LIO tree to verify against), even with targetcli present.
test_pool_to_target_no_lio_probe_off_storage_host() {
    test_start "pool_to_target skips the LIO probe when not on the storage host"
    clear_test_log_file
    local result
    result=$(NODE_CONF="$two_node_conf" source "$mydir/lib/node-lib.sh";
        hostname() { echo brian; }
        targetcli() { echo "SHOULD-NOT-RUN"; return 0; }
        pool_to_target "threeamigos" 2>/dev/null)
    assert_equals "iqn.2025-01.com.zfsutilities:threeamigos" "$result"
    local log
    log=$(get_test_log_file)
    if grep -q "SHOULD-NOT-RUN" "$log"; then
        test_fail "targetcli probe ran off the storage host"
    else
        test_pass
    fi
}

