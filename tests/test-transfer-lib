test_transfer_do_with_pacer_and_pv_when_inherit() {
    test_start "transfer_do paces before pv when a rate limit is set"
    reset_state
    local stage_capture="$_mock_zfs_state_dir/transfer_stage_order"
    : > "$stage_capture"
    # Pipeline child STARTUP order is not guaranteed (the scheduler can run
    # either subshell first), so pv records only after draining its stdin:
    # its marker then lands strictly after the pacer's, proving the data
    # flows send -> pacer -> pv (pv displays the paced rate).
    pv() {
        local received
        received=$(cat)
        echo "pv $* :: ${received}" >> "$stage_capture"
        printf '%s' "$received"
        return 0
    }
    python3() {
        if [[ "${1:-}" != *pace_stream.py ]]; then
            command python3 "$@"
            return $?
        fi
        echo "pacer ${*:2}" >> "$stage_capture"
        cat
        return 0
    }
    transfer_rate_limit="100M"
    ZFSUTILITIES_LOG_INHERIT="Y" \
        transfer_do "Send/receive" "-cw" "-uv" "Y" "5000000" "src@snap" "pool/dest" \
        2>/dev/null
    local rc=$?
    unset -f pv python3
    assert_rc 0 "$rc"
    local order
    order=$(cat "$stage_capture" 2>/dev/null)
    if [[ "$order" != "pacer 100M
pv -fpterb -s 5000000 :: " ]]; then
        test_fail "Unexpected stage order:\n$order"
        return
    fi
}

