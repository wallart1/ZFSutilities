#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-transfer-lib — Unit tests for the shared ZFS transfer helpers in
# lib/transfer-lib.sh (pv argument construction, resume-token validation and
# classification, token abort, space check, and the transfer pipeline).

# shellcheck disable=SC2218
# (source() override below is intentionally not active for test-lib.sh itself.)
builtin source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

repo_root="$mydir"

# Keep test-lib's log_msg mock: skip re-sourcing bashinit from the library.
source() {
    local expanded="${1/#\~/$HOME}"
    [[ "$expanded" == "$HOME/bashinit" ]] && return 0
    [[ "$expanded" == "$repo_root/bin/bashinit" ]] && return 0
    builtin source "$@"
}

source "$mydir/lib/transfer-lib.sh"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

reset_state() {
    clear_test_log_file
    transfer_pv_args=()
    transfer_rate_limit=""
    ZFSUTILITIES_LOG_INHERIT=""
    dryrun="N"
    _mock_zfs_props=()
    unset _transfer_resolver
    : > "$_zfs_capture_file"
    _mock_zfs_send_size="0"
    _mock_zfs_send_rc=0
    _mock_zfs_send_err=""
    _mock_zfs_cmd_rc=0
}

# Override zfs to record invocations to a file (pipeline stages run in
# subshells, so arrays would not survive); serves `zfs get` from
# _mock_zfs_props and `zfs send -nP` from _mock_zfs_send_size; send/receive
# rc is controlled by _mock_zfs_cmd_rc.
_zfs_capture_file="$_mock_zfs_state_dir/transfer_zfs_calls"

zfs() {
    echo "zfs $*" >> "$_zfs_capture_file"
    case "$1" in
        get)
            local prop="" dataset="" value_only=0
            local -a args=("${@:2}")
            local i
            for (( i=0; i<${#args[@]}; i++ )); do
                case "${args[$i]}" in
                    -H*|-p*) ;;
                    -o)
                        [[ "${args[$((i+1))]}" == "value" ]] && value_only=1
                        ((i++))
                        ;;
                    *)
                        if [[ -z "$prop" ]]; then
                            prop="${args[$i]}"
                        else
                            dataset="${args[$i]}"
                        fi
                        ;;
                esac
            done
            local value="${_mock_zfs_props[$dataset:$prop]:--}"
            if [[ $value_only -eq 1 ]]; then
                echo "$value"
            else
                printf '%s\t%s\t%s\n' "$dataset" "$prop" "$value"
            fi
            return 0
            ;;
        send)
            # Getopt fidelity, mirroring real zfs: an argument-taking
            # option (-i/-I/-t) embedded in a short-option cluster makes
            # the next cluster character its argument, so any snapshot
            # names after it land as extra positionals — real zfs fails
            # with "too many arguments". Such options must be standalone
            # argv words; two positionals without one are rejected too.
            local _gopt _prev='' _pos=0 _incr=0
            for _gopt in "${@:2}"; do
                # A short-option cluster (dash + two or more letters)
                # holding i/I/t is exactly the broken form; globs suffice.
                if [[ "$_gopt" == -* && "${#_gopt}" -gt 2 && "$_gopt" == *[iIt]* ]]; then
                    echo "too many arguments" >&2
                    return 1
                fi
                if [[ "$_prev" == -I || "$_prev" == -i || "$_prev" == -t ]]; then
                    _prev=
                    continue
                fi
                case "$_gopt" in
                    -I|-i|-t) _incr=1; _prev=$_gopt ;;
                    -*) ;;
                    *) _pos=$((_pos + 1)) ;;
                esac
            done
            if (( _pos > 1 && _incr == 0 )); then
                echo "too many arguments" >&2
                return 1
            fi
            if [[ "$*" == *"-nP"* ]]; then
                if [[ "${_mock_zfs_send_rc:-0}" != "0" ]]; then
                    echo "${_mock_zfs_send_err:-send failed}" >&2
                    return "$_mock_zfs_send_rc"
                fi
                printf 'size\t%s\n' "$_mock_zfs_send_size"
                return 0
            fi
            return "${_mock_zfs_cmd_rc:-0}"
            ;;
        receive)
            return "${_mock_zfs_cmd_rc:-0}"
            ;;
        *)
            return 0
            ;;
    esac
}

get_log() {
    cat "$(get_test_log_file)" 2>/dev/null
}

# ---------------------------------------------------------------------------
# transfer_pv_args
# ---------------------------------------------------------------------------

test_pv_args_headless_no_rate() {
    test_start "transfer_pv_args empty in headless mode without rate limit"
    reset_state
    transfer_pv_args "5000000" "Y" 2>/dev/null
    assert_array_len 0 "${transfer_pv_args[@]}"
}

test_pv_args_use_pv_no() {
    test_start "transfer_pv_args empty when use_pv is not Y"
    reset_state
    transfer_pv_args "5000000" "N" 2>/dev/null
    assert_array_len 0 "${transfer_pv_args[@]}"
}

test_pv_args_log_inherit() {
    test_start "transfer_pv_args forces progress output when LOG_INHERIT=Y"
    reset_state
    ZFSUTILITIES_LOG_INHERIT="Y" transfer_pv_args "5000000" "Y" 2>/dev/null
    assert_golden test_pv_args_log_inherit "$(printf '%s\n' "${transfer_pv_args[@]}")"
}

test_pace_args_without_rate() {
    test_start "transfer_pace_args empty when no rate limit is set"
    reset_state
    transfer_pace_args 2>/dev/null
    assert_array_len 0 "${transfer_pace_args[@]}"
}

test_pace_args_with_rate() {
    test_start "transfer_pace_args builds the pacer stage from transfer_rate_limit"
    reset_state
    transfer_rate_limit="50M"
    transfer_pace_args
    assert_rc 0 "$?"
    if [[ ${#transfer_pace_args[@]} -ne 3 ]]; then
        test_fail "Expected python3/pacer/rate argv, got: ${transfer_pace_args[*]}"
        return
    fi
    if [[ "${transfer_pace_args[0]}" != "python3" \
            || "${transfer_pace_args[1]}" != */pace_stream.py \
            || "${transfer_pace_args[2]}" != "50M" ]]; then
        test_fail "Unexpected pacer argv: ${transfer_pace_args[*]}"
        return
    fi
}

test_pace_args_unresolvable_pacer() {
    test_start "transfer_pace_args fails when the pacer cannot be resolved"
    reset_state
    # transfer_pacer is a sourced library function: save its body and
    # restore it after the override (unset -f would delete it outright).
    local _orig_pacer
    _orig_pacer=$(declare -f transfer_pacer)
    transfer_pacer() { return 1; }
    transfer_rate_limit="100M"
    transfer_pace_args 2>/dev/null
    local rc=$?
    eval "$_orig_pacer"
    assert_rc 1 "$rc"
    assert_array_len 0 "${transfer_pace_args[@]}"
}

test_transfer_do_fatals_when_pacer_missing() {
    test_start "transfer_do refuses to run unlimited when the pacer is missing"
    reset_state
    local _orig_pacer
    _orig_pacer=$(declare -f transfer_pacer)
    transfer_pacer() { return 1; }
    transfer_rate_limit="100M"
    transfer_do "Send/receive" "-cw" "-uv" "N" "5000000" "src@snap" "pool/dest" \
        2>/dev/null
    local rc=$?
    eval "$_orig_pacer"
    assert_rc 1 "$rc"
    local log
    log=$(get_log)
    assert_contains "$log" "FATAL: Rate limit set but pace_stream.py not found"
    if [[ -s "$_zfs_capture_file" ]]; then
        test_fail "pipeline must not run without pacing"
        return
    fi
    test_pass
}

test_pv_args_never_rate_limits() {
    test_start "transfer_pv_args carries progress flags only, never -L"
    reset_state
    transfer_rate_limit="50M"
    ZFSUTILITIES_LOG_INHERIT="Y" transfer_pv_args "5000000" "Y" 2>/dev/null
    if printf '%s\n' "${transfer_pv_args[@]}" | grep -q -- '-L'; then
        test_fail "transfer_pv_args still rate limits: ${transfer_pv_args[*]}"
        return
    fi
    assert_golden test_pv_args_log_inherit "$(printf '%s\n' "${transfer_pv_args[@]}")"
}

# ---------------------------------------------------------------------------
# transfer_resume_token_stale
# ---------------------------------------------------------------------------

test_token_stale_strings() {
    test_start "transfer_resume_token_stale recognizes known stale strings"
    reset_state
    local s
    for s in "snapshot no longer exists" "token @--head-- invalid" \
        "Invalid argument" "stream does not match destination" \
        "destination has been modified"; do
        if ! transfer_resume_token_stale "$s"; then
            test_fail "Expected stale classification for '$s'"
            return
        fi
    done
    if transfer_resume_token_stale "some other error"; then
        test_fail "Unexpected stale classification for unrelated error"
        return
    fi
    test_pass
}

