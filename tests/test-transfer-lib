test_pace_args_resolver_failure_fails_open() {
    test_start "a failing resolver WARNs and paces at the activity limit"
    reset_state
    transfer_rate_limit="50M"
    local fake="$_mock_zfs_state_dir/failing_resolver"
    printf '#!/usr/bin/bash\necho "enclosure_rate: rate resolution failed: boom" >&2\nexit 1\n' \
        > "$fake"
    chmod +x "$fake"
    ZFSUTILITIES_ENCLOSURE_RATE="$fake" \
        transfer_pace_args "tank/a" "backup/b" 2>/dev/null
    local argv
    argv="${transfer_pace_args[*]}"
    if [[ "$argv" != "python3 "* || "$argv" != *" 50M" ]]; then
        test_fail "Expected fail-open pacer at 50M, got: $argv"
        return
    fi
    local log
    log=$(get_log)
    assert_contains "$log" \
        "WARN: Enclosure rate resolution failed; ignoring enclosure caps for this transfer"
}

