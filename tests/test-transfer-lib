# ---------------------------------------------------------------------------
# Endpoint-aware pacing (per-enclosure rate governance)
# ---------------------------------------------------------------------------

# Write a resolver fake at $1 that appends its argv to $2 and prints $3
# (empty answer = unlimited).
make_resolver_fake() {
    local fake="$1" capture="$2" answer="$3"
    {
        echo '#!/usr/bin/bash'
        printf '%s\n' "printf '%s\\n' \"\$*\" >> '$capture'"
        if [[ -n "$answer" ]]; then
            printf '%s\n' "printf '%s\\n' '$answer'"
        else
            printf '%s\n' "printf '\\n'"
        fi
        echo 'exit 0'
    } > "$fake"
    chmod +x "$fake"
}

test_pace_args_cap_without_activity_rate() {
    test_start "an enclosure cap paces the transfer with no activity rate set"
    reset_state
    ZFSUTILITIES_TEST_ENCLOSURE_RATE="40M" \
        transfer_pace_args "tank/src/ds@snap" "backup/dest" 2>/dev/null
    local -a argv=("${transfer_pace_args[@]}")
    if [[ ${#argv[@]} -ne 3 || "${argv[2]}" != "40M" ]]; then
        test_fail "Expected pacer argv at 40M, got: ${argv[*]}"
        return
    fi
    assert_contains "$(get_log)" "INFO: Enclosure rate cap applied: 40M"
}

test_pace_args_resolver_min_combination_call() {
    test_start "the resolver is called with --min-with and both endpoint pools"
    reset_state
    transfer_rate_limit="50M"
    local capture="$_mock_zfs_state_dir/resolver_argv"
    : > "$capture"
    make_resolver_fake "$_mock_zfs_state_dir/fake_resolver" "$capture" "30M"
    ZFSUTILITIES_ENCLOSURE_RATE="$_mock_zfs_state_dir/fake_resolver" \
        transfer_pace_args "tank/src/ds@snap" "backup/dest" 2>/dev/null
    local argv seen
    argv="${transfer_pace_args[*]}"
    seen=$(cat "$capture" 2>/dev/null)
    assert_contains "$seen" "--min-with 50M tank backup"
    if [[ "$argv" != "python3 "* || "$argv" != *" 30M" ]]; then
        test_fail "Expected pacer at the combined rate 30M, got: $argv"
        return
    fi
    assert_contains "$(get_log)" "INFO: Enclosure rate cap applied: 30M"
}

test_pace_args_resolver_same_pool_deduplicated() {
