#!/usr/bin/env bash
# test-itf-lab-stages — Unit tests for the lab-layer builders in
# tests/integrated/journeys/common.sh and tests/integrated/lib/vmos-lib.sh
# (recovery-scenario campaign G0: test-pools stage, single-node lab,
# VM-OS image machinery, workload helpers, reboot stage, keystore
# helpers; campaign G1: the reboot begin/wait split, the boot-journal
# parser, the key ceremony, load-keys/keystatus gates, link-presence /
# fence-tick / fallout observables, and the boot-workload staging).
#
# Pattern (from test-itf-driver's common.sh block): source the library
# in-process inside a subshell with stubbed transports that record every
# call, invoke the stage/helper, and assert on the recorded calls, the
# written files, and the J_* globals.  No test can reach a real base
# host: every itf_qm/itf_guest_* transport is a stub.  DRY_RUN variants
# additionally pin the exact guarded qm commands the stages emit.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

ITF_COMMON="$mydir/tests/integrated/journeys/common.sh"
tmp_dir=$(mktemp -d)

# Minimal site-config values the stages read (never a real environment;
# transports are stubbed or the config points at .invalid hosts).
export ITF_BASE_HOSTS=(base.invalid)
export ITF_SSH_USER=testuser
export ITF_VMID_FIRST=8000
export ITF_VMID_LAST=8099
export ITF_GUEST_STORAGE=itfguests
export ITF_GUEST_POOL_DISK_GB=100
export ITF_KEYFILE_NAME=zfstest1.key
export ITF_KEYSTORE_PASSPHRASE=unit-test-passphrase
export ITF_CACHE_DIR="$tmp_dir/cache"
export ITF_HTTP_PORT=8123
mkdir -p "$ITF_CACHE_DIR"

