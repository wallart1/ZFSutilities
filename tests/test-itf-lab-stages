ITF_VMOS_LIB="$mydir/tests/integrated/lib/vmos-lib.sh"

test_vmos_wait_guest_ping_arg_order() {
    test_start "agent ping uses qm agent <vmid> ping (VMID before command)"
    local work="$tmp_dir/vmos-ping"
    mkdir -p "$work"
    (
        # shellcheck disable=SC2034  # consumed by the sourced library
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_VMOS_LIB"
        _calls=""
        itf_qm() { _calls+="qm:$(printf '%s:' "$@") "; return 0; }
        itf_vmos_wait_guest_ping base.invalid 8005 5
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    # PVE 9 takes the VMID BEFORE the agent command; the inverse order
    # silently never answers (live-proven on 9.2.21).
    assert_contains "$(cat "$work/calls")" "qm:base.invalid:agent:8005:ping:"
}

test_vmos_stamp_short_circuit() {
    test_start "vmos build skips entirely when the cache matches the stamp"
    local work="$tmp_dir/vmos-skip"
    mkdir -p "$work"
    # A matching cache: image + stamp over the CURRENT inputs.  The
    # image must be non-empty — the cache check is -s (an empty file
    # means "no image").
    echo fake-image > "$ITF_CACHE_DIR/itf-vmos.raw.gz"
    (
        # shellcheck disable=SC2034  # consumed by the sourced library
        ITF_RUN_DIR="$work"
        ITF_SSH_KEY="/dev/null"
        # shellcheck disable=SC1090
        source "$ITF_VMOS_LIB"
        _calls=""
        itf_qm() { _calls+="qm "; return 0; }
        itf_step() { _calls+="step:$1:$2 "; return 0; }
        itf_vmos_stamp_want > "$ITF_CACHE_DIR/itf-vmos.stamp"
        itf_vmos_build
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    assert_contains "$(cat "$work/calls")" "step:skip:VM-OS image build"
    # A skip must not touch any base host.
    [[ "$(cat "$work/calls")" != *"qm "* ]] && : > "$work/no-qm" || true
    assert_contains "$(cat "$work/no-qm" 2>/dev/null || echo missing)" ""
    rm -f "$ITF_CACHE_DIR/itf-vmos.raw.gz" "$ITF_CACHE_DIR/itf-vmos.stamp"
}

test_vmos_dump_command_shape() {
    test_start "vmos dump resolves the volume and runs the audited dd|gzip"
    local work="$tmp_dir/vmos-dump"
    mkdir -p "$work"
    (
        # shellcheck disable=SC2034  # consumed by the sourced library
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_VMOS_LIB"
        _calls=""
        itf_qm() {
            # qm config output carrying the system disk volid.
            if [[ "$2" == config ]]; then
                printf 'scsi0: itfguests:vm-8005-disk-0,discard=on\n'
            fi
            return 0
        }
        itf_pvesm() {
            _calls+="pvesm:$2:$3 "
            [[ "$2" == path ]] && printf '/dev/itfguests/vm-8005-disk-0\n'
            return 0
        }
        itf_base_exec() {
            _calls+="base-exec:[$2] "
            return 0
        }
        itf_base_get() {
            _calls+="base-get:$2:$3 "
            echo fake-dump > "$3"
            return 0
        }
        itf_log_action() { _calls+="audit:[$2] "; return 0; }
        itf_vmos_dump_to_run_dir base.invalid 8005
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    # pvesm path resolution is proven by the dd target below (the pvesm
    # stub itself runs inside a command substitution, so its recording
    # does not survive the subshell).
    assert_contains "$(cat "$work/calls")" \
        "base-exec:[dd if=/dev/itfguests/vm-8005-disk-0 bs=4M status=none"
    assert_contains "$(cat "$work/calls")" "| gzip -1c"
    assert_contains "$(cat "$work/calls")" "chmod 644"
    assert_contains "$(cat "$work/calls")" "base-get:/tmp/itf-vmos-dump-"
    assert_contains "$(cat "$work/calls")" "audit:[vmos-dump: itfguests:vm-8005-disk-0"
    assert_contains "$(cat "$work/calls")" "rm -f"
}

