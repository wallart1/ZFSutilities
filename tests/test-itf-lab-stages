test_test_pools_success_path() {
    test_start "test_pools attaches the disk, runs the docs recipe, snapshots"
    local work="$tmp_dir/pools-ok"
    mkdir -p "$work"
    (
        # shellcheck disable=SC2034  # consumed by the sourced stage
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_COMMON"
        _calls=""
        itf_qm() {
            _calls+="qm:$2:$3:$4:$5 "
            return 0
        }
        itf_guest_exec() {
            _calls+="exec:$1 "
            return 0
        }
        itf_guest_put() {
            _calls+="put:$1:$3 "
            return 0
        }
        itf_guest_snapshot() {
            _calls+="snap:$1:$2:$3 "
            return 0
        }
        itf_step() { _calls+="step:$1:$2 "; return 0; }
        itf_artifact() { _calls+="artifact:$1 "; return 0; }
        itf_journey_stage_test_pools j99 base.invalid 8005 10.1.1.1
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    assert_contains "$(cat "$work/calls")" \
        "qm:set:8005:--scsi1:itfguests:100"
    assert_contains "$(cat "$work/calls")" "exec:10.1.1.1"
    assert_contains "$(cat "$work/calls")" "put:10.1.1.1:/root/itf-pools.sh"
    assert_contains "$(cat "$work/calls")" "snap:base.invalid:8005:pools-created"
    assert_contains "$(cat "$work/calls")" "step:pass:pool disk attached"
    assert_contains "$(cat "$work/calls")" "step:pass:test pools created"
    assert_contains "$(cat "$work/calls")" "artifact:pools"
}

