    cat > "$work/journal" <<'EOF'
targetctl: backed up saveconfig.json
targetctl: restoring boot config (encrypted backstores excluded)
targetctl: post-restore verification FAILED — live LUNs differ from the pool map; do NOT save config until reconciled
DRIFT: backstore vm-101-disk-1: map backstore no longer exists live
EOF
    cat > "$work/order-ok" <<'EOF'
12:Finished zfs-import-cache.service.
20:targetctl: restoring boot config (encrypted backstores excluded)
