test_vm_workload_helpers_use_agent_channel() {
    test_start "workload start/sample/checksum drive qm guest exec, not ssh"
    local work="$tmp_dir/vm-wl"
    mkdir -p "$work"
    (
        # shellcheck disable=SC2034  # consumed by the sourced stages
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_COMMON"
        _calls=""
        itf_guest_exec() {
            _calls+="exec:[$2] "
            # qm guest exec result as qm REALLY prints it: a pretty-printed
            # JSON dict whose payload key is "out-data" (live-proven on
            # PVE 9.2.21 — the G0 fixtures invented an "out" key, which
            # masked the parser bug until the first live j15 run).
            case "$2" in
                *cat\ /workload.log*)
                    printf '{\n   "exitcode" : 0,\n   "exited" : 1,\n   "out-data" : "1700000000\\n1700000001\\n",\n   "out-truncated" : 0\n}\n' ;;
                *cksum*)
                    printf '{\n   "exitcode" : 0,\n   "exited" : 1,\n   "out-data" : "4294967295 42 /workload.log\\n",\n   "out-truncated" : 0\n}\n' ;;
                *) return 0 ;;
            esac
            return 0
        }
        itf_step() { _calls+="step:$1 "; return 0; }
        itf_vm_workload_start 10.2.2.2 101
        itf_vm_workload_sample 10.2.2.2 101 > "$work/sample"
        itf_vm_workload_checksum 10.2.2.2 101 > "$work/cksum"
        itf_vm_workload_stop 10.2.2.2 101
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
