test_test_pools_dry_run_emits_guarded_attach() {
    test_start "test_pools DRY_RUN emits the guarded scsi1 attach, nothing else"
    local work="$tmp_dir/pools-dryrun"
    mkdir -p "$work"
    (
        # shellcheck disable=SC2034  # consumed by the sourced stage
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_COMMON"
        _dry=""
        itf_qm() {
            # Mirror base-lib's DRY_RUN contract for the mutating verb:
            # the guarded command is echoed, never executed.
            # Call shape: itf_qm <base> set <vmid> --scsi1 <storage>:<gb>
            if [[ -n "${ITF_DRY_RUN:-}" ]]; then
                _dry+="[dry-run] $1: qm set $3 --scsi1 $5 "
                return 0
            fi
            return 0
        }
        itf_guest_exec() { return 0; }
        itf_guest_put() { return 0; }
        itf_guest_snapshot() { return 0; }
        itf_step() { return 0; }
        itf_artifact() { return 0; }
        ITF_DRY_RUN=1 itf_journey_stage_test_pools j99 base.invalid 8005 10.1.1.1
        echo "$?" > "$work/rc"
        printf '%s' "$_dry" > "$work/dry"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    assert_contains "$(cat "$work/dry")" \
        "[dry-run] base.invalid: qm set 8005 --scsi1 itfguests:100"
}

