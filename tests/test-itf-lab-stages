        # shellcheck disable=SC2034  # consumed by the sourced stage
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1090
        source "$ITF_COMMON"
        _calls=""
        itf_qm() { _calls+="qm-refused "; return 22; }
        itf_guest_exec() { return 0; }
        itf_guest_put() { return 0; }
        itf_guest_snapshot() { _calls+="snap "; return 0; }
        itf_step() { _calls+="step:$1:$2 "; return 0; }
        itf_artifact() { return 0; }
