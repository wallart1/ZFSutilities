test_vmos_build_orchestration() {
    test_start "vmos build runs install -> dump -> self-verify -> cache"
    local work="$tmp_dir/vmos-build"
    mkdir -p "$work"
    echo fake-iso > "$ITF_CACHE_DIR/itf-debian-netinst.iso"
    (
        # shellcheck disable=SC2034  # consumed by the build's report context
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC2034  # consumed by itf_vmos_stamp_want
        ITF_SSH_KEY="/dev/null"
        # shellcheck disable=SC1090
        source "$ITF_VMOS_LIB"
        # Pre-load common.sh so the build's conditional source keeps the
        # stub below in place.
        # shellcheck disable=SC1090
        source "$mydir/tests/integrated/journeys/common.sh"
        _calls=""
        itf_journey_stage_os() {
            _calls+="install:[$*] "
            # shellcheck disable=SC2034  # consumed by the build's locals
            J_VMID=8005 J_GUEST_IP=10.1.1.1
            return 0
        }
        itf_qm() {
            _calls+="qm:$(printf '%s:' "$@") "
            if [[ "$2" == config ]]; then
                printf 'scsi0: itfguests:vm-8005-disk-0\n'
            fi
            return 0
        }
        itf_pvesm() {
            [[ "$2" == path ]] && printf '/dev/itfguests/vm-8005-disk-0\n'
            return 0
        }
        itf_base_exec() { _calls+="base-exec "; return 0; }
        itf_base_get() { echo fake-dump > "$3"; return 0; }
        itf_log_action() { return 0; }
        itf_guest_stop() { _calls+="stop "; return 0; }
        itf_guest_start() { _calls+="start "; return 0; }
        itf_guest_ip() { _calls+="ip "; echo 10.1.1.1; return 0; }
        itf_guest_put() { _calls+="put "; return 0; }
        itf_guest_exec() { _calls+="exec "; return 0; }
        itf_guest_destroy() { _calls+="destroy:$2 "; return 0; }
        itf_vmos_wait_guest_ping() { _calls+="ping "; return 0; }
        itf_step() { _calls+="step:$1:$2 "; return 0; }
        itf_vmos_build --disk-gb 4
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    assert_contains "$(cat "$work/calls")" \
        "install:[itf-vmos-build itf-vmos --base base.invalid --sysdisk 4]"
    # The install disk matches the image size (a 32G default dump would
    # overflow the 4G verify disk — live-proven the hard way).
    # The installer-time CPU freeze is cleared before any later start
    # (the live first run wedged exactly here: frozen start, silent
    # agent, IP timeout).
    assert_contains "$(cat "$work/calls")" "qm:base.invalid:set:8005:--freeze:0:"
    assert_contains "$(cat "$work/calls")" \
        "qm:base.invalid:set:8005:--scsi1:itfguests:4:"
    assert_contains "$(cat "$work/calls")" \
        "qm:base.invalid:set:8005:--boot:order=scsi1:"
    assert_contains "$(cat "$work/calls")" "step:pass:build guest stopped"
    assert_contains "$(cat "$work/calls")" "step:pass:system disk dumped"
    assert_contains "$(cat "$work/calls")" "step:pass:image restored to verify disk"
    assert_contains "$(cat "$work/calls")" "step:pass:restored image boots with agent"
    assert_contains "$(cat "$work/calls")" "destroy:8005"
    assert_contains "$(cat "$work/calls")" "step:pass:VM-OS image cached"
    # Cache + stamp landed after the destroy.
    [[ -s "$ITF_CACHE_DIR/itf-vmos.raw.gz" ]] && : > "$work/cached" || true
    assert_contains "$(cat "$work/cached" 2>/dev/null || echo missing)" ""
    [[ -f "$ITF_CACHE_DIR/itf-vmos.stamp" ]] && : > "$work/stamped" || true
    assert_contains "$(cat "$work/stamped" 2>/dev/null || echo missing)" ""
    rm -f "$ITF_CACHE_DIR/itf-vmos.raw.gz" "$ITF_CACHE_DIR/itf-vmos.stamp" \
        "$ITF_CACHE_DIR/itf-debian-netinst.iso"
}

