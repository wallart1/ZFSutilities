#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-startdocserver — Unit tests for startdocserver helper functions

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"

source "$mydir/bin/startdocserver"

# Override set -euo pipefail from startdocserver so test failures don't abort early
set +euo pipefail

# =============================================================================
# Mock helpers
# =============================================================================

_mock_curl_http_code=""
_mock_pgrep_output=""
_mock_lsof_output=""
_mock_fuser_output=""
_mock_server_cwd=""

_stop_server_called=""
_start_server_called=""

curl() {
    if [[ "$*" == *"-w %{http_code}"* ]]; then
        echo -n "$_mock_curl_http_code"
        return 0
    fi
    return 1
}

pgrep() {
    if [[ "$*" == *"mkdocs serve"* ]]; then
        if [[ -n "$_mock_pgrep_output" ]]; then
            echo "$_mock_pgrep_output"
            return 0
        fi
    fi
    return 1
}

lsof() {
    if [[ "$*" == *":8000"* ]]; then
        if [[ -n "$_mock_lsof_output" ]]; then
            echo "$_mock_lsof_output"
            return 0
        fi
    fi
    return 1
}

fuser() {
    if [[ "$*" == *"8000/tcp"* ]]; then
        if [[ -n "$_mock_fuser_output" ]]; then
            echo "$_mock_fuser_output"
            return 0
        fi
    fi
    return 1
}

_python3_args_file=""
_python3_cwd_file=""
_python3_rc=0

# Records to files (not variables) because _refresh_static_site invokes
# python3 inside a subshell.
python3() {
    [[ -n "$_python3_args_file" ]] && echo "$*" >> "$_python3_args_file"
    [[ -n "$_python3_cwd_file" ]] && echo "$PWD" > "$_python3_cwd_file"
    return "${_python3_rc}"
}

_get_server_cwd() {
    echo "$_mock_server_cwd"
}

_stop_server() {
    _stop_server_called="$1"
}

start_server() {
    _start_server_called="yes"
}

reset_mocks() {
    _mock_curl_http_code=""
    _mock_pgrep_output=""
    _mock_lsof_output=""
    _mock_fuser_output=""
    _mock_server_cwd=""
    _stop_server_called=""
    _start_server_called=""
    _python3_args_file=""
    _python3_cwd_file=""
    _python3_rc=0
}

# =============================================================================
# Tests
# =============================================================================

test_is_server_running_true() {
    reset_mocks
    _mock_curl_http_code="200"
    test_start "is_server_running returns true on HTTP 200"
    if is_server_running; then
        test_pass
    else
        test_fail "Expected true, got false"
    fi
}

test_is_server_running_false() {
    reset_mocks
    _mock_curl_http_code="000"
    test_start "is_server_running returns false on no response"
    if ! is_server_running; then
        test_pass
    else
        test_fail "Expected false, got true"
    fi
}

test_get_server_pid_lsof() {
    reset_mocks
    _mock_lsof_output="12345"
    test_start "_get_server_pid finds PID via lsof"
    local pid
    pid=$(_get_server_pid)
    assert_equals "12345" "$pid"
}

test_get_server_pid_fuser() {
    reset_mocks
    _mock_lsof_output=""
    _mock_fuser_output="67890"
    test_start "_get_server_pid falls back to fuser"
    local pid
    pid=$(_get_server_pid)
    assert_equals "67890" "$pid"
}

test_get_server_pid_pgrep() {
    reset_mocks
    _mock_lsof_output=""
    _mock_fuser_output=""
    _mock_pgrep_output="11111"
    test_start "_get_server_pid falls back to pgrep"
    local pid
    pid=$(_get_server_pid)
    assert_equals "11111" "$pid"
}

test_is_server_serving_expected_dir_match() {
    reset_mocks
    local tmpdir
    tmpdir=$(mktemp -d)
    mkdir -p "$tmpdir/docs"
    _mock_server_cwd="$tmpdir/docs"
    test_start "_is_server_serving_expected_dir returns true on exact match"
    if _is_server_serving_expected_dir "1234" "$tmpdir/docs"; then
        test_pass
    else
        test_fail "Expected true for matching CWD"
    fi
    rm -rf "$tmpdir"
}

test_is_server_serving_expected_dir_mismatch() {
    reset_mocks
    local tmpdir_old tmpdir_new
    tmpdir_old=$(mktemp -d)
    tmpdir_new=$(mktemp -d)
    mkdir -p "$tmpdir_old/docs"
    mkdir -p "$tmpdir_new/docs"
    _mock_server_cwd="$tmpdir_old/docs"
    test_start "_is_server_serving_expected_dir returns false on mismatch"
    if ! _is_server_serving_expected_dir "1234" "$tmpdir_new/docs"; then
        test_pass
    else
        test_fail "Expected false for mismatched CWD"
    fi
    rm -rf "$tmpdir_old" "$tmpdir_new"
}

test_is_server_serving_expected_dir_empty() {
    reset_mocks
    _mock_server_cwd=""
    test_start "_is_server_serving_expected_dir returns false when CWD unreadable"
    if ! _is_server_serving_expected_dir "1234" "/some/path/docs"; then
        test_pass
    else
        test_fail "Expected false for empty CWD"
    fi
}

test_main_restarts_stale_server() {
    reset_mocks
    _mock_curl_http_code="200"
    _mock_lsof_output="99999"
    _mock_server_cwd="/old/path/docs"
    test_start "main restarts server when serving from wrong directory"
    main
    if [[ "$_stop_server_called" == "99999" && "$_start_server_called" == "yes" ]]; then
        test_pass
    else
        local _wrap_msg="Expected stop+restart, got stop='$_stop_server_called' "
        _wrap_msg+="start='$_start_server_called'"
        test_fail "$_wrap_msg"
    fi
}

test_main_leaves_correct_server() {
    reset_mocks
    _mock_curl_http_code="200"
    _mock_lsof_output="99999"
    _mock_server_cwd="$docs_dir"
    test_start "main leaves server alone when serving from correct directory"
    main
    if [[ -z "$_stop_server_called" && -z "$_start_server_called" ]]; then
        test_pass
    else
        local _wrap_msg="Expected no action, got stop='$_stop_server_called' "
        _wrap_msg+="start='$_start_server_called'"
        test_fail "$_wrap_msg"
    fi
}

test_main_starts_when_not_running() {
    reset_mocks
    _mock_curl_http_code="000"
    test_start "main starts server when not running"
    main
    if [[ -z "$_stop_server_called" && "$_start_server_called" == "yes" ]]; then
        test_pass
    else
        local _wrap_msg="Expected start only, got stop='$_stop_server_called' "
        _wrap_msg+="start='$_start_server_called'"
        test_fail "$_wrap_msg"
    fi
}

test_main_restart_flag_stops_running_server() {
    reset_mocks
    _mock_curl_http_code="200"
    _mock_lsof_output="99999"
    _mock_server_cwd="$docs_dir"
    test_start "main --restart stops a running server before starting"
    main --restart
    if [[ "$_stop_server_called" == "99999" && "$_start_server_called" == "yes" ]]; then
        test_pass
    else
        local _wrap_msg="Expected stop+start, got stop='$_stop_server_called' "
        _wrap_msg+="start='$_start_server_called'"
        test_fail "$_wrap_msg"
    fi
}

test_main_restart_flag_starts_when_not_running() {
    reset_mocks
    _mock_curl_http_code="000"
    test_start "main --restart starts server when none is running"
    main --restart
    if [[ -z "$_stop_server_called" && "$_start_server_called" == "yes" ]]; then
        test_pass
    else
        local _wrap_msg="Expected start only, got stop='$_stop_server_called' "
        _wrap_msg+="start='$_start_server_called'"
        test_fail "$_wrap_msg"
    fi
}

test_refresh_static_site_runs_mkdocs_build() {
    reset_mocks
    local tmplog args_file cwd_file args cwd resolved_docs
    tmplog=$(mktemp)
    args_file=$(mktemp)
    cwd_file=$(mktemp)
    build_logfile="$tmplog"
    _python3_args_file="$args_file"
    _python3_cwd_file="$cwd_file"
    resolved_docs=$(readlink -f "$docs_dir")
    test_start "_refresh_static_site runs mkdocs build --clean in the docs directory"
    if ! _refresh_static_site; then
        test_fail "Expected rc 0 on successful build"
    else
        args=$(cat "$args_file")
        cwd=$(readlink -f "$(cat "$cwd_file")")
        if [[ "$args" == "-m mkdocs build --clean" && "$cwd" == "$resolved_docs" ]]; then
            test_pass
        else
            test_fail "args='$args' cwd='$cwd'"
        fi
    fi
    rm -f "$tmplog" "$args_file" "$cwd_file"
}

test_refresh_static_site_survives_build_failure() {
    reset_mocks
    local tmplog
    tmplog=$(mktemp)
    build_logfile="$tmplog"
    _python3_rc=1
    test_start "_refresh_static_site returns 0 when the build fails"
    if _refresh_static_site; then
        test_pass
    else
        test_fail "Expected rc 0 on build failure"
    fi
    rm -f "$tmplog"
}

# =============================================================================
# Run
# =============================================================================

test_is_server_running_true
test_is_server_running_false
test_get_server_pid_lsof
test_get_server_pid_fuser
test_get_server_pid_pgrep
test_is_server_serving_expected_dir_match
test_is_server_serving_expected_dir_mismatch
test_is_server_serving_expected_dir_empty
test_main_restarts_stale_server
test_main_leaves_correct_server
test_main_starts_when_not_running
test_main_restart_flag_stops_running_server
test_main_restart_flag_starts_when_not_running
test_refresh_static_site_runs_mkdocs_build
test_refresh_static_site_survives_build_failure

test_summary
