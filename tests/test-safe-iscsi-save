test_manifest_regenerated_after_save() {
    test_start "Manifest is regenerated after successful save"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf 'vm-999-disk-0\n' > "$tmpdir/expected-backstores.txt"

    _run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 2 >/dev/null

    local content
    content=$(grep -v '^#' "$tmpdir/expected-backstores.txt" | grep -v '^$' | sort)
    if [[ "$content" == $'vm-100-disk-0\nvm-101-disk-0' ]]; then
        test_pass
    else
        test_fail "Manifest not regenerated correctly: '$content'"
    fi
    rm -rf "$tmpdir"
}

# ------------------------------------------------------------------
# Run safe-iscsi-save end-to-end against a temp copy and verify that
# generate_boot_config strips encrypted backstores using the modern
# /etc/zfsutilities/iscsi-encrypted-luns.conf path.
# ------------------------------------------------------------------
test_encrypted_backstores_excluded_from_boot_config() {
    test_start "Encrypted backstores are excluded from saveconfig-boot.json"
    local tmpdir
    tmpdir=$(mktemp -d)
    local savefile="$tmpdir/saveconfig.json"
    local bootfile="$tmpdir/saveconfig-boot.json"
    local manifest="$tmpdir/expected-backstores.txt"
    local confdir="$tmpdir/etc/zfsutilities"
    mkdir -p "$confdir"

    cat > "$savefile" <<'EOF'
{
  "storage_objects": [
    {"name": "vm-100-disk-0", "dev": "/dev/zvol/threeamigos/proxmox/vm-100-disk-0"},
    {"name": "vm-101-disk-0", "dev": "/dev/zvol/threeamigos/proxmox/vm-101-disk-0"}
  ],
  "targets": [
    {
      "tpgs": [
        {
          "luns": [
            {"storage_object": "/backstores/block/vm-100-disk-0", "index": 0},
            {"storage_object": "/backstores/block/vm-101-disk-0", "index": 1}
          ]
        }
      ]
    }
  ]
}
EOF
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$manifest"
    printf 'vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos\n' \
        > "$confdir/iscsi-encrypted-luns.conf"

    local script_copy="$tmpdir/safe-iscsi-save"
    sed \
        -e "s|/etc/rtslib-fb-target/saveconfig\.json|$savefile|g" \
        -e "s|/etc/rtslib-fb-target/saveconfig-boot\.json|$bootfile|g" \
        -e "s|/etc/rtslib-fb-target/expected-backstores\.txt|$manifest|g" \
        -e "s|source ~/bashinit|source \"$mydir/bin/bashinit\"|g" \
        "$mydir/bin/safe-iscsi-save" > "$script_copy"

    local node_conf="$tmpdir/node.conf"
    cat > "$node_conf" <<'EOF'
NODE_MODE="single-node"
EOF

    cat > "$tmpdir/runner" << RUNNEREOF
#!/bin/bash
export NODE_CONF="$node_conf"
export mydir="$mydir"
export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$confdir"
targetcli() {
    case "\$*" in
        "/backstores/block ls")
            echo "  vm-100-disk-0     /dev/zvol/threeamigos/proxmox/vm-100-disk-0   50G"
            echo "  vm-101-disk-0     /dev/zvol/threeamigos/proxmox/vm-101-disk-0   50G"
            ;;
        "saveconfig")
            true
            ;;
        *)
            true
            ;;
    esac
}
rootcheck() { true; }
source "$script_copy"
RUNNEREOF

    bash "$tmpdir/runner" >/dev/null 2>&1
    local rc=$?

    local names
    names=$(python3 -c "import json; print(' '.join([so['name'] for so in \
json.load(open('$bootfile')).get('storage_objects', [])]))" 2>/dev/null || true)

    rm -rf "$tmpdir"

    if [[ $rc -ne 0 ]]; then
        test_fail "safe-iscsi-save failed, rc=$rc"
    elif [[ "$names" != "vm-101-disk-0" ]]; then
        test_fail "Expected only vm-101-disk-0 in boot config, got: $names"
    else
        test_pass
    fi
}

test_helper_removes_workdir() {
    test_start "Helper removes its temporary work directory"
    local scratch output rc=0 leftover
    scratch=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$scratch/saveconfig.json"
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$scratch/expected-backstores.txt"

    # The TMPDIR prefix sits inside the command substitution, so it scopes to
    # the helper call only: the helper's mktemp -d lands under $scratch, where
    # a leftover workdir is visible to this test alone.
    output=$(TMPDIR="$scratch" _run_safe_iscsi_save \
        "$scratch/expected-backstores.txt" "$scratch/saveconfig.json" 2) || rc=$?
    # -mindepth 1: the scratch dir itself is a tmp.* and must not match.
    leftover=$(find "$scratch" -mindepth 1 -maxdepth 1 -name 'tmp.*' -print -quit)

    if [[ "$rc" -eq 0 ]] && [[ -z "$leftover" ]]; then
        test_pass
    else
        test_fail "Workdir left behind: rc=$rc leftover='$leftover'"
    fi
    rm -rf "$scratch"
}

test_manifest_install_failure_cleans_tmpfile() {
    test_start "Manifest install failure removes the tmpfile and exits 1"

    # The failure is injected by making the manifest dir unwritable; root
    # ignores mode bits, so the install succeeds and the test cannot run.
    if [[ $EUID -eq 0 ]]; then
        test_skip "Requires non-root (root ignores the 0555 install-dir gate)"
        return
    fi

    local scratch ro_dir manifest output rc=0 leftover
    scratch=$(mktemp -d)
    ro_dir="$scratch/ro"
    mkdir "$ro_dir"
    manifest="$ro_dir/expected-backstores.txt"
    echo '{"storage_objects":[],"targets":[]}' > "$scratch/saveconfig.json"
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$manifest"
    # Read-only manifest dir: the script's -f gate still passes (reading
    # works), but mv cannot install the regenerated manifest.
    chmod 555 "$ro_dir"

    # Private TMPDIR (scoped to the helper call) makes the script's mktemp
    # tmpfile land under $scratch, where a leak is visible to this test.
    output=$(TMPDIR="$scratch" _run_safe_iscsi_save \
        "$manifest" "$scratch/saveconfig.json" 2) || rc=$?
    leftover=$(find "$scratch" -mindepth 1 -maxdepth 1 -name 'tmp.*' -print -quit)
    chmod 755 "$ro_dir"

    if [[ "$rc" -ne 0 ]] && [[ "$output" == *"Could not install regenerated manifest"* ]] \
        && [[ -z "$leftover" ]]; then
        test_pass
    else
        test_fail "rc=$rc leftover='$leftover' output='$output'"
    fi
    rm -rf "$scratch"
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_zero_active_backstores_refuses_save
test_active_count_equals_expected_saves
test_active_less_than_expected_refuses_save
test_empty_manifest_refuses_save
test_manifest_regenerated_after_save
test_encrypted_backstores_excluded_from_boot_config
test_helper_removes_workdir
test_manifest_install_failure_cleans_tmpfile

test_summary
