    case "\$*" in
        "/backstores/block ls")
            echo "  vm-100-disk-0     /dev/zvol/threeamigos/proxmox/vm-100-disk-0   50G"
            echo "  vm-101-disk-0     /dev/zvol/threeamigos/proxmox/vm-101-disk-0   50G"
            ;;
        "saveconfig "*)
            if [[ "\$SAVECONFIG_FAIL" == "1" ]]; then
                return 1
            fi
            SAVECONFIG_CALLED="yes"
            SAVECONFIG_FIXTURE="\$SAFE_SAVE_LIVE_FIXTURE" \\
                python3 "$tmpdir/write_live_config.py" "\$2" "\$BACKSTORE_COUNT"
