          "acls": [
            {
              "node_wwn": "iqn.2026-02.local.tweety",
              "mapped_luns": [
                {"index": 0, "tpg_lun": 0},
                {"index": 1, "tpg_lun": 1}
              ]
            }
          ]
        }
      ]
    }
  ]
}
EOF
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$manifest"
    printf 'vm-101-disk-0:/dev/zvol/threeamigos/proxmox/vm-101-disk-0:threeamigos\n' \
