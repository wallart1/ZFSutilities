test_export_hook_suppressed_by_caller() {
    test_start "SAFE_ISCSI_SAVE_SKIP_EXPORT_ISCSI_STATE=1 skips the hook with an INFO line"
    local tmpdir hook output rc=0
    tmpdir=$(mktemp -d)
    hook="$tmpdir/export-mock"
    printf '#!/bin/bash\necho EXPORT_HOOK_CALLED\n' > "$hook"
    chmod +x "$hook"

    # The runner exports the suppression knob the way reconcile-iscsi-state
    # invokes the save; the hook must not run.
    output=$(SAFE_ISCSI_SAVE_SKIP_EXPORT_ISCSI_STATE=1 \
        _run_safe_iscsi_save_with_hook "$hook") || rc=$?
    rm -rf "$tmpdir"

    if [[ "$rc" -eq 0 ]] && [[ "$output" == *"SAVECONFIG_CALLED"* ]] \
        && [[ "$output" == *"Pool LUN map refresh suppressed by caller"* ]] \
        && [[ "$output" != *"EXPORT_HOOK_CALLED"* ]]; then
        test_pass
    else
        test_fail "rc=$rc output='$output'"
    fi
}

