    local manifest="$tmpdir/expected-backstores.txt"
    local confdir="$tmpdir/etc/zfsutilities"
    mkdir -p "$confdir"

    # TPG holds a plain LUN 0 and an encrypted LUN 1; the initiator ACL maps
    # both. The boot config must keep MappedLUN 0 and drop MappedLUN 1 with
    # its LUN, or targetctl restore warns "Could not find matching TPG LUN".
    cat > "$savefile" <<'EOF'
