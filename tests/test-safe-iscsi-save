#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-safe-iscsi-save — Unit tests for the degraded-config guard.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Run safe-iscsi-save from a temp copy with paths rewritten and
# targetcli/generate_boot_config mocked inside the subshell.
# ------------------------------------------------------------------
_run_safe_iscsi_save() {
    local manifest="$1"
    local savefile="$2"
    local backstore_count="$3"
    local tmpdir
    tmpdir=$(mktemp -d)
    local script_copy="$tmpdir/safe-iscsi-save"

    sed \
        -e "s|/etc/rtslib-fb-target/saveconfig\.json|$savefile|g" \
        -e "s|/etc/rtslib-fb-target/saveconfig-boot\.json|${savefile}.boot|g" \
        -e "s|/etc/rtslib-fb-target/expected-backstores\.txt|$manifest|g" \
        -e "s|/etc/iscsi-encrypted-luns\.conf||g" \
        -e "s|source ~/bashinit|source \"$mydir/bin/bashinit\"|g" \
        "$mydir/bin/safe-iscsi-save" > "$script_copy"

    # Temporary single-node config so node-lib.sh does not require a two-node conf.
    local node_conf="$tmpdir/node.conf"
    cat > "$node_conf" <<'EOF'
NODE_MODE="single-node"
EOF

    cat > "$tmpdir/runner" << RUNNEREOF
#!/bin/bash
export NODE_CONF="$node_conf"
export mydir="$mydir"
BACKSTORE_COUNT=$backstore_count
SAVECONFIG_CALLED=""
targetcli() {
    case "\$*" in
        "/backstores/block ls")
            if [[ "\$BACKSTORE_COUNT" -eq 0 ]]; then
                true
            else
                for (( i=0; i<\$BACKSTORE_COUNT; i++ )); do
                    echo "  vm-10\$i-disk-0     /dev/zvol/threeamigos/proxmox/vm-10\$i-disk-0   50G"
                done
            fi
            ;;
        "saveconfig")
            SAVECONFIG_CALLED="yes"
            ;;
        *)
            true
            ;;
    esac
}
generate_boot_config() { true; }
rootcheck() { true; }
source "$script_copy"
[[ "\$SAVECONFIG_CALLED" == "yes" ]] && echo "SAVECONFIG_CALLED"
RUNNEREOF

    bash "$tmpdir/runner" 2>&1
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_zero_active_backstores_refuses_save() {
    test_start "Zero active backstores refuses to save"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$tmpdir/expected-backstores.txt"

    local output rc=0
    output=$(_run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 0) \
        || rc=$?

    if [[ "$rc" -ne 0 ]] && [[ "$output" != *"SAVECONFIG_CALLED"* ]]; then
        test_pass
    else
        test_fail "Expected non-zero rc and no save, got rc=$rc output='$output'"
    fi
    rm -rf "$tmpdir"
}

test_active_count_equals_expected_saves() {
    test_start "Active count equal to expected saves config"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$tmpdir/expected-backstores.txt"

    local output rc=0
    output=$(_run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 2) \
        || rc=$?

    if [[ "$rc" -eq 0 ]] && [[ "$output" == *"SAVECONFIG_CALLED"* ]]; then
        test_pass
    else
        test_fail "Expected rc=0 and save called, got rc=$rc output='$output'"
    fi
    rm -rf "$tmpdir"
}

test_active_less_than_expected_refuses_save() {
    test_start "Active count less than expected refuses to save"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf 'vm-100-disk-0\nvm-101-disk-0\nvm-102-disk-0\n' > "$tmpdir/expected-backstores.txt"

    local output rc=0
    output=$(_run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 2) \
        || rc=$?

    if [[ "$rc" -ne 0 ]] && [[ "$output" != *"SAVECONFIG_CALLED"* ]]; then
        test_pass
    else
        test_fail "Expected non-zero rc and no save, got rc=$rc output='$output'"
    fi
    rm -rf "$tmpdir"
}

test_empty_manifest_refuses_save() {
    test_start "Empty manifest refuses to save"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf '# empty manifest\n' > "$tmpdir/expected-backstores.txt"

    local output rc=0
    output=$(_run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 0) \
        || rc=$?

    if [[ "$rc" -ne 0 ]] && [[ "$output" != *"SAVECONFIG_CALLED"* ]]; then
        test_pass
    else
        test_fail "Expected non-zero rc and no save, got rc=$rc output='$output'"
    fi
    rm -rf "$tmpdir"
}

test_manifest_regenerated_after_save() {
    test_start "Manifest is regenerated after successful save"
    local tmpdir
    tmpdir=$(mktemp -d)
    echo '{"storage_objects":[],"targets":[]}' > "$tmpdir/saveconfig.json"
    printf 'vm-999-disk-0\n' > "$tmpdir/expected-backstores.txt"

    _run_safe_iscsi_save "$tmpdir/expected-backstores.txt" "$tmpdir/saveconfig.json" 2 >/dev/null

    local content
    content=$(grep -v '^#' "$tmpdir/expected-backstores.txt" | grep -v '^$' | sort)
    if [[ "$content" == $'vm-100-disk-0\nvm-101-disk-0' ]]; then
        test_pass
    else
        test_fail "Manifest not regenerated correctly: '$content'"
    fi
    rm -rf "$tmpdir"
}

# ------------------------------------------------------------------
# Run safe-iscsi-save end-to-end against a temp copy and verify that
# generate_boot_config strips encrypted backstores using the modern
# /etc/zfsutilities/iscsi-encrypted-luns.conf path.
# ------------------------------------------------------------------
test_encrypted_backstores_excluded_from_boot_config() {
    test_start "Encrypted backstores are excluded from saveconfig-boot.json"
    local tmpdir
    tmpdir=$(mktemp -d)
    local savefile="$tmpdir/saveconfig.json"
    local bootfile="$tmpdir/saveconfig-boot.json"
    local manifest="$tmpdir/expected-backstores.txt"
    local confdir="$tmpdir/etc/zfsutilities"
    mkdir -p "$confdir"

    cat > "$savefile" <<'EOF'
{
  "storage_objects": [
    {"name": "vm-100-disk-0", "dev": "/dev/zvol/threeamigos/proxmox/vm-100-disk-0"},
    {"name": "vm-101-disk-0", "dev": "/dev/zvol/threeamigos/proxmox/vm-101-disk-0"}
  ],
  "targets": [
    {
      "tpgs": [
        {
          "luns": [
            {"storage_object": "/backstores/block/vm-100-disk-0", "index": 0},
            {"storage_object": "/backstores/block/vm-101-disk-0", "index": 1}
          ]
        }
      ]
    }
  ]
}
EOF
    printf 'vm-100-disk-0\nvm-101-disk-0\n' > "$manifest"
    printf 'vm-100-disk-0:/dev/zvol/threeamigos/proxmox/vm-100-disk-0:threeamigos\n' \
        > "$confdir/iscsi-encrypted-luns.conf"

    local script_copy="$tmpdir/safe-iscsi-save"
    sed \
        -e "s|/etc/rtslib-fb-target/saveconfig\.json|$savefile|g" \
        -e "s|/etc/rtslib-fb-target/saveconfig-boot\.json|$bootfile|g" \
        -e "s|/etc/rtslib-fb-target/expected-backstores\.txt|$manifest|g" \
        -e "s|source ~/bashinit|source \"$mydir/bin/bashinit\"|g" \
        "$mydir/bin/safe-iscsi-save" > "$script_copy"

    local node_conf="$tmpdir/node.conf"
    cat > "$node_conf" <<'EOF'
NODE_MODE="single-node"
EOF

    cat > "$tmpdir/runner" << RUNNEREOF
#!/bin/bash
export NODE_CONF="$node_conf"
export mydir="$mydir"
export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$confdir"
targetcli() {
    case "\$*" in
        "/backstores/block ls")
            echo "  vm-100-disk-0     /dev/zvol/threeamigos/proxmox/vm-100-disk-0   50G"
            echo "  vm-101-disk-0     /dev/zvol/threeamigos/proxmox/vm-101-disk-0   50G"
            ;;
        "saveconfig")
            true
            ;;
        *)
            true
            ;;
    esac
}
rootcheck() { true; }
source "$script_copy"
RUNNEREOF

    bash "$tmpdir/runner" >/dev/null 2>&1
    local rc=$?

    local names
    names=$(python3 -c "import json; print(' '.join([so['name'] for so in json.load(open('$bootfile')).get('storage_objects', [])]))" 2>/dev/null || true)

    rm -rf "$tmpdir"

    if [[ $rc -ne 0 ]]; then
        test_fail "safe-iscsi-save failed, rc=$rc"
    elif [[ "$names" != "vm-101-disk-0" ]]; then
        test_fail "Expected only vm-101-disk-0 in boot config, got: $names"
    else
        test_pass
    fi
}

# ------------------------------------------------------------------
# Run
# ------------------------------------------------------------------
test_zero_active_backstores_refuses_save
test_active_count_equals_expected_saves
test_active_less_than_expected_refuses_save
test_empty_manifest_refuses_save
test_manifest_regenerated_after_save
test_encrypted_backstores_excluded_from_boot_config

test_summary
