# Authoritative mapping-gate tests (2026-10-27 boot-incident shapes)
# ------------------------------------------------------------------

# Render a saveconfig-shaped fixture with `total` defined backstores of
# which the first `mapped` are mapped at ordinals 0..mapped-1, each granted
# to the single initiator ACL. The incident shape is total=33, mapped=3.
_render_config_fixture() {
    python3 - "$1" "$2" "$3" <<'PYEOF'
import json, sys
path, total, mapped = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
names = ["vm-10%d-disk-0" % i for i in range(total)]
cfg = {
    "storage_objects": [
        {"name": n, "dev": "/dev/zvol/threeamigos/proxmox/" + n}
        for n in names
    ],
    "targets": [{
        "wwn": "iqn.2026-02.local.stewie:threeamigos",
        "tpgs": [{
            "luns": [
                {"storage_object": "/backstores/block/" + n, "index": i}
                for i, n in enumerate(names[:mapped])
            ],
            "acls": [{
                "node_wwn": "iqn.2026-02.local.tweety",
                "mapped_luns": [
                    {"index": i, "tpg_lun": i} for i in range(mapped)
                ],
            }],
        }],
    }],
}
with open(path, "w") as f:
    json.dump(cfg, f, indent=2)
PYEOF
}

test_incident_shape_refuses_save() {
    test_start "Defined-but-unmapped backstores refuse the save (incident shape)"
    local tmpdir manifest savefile bootfile hook live
    tmpdir=$(mktemp -d)
    manifest="$tmpdir/expected-backstores.txt"
    savefile="$tmpdir/saveconfig.json"
    bootfile="${savefile}.boot"
    hook="$tmpdir/export-mock"
    live="$tmpdir/live-config.json"

    # 33 expected, 33 defined — every backstore-count gate passes; the saved
    # config maps all 33, the live tree maps only 3.
    local i
    : > "$manifest"
    for (( i=0; i<33; i++ )); do printf 'vm-10%d-disk-0\n' "$i" >> "$manifest"; done
    _render_config_fixture "$savefile" 33 33
    _render_config_fixture "$live" 33 3
    printf 'BOOT-SENTINEL\n' > "$bootfile"
    printf '#!/bin/bash\necho EXPORT_HOOK_CALLED\n' > "$hook"
    chmod +x "$hook"
    cp -- "$savefile" "${savefile}.orig"
    cp -- "$manifest" "${manifest}.orig"

    local output rc=0 leftover
    output=$(_run_safe_iscsi_save_core "$manifest" "$savefile" 33 "$live" "$hook" "") || rc=$?
    leftover=$(find "$tmpdir" -maxdepth 1 -name '*.tmp.*' -print -quit)

    local ok=true
    [[ "$rc" -ne 0 ]] || ok=false
    [[ "$output" == *"refusing to save — 30 LUN mapping(s)"* ]] || ok=false
    [[ "$output" == *"(and 30 ACL MappedLUN grant(s)) would be lost"* ]] || ok=false
    cmp -s "${savefile}.orig" "$savefile" || ok=false
    cmp -s "${manifest}.orig" "$manifest" || ok=false
    [[ "$(cat "$bootfile")" == "BOOT-SENTINEL" ]] || ok=false
    [[ "$output" != *"EXPORT_HOOK_CALLED"* ]] || ok=false
    [[ -z "$leftover" ]] || ok=false

    if [[ "$ok" == true ]]; then
        test_pass
    else
        test_fail "rc=$rc leftover='$leftover' output='$output'"
    fi
    rm -rf "$tmpdir"
}

test_legitimate_shrinkage_saves() {
