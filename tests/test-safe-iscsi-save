#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-safe-iscsi-save — Unit tests for the degraded-config guard.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Live-config writer: `targetcli saveconfig <path>` stages the live LIO
# state. With SAFECONFIG_FIXTURE set the mock copies that file; otherwise it
# generates a fully-mapped config for BACKSTORE_COUNT backstores (each a
# storage_object mapped at its ordinal, one initiator ACL granting every
# LUN), so the saved config's mappings survive by default and gate tests
# override the live topology with explicit fixtures.
# ------------------------------------------------------------------
_write_live_config_writer() {
    local dir="$1"
    cat > "${dir}/write_live_config.py" <<'WRITEREOF'
import json, os, sys

dst, count = sys.argv[1], int(sys.argv[2])
fixture = os.environ.get("SAVECONFIG_FIXTURE", "")
if fixture:
    with open(fixture) as f:
        cfg = json.load(f)
else:
    names = ["vm-10%d-disk-0" % i for i in range(count)]
    cfg = {
        "storage_objects": [
            {"name": n, "dev": "/dev/zvol/threeamigos/proxmox/" + n}
            for n in names
        ],
        "targets": [{
            "wwn": "iqn.2026-02.local.stewie:threeamigos",
            "tpgs": [{
                "luns": [
                    {"storage_object": "/backstores/block/" + n, "index": i}
                    for i, n in enumerate(names)
                ],
                "acls": [{
                    "node_wwn": "iqn.2026-02.local.tweety",
                    "mapped_luns": [
                        {"index": i, "tpg_lun": i} for i in range(len(names))
                    ],
                }],
            }],
        }],
    }
with open(dst, "w") as f:
    json.dump(cfg, f, indent=2)
WRITEREOF
}

# ------------------------------------------------------------------
# Run safe-iscsi-save from a temp copy with paths rewritten and
# targetcli/rootcheck mocked inside the subshell.
#   $1 manifest          $2 savefile
#   $3 backstore_count   $4 live fixture ("" = generated)
#   $5 export hook ("" = the script's default fallback)
#   $6 saveconfig_fail ("1" = targetcli saveconfig itself fails)
# Prints the runner's combined output and returns its exit status.
# ------------------------------------------------------------------
_run_safe_iscsi_save_core() {
    local manifest="$1"
    local savefile="$2"
    local backstore_count="$3"
    local live_fixture="${4:-}"
    local hook="${5:-}"
    local saveconfig_fail="${6:-}"
    local tmpdir
    local runner_rc
    tmpdir=$(mktemp -d)
    _write_live_config_writer "$tmpdir"

    local script_copy="$tmpdir/safe-iscsi-save"
    sed \
        -e "s|/etc/rtslib-fb-target/saveconfig\.json|$savefile|g" \
        -e "s|/etc/rtslib-fb-target/saveconfig-boot\.json|${savefile}.boot|g" \
        -e "s|/etc/rtslib-fb-target/expected-backstores\.txt|$manifest|g" \
        -e "s|/etc/iscsi-encrypted-luns\.conf||g" \
        -e "s|source ~/bashinit|source \"$mydir/bin/bashinit\"|g" \
        -e 's|^source_helper rootcheck$|: # rootcheck stays mocked; the suite runs non-root|' \
        "$mydir/bin/safe-iscsi-save" > "$script_copy"

    # Temporary single-node config so node-lib.sh does not require a two-node conf.
    local node_conf="$tmpdir/node.conf"
    cat > "$node_conf" <<'EOF'
NODE_MODE="single-node"
EOF

    cat > "$tmpdir/runner" << RUNNEREOF
#!/bin/bash
export NODE_CONF="$node_conf"
export mydir="$mydir"
export SAFE_SAVE_LIVE_FIXTURE="$live_fixture"
export SAVECONFIG_FAIL="$saveconfig_fail"
export SAFE_ISCSI_SAVE_EXPORT_ISCSI_STATE="$hook"
BACKSTORE_COUNT=$backstore_count
SAVECONFIG_CALLED=""
targetcli() {
    case "\$*" in
        "/backstores/block ls")
            if [[ "\$BACKSTORE_COUNT" -eq 0 ]]; then
                true
            else
                for (( i=0; i<\$BACKSTORE_COUNT; i++ )); do
                    echo "  vm-10\$i-disk-0     /dev/zvol/threeamigos/proxmox/vm-10\$i-disk-0   50G"
                done
            fi
            ;;
        "saveconfig "*)
            if [[ "\$SAVECONFIG_FAIL" == "1" ]]; then
                return 1
            fi
            SAVECONFIG_CALLED="yes"
            SAVECONFIG_FIXTURE="\$SAFE_SAVE_LIVE_FIXTURE" \\
                python3 "$tmpdir/write_live_config.py" "\$2" "\$BACKSTORE_COUNT"
            ;;
        *)
            true
            ;;
    esac
}
rootcheck() { true; }
source "$script_copy"
[[ "\$SAVECONFIG_CALLED" == "yes" ]] && echo "SAVECONFIG_CALLED"
RUNNEREOF

    bash "$tmpdir/runner" 2>&1
    runner_rc=$?
    # The runner's exit status is asserted on by callers, so preserve it
    # across the workdir teardown.
    rm -rf "$tmpdir"
    return "$runner_rc"
}

_run_safe_iscsi_save() {
    _run_safe_iscsi_save_core "$1" "$2" "$3" "" "" ""
}

