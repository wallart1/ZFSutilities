#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-installer-flows — Execution harness for the installers' interactive
# flows (install-single-node / install-two-node).
#
# The guard-level suites (test-installer-checks / -structure / -retention,
# test-iscsi-fresh-install-guards) never execute the installers, so
# shell-variable flow bugs were invisible to them: install-two-node's
# keep-existing-config path shipped broken for years because nothing ran it.
# This suite executes both installers end to end as a non-root user:
#   - a mirror tree redirects script_dir at stub check-prerequisites /
#     deploy-version / switch-version / setup-iscsi-targets while the
#     libraries and templates stay the repo copies;
#   - ssh/scp/systemctl/sudo/targetcli/findmnt/hostname/mkdocs are shell
#     functions, recorded into a capture directory;
#   - answers are piped in on stdin (read -rp prompts consume them in order);
#   - the retention helper runs for real against a fixture config path.
# Unhandled remote commands fail loudly (SSH-UNHANDLED) so a new probe shape
# cannot pass silently.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Mirror tree: script_dir points here, so the installers find the stub
# external commands; lib/ and share/ stay the repository copies.
# ------------------------------------------------------------------

build_mirror() {
    local mirror="$1"
    mkdir -p "$mirror/bin"
    ln -s "$mydir/bin/install-single-node" "$mirror/bin/install-single-node"
    ln -s "$mydir/bin/install-two-node" "$mirror/bin/install-two-node"
    ln -s "$mydir/lib" "$mirror/lib"
    ln -s "$mydir/share" "$mirror/share"
    printf '9.9.9\n' > "$mirror/VERSION"
    printf '#!/usr/bin/bash\nexit 0\n' > "$mirror/bin/check-prerequisites"
    cat > "$mirror/bin/deploy-version" <<'STUB'
#!/usr/bin/bash
printf 'DEPLOY:%s\n' "$*" >> "${_capture_dir:?}/deploy"
exit 0
STUB
    cat > "$mirror/bin/switch-version" <<'STUB'
#!/usr/bin/bash
printf 'SWITCH:%s\n' "$*" >> "${_capture_dir:?}/switch"
exit 0
STUB
    cat > "$mirror/bin/setup-iscsi-targets" <<'STUB'
#!/usr/bin/bash
printf 'SETUP-TARGETS:%s\n' "$*" >> "${_capture_dir:?}/setup-targets"
exit 0
STUB
    chmod +x "$mirror/bin/check-prerequisites" "$mirror/bin/deploy-version" \
        "$mirror/bin/switch-version" "$mirror/bin/setup-iscsi-targets"
}

# ------------------------------------------------------------------
# Runner: execute one installer in a mock subshell with piped answers.
#   $1  "single" | "two"
#   $2  per-test fixture directory (fresh for every test)
# Capture files are appended to the returned output so assertions can grep
# one stream.
# ------------------------------------------------------------------

run_installer() {
    local which="$1"
    local fixture="$2"
    local stdin_input="${_mock_stdin:-}"
    local capture_dir="$fixture/capture"
    mkdir -p "$capture_dir" "$fixture/etc-zfs" "$fixture/state" \
        "$fixture/run" "$fixture/etc-prefix"
    (
        source "$mydir/tests/test-lib.sh"
        setup_test_env
        build_mirror "$fixture/mirror"

        export _capture_dir="$capture_dir"
        export ZFSUTILITIES_SYSTEM_CONFIG_DIR="$fixture/etc-zfs"
        export ZFSUTILITIES_STATE_DIR="$fixture/state"
        export ZFSUTILITIES_RUN_DIR="$fixture/run"
        export ZFSUTILITIES_ETC_PREFIX="$fixture/etc-prefix"
        export ZFSUTILITIES_VERSION_BASE="$fixture/versions-base"
        export ZFSCONFIG_PATH="$fixture/state/config.json"
        export ZFSUTILITIES_PYTHON_SRC="$mydir/python"
        export ZFSUTILITIES_LEGACY_NODE_CONF="$fixture/legacy-node.conf"
        export ZFSUTILITIES_LEGACY_TWO_NODE_CONF="$fixture/legacy-two.conf"
        if [[ "$which" == "single" ]]; then
            export INSTALL_SINGLE_NODE_TEST_NO_ROOT=1
        else
            export INSTALL_TWO_NODE_TEST_NO_ROOT=1
            _mock_zpool_list=$'threeamigos\nNVME1'
        fi

        # Root filesystem type and hostname, stable per test.
        findmnt() {
            if [[ "$1" == "-n" ]]; then
                printf '%s\n' "${_mock_root_fstype:-ext4}"
                return 0
            fi
            command findmnt "$@"
        }
        hostname() {
            if [[ "$1" == "-s" ]]; then
                printf '%s\n' "${_mock_hostname:-zteststor}"
                return 0
            fi
            command hostname "$@"
        }

        # ensure_doc_server short-circuit: mkdocs "installed" and the
        # material import answered by the python3 wrapper below.
        mkdocs() { return 0; }
        python3() {
            if [[ "${1:-}" == "-c" && "${2:-}" == "import material" ]]; then
                return 0
            fi
            command python3 "$@"
        }

        # Summary "Installed versions" listing.
        sudo() {
            printf 'SUDO:%s\n' "$*" >> "$_capture_dir/sudo"
            return 0
        }

        # LIO stack presence probes (command -v sees the function).
        # /iscsi ls answers from _mock_live_targets so the IQN-default
        # fence (live-prefix-derived default) can be exercised.
        targetcli() {
            printf 'TARGETCLI:%s\n' "$*" >> "$_capture_dir/targetcli"
            if [[ "$1 $2" == "/iscsi ls" && -n "${_mock_live_targets:-}" ]]; then
                printf '%s\n' "$_mock_live_targets"
            fi
            return 0
        }
        systemctl() {
            printf 'SYSTEMCTL:%s\n' "$*" >> "$_capture_dir/systemctl"
            return 0
        }

        # Remote compute-host channel, matched on the full argument string
        # (some calls carry the version as a trailing argument after the
        # remote command). Existence probes are answered from mock state;
        # anything unrecognized fails loudly so a new probe shape cannot
        # pass silently.
        ssh() {
            local all="$*"
            printf 'SSH:%s\n' "$all" >> "$_capture_dir/ssh"
            if [[ "${_mock_ssh_fail:-}" == "1" ]] \
                && [[ "$all" == *" root@ztestcomp true" ]]; then
                return 1
            fi
            case "$all" in
                *"ssh -o"*"root@zteststor true") return 0 ;;
                *" root@ztestcomp true") return 0 ;;
                *"command -v iscsiadm"*) return 0 ;;
                *"iscsid.socket"*) return 0 ;;
                *"systemctl restart pvestatd"*) return 0 ;;
                *"sed -i "*) return "${_mock_patch_rc:-0}" ;;
                *"[[ ! -f "*]])
                    if [[ "$all" == *ISCSIPlugin.pm* ]]; then
                        if [[ "${_mock_pve_present:-}" == "1" ]]; then
                            return 0
                        fi
                        return 1
                    fi
                    if [[ "$all" == *node.conf* ]]; then
                        # "[[ ! -f <node.conf> ]]": report present when asked.
                        if [[ "${_mock_remote_node_conf_present:-}" == "1" ]]; then
                            return 1
                        fi
                        return 0
                    fi
                    return 0
                    ;;
                *"[[ -f "*]])
                    # PVE plugin existence probe (no negation)
                    if [[ "${_mock_pve_present:-}" == "1" ]]; then
                        return 0
                    fi
                    return 1
                    ;;
                *"installer_retention.py"*) return 0 ;;
                *"qemu-server"*)
                    # probe_target_usage remote payload: referencing guest
                    # configs plus the live-session count. Defaults verify
                    # the target unused; _mock_probe_refs (newline-free
                    # conf path list) and _mock_probe_sessions simulate
                    # use; _mock_probe_unreachable fails the probe's ssh.
                    if [[ "${_mock_probe_unreachable:-}" == "1" ]]; then
                        return 1
                    fi
                    if [[ -n "${_mock_probe_refs:-}" ]]; then
                        printf '%s\n' "${_mock_probe_refs}"
                    fi
                    printf 'SESSIONS:%s\n' "${_mock_probe_sessions:-0}"
                    return 0
                    ;;
                *"switch-version"*) return 0 ;;
                *"install -d "*) return 0 ;;
                *"chmod 0644 "*) return 0 ;;
                *"apt-get"*) return 0 ;;
                *)
                    printf 'SSH-UNHANDLED:%s\n' "$all" >> "$_capture_dir/ssh"
                    return 1
                    ;;
            esac
        }
        scp() {
            printf 'SCP:%s\n' "$*" >> "$_capture_dir/scp"
            return 0
        }

        source "$fixture/mirror/bin/install-${which}-node"
    ) <<< "$stdin_input" 2>&1
    local rc=$?
    cat "$capture_dir/deploy" 2>/dev/null || true
    cat "$capture_dir/switch" 2>/dev/null || true
    cat "$capture_dir/setup-targets" 2>/dev/null || true
    cat "$capture_dir/ssh" 2>/dev/null || true
    cat "$capture_dir/scp" 2>/dev/null || true
    cat "$capture_dir/systemctl" 2>/dev/null || true
    cat "$capture_dir/sudo" 2>/dev/null || true
    return $rc
}

reset_installer_mocks() {
    unset _mock_stdin _mock_root_fstype _mock_hostname _mock_ssh_fail \
        _mock_patch_rc _mock_pve_present _mock_remote_node_conf_present \
        _mock_probe_refs _mock_probe_sessions _mock_probe_unreachable \
        _mock_live_targets
}

node_conf_path() {
    printf '%s/etc-zfs/node.conf\n' "$1"
}

write_two_node_conf() {
    local fixture="$1"
    {
        echo 'NODE_MODE="two-node"'
        echo 'STORAGE_HOST="zteststor"'
        echo 'COMPUTE_HOST="ztestcomp"'
        echo 'STORAGE_IP="192.168.100.1"'
        echo 'IQN_PREFIX="iqn.2026-01.local.zteststor"'
        echo 'EXPECTED_ISCSI_DEVICES="6"'
        echo 'declare -A POOL_TARGET=('
        echo '    [threeamigos]="threeamigos"'
        echo '    [NVME1]="nvme1"'
        echo ')'
    } > "$(node_conf_path "$fixture")"
}

# ------------------------------------------------------------------
# install-single-node flows
# ------------------------------------------------------------------

test_single_node_fresh_install() {
    reset_installer_mocks
    test_start "single-node: fresh install generates config, deploys, activates"

    local fixture="$_mock_zfs_state_dir/single-fresh"
    _mock_stdin=$'\nn'
    local out rc
    out=$(run_installer single "$fixture")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    local conf
    conf="$(node_conf_path "$fixture")"
    if [[ ! -f "$conf" ]]; then
        test_fail "node.conf not written: $conf; output:\n$out"
        return
    fi
    if ! grep -q '^NODE_MODE="single-node"$' "$conf" \
        || ! grep -q '^THIS_HOST="zteststor"$' "$conf" \
        || grep -q '@@THIS_HOST@@' "$conf"; then
        test_fail "Template substitution wrong; content:\n$(cat "$conf")"
        return
    fi
    if [[ "$out" != *"DEPLOY:"* ]] || [[ "$out" != *"SWITCH:9.9.9"* ]]; then
        test_fail "Deploy/activate not recorded; output:\n$out"
        return
    fi
    if ! grep -q '"default"' "$fixture/state/config.json"; then
        test_fail "Retention profile not initialized; output:\n$out"
        return
    fi
    if [[ "$out" != *"Installation Complete"* ]] \
        || [[ "$out" == *"SSH-UNHANDLED:"* ]]; then
        test_fail "Run did not complete cleanly; output:\n$out"
        return
    fi

    test_pass
}

test_single_node_keep_existing_config() {
    reset_installer_mocks
    test_start "single-node: declining reconfigure keeps the existing config"

    local fixture="$_mock_zfs_state_dir/single-keep"
    mkdir -p "$fixture/etc-zfs"
    printf 'NODE_MODE="single-node"\nTHIS_HOST="keepme"\n' \
        > "$(node_conf_path "$fixture")"
    _mock_stdin="n"
    local out rc
    out=$(run_installer single "$fixture")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"Keeping existing configuration"* ]]; then
        test_fail "Keep message missing; output:\n$out"
        return
    fi
    if ! grep -q '^THIS_HOST="keepme"$' "$(node_conf_path "$fixture")"; then
        test_fail "Existing config was rewritten; content:\n$(cat "$(node_conf_path "$fixture")")"
        return
    fi

    test_pass
}

