test_single_node_partial_uninstall_declined() {
    reset_installer_mocks
    test_start "single-node: declined remnant cleanup warns and continues"

    local fixture="$_mock_zfs_state_dir/single-remnants"
    mkdir -p "$fixture/versions-base"
    # A version base without a current symlink looks like an interrupted
    # uninstall. The first stdin line answers the cleanup question with
    # "no" (the installer re-sources bashinit, so ask_yn is the real
    # prompt and reads the piped answers like every other read).
    _mock_stdin=$'n\n\nn'
    local out rc
    out=$(run_installer single "$fixture")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"Remnants of a previous ZFSutilities installation"* ]]; then
        test_fail "Remnant warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"Continuing without cleanup"* ]]; then
        test_fail "Decline path missing; output:\n$out"
        return
    fi

    test_pass
}

# ------------------------------------------------------------------
# install-two-node flows
# ------------------------------------------------------------------

test_two_node_fresh_install() {
    reset_installer_mocks
    test_start "two-node: fresh install prompts, writes config, deploys both hosts"

    local fixture="$_mock_zfs_state_dir/two-fresh"
    _mock_stdin=$'\nztestcomp\n\n\nthreeamigos\n\nNVME1\ntank\n\n8\nn'
    local out rc
    out=$(run_installer two "$fixture")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" == *"FATAL"* || "$out" == *"SSH-UNHANDLED:"* ]]; then
        test_fail "Run not clean; output:\n$out"
        return
    fi

    local conf
    conf="$(node_conf_path "$fixture")"
    # Pool entries are indented inside the POOL_TARGET declaration, so they
    # are matched as substrings, not anchored lines.
    local -a want=(
        '^NODE_MODE="two-node"$'
        '^STORAGE_HOST="zteststor"$'
        '^COMPUTE_HOST="ztestcomp"$'
        '^STORAGE_IP="192.168.100.1"$'
        '^EXPECTED_ISCSI_DEVICES="8"$'
        '\[threeamigos\]="threeamigos"'
        '\[NVME1\]="tank"'
    )
    local pattern
    for pattern in "${want[@]}"; do
        if ! grep -qE "$pattern" "$conf"; then
            test_fail "node.conf lacks $pattern; content:\n$(cat "$conf")"
            return
        fi
    done

    # Deployment config gets the host substitution; both version activations
    # and the remote retention init happen; node.conf is copied to compute.
    if ! grep -q '^DEPLOY_GROUP_production="zteststor ztestcomp"$' \
        "$fixture/etc-zfs/deploy.conf"; then
        test_fail "deploy.conf substitution wrong; content:\n$(cat "$fixture/etc-zfs/deploy.conf")"
        return
    fi
    if [[ "$out" != *"SETUP-TARGETS:"* ]] || [[ "$out" != *"DEPLOY:"* ]] \
        || [[ "$out" != *"SWITCH:9.9.9"* ]]; then
        test_fail "Storage-host steps not recorded; output:\n$out"
        return
    fi
    local remote_switch
    remote_switch="SSH:root@ztestcomp"
    remote_switch+=" /usr/local/lib/zfsutilities/versions/9.9.9/bin/switch-version 9.9.9"
    if [[ "$out" != *"$remote_switch"* ]]; then
        test_fail "Compute-host activation missing; output:\n$out"
        return
    fi
    if [[ "$out" != *installer_retention.py*"--new-install"* ]]; then
        test_fail "Remote retention init missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"SCP:-q $conf root@ztestcomp:$conf"* ]]; then
        test_fail "node.conf not copied to compute; output:\n$out"
        return
    fi

    # Activation is invoked on the storage host (the stub records it); the
    # rtslib-fb-targetctl drop-ins are installed by the REAL switch-version
    # during activation — covered functionally in test-switch-version — so
    # this flow only checks the invocation. Encrypted-luns conf is
    # installed; the retention profile is initialized locally for real.
    if [[ "$out" != *"SWITCH:9.9.9"* ]]; then
        test_fail "Local activation (switch-version 9.9.9) missing; output:\n$out"
        return
    fi
    if [[ ! -f "$fixture/etc-zfs/iscsi-encrypted-luns.conf" ]]; then
        test_fail "Encrypted-luns conf not installed; output:\n$out"
        return
    fi
    if ! grep -q '"default"' "$fixture/state/config.json"; then
        test_fail "Local retention profile missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"Installation Complete"* ]]; then
        test_fail "Completion banner missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"iSCSI fence:  zfsutilities-iscsi-fence.timer active on ztestcomp"* ]]; then
        test_fail "Fence summary mention missing; output:\n$out"
        return
    fi

    test_pass
}

# IQN-prefix drift guard: a fixture saveconfig.json carrying the configured
# target short name under a different prefix must trip the confirmation
# gate. Refusal aborts before setup; explicit consent continues.
test_two_node_iqn_drift_refused() {
    reset_installer_mocks
    test_start "two-node: IQN prefix drift aborts when not confirmed"

    local fixture="$_mock_zfs_state_dir/two-iqn-drift-no"
    mkdir -p "$fixture/etc-prefix/etc/rtslib-fb-target"
    cat > "$fixture/etc-prefix/etc/rtslib-fb-target/saveconfig.json" <<'EOF'
{"targets": [{"wwn": "iqn.2099-01.local.zteststor:threeamigos"}]}
EOF
    _mock_stdin=$'\nztestcomp\n\niqn.2026-02.local.zteststor\nthreeamigos\n\n\n8\nn\nn'
    local out rc
    out=$(run_installer two "$fixture")
    rc=$?

    if [[ $rc -eq 0 ]]; then
        test_fail "Installer completed despite refused drift confirmation; output:\n$out"
        return
    fi
    if [[ "$out" != *"IQN prefix mismatch"* ]]; then
        test_fail "Drift warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"Aborting: resolve the IQN prefix mismatch"* ]]; then
        test_fail "Refusal abort message missing; output:\n$out"
        return
    fi
    if [[ "$out" == *"SETUP-TARGETS:"* ]]; then
        test_fail "Target setup ran despite refusal; output:\n$out"
        return
    fi

    test_pass
}

test_two_node_iqn_drift_confirmed() {
    reset_installer_mocks
    test_start "two-node: IQN prefix drift continues on explicit confirmation"

    local fixture="$_mock_zfs_state_dir/two-iqn-drift-yes"
    mkdir -p "$fixture/etc-prefix/etc/rtslib-fb-target"
    cat > "$fixture/etc-prefix/etc/rtslib-fb-target/saveconfig.json" <<'EOF'
{"targets": [{"wwn": "iqn.2099-01.local.zteststor:threeamigos"}]}
EOF
    _mock_stdin=$'\nztestcomp\n\niqn.2026-02.local.zteststor\nthreeamigos\n\n\n8\nn\ny'
    local out rc
    out=$(run_installer two "$fixture")
    rc=$?

    if [[ $rc -ne 0 ]]; then
        test_fail "Unexpected exit code $rc; output:\n$out"
        return
    fi
    if [[ "$out" != *"IQN prefix mismatch"* ]]; then
        test_fail "Drift warning missing; output:\n$out"
        return
    fi
    if [[ "$out" != *"SETUP-TARGETS:"* ]]; then
        test_fail "Target setup did not run after consent; output:\n$out"
        return
    fi
    if ! grep -q '^IQN_PREFIX="iqn.2026-02.local.zteststor"$' \
        "$(node_conf_path "$fixture")"; then
        local _conf_content
        _conf_content=$(cat "$(node_conf_path "$fixture")")
        test_fail "node.conf lacks the confirmed IQN prefix; content:\\n$_conf_content"
        return
    fi

    test_pass
}

# Script-side usage probe: when a drifted target is still referenced by a
# guest config on the compute host, no confirmation may be offered at all —
# proceeding (or deleting it) would break that guest's disks. The stdin
# ends in "y" so a regression that DOES offer the prompt also proceeds and
# fails the completion assertion.
test_two_node_iqn_drift_in_use_refused() {
    reset_installer_mocks
    test_start "two-node: IQN prefix drift aborts outright when a drifted target is in use"

