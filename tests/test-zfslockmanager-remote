#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfslockmanager-remote — Verify the remote lock agent subcommands.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

AGENT_SCRIPT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/../bin/zfslockmanager-remote"
[[ -f "$AGENT_SCRIPT" ]] || die "Missing: $AGENT_SCRIPT"

# Redirect the lock manager to a temp directory so tests do not require root
# or touch production paths.
REMOTE_LOCK_DIR="$_mock_zfs_state_dir/remote_locks"
mkdir -p "$REMOTE_LOCK_DIR/.locks" "$REMOTE_LOCK_DIR/.pids"

_run_agent() {
    ZFSUTILITIES_BIN_DIR="$mydir/bin" \
    ZFSUTILITIES_CURRENT_BIN_DIR="$mydir/bin" \
    ZFSUTILITIES_SESSION_LOG_DIR="$_mock_zfs_state_dir/logs" \
    ZFSLOCK_DIR="$REMOTE_LOCK_DIR" \
    ZFSLOCK_LOCKS_DIR="$REMOTE_LOCK_DIR/.locks" \
    ZFSLOCK_PIDS_DIR="$REMOTE_LOCK_DIR/.pids" \
    ZFSLOCK_REMOTE_DISABLED=1 \
    bash "$AGENT_SCRIPT" "$@" 2>&1
}

_cleanup_remote_locks() {
    rm -rf "$REMOTE_LOCK_DIR/.locks"/* "$REMOTE_LOCK_DIR/.pids"/* 2>/dev/null
}

# Start the agent's "hold" subcommand in the background and keep it alive
# using a FIFO.  The agent reads from stdin until EOF; a FIFO with a sleeping
# writer keeps stdin open without spawning busy "cat" processes.
# Globals set: _HOLDER_AGENT_PID, _HOLDER_WRITER_PID
_start_holder() {
    local dataset="$1" type="$2" description="$3"
    local fifo="$_mock_zfs_state_dir/holder_$$_${RANDOM}.fifo"
    mkfifo "$fifo" || return 1

    # Hold the write end open with a sleeping subshell.
    (
        exec 3>"$fifo"
        sleep 3600
    ) &
    _HOLDER_WRITER_PID=$!

    ZFSUTILITIES_BIN_DIR="$mydir/bin" \
    ZFSUTILITIES_CURRENT_BIN_DIR="$mydir/bin" \
    ZFSUTILITIES_SESSION_LOG_DIR="$_mock_zfs_state_dir/logs" \
    ZFSLOCK_DIR="$REMOTE_LOCK_DIR" \
    ZFSLOCK_LOCKS_DIR="$REMOTE_LOCK_DIR/.locks" \
    ZFSLOCK_PIDS_DIR="$REMOTE_LOCK_DIR/.pids" \
    ZFSLOCK_REMOTE_DISABLED=1 \
    bash "$AGENT_SCRIPT" hold "$dataset" "$type" "$description" < "$fifo" >/dev/null 2>&1 &
    _HOLDER_AGENT_PID=$!

    rm -f "$fifo"
}

_stop_holder() {
    [[ -n "${_HOLDER_WRITER_PID:-}" ]] && kill "$_HOLDER_WRITER_PID" 2>/dev/null
    [[ -n "${_HOLDER_AGENT_PID:-}" ]] && kill "$_HOLDER_AGENT_PID" 2>/dev/null
    [[ -n "${_HOLDER_AGENT_PID:-}" ]] && wait "$_HOLDER_AGENT_PID" 2>/dev/null
    [[ -n "${_HOLDER_WRITER_PID:-}" ]] && wait "$_HOLDER_WRITER_PID" 2>/dev/null
    _HOLDER_AGENT_PID=""
    _HOLDER_WRITER_PID=""
}

_wait_for_lock() {
    local lockfile="$1"
    local tries=0
    while [[ ! -f "$lockfile" && $tries -lt 50 ]]; do
        sleep 0.1
        ((tries++))
    done
}

test_hold_acquires_lock() {
    test_start "hold acquires lock and prints LOCKED"
    _cleanup_remote_locks
    local output rc
    output=$(_run_agent hold "threeamigos/pve" "w" "holder") && rc=0 || rc=$?
    assert_rc 0 "$rc"
    assert_contains "$output" "LOCKED"
}

test_hold_conflict() {
    test_start "hold reports CONFLICT when lock is already held"
    _cleanup_remote_locks
    _start_holder "threeamigos/conflict" "w" "holder"
    _wait_for_lock "$REMOTE_LOCK_DIR/.locks/threeamigos%2Fconflict.lock"

    local output rc
    output=$(_run_agent hold "threeamigos/conflict" "w" "contender") && rc=0 || rc=$?
    _stop_holder
    assert_rc 1 "$rc"
    assert_contains "$output" "CONFLICT"
}

test_check_available() {
    test_start "check returns available true when lock is free"
    _cleanup_remote_locks
    local output rc
    output=$(_run_agent check "threeamigos/free" "w") && rc=0 || rc=$?
    assert_rc 0 "$rc"
    assert_contains "$output" '"available": true'
}

test_check_locked() {
    test_start "check returns available false when lock is held"
    _cleanup_remote_locks
    _start_holder "threeamigos/locked" "w" "holder"
    _wait_for_lock "$REMOTE_LOCK_DIR/.locks/threeamigos%2Flocked.lock"

    local output rc
    output=$(_run_agent check "threeamigos/locked" "w") && rc=0 || rc=$?
    _stop_holder
    assert_rc 0 "$rc"
    assert_contains "$output" '"available": false'
}

test_list_locks() {
    test_start "list returns active locks"
    _cleanup_remote_locks
    _start_holder "threeamigos/list" "w" "lister"
    _wait_for_lock "$REMOTE_LOCK_DIR/.locks/threeamigos%2Flist.lock"

    local output rc
    output=$(_run_agent list) && rc=0 || rc=$?
    _stop_holder
    assert_rc 0 "$rc"
    assert_contains "$output" '"dataset":"threeamigos/list"'
    assert_contains "$output" '"type":"w"'
}

test_release_removes_lock() {
    test_start "release removes a lock file"
    _cleanup_remote_locks
    local lockfile="$REMOTE_LOCK_DIR/.locks/threeamigos%2Frelease.lock"
    echo '{"dataset":"threeamigos/release","type":"w","pid":"1","script":"test","acquired":"2026-01-01T00:00:00","description":""}' > "$lockfile"
    local rc
    _run_agent release "$lockfile" && rc=0 || rc=$?
    assert_rc 0 "$rc"
    if [[ ! -f "$lockfile" ]]; then
        test_pass
    else
        test_fail "Lock file still exists after release"
    fi
}

test_cleanup_removes_stale_locks() {
    test_start "cleanup removes stale locks"
    _cleanup_remote_locks
    local lockfile="$REMOTE_LOCK_DIR/.locks/stale%2Fdataset.lock"
    echo '{"dataset":"stale/dataset","type":"w","pid":"99999","script":"test","acquired":"2026-01-01T00:00:00","description":""}' > "$lockfile"
    local rc
    _run_agent cleanup && rc=0 || rc=$?
    assert_rc 0 "$rc"
    if [[ ! -f "$lockfile" ]]; then
        test_pass
    else
        test_fail "Stale lock file still exists after cleanup"
    fi
}

test_hold_acquires_lock
test_hold_conflict
test_check_available
test_check_locked
test_list_locks
test_release_removes_lock
test_cleanup_removes_stale_locks

test_summary
teardown_test_env
