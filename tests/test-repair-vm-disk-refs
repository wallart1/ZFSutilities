#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154,SC2016,SC2028
# test-repair-vm-disk-refs — Unit tests for the compute-host VM-config repair.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Mocks
# ------------------------------------------------------------------

IQN_PREFIX="iqn.2026-02.local.stewie"
BP_BASE="/dev/disk/by-path/ip-192.168.100.1:3260-iscsi-${IQN_PREFIX}"

# Mock node-lib.sh behavior
NODE_MODE="two-node"
storage_host="stewie"
compute_host="tweety"
storage_ip="192.168.100.1"
iqn_prefix="$IQN_PREFIX"
is_single_node() { [[ "$NODE_MODE" == "single-node" ]]; }
is_two_node()    { [[ "$NODE_MODE" == "two-node" ]]; }

# qm presence gate (the dev host has no Proxmox); set/status below do the work.
qm() {
    case "$1" in
        set)
            [[ -n "${_qm_log:-}" ]] && printf '%s\n' "$*" >> "$_qm_log"
            return "${_mock_qm_set_rc:-0}"
            ;;
        status)
            printf 'status: %s\n' "${_mock_vm_status[$2]:-stopped}"
            return 0
            ;;
    esac
    return 0
}

# The evaluated script calls find_zfsutility_script to locate node-lib and
# rootcheck; /dev/null keeps the node-lib mocks above in charge (the real
# lib/iscsi-lib.sh is sourced for is_vm_backstore_name).
find_zfsutility_script() { echo "/dev/null"; }

# Remote fetches over ssh: the resolver prints the deployed path, and the
# ssh mock records the command and serves both fetches from fixtures.
remote_zfsutility_script() {
    printf '/usr/local/lib/zfsutilities/current/bin/%s\n' "$2"
}
_ssh_log=""
_lkg_map_file=""
_mock_live_records=""
_mock_ssh_rc=0
ssh() {
    [[ -n "$_ssh_log" ]] && printf '%s\n' "$*" >> "$_ssh_log"
    [[ "${_mock_ssh_rc}" -ne 0 ]] && return "${_mock_ssh_rc}"
    case "$*" in
        *--print-map) cat "$_lkg_map_file" ;;
        *--gather-lun-info) printf '%s\n' "${_mock_live_records}" ;;
    esac
    return 0
}

# ------------------------------------------------------------------
# Load the script under test with node-lib mocked.
# ------------------------------------------------------------------
old_mydir="$mydir"
REPAIR_VM_DISK_REFS_SKIP_ROOT="Y"
REPAIR_VM_DISK_REFS_TEST_MODE="Y"
export REPAIR_VM_DISK_REFS_NODE_LIB="/dev/null"
export REPAIR_VM_DISK_REFS_ISCSI_LIB="$old_mydir/lib/iscsi-lib.sh"
script_orig=$(cat "$old_mydir/bin/repair-vm-disk-refs")
script_text="${script_orig/my_host=\$(hostname -s)/my_host=tweety}"
# The script parses "$@" at the top level; neutralize the test runner's args.
set --
eval "$script_text"
# The script's strict line leaks into this test shell at the eval point;
# restore the test harness's own option state so a failing test reports
# normally instead of aborting the suite.
set +euo pipefail

# ------------------------------------------------------------------
# Fixtures
# ------------------------------------------------------------------
_scratch=""
_conf_dir=""
_by_path_dir=""
_qm_log=""
_rescan_log=""
_rescan_scripts=()
declare -A _mock_vm_status=()
_mock_qm_set_rc=0

link_name() {
    printf 'ip-%s:3260-iscsi-%s:%s-lun-%s' "$storage_ip" "$iqn_prefix" "$1" "$2"
}

add_link() {
    ln -s /dev/null "${_by_path_dir}/$(link_name "$1" "$2")"
}

write_vm_conf() {
    local vmid="$1"
    shift
    local line
    for line in "$@"; do
        printf '%s\n' "$line"
    done > "$_conf_dir/${vmid}.conf"
}

# Render the last-known-good map. Each spec is "short|lun|backstore|zvol".
write_lkg_map() {
    python3 - "$_lkg_map_file" "$@" <<'PYEOF'
import json, sys
path = sys.argv[1]
targets, backstores = {}, {}
for spec in sys.argv[2:]:
    short, lun, bs, zvol = spec.split("|")
    iqn = "iqn.2026-02.local.stewie:" + short
    targets.setdefault(iqn, {"acls": [], "luns": {}})["luns"][lun] = bs
    backstores[bs] = {"dev": zvol, "target": iqn, "lun": int(lun)}
m = {"version": 1, "generated": "2026-10-24T10:00:00+00:00", "host": "stewie",
     "iqn_prefix": "iqn.2026-02.local.stewie", "storage_ip": "192.168.100.1",
     "targets": targets, "backstores": backstores}
with open(path, "w") as f:
    json.dump(m, f, indent=2)
PYEOF
}

# Rewrite one header field of the rendered map (host / iqn_prefix / storage_ip).
patch_lkg_map_field() {
    python3 - "$_lkg_map_file" "$1" "$2" <<'PYEOF'
import json, sys
with open(sys.argv[1]) as f:
    m = json.load(f)
m[sys.argv[2]] = sys.argv[3]
with open(sys.argv[1], "w") as f:
    json.dump(m, f, indent=2)
PYEOF
}

# Set the live exported topology. Each spec is "short|lun|backstore|zvol"
# (the zvol field rides along like the real gather records carry it).
set_live_records() {
    _mock_live_records=""
    local r
    for r in "$@"; do
        _mock_live_records+="LUN|${r%%|*}|${r#*|}"$'\n'
    done
}

# Mock rescan-storage: logs its invocation, then runs the caller-supplied
# snippet (e.g. re-creating a by-path link). No snippet = changes nothing.
make_rescan_mock() {
    local p line
    p=$(mktemp)
    {
        echo '#!/usr/bin/bash'
        echo "printf 'rescan\\n' >> '${_rescan_log}'"
        for line in "$@"; do
            echo "$line"
        done
    } > "$p"
    chmod +x "$p"
    _rescan_scripts+=("$p")
    printf '%s' "$p"
}

reset_mocks() {
    [[ -n "$_scratch" && -d "$_scratch" ]] && rm -rf "$_scratch"
    local _old
    for _old in "${_rescan_scripts[@]:-}"; do
        rm -f "$_old"
    done
    _rescan_scripts=()

    _scratch=$(mktemp -d)
    _conf_dir="$_scratch/qemu-server"
    _by_path_dir="$_scratch/by-path"
    mkdir -p "$_conf_dir" "$_by_path_dir"
    _qm_log="$_scratch/qm.log"
    : > "$_qm_log"
    _ssh_log="$_scratch/ssh.log"
    : > "$_ssh_log"
    _rescan_log="$_scratch/rescan.log"
    : > "$_rescan_log"
    _lkg_map_file="$_scratch/iscsi-state.json"
    _mock_live_records=""
    _mock_ssh_rc=0
    _mock_qm_set_rc=0
    _mock_vm_status=()

    unset REPAIR_VM_DISK_REFS_LKG_MAP_FILE REPAIR_VM_DISK_REFS_LIVE_MAP_FILE
    REPAIR_VM_DISK_REFS_CONF_DIR="$_conf_dir"
    REPAIR_VM_DISK_REFS_BY_PATH_DIR="$_by_path_dir"
    export REPAIR_VM_DISK_REFS_CONF_DIR REPAIR_VM_DISK_REFS_BY_PATH_DIR
    local p
    p=$(make_rescan_mock)
    REPAIR_VM_DISK_REFS_RESCAN_STORAGE="$p"
    export REPAIR_VM_DISK_REFS_RESCAN_STORAGE

    dry_run=false
    assume_yes=false
}

# Run main() capturing combined output (the script under test re-sources
# bin/bashinit when eval'd, reinstating the real log_msg on stderr, so
# assertions grep the captured output rather than the test log).
run_main() {
    _main_rc=0
    _main_out=$(main 2>&1) || _main_rc=$?
}

log_has() {
    [[ "$_main_out" == *"$1"* ]]
}

qm_calls() {
    [[ -f "$_qm_log" ]] && cat "$_qm_log" || true
}

ssh_calls() {
    [[ -f "$_ssh_log" ]] && cat "$_ssh_log" || true
}

ssh_call_count() {
    printf '%s\n' "$(ssh_calls)" | grep -c .
}

rescan_called() {
    [[ -f "$_rescan_log" ]] && grep -q . "$_rescan_log"
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_script_loads() {
    test_start "repair-vm-disk-refs sources with mocked dependencies"
    if declare -f main >/dev/null 2>&1 \
        && declare -f plan_repairs >/dev/null 2>&1 \
        && declare -f vm_conf_gather >/dev/null 2>&1; then
        test_pass
    else
        test_fail "main/plan/gather functions should be defined after sourcing"
    fi
}

test_single_node_silent_exit() {
    test_start "Single-node mode exits silently at source time"
    local rc=0 out
    out=$( NODE_MODE="single-node" eval "$script_text" 2>/dev/null ) || rc=$?
    if [[ "$rc" -eq 0 && -z "$out" ]]; then
        test_pass
    else
        test_fail "Expected silent exit 0, got rc=$rc out='$out'"
    fi
}

test_wrong_host_refused() {
    test_start "Running anywhere but the compute host is refused"
    local wrong="${script_orig/my_host=\$(hostname -s)/my_host=stewie}"
    local rc=0 out
    out=$( eval "$wrong" 2>&1 ) || rc=$?
    if [[ "$rc" -eq 1 && "$out" == *"Must run on the compute host (tweety), not stewie"* ]]; then
        test_pass
    else
        test_fail "rc=$rc out='$out'"
    fi
}

test_no_qm_refused() {
    test_start "A host without Proxmox VE (qm) is refused"
    local rc=0 out
    out=$( unset -f qm; eval "$script_text" 2>&1 ) || rc=$?
    if [[ "$rc" -eq 1 && "$out" == *"requires Proxmox VE (qm command not found)"* ]]; then
        test_pass
    else
        test_fail "rc=$rc out='$out'"
    fi
}

test_unknown_option_usage() {
    test_start "Unknown options print usage and exit 1"
    local rc=0 out
    out=$( parse_cli_args --frob 2>&1 ) || rc=$?
    if [[ "$rc" -eq 1 && "$out" == *"Unknown option: --frob"* \
