test_clean_rewrite_preserves_options() {
    reset_mocks
    # VM 211's scsi0 references the slot it held at map time (LUN 5); the
    # disk now lives at LUN 12. The line's options must survive untouched.
    write_vm_conf 211 \
        "name: testvm" \
        "scsi0: ${BP_BASE}:threeamigos-lun-5,size=100G,discard=on"
    write_lkg_map \
        "threeamigos|5|vm-211-disk-0|/dev/zvol/threeamigos/proxmox/vm-211-disk-0"
    set_live_records \
        "threeamigos|12|vm-211-disk-0|/dev/zvol/threeamigos/proxmox/vm-211-disk-0"
    add_link threeamigos 12
    assume_yes=true
    test_start "A clean rewrite changes only the volume; options stay byte-for-byte"

    run_main
    local ok=true
    [[ "$_main_rc" -eq 0 ]] || ok=false
    log_has "VM 211 (testvm) scsi0: threeamigos LUN 5 → threeamigos LUN 12" \
        || ok=false
    grep -qxF "set 211 --scsi0 ${_by_path_dir}/$(link_name threeamigos 12),size=100G,discard=on" \
        "$_qm_log" || ok=false
    # Nothing else was touched: exactly one qm call, no old LUN in it.
    [[ "$(qm_calls | grep -c .)" -eq 1 ]] || ok=false
    [[ "$(qm_calls)" != *"lun-5"* ]] || ok=false
    log_has "All 1 rewritten reference(s) resolve to live devices" || ok=false
    ! rescan_called || ok=false

    if [[ "$ok" == true ]]; then
        test_pass
    else
        test_fail "rc=$_main_rc — qm calls: $(qm_calls)"
    fi
}

