        "threeamigos|5|vm-211-disk-0|/dev/zvol/threeamigos/proxmox/vm-211-disk-0"
    set_live_records \
        "threeamigos|12|vm-211-disk-0|/dev/zvol/threeamigos/proxmox/vm-211-disk-0"
    test_start "Declining the confirmation makes no changes"

    local rc=0 errfile
    errfile=$(mktemp)
    printf 'n\n' | main >/dev/null 2>"$errfile" || rc=$?
    _main_out=$(cat "$errfile")
    rm -f "$errfile"

    local ok=true
    [[ "$rc" -eq 1 ]] || ok=false
    log_has "Aborted — no changes made" || ok=false
    [[ -z "$(qm_calls)" ]] || ok=false

    if [[ "$ok" == true ]]; then
        test_pass
    else
        test_fail "rc=$rc — decline did not abort cleanly"
    fi
}

