#!/usr/bin/bash
# test-zfsrestore — Unit tests for the zfsrestore command.

source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/test-lib.sh"
setup_test_env

# ------------------------------------------------------------------
# Test helpers
# ------------------------------------------------------------------

_run_zfsrestore() {
    local _state_dir="$1"
    shift
    local _mock_bin="$_state_dir/mockbin"
    mkdir -p "$_mock_bin"

    # Copy the script under test into the mock bin directory so helper
    # resolution (via $mydir) finds our stubs instead of the real ones.
    cp "$mydir/bin/zfsrestore" "$_mock_bin/zfsrestore"

    local _send_receive_rc="${ZFSRESTORE_SEND_RECEIVE_RC:-0}"
    local _iscsi_rc="${ZFSRESTORE_ISCSI_RC:-0}"
    local _reapply_rc="${ZFSRESTORE_REAPPLY_RC:-0}"
    cat > "$_mock_bin/zfs-send-receive" <<'EOF'
send-receive() {
    echo "send-receive called with: $*" >> "$ZFSRESTORE_STATE/send-receive.calls"
    echo "doincrementals=$doincrementals" \
        >> "$ZFSRESTORE_STATE/send-receive.calls"
    echo "force=$force" >> "$ZFSRESTORE_STATE/send-receive.calls"
    echo "commsnap_mostrecent=$commsnap_mostrecent" \
        >> "$ZFSRESTORE_STATE/send-receive.calls"
    echo "sourcefsremovequalifiers=$sourcefsremovequalifiers" \
        >> "$ZFSRESTORE_STATE/send-receive.calls"
EOF
    echo "    return $_send_receive_rc" >> "$_mock_bin/zfs-send-receive"
    cat >> "$_mock_bin/zfs-send-receive" <<'EOF'
}
EOF
    cat > "$_mock_bin/zfsoverrides" <<'EOF'
overrides() {
    echo "overrides called with: $*" >> "$ZFSRESTORE_STATE/overrides.calls"
    if [[ $# -gt 0 ]]; then
        local overrides="$*"
        eval "$overrides"
    fi
}
EOF
    cat > "$_mock_bin/zfssnapbuild" <<'EOF'
zfssnapbuild() {
    echo "@test-snap"
}
EOF
    cat > "$_mock_bin/zfsremoveleadingqualifiers" <<'EOF'
remove_leading_qualifiers() {
    echo "$2"
}
EOF
    cat > "$_mock_bin/bashfatal" <<'EOF'
exit "${1:-8}"
EOF
    cat > "$_mock_bin/ensure-restored-vm-iscsi" <<EOF
#!/usr/bin/bash
echo "ensure-restored-vm-iscsi called with: \$*" \\
    >> "\$ZFSRESTORE_STATE/iscsi.calls"
exit $_iscsi_rc
EOF
    chmod +x "$_mock_bin/ensure-restored-vm-iscsi"

    cat > "$_mock_bin/zfsreapplyholds" <<'EOF'
reapplyholds_capture() {
    echo "capture: $*" >> "$ZFSRESTORE_STATE/reapply.calls"
    if [[ -n "$2" ]]; then
        printf '%s\t%s\n' "${destfs}@placeholder" "kept" > "$2"
    fi
}
reapplyholds_apply() {
    echo "apply: $*" >> "$ZFSRESTORE_STATE/reapply.calls"
    return $_reapply_rc
}
EOF

    (
        # shellcheck disable=SC2034
        # Intentionally set for sourced zfsrestore script.
        ZFSRESTORE_STATE="$_state_dir"
        mydir="$_mock_bin"
        # Inhibit the iSCSI post-restore helper by using an empty fsarray.
        # shellcheck disable=SC2034
        # Intentionally set for sourced zfsrestore script.
        fsarray=()
        # Redirect mktemp to a predictable path inside the test state.
        mktemp() {
            echo "$_state_dir/zfsrestore-target-holds.current"
        }
        # shellcheck source=/dev/null
        source "$_mock_bin/zfsrestore"
    ) >"$_state_dir/out" 2>"$_state_dir/err"
    echo $? > "$_state_dir/rc"
}

# ------------------------------------------------------------------
# Tests
# ------------------------------------------------------------------

test_zfsrestore_applies_overrides() {
    test_start "zfsrestore applies overrides when provided"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_overrides"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest; someoverride=1"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    if [[ -f "$_state_dir/overrides.calls" ]]; then
        assert_contains "$(cat "$_state_dir/overrides.calls")" "someoverride=1"
    else
        test_fail "overrides was not called"
    fi
}

test_zfsrestore_applies_second_overrides() {
    test_start "zfsrestore applies legacy second overrides"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_second_overrides"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest; first=1" "second=2"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    assert_contains "$(cat "$_state_dir/overrides.calls")" "first=1"
    assert_contains "$(cat "$_state_dir/overrides.calls")" "second=2"
}

test_zfsrestore_defaults_remove_qualifiers() {
    test_start "zfsrestore defaults sourcefsremovequalifiers to 0"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_default_qualifiers"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" \
        "sourcefsremovequalifiers=0"
}

test_zfsrestore_requires_restoresourcefs() {
    test_start "zfsrestore is fatal when restoresourcefs is missing"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_missing_source"
    mkdir -p "$_state_dir"
    destfs="pool/dest" _run_zfsrestore "$_state_dir"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 8 "$rc"
}

test_zfsrestore_requires_destfs() {
    test_start "zfsrestore is fatal when destfs is missing"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_missing_dest"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" "restoresourcefs=pool/src"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 8 "$rc"
}

test_zfsrestore_calls_send_receive_once() {
    test_start "zfsrestore invokes send-receive once"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_once"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    local calls
    calls=$(grep -c "send-receive called with" \
        "$_state_dir/send-receive.calls" 2>/dev/null || echo 0)
    if [[ "$calls" -eq 1 ]]; then
        test_pass
    else
        test_fail "Expected 1 send-receive call, got $calls"
    fi
}

test_zfsrestore_sets_full_copy_parameters() {
    test_start "zfsrestore sets full-copy parameters for send-receive"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_full_copy_params"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" \
        "doincrementals=N"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" "force=Y"
    assert_contains "$(cat "$_state_dir/send-receive.calls")" \
        "commsnap_mostrecent=OLDEST"
}

test_zfsrestore_preserves_target_holds() {
    test_start "zfsrestore captures and reapplies target holds"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_preserve_holds"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"

    local _calls
    _calls=$(cat "$_state_dir/reapply.calls")
    assert_contains "$_calls" "capture: pool/dest"
    assert_contains "$_calls" "apply: pool/dest"
    # Capture must run before apply.
    local _cap_line _apply_line
    _cap_line=$(grep -n "capture:" "$_state_dir/reapply.calls" | head -n1 | cut -d: -f1)
    _apply_line=$(grep -n "apply:" "$_state_dir/reapply.calls" | head -n1 | cut -d: -f1)
    if [[ "$_cap_line" -lt "$_apply_line" ]]; then
        test_pass
    else
        test_fail "Capture should run before apply"
    fi
}

test_zfsrestore_skips_hold_preservation_when_disabled() {
    test_start "zfsrestore skips hold preservation when preserve_target_holds=N"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_no_preserve_holds"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest; preserve_target_holds='N'"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"

    if [[ -f "$_state_dir/reapply.calls" ]]; then
        test_fail "Hold helpers should not be called when disabled"
    else
        test_pass
    fi
}

test_zfsrestore_dry_run_applies_holds_logged() {
    test_start "zfsrestore passes dry-run flag to hold reapply"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_dryrun_holds"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest; dryrun='Y'"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"

    assert_contains "$(cat "$_state_dir/reapply.calls")" "apply: pool/dest"
    assert_contains "$(cat "$_state_dir/reapply.calls")" "Y"
}

test_zfsrestore_removes_temp_file_on_success() {
    test_start "zfsrestore removes captured-holds temp file on success"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_success_temp"
    mkdir -p "$_state_dir"
    _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    assert_rc 0 "$rc"
    if [[ -e "$_state_dir/zfsrestore-target-holds.current" ]]; then
        test_fail "Temp file should have been removed on success"
    else
        test_pass
    fi
}

test_zfsrestore_preserves_temp_file_on_failure() {
    test_start "zfsrestore preserves captured-holds temp file on failure"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_failure_temp"
    mkdir -p "$_state_dir"
    clear_test_log_file
    ZFSRESTORE_SEND_RECEIVE_RC=1 _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    if [[ "$rc" -eq 0 ]]; then
        test_fail "Expected non-zero exit code on failure, got $rc"
        return
    fi
    if [[ ! -e "$_state_dir/zfsrestore-target-holds.current" ]]; then
        test_fail "Temp file should have been preserved on failure"
        return
    fi
    if grep -q "leaving captured-holds temp file for diagnosis" \
            "$_state_dir/err"; then
        test_pass
    else
        test_fail "Expected log message about residual captured-holds file"
    fi
}

test_zfsrestore_cleans_residual_temp_file_on_startup() {
    test_start "zfsrestore removes residual captured-holds temp file on startup"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_residual_temp"
    mkdir -p "$_state_dir"
    local _residual="$_state_dir/zfsrestore-target-holds.residual"
    touch "$_residual"
    TMPDIR="$_state_dir" _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest"
    if [[ -e "$_residual" ]]; then
        test_fail "Residual temp file should have been removed on startup"
    else
        test_pass
    fi
}

test_zfsrestore_propagates_ensure_restored_iscsi_failure() {
    test_start "zfsrestore propagates ensure-restored-vm-iscsi failure"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_iscsi_failure"
    mkdir -p "$_state_dir"
    ZFSRESTORE_ISCSI_RC=1 _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest; fsarray=(pool/src/vm-100)"
    local rc
    rc=$(cat "$_state_dir/rc")
    if [[ "$rc" -eq 0 ]]; then
        test_fail "Expected non-zero exit code on iSCSI failure, got $rc"
        return
    fi
    if [[ ! -e "$_state_dir/zfsrestore-target-holds.current" ]]; then
        test_fail "Temp file should have been preserved on iSCSI failure"
        return
    fi
    test_pass
}

test_zfsrestore_propagates_reapplyholds_apply_failure() {
    test_start "zfsrestore propagates reapplyholds_apply failure"
    local _state_dir
    _state_dir="$_mock_zfs_state_dir/zfsrestore_reapply_failure"
    mkdir -p "$_state_dir"
    ZFSRESTORE_REAPPLY_RC=1 _run_zfsrestore "$_state_dir" \
        "restoresourcefs=pool/src; destfs=pool/dest"
    local rc
    rc=$(cat "$_state_dir/rc")
    if [[ "$rc" -eq 0 ]]; then
        test_fail "Expected non-zero exit code on reapply failure, got $rc"
        return
    fi
    if [[ ! -e "$_state_dir/zfsrestore-target-holds.current" ]]; then
        test_fail "Temp file should have been preserved on reapply failure"
        return
    fi
    test_pass
}

# ------------------------------------------------------------------
# Run tests
# ------------------------------------------------------------------

test_zfsrestore_applies_overrides
test_zfsrestore_applies_second_overrides
test_zfsrestore_defaults_remove_qualifiers
test_zfsrestore_requires_restoresourcefs
test_zfsrestore_requires_destfs
test_zfsrestore_calls_send_receive_once
test_zfsrestore_sets_full_copy_parameters
test_zfsrestore_preserves_target_holds
test_zfsrestore_skips_hold_preservation_when_disabled
test_zfsrestore_dry_run_applies_holds_logged
test_zfsrestore_removes_temp_file_on_success
test_zfsrestore_preserves_temp_file_on_failure
test_zfsrestore_cleans_residual_temp_file_on_startup
test_zfsrestore_propagates_ensure_restored_iscsi_failure
test_zfsrestore_propagates_reapplyholds_apply_failure

teardown_test_env
test_summary
