#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# test-zfsmassdelsnaps — Unit tests for snapshot mass delete.

# shellcheck source=tests/test-lib.sh
source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

old_mydir="$mydir"
mock_mydir=$(mktemp -d)
_mock_cleanup_log="${mock_mydir}/cleanup_calls.log"
: > "${_mock_cleanup_log}"
mydir="$mock_mydir"

cat > "$mock_mydir/rootcheck" <<'EOF'
rootcheck() { true; }
EOF

cat > "$mock_mydir/bashreturn" <<'EOF'
return "${1:-0}"
EOF

cat > "$mock_mydir/zfsbuildfsarray" <<'EOF'
buildfsarray() {
    local _pool_specific="_mock_fsarray_$1"
    if [[ -n "${!_pool_specific+x}" ]]; then
        eval "fsarray=(\"\${$_pool_specific[@]}\")"
    elif [[ ${#_mock_fsarray[@]} -gt 0 ]]; then
        fsarray=("${_mock_fsarray[@]}")
    else
        fsarray=("$1")
    fi
}
EOF

cat > "$mock_mydir/zfsdelsnap" <<'EOF'
delsnap() {
    _mock_delsnap_calls+=("$1|$2|$3|$4")
    _mock_delsnap_autoproceed+=("${autoproceed:-unset}")
    return 0
}
EOF

cat > "$mock_mydir/zfsdelsnap" <<'EOF'
delsnap() {
    _mock_delsnap_calls+=("$1|$2|$3|$4")
    _mock_delsnap_autoproceed+=("${autoproceed:-unset}")
    return 0
}
# Mirrors snapshot_age_days from bin/zfsdelsnap; the mock zfs() serves
# creation epochs via mock_zfs_prop <snap> creation <epoch>.
snapshot_age_days() {
    local creation
    creation=$(zfs get -Hp -o value creation "$1" 2>/dev/null) || { echo -1; return; }
    [[ "$creation" =~ ^[0-9]+$ ]] || { echo -1; return; }
    echo $(( ($(date +%s) - creation) / 86400 ))
}
EOF

cat > "$mock_mydir/zfscleanup" <<'EOF'
cleanup() {
    echo "$* releaseholds=${releaseholds:-N}" >> "${_mock_cleanup_log}"
    local pool="${1:-}"
    # Echo would-be removal lines for the respect-retention path to parse.
    if [[ "${dryrun:-N}" == "Y" && "${_mock_cleanup_empty:-N}" != "Y" ]]; then
        printf 'INFO: Would: Remove %s@dailybackup-2025-03-28T10:00-04:00-d --- Bucket.\n' "$pool"
        if [[ "${_mock_cleanup_keep_line:-N}" == "Y" ]]; then
            local _keep='INFO: Would: Keep %s@dailybackup-2025-03-27T10:00-04:00-d --- Bucket'
            _keep="${_keep}; only 12 days old (minimum age is 45 days).\n"
            printf "$_keep" "$pool"
        fi
        if [[ "${_mock_cleanup_gate_keep_line:-N}" == "Y" ]]; then
            local _gate_keep='INFO: Would: Keep %s@dailybackup-2025-03-27T10:00-04:00-d --- Bucket'
            _gate_keep="${_gate_keep}; counterpart pool(s) offline.\n"
            printf "$_gate_keep" "$pool"
        fi
        printf 'INFO: Would: Remove %s@dailybackup-2025-03-29T10:00-04:00-d --- Bucket.\n' "$pool"
    fi
    return 0
}
EOF

cat > "$mock_mydir/zfslockmanager" <<'EOF'
zfslock_init() { true; }
zfslock_acquire() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_wait_or_resolve() { zfslock_id="/tmp/mock_lock_$$"; return 0; }
zfslock_release() { true; }
zfslock_release_all() { true; }
EOF

source "$old_mydir/bin/zfsmassdelsnaps"

reset_state() {
    _mock_delsnap_calls=()
    _mock_delsnap_autoproceed=()
    : > "${_mock_cleanup_log}"
    _mock_fsarray=()
    _mock_fsarray_pool1=()
    _mock_zfs_snap_lists=()
    _mock_zfs_props=()
    _mock_cleanup_empty="N"
    _mock_cleanup_keep_line="N"
    _mock_cleanup_gate_keep_line="N"
    snapshot_label=""
    snapshot_has=""
    includes=()
    excludes=()
    startwith=""
    endwith=""
    ignore_retention_policies="N"
    releaseholds="N"
    dryrun="N"
}

# -----------------------------------------------------------------------------
# Ignore retention policies mode
# -----------------------------------------------------------------------------

test_no_matching_snapshots() {
    echo "=== Ignore mode: no snapshots match ==="
    reset_state
    snapshot_label="dailybackup"
    snapshot_has="nomatch"
    ignore_retention_policies="Y"
    _mock_fsarray_pool1=("pool1/fs")
    mock_zfs_snap_list_for "pool1/fs" "pool1/fs@dailybackup-2025-03-28T10:00-04:00-d"
    mass_delete_snapshots pool1 >/dev/null
    test_start "Returns 0 and deletes nothing when no snapshots match"
    if [[ ${#_mock_delsnap_calls[@]} -eq 0 ]]; then
        test_pass
    else
        test_fail "Expected no deletions, got: ${_mock_delsnap_calls[*]}"
    fi
}

test_ignore_dryrun_lists_only() {
    echo "=== Ignore mode: dry run lists but does not delete ==="
    reset_state
    snapshot_label="dailybackup"
    snapshot_has="dailybackup"
    ignore_retention_policies="Y"
    dryrun="Y"
    _mock_fsarray_pool1=("pool1/fs")
    local _snaplist=$'pool1/fs@dailybackup-2025-03-28T10:00-04:00-d\n'
    _snaplist+=$'pool1/fs@dailybackup-2025-03-29T10:00-04:00-d'
    mock_zfs_snap_list_for "pool1/fs" "$_snaplist"
    mock_zfs_prop "pool1/fs@dailybackup-2025-03-28T10:00-04:00-d" "creation" "1711630800"
    mock_zfs_prop "pool1/fs@dailybackup-2025-03-29T10:00-04:00-d" "creation" "1711717200"
    mock_zfs_prop "pool1/fs@dailybackup-2025-03-28T10:00-04:00-d" "used" "1073741824"
    mock_zfs_prop "pool1/fs@dailybackup-2025-03-29T10:00-04:00-d" "used" "2147483648"
    local output
    mass_delete_snapshots pool1 > "${mock_mydir}/test_output.txt" 2>&1
    output=$(cat "${mock_mydir}/test_output.txt")
    test_start "Dry run does not call delsnap"
    if [[ ${#_mock_delsnap_calls[@]} -eq 0 ]]; then
        test_pass
    else
        test_fail "Expected no deletions, got: ${_mock_delsnap_calls[*]}"
    fi
    test_start "Dry run reports estimated space freed"
    if [[ "$output" == *"Estimated disk space that would be freed: ~3.0Gi"* ]]; then
        test_pass
    else
        test_fail "Expected estimate message, got: $output"
    fi
}

test_ignore_dryrun_unknown_age_displays_zero() {
    echo "=== Ignore mode: unreadable creation age displays as 0 days ==="
    reset_state
    snapshot_label="dailybackup"
    snapshot_has="dailybackup"
    ignore_retention_policies="Y"
    dryrun="Y"
    _mock_fsarray_pool1=("pool1/fs")
    mock_zfs_snap_list_for "pool1/fs" "pool1/fs@dailybackup-2025-03-28T10:00-04:00-d"
    # No creation prop: snapshot_age_days reports -1 (age unknown) and the
    # listing clamps the display to 0 days old.
    mock_zfs_prop "pool1/fs@dailybackup-2025-03-28T10:00-04:00-d" "used" "1073741824"
    local output
    mass_delete_snapshots pool1 > "${mock_mydir}/test_output.txt" 2>&1
    output=$(cat "${mock_mydir}/test_output.txt")
    test_start "Unreadable creation lists the snapshot as 0 days old"
    if [[ "$output" == *"pool1/fs@dailybackup-2025-03-28T10:00-04:00-d"* ]] \
        && [[ "$output" == *"(0 days old)"* ]]; then
        test_pass
    else
        test_fail "Expected a '(0 days old)' listing, got: $output"
    fi
}

