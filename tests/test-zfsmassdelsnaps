test_respect_parses_candidates() {
    echo "=== Respect mode: parses candidate snapshots ==="
    reset_state
    snapshot_label="dailybackup"
    ignore_retention_policies="N"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "creation" "1711630800"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "creation" "1711717200"
    mock_zfs_prop "pool2@dailybackup-2025-03-28T10:00-04:00-d" "creation" "1711630800"
    mock_zfs_prop "pool2@dailybackup-2025-03-29T10:00-04:00-d" "creation" "1711717200"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "used" "268435456"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "used" "268435456"
    mock_zfs_prop "pool2@dailybackup-2025-03-28T10:00-04:00-d" "used" "268435456"
    mock_zfs_prop "pool2@dailybackup-2025-03-29T10:00-04:00-d" "used" "268435456"
    local output
    mass_delete_snapshots pool1 pool2 <<< "Y" > "${mock_mydir}/test_output.txt" 2>&1
    output=$(cat "${mock_mydir}/test_output.txt")
    test_start "Calls cleanup once per pool in real mode"
    local cleanup_count
    cleanup_count=$(wc -l < "${_mock_cleanup_log}")
    if [[ "$cleanup_count" -eq 4 ]]; then
        test_pass
    else
        test_fail "Expected 4 cleanup calls, got: $(cat "${_mock_cleanup_log}")"
    fi
    test_start "Real run reports estimated space freed"
    if [[ "$output" == *"Estimated disk space that would be freed: ~1.0Gi"* ]]; then
        test_pass
    else
        test_fail "Expected estimate message, got: $output"
    fi
}

test_respect_dryrun_ignores_keep_lines() {
    echo "=== Respect mode: Would: Keep lines are not candidates ==="
    reset_state
    snapshot_label="dailybackup"
    ignore_retention_policies="N"
    dryrun="Y"
    _mock_cleanup_keep_line="Y"
    mock_zfs_prop "pool1@dailybackup-2025-03-27T10:00-04:00-d" "creation" "1711544400"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "creation" "1711630800"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "creation" "1711717200"
    # The too-young snapshot carries the largest used value: if the parser
    # wrongly collected it, both the count and the space estimate would grow.
    mock_zfs_prop "pool1@dailybackup-2025-03-27T10:00-04:00-d" "used" "1073741824"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "used" "268435456"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "used" "268435456"
    local output
    mass_delete_snapshots pool1 > "${mock_mydir}/test_output.txt" 2>&1
    output=$(cat "${mock_mydir}/test_output.txt")
    test_start "Candidate count excludes Would: Keep snapshots"
    if [[ "$output" == *"The following 2 snapshots would be removed:"* ]]; then
        test_pass
    else
        test_fail "Expected 2 candidates, got: $output"
    fi
    test_start "Space estimate excludes Would: Keep snapshots"
    if [[ "$output" == *"Estimated disk space that would be freed: ~512Mi"* \
        && "$output" != *"~1.5Gi"* ]]; then
        test_pass
    else
        test_fail "Expected ~512Mi estimate (Keep line excluded), got: $output"
    fi
}

test_respect_dryrun_ignores_gate_keep_lines() {
    echo "=== Respect mode: gate-reason Would: Keep lines are not candidates ==="
    reset_state
    snapshot_label="dailybackup"
    ignore_retention_policies="N"
    dryrun="Y"
    # The preview-gate keep variant: a snapshot the deletion-time gates
    # (here: counterpart pool offline) would hold back. The parsed approval
    # list must exclude it, so massdelsnaps stops over-promising removals
    # the real run's gates keep.
    _mock_cleanup_gate_keep_line="Y"
    mock_zfs_prop "pool1@dailybackup-2025-03-27T10:00-04:00-d" "creation" "1711544400"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "creation" "1711630800"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "creation" "1711717200"
    mock_zfs_prop "pool1@dailybackup-2025-03-27T10:00-04:00-d" "used" "1073741824"
    mock_zfs_prop "pool1@dailybackup-2025-03-28T10:00-04:00-d" "used" "268435456"
    mock_zfs_prop "pool1@dailybackup-2025-03-29T10:00-04:00-d" "used" "268435456"
    local output
    mass_delete_snapshots pool1 > "${mock_mydir}/test_output.txt" 2>&1
    output=$(cat "${mock_mydir}/test_output.txt")
    test_start "Candidate count excludes gate-kept snapshots"
    if [[ "$output" == *"The following 2 snapshots would be removed:"* ]]; then
        test_pass
    else
        test_fail "Expected 2 candidates, got: $output"
    fi
    test_start "Space estimate excludes gate-kept snapshots"
    if [[ "$output" == *"Estimated disk space that would be freed: ~512Mi"* \
        && "$output" != *"~1.5Gi"* ]]; then
        test_pass
    else
        test_fail "Expected ~512Mi estimate (gate-keep excluded), got: $output"
    fi
}

