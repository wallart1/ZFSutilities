# -----------------------------------------------------------------------------
# Respect retention policies mode
# -----------------------------------------------------------------------------

test_respect_no_matching_snapshots() {
    echo "=== Respect mode: no snapshots match ==="
    reset_state
    snapshot_label="dailybackup"
    ignore_retention_policies="N"
    dryrun="Y"
    _mock_cleanup_empty="Y"
    local output
    output=$(mass_delete_snapshots pool1 2>&1)
    test_start "Reports no snapshots when none would be removed"
    local cleanup_count
    cleanup_count=$(wc -l < "${_mock_cleanup_log}")
    if [[ "$cleanup_count" -ne 1 || ${#_mock_delsnap_calls[@]} -ne 0 ]]; then
        test_fail "Unexpected calls: cleanup=${cleanup_count} delsnap=${_mock_delsnap_calls[*]}"
    elif [[ "$output" == *"No snapshots would be removed by retention policies."* ]]; then
        test_pass
    else
        test_fail "Expected 'No snapshots would be removed' message, got: $output"
    fi
}

