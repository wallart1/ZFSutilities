test_run_installer_expected_rc_contract() {
    test_start "run_installer pins the chosen exit code (graceful-failure paths)"
    local work="$tmp_dir/run-installer"
    mkdir -p "$work"
    # Columns: installer rc, expected-rc argument ("-" = omitted, the
    # pre-failure-path call shape), wanted stage rc.  The (1, 1) row is
    # the contract j08/j09 stand on: a graceful installer abort is a
    # PASS for a failure-path journey.
    local feed_rc exp_arg want_rc idx=0
    while read -r feed_rc exp_arg want_rc; do
        idx=$((idx + 1))
        (
            ITF_RUN_DIR="$work/case$idx"
            mkdir -p "$ITF_RUN_DIR"
            # shellcheck disable=SC1091
            source "$mydir/tests/integrated/journeys/common.sh"
            itf_guest_exec_feed() { return "$feed_rc"; }
            itf_artifact() { return 0; }
            _steps=""
            itf_step() { _steps+="$1:$3 "; return 0; }
            local -a args=(10.9.9.9 'y\n' "installer case $idx")
            if [[ "$exp_arg" != "-" ]]; then args+=("$exp_arg"); fi
            itf_journey_run_installer "${args[@]}"
            echo "$?" > "$ITF_RUN_DIR/rc"
            printf '%s' "$_steps" > "$ITF_RUN_DIR/steps"
        ) > /dev/null 2>&1
        assert_rc "$want_rc" "$(cat "$work/case$idx/rc")"
    done <<'EOF'
0 - 0
1 1 0
1 - 1
0 1 1
EOF
    assert_contains "$(cat "$work/case2/steps")" "graceful failure path"
}

test_prepare_install_tolerates_expected_prereq_failure() {
    test_start "prepare_install aborts on tooling/download failure, tolerates the prereq failure"
    local work="$tmp_dir/prepare-install"
    mkdir -p "$work"
    # Columns: tooling rc, download rc, prereq rc, wanted stage rc.  A
    # FAILING prereq check is the fresh-system norm — the stage must
    # carry on so failure-path journeys can drive their own feeds.
    local tooling_rc download_rc prereq_rc want_rc idx=0
    while read -r tooling_rc download_rc prereq_rc want_rc; do
        idx=$((idx + 1))
        (
            ITF_RUN_DIR="$work/case$idx"
            mkdir -p "$ITF_RUN_DIR"
            # shellcheck disable=SC1091
            source "$mydir/tests/integrated/journeys/common.sh"
            itf_guest_exec() {
                case "$2" in
                    *apt-get*) return "$tooling_rc" ;;
                    *check-prerequisites*) return "$prereq_rc" ;;
                esac
                return 0
            }
            itf_journey_stage_download() {
                echo called >> "$ITF_RUN_DIR/dl-called"
                return "$download_rc"
            }
            itf_step() { return 0; }
            itf_artifact() { return 0; }
            itf_journey_stage_prepare_install 10.9.9.9
            echo "$?" > "$ITF_RUN_DIR/rc"
        ) > /dev/null 2>&1
        assert_rc "$want_rc" "$(cat "$work/case$idx/rc")"
    done <<'EOF'
1 0 1 1
0 1 1 1
0 0 1 0
0 0 0 0
EOF
    # A tooling failure must abort before the download stage ever runs.
    if [[ -e "$work/case1/dl-called" ]]; then
        test_fail "download stage ran despite the tooling failure"
    else
        test_pass
    fi
}

