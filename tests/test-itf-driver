test_stage_os_rerun_rolls_back_not_installs() {
    test_start "stage_os rerun branch rolls back instead of installing"
    local work="$tmp_dir/stage-os-rerun"
    mkdir -p "$work"
    printf 'guest.txt base.invalid 8005\n' > "$work/rerun-guests.tsv"
    (
        # shellcheck disable=SC2034  # consumed by the sourced stage functions
        ITF_RUN_DIR="$work"
        # shellcheck disable=SC1091
        source "$mydir/tests/integrated/journeys/common.sh"
        _calls=""
        _installed=0
        itf_qm() {
            _calls+="$2:$3 "
            if [[ "$2" == "listsnapshot" ]]; then
                # Real qm listsnapshot shape: tree arrow first, name
                # second; the newer-than-checkpoint snapshot (plus the
                # current marker) exercises the stale sweep's parsing.
                printf '`-> os-installed  today   1.5 GiB\n'
                printf '`-> pools-created  today   0 B\n'
                printf '`-> current  You are here!\n'
            fi
            return 0
        }
        itf_guest_stop() { _calls+="stop:$2 "; return 0; }
        itf_guest_rollback() {
            _calls+="rollback:$1:$2:$3 "
            return 0
        }
        itf_guest_start() { _calls+="gstart:$2 "; return 0; }
        itf_guest_ip() { echo "10.9.9.9"; }
        itf_wait_ssh() { return 0; }
        # Leak flags: the install machinery must never run on a rerun.
        itf_guest_create() { _installed=1; echo 8001; }
        itf_preseed_render() { _installed=1; return 0; }
        itf_step() { _calls+="step:$1 "; return 0; }
        itf_journey_stage_os j08 itfj08
        echo "$?" > "$work/rc"
        printf '%s' "$_calls" > "$work/calls"
        printf '%s' "${_installed:-0}" > "$work/installed"
        printf '%s' "${J_VMID:-}-${J_GUEST_IP:-}" > "$work/globals"
        printf '%s' "$(cat "$work/guest.txt" 2>/dev/null)" > "$work/record"
    ) > /dev/null 2>&1
    assert_rc 0 "$(cat "$work/rc")"
    assert_contains "$(cat "$work/calls")" "delsnapshot:8005"
    assert_contains "$(cat "$work/calls")" "rollback:base.invalid:8005:os-installed"
    assert_contains "$(cat "$work/calls")" "set:8005"
    assert_contains "$(cat "$work/calls")" "gstart:8005"
    assert_equals "0" "$(cat "$work/installed")"
    assert_equals "8005-10.9.9.9" "$(cat "$work/globals")"
    assert_contains "$(cat "$work/record")" "base.invalid 8005 10.9.9.9"
    # Ordering law: the rollback restores the os-installed config (still
    # freeze:1), so the freeze clear must come after it and before the
    # start — a pre-rollback clear reverts with the config.
    if [[ "$(cat "$work/calls")" \
            != *"rollback:base.invalid:8005:os-installed"*"set:8005"*"gstart:8005"* ]]; then
        test_fail "freeze clear/start must follow the rollback, in that order"
    fi
}

