# ------------------------------------------------------------------------------
# Run lock: one run at a time per dev host (lib/runlock-lib.sh)
# ------------------------------------------------------------------------------

test_runlock_records_holder_and_releases_with_process() {
    test_start "runlock records the holder and frees when the process exits"
    local lk="$tmp_dir/rl-auto.lock" out rec
    out="$(_runlock_subshell "$lk" "journey run test-journey")"
    if [[ "$out" != "acquired" ]]; then
        test_fail "first acquire failed: $out"
        return
    fi
    rec="$(head -n 1 "$lk" 2>/dev/null)"
    if [[ "$rec" != *"journey run test-journey | pid "* ]]; then
        test_fail "holder record missing desc/pid: ${rec:-<none>}"
        return
    fi
    # The child exited — the kernel must have released the lock, so a
    # second starter acquires instantly (no stale-lock class at all).
    out="$(_runlock_subshell "$lk" "second run")"
    if [[ "$out" != "acquired" ]]; then
        test_fail "lock stayed held after the holder exited: $out"
        return
    fi
    test_pass
}

test_runlock_second_acquire_refuses_naming_holder() {
    test_start "runlock second starter (WAIT=0) is refused naming the holder"
    local lk="$tmp_dir/rl-held.lock"
    local hpid
    hpid=$(_runlock_hold_bg "$lk" "journey run holder-run" 30)
    if ! _runlock_wait_recorded "$lk" "holder-run"; then
        kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
        test_fail "holder never recorded itself"
        return
    fi
    local out rc=0
    out="$(ITF_RUN_LOCK="$lk" ITF_RUNLOCK_WAIT=0 bash -c '
        source "$(dirname "$1")/lib/runlock-lib.sh"
        itf_runlock_acquire "second run" && echo SHOULD-NOT-ACQUIRE
    ' _ "$ITF_DRIVER" 2>&1)" || rc=$?
    kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
    if [[ $rc -eq 0 ]]; then
        test_fail "second starter acquired a held lock"
        return
    fi
    if [[ "$out" != *"another itf run is active"* ]] \
            || [[ "$out" != *"journey run holder-run"* ]] \
            || [[ "$out" != *"ITF_RUNLOCK_WAIT=0"* ]]; then
        test_fail "refusal does not name holder/knob: $out"
        return
    fi
    test_pass
}

test_runlock_wait_budget_times_out_with_heartbeat() {
    test_start "runlock gives up after ITF_RUNLOCK_WAIT with heartbeats"
    local lk="$tmp_dir/rl-timeout.lock"
    local hpid
    hpid=$(_runlock_hold_bg "$lk" "holder-run" 10)
    if ! _runlock_wait_recorded "$lk" "holder-run"; then
        kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
        test_fail "holder never recorded itself"
        return
    fi
    local out rc=0 start elapsed
    start=$SECONDS
    out="$(ITF_RUN_LOCK="$lk" ITF_RUNLOCK_WAIT=2 ITF_RUNLOCK_HEARTBEAT=1 \
        bash -c '
        source "$(dirname "$1")/lib/runlock-lib.sh"
        itf_runlock_acquire "waiting run" && echo SHOULD-NOT-ACQUIRE
    ' _ "$ITF_DRIVER" 2>&1)" || rc=$?
    elapsed=$(( SECONDS - start ))
    kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
    if [[ $rc -eq 0 ]] || [[ "$out" == *SHOULD-NOT-ACQUIRE* ]]; then
        test_fail "waiting starter acquired a held lock"
        return
    fi
    if [[ "$out" != *"still waiting for the active run"* ]] \
            || [[ "$out" != *"giving up"* ]]; then
        test_fail "no heartbeat/give-up lines: $out"
        return
    fi
    if (( elapsed > 8 )); then
        test_fail "timeout overshot its budget (${elapsed}s)"
        return
    fi
    test_pass
}

test_journey_run_blocked_while_lock_held() {
    test_start "journey run refuses (rc 2, no run dir) while the lock is held"
    local lk="$tmp_dir/rl-driver.lock"
    local runs_dir="$tmp_dir/rl-runs"
    mkdir -p "$runs_dir"
    local hpid
    hpid=$(_runlock_hold_bg "$lk" "journey run other-lane-run" 30)
    if ! _runlock_wait_recorded "$lk" "other-lane-run"; then
        kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
        test_fail "holder never recorded itself"
        return
    fi
    run_out=""
    run_rc=0
    run_out=$(ITF_RUN_LOCK="$lk" ITF_RUNLOCK_WAIT=0 ITF_RUNS_DIR="$runs_dir" \
        ITF_SITE_CONFIG="$tmp_dir/site.conf" \
        bash "$ITF_DRIVER" journey run j04-post-install-baseline \
        2>"$tmp_dir/run.err") || run_rc=$?
    run_err="$(cat "$tmp_dir/run.err")"
    kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
    assert_rc 2 "$run_rc"
    assert_contains "$run_err" "another itf run is active"
    assert_contains "$run_err" "other-lane-run"
    # The refused run must not leave a run directory behind.
    if compgen -G "$runs_dir/run-*" > /dev/null; then
        test_fail "refused run created a run dir under $runs_dir"
        return
    fi
}

test_status_shows_run_lock_section() {
    test_start "itf status names the lock holder across lanes"
    # Free case first (the suite-private fixture lock has no holder).
    run_itf status
    assert_rc 0 "$run_rc"
    assert_contains "$run_out" "== run lock =="
    assert_contains "$run_out" "free"
    # Held case: a live holder must be named in the status line.
    local lk="$tmp_dir/rl-status.lock"
    local hpid
    hpid=$(_runlock_hold_bg "$lk" "journey run status-holder-run" 30)
    if ! _runlock_wait_recorded "$lk" "status-holder-run"; then
        kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
        test_fail "holder never recorded itself"
        return
    fi
    run_out=""
    run_rc=0
    run_out=$(ITF_RUN_LOCK="$lk" ITF_SITE_CONFIG="$tmp_dir/site.conf" \
        bash "$ITF_DRIVER" status 2>"$tmp_dir/run.err") || run_rc=$?
    kill "$hpid" 2>/dev/null; wait "$hpid" 2>/dev/null
    assert_rc 0 "$run_rc"
    assert_contains "$run_out" "held"
    assert_contains "$run_out" "status-holder-run"
}

# ------------------------------------------------------------------------------
# Acquire-time orphan fence: interrupted runs' guests outlive the lock
# ------------------------------------------------------------------------------

test_orphan_fence_refuses_naming_leftover_and_both_recoveries() {
    test_start "orphan fence refuses while an interrupted run's guest lives on, naming both recoveries"
    local runs table out
    runs=$(mktemp -d)
    _plant_run "$runs" run-20260101-010101-j13-test interrupted \
        "guest-storage.txt:base.invalid 8010 10.0.0.5"
    sed -i 's/^caller:   journey:test$/caller:   journey:j13-test/' \
        "$runs/run-20260101-010101-j13-test/meta.txt"
    table="$tmp_dir/fence-table-live"
    printf '      VMID Status    Name\n8010     running  itf-guest\n' > "$table"
    out="$(_fence_child "$runs" "" "$table" 0)"
    if [[ "$out" != *"fence-rc=1"* ]]; then
        test_fail "fence passed while a recorded guest lives on its base: $out"
        return
    fi
    if [[ "$out" != *"refusing to start"* ]] \
            || [[ "$out" != *"run-20260101-010101-j13-test: base.invalid/8010 (guest-storage.txt)"* ]]; then
        test_fail "refusal does not name the leftover: $out"
        return
    fi
    if [[ "$out" != *"itf journey run j13-test --rerun"* ]]; then
        test_fail "reuse recovery (rerun of the interrupted journey) missing: $out"
        return
    fi
    if [[ "$out" != *"itf guest destroy base.invalid 8010"* ]]; then
        test_fail "discard recovery (guest destroy) missing: $out"
        return
    fi
    rm -rf "$runs"
    test_pass
}

test_orphan_fence_passes_when_leftover_no_longer_exists() {
    test_start "orphan fence passes when the recorded guest was already destroyed"
    local runs table out
    runs=$(mktemp -d)
    _plant_run "$runs" run-20260101-010101-j13-test interrupted \
        "guest-storage.txt:base.invalid 8010 10.0.0.5"
    # The base answers, but the VMID is gone — nothing to collide with.
    table="$tmp_dir/fence-table-gone"
    printf '      VMID Status    Name\n8003     stopped  other-guest\n' > "$table"
    out="$(_fence_child "$runs" "" "$table" 0)"
    if [[ "$out" != *"fence-rc=0"* ]] || [[ "$out" == *"refusing to start"* ]]; then
        test_fail "fence refused a destroyed leftover: $out"
        return
    fi
    rm -rf "$runs"
    test_pass
}

test_orphan_fence_healthy_results_dir_never_queries_bases() {
    test_start "orphan fence with no interrupted runs queries no base at all"
    local runs table out
    runs=$(mktemp -d)
    # Done runs legitimately keep guests (run → fix → --rerun loop); only
    # interrupted runs fence.  The healthy path must pay zero ssh.
    _plant_run "$runs" run-20260101-010101-j04-test finished \
        "guest.txt:base.invalid 8005 10.0.0.9"
    table="$tmp_dir/fence-table-healthy"
    printf '      VMID Status    Name\n' > "$table"
    out="$(_fence_child "$runs" "" "$table" 0)"
    if [[ "$out" != *"fence-rc=0"* ]]; then
        test_fail "fence refused on a healthy results dir: $out"
        return
    fi
    if [[ -s "$tmp_dir/fence-calls" ]]; then
        test_fail "fence queried bases with no interrupted runs: $(cat "$tmp_dir/fence-calls")"
        return
    fi
    rm -rf "$runs"
    test_pass
}

test_orphan_fence_rerun_spec_exempts_only_its_own_takeovers() {
    test_start "orphan fence exempts the rerun's takeover pairs, still fences the others"
    local runs table spec out ncalls
    runs=$(mktemp -d)
    _plant_run "$runs" run-20260101-010101-j04-test interrupted \
        "guest.txt:base.invalid 8005 10.0.0.9"
    _plant_run "$runs" run-20260102-020202-j13-test interrupted \
        "guest-storage.txt:base.invalid 8010 10.0.0.5"
    spec="$tmp_dir/rerun-guests.tsv"
    printf 'guest.txt base.invalid 8005\n' > "$spec"
    table="$tmp_dir/fence-table-two"
    printf '      VMID Status    Name\n8005     running  a\n8010     running  b\n' > "$table"
    out="$(_fence_child "$runs" "$spec" "$table" 0)"
    if [[ "$out" != *"fence-rc=1"* ]]; then
        test_fail "fence passed with a non-exempt leftover live: $out"
        return
    fi
    if [[ "$out" != *"run-20260102-020202-j13-test: base.invalid/8010"* ]] \
            || [[ "$out" == *"8005"* ]]; then
        test_fail "exemption filtered the wrong pairs: $out"
        return
    fi
    # Both leftovers share a base: one `qm list` is the whole cost.
    ncalls=$(wc -l < "$tmp_dir/fence-calls")
    if [[ "$ncalls" != 1 ]]; then
        test_fail "expected one base query, saw $ncalls: $(cat "$tmp_dir/fence-calls")"
        return
    fi
    rm -rf "$runs"
    test_pass
}

test_orphan_fence_all_exempt_never_queries_bases() {
    test_start "orphan fence with every candidate taken over by the rerun queries no base"
    local runs spec table out
    runs=$(mktemp -d)
    _plant_run "$runs" run-20260101-010101-j04-test interrupted \
        "guest.txt:base.invalid 8005 10.0.0.9"
    spec="$tmp_dir/rerun-guests.tsv"
    printf 'guest.txt base.invalid 8005\n' > "$spec"
    table="$tmp_dir/fence-table-unused"
    printf '      VMID Status    Name\n' > "$table"
    out="$(_fence_child "$runs" "$spec" "$table" 0)"
    if [[ "$out" != *"fence-rc=0"* ]]; then
        test_fail "fence refused its own takeover pairs: $out"
        return
    fi
    if [[ -s "$tmp_dir/fence-calls" ]]; then
        test_fail "fence queried a base despite full exemption: $(cat "$tmp_dir/fence-calls")"
        return
    fi
    rm -rf "$runs"
    test_pass
}

test_orphan_fence_unreachable_base_fails_closed() {
