#!/usr/bin/env bash
# test-itf-driver — Dispatch-level smoke tests for the itf driver
# (tests/integrated/itf) under its strict mode (set -euo pipefail).
#
# The driver runs as a subprocess against a fixture site config whose base
# host is under the reserved .invalid TLD, so no test can reach a real
# base host: guard refusals fire before any ssh, and the one test whose
# transport is attempted fails on instant NXDOMAIN.  These pin the
# usage/rc contracts of the command dispatch and the empty-tolerant
# guards added with strict mode (an unreachable base reports
# empty/(unreachable), never an abort).  The --rerun tests additionally
# plant run directories (meta.txt + guest records) in sandboxed
# ITF_RUNS_DIR trees — the config's :- default lets the environment
# supply it — and one block sources common.sh in-process with stubbed
# transports to pin the rollback-instead-of-clone branch itself.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

ITF_DRIVER="$mydir/tests/integrated/itf"
tmp_dir=$(mktemp -d)

cat > "$tmp_dir/site.conf" <<'EOF'
ITF_BASE_HOSTS=(base.invalid)
ITF_SSH_USER=testuser
ITF_VMID_FIRST=8000
ITF_VMID_LAST=8099
ITF_GUEST_STORAGE=itfguests
ITF_ISO_STORAGE=itfiso
ITF_ISO_DIR=/mnt/itf-iso
ITF_ACTION_LOG=/var/log/itf-actions.log
ITF_BRIDGE=vmbr0
ITF_GUEST_MEMORY_MB=8192
ITF_GUEST_CORES=4
ITF_GUEST_SYSTEM_DISK_GB=32
ITF_GUEST_POOL_DISK_GB=100
ITF_DEBIAN_ISO_URL=https://cdimage.example.invalid/debian-netinst.iso
ITF_ISO_NAME=itf-debian-netinst.iso
ITF_SW_SOURCE=release
ITF_GITHUB_REPO=owner/repo
EOF

# run_itf <args...> — driver subprocess with the fixture config; leaves
# $run_rc / $run_out / $run_err for assertions. The run lock is sandboxed
# per suite: driver tests that reach `journey run`/`template build` take
# it (runlock-lib.sh), and a suite-private path keeps them off the dev
# host's real fence — a live journey would otherwise park the suite
# behind the lock for its whole wait budget.  The same tests scan
# ITF_RUNS_DIR with the acquire-time orphan fence, so they get an empty
# suite-private results tree too (never the dev host's real run records
# or bases).
ITF_LOCK_FIXTURE="$tmp_dir/itf-driver-tests.lock"
ITF_RUNS_FIXTURE="$tmp_dir/itf-runs-fixture"
mkdir -p "$ITF_RUNS_FIXTURE"

run_itf() {
    run_out=""
    run_rc=0
    run_out=$(ITF_RUN_LOCK="$ITF_LOCK_FIXTURE" ITF_RUNS_DIR="$ITF_RUNS_FIXTURE" \
        ITF_SITE_CONFIG="$tmp_dir/site.conf" bash "$ITF_DRIVER" "$@" \
        2>"$tmp_dir/run.err") || run_rc=$?
    run_err="$(cat "$tmp_dir/run.err")"
}

# run_itf_runs <runs-dir> <args...> — run_itf with ITF_RUNS_DIR pointed
# at a sandbox (config-lib's :- default keeps the environment value).
run_itf_runs() {
    local runs_dir="$1"
    shift
    run_out=""
    run_rc=0
    run_out=$(ITF_RUN_LOCK="$ITF_LOCK_FIXTURE" ITF_RUNS_DIR="$runs_dir" \
        ITF_SITE_CONFIG="$tmp_dir/site.conf" \
        bash "$ITF_DRIVER" "$@" 2>"$tmp_dir/run.err") || run_rc=$?
    run_err="$(cat "$tmp_dir/run.err")"
}

# _runlock_subshell <lock> <desc> — helper for lock tests: a child that
# sources runlock-lib.sh, acquires the fence, and exits (releasing it).
# Prints "acquired" on success.
_runlock_subshell() {
    local lock="$1" desc="$2"
    ITF_RUN_LOCK="$lock" bash -c '
        source "$(dirname "$1")/lib/runlock-lib.sh"
        itf_runlock_acquire "$2" || exit 1
        echo acquired
    ' _ "$ITF_DRIVER" "$desc" 2>&1
}

# _runlock_hold_bg <lock> <desc> <seconds> — start a background holder
# (records itself, then sleeps); echoes its pid. Tests must kill+wait it.
_runlock_hold_bg() {
    local lock="$1" desc="$2" secs="$3"
    ITF_RUN_LOCK="$lock" ITF_RUNLOCK_HOLD_SECONDS="$secs" bash -c '
        source "$(dirname "$1")/lib/runlock-lib.sh"
        itf_runlock_acquire "$2" || exit 1
        echo ready
        sleep "$3"
    ' _ "$ITF_DRIVER" "$desc" "$secs" > "$tmp_dir/rl-holder-$$.log" 2>&1 &
    echo $!
}

# _runlock_wait_recorded <lock> <needle> — poll the lock file until the
# holder has recorded itself (bounded; readiness, not timing).
_runlock_wait_recorded() {
    local lock="$1" needle="$2"
    local _
    for _ in $(seq 1 30); do
        grep -q "$needle" "$lock" 2>/dev/null && return 0
        sleep 0.2
    done
    grep -q "$needle" "$lock" 2>/dev/null
}

# _plant_run <runs-root> <run-dirname> <finished|running|interrupted> [guest-record...]
#
# Plants a run directory with meta.txt (a "running" state carries the
# test process's own live pid; an "interrupted" one carries a provably
# dead pid — a just-reaped child — and no finished: line, exactly what
# itf_run_state reports after a killed run) plus guest records of the
# form "file:base vmid [ip]".
_plant_run() {
    local root="$1" dir="$2" state="$3" rec f deadpid
    shift 3
    mkdir -p "$root/$dir"
    {
        echo "tag:      test"
        echo "started:  2026-01-01T00:00:00Z"
        echo "caller:   journey:test"
        echo "pid:      1"
        echo "finished: 2026-01-01T00:01:00Z"
    } > "$root/$dir/meta.txt"
    # A live pid (the harness itself) makes itf_run_state say "running".
    if [[ "$state" == "running" ]]; then
        sed -i "s/^pid:      1$/pid:      $$/" "$root/$dir/meta.txt"
        sed -i "/^finished:/d" "$root/$dir/meta.txt"
    fi
    # Dead pid + no finished: line = "interrupted" (killed/crashed run).
    if [[ "$state" == "interrupted" ]]; then
        bash -c ':' & deadpid=$!
        wait "$deadpid"
        sed -i "s/^pid:      1$/pid:      $deadpid/" "$root/$dir/meta.txt"
        sed -i "/^finished:/d" "$root/$dir/meta.txt"
    fi
    for rec in "$@"; do
        f="${rec%%:*}"
        echo "${rec#*:}" > "$root/$dir/$f"
    done
}

# _fence_child <runs-dir> <spec-file-or-""> <qm-list-table-file> <qm-rc>
#
# Runs itf_runlock_orphan_fence in a child shell with the real
# report-lib (itf_run_state over planted runs) and a stubbed itf_qm whose
# "list" call emits the canned table (or fails with <qm-rc>, the
# unreachable-base case).  Every itf_qm call is recorded in
# $tmp_dir/fence-calls.  Prints the fence's output plus "fence-rc=N".
_fence_child() {
    local runs="$1" spec="$2" table="$3" qmrc="${4:-0}"
    ITF_RUNS_DIR="$runs" FENCE_TABLE="$table" FENCE_QM_RC="$qmrc" \
    FENCE_CALLS="$tmp_dir/fence-calls" bash -c '
        source "$(dirname "$1")/lib/report-lib.sh"
        source "$(dirname "$1")/lib/runlock-lib.sh"
        : > "$FENCE_CALLS"
        itf_qm() {
            echo "list:$1" >> "$FENCE_CALLS"
            [[ "$FENCE_QM_RC" == 0 ]] || return "$FENCE_QM_RC"
            cat "$FENCE_TABLE"
        }
        if itf_runlock_orphan_fence "$2"; then
            echo "fence-rc=0"
        else
            echo "fence-rc=1"
        fi
    ' _ "$ITF_DRIVER" "$spec" 2>&1
}

