test_journey_list_lists_committed_journeys() {
    test_start "journey list names every committed journey"
    run_itf journey list
    assert_rc 0 "$run_rc"
    local j
    for j in j01-fresh-install j02-uninstall-reinstall \
        j03-install-over-leftovers j04-post-install-baseline \
        j05-two-node-install j06-guest-probe-validator \
        j07-unarchive-iscsi-rebuild j08-prereq-decline \
        j09-prereq-apt-failure j10-release-upgrade; do
        assert_contains "$run_out" "$j"
    done
}

