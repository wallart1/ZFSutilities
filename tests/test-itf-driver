test_journey_run_rerun_writes_spec_from_latest_source() {
    test_start "journey run --rerun picks the latest source and writes the guest spec"
    local runs_dir new_run spec
    runs_dir=$(mktemp -d)
    _plant_run "$runs_dir" run-20260101-010101-j04-post-install-baseline finished \
        "guest.txt:base.invalid 8005 10.0.0.9"
    _plant_run "$runs_dir" run-20260102-020202-j04-post-install-baseline finished \
        "guest.txt:base.invalid 8007 10.0.0.11"
    run_itf_runs "$runs_dir" journey run j04-post-install-baseline --rerun
    # The spec is written before the journey runs; the journey then fails
    # reaching the unreachable base (.invalid) at its first rerun step.
    assert_rc 1 "$run_rc"
    assert_contains "$run_out" "rerun of run-20260102-020202-j04-post-install-baseline"
    new_run="$(ls -1d "$runs_dir"/run-* | sort -r | head -1)"
    spec="$new_run/rerun-guests.tsv"
    if [[ -f "$spec" ]]; then
        test_pass
    else
        test_fail "missing rerun-guests.tsv in the new run dir"
    fi
    assert_contains "$(cat "$spec" 2>/dev/null)" "guest.txt base.invalid 8007"
    assert_contains "$(cat "$new_run/report.md" 2>/dev/null)" "rerun guest present"
    rm -rf "$runs_dir"
}

