#!/usr/bin/env bash
# test-itf-driver — Dispatch-level smoke tests for the itf driver
# (tests/integrated/itf) under its strict mode (set -euo pipefail).
#
# The driver runs as a subprocess against a fixture site config whose base
# host is under the reserved .invalid TLD, so no test can reach a real
# base host: guard refusals fire before any ssh, and the one test whose
# transport is attempted fails on instant NXDOMAIN.  These pin the
# usage/rc contracts of the command dispatch and the empty-tolerant
# guards added with strict mode (an unreachable base reports
# empty/(unreachable), never an abort).  The --rerun tests additionally
# plant run directories (meta.txt + guest records) in sandboxed
# ITF_RUNS_DIR trees — the config's :- default lets the environment
# supply it — and one block sources common.sh in-process with stubbed
# transports to pin the rollback-instead-of-clone branch itself.

source "$(cd "$(dirname "$0")" && pwd)/test-lib.sh"
setup_test_env

ITF_DRIVER="$mydir/tests/integrated/itf"
tmp_dir=$(mktemp -d)

cat > "$tmp_dir/site.conf" <<'EOF'
ITF_BASE_HOSTS=(base.invalid)
ITF_SSH_USER=testuser
ITF_VMID_FIRST=8000
ITF_VMID_LAST=8099
ITF_GUEST_STORAGE=itfguests
ITF_ISO_STORAGE=itfiso
ITF_ISO_DIR=/mnt/itf-iso
ITF_ACTION_LOG=/var/log/itf-actions.log
ITF_BRIDGE=vmbr0
ITF_GUEST_MEMORY_MB=8192
ITF_GUEST_CORES=4
ITF_GUEST_SYSTEM_DISK_GB=32
ITF_GUEST_POOL_DISK_GB=100
ITF_DEBIAN_ISO_URL=https://cdimage.example.invalid/debian-netinst.iso
ITF_ISO_NAME=itf-debian-netinst.iso
ITF_SW_SOURCE=release
ITF_GITHUB_REPO=owner/repo
EOF

# run_itf <args...> — driver subprocess with the fixture config; leaves
# $run_rc / $run_out / $run_err for assertions.
run_itf() {
    run_out=""
    run_rc=0
    run_out=$(ITF_SITE_CONFIG="$tmp_dir/site.conf" bash "$ITF_DRIVER" "$@" \
        2>"$tmp_dir/run.err") || run_rc=$?
    run_err="$(cat "$tmp_dir/run.err")"
}

# run_itf_runs <runs-dir> <args...> — run_itf with ITF_RUNS_DIR pointed
# at a sandbox (config-lib's :- default keeps the environment value).
run_itf_runs() {
    local runs_dir="$1"
    shift
    run_out=""
    run_rc=0
    run_out=$(ITF_RUNS_DIR="$runs_dir" ITF_SITE_CONFIG="$tmp_dir/site.conf" \
        bash "$ITF_DRIVER" "$@" 2>"$tmp_dir/run.err") || run_rc=$?
    run_err="$(cat "$tmp_dir/run.err")"
}

# _plant_run <runs-root> <run-dirname> <finished|running> [guest-record...]
#
# Plants a run directory with meta.txt (a "running" state carries the
# test process's own live pid) plus guest records of the form
# "file:base vmid [ip]".
_plant_run() {
    local root="$1" dir="$2" state="$3" rec f
    shift 3
    mkdir -p "$root/$dir"
    {
        echo "tag:      test"
        echo "started:  2026-01-01T00:00:00Z"
        echo "caller:   journey:test"
        echo "pid:      1"
        echo "finished: 2026-01-01T00:01:00Z"
    } > "$root/$dir/meta.txt"
    # A live pid (the harness itself) makes itf_run_state say "running".
    if [[ "$state" == "running" ]]; then
        sed -i "s/^pid:      1$/pid:      $$/" "$root/$dir/meta.txt"
        sed -i "/^finished:/d" "$root/$dir/meta.txt"
    fi
    for rec in "$@"; do
        f="${rec%%:*}"
        echo "${rec#*:}" > "$root/$dir/$f"
    done
}

