#!/usr/bin/bash
# Delete all zfs snapshot holds in a subtree
# $1    Subtree
# $2    Optional leading substring of snapshot names to be affected
# $3    Optional depth of the subtree

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper zfsdelallholds
source_helper zfslockmanager

function delholds {
    local zfsdelholds_subtree zfsdelholds_match
    local snap i l snapsnap
    local autoproceed="Y"
    declare -a snaparray

    if [[ $1 = "" ]]; then
        log_msg "FATAL: A subtree must be specified."
        source "$(find_zfsutility_script bashfatal)"
    else
        zfsdelholds_subtree=$1
    fi

    zfslock_init
    if ! zfslock_wait_or_resolve "$zfsdelholds_subtree" "w" "zfsdelholds"; then
        log_msg "WARN: Could not acquire write lock on ${zfsdelholds_subtree}; aborting."
        return 1
    fi
    local _delholds_lock="$zfslock_id"
    zfsdelholds_match=$2
    local -a zfsdelholds_depth_args=()
    if [[ $3 != '' ]]; then
        zfsdelholds_depth_args=(-d "$3")
    fi

    readarray -t snaparray < <(zfs list "${zfsdelholds_depth_args[@]}" -Ho name -rt snapshot \
        "$zfsdelholds_subtree")

    if [[ ${#snaparray[@]} = 0 ]]; then
        log_msg "INFO: $zfsdelholds_subtree has no snapshots and therefore no holds."
        return 0
    fi

    if [[ $zfsdelholds_match != "" ]]; then
        for ((i=0; i<${#snaparray[@]}; i++)); do  # Remove the snaps that don't match the substring.
            snapsnap=${snaparray[$i]#*@}  # Get part after @
            l=${#zfsdelholds_match}
            if [[ ${snapsnap:0:$l} != "$zfsdelholds_match" ]]; then
                unset 'snaparray[$i]'
            fi
        done
        # Re-index the array to remove gaps
        snaparray=("${snaparray[@]}")
    fi

    if [[ ${#snaparray[@]} = 0 ]]; then
        log_msg "INFO: No snapshots matched pattern '$zfsdelholds_match' in $zfsdelholds_subtree."
        return 0
    fi

    if [[ $autoproceed != "Y" ]]; then
        log_msg "INFO: About to release holds for the following ${#snaparray[@]} snapshots in" \
            "$zfsdelholds_subtree."
        for snap in "${snaparray[@]}"; do
            echo "$snap"
        done
        read -rp "Press enter to continue."
    fi

    for snap in "${snaparray[@]}"; do
        delallholds "$snap"
    done

    zfslock_release "$_delholds_lock"
}

if calledbybash; then delholds "$1" "$2" "$3"; fi
