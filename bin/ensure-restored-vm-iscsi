#!/usr/bin/bash
#
# Script: ensure-restored-vm-iscsi
# Description: Ensures restored Proxmox VM disk zvols are exported as iSCSI LUNs.
#
#   Two-node only. In single-node mode this script is a no-op.
#
#   For each supplied zvol whose basename matches vm-<vmid>-disk-<num>, the
#   script reads the matching Proxmox VM config on the compute host, extracts
#   the existing LUN number from the disk's by-path entry, and ensures the
#   backstore and LUN mapping exist on the storage host. This preserves the
#   compute host's /dev/disk/by-path symlinks so the VM can start after a
#   restore.
#
# Usage: ensure-restored-vm-iscsi <zvol>...
#
#   <zvol>    One or more ZFS zvol paths that back Proxmox VM disks. Only
#             paths whose basename matches vm-<vmid>-disk-<num> are processed.
#
# Globals / environment:
#   pve_conf_dir          Directory containing Proxmox VM configs
#                         (default: /etc/pve/qemu-server).
#   ISCSI_MANIFEST        Backstore manifest path on the storage host
#                         (default: /etc/rtslib-fb-target/expected-backstores.txt).
#   ISCSI_ENCRYPTED_CONF  Encrypted-LUN config path
#                         (default: /etc/zfsutilities/iscsi-encrypted-luns.conf).
#
# Returns:
#   0 on success or when there is no work to do,
#   1 on a usage error (missing arguments).

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
if ! declare -f rootcheck &>/dev/null; then

    source_helper rootcheck
fi
rootcheck

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"
ISCSI_MANIFEST="${ISCSI_MANIFEST:-/etc/rtslib-fb-target/expected-backstores.txt}"
# Encrypted-LUN config path mirrors iscsi-lib.sh behavior.
ISCSI_ENCRYPTED_CONF="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}"
ISCSI_ENCRYPTED_CONF="${ISCSI_ENCRYPTED_CONF}/iscsi-encrypted-luns.conf"
if [[ ! -e "$ISCSI_ENCRYPTED_CONF" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    ISCSI_ENCRYPTED_CONF="/etc/iscsi-encrypted-luns.conf"
fi

usage() {
    log_msg "INFO: Usage: ensure-restored-vm-iscsi <zvol>..."
    log_msg "INFO:   Ensures iSCSI backstores/LUNs exist for restored VM disk zvols."
    log_msg "INFO:   The Proxmox config directory can be overridden via pve_conf_dir."
}

if [[ $# -lt 1 ]]; then
    usage
    source "$(find_zfsutility_script bashreturn)" 1
fi

# ---------------------------------------------------------------------------
# Host helpers
# ---------------------------------------------------------------------------

is_local_host() {
    [[ "$my_host" == "$1" ]]
}

# Read a file from the compute host (locally or via SSH).
read_compute_file() {
    local path="$1"
    if is_local_host "$compute_host"; then
        cat -- "$path" 2>/dev/null || true
    else
        ssh -o ConnectTimeout=10 -o BatchMode=yes root@"$compute_host" \
            "cat -- $(printf '%q' "$path") 2>/dev/null || true" 2>/dev/null
    fi
}

# Run a bash script (supplied via stdin) on the storage host.
# Arguments after the script are passed as positional parameters.
run_on_storage() {
    local script
    script=$(cat)
    if is_local_host "$storage_host"; then
        bash -s "$@" <<< "$script"
    else
        ssh -o ConnectTimeout=10 -o BatchMode=yes root@"$storage_host" \
            bash -s "$@" <<< "$script"
    fi
}

# Run a single command string on the storage host.
exec_on_storage() {
    local cmd="$1"
    if is_local_host "$storage_host"; then
        bash -c "$cmd"
    else
        ssh -o ConnectTimeout=10 -o BatchMode=yes root@"$storage_host" "$cmd"
    fi
}

# ---------------------------------------------------------------------------
# zvol / VM config parsing
# ---------------------------------------------------------------------------

# Print the basename of a dataset path.
bsname_from_zvol() {
    local zvol="$1"
    echo "${zvol##*/}"
}

# Print the pool name (first qualifier) of a dataset path.
pool_from_zvol() {
    local zvol="$1"
    echo "${zvol%%/*}"
}

# Validate and parse a VM disk zvol path. Outputs "<vmid> <disknum>" on
# success, otherwise returns 1.
parse_vm_disk_zvol() {
    local zvol="$1" base rest mid tail
    base=$(bsname_from_zvol "$zvol")
    [[ "$base" == vm-*-disk-* ]] || return 1
    rest="${base#vm-}"
    mid="${rest%%-disk-*}"
    tail="${rest##*-disk-}"
    [[ "$mid" =~ ^[0-9]+$ && "$tail" =~ ^[0-9]+$ ]] || return 1
    echo "$mid $tail"
}

# Extract the LUN number from an iSCSI by-path disk line.
# The line and the literal target marker are passed as arguments.
lun_from_by_path_line() {
    local line="$1"
    local marker="$2"
    local rest
    rest="${line#*"${marker}"}"
    if [[ "$rest" == "$line" ]]; then
        return 0
    fi
    # rest now starts with the LUN number, possibly followed by options.
    rest="${rest%%,*}"
    rest="${rest%% *}"
    if [[ "$rest" =~ ^[0-9]+$ ]]; then
        echo "$rest"
    fi
    return 0
}

# Find the LUN number already referenced by the VM config for a given disk,
# searching the disk lines on the compute host. Arguments: zvol path, VM ID,
# zvol disk number, and zvol size (e.g. "4M"/"4194304", used to spot EFI
# disks). Outputs the LUN number, or nothing when no line matches.
expected_lun_for_zvol() {
    local zvol="$1"
    local vmid="$2"
    local disknum="$3"
    local zvol_size="${4:-}"

    # Track config LUNs already assigned to zvols in this run so fallback
    # scanning does not map two zvols to the same config entry.  Key is
    # "<target_short>:<vmid>:<lun>" because LUN numbers are per target.
    declare -gA _assigned_config_luns

    local pool
    pool=$(pool_from_zvol "$zvol")
    local target_short="${pool_target[$pool]:-}"
    [[ -n "$target_short" ]] || return 0

    local conf="$pve_conf_dir/${vmid}.conf"
    local config
    config=$(read_compute_file "$conf")
    [[ -n "$config" ]] || return 0

    # EFI disks are always 4 MiB in Proxmox. The backing zvol disk number is
    # independent of the config key, so detect EFI by size and match efidisk0
    # regardless of the zvol's disk number.
    local is_efi=false
    if [[ "$zvol_size" == "4M" || "$zvol_size" == "4194304" ]]; then
        is_efi=true
    fi

    local -a candidate_keys=()
    if [[ "$is_efi" == true ]]; then
        candidate_keys+=("efidisk0:")
    fi
    candidate_keys+=("scsi${disknum}:")
    candidate_keys+=("sata${disknum}:")
    candidate_keys+=("ide${disknum}:")
    candidate_keys+=("virtio${disknum}:")
    if [[ "$disknum" == "0" && "$is_efi" != true ]]; then
        candidate_keys+=("efidisk0:")
    fi

    local marker="ip-${storage_ip}:3260-iscsi-${iqn_prefix}:${target_short}-lun-"
    local key line lun
    for key in "${candidate_keys[@]}"; do
        line=$(echo "$config" | grep "^${key}" | head -1 || true)
        [[ -n "$line" ]] || continue
        lun=$(lun_from_by_path_line "$line" "$marker")
        if [[ -n "$lun" ]]; then
            _assigned_config_luns["${target_short}:${vmid}:${lun}"]=1
            echo "$lun"
            return 0
        fi
    done

    # Fallback: zvol disk numbers are global, but config keys are per bus. If a
    # non-EFI data disk's zvol number does not match its scsi/sata/ide/virtio
    # slot number, scan all non-EFI disk lines and pick the first unused LUN.
    if [[ "$is_efi" != true ]]; then
        local -a all_disk_lines=()
        local _line
        while IFS= read -r _line; do
            case "${_line%%:*}" in
                scsi[0-9]*|sata[0-9]*|ide[0-9]*|virtio[0-9]*)
                    all_disk_lines+=("$_line") ;;
            esac
        done < <(echo "$config" | grep -E '^[a-z]')

        local _key _bus _idx _prio
        local -a _prefixed=()
        for _line in "${all_disk_lines[@]}"; do
            _key="${_line%%:*}"
            _bus="${_key%%[0-9]*}"
            _idx="${_key#"${_bus}"}"
            case "$_bus" in
                scsi)   _prio=0 ;;
                sata)   _prio=1 ;;
                ide)    _prio=2 ;;
                virtio) _prio=3 ;;
                *)      _prio=9 ;;
            esac
            _prefixed+=("${_prio}|${_idx}|${_line}")
        done

        local -a _sorted_prefixed=()
        if [[ ${#_prefixed[@]} -gt 0 ]]; then
            readarray -t _sorted_prefixed < <(
                printf '%s\n' "${_prefixed[@]}" | \
                sort -t'|' -k1,1n -k2,2n
            )
        fi

        local _pref _candidate_lun _candidate_size _lun_key
        local _best_lun=""
        for _pref in "${_sorted_prefixed[@]}"; do
            # Strip priority|index prefix to recover the original config line.
            _line="${_pref#*'|'}"
            _line="${_line#*'|'}"
            _candidate_lun=$(lun_from_by_path_line "$_line" "$marker")
            [[ -n "$_candidate_lun" ]] || continue
            _lun_key="${target_short}:${vmid}:${_candidate_lun}"
            [[ -z "${_assigned_config_luns[${_lun_key}]:-}" ]] || continue
            _candidate_size=""
            if [[ "$_line" == *size=* ]]; then
                _candidate_size="${_line#*size=}"
                _candidate_size="${_candidate_size%%[[:space:],]*}"
            fi
            if [[ -n "$zvol_size" && "$_candidate_size" == "$zvol_size" ]]; then
                _best_lun="$_candidate_lun"
                break
            fi
            if [[ -z "$_best_lun" ]]; then
                _best_lun="$_candidate_lun"
            fi
        done
        if [[ -n "$_best_lun" ]]; then
            _assigned_config_luns["${target_short}:${vmid}:${_best_lun}"]=1
            echo "$_best_lun"
            return 0
        fi
    fi

    return 0
}

# ---------------------------------------------------------------------------
# Storage-side iSCSI helpers
# ---------------------------------------------------------------------------

# Ensure a single backstore + LUN mapping exists on the storage host.
# Arguments: zvol target expected_lun encrypted(Y/N)
ensure_lun_on_storage() {
    local zvol="$1"
    local target="$2"
    local expected_lun="$3"
    local encrypted="$4"

    local bsname zvol_dev target_short
    bsname=$(bsname_from_zvol "$zvol")
    zvol_dev="/dev/zvol/${zvol}"
    target_short="${target##*:}"

    run_on_storage \
        "$zvol" "$zvol_dev" "$bsname" "$target" "$expected_lun" "$encrypted" \
        << 'STORAGEEOF'
source ~/bashinit
bashinit
set -e
zvol="$1"
zvol_dev="$2"
bsname="$3"
target="$4"
expected_lun="$5"
encrypted="$6"

mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)

# Verify the zvol device node is present.
if [[ ! -e "$zvol_dev" ]]; then
    log_msg "WARN: Zvol device not found: $zvol_dev"
    exit 0
fi

# Ensure backstore exists.
if ! targetcli /backstores/block ls 2>/dev/null | grep -qF " ${bsname} "; then
    targetcli /backstores/block create "$bsname" "$zvol_dev"
    targetcli "/backstores/block/${bsname}" set attribute emulate_tpu=1
    echo "BACKSTORE_CREATED:${bsname}"
else
    echo "BACKSTORE_EXISTS:${bsname}"
fi

# Determine current LUN mapping for this backstore and the expected slot.
# Strip everything through the first "lun" token and keep the leading
# digits ("... lun3 [block/..." -> "3").
current_lun=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
    | grep -F " ${bsname} " \
    | while IFS= read -r _lun_line; do
        _lun_rest="${_lun_line#*lun}"
        printf '%s\n' "${_lun_rest%%[!0-9]*}"
    done \
    | head -1 || true)

if [[ -n "$current_lun" ]]; then
    if [[ "$current_lun" == "$expected_lun" ]]; then
        echo "LUN_OK:${bsname}:${expected_lun}"
    else
        echo "LUN_MISMATCH:${bsname}:${current_lun}:${expected_lun}"
        exit 0
    fi
else
    # Check whether the expected LUN index is free.
    occupied=""
    while IFS= read -r _lun_line; do
        _lun_rest="${_lun_line#*lun}"
        _lun_num="${_lun_rest%%[!0-9]*}"
        if [[ "$_lun_num" == "$expected_lun" ]]; then
            occupied="$expected_lun"
            break
        fi
    done < <(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null)
    if [[ -n "$occupied" ]]; then
        log_msg "INFO: LUN_OCCUPIED:${expected_lun}"
        exit 0
    fi
    targetcli "/iscsi/${target}/tpg1/luns" create "/backstores/block/${bsname}" "$expected_lun"
    echo "LUN_CREATED:${bsname}:${expected_lun}"
fi
STORAGEEOF

    # Update local manifest / encrypted config on the storage host.
    run_on_storage \
        "$bsname" "$zvol_dev" "$target_short" "$encrypted" \
        << 'MANIFESTEOF'
source ~/bashinit
bashinit
set -e
bsname="$1"
zvol_dev="$2"
target_short="$3"
encrypted="$4"

ISCSI_MANIFEST="${ISCSI_MANIFEST:-/etc/rtslib-fb-target/expected-backstores.txt}"
ISCSI_ENCRYPTED_CONF="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}"
ISCSI_ENCRYPTED_CONF="${ISCSI_ENCRYPTED_CONF}/iscsi-encrypted-luns.conf"
if [[ ! -e "$ISCSI_ENCRYPTED_CONF" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    ISCSI_ENCRYPTED_CONF="/etc/iscsi-encrypted-luns.conf"
fi

if [[ -f "$ISCSI_MANIFEST" ]] && ! grep -qxF -- "$bsname" "$ISCSI_MANIFEST"; then
    echo "$bsname" >> "$ISCSI_MANIFEST"
fi

if [[ "$encrypted" == "Y" && -f "$ISCSI_ENCRYPTED_CONF" ]] && \
   ! awk -v p="${bsname}:" 'index($0, p) == 1 { f=1 } END { exit !f }' \
       "$ISCSI_ENCRYPTED_CONF"; then
    echo "${bsname}:${zvol_dev}:${target_short}" >> "$ISCSI_ENCRYPTED_CONF"
fi
MANIFESTEOF
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

is_single_node && source "$(find_zfsutility_script bashreturn)" 0

# Validate that each argument looks like a dataset path.
for zvol in "$@"; do
    if [[ -z "$zvol" || "$zvol" == -* ]]; then
        usage
    fi
done

# Collect work items.
declare -a work_zvols=()
declare -a work_targets=()
declare -a work_luns=()
declare -a work_encrypted=()
declare -a work_items=()

for zvol in "$@"; do
    parsed=$(parse_vm_disk_zvol "$zvol" || true)
    if [[ -z "$parsed" ]]; then
        log_msg "INFO: Skipping non-VM-disk zvol: $zvol"
        continue
    fi

    read -r vmid disknum <<< "$parsed"
    pool=$(pool_from_zvol "$zvol")
    if ! is_known_pool "$pool"; then
        log_msg "WARN: $zvol is not in a known iSCSI pool; skipping"
        continue
    fi

    target=$(pool_to_target "$pool") || {
        log_msg "WARN: Could not map pool $pool to iSCSI target; skipping $zvol"
        continue
    }

    zvol_size=$(zfs get -H -o value volsize "$zvol" 2>/dev/null || true)

    enc_value=$(zfs get -H -o value encryption "$zvol" 2>/dev/null || echo off)
    encrypted="N"
    [[ "$enc_value" != "off" && "$enc_value" != "-" ]] && encrypted="Y"

    work_items+=("${vmid}|${disknum}|${zvol}|${target}|${encrypted}|${zvol_size}")
done

# Sort work items by VM ID then disk number so deterministic fallback LUN
# assignment works correctly when zvol disk numbers do not match config keys.
declare -a sorted_items=()
if [[ ${#work_items[@]} -gt 0 ]]; then
    readarray -t sorted_items < <(printf '%s\n' "${work_items[@]}" | sort -t'|' -k1,1n -k2,2n)
fi

for item in "${sorted_items[@]}"; do
    IFS='|' read -r vmid disknum zvol target encrypted zvol_size <<< "$item"

    expected_lun=$(expected_lun_for_zvol "$zvol" "$vmid" "$disknum" "$zvol_size")
    if [[ -z "$expected_lun" ]]; then
        log_msg "WARN: No VM config entry found for $zvol (VM $vmid disk $disknum); skipping"
        continue
    fi

    work_zvols+=("$zvol")
    work_targets+=("$target")
    work_luns+=("$expected_lun")
    work_encrypted+=("$encrypted")
    log_msg "INFO: Will ensure $zvol -> ${target} LUN ${expected_lun}"
done

if [[ ${#work_zvols[@]} -eq 0 ]]; then
    log_msg "INFO: No VM disk zvols to ensure"
    source "$(find_zfsutility_script bashreturn)" 0
fi

log_msg "INFO: Ensuring iSCSI LUNs for ${#work_zvols[@]} restored zvol(s)"

for (( i=0; i<${#work_zvols[@]}; i++ )); do
    zvol="${work_zvols[$i]}"
    target="${work_targets[$i]}"
    lun="${work_luns[$i]}"
    encrypted="${work_encrypted[$i]}"

    result=$(ensure_lun_on_storage "$zvol" "$target" "$lun" "$encrypted" 2>&1 || true)
    # shellcheck disable=SC2001
    echo "$result" | sed 's/^/  /'

    if echo "$result" | grep -qF "LUN_MISMATCH:"; then
        log_msg "WARN: $zvol already mapped to a different LUN than VM config expects"
    elif echo "$result" | grep -qF "LUN_OCCUPIED:"; then
        log_msg "WARN: Expected LUN for $zvol is occupied by a different backstore"
    fi
done

# Save iSCSI configuration and rescan the compute host.
safe_iscsi_save_path=$(find_zfsutility_script safe-iscsi-save)
log_msg "INFO: Saving iSCSI configuration..."
exec_on_storage "$safe_iscsi_save_path"

log_msg "INFO: Rescanning compute host..."
rescan_storage_path=$(find_zfsutility_script rescan-storage)
"$rescan_storage_path"

log_msg "INFO: Ensure iSCSI complete"
source "$(find_zfsutility_script bashreturn)" 0
