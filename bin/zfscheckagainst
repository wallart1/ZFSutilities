#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154

function checkagainst {
# Before deleting a snapshot, this script checks to ensure that the proposed snapshot to delete
#   is not the last one in common with its counterpart(s) in one or more other datasets. This is
#   to avoid losing the ability to do an incremental backup, which requires a common snapshot
#   between the source and destination datasets.

# This module contains the table of what to check against what. It needs to be maintained.
#
# $1    Fully-qualified snapshot to be checked.
#
# Return codes
# 0     Snapshot is ok to delete. It has sufficient counterparts.
# 4     Did not find any counterpart snapshots (candidate is not common with destination).
# 5     Did not find any eligible entries in the fss array.
# 6     Counterpart pool(s) offline - cannot verify, deletion blocked.
# 7     This is the last remaining common snapshot — deletion blocked.
# 8     Fatal error. Script was terminated. See message in stdout.

    local _local_bashinit
    _local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
    if [[ -f "$_local_bashinit" ]]; then
        source "$_local_bashinit"
    else
        source ~/bashinit
    fi
    bashinit
    unset _local_bashinit

    source_helper zfscommsnap
    source_helper bashdebug
    if [[ "$1" == '*NVME1*' ]]; then bashdebugon; else bashdebugoff; fi

    local \
        _ca_from_offsite_ds=() \
        _candidate_dstocheck \
        _candidate_pool \
        _candidate_guid \
        _dest_guids \
        _entry_found \
        _entry_last_remaining \
        _entry_offline_pools \
        _fs \
        _has_other \
        _hold_tag \
        _line \
        _new_src \
        _offsite_candidates=() \
        _other_snap \
        _pool \
        _pool_online \
        _source_dataset \
        _source_pool \
        checkagainst \
        commsnap \
        dest_root \
        foundcounterpart='' \
        fs \
        fullfs \
        i \
        label \
        last_remaining_common='' \
        offline_pools="" \
        rc \
        snaplabel \
        snaptocheck="$1" \
        source_root \
        zfsdelsnap_other_commsnap

    # Verify that the given snapshot exists.
    if ! zfs list -t snapshot "$snaptocheck" > /dev/null 2>&1; then
        log_msg "FATAL: Snapshot $snaptocheck does not exist."
        exit 8
    fi

    # Remember the source pool so we can skip self-checks for rows that were
    # expanded from an <offsite> source-root placeholder.
    _source_pool=$(echo "${snaptocheck%%@*}" | awk -F'/' '{print $1}')
    _source_dataset="${snaptocheck%%@*}"

# =======================  Backup Series  ==============================
# Each < or > is one line in the fss table.
#       LABEL           SOURCE ROOT            DESTINATION ROOT
# 1)    dailybackup     threeamigos            fivebays/threeamigos
# 2)    dailybackup     NVME1                  fivebays/NVME1
# 3)    dailybackup     temp                   z22tb/temp
# 4)    dailybackup     temp                   z40tb/temp
# 5)    offsite         temp                   z22tb/temp
# 6)    offsite         temp                   z40tb/temp
# 7)    offsite         threeamigos            fivebays/threeamigos
# 8)    offsite         NVME1                  fivebays/NVME1
# 9)    offsite         fivebays               z22tb/fivebays
# 10)   offsite         fivebays               z40tb/fivebays

    #    Source root (dataset tree that the checked snapshot belongs to)
    #    |                    Destination root (counterpart dataset tree)
    #    |                    |           Label to process
    #    |                    |           |
    #    V                    V           V
    #
    # Load fss table from the JSON config via zfsconfig helper. Falls back
    # to the legacy zfscheckagainst.conf file if the JSON section is empty.
    local fss=()
    source_helper zfsconfig
    while IFS= read -r _line; do
        [[ -z "${_line//[[:space:]]/}" ]] && continue
        fss+=("$_line")
    done < <(zfsconfig_get_checkagainst)
    if [[ ${#fss[@]} -eq 0 ]]; then
        local _conf="$mydir/../share/config/zfscheckagainst.conf"
        if [[ -f "$_conf" ]]; then
            while IFS= read -r _line; do
                [[ "$_line" =~ ^[[:space:]]*# ]] && continue
                [[ -z "${_line//[[:space:]]/}" ]] && continue
                # Convert legacy 4-field strip/prepend rows to 3-field
                # source_root/dest_root rows.
                local _fields
                _fields=$(echo "$_line" | awk '{print NF}')
                if [[ $_fields -eq 4 ]]; then
                    local _dataset _quals _prepend _lbl
                    _dataset=$(echo "$_line" | awk '{print $1}')
                    _quals=$(echo "$_line" | awk '{print $2}')
                    _prepend=$(echo "$_line" | awk '{print $3}')
                    _lbl=$(echo "$_line" | awk '{print $4}')
                    [[ $_prepend = '-' ]] && _prepend=''
                    local _stripped
                    _stripped=$(echo "$_dataset" | cut -d'/' -f$((_quals + 1))-)
                    if [[ -n "$_prepend" && -n "$_stripped" ]]; then
                        _line="$_dataset ${_prepend}/${_stripped} $_lbl"
                    elif [[ -n "$_prepend" ]]; then
                        _line="$_dataset $_prepend $_lbl"
                    else
                        _line="$_dataset $_stripped $_lbl"
                    fi
                fi
                fss+=("$_line")
            done < "$_conf"
        fi
    fi

    # Expand <offsite> placeholders in the Source root column. Every
    # occurrence of the literal token is replaced with each offsite-candidate
    # pool.
    local _expanded_fss=()
    local _ca_line
    for _ca_line in "${fss[@]}"; do
        _fs=$(echo "$_ca_line" | awk '{print $1}')
        if [[ $_fs == *'<offsite>'* ]]; then
            local _offsite_ds_candidates=()
            while IFS= read -r _pool; do
                [[ -n "$_pool" ]] && _offsite_ds_candidates+=("$_pool")
            done < <(zfsconfig_get_offsite_candidates)
            if [[ ${#_offsite_ds_candidates[@]} -eq 0 ]]; then
                log_msg "WARN: <offsite> used in source root but no offsite candidate" \
                    "pools are configured. Skipping fss row: $_ca_line"
                continue
            fi
            for _pool in "${_offsite_ds_candidates[@]}"; do
                _new_src="${_fs//<offsite>/$_pool}"
                _expanded_fss+=("$(echo "$_ca_line" | awk -v s="$_new_src" '{$1=s; print}')")
                _ca_from_offsite_ds+=("Y")
            done
        else
            _expanded_fss+=("$_ca_line")
            _ca_from_offsite_ds+=("N")
        fi
    done
    fss=("${_expanded_fss[@]}")

    local matched_fss_entry=false
    for ((i=0; i<${#fss[@]}; i++)); do
        fullfs="${fss[$i]}"
        source_root=$(echo "$fullfs" | awk '{print $1}')
        dest_root=$(echo "$fullfs" | awk '{print $2}')
        label=$(echo "$fullfs" | awk '{print $3}')

        # Check if snapshot belongs to this source root (exact match or child dataset).
        if [[ $snaptocheck == $source_root@* ]] || [[ $snaptocheck == $source_root/* ]]; then
            snaplabel=$(echo "$snaptocheck" | awk -F'@' '{print $2}' | awk -F'-' '{print $1}')
            if [[ $label = "$snaplabel" ]]; then              # Labels must match.
                # Compute the counterpart dataset by replacing the source-root
                # prefix with the destination-root prefix.
                local _src_dataset="${snaptocheck%%@*}"
                if [[ $_src_dataset == "$source_root" ]]; then
                    _candidate_dstocheck="$dest_root"
                else
                    _candidate_dstocheck="${dest_root}/${_src_dataset#"${source_root}"}/"
                fi

                # Expand <offsite> placeholder in the destination root.
                local _ca_dest_roots=("$dest_root")
                if [[ $dest_root == *'<offsite>'* ]]; then
                    _offsite_candidates=()
                    while IFS= read -r _pool; do
                        [[ -n "$_pool" ]] && _offsite_candidates+=("$_pool")
                    done < <(zfsconfig_get_offsite_candidates)
                    if [[ ${#_offsite_candidates[@]} -eq 0 ]]; then
                        log_msg "WARN: <offsite> placeholder used but no offsite candidate" \
                            "pools are configured. Snapshot: $snaptocheck."
                        if [[ -z "$offline_pools" ]]; then
                            offline_pools="<offsite>"
                        elif [[ "$offline_pools" != *"<offsite>"* ]]; then
                            offline_pools="$offline_pools, <offsite>"
                        fi
                        matched_fss_entry=true
                        continue
                    fi
                    _ca_dest_roots=()
                    for _pool in "${_offsite_candidates[@]}"; do
                        _ca_dest_roots+=("${dest_root//<offsite>/$_pool}")
                    done
                fi

                matched_fss_entry=true

                _entry_found=false
                _entry_last_remaining=false
                _entry_offline_pools=""

                for dest_root in "${_ca_dest_roots[@]}"; do
                    # Recompute counterpart with the expanded dest_root.
                    _src_dataset="${snaptocheck%%@*}"
                    if [[ $_src_dataset == "$source_root" ]]; then
                        _candidate_dstocheck="$dest_root"
                    else
                        _candidate_dstocheck="${dest_root}/${_src_dataset#"${source_root}"}/"
                    fi

                    _candidate_pool=$(echo "$dest_root" | awk -F'/' '{print $1}')

                    # If this row was expanded from an <offsite> source-root
                    # placeholder, skip the meaningless self-check (e.g.
                    # z22tb/temp should not be checked against z22tb/temp).
                    if [[ ${_ca_from_offsite_ds[$i]} == "Y" \
                        && $_candidate_pool == "$_source_pool" ]]; then
                        continue
                    fi

                    if zpool list -Ho name "$_candidate_pool" >/dev/null 2>&1; then
                        _pool_online=true
                    else
                        _pool_online=false
                    fi

                    if [[ $_pool_online = false ]]; then
                        if [[ $label = "offsite" ]]; then
                            _hold_tag="offsite-${_candidate_pool}"
                            _has_other=false
                            while IFS= read -r _other_snap; do
                                [[ "$_other_snap" = "$snaptocheck" ]] && continue
                                if zfs holds -H "$_other_snap" 2>/dev/null \
                                   | awk '{print $2}' | grep -qFx "$_hold_tag"; then
                                    _has_other=true
                                    break
                                fi
                            done < <(zfs list -Ht snapshot -o name -s creation \
                                     "$_source_dataset" 2>/dev/null)
                            if [[ $_has_other = true ]]; then
                                log_msg "INFO: Offline pool $_candidate_pool: another snapshot" \
                                    "carries hold '$_hold_tag' — incremental chain intact."
                                _entry_found=true
                                break
                            fi
                        fi
                        if [[ -z "$_entry_offline_pools" ]]; then
                            _entry_offline_pools="$_candidate_pool"
                        elif [[ "$_entry_offline_pools" != *"$_candidate_pool"* ]]; then
                            _entry_offline_pools="$_entry_offline_pools, $_candidate_pool"
                        fi
                        continue
                    fi

                    if ! (zfs list -rt filesystem,volume "$_candidate_dstocheck" \
                        >/dev/null 2>&1); then
                        log_msg "WARN: Dataset to check $_candidate_dstocheck" \
                            "does not exist or is offline."
                        continue
                    fi

                    commsnap_find_another='Y'
                    if [[ $maxcommsnapperiod = '' ]]; then maxcommsnapperiod=130; fi
                    commsnap=$(getcommonsnap "$snaptocheck" "$_candidate_dstocheck")
                    rc=$?
                    if [[ $rc -eq 32 || $rc -eq 0 ]]; then
                        _entry_found=true
                        break
                    elif [[ $rc -eq 64 ]]; then
                        _candidate_guid=$(zfs get -Hp -o value guid "$snaptocheck" 2>/dev/null)
                        _dest_guids=$(zfs list -t snapshot -H -o guid -d1 \
                            "$_candidate_dstocheck" 2>/dev/null)
                        if grep -qFx "$_candidate_guid" <<< "$_dest_guids"; then
                            _entry_last_remaining=true
                            log_msg "WARN: This is the last remaining common snap." \
                                "\nSnapshot: $snaptocheck. Other dataset: $_candidate_dstocheck."
                        else
                            log_msg "INFO: No counterpart snapshot for $snaptocheck on" \
                                "$_candidate_dstocheck."
                            _entry_found=true
                            break
                        fi
                    else
                        log_msg "FATAL: Unexpected RC=$rc from $mydir/zfscommsnap." \
                            "\nSnapshot: $snaptocheck. Other dataset: $_candidate_dstocheck."
                        exit 8
                    fi
                done

                if [[ $_entry_found = true ]]; then
                    foundcounterpart=true
                    continue
                elif [[ $_entry_last_remaining = true ]]; then
                    last_remaining_common=true
                    break
                elif [[ -n "$_entry_offline_pools" ]]; then
                    if [[ -z "$offline_pools" ]]; then
                        offline_pools="$_entry_offline_pools"
                    elif [[ "$offline_pools" != *"$_entry_offline_pools"* ]]; then
                        offline_pools="$offline_pools, $_entry_offline_pools"
                    fi
                    continue
                fi
            else
                continue
            fi
        else
            continue
        fi
    done

    if [[ $last_remaining_common = true ]]; then
        log_msg "WARN: Deletion blocked — $snaptocheck is the last remaining common snapshot."
        return 7
    fi
    if [[ $foundcounterpart = '' ]]; then
        if [[ $matched_fss_entry = true && -n "$offline_pools" ]]; then
            log_msg "WARN: Cannot verify counterpart - pool(s) offline: $offline_pools" \
                "\nSnapshot: $snaptocheck" \
                "\nDeletion blocked for safety. Bring the counterpart pool(s) online to verify."
            return 6
        fi
        log_msg "WARN: No eligible enteries in the checkagainst array for $snaptocheck."
        if [[ ! -f /tmp/fssalreadyprinted.$PPID ]]; then
            touch /tmp/fssalreadyprinted.$PPID
            echo 'Source root            Destination root       Label'
            for fullfs in "${fss[@]}"; do
                echo "$fullfs"
            done
        fi
        return 5
    fi
    if [[ $foundcounterpart = true ]]; then
        return 0
    fi
    log_msg "FATAL: Internal error = $foundcounterpart"
    exit 8
}
