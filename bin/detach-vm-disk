#!/usr/bin/bash
# detach-vm-disk <vmid> <disk-key>
# Removes a disk from a Proxmox VM config and tears down iSCSI infrastructure
# (two-node), leaving the underlying zvol intact.
#
# Install to: /usr/local/lib/zfsutilities/bin/detach-vm-disk on BOTH hosts
# Run from:   the compute host (or storage host — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="/etc/pve/qemu-server"

usage() {
    log_msg "INFO: Usage: detach-vm-disk <vmid> <disk-key>"
    echo ""
    log_msg "INFO:   vmid      Proxmox VM ID"
    log_msg "INFO:   disk-key  Disk key to detach (e.g. scsi0, scsi1, efidisk0)"
    echo ""
    log_msg "WARN: WARNING: The VM must be stopped before detaching a disk."
    echo ""
    log_msg "INFO: Example: detach-vm-disk 300 scsi1"
    exit 1
}

# --- Argument validation ---
[[ $# -eq 2 ]] || usage

vmid="$1"
diskkey="$2"

[[ "$vmid" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $vmid"
    exit 1
}
# Disk-key must be lowercase letters followed by digits (e.g. scsi0, ide1).
_diskkey_num="${diskkey##*[a-z]}"
_diskkey_letters="${diskkey%"${_diskkey_num}"}"
[[ -n "${_diskkey_letters}" && "${_diskkey_letters}" != *[^a-z]* \
    && -n "${_diskkey_num}" && "${_diskkey_num}" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: disk-key must be like scsi0 or ide1, got: $diskkey"
    exit 1
}

# --- Delegate to compute host if run on storage node (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "detach-vm-disk")
    exec ssh -t root@"$compute_host" \
        "$remote_script '$vmid' '$diskkey'"
fi

# === Running on the compute host ===

conf="$pve_conf_dir/${vmid}.conf"
[[ -f "$conf" ]] || {
    log_msg "FATAL: VM config not found: $conf"
    exit 1
}

# --- VM state check ---
status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
if [[ "${status:-unknown}" != "stopped" ]]; then
    log_msg "WARN: VM $vmid is currently $status"
    log_msg "INFO:   Detaching a disk from a running VM is allowed but may cause I/O errors"
    log_msg "INFO:   if the guest OS is actively using the disk."
    echo ""
    read -rp "  Continue anyway? (y/N): " proceed
    [[ "$proceed" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
    echo ""
fi

# --- Parse disk line ---
disk_line=$(grep "^${diskkey}:" "$conf" 2>/dev/null || true)
[[ -n "$disk_line" ]] || {
    log_msg "FATAL: Disk key $diskkey not found in VM $vmid config"
    exit 1
}

log_msg "INFO: === detach-vm-disk ==="
log_msg "INFO:   VM:        $vmid"
log_msg "INFO:   Disk key:  $diskkey"
log_msg "INFO:   Config:    $conf"

# --- Two-node: parse iSCSI info from disk line ---
backstore_name=""
lun_num=""
target_short=""
pool=""

if is_two_node; then
    # Map target short name -> pool for validation of the parsed target.
    declare -A target_pool=()
    for _pool in "${!pool_target[@]}"; do
        target_pool["${pool_target[$_pool]}"]="$_pool"
    done

    # iSCSI disk line shape:
    #   ${diskkey}: ... ip-${storage_ip}:3260-iscsi-${iqn_prefix}:<target>-lun-<n> ...
    # Extract the target and LUN with parameter expansion (no regex).
    _detach_prefix="ip-${storage_ip}:3260-iscsi-${iqn_prefix}:"
    if [[ "$disk_line" == *"${_detach_prefix}"*"-lun-"* ]]; then
        _detach_rest="${disk_line#*"${_detach_prefix}"}"
        target_short="${_detach_rest%%-lun-*}"
        _detach_lun="${_detach_rest#"${target_short}"-lun-}"
        lun_num="${_detach_lun%%,*}"
    fi
    if [[ -n "$target_short" && -n "${target_pool[$target_short]:-}" \
        && "$lun_num" =~ ^[0-9]+$ ]]; then
        pool="${target_pool[$target_short]}"
        backstore_name="vm-${vmid}-disk-${diskkey//[^0-9]/}"
        # efidisk is always disk 0 in naming convention
        if [[ "$diskkey" == efidisk* ]]; then
            backstore_name="vm-${vmid}-disk-0"
        fi
    else
        log_msg "WARN: Disk line does not look like iSCSI — skipping iSCSI teardown"
    fi
fi

# --- Show what will be done ---
echo ""
log_msg "INFO: This will detach $diskkey from VM $vmid:"
log_msg "INFO:   $disk_line"
if is_two_node && [[ -n "$backstore_name" ]]; then
    echo ""
    log_msg "INFO:   Two-node: iSCSI LUN and backstore will also be removed:"
    log_msg "INFO:     LUN:       $lun_num"
    log_msg "INFO:     Backstore: $backstore_name"
fi
echo ""
log_msg "INFO:   The underlying zvol will be left intact."
echo ""
read -rp "Proceed? (y/N): " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
echo ""

# --- Remove from Proxmox config ---
sed -i "/^${diskkey}:/d" "$conf"
log_msg "INFO: ✓ Removed $diskkey from VM $vmid config"

# --- Two-node: tear down iSCSI ---
if is_two_node && [[ -n "$backstore_name" ]]; then
    target="${iqn_prefix}:${target_short}"

    # Remove LUN from target
    if [[ -n "$lun_num" ]]; then
        log_msg "INFO: Removing LUN $lun_num from target..."
        targetcli "/iscsi/${target}/tpg1/luns" delete "lun${lun_num}" 2>/dev/null || \
            log_msg "WARN: Could not remove LUN (may already be removed)"
    fi

    # Remove backstore
    if targetcli /backstores/block ls 2>/dev/null | grep -q " ${backstore_name} "; then
        log_msg "INFO: Removing backstore $backstore_name..."
        targetcli /backstores/block delete "$backstore_name"
        log_msg "INFO: ✓ Backstore removed"
    else
        log_msg "WARN: Backstore not found — skipping"
    fi

    # Remove from expected-backstores manifest before saving, otherwise
    # safe-iscsi-save sees fewer active backstores than expected and refuses
    # to save, leaving the manifest stale and the Dashboard reporting the
    # detached disk as missing.
    manifest="/etc/rtslib-fb-target/expected-backstores.txt"
    if [[ -f "$manifest" ]] && grep -q "^${backstore_name}$" "$manifest"; then
        sed -i "/^${backstore_name}$/d" "$manifest"
        log_msg "INFO: ✓ Removed from expected-backstores manifest"
    fi

    # Save config
    log_msg "INFO: Saving iSCSI configuration..."
    "$mydir/safe-iscsi-save"
    log_msg "INFO: ✓ Configuration saved"

    # Rescan on the compute host, using its active deployed version.
    remote_rescan=$(remote_zfsutility_script "$compute_host" "rescan-storage")
    log_msg "INFO: Triggering iSCSI rescan on $compute_host..."
    if ssh -o ConnectTimeout=10 root@"$compute_host" \
        "$remote_rescan" 2>&1; then
        log_msg "INFO: ✓ Rescan triggered"
    else
        log_msg "WARN: Could not reach $compute_host — run 'sudo rescan-storage' manually"
    fi
fi

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   Detached: $diskkey from VM $vmid"
if is_two_node && [[ -n "$pool" ]]; then
    log_msg "INFO:   Zvol left intact: $pool/proxmox/$backstore_name"
fi
