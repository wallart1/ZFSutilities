#!/usr/bin/bash
# $1    The subtree to work with
# $2    Subtree depth
_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


function holds {
    log_msg 'INFO: Snapshot holds for' "$1"'.'
    zfs list -Hrt snapshot -o name "$1" | xargs -r -n1 zfs holds -H
}
if calledbybash; then holds "$*"; fi
