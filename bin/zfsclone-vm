#!/usr/bin/bash
# zfsclone-vm <src_vmid> <dst_vmid> <new_name>
# Creates a new Proxmox VM by ZFS-cloning the source VM's disk zvols.
#
# Unlike clone-vm (which does a full zfs send/receive copy), this creates
# true ZFS clones — instantaneous COW datasets that share blocks with the
# source until they diverge. No data is copied; only written blocks consume
# new space.
#
# The clone origin snapshot (@clone-...-c) is retained on the source zvols.
# It must not be deleted while any clones from this operation exist.
# Use promote-vm-clone <dst_vmid> to cut the dependency before retiring the source VM.
#
# The source VM must be stopped before cloning.
#
# Install to: /usr/local/lib/zfsutilities/bin/zfsclone-vm on every host where it may be run
# Run from:   the local host in single-node mode, or the compute/storage host in
#             two-node mode (storage-host runs delegate via SSH to compute)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"

usage() {
    log_msg "INFO: Usage: zfsclone-vm <src_vmid> <dst_vmid> <new_name>"
    echo ""
    log_msg "INFO:   src_vmid   VM ID to clone from (must be stopped)"
    log_msg "INFO:   dst_vmid   New VM ID"
    log_msg "INFO:   new_name   Name for the new VM"
    echo ""
    log_msg "INFO: Example: zfsclone-vm 904 310 myvm"
    exit 1
}

# gen_mac is provided by node-lib.sh (sourced above).

# --- Argument validation ---
[[ $# -eq 3 ]] || usage

srcvmid="$1"
dstvmid="$2"
new_name="$3"

if [[ ! "$srcvmid" =~ ^[0-9]+$ ]]; then
    log_msg "FATAL: src_vmid must be a number, got: $srcvmid"
    exit 1
fi
if [[ ! "$dstvmid" =~ ^[0-9]+$ ]]; then
    log_msg "FATAL: dst_vmid must be a number, got: $dstvmid"
    exit 1
fi
# --- If not on the compute host, delegate (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "zfsclone-vm")
    exec ssh -t root@"$compute_host" "$remote_script '$srcvmid' '$dstvmid' '$new_name'"
fi

# === Running on the compute host ===

src_conf="$pve_conf_dir/${srcvmid}.conf"
dst_conf="$pve_conf_dir/${dstvmid}.conf"

[[ -f "$src_conf" ]]   || { log_msg "FATAL: Source VM config not found: $src_conf"; exit 1; }
if [[ -f "$dst_conf" ]]; then
    log_msg "FATAL: Destination VM config already exists: $dst_conf"
    exit 1
fi

# --- Check source VM is stopped ---
vm_status=$(qm status "$srcvmid" 2>/dev/null | awk '{print $2}')
[[ "$vm_status" == "stopped" ]] \
    || {
        log_msg "FATAL: VM $srcvmid must be stopped before cloning (status: ${vm_status:-unknown})"
        exit 1
    }

# --- Config-line parsing helpers (no regex literals over 10 chars) ---

# Parse a Proxmox disk line: <key>: <storage>:vm-<srcvmid>-disk-<N>[,params]
# On success sets _pd_key / _pd_storage / _pd_disknum / _pd_rest and returns 0.
# True when the line begins with a net<N>: key (N all digits).
is_net_line() {
    local key="${1%%:*}"
    [[ "$1" == *:* && "$key" == net* ]] || return 1
    [[ "${key#net}" =~ ^[0-9]+$ ]]
}

parse_disk_line() {
    local line="$1" rest storage rem key_head key_tail
    _pd_key="${line%%:*}"
    # Key must be lowercase letters followed by digits only ([a-z]+[0-9]+).
    key_tail="${_pd_key##*[!0-9]}"
    key_head="${_pd_key%"${key_tail}"}"
    [[ -n "$key_tail" && -n "$key_head" && "$key_head" != *[!a-z]* ]] || return 1
    rest="${line#*:}"
    [[ "$rest" == *:* ]] || return 1
    storage="${rest%%:*}"
    [[ -n "$storage" ]] || return 1
    # Consume leading spaces like the old "\ *" quantifier; an all-space
    # storage keeps one space (regex backtracking behavior).
    storage="${storage#"${storage%%[! ]*}"}"
    [[ -n "$storage" ]] || storage=" "
    rem="${rest#*:}"
    [[ "$rem" == "vm-${srcvmid}-disk-"* ]] || return 1
    rem="${rem#"vm-${srcvmid}-disk-"}"
    _pd_disknum="${rem%%[!0-9]*}"
    [[ -n "$_pd_disknum" ]] || return 1
    _pd_rest="${rem#"${_pd_disknum}"}"
    _pd_storage="$storage"
    return 0
}

# Parse a two-node iSCSI disk line, extracting the full IQN and LUN number.
# Format: <key>: ...ip-<storage_ip>:3260-iscsi-<iqn.…>-lun-<N>[,params]
# On success sets _pi_key / _pi_iqn / _pi_lun and returns 0.
parse_iscsi_line() {
    local line="$1" marker tail field lpart key_head key_tail
    _pi_key="${line%%:*}"
    # Key must be lowercase letters followed by digits only ([a-z]+[0-9]+).
    key_tail="${_pi_key##*[!0-9]}"
    key_head="${_pi_key%"${key_tail}"}"
    [[ -n "$key_tail" && -n "$key_head" && "$key_head" != *[!a-z]* ]] || return 1
    marker="ip-${storage_ip}:3260-iscsi-"
    [[ "$line" == *"${marker}"* ]] || return 1
    tail="${line#*"${marker}"}"
    field="${tail%%,*}"
    [[ "$field" == iqn.*-lun-[0-9]* ]] || return 1
    _pi_iqn="${field%%-lun-*}"
    lpart="${field##*-lun-}"
    _pi_lun="${lpart%%[!0-9]*}"
    [[ -n "$_pi_lun" ]] || return 1
    return 0
}

# Replace the MAC in a netN: line, mirroring the old greedy regex: the LAST
# "=<MAC>," occurrence is rewritten. Mode "pairs" requires strict
# XX:XX:XX:XX:XX:XX; mode "loose" accepts any 17 hex/colon characters
# (the legacy [0-9A-Fa-f:]{17} behavior).
rewrite_mac() {
    local line="$1" new_mac="$2" mode="$3"
    local rest="$line" result="$line"
    local prefix="" seg after cand tail colon_pos
    while [[ "$rest" == *=* ]]; do
        seg="${rest%%=*}"
        after="${rest#*=}"
        cand="${after:0:17}"
        tail="${after:17}"
        if (( ${#after} >= 18 )) && [[ "$tail" == ,* ]]; then
            if [[ "$mode" == pairs ]]; then
                # Strict XX:XX:XX:XX:XX:XX — colons exactly at positions
                # 3,6,9,12,15 and hex nibbles everywhere else.
                colon_pos="${cand:2:1}${cand:5:1}${cand:8:1}${cand:11:1}${cand:14:1}"
                if [[ ${#cand} -eq 17 && "$colon_pos" == ::::: \
                        && -z "${cand//[0-9A-Fa-f:]/}" ]]; then
                    result="${prefix}${seg}=${new_mac}${tail}"
                fi
            elif [[ -z "${cand//[0-9A-Fa-f:]/}" ]]; then
                result="${prefix}${seg}=${new_mac}${tail}"
            fi
        fi
        prefix="${prefix}${seg}="
        rest="$after"
    done
    printf '%s\n' "$result"
}

# === Single-node ZFS clone path ===
if is_single_node; then
    # Parse ZFS-backed disk lines (format: scsiN: <storage>:vm-VMID-disk-N,...)
    declare -a sn_disk_keys=()
    declare -A sn_disk_zvols=()
    declare -A sn_disk_nums=()

    while IFS= read -r line; do
        [[ "$line" =~ ^\[.+\] ]] && break
        if parse_disk_line "$line"; then
            zvol=$(zfs list -H -t volume -o name 2>/dev/null \
                | grep -F "/proxmox/vm-${srcvmid}-disk-${_pd_disknum}" | head -1)
            if [[ -n "$zvol" ]]; then
                sn_disk_keys+=("${_pd_key}")
                sn_disk_zvols["${_pd_key}"]="$zvol"
                sn_disk_nums["${_pd_key}"]="${_pd_disknum}"
            fi
        fi
    done < "$src_conf"

    if [[ ${#sn_disk_keys[@]} -eq 0 ]]; then
        log_msg "FATAL: No ZFS disk zvols found for VM $srcvmid"
        exit 1
    fi

    snap_suffix="@clone-$(date -Iminutes)-c"

    zfslock_init

    log_msg "INFO: === zfsclone-vm (single-node) ==="
    log_msg "INFO:   Source:   VM ${srcvmid}"
    log_msg "INFO:   Dest:     VM ${dstvmid} (${new_name})"
    log_msg "INFO:   Snapshot: ${snap_suffix}"
    log_msg "INFO:   Disks:"
    for key in "${sn_disk_keys[@]}"; do
        log_msg "INFO:     ${key}: ${sn_disk_zvols[$key]}"
    done
    echo ""
    read -rp "Proceed? (y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
    echo ""

    # Clone each disk locally
    for key in "${sn_disk_keys[@]}"; do
        src_zvol="${sn_disk_zvols[$key]}"
        disknum="${sn_disk_nums[$key]}"
        pool="${src_zvol%%/*}"
        dst_zvol="${pool}/proxmox/vm-${dstvmid}-disk-${disknum}"
        snap="${src_zvol}${snap_suffix}"

        log_msg "INFO: Cloning ${key}: ${src_zvol}..."

        ! zfs list -H "$dst_zvol" >/dev/null 2>&1 \
            || { log_msg "FATAL: Destination zvol already exists: $dst_zvol"; exit 1; }

        if ! zfslock_wait_or_resolve "$src_zvol" "w" "zfsclone-vm source"; then
            log_msg "FATAL: Could not acquire write lock on source zvol ${src_zvol}"
            exit 1
        fi
        lock_src="$zfslock_id"
        if ! zfslock_wait_or_resolve "$dst_zvol" "w" "zfsclone-vm destination"; then
            zfslock_release "$lock_src"
            log_msg "FATAL: Could not acquire write lock on destination zvol ${dst_zvol}"
            exit 1
        fi
        lock_dst="$zfslock_id"

        if ! zfs list -H -t snapshot "$snap" >/dev/null 2>&1; then
            zfs snapshot "$snap"
            log_msg "INFO: ✓ Snapshot created: $snap"
        else
            log_msg "INFO: ✓ Snapshot exists: $snap"
        fi

        zfs clone -o compression=lz4 -o refreservation=none "$snap" "$dst_zvol"
        zfslock_release "$lock_dst"
        zfslock_release "$lock_src"
        log_msg "INFO: ✓ ZFS clone created: $dst_zvol"
        echo ""
    done

    # Write new VM config
    log_msg "INFO: Writing VM ${dstvmid} config..."

    new_vmgenid=$(cat /proc/sys/kernel/random/uuid)
    new_smbios_uuid=$(cat /proc/sys/kernel/random/uuid)
    name_written=false
    vmgenid_written=false
    smbios1_written=false

    while IFS= read -r line; do
        [[ "$line" =~ ^\[.+\] ]] && break

        if parse_disk_line "$line"; then
            echo "${_pd_key}: ${_pd_storage}:vm-${dstvmid}-disk-${_pd_disknum}${_pd_rest}"
        elif [[ "$line" =~ ^vmgenid: ]]; then
            echo "vmgenid: $new_vmgenid"
            vmgenid_written=true
        elif [[ "$line" =~ ^smbios1: ]]; then
            echo "smbios1: uuid=${new_smbios_uuid}"
            smbios1_written=true
        elif [[ "$line" =~ ^name: ]]; then
            echo "name: $new_name"
            name_written=true
        elif is_net_line "$line"; then
            new_mac=$(gen_mac)
            rewrite_mac "$line" "$new_mac" loose
        elif [[ "$line" == protection:* ]]; then
            :
        elif [[ "$line" =~ ^meta: ]]; then
            :
        else
            echo "$line"
        fi
    done < "$src_conf" > "$dst_conf"

    [[ "$name_written"     == "true" ]] || echo "name: $new_name"                  >> "$dst_conf"
    [[ "$vmgenid_written"  == "true" ]] || echo "vmgenid: $new_vmgenid"            >> "$dst_conf"
    [[ "$smbios1_written"  == "true" ]] || echo "smbios1: uuid=${new_smbios_uuid}" >> "$dst_conf"

    log_msg "INFO: ✓ Config written: $dst_conf"
    echo ""
    log_msg "INFO: === Done ==="
    log_msg "INFO:   VM ${dstvmid} (${new_name}) is ready in Proxmox."
    log_msg "INFO:   Clone origin: ${snap_suffix} (retained on source VM ${srcvmid} zvols)"
    log_msg "INFO:   To cut dependency before retiring VM ${srcvmid}: promote-vm-clone ${dstvmid}"
    log_msg "INFO:   Review hardware in the GUI before starting."
    exit 0
fi

# === Two-node iSCSI clone path ===

# --- Parse iSCSI disk lines from source config ---
# The full target IQN is embedded in the by-path device string — extract it directly.
# No pool names or IQN prefixes are hardcoded here.
declare -a disk_keys=()
declare -A disk_targets=()
declare -A disk_luns=()

while IFS= read -r line; do
    [[ "$line" =~ ^\[.+\] ]] && break
    if parse_iscsi_line "$line"; then
        disk_keys+=("${_pi_key}")
        disk_targets["${_pi_key}"]="${_pi_iqn}"
        disk_luns["${_pi_key}"]="${_pi_lun}"
    fi
done < "$src_conf"

if [[ ${#disk_keys[@]} -eq 0 ]]; then
    log_msg "FATAL: No iSCSI disks found in source VM config"
    exit 1
fi

# Snapshot name — same for all disks in this operation, kept as clone origin
snap_suffix="@clone-$(date -Iminutes)-c"

zfslock_init

log_msg "INFO: === zfsclone-vm ==="
log_msg "INFO:   Source:   VM ${srcvmid}"
log_msg "INFO:   Dest:     VM ${dstvmid} (${new_name})"
log_msg "INFO:   Snapshot: ${snap_suffix}"
log_msg "INFO:   Disks:"
for key in "${disk_keys[@]}"; do
    log_msg "INFO:     ${key}: target=${disk_targets[$key]}, LUN ${disk_luns[$key]}"
done
echo ""
read -rp "Proceed? (y/N): " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
echo ""

# --- Clone each disk on the storage host ---
declare -A disk_new_luns=()

for key in "${disk_keys[@]}"; do
    target="${disk_targets[$key]}"
    old_lun="${disk_luns[$key]}"

    log_msg "INFO: Cloning ${key} (target=${target}, LUN ${old_lun})..."

    new_lun=$(ssh root@"$storage_host" bash -s "$target" "$srcvmid" "$dstvmid" \
        "$old_lun" "$snap_suffix" \
    << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

set -e
target="$1"
src_vmid="$2"
dst_vmid="$3"
old_lun="$4"
snap_suffix="$5"

# Find the backstore name for the old LUN to get the disk number.
# Select the LUN line (LUN id followed by a non-digit) and extract the
# backstore name (first whitespace-separated token after "block/").
backstore=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
    | awk -v pat="lun${old_lun}" '
        index($0, pat) && index($0, "block/") {
            after = index($0, pat) + length(pat)
            if (substr($0, after, 1) !~ /^[0-9]$/) {
                tail = substr($0, index($0, "block/") + 6)
                split(tail, f)
                print f[1]
            }
        }')
[[ -n "$backstore" ]] \
    || { log_msg "FATAL: No backstore found for LUN ${old_lun} in ${target}"; exit 1; }

if [[ "$backstore" == *-disk-[0-9]* ]] && [[ "${backstore##*-disk-}" =~ ^[0-9]+$ ]]; then
    disknum="${backstore##*-disk-}"
else
    log_msg "FATAL: Cannot extract disk number from '${backstore}'"
    exit 1
fi

# Derive pool from the backstore's device path — no pool names hardcoded
_pool_line=$(targetcli /backstores/block ls 2>/dev/null \
    | grep -F " ${backstore} " \
    | head -1)
_zvol_tail="${_pool_line#*/dev/zvol/}"
if [[ -z "$_zvol_tail" || "$_zvol_tail" == "$_pool_line" ]]; then
    log_msg "FATAL: Cannot determine pool for backstore ${backstore}"
    exit 1
fi
pool="${_zvol_tail%%/*}"

src_zvol="${pool}/proxmox/vm-${src_vmid}-disk-${disknum}"
dst_zvol="${pool}/proxmox/vm-${dst_vmid}-disk-${disknum}"
dst_zvol_dev="/dev/zvol/${dst_zvol}"
dst_backstore="vm-${dst_vmid}-disk-${disknum}"
snap="${src_zvol}${snap_suffix}"

log_msg "INFO:   ${src_zvol} → ${dst_zvol}"
log_msg "INFO:   Snapshot: ${snap}"

zfslock_init
if ! zfslock_wait_or_resolve "$src_zvol" "w" "zfsclone-vm source"; then
    log_msg "FATAL: Could not acquire write lock on source zvol ${src_zvol}"
    exit 1
fi
lock_src="$zfslock_id"
if ! zfslock_wait_or_resolve "$dst_zvol" "w" "zfsclone-vm destination"; then
    zfslock_release "$lock_src"
    log_msg "FATAL: Could not acquire write lock on destination zvol ${dst_zvol}"
    exit 1
fi
lock_dst="$zfslock_id"

zfs list -H "$src_zvol" >/dev/null 2>&1 \
    || { log_msg "FATAL: Source zvol not found: ${src_zvol}"; exit 1; }
! zfs list -H "$dst_zvol" >/dev/null 2>&1 \
    || { log_msg "FATAL: Destination zvol already exists: ${dst_zvol}"; exit 1; }
! targetcli /backstores/block ls 2>/dev/null | grep -qF " ${dst_backstore} " \
    || { log_msg "FATAL: Backstore already exists: ${dst_backstore}"; exit 1; }

# Take snapshot if it doesn't already exist (same name reused across all disks of this VM)
if ! zfs list -H -t snapshot "${snap}" >/dev/null 2>&1; then
    zfs snapshot "$snap"
    log_msg "INFO: ✓ Snapshot created: ${snap}"
else
    log_msg "INFO: ✓ Snapshot exists: ${snap}"
fi

# ZFS clone — instantaneous, shares all blocks with source until they diverge
zfs clone -o compression=lz4 -o refreservation=none "$snap" "$dst_zvol"
log_msg "INFO: ✓ ZFS clone created"
zfslock_release "$lock_dst"
zfslock_release "$lock_src"

# Wait for device node to appear (udev is async)
for i in $(seq 1 20); do [[ -b "$dst_zvol_dev" ]] && break; sleep 0.5; done
[[ -b "$dst_zvol_dev" ]] \
    || { log_msg "FATAL: Device node did not appear: ${dst_zvol_dev}"; exit 1; }

# Create iSCSI backstore and LUN
targetcli /backstores/block create "$dst_backstore" "$dst_zvol_dev" >/dev/null 2>&1
targetcli "/iscsi/${target}/tpg1/luns" create "/backstores/block/${dst_backstore}" >/dev/null 2>&1
log_msg "INFO: ✓ iSCSI LUN added"

# Print only the new LUN number to stdout (captured by caller).
# Select the line for this backstore, strip everything through the first
# "lun" token, and keep the leading digits ("... lun3 [block/..." -> "3").
targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
    | grep -F "$dst_backstore" \
    | while IFS= read -r _lun_line; do
        _lun_rest="${_lun_line#*lun}"
        printf '%s\n' "${_lun_rest%%[!0-9]*}"
    done \
    | head -1
SSHEOF
    ) || { log_msg "FATAL: Failed to clone ${key}"; exit 1; }

    if [[ -z "$new_lun" ]]; then
        log_msg "FATAL: Could not determine new LUN number for ${key}"
        exit 1
    fi
    disk_new_luns["$key"]="$new_lun"
    log_msg "INFO: ✓ ${key}: LUN ${old_lun} → LUN ${new_lun}"
    echo ""
done

# --- Save iSCSI config on the storage host ---
log_msg "INFO: Saving iSCSI configuration..."
remote_safe_iscsi_save=$(remote_zfsutility_script "$storage_host" "safe-iscsi-save")
ssh root@"$storage_host" "$remote_safe_iscsi_save"
log_msg "INFO: ✓ Configuration saved"
echo ""

# --- Write new VM config ---
log_msg "INFO: Writing VM ${dstvmid} config..."

# Build target:old_lun → new_lun lookup (target IQN is unique per pool, handles multi-pool VMs)
declare -A lun_map=()
for key in "${disk_keys[@]}"; do
    lun_map["${disk_targets[$key]}:${disk_luns[$key]}"]="${disk_new_luns[$key]}"
done

new_vmgenid=$(cat /proc/sys/kernel/random/uuid)
new_smbios_uuid=$(cat /proc/sys/kernel/random/uuid)
name_written=false
vmgenid_written=false
smbios1_written=false

while IFS= read -r line; do
    [[ "$line" =~ ^\[.+\] ]] && break

    if parse_iscsi_line "$line"; then
        # Disk line — replace old LUN with new LUN
        old_target="${_pi_iqn}"
        old_lun="${_pi_lun}"
        new_lun="${lun_map[${old_target}:${old_lun}]}"
        [[ -n "$new_lun" ]] && line="${line/-lun-${old_lun},/-lun-${new_lun},}"
        echo "$line"

    elif [[ "$line" =~ ^vmgenid: ]]; then
        echo "vmgenid: $new_vmgenid"
        vmgenid_written=true

    elif [[ "$line" =~ ^smbios1: ]]; then
        echo "smbios1: uuid=${new_smbios_uuid}"
        smbios1_written=true

    elif [[ "$line" =~ ^name: ]]; then
        echo "name: $new_name"
        name_written=true

    elif is_net_line "$line"; then
        # Replace MAC address
        new_mac=$(gen_mac)
        rewrite_mac "$line" "$new_mac" pairs

    elif [[ "$line" == protection:* ]]; then
        : # Drop — clone is not a template

    elif [[ "$line" =~ ^meta: ]]; then
        : # Drop — Proxmox regenerates this on first interaction

    else
        echo "$line"
    fi

done < "$src_conf" > "$dst_conf"

# Add any fields not present in source config
[[ "$name_written"     == "true" ]] || echo "name: $new_name"                  >> "$dst_conf"
[[ "$vmgenid_written"  == "true" ]] || echo "vmgenid: $new_vmgenid"            >> "$dst_conf"
[[ "$smbios1_written"  == "true" ]] || echo "smbios1: uuid=${new_smbios_uuid}" >> "$dst_conf"

log_msg "INFO: ✓ Config written: $dst_conf"
echo ""

# --- Rescan iSCSI ---
log_msg "INFO: Rescanning iSCSI..."
rescan_path=$(find_zfsutility_script rescan-storage) \
    || { log_msg "FATAL: Could not locate rescan-storage"; exit 1; }
if ! "$rescan_path"; then
    log_msg "WARN: iSCSI rescan failed; run 'sudo rescan-storage' on $compute_host manually"
fi
echo ""

log_msg "INFO: === Done ==="
log_msg "INFO:   VM ${dstvmid} (${new_name}) is ready in Proxmox."
log_msg "INFO:   Clone origin: ${snap_suffix} (retained on source VM ${srcvmid} zvols)"
log_msg "INFO:   To cut dependency before retiring VM ${srcvmid}: promote-vm-clone ${dstvmid}"
log_msg "INFO:   Review hardware in the GUI before starting."
