#!/usr/bin/bash
# iscsi-add-encrypted-luns
# Add encrypted LUNs to the iSCSI target if they are missing (e.g., after keys loaded).
# Called by restart-iscsi-services after the iSCSI target is started.
#
# Preserves original LUN numbers by reading them from saveconfig.json (the full config).
# This is important because the compute host's by-path device symlinks depend on
# stable LUN indexes. Entries with no recorded index are skipped with a WARN —
# an index is never auto-assigned. After a LUN is added, every existing ACL
# initiator on the target is granted a MappedLUN at that index.
#
# Reads encrypted zvol list from /etc/zfsutilities/iscsi-encrypted-luns.conf,
# falling back to the legacy /etc/iscsi-encrypted-luns.conf.
# Format: backstore_name:device_path:target_short_name
#
# Install to: /usr/local/lib/zfsutilities/bin/iscsi-add-encrypted-luns on the storage host

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

# ACL MappedLUN binding (iscsi_grant_lun_to_acls) lives in lib/iscsi-lib.sh.
ISCSI_LIB="${ISCSI_ADD_ENCRYPTED_LUNS_ISCSI_LIB:-$(find_zfsutility_script iscsi-lib.sh)}"
source "$ISCSI_LIB"

source_helper rootcheck
rootcheck

# iSCSI-only script — exit silently in single-node mode
is_single_node && exit 0

sleep 2  # Brief wait for device nodes to appear after zfs load-key

conf="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$conf" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    conf="/etc/iscsi-encrypted-luns.conf"
fi
savefile="/etc/rtslib-fb-target/saveconfig.json"

if [[ ! -f "$conf" ]]; then
    exit 0
fi

# Look up the original LUN index for a backstore name from saveconfig.json,
# scoped to one full target IQN. Returns the index on stdout, or empty
# string if not found. Scoping matters when orphan targets under a
# different IQN prefix carry the same backstore at another index — a
# global first-match lookup would return that wrong index.
lookup_lun_number() {
    local bsname="$1" target_iqn="$2"
    [[ -f "$savefile" ]] || return
    bsname="$bsname" target_iqn="$target_iqn" python3 - "$savefile" << 'PYEOF' 2>/dev/null
import json, os, sys
name = os.environ["bsname"]
target_iqn = os.environ["target_iqn"]
with open(sys.argv[1]) as f:
    config = json.load(f)
for target in config.get("targets", []):
    if target.get("wwn") != target_iqn:
        continue
    for tpg in target.get("tpgs", []):
        for lun in tpg.get("luns", []):
            if lun.get("storage_object", "").endswith("/" + name):
                print(lun["index"])
                exit()
PYEOF
}

added=0
while IFS=: read -r name device target; do
    [[ -z "$name" || "$name" == \#* ]] && continue

    if [[ ! -e "$device" ]]; then
        continue
    fi

    if targetcli /backstores/block ls 2>/dev/null | grep -q " ${name} "; then
        continue
    fi

    full_iqn="${iqn_prefix}:${target}"

    # Look up the original LUN number BEFORE creating anything, to preserve
    # stable device paths on the compute host — and to refuse entries with no
    # recorded index before a backstore exists (auto-assignment can collide
    # or pick the wrong slot when orphan targets under a different IQN prefix
    # exist; the same identity rule iscsi-recover-encrypted-luns keeps).
    lun_num=$(lookup_lun_number "$name" "$full_iqn" || true)
    if [[ -z "$lun_num" ]]; then
        log_msg "WARN: $name — no recorded LUN index under $full_iqn in $savefile;" \
            "not added (auto-assignment refused)"
        continue
    fi

    targetcli /backstores/block create "$name" "$device" >/dev/null 2>&1
    targetcli /iscsi/"${full_iqn}"/tpg1/luns \
        create /backstores/block/"$name" "$lun_num" >/dev/null 2>&1
    log_msg "INFO:   ✓ Added $name (LUN $lun_num)"
    if ! iscsi_grant_lun_to_acls "$full_iqn" "$lun_num"; then
        log_msg "WARN: $name — ACL grant incomplete for LUN $lun_num on $full_iqn"
    fi
    added=$((added + 1))
done < "$conf"

# Persist only when something was added: nothing changed otherwise, and a
# keyless boot-time run (the ExecStartPost invocation) must not re-save —
# safe-iscsi-save would FATAL-log the degraded state on every boot.
# safe-iscsi-save itself refuses to save when a still-expected LUN mapping
# would be lost, so a partial add leaves saveconfig.json untouched. That
# refusal must not fail the boot unit by design (the loudness comes from the
# boot-time verification); warn and leave persistence to the reconcile.
if [[ "$added" -gt 0 ]]; then
    if ! "$mydir/safe-iscsi-save"; then
        log_msg "WARN: added encrypted LUNs but degraded state refused save —" \
            "run reconcile-iscsi-state"
        exit 0
    fi
fi

exit 0
