#!/usr/bin/bash

# Copy a dataset subtree from a backup copy.
# In order to get all the snapshots in the backup,
# we must do the restore in two steps. First, a
# full copy is performed using the oldest available
# snapshot. Then an incremental copy is performed
# to get the remaining snapshots.
# The two-step copy is now performed internally by
# zfs-send-receive; this wrapper makes a single call
# with the appropriate full-copy parameters.

# $1    (Optional) Overrides for the restore.
# $2    (Optional) Additional overrides (legacy Part 2 overrides). These are
#       applied after $1 for compatibility with older two-call workflows.

# Required overrides:
# 'restoresourcefs=<source dataset>; sourcefsremovequalifiers=<n>; destfs=<destination dataset>'

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper zfssnapbuild
source_helper zfs-send-receive
source_helper zfsremoveleadingqualifiers
source_helper zfsoverrides
source_helper zfsreapplyholds

# Remove any residual captured-holds temp file left by a previous failed run
# before we create a new one.
_cleanup_residual_target_holds() {
    local _residual
    for _residual in "${TMPDIR:-/tmp}"/zfsrestore-target-holds.*; do
        [[ -e "$_residual" ]] || continue
        log_msg "INFO: Removing residual captured-holds temp file from previous run: $_residual"
        rm -f -- "$_residual"
    done
}
_cleanup_residual_target_holds

# On exit, remove the captured-holds temp file only if the script succeeded.
# If it failed, preserve the file for diagnosis and tell the user where it is.
_cleanup_target_holds() {
    local _rc=$?
    if [[ -n "${_target_holds_file:-}" && -e "$_target_holds_file" ]]; then
        if [[ "$_rc" -eq 0 ]]; then
            rm -f -- "$_target_holds_file"
        else
            log_msg "WARN: zfsrestore failed (exit $_rc); leaving captured-holds" \
                "temp file for diagnosis: $_target_holds_file"
        fi
    fi
}
trap _cleanup_target_holds EXIT

# shellcheck disable=SC2034
# Intentionally set for sourced zfs-send-receive helper.
autoproceed='N'

# Post-restore helper: ensure restored VM disk zvols are exported as iSCSI LUNs.
ensure_restored_iscsi() {
    [[ "${dryrun:-N}" == "Y" ]] && return 0
    local _fs _dest
    local -a _dests=()
    for _fs in "${fsarray[@]}"; do
        _dest=$(remove_leading_qualifiers "$sourcefsremovequalifiers" "$_fs")
        [[ "$_dest" != "" && ${_dest:0:1} != "/" ]] && _dest="/$_dest"
        _dests+=("${destfs}${_dest}")
    done
    if [[ ${#_dests[@]} -gt 0 ]]; then
        log_msg "INFO: Ensuring iSCSI LUNs for restored VM disks..."
        local _ensure
        _ensure=$(find_zfsutility_script ensure-restored-vm-iscsi)
        "$_ensure" "${_dests[@]}"
    fi
}

# ========================== Global arguments ===============================
restoresourcefs="notgiven"
sourcefsremovequalifiers='0'    # '0' = Keep the full sourcefs name in the destfs name.
destfs="notgiven"               # Add the dest pool name and '/' at the beginning of the sourcefs
                                # name, giving the destination filesystem.

# Parameters for zfsbuildfsarray
# shellcheck disable=SC2034
# Intentionally set for sourced zfsbuildfsarray helper.
depth=''
# shellcheck disable=SC2034
label=''
# shellcheck disable=SC2034
includes=()
# shellcheck disable=SC2034
excludes=()
# shellcheck disable=SC2034
startwith=''
# shellcheck disable=SC2034
endwith=''

# shellcheck disable=SC2034
# Intentionally set for sourced zfs-send-receive helper.
nextsnap='notneeded'            # Inhibit creation of a new snapshot name.

# Preserve existing holds on the destination before it is destroyed/recreated.
preserve_target_holds='Y'

if [[ $1 != '' ]]; then overrides "$1"; fi
if [[ $2 != '' ]]; then overrides "$2"; fi

# Part 1: do a full copy using the oldest available snapshot.
# zfs-send-receive performs the subsequent incremental step internally.
log_msg "INFO: Restoring with full copy using the oldest available snapshot."
# shellcheck disable=SC2034
# Intentionally set for sourced zfs-send-receive helper.
force='Y'                       # Do full copy even if common snapshots are found.
# shellcheck disable=SC2034
releaseholds='Y'                # Release matching holds before restoring.
if [[ ${#releaseholds_tags[@]} -eq 0 ]]; then
    releaseholds_tags=('offsite-*')
fi
# shellcheck disable=SC2034
doincrementals='N'              # 'N' means do full copies.
# shellcheck disable=SC2034
dointermediates='N'             # Intermediate snapshots are handled internally.
# shellcheck disable=SC2034
commsnap_mostrecent='OLDEST'    # Start with the oldest snapshot.

if [[ $1 != '' ]]; then overrides "$1"; fi
if [[ $2 != '' ]]; then overrides "$2"; fi

if [[ $restoresourcefs == '' || $restoresourcefs == 'notgiven' ]]; then
    log_msg "FATAL: \$restoresourcefs was not specified."
    source "$(find_zfsutility_script bashfatal)" 8
fi
if [[ $destfs == '' || $destfs == 'notgiven' ]]; then
    log_msg "FATAL: \$destfs was not specified."
    source "$(find_zfsutility_script bashfatal)" 8
fi

_target_holds_file=""
if [[ "$preserve_target_holds" == "Y" ]]; then
    _target_holds_file=$(mktemp -t zfsrestore-target-holds.XXXXXX)
    if ! reapplyholds_capture "$destfs" "$_target_holds_file"; then
        rm -f "$_target_holds_file"
        log_msg "FATAL: Could not capture existing holds on $destfs." \
            "Aborting restore to avoid losing target hold tags." \
            "Set preserve_target_holds='N' to skip hold preservation."
        source "$(find_zfsutility_script bashfatal)" 8
    fi
fi

send-receive "$restoresourcefs" || exit $?
ensure_restored_iscsi || exit $?

if [[ -n "$_target_holds_file" && -s "$_target_holds_file" ]]; then
    reapplyholds_apply "$destfs" "$_target_holds_file" "${dryrun:-N}" || exit $?
fi

log_msg "INFO: zfsrestore completed."
