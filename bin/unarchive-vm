#!/usr/bin/bash
# unarchive-vm <vmid> [archive_base]
# Restores an archived VM from archive: recreates zvols, Proxmox config,
# and iSCSI infrastructure (two-node).
#
# Install to: /usr/local/lib/zfsutilities/bin/unarchive-vm on BOTH hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"
JSON_CONFIG="${JSON_CONFIG:-${ZFSUTILITIES_CONFIG_PATH:-/var/lib/zfsutilities/config.json}}"

usage() {
    log_msg "INFO: Usage: unarchive-vm <vmid> [archive_base] [--new-vmid <new_vmid>]"
    echo ""
    log_msg "INFO:   vmid         VM ID of the retired VM to restore"
    log_msg "INFO:   archive_base Optional ZFS dataset that contains the archive"
    log_msg "INFO:                (defaults to the path saved in JSON config)"
    log_msg "INFO:   --new-vmid   Optional new VM ID to use for restored resources"
    echo ""
    log_msg "INFO: If the original vmid is already in use and --new-vmid is not given,"
    log_msg "INFO: you will be prompted for a new VM ID (or cancel)."
    echo ""
    log_msg "INFO: Steps:"
    log_msg "INFO:   1. Discover archived zvols and Proxmox config"
    log_msg "INFO:   2. Verify destination zvols and config do not already exist"
    log_msg "INFO:   3. Restore each zvol with its original volblocksize"
    log_msg "INFO:   4. Rebuild iSCSI backstores and LUNs (two-node)"
    log_msg "INFO:   5. Restore Proxmox config (rewriting disk lines in two-node)"
    log_msg "INFO:   6. Rescan iSCSI (two-node)"
    echo ""
    log_msg "INFO: Example: unarchive-vm 904"
    log_msg "INFO: Example: unarchive-vm 904 temp/archive"
    log_msg "INFO: Example: unarchive-vm 904 temp/archive --new-vmid 910"
    exit 1
}

prompt_new_vmid() {
    local response
    echo ""
    log_msg "INFO: vmid ${vmid} is already in use (config or zvols exist)."
    read -rp "Enter a new vmid to restore as, or leave blank to abort: " response
    if [[ -z "$response" ]]; then
        log_msg "INFO: Aborted."
        exit 0
    fi
    if [[ ! "$response" =~ ^[0-9]+$ ]]; then
        log_msg "FATAL: new vmid must be a number, got: $response"
        exit 1
    fi
    if [[ "$response" == "$vmid" ]]; then
        log_msg "FATAL: new vmid must differ from the original vmid"
        exit 1
    fi
    newvmid="$response"
}

# Return 0 if $1 is a Proxmox disk key: one or more lowercase letters
# followed by one or more digits (e.g. scsi0, virtio12). Implemented with
# parameter expansion so no regex exceeds the 10-character policy limit.
is_disk_key() {
    local key="$1" digits letters
    digits="${key##*[a-z]}"
    letters="${key%"$digits"}"
    [[ -n "$letters" && "$letters" =~ ^[a-z]+$ && "$digits" =~ ^[0-9]+$ ]]
}

vmid_in_use() {
    local check_vmid="$1"
    local dest_conf="${pve_conf_dir}/${check_vmid}.conf"
    [[ -f "$dest_conf" ]] && return 0

    local found vol vol_tail
    if is_single_node; then
        # Find a non-archive zvol for this VM: ends in "/proxmox/vm-N-disk-"
        # followed only by digits, and not under the archive base.
        found=""
        while IFS= read -r vol; do
            [[ "$vol" == "${archive_base}/"* ]] && continue
            vol_tail="${vol##*"/proxmox/vm-${check_vmid}-disk-"}"
            [[ "$vol_tail" =~ ^[0-9]+$ ]] || continue
            found="$vol"
            break
        done < <(zfs list -H -t volume -o name 2>/dev/null)
    else
        found=$(ssh root@"$storage_host" bash -s "$check_vmid" "$archive_base" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

vmid="$1"
archive_base="$2"
found=""
while IFS= read -r vol; do
    [[ "$vol" == "${archive_base}/"* ]] && continue
    vol_tail="${vol##*"/proxmox/vm-${vmid}-disk-"}"
    [[ "$vol_tail" =~ ^[0-9]+$ ]] || continue
    found="$vol"
    break
done < <(zfs list -H -t volume -o name 2>/dev/null)
echo "$found"
SSHEOF
        )
    fi
    [[ -n "$found" ]]
}

# get_json_archive_path is provided by node-lib.sh (sourced above).

newvmid=""
pos_args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --new-vmid)
            shift
            newvmid="${1:-}"
            [[ -n "$newvmid" ]] || usage
            shift
            ;;
        *)
            pos_args+=("$1")
            shift
            ;;
    esac
done

[[ ${#pos_args[@]} -ge 1 && ${#pos_args[@]} -le 2 ]] || usage

vmid="${pos_args[0]}"
archive_base="${pos_args[1]:-}"

[[ "$vmid" =~ ^[0-9]+$ ]] || { log_msg "FATAL: vmid must be a number, got: $vmid"; exit 1; }
if [[ -n "$newvmid" && ! "$newvmid" =~ ^[0-9]+$ ]]; then
    log_msg "FATAL: new-vmid must be a number, got: $newvmid"
    exit 1
fi
if [[ -n "$newvmid" && "$newvmid" == "$vmid" ]]; then
    log_msg "FATAL: new-vmid must differ from vmid"
    exit 1
fi
if [[ $EUID -ne 0 && ${UNARCHIVE_VM_TEST_NO_ROOT:-0} != "1" ]]; then
    log_msg "FATAL: Must run as root (use sudo)"
    exit 1
fi

# --- If not on the compute host, delegate (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    new_vmid_arg=""
    [[ -n "$newvmid" ]] && new_vmid_arg=" --new-vmid '$newvmid'"
    remote_script=$(remote_zfsutility_script "$compute_host" "unarchive-vm")
    exec ssh -t root@"$compute_host" \
        "$remote_script '$vmid' '$archive_base'${new_vmid_arg}"
fi

log_msg "INFO: === unarchive-vm ===="
log_msg "INFO:   VM: ${vmid}"
[[ -n "$newvmid" && "$newvmid" != "$vmid" ]] && log_msg "INFO:   New VM: ${newvmid}"
echo ""

# =======================================================================
# Resolve archive base
# =======================================================================

if [[ -z "$archive_base" ]]; then
    archive_base=$(get_json_archive_path)
fi

[[ -n "$archive_base" ]] \
    || {
        log_msg "FATAL: Archive base path is required (provide as argument or save in JSON config)"
        exit 1
    }

# Validate the base exists as a ZFS dataset
if is_single_node; then
    if ! zfs list -H -o name "$archive_base" 2>/dev/null \
            | grep -qxF -- "$archive_base"; then
        {
            log_msg "FATAL: Not a ZFS dataset: $archive_base"
            exit 1
        }
    fi
else
    if ! ssh root@"$storage_host" "zfs list -H -o name '$archive_base' 2>/dev/null \
            | grep -qxF -- '$archive_base'"; then
        {
            log_msg "FATAL: Not a ZFS dataset on $storage_host: $archive_base"
            exit 1
        }
    fi
fi

# Get mountpoint of the base dataset
if is_single_node; then
    archive_mount=$(zfs get -H -o value mountpoint "$archive_base")
else
    archive_mount=$(ssh root@"$storage_host" \
        "zfs get -H -o value mountpoint '$archive_base'")
fi

# =======================================================================
# Discover archived zvols
# =======================================================================

log_msg "INFO: --- Discovering archive ---"

# Find archived zvol datasets under the archive base
if is_single_node; then
    # -r lists only descendants of the base, so filtering by the fixed
    # strings "${archive_base}/" and "/proxmox/vm-${vmid}-disk-" plus a
    # digits-at-end check preserves the original anchored-regex semantics.
    archived_zvols=$(zfs list -H -t volume -o name -r "$archive_base" 2>/dev/null \
        | grep -F "${archive_base}/" \
        | grep -F "/proxmox/vm-${vmid}-disk-" \
        | grep -E '[0-9]+$' \
        | sort)
else
    archived_zvols=$(ssh root@"$storage_host" bash -s "$archive_base" "$vmid" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

archive_base="$1"
vmid="$2"
# -r lists only descendants of the base, so fixed-string filters preserve
# the original anchored-regex semantics.
zfs list -H -t volume -o name -r "$archive_base" 2>/dev/null \
    | grep -F "${archive_base}/" \
    | grep -F "/proxmox/vm-${vmid}-disk-" \
    | grep -E '[0-9]+$' \
    | sort
SSHEOF
    ) || { log_msg "FATAL: SSH to $storage_host failed"; exit 1; }
fi

if [[ -z "$archived_zvols" ]]; then
    log_msg "FATAL: No archived zvols found for VM ${vmid} under ${archive_base}"
    exit 1
fi

# Build arrays of archive datasets and their original zvol paths
declare -a archive_datasets=()
declare -a original_zvols=()
declare -a new_zvols=()
declare -a disk_nums=()

dataset_count=0
while IFS= read -r arc_zvol; do
    # Original zvol path is the suffix after archive_base/
    orig_zvol="${arc_zvol#"${archive_base}"/}"
    disknum=""
    if [[ "$orig_zvol" == *-disk-* ]]; then
        disknum="${orig_zvol##*-disk-}"
        [[ "$disknum" =~ ^[0-9]+$ ]] || disknum=""
    fi

    archive_datasets+=("$arc_zvol")
    original_zvols+=("$orig_zvol")
    disk_nums+=("$disknum")
    ((++dataset_count))
done <<< "$archived_zvols"

# Verify sidecar files exist
missing_sidecars=()
for i in "${!archive_datasets[@]}"; do
    vbs_file="${archive_mount}/${original_zvols[$i]}.original_volblocksize"
    info_file="${archive_mount}/${original_zvols[$i]}.disk_info"
    if is_single_node; then
        [[ -f "$vbs_file" ]] || missing_sidecars+=("$vbs_file")
        [[ -f "$info_file" ]] || missing_sidecars+=("$info_file")
    else
        if ! ssh root@"$storage_host" "[[ -f '$vbs_file' ]]"; then
            missing_sidecars+=("$vbs_file")
        fi
        if ! ssh root@"$storage_host" "[[ -f '$info_file' ]]"; then
            missing_sidecars+=("$info_file")
        fi
    fi
done

[[ ${#missing_sidecars[@]} -eq 0 ]] \
    || {
        log_msg "FATAL: Missing sidecar files:"
        printf '  %s\n' "${missing_sidecars[@]}" >&2
        exit 1
    }

# Resolve new vmid if the original is in use and none was supplied
if [[ -n "$newvmid" ]]; then
    if vmid_in_use "$newvmid"; then
        {
            log_msg "FATAL: Requested new vmid ${newvmid} is already in use"
            exit 1
        }
    fi
elif vmid_in_use "$vmid"; then
    while true; do
        prompt_new_vmid
        if ! vmid_in_use "$newvmid"; then
            break
        fi
        log_msg "INFO: vmid ${newvmid} is also in use."
        newvmid=""
    done
fi
newvmid="${newvmid:-$vmid}"

# Build new zvol paths using the (possibly changed) vmid
for i in "${!original_zvols[@]}"; do
    new_zvols+=("${original_zvols[$i]/%vm-${vmid}-disk-${disk_nums[$i]}/\
vm-${newvmid}-disk-${disk_nums[$i]}}")
done

# Verify destination zvols do not already exist
existing_dest=()
for i in "${!new_zvols[@]}"; do
    if is_single_node; then
        if zfs list -H -o name "${new_zvols[$i]}" 2>/dev/null \
                | grep -qxF -- "${new_zvols[$i]}"; then
            existing_dest+=("${new_zvols[$i]}")
        fi
    else
        if ssh root@"$storage_host" "zfs list -H -o name '${new_zvols[$i]}' 2>/dev/null \
                | grep -qxF -- '${new_zvols[$i]}'"; then
            existing_dest+=("${new_zvols[$i]}")
        fi
    fi
done

[[ ${#existing_dest[@]} -eq 0 ]] \
    || {
        log_msg "FATAL: Destination zvols already exist:"
        printf '  %s\n' "${existing_dest[@]}" >&2
        exit 1
    }

# Verify archived config exists
archived_config="${archive_mount}/${pve_conf_dir}/${vmid}.conf"
if is_single_node; then
    if [[ ! -f "$archived_config" ]]; then
        log_msg "FATAL: Archived config not found: $archived_config"
        exit 1
    fi
else
    if ! ssh root@"$storage_host" "[[ -f '$archived_config' ]]"; then
        {
            log_msg "FATAL: Archived config not found on $storage_host: $archived_config"
            exit 1
        }
    fi
fi

# Verify destination config does not already exist
dest_config="${pve_conf_dir}/${newvmid}.conf"
if [[ -f "$dest_config" ]]; then
    log_msg "FATAL: Destination Proxmox config already exists: $dest_config"
    exit 1
fi

# =======================================================================
# Show summary and confirm
# =======================================================================

log_msg "INFO:   Archive base: ${archive_base}"
log_msg "INFO:   Archive mount: ${archive_mount}"
log_msg "INFO:   Archived config: ${archived_config}"
log_msg "INFO:   Zvols to restore:"
for i in "${!archive_datasets[@]}"; do
    vbs_file="${archive_mount}/${original_zvols[$i]}.original_volblocksize"
    if is_single_node; then
        orig_vbs=$(cat "$vbs_file")
    else
        orig_vbs=$(ssh root@"$storage_host" "cat '$vbs_file'")
    fi
    if [[ "${original_zvols[$i]}" != "${new_zvols[$i]}" ]]; then
        log_msg "INFO:     ${original_zvols[$i]} → ${new_zvols[$i]} (volblocksize: ${orig_vbs})"
    else
        log_msg "INFO:     ${new_zvols[$i]} (volblocksize: ${orig_vbs})"
    fi
done
echo ""

if ! ask_yn "Proceed with restore?"; then
    log_msg "INFO: Aborted."
    exit 0
fi
echo ""

# =======================================================================
# Step 1: Restore zvols
# =======================================================================

log_msg "INFO: --- Step 1: Restoring zvols ---"

if is_single_node; then
    for i in "${!archive_datasets[@]}"; do
        arc_dataset="${archive_datasets[$i]}"
        orig_zvol="${original_zvols[$i]}"
        new_zvol="${new_zvols[$i]}"
        vbs_file="${archive_mount}/${orig_zvol}.original_volblocksize"

        snap=$(zfs list -H -t snapshot -o name -S creation "$arc_dataset" 2>/dev/null | head -1)
        if [[ -z "$snap" ]]; then
            log_msg "FATAL: No snapshots found on archive dataset: $arc_dataset"
            exit 1
        fi

        snap_name="@${snap##*@}"
        orig_vbs=$(cat "$vbs_file")

        parent=$(dirname "$new_zvol")
        zfs create -p "$parent" 2>/dev/null || true

        log_msg "INFO:   Restoring ${new_zvol} (volblocksize: ${orig_vbs})..."

        zfslock_init
        if ! zfslock_wait_or_resolve "$new_zvol" "w" "unarchive-vm restore"; then
            log_msg "FATAL: Could not acquire write lock on ${new_zvol}"
            exit 1
        fi

        if ! zfs send -cw "${arc_dataset}${snap_name}" \
                | zfs receive -o volblocksize="$orig_vbs" "$new_zvol"; then
            zfslock_release "$zfslock_id"
            { log_msg "FATAL: Failed to restore ${new_zvol}"; exit 1; }
        fi
        zfslock_release "$zfslock_id"
        log_msg "INFO:   ✓ Restored: ${new_zvol}"
    done
else
    # Two-node: run restoration on storage host via SSH
    if ! ssh root@"$storage_host" bash -s "$archive_mount" "$dataset_count" \
            "${archive_datasets[@]}" "${original_zvols[@]}" "${new_zvols[@]}" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

set -e
archive_mount="$1"
dataset_count="$2"
shift 2

archive_datasets=("${@:1:$dataset_count}")
original_zvols=("${@:$((dataset_count + 1)):$dataset_count}")
new_zvols=("${@:$((2 * dataset_count + 1)):$dataset_count}")

for i in "${!archive_datasets[@]}"; do
    arc_dataset="${archive_datasets[$i]}"
    orig_zvol="${original_zvols[$i]}"
    new_zvol="${new_zvols[$i]}"
    vbs_file="${archive_mount}/${orig_zvol}.original_volblocksize"

    snap=$(zfs list -H -t snapshot -o name -S creation "$arc_dataset" 2>/dev/null | head -1)
    [[ -n "$snap" ]] || { log_msg "FATAL: No snapshots found on ${arc_dataset}"; exit 1; }

    snap_name="@${snap##*@}"
    orig_vbs=$(cat "$vbs_file")

    parent=$(dirname "$new_zvol")
    zfs create -p "$parent" 2>/dev/null || true

    log_msg "INFO:   Restoring ${new_zvol} (volblocksize: ${orig_vbs})..."

    zfslock_init
    if ! zfslock_wait_or_resolve "$new_zvol" "w" "unarchive-vm restore"; then
        log_msg "FATAL: Could not acquire write lock on ${new_zvol}"
        exit 1
    fi

    zfs send -cw "${arc_dataset}${snap_name}" \
        | zfs receive -o volblocksize="$orig_vbs" "$new_zvol"

    zfslock_release "$zfslock_id"
    log_msg "INFO:   ✓ Restored: ${new_zvol}"
done
SSHEOF
    then
        log_msg "FATAL: Zvol restoration failed on $storage_host"
        exit 1
    fi
fi

echo ""

# =======================================================================
# Step 2: iSCSI reconstruction (two-node only)
# =======================================================================

declare -A disk_to_lun=()
declare -A disk_to_target=()

if is_two_node; then
    log_msg "INFO: --- Step 2: Rebuilding iSCSI infrastructure ---"

    lun_result=$(ssh root@"$storage_host" bash -s "$newvmid" "$dataset_count" \
        "${new_zvols[@]}" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

set -e
vmid="$1"
dataset_count="$2"
shift 2
new_zvols=("${@:1:$dataset_count}")

for i in "${!new_zvols[@]}"; do
    new_zvol="${new_zvols[$i]}"
    pool="${new_zvol%%/*}"
    disknum=""
    if [[ "$new_zvol" == *-disk-* ]]; then
        disknum="${new_zvol##*-disk-}"
        [[ "$disknum" =~ ^[0-9]+$ ]] || disknum=""
    fi
    backstore="vm-${vmid}-disk-${disknum}"
    zvol_dev="/dev/zvol/${new_zvol}"

    # Map pool to target using node-lib's pool_to_target logic
    target=$(python3 -c "
import json, sys
conf = '/etc/zfsutilities-node.conf'
try:
    with open(conf) as f:
        exec(f.read())
    print(f'{IQN_PREFIX}:{POOL_TARGET[\"'$pool'\"]}')
except Exception as e:
    sys.exit(1)
") || { log_msg "FATAL: Cannot map pool ${pool} to target"; exit 1; }

    echo "TARGET:${target}"
    echo "DISK:${disknum}"

    # Create backstore if missing
    if targetcli /backstores/block ls 2>/dev/null | grep -qF " ${backstore} "; then
        echo "BACKSTORE_EXISTS:${backstore}"
    else
        targetcli /backstores/block create "$backstore" "$zvol_dev"
        targetcli "/backstores/block/${backstore}" set attribute emulate_tpu=1
        echo "BACKSTORE_CREATED:${backstore}"
    fi

    # Create LUN if missing
    existing_lun=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
        | grep -F " ${backstore} " \
        | grep -oE 'lun[0-9]+' \
        | head -1)
    existing_lun="${existing_lun#lun}"

    if [[ -n "$existing_lun" ]]; then
        echo "LUN_EXISTS:${disknum}:${existing_lun}"
    else
        targetcli "/iscsi/${target}/tpg1/luns" create "/backstores/block/${backstore}"
        new_lun=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
            | grep -F " ${backstore} " \
            | grep -oE 'lun[0-9]+' \
            | head -1)
        new_lun="${new_lun#lun}"
        echo "LUN_CREATED:${disknum}:${new_lun}"
    fi

    # Add to expected-backstores manifest
    manifest="/etc/rtslib-fb-target/expected-backstores.txt"
    if [[ -f "$manifest" ]]; then
        if ! grep -qxF -- "${backstore}" "$manifest"; then
            echo "$backstore" >> "$manifest"
            echo "MANIFEST_ADDED:${backstore}"
        fi
    fi

    # Check encryption status and add to encrypted-luns.conf if needed
    enc_status=$(zfs get -H -o value encryption "$new_zvol" 2>/dev/null || echo "-")
    if [[ "$enc_status" != "-" && "$enc_status" != "off" ]]; then
        enc_conf="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
        if [[ ! -e "$enc_conf" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
            enc_conf="/etc/iscsi-encrypted-luns.conf"
        fi
        target_short="${target##*:}"
        if [[ -f "$enc_conf" ]] \
            && cut -d: -f1 "$enc_conf" | grep -qxF -- "${backstore}"; then
            echo "ENCRYPTED_ALREADY:${backstore}"
        else
            echo "${backstore}:${zvol_dev}:${target_short}" >> "$enc_conf"
            echo "ENCRYPTED_ADDED:${backstore}"
        fi
    fi
done

# Save iSCSI config
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
"$mydir/safe-iscsi-save"
echo "CONFIG_SAVED"
SSHEOF
    ) || {
        log_msg "FATAL: iSCSI reconstruction failed on $storage_host"
        exit 1
    }

    # Parse results
    current_target=""
    while IFS= read -r line; do
        case "$line" in
            TARGET:*)
                current_target="${line#TARGET:}"
                ;;
            LUN_EXISTS:*)
                dnum="${line#LUN_EXISTS:}"
                dnum="${dnum%%:*}"
                lun="${line##*:}"
                disk_to_lun["$dnum"]="$lun"
                disk_to_target["$dnum"]="$current_target"
                log_msg "INFO:   ✓ Disk ${dnum}: LUN ${lun} (existing)"
                ;;
            LUN_CREATED:*)
                dnum="${line#LUN_CREATED:}"
                dnum="${dnum%%:*}"
                lun="${line##*:}"
                disk_to_lun["$dnum"]="$lun"
                disk_to_target["$dnum"]="$current_target"
                log_msg "INFO:   ✓ Disk ${dnum}: LUN ${lun} (created)"
                ;;
            CONFIG_SAVED)
                log_msg "INFO:   ✓ iSCSI configuration saved"
                ;;
        esac
    done <<< "$lun_result"
    echo ""
fi

# =======================================================================
# Step 3: Restore Proxmox config
# =======================================================================

log_msg "INFO: --- Step 3: Restoring Proxmox config ---"

mkdir -p "$(dirname "$dest_config")"

# Build disk_key -> disk_num mapping from .disk_info sidecars.
declare -A key_to_disknum=()
for i in "${!original_zvols[@]}"; do
    info_file="${archive_mount}/${original_zvols[$i]}.disk_info"
    if is_single_node; then
        disk_key=$(grep '^DISK_KEY=' "$info_file" 2>/dev/null | cut -d= -f2)
    else
        disk_key=$(ssh root@"$storage_host" \
            "grep '^DISK_KEY=' '$info_file' 2>/dev/null | cut -d= -f2")
    fi
    disknum="${disk_nums[$i]}"
    [[ -n "$disk_key" ]] && key_to_disknum["$disk_key"]="$disknum"
done

if is_single_node; then
    archived_content=$(cat "$archived_config")
else
    archived_content=$(ssh root@"$storage_host" "cat '$archived_config'")
fi
if [[ -z "$archived_content" ]]; then
    log_msg "FATAL: Failed to read archived config"
    exit 1
fi

rewrite_needed=false
[[ "$newvmid" != "$vmid" ]] && rewrite_needed=true

if [[ "$rewrite_needed" == "false" ]] && is_single_node; then
    # No vmid change in single-node mode: simple copy is sufficient.
    cp "$archived_config" "$dest_config"
    log_msg "INFO:   ✓ Config restored: $dest_config"
else
    # Rewrite disk lines (and UUIDs when the vmid changed).
    new_vmgenid=""
    new_smbios_uuid=""
    vmgenid_written=false
    smbios1_written=false
    if [[ "$rewrite_needed" == "true" ]]; then
        new_vmgenid=$(cat /proc/sys/kernel/random/uuid)
        new_smbios_uuid=$(cat /proc/sys/kernel/random/uuid)
    fi

    while IFS= read -r line; do
        [[ "$line" =~ ^\[.+\] ]] && break

        # Split the line into key and value parts with parameter expansion
        # (avoids regexes longer than the 10-character policy limit).
        key="${line%%:*}"
        rest_of_line="${line#*:}"
        storage="${rest_of_line%%:*}"
        storage="${storage#"${storage%%[! ]*}"}"  # drop leading spaces
        disk_part="${rest_of_line#*:}"
        disk_tail="${disk_part#vm-${vmid}-disk-}"
        disknum="${disk_tail%%[!0-9]*}"
        if is_disk_key "$key" \
            && [[ "$line" == "$key:"* && "$rest_of_line" == *:* ]] \
            && [[ -n "$storage" && "$disk_part" == "vm-${vmid}-disk-"* ]] \
            && [[ -n "$disknum" ]]; then
            # Single-node disk line: rewrite vmid if it changed, otherwise keep.
            rest="${disk_tail#"$disknum"}"
            echo "${key}: ${storage}:vm-${newvmid}-disk-${disknum}${rest}"
            [[ "$newvmid" != "$vmid" ]] && log_msg "INFO:   ✓ Rewrote ${key} for vmid ${newvmid}"
        elif [[ "$line" == *"ip-"[0-9.]":3260-iscsi-iqn."*"-lun-"[0-9]* ]] \
            && is_disk_key "$key" && [[ "$line" == "$key:"* ]]; then
            # Two-node iSCSI disk line: rewrite LUN (and target if needed).
            after="${line##*-iscsi-}"
            target="${after%-lun-*}"
            lun_and_rest="${after##*-lun-}"
            lun_digits="${lun_and_rest%%[!0-9]*}"
            rest="${lun_and_rest#"$lun_digits"}"
            disknum="${key_to_disknum[$key]}"

            if [[ -n "$disknum" && -n "${disk_to_lun[$disknum]}" \
                && -n "$lun_digits" && "$target" != *,* ]]; then
                new_lun="${disk_to_lun[$disknum]}"
                new_target="${disk_to_target[$disknum]}"
                new_path="ip-${storage_ip}:3260-iscsi-${new_target}-lun-${new_lun}"
                # Reconstruct line preserving everything except the path
                prefix="${line%%ip-*}"
                echo "${prefix}${new_path}${rest}"
                log_msg "INFO:   ✓ Rewrote ${key} → LUN ${new_lun}"
            else
                log_msg "WARN: Could not map ${key}, keeping original line"
                echo "$line"
            fi
        elif [[ "$rewrite_needed" == "true" && "$line" =~ ^vmgenid: ]]; then
            echo "vmgenid: $new_vmgenid"
            vmgenid_written=true
        elif [[ "$rewrite_needed" == "true" && "$line" =~ ^smbios1: ]]; then
            echo "smbios1: uuid=${new_smbios_uuid}"
            smbios1_written=true
        else
            echo "$line"
        fi
    done <<< "$archived_content" > "$dest_config"

    if [[ "$rewrite_needed" == "true" ]]; then
        [[ "$vmgenid_written" == "true" ]] || echo "vmgenid: $new_vmgenid" >> "$dest_config"
        if [[ "$smbios1_written" != "true" ]]; then
            echo "smbios1: uuid=${new_smbios_uuid}" >> "$dest_config"
        fi
    fi

    log_msg "INFO:   ✓ Config restored: $dest_config"
fi

echo ""

# =======================================================================
# Step 4: Rescan (two-node only)
# =======================================================================

if is_two_node; then
    log_msg "INFO: --- Step 4: Rescanning iSCSI ---"
    rescan_path=$(find_zfsutility_script rescan-storage) \
        || { log_msg "FATAL: Could not locate rescan-storage"; exit 1; }
    if ! "$rescan_path"; then
        log_msg "WARN: iSCSI rescan failed; run 'sudo rescan-storage' on $compute_host manually"
    fi
    echo ""
fi

# =======================================================================
# Done
# =======================================================================

log_msg "INFO: === Done ==="
if [[ "$newvmid" != "$vmid" ]]; then
    log_msg "INFO:   VM ${vmid} has been unarchived as VM ${newvmid}."
else
    log_msg "INFO:   VM ${vmid} has been unarchived."
fi
if is_two_node; then
    log_msg "INFO:   iSCSI LUNs:"
    for d in "${!disk_to_lun[@]}"; do
        log_msg "INFO:     disk ${d}: LUN ${disk_to_lun[$d]}"
    done
fi
log_msg "INFO:   Config: ${dest_config}"
echo ""
log_msg "INFO:   Review hardware in the Proxmox GUI before starting the VM."
