#!/usr/bin/bash
# uninstall-some-versions
# Reads version numbers from a list file and uninstalls each one by invoking
# uninstall-version with the -y flag.
#
# Usage:
#   sudo ./uninstall-some-versions [listfile]
#
# Arguments:
#   listfile  Path to a plain-text list of versions to remove.
#             Defaults to ./someinstalledversions in the current directory.
#
# Globals:
#   ZFSUTILITIES_VERSION_BASE  Optional override for the version base directory.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


set -euo pipefail

source_helper rootcheck
rootcheck

usage() {
    echo "Usage: uninstall-some-versions [listfile]"
    echo ""
    echo "Reads version numbers from listfile (default: ./someinstalledversions)"
    echo "and invokes uninstall-version -y for each entry."
    echo ""
    echo "Examples:"
    echo "  sudo uninstall-some-versions"
    echo "  sudo uninstall-some-versions /root/versions-to-remove.txt"
    exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
fi

if [[ $# -gt 1 ]]; then
    usage
fi

listfile="${1:-./someinstalledversions}"
uninstall="$mydir/uninstall-version"

[[ -f "$listfile" ]] || die "Version list not found: $listfile"
[[ -x "$uninstall" ]] || die "uninstall-version not found: $uninstall"

# Trim leading whitespace, drop blank lines, and run uninstall-version -y
# once per listed version via xargs (one at a time, destructively).
sed -e 's/^[[:space:]]*//' -e '/^$/d' "$listfile" | \
    xargs -I {} "$uninstall" -y {}
