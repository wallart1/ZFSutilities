#!/usr/bin/bash
# Relinquish root privilages if root.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


function unroot {
    if [[ $1 != '' ]]; then suuser=$1; fi
    if [[ $suuser = '' ]]; then suuser='dan'; fi        # New user to switch to

    userid=$(id | awk -F'(' '{print $1}')       # Current uid

    if [[ $userid = 'uid=0' ]]; then        # Are we root?
        su - "$suuser"
    fi
}
if calledbybash; then
    unroot "$1"
fi
