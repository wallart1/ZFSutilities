#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# Delete a dataset along with all its snapshots and holds.
# $1 = Subtree head
# $2 = Optional $includes
# $3 = Optional $excludes
# $4 = Optional $startwith
# $5 = Optional $overrides

source ~/bashinit

# Record this script's directory early so fatal configuration errors can
# source bashfatal and locate node-lib.sh, even when a caller has overridden
# $mydir (e.g., the test suite).  The full bashinit / rootcheck sequence is
# intentionally delayed until the entry function runs because this file is
# also sourced as a library.
_zfsdelfs_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")

# Node configuration (single-node or two-node)
: "${NODE_CONF:=/etc/zfsutilities-node.conf}"
if [[ ! -r "$NODE_CONF" ]]; then
    if [[ -r /etc/two-node.conf ]]; then
        NODE_CONF="/etc/two-node.conf"
    else
        log_msg "FATAL: Missing $NODE_CONF — install via: bin/install-single-node"
        # shellcheck source=bin/bashfatal
        source "$_zfsdelfs_dir/bashfatal" 1
    fi
fi
source "$NODE_CONF"
: "${NODE_MODE:=two-node}"
if [[ "$NODE_MODE" == "single-node" ]]; then
    STORAGE_HOST="${THIS_HOST:-$(hostname -s)}"
    COMPUTE_HOST="$STORAGE_HOST"
fi

# Shared iSCSI teardown/rebuild helpers.
source_helper iscsi-lib.sh

# Returns 0 if the dataset has any snapshots with ZFS clone dependents, 1 otherwise.
# Used to block deletion of zvols that are the origin of ZFS clones.
function has_clone_dependents {
    local dataset="$1"
    zfs list -H -t snapshot -o clones -r "$dataset" 2>/dev/null \
        | grep -qv '^-$'
}

function delfs {
    local fsarray fs

    # Initialise bashinit now because this file is sourced as a library.
    # rootcheck was deliberately deferred to this entry function.
    bashinit

    # Source helpers via the centralized finder, which locates them relative
    # to this script rather than the caller-controlled $mydir.

    source_helper node-lib.sh
    source_helper zfsbuildfsarray
    source_helper zfsdelallsnaps
    source_helper zfsoverrides
    source_helper zfs-diagnose-busy
    source_helper zfslockmanager

    if [[ $autoproceed = '' ]]; then autoproceed='N'; fi
    depth=''
    if [[ $1 != '' ]]; then sourcefs=$1; fi
    if [[ $sourcefs = '' ]]; then
        log_msg "FATAL: A subtree must be specified."
        exit 8
    fi

    # Save caller's includes, excludes, and startwith before overwriting them,
    # so that delfs does not clobber the caller's filter state.
    local saved_includes=("${includes[@]}")
    local saved_excludes=("${excludes[@]}")
    local saved_startwith="$startwith"
    local saved_endwith="$endwith"

    function restore-caller-filter-state {
        includes=("${saved_includes[@]}")
        excludes=("${saved_excludes[@]}")
        startwith="$saved_startwith"
        endwith="$saved_endwith"
    }

    if [[ $2 != '' ]]; then
        includes=("$2")
    else
        unset includes
    fi
    if [[ $3 != '' ]]; then
        excludes=("$3")
    else
        unset excludes
    fi
    if [[ $4 != '' ]]; then
        startwith="$4"
    else
        unset startwith
    fi

    if [[ $5 != '' ]]; then overrides "$5"; fi

    zfslock_init
    zfslock_wait_or_resolve "$sourcefs" "x" "destroy dataset $sourcefs"
    local lock_rc=$?
    if [[ $lock_rc -ne 0 ]]; then
        log_msg "FATAL: Cannot acquire destroy lock on $sourcefs; aborting."
        restore-caller-filter-state
        exit 8
    fi

    buildfsarray "$sourcefs" bottomup       # bottomup = list descendents before parents.

    if [[ ${#fsarray[@]} = 0 ]]; then
        log_msg "WARN: There are no qualifying datasets to delete."
        restore-caller-filter-state
        exit 4
    else
        if [[ $autoproceed != 'Y' ]]; then
            local _has_dependent_clones=false
            log_msg "INFO: About to delete the following datasets and all their snapshots," \
                "ignoring holds."
            for fs in "${fsarray[@]}"; do
                local _bsname="${fs##*/}"
                local _annotation=""
                if has_clone_dependents "$fs"; then
                    _annotation+="  [ZFS clone dependents — cannot delete]"
                    _has_dependent_clones=true
                fi
                if [[ "$NODE_MODE" != "single-node" && "$_bsname" =~ ^vm-[0-9]+-disk-[0-9]+$ ]] && \
                        targetcli /backstores/block ls 2>/dev/null | grep -q " ${_bsname} "; then
                    local _bs_dev
                    _bs_dev=$(targetcli "/backstores/block/${_bsname}" info 2>/dev/null \
                        | grep -oP '/dev/zvol/\S+' | head -1)
                    if [[ -z "$_bs_dev" || "$_bs_dev" == "/dev/zvol/${fs}" ]]; then
                        _annotation+="  [iSCSI LUN — will be removed from targetcli]"
                    fi
                fi
                echo "  $fs${_annotation}"
            done
            if [[ "$_has_dependent_clones" == true ]]; then
                log_msg "FATAL: One or more datasets have ZFS clone dependents and cannot be" \
                    "deleted. Use promote-vm-clone to cut dependencies first."
                restore-caller-filter-state
                exit 8
            fi
            read -rp 'Press enter to continue.'
        fi
        rc=''
        for fs in "${fsarray[@]}"; do
            if zfs list -t filesystem,volume "$fs" > /dev/null 2>&1; then
                if has_clone_dependents "$fs"; then
                    log_msg "FATAL: $fs has ZFS clone dependents — cannot delete." \
                        "Use promote-vm-clone to cut dependencies first."
                    restore-caller-filter-state
                    exit 8
                fi
                if ! iscsi_teardown_zvol "$fs"; then
                    log_msg "FATAL: $fs NOT deleted (running VM)."
                    restore-caller-filter-state
                    exit 8
                fi
                if delallsnaps "$fs" '' 'releaseholds'; then
                    if ! zfs destroy "$fs"; then
                        diagnose_dataset_busy "$fs"
                        log_msg "FATAL: $fs was NOT deleted."
                        restore-caller-filter-state
                        exit 8
                    else
                        log_msg "INFO: $fs was deleted."
                    fi
                else
                    log_msg "FATAL: $fs was NOT deleted because delallsnaps could not delete all" \
                        "of its snapshots."
                    restore-caller-filter-state
                    exit 8
                fi
            fi
        done
    fi

    restore-caller-filter-state
}
if calledbybash; then delfs "$@"; fi
