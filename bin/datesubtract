#!/usr/bin/bash
set -euo pipefail
# Find the number of days between two dates

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

usage() {
    log_msg "INFO: Usage: $0 <start-date> <end-date>"
    log_msg "INFO:   start-date  First date, accepted by 'date -d'."
    log_msg "INFO:   end-date    Second date, accepted by 'date -d'."
}

if [[ $# -lt 2 ]]; then
    usage
    die "Two dates are required."
fi

start_date=$(date -d "$1" +%s)
end_date=$(date -d "$2" +%s)
numberofdays=$(( (end_date - start_date) / 86400 ))
log_msg "INFO: Between $1 and $2, there are $numberofdays days."

numberofmonths=$(printf "%.2f\n" "$(echo "$numberofdays / (365 / 12)" | bc -l)")
log_msg "INFO: ... or $numberofmonths months."

numberofyears=$(printf "%.2f\n" "$(echo "$numberofdays / 365" | bc -l)")
log_msg "INFO: ... or $numberofyears years."
