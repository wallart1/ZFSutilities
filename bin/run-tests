#!/usr/bin/bash
# run-tests — Thin wrapper around the unified test harness at tests/run-tests.
#
# Usage:
#   ./run-tests                    # Run all suites (bash + Python)
#   ./run-tests test-zfsretain     # Run a specific bash suite
#   ./run-tests test_backup_config # Run a specific Python suite
#   ./run-tests -v                 # Verbose (show all output)
#   ./run-tests -q                 # Quiet (summary only)
#   ./run-tests --failures-only    # Only show failures
#
# Exit codes:
#   0  All tests passed
#   1  One or more tests failed
#   2  Unified test runner executable not found

set -uo pipefail

MYDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNIFIED_RUNNER="$MYDIR/../tests/run-tests"

if [[ ! -x "$UNIFIED_RUNNER" ]]; then
    echo "Unified test runner not found: $UNIFIED_RUNNER" >&2
    exit 2
fi

exec "$UNIFIED_RUNNER" "$@"
