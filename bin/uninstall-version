#!/bin/bash
# uninstall-version [-y|--yes] <version>
# Removes a deployed version directory. Refuses to remove the active version.
# Use -y or --yes to skip the confirmation prompt.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


set -euo pipefail

source_helper rootcheck
rootcheck

VERSION_BASE="${ZFSUTILITIES_VERSION_BASE:-/usr/local/lib/zfsutilities}"

# die is provided by bashinit (sourced above).

usage() {
    log_msg "INFO: Usage: uninstall-version [-y|--yes] <version>"
    log_msg "INFO:"
    log_msg "INFO: Options:"
    log_msg "INFO:   -y, --yes    Skip the confirmation prompt"
    log_msg "INFO:"
    log_msg "INFO: Examples:"
    log_msg "INFO:   sudo uninstall-version 1.0.0"
    log_msg "INFO:   sudo uninstall-version -y 1.0.0"
    exit 1
}

[[ $EUID -eq 0 || ${UNINSTALL_VERSION_TEST_NO_ROOT:-0} == "1" ]] || \
    die "Must run as root (use sudo)"

FORCE_YES=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes)
            FORCE_YES=1
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            log_msg "WARN: Unknown option: $1"
            usage
            ;;
        *)
            break
            ;;
    esac
done

[[ $# -eq 1 ]] || usage

VERSION="$1"
TARGET="$VERSION_BASE/versions/$VERSION"

[[ -d "$TARGET" ]] || die "Version not found: $VERSION"

CURRENT=$(readlink -f "$VERSION_BASE/current" 2>/dev/null || true)
if [[ "$CURRENT" == "$TARGET" ]]; then
    die "Cannot uninstall the currently active version ($VERSION)"
fi

if [[ "$FORCE_YES" -eq 0 ]]; then
    read -rp "Remove $VERSION? (y/N): " confirm
    # Regex: ^[Yy]$
    # Purpose: Accept any single-character response starting with Y or y as confirmation.
    # Example: "Y" -> match; "y" -> match; "yes" -> no match (triggers abort)
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
fi

rm -rf "$TARGET"

log_msg "INFO: === uninstall-version ==="
log_msg "INFO:   Removed: $VERSION"
