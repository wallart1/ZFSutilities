#!/usr/bin/bash

# zfsconfig — JSON config helper for bash scripts
#
# Source this file to get functions that read/write the JSON config file used
# by the GUI (/var/lib/zfsutilities/config.json). Implemented with python3 so
# there is no dependency on jq.
#
# Functions:
#   zfsconfig_get_pools              # Print one pool name per line
#   zfsconfig_get_offsite_candidates # Print offsite-candidate pool names, one per line
#   zfsconfig_get_checkagainst       # Print entries: "<dataset> <quals> <counterpart> <label>"
#   zfsconfig_get_retention <pool>   # Emit bash-sourceable bktname[]/bktretain[]/minage[]
#                                    # for <pool>. Resolution order: the pool's own entry,
#                                    # then the special '<offsite>' entry when <pool> is an
#                                    # offsite candidate, then 'default'. Falls back to
#                                    # legacy zfsretainpol-<pool> files in
#                                    # $ZFSCONFIG_LEGACY_DIR (default: helper's dir).
#   poolarray                        # Compatibility shim: fills $zfspoolarray from pools
#
# Environment:
#   ZFSCONFIG_PATH  override config path (default: /var/lib/zfsutilities/config.json)
#   ZFSLOCK_DIR     override lock directory (default: /run/lock/zfsutilities)
#
# Cached in the shell for speed: _ZFSCONFIG_POOLS_CACHE,
# _ZFSCONFIG_OFFSITE_CACHE, _ZFSCONFIG_CA_CACHE.
# Unset them to force a re-read, or call zfsconfig_invalidate.

# The path library is normally inherited from bashinit; source it directly if
# this file is loaded in a context where the variables are not yet defined.
if [[ -z "${ZFSUTILITIES_CONFIG_PATH:-}" ]]; then
    PATHS_LIB="${PATHS_LIB:-$(find_zfsutility_script paths.sh)}"
    if [[ -n "$PATHS_LIB" ]]; then
        # shellcheck source=/dev/null
        source "$PATHS_LIB"
    fi
fi

ZFSCONFIG_PATH="${ZFSCONFIG_PATH:-${ZFSUTILITIES_CONFIG_PATH:-/var/lib/zfsutilities/config.json}}"
ZFSLOCK_DIR="${ZFSLOCK_DIR:-${ZFSUTILITIES_LOCK_DIR:-/run/lock/zfsutilities}}"

# Legacy fallback: if the new path does not exist and the old path does, use
# the old path so existing installs keep working before the Step 5 migration.
if [[ ! -e "$ZFSCONFIG_PATH" \
    && -f "${ZFSUTILITIES_LEGACY_CONFIG_PATH:-/root/.config/zfsutilities.json}" ]]; then
    log_msg "WARN: zfsconfig: config not found at $ZFSCONFIG_PATH; using legacy path" \
        "${ZFSUTILITIES_LEGACY_CONFIG_PATH:-/root/.config/zfsutilities.json}"
    ZFSCONFIG_PATH="${ZFSUTILITIES_LEGACY_CONFIG_PATH:-/root/.config/zfsutilities.json}"
fi

_zfsconfig_ensure() {
    if [[ ! -f "$ZFSCONFIG_PATH" ]]; then
        mkdir -p "$(dirname "$ZFSCONFIG_PATH")"
        echo '{}' > "$ZFSCONFIG_PATH"
    fi
}

_zfsconfig_lock_file() {
    mkdir -p "$ZFSLOCK_DIR"
    printf '%s/.config.lock' "$ZFSLOCK_DIR"
}

# Locate the Python source directory so bash helpers can import feature_config.
# Honours ZFSUTILITIES_PYLIB, then checks the repo root and deployed bin/ layouts.
_zfsconfig_pylib() {
    if [[ -n "${ZFSUTILITIES_PYLIB:-}" ]]; then
        printf '%s\n' "$ZFSUTILITIES_PYLIB"
        return 0
    fi
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local candidate
    for candidate in \
        "$script_dir/python" \
        "$script_dir/../python"; do
        if [[ -f "$candidate/feature_config.py" ]]; then
            realpath "$candidate"
            return 0
        fi
    done
    log_msg "FATAL: Could not locate feature_config.py"
    return 1
}

zfsconfig_invalidate() {
    unset _ZFSCONFIG_POOLS_CACHE _ZFSCONFIG_OFFSITE_CACHE _ZFSCONFIG_CA_CACHE
}

zfsconfig_get_pools() {
    if [[ -z "${_ZFSCONFIG_POOLS_CACHE+x}" ]]; then
        _zfsconfig_ensure
        local lock_file
        lock_file="$(_zfsconfig_lock_file)"
        _ZFSCONFIG_POOLS_CACHE=$(
            exec 200<>"$lock_file"
            flock -s 200
            cfg_path="$ZFSCONFIG_PATH" python3 - <<'PYEOF'
import json, os, sys
try:
    with open(os.environ["cfg_path"]) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
for p in cfg.get("pools", []) or []:
    if isinstance(p, dict):
        name = p.get("name")
        if name:
            print(name)
    else:
        print(p)
PYEOF
        )
        export _ZFSCONFIG_POOLS_CACHE
    fi
    printf '%s\n' "$_ZFSCONFIG_POOLS_CACHE"
}

zfsconfig_get_offsite_candidates() {
    if [[ -z "${_ZFSCONFIG_OFFSITE_CACHE+x}" ]]; then
        _zfsconfig_ensure
        local lock_file
        lock_file="$(_zfsconfig_lock_file)"
        _ZFSCONFIG_OFFSITE_CACHE=$(
            exec 200<>"$lock_file"
            flock -s 200
            cfg_path="$ZFSCONFIG_PATH" python3 - <<'PYEOF'
import json, os, sys
try:
    with open(os.environ["cfg_path"]) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
for p in cfg.get("pools", []) or []:
    if isinstance(p, dict):
        if p.get("offsite_candidate"):
            print(p.get("name", ""))
    elif isinstance(p, str):
        # Legacy string entries are never offsite candidates.
        pass
PYEOF
        )
        export _ZFSCONFIG_OFFSITE_CACHE
    fi
    printf '%s\n' "$_ZFSCONFIG_OFFSITE_CACHE"
}

zfsconfig_get_checkagainst() {
    if [[ -z "${_ZFSCONFIG_CA_CACHE+x}" ]]; then
        _zfsconfig_ensure
        local lock_file pylib
        lock_file="$(_zfsconfig_lock_file)"
        pylib="$(_zfsconfig_pylib)" || return 1
        _ZFSCONFIG_CA_CACHE=$(
            exec 200<>"$lock_file"
            flock -s 200
            cfg_path="$ZFSCONFIG_PATH" pylib="$pylib" python3 - <<'PYEOF'
import json, os, sys
sys.path.insert(0, os.environ["pylib"])
import feature_config
try:
    with open(os.environ["cfg_path"]) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}
for e in feature_config.merge_checkagainst_entries(cfg):
    source_root = str(e.get("source_root", "")).strip()
    dest_root = str(e.get("dest_root", "")).strip()
    label = str(e.get("label", "")).strip()
    if not source_root or not dest_root or not label:
        continue
    print(source_root, dest_root, label)
PYEOF
        )
        export _ZFSCONFIG_CA_CACHE
    fi
    printf '%s\n' "$_ZFSCONFIG_CA_CACHE"
}

# zfsconfig_get_retention <pool>
#   Prints a bash-sourceable fragment: `bktname[i]='...'; bktretain[i]=N; minage[i]=N`
#   for the given pool. Resolution order: the pool's own entry in the JSON
#   retention section, then the special '<offsite>' entry when <pool> is marked
#   as an offsite candidate, then 'default'. If the JSON has none of those,
#   falls back to parsing legacy zfsretainpol-<pool> files from
#   $ZFSCONFIG_LEGACY_DIR (default: the directory containing this helper).
#   Exit status: 0 if any buckets were emitted, 1 otherwise.
zfsconfig_get_retention() {
    local pool="$1"
    local legacy_dir="${ZFSCONFIG_LEGACY_DIR:-$(dirname "${BASH_SOURCE[0]}")}"
    _zfsconfig_ensure
    local lock_file
    lock_file="$(_zfsconfig_lock_file)"
    (
        exec 200<>"$lock_file"
        flock -s 200
        cfg_path="$ZFSCONFIG_PATH" pool="$pool" legacy_dir="$legacy_dir" \
        python3 - <<'PYEOF'
import json, os, re, sys

path = os.environ["cfg_path"]
pool = os.environ["pool"]
legacy_dir = os.environ["legacy_dir"]

try:
    with open(path) as f:
        cfg = json.load(f)
except Exception:
    cfg = {}

retention = cfg.get("retention") or {}
buckets = retention.get(pool)
if not buckets and pool != "<offsite>":
    # An offsite-candidate pool inherits the special '<offsite>' policy before
    # falling back to 'default'.
    for entry in cfg.get("pools", []) or []:
        if (
            isinstance(entry, dict)
            and entry.get("name") == pool
            and entry.get("offsite_candidate")
        ):
            buckets = retention.get("<offsite>")
            break
buckets = buckets or retention.get("default")

if not buckets:
    # Legacy fallback: parse zfsretainpol-<pool> then zfsretainpol-default.
    # Pattern documentation (required because the regex exceeds 10 characters):
    #   bktname\[\d+\]='(\w+)'
    #       Matches a legacy bucket-name assignment: the literal "bktname[",
    #       one or more digits (the bucket index, discarded), the literal
    #       "]='", then capture group 1: one or more word characters (letters,
    #       digits, underscore) — the bucket name — followed by a single quote.
    #   ;
    #       A literal semicolon ends the assignment.
    #   \s*bktretain\[\d+\]=(\d+)
    #       Optional whitespace, then a retain-count assignment: the literal
    #       "bktretain[", digits (index, discarded), "] =", then capture group
    #       2: one or more digits — the number of snapshots to retain.
    #   ;
    #       A literal semicolon ends the assignment.
    #   \s*minage\[\d+\]=(\d+)
    #       Optional whitespace, then a minimum-age assignment: the literal
    #       "minage[", digits (index, discarded), "] =", then capture group 3:
    #       one or more digits — the minimum snapshot age in days.
    # re.search (not fullmatch) is used so leading indentation or trailing
    # content on the line is tolerated.
    pat = re.compile(
        r"bktname\[\d+\]='(\w+)';\s*bktretain\[\d+\]=(\d+);\s*minage\[\d+\]=(\d+)"
    )
    for name in (pool, "default"):
        fpath = os.path.join(legacy_dir, f"zfsretainpol-{name}")
        if not os.path.exists(fpath):
            continue
        parsed = []
        try:
            with open(fpath) as f:
                for line in f:
                    m = pat.search(line)
                    if m:
                        parsed.append({
                            "name": m.group(1),
                            "retain": int(m.group(2)),
                            "minage": int(m.group(3)),
                        })
        except OSError:
            continue
        if parsed:
            buckets = parsed
            break

if not buckets:
    sys.exit(1)

for i, b in enumerate(buckets):
    bname = b.get("name", "")
    retain = int(b.get("retain", 0))
    minage = int(b.get("minage", 0))
    if not bname:
        continue
    print(f"bktname[{i}]='{bname}'; bktretain[{i}]={retain}; minage[{i}]={minage}")
PYEOF
    )
}

# poolarray — fills $zfspoolarray from the JSON pool list.
# Compatibility shim for scripts that previously sourced zfsallthepools.
poolarray() {
    zfspoolarray=()
    local pool
    while IFS= read -r pool; do
        [[ -z "$pool" ]] && continue
        zfspoolarray+=("$pool")
    done < <(zfsconfig_get_pools)
}
