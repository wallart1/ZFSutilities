#!/usr/bin/bash
# Release selected holds on a given ZFS snapshot.
#
# $1    Snapshot
# $2+   Optional hold tag patterns. Only holds matching at least one pattern
#       are released. If no patterns are supplied, all holds are released.
#
# Sets global variable zfs_delallholds_remaining_tags to a space-separated
# list of hold tags that were NOT released (empty if none remain).

function delallholds {
    local _local_bashinit
    _local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
    if [[ -f "$_local_bashinit" ]]; then
        source "$_local_bashinit"
    else
        source ~/bashinit
    fi
    bashinit
    unset _local_bashinit

    source_helper zfslockmanager

    local zfsdelallholds_snap="$1"
    shift
    local -a zfsdelallholds_patterns=("$@")
    local hold holdtag pattern
    declare -a holdarray released_tags held_tags

    zfs_delallholds_remaining_tags=""

    local _delallholds_parent="${zfsdelallholds_snap%%@*}"
    zfslock_init
    if ! zfslock_wait_or_resolve "$_delallholds_parent" "w" "zfsdelallholds"; then
        log_msg "WARN: Could not acquire write lock on ${_delallholds_parent}; aborting."
        return 1
    fi
    local _delallholds_lock="$zfslock_id"

    # Read each line from zfs holds -H into holdarray
    IFS=$'\n' readarray -t holdarray < <(zfs holds -H "$zfsdelallholds_snap")

    if [[ ${#holdarray[@]} = 0 ]]; then
        return 0
    fi

    released_tags=()
    held_tags=()
    for hold in "${holdarray[@]}"; do
        holdtag=$(echo "$hold" | awk '{print $2}')
        local release_this='N'
        if [[ ${#zfsdelallholds_patterns[@]} -eq 0 ]]; then
            release_this='Y'
        else
            for pattern in "${zfsdelallholds_patterns[@]}"; do
                # shellcheck disable=SC2053
                if [[ "$holdtag" == $pattern ]]; then
                    release_this='Y'
                    break
                fi
            done
        fi
        if [[ $release_this = 'Y' ]]; then
            released_tags+=("$holdtag")
        else
            held_tags+=("$holdtag")
        fi
    done

    if [[ ${#held_tags[@]} -gt 0 ]]; then
        # shellcheck disable=SC2034
        # Intentionally set for callers that source this helper.
        zfs_delallholds_remaining_tags="${held_tags[*]}"
    fi

    if [[ ${#released_tags[@]} -eq 0 ]]; then
        return 0
    fi

    # Only prompt when releasing all holds (no patterns supplied), matching
    # historical behavior for direct/manual use.
    if [[ ${#zfsdelallholds_patterns[@]} -eq 0 ]]; then
        log_msg "INFO: About to release the following ${#released_tags[@]} holds from" \
            "$zfsdelallholds_snap."
        for holdtag in "${released_tags[@]}"; do
            echo "$holdtag"
        done
        if [[ $autoproceed != "Y" ]]; then
            read -rp "Press enter to continue."
        fi
    fi

    for holdtag in "${released_tags[@]}"; do
        if ! zfs release "$holdtag" "$zfsdelallholds_snap"; then
            rc=$?
            zfslock_release "$_delallholds_lock"
            log_msg "FATAL: Release of hold $holdtag on $zfsdelallholds_snap failed rc=$rc."
            exit 8
        fi
    done

    zfslock_release "$_delallholds_lock"
}
