#!/usr/bin/bash

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

# Apply retention to each dataset in the current global fsarray.
# Shared by pool mode and explicit prune_datasets mode. Uses the globals
# $autoproceed and $zfscleanup_label (set by cleanup).
_zfscleanup_retain_loop() {
    local retainfs
    log_msg "INFO: About to apply snapshot retention policies to the following datasets:"
    for retainfs in "${fsarray[@]}"; do
        log_msg "INFO: $retainfs"
    done
    if [[ $autoproceed != 'Y' ]]; then
        read -rp "$(log_msg) Press enter to continue."
    fi
    for retainfs in "${fsarray[@]}"; do
        retain "$retainfs" "$zfscleanup_label"
        local _retain_rc=$?
        if [[ $_retain_rc -ne 0 ]]; then
            log_msg "WARN: Skipped $retainfs (rc=$_retain_rc); continuing with next dataset."
        fi
    done
}

function cleanup {
    # Perform retention policies on given or all pools.

    # $1    (Optional) Name of pool to clean up. Defaults to all online pools.
    # $2    (Optional) 'only' means to not recurse the pool given in $1.
    #                  Anything else means to recurse the pool or subtree.
    # $3    (Required) Snapshot label that must be matched in order to be processed.
    # $4    (Optional) Overrides.
    #
    # $autoproceed  'N' means to ask user to press enter before important steps are taken.
    #               'Y' means to not stop. (Default)
    # $dryrun       'Y' means to not perform any dataset updates.Only say what would happen.
    #               'N' means to perform updates. (Default)
    # $releaseholds 'Y' means to release matching holds on snapshots to be deleted.
    #                   Matching tags are controlled by releaseholds_tags (default offsite-*).
    #               'N' means to keep snapshot holds. May result in "Dataset is busy" messages
    #                   as holds may be preventing snapshots from being deleted. (Default)
    #                   "Dataset is busy" is used as a ZFS catch-all for this and many other cases.
    # $skipbusy     'Y' means a "Dataset is busy" destroy failure is logged as WARN and the
    #               script continues to the next snapshot. 'N' means treat it as fatal.
    #               Defaults to 'Y' when called via zfsretain; 'N' for direct delsnap calls.
    # $includes     Optional array of dataset name substrings to prune (prefix '=' for exact
    #               match). If empty, all datasets in each pool are pruned.
    # $excludes     Optional array of dataset name substrings to skip (prefix '=' for exact
    #               match). If empty, no datasets are excluded. There are no built-in
    #               exclusions; callers pass any dataset-specific exclusions explicitly.
    # $startwith    Optional substring; pruning starts at the first matching dataset.
    # $endwith      Optional substring; pruning stops after the last matching dataset.
    # $prune_datasets Optional array of dataset names. When non-empty, cleanup prunes
    #               exactly these datasets (typically the destination names derived
    #               from a backup run) and skips pool discovery/buildfsarray entirely.
    #               When unset or empty, cleanup operates in pool mode as described above.

    local _local_bashinit
    _local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
    if [[ -f "$_local_bashinit" ]]; then
        source "$_local_bashinit"
    else
        source ~/bashinit
    fi
    bashinit
    unset _local_bashinit

    source_helper rootcheck
    rootcheck
    source_helper zfsconfig
    source_helper zfsbuildfsarray
    source_helper zfsretain
    source_helper zfsoverrides
    source_helper zfslockmanager

    if [[ $autoproceed = '' ]]; then autoproceed='Y'; fi
    if [[ $dryrun = '' ]]; then dryrun="N"; fi

    # Holds are maintained for offsite snapshots to avoid accidental removal.
    # This function does not release holds by default.
    if [[ $releaseholds = '' ]]; then releaseholds='N'; fi
    if [[ ${#releaseholds_tags[@]} -eq 0 ]]; then
        releaseholds_tags=('offsite-*')
    fi

    # Dataset selection criteria forwarded to zfsbuildfsarray. No built-in
    # exclusions; callers set these explicitly when they want to filter.
    [[ ${includes+x}  ]] || includes=()
    [[ ${excludes+x}  ]] || excludes=()
    [[ ${startwith+x} ]] || startwith=''
    [[ ${endwith+x}   ]] || endwith=''
    [[ ${prune_datasets+x} ]] || prune_datasets=()

    if [[ $1 != "" ]]; then zfspoolarray=("$1")
    else
        poolarray        # Put list of ZFS pools into zfspoolarray
        if [[ ${#zfspoolarray[@]} -eq 0 ]]; then
            log_msg "WARN: No pools configured in JSON config; falling back to all online pools."
            readarray -t zfspoolarray < <(zpool list -Ho name)
        fi
    fi

    if [[ $2 = 'only' ]]; then
        depth='-d0'
    else
        depth=''
    fi

    if [[ $3 = '' ]]; then
        log_msg "FATAL: Please provide a label in \$3 to specify which snapshots to process."
        source "$(find_zfsutility_script bashreturn)" 8
    else
        zfscleanup_label=$3
        if [[ ${zfscleanup_label:0:1} != '@' ]]; then zfscleanup_label='@'$zfscleanup_label; fi
    fi
    
    if [[ $4 != '' ]]; then overrides "$4"; fi

    zfslock_init

    # Explicit dataset list mode: prune exactly the given datasets (already
    # destination names). No pool discovery, no buildfsarray.
    if [[ ${#prune_datasets[@]} -gt 0 ]]; then
        fsarray=("${prune_datasets[@]}")
        echo '--------------------------------'
        _zfscleanup_retain_loop
        log_msg "INFO: zfscleanup completed."
        return 0
    fi

    for pool in "${zfspoolarray[@]}"; do
        if ! zpool list "$pool" >/dev/null 2>&1; then continue; fi
        echo '--------------------------------'

        # shellcheck disable=SC2034
        depth=''
        buildfsarray "$pool"
        _zfscleanup_retain_loop
    done
    log_msg "INFO: zfscleanup completed."
}
if calledbybash; then cleanup "$1" "$2" "$3" "$4"; fi

