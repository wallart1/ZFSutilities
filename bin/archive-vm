#!/usr/bin/bash
# archive-vm <vmid>
# Archives a VM: promotes dependent clones, archives zvols + config,
# verifies the archive, and optionally removes the VM.
#
# Install to: /usr/local/lib/zfsutilities/bin/archive-vm on BOTH hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"
JSON_CONFIG="${JSON_CONFIG:-${ZFSUTILITIES_CONFIG_PATH:-/var/lib/zfsutilities/config.json}}"

source_helper zfslockmanager

usage() {
    log_msg "INFO: Usage: archive-vm <vmid>"
    echo ""
    log_msg "INFO:   vmid   VM ID to retire"
    echo ""
    log_msg "INFO: Steps:"
    log_msg "INFO:   1. Discover ZFS clones that depend on this VM"
    log_msg "INFO:   2. Optionally promote clones (sever dependency)"
    log_msg "INFO:   3. Archive zvols and Proxmox config"
    log_msg "INFO:   4. Verify archive integrity"
    log_msg "INFO:   5. Optionally remove the VM"
    echo ""
    log_msg "INFO: Example: archive-vm 904"
    exit 1
}

# Build the prompt for the archive base dataset. In two-node mode the prompt
# reminds the operator that the dataset must live on the storage host.
build_archive_prompt() {
    local default_prompt="$1"
    if is_two_node; then
        echo "Archive base ZFS dataset (must be on ${storage_host})${default_prompt}: "
    else
        echo "Archive base ZFS dataset${default_prompt}: "
    fi
}

# Return 0 if $1 is a Proxmox disk key: one or more lowercase letters
# followed by one or more digits (e.g. scsi0, virtio12). Implemented with
# parameter expansion so no regex exceeds the 10-character policy limit.
is_disk_key() {
    local key="$1" digits letters
    digits="${key##*[a-z]}"
    letters="${key%"$digits"}"
    [[ -n "$letters" && "$letters" =~ ^[a-z]+$ && "$digits" =~ ^[0-9]+$ ]]
}

# Extract the trailing disk number from a zvol path such as
# threeamigos/proxmox/vm-105-disk-0 (prints nothing when absent).
disk_number_from_zvol() {
    local zvol="$1" disknum
    if [[ "$zvol" == *-disk-* ]]; then
        disknum="${zvol##*-disk-}"
        [[ "$disknum" =~ ^[0-9]+$ ]] && echo "$disknum"
    fi
}

# --- Ensure a snapshot exists for archiving -----------------------------
# Returns the full snapshot name (e.g. pool/dataset@snap) on stdout.
# In two-node mode this runs on the storage host.
ensure_retire_snapshot() {
    local zvol="$1"
    local snap snap_name

    if is_single_node; then
        snap=$(zfs list -H -t snapshot -o name -S creation "$zvol" 2>/dev/null | head -1)
        if [[ -z "$snap" ]]; then
            zfslock_init
            if ! zfslock_acquire "$zvol" "w" "archive-vm auto-snapshot"; then
                {
                    log_msg "FATAL: Could not acquire write lock on ${zvol} for snapshot creation"
                    exit 1
                }
            fi
            snap_name="@retire-$(date -Iminutes)-d"
            if ! zfs snapshot "${zvol}${snap_name}"; then
                zfslock_release "$zfslock_id"
                { log_msg "FATAL: Failed to create snapshot ${zvol}${snap_name}"; exit 1; }
            fi
            zfslock_release "$zfslock_id"
            snap="${zvol}${snap_name}"
            log_msg "INFO:   Created retire snapshot: ${snap}"
        fi
    else
        snap=$(ssh root@"$storage_host" bash -s "$zvol" << 'SSHEOF'
zvol="$1"

mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

snap=$(zfs list -H -t snapshot -o name -S creation "$zvol" 2>/dev/null | head -1)
if [[ -z "$snap" ]]; then
    zfslock_init
    if ! zfslock_acquire "$zvol" "w" "archive-vm auto-snapshot"; then
        log_msg "FATAL: Could not acquire write lock on ${zvol} for snapshot creation"
        echo "__ARCHIVE_VM_ERROR__"
        exit 1
    fi
    snap_name="@retire-$(date -Iminutes)-d"
    if ! zfs snapshot "${zvol}${snap_name}"; then
        zfslock_release "$zfslock_id"
        log_msg "FATAL: Failed to create snapshot ${zvol}${snap_name}"
        echo "__ARCHIVE_VM_ERROR__"
        exit 1
    fi
    zfslock_release "$zfslock_id"
    snap="${zvol}${snap_name}"
    log_msg "INFO:   Created retire snapshot: ${snap}"
fi
echo "$snap"
SSHEOF
        )
        if [[ -z "$snap" || "$snap" == __ARCHIVE_VM_ERROR__ ]]; then
            {
                log_msg "FATAL: Failed to determine snapshot for ${zvol} on ${storage_host}"
                exit 1
            }
        fi
    fi

    echo "$snap"
}

# get_json_archive_path is provided by node-lib.sh (sourced above).

# --- Save archive_path to JSON config ---
save_json_archive_path() {
    local path="$1"
    python3 -c "
import json, os
path = '$path'
conf_file = '$JSON_CONFIG'
try:
    with open(conf_file) as f:
        c = json.load(f)
except:
    c = {}
c['archive_path'] = path
c['config_version'] = c.get('config_version', 2)
os.makedirs(os.path.dirname(conf_file), exist_ok=True)
with open(conf_file, 'w') as f:
    json.dump(c, f, indent=2)
"
}

# Collect the zvol paths referenced by the VM's Proxmox config.
# Prints one zvol path per line on stdout. Warnings for unresolved
# references or orphaned zvols are emitted via log_msg on stderr.
collect_referenced_zvols() {
    local config_line disk_num target lun zvol_path
    local key rest_of_line storage disk_part after lun_and_rest
    local vol vol_tail
    local -A referenced_zvols=()

    if is_single_node; then
        while IFS= read -r config_line; do
            [[ "$config_line" =~ ^\[.+\] ]] && break
            # Parse Proxmox ZFS disk lines such as:
            #   scsi0: threeamigos:vm-105-disk-0,size=10G
            # and extract the disk number via parameter expansion.
            key="${config_line%%:*}"
            rest_of_line="${config_line#*:}"
            storage="${rest_of_line%%:*}"
            storage="${storage#"${storage%%[! ]*}"}"  # drop leading spaces
            disk_part="${rest_of_line#*:}"
            disk_num="${disk_part#vm-"${vmid}"-disk-}"
            disk_num="${disk_num%%[!0-9]*}"
            if is_disk_key "$key" \
                && [[ "$config_line" == "$key:"* && "$rest_of_line" == *:* ]] \
                && [[ -n "$storage" && "$disk_part" == "vm-${vmid}-disk-"* ]] \
                && [[ -n "$disk_num" ]]; then
                # Find the zvol whose path ends with this disk reference.
                zvol_path=""
                while IFS= read -r vol; do
                    if [[ "$vol" == *"/proxmox/vm-${vmid}-disk-${disk_num}" ]]; then
                        zvol_path="$vol"
                        break
                    fi
                done < <(zfs list -H -t volume -o name 2>/dev/null)
                if [[ -z "$zvol_path" ]]; then
                    log_msg "WARN: Config references vm-${vmid}-disk-${disk_num}" \
                        "but no zvol was found"
                    continue
                fi
                if [[ -z "${referenced_zvols[$zvol_path]:-}" ]]; then
                    referenced_zvols["$zvol_path"]=1
                    echo "$zvol_path"
                fi
            fi
        done < "$proxmoxconfig"

        # Warn about VM zvols that are not referenced in the config.
        while IFS= read -r vol; do
            vol_tail="${vol##*"/proxmox/vm-${vmid}-disk-"}"
            [[ "$vol_tail" =~ ^[0-9]+$ ]] || continue
            if [[ -z "${referenced_zvols[$vol]:-}" ]]; then
                log_msg "WARN: Orphaned zvol not referenced in config:" "$vol"
            fi
        done < <(zfs list -H -t volume -o name 2>/dev/null)
        return 0
    fi

    # Two-node path: collect target:lun pairs and resolve them on the
    # storage host. The remote helper also warns about orphaned zvols.
    local -a target_lun_refs=()
    while IFS= read -r config_line; do
        [[ "$config_line" =~ ^\[.+\] ]] && break
        # Parse Proxmox iSCSI disk lines such as:
        #   scsi0: ip-192.168.100.1:3260-iscsi-iqn.2026-02.local.stewie:threeamigos-lun-0,size=10G
        # extracting the target IQN and LUN number via parameter expansion.
        key="${config_line%%:*}"
        rest_of_line="${config_line#*:}"
        if is_disk_key "$key" && [[ "$config_line" == "$key:"* ]] \
            && [[ "$rest_of_line" == *"ip-"[0-9.]*":3260-iscsi-iqn."*"-lun-"[0-9]* ]]; then
            after="${rest_of_line##*-iscsi-}"
            target="${after%-lun-*}"
            lun_and_rest="${after##*-lun-}"
            lun="${lun_and_rest%%[!0-9]*}"
            if [[ -n "$lun" && "$target" == iqn.* && "$target" != *,* ]]; then
                target_lun_refs+=("${target}:${lun}")
            fi
        fi
    done < "$proxmoxconfig"

    if [[ ${#target_lun_refs[@]} -gt 0 ]]; then
        ssh root@"$storage_host" bash -s "$vmid" \
            "${target_lun_refs[@]}" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

vmid="$1"
shift

declare -A referenced_zvols=()
for ref in "$@"; do
    IFS=: read -r target lun <<< "$ref"
    [[ -n "$target" && -n "$lun" ]] || continue

    # Find the backstore name mapped to this target/LUN. Match lun0 without
    # matching lun01: the character after "lun${lun}" must not be a digit.
    backstore=""
    while IFS= read -r lun_line; do
        [[ "$lun_line" == *"lun${lun}"* ]] || continue
        after_lun="${lun_line#*"lun${lun}"}"
        [[ -z "$after_lun" || "$after_lun" =~ ^[0-9] ]] && continue
        [[ "$lun_line" == *"block/"* ]] || continue
        backstore="${lun_line#*"block/"}"
        backstore="${backstore%%[[:space:]]*}"
        break
    done < <(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null)
    if [[ -z "$backstore" ]]; then
        log_msg "WARN: Config references target ${target} LUN ${lun}" \
            "but no backstore was found"
        continue
    fi

    # Map the backstore to its /dev/zvol path (pool/dataset).
    zvol_line=$(targetcli /backstores/block ls 2>/dev/null \
        | grep -F " ${backstore} " \
        | head -1)
    zvol=""
    if [[ "$zvol_line" == *"/dev/zvol/"* ]]; then
        zvol="${zvol_line#*"/dev/zvol/"}"
        zvol="${zvol%%[ )]*}"
    fi
    if [[ -z "$zvol" ]]; then
        log_msg "WARN: Backstore ${backstore} has no zvol"
        continue
    fi

    echo "$zvol"
    referenced_zvols["$zvol"]=1
done

# Warn about VM zvols that are not referenced in the config.
while IFS= read -r orphan_zvol; do
    [[ -n "$orphan_zvol" ]] || continue
    if [[ -z "${referenced_zvols[$orphan_zvol]:-}" ]]; then
        log_msg "WARN: Orphaned zvol not referenced in config:" \
            "${orphan_zvol}"
    fi
done < <(zfs list -H -t volume -o name 2>/dev/null | while IFS= read -r vol; do
    vol_tail="${vol##*"/proxmox/vm-${vmid}-disk-"}"
    [[ "$vol_tail" =~ ^[0-9]+$ ]] && echo "$vol"
done)
SSHEOF
    fi
}

[[ $# -eq 1 ]] || usage

vmid="$1"
[[ "$vmid" =~ ^[0-9]+$ ]] || { log_msg "FATAL: vmid must be a number, got: $vmid"; exit 1; }
[[ $EUID -eq 0 || ${ARCHIVE_VM_TEST_NO_ROOT:-0} == "1" ]] || {
    log_msg "FATAL: Must run as root (use sudo)"
    exit 1
}

# --- If not on the compute host, delegate (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "archive-vm")
    exec ssh -t root@"$compute_host" \
        "$remote_script '$vmid'"
fi

log_msg "INFO: === archive-vm ==="
log_msg "INFO:   VM: ${vmid}"
echo ""

# =======================================================================
# Step 1: Discover clones
# =======================================================================

log_msg "INFO: --- Step 1: Discovering dependent clones ---"

if is_single_node; then
    # index() does a fixed-string substring test (no regex literals).
    clone_info=$(zfs list -H -o name,origin \
        | awk -v v="$vmid" 'index($2, "/proxmox/vm-" v "-disk-") {print $1 "\t" $2}')
else
    clone_info=$(ssh root@"$storage_host" bash -s "$vmid" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

vmid="$1"
# index() does a fixed-string substring test (no regex literals).
zfs list -H -o name,origin \
    | awk -v v="$vmid" 'index($2, "/proxmox/vm-" v "-disk-") {print $1 "\t" $2}'
SSHEOF
    ) || { log_msg "FATAL: SSH to $storage_host failed"; exit 1; }
fi

declare -A clone_vmids
if [[ -n "$clone_info" ]]; then
    log_msg "INFO:   Found dependent clones:"
    while IFS=$'\t' read -r zvol origin; do
        # Extract the VM ID from a zvol path via parameter expansion.
        # Example: "threeamigos/proxmox/vm-105-disk-0" -> "105"
        clone_vmid=""
        if [[ "$zvol" == *"/proxmox/vm-"*"-disk-"* ]]; then
            vm_part="${zvol#*"/proxmox/vm-"}"
            clone_vmid="${vm_part%%-disk-*}"
            [[ "$clone_vmid" =~ ^[0-9]+$ ]] || clone_vmid=""
        fi
        if [[ -n "$clone_vmid" && "$clone_vmid" != "$vmid" ]]; then
            clone_vmids["$clone_vmid"]=1
            log_msg "INFO:     VM ${clone_vmid}: ${zvol}"
            log_msg "INFO:       origin: ${origin}"
        fi
    done <<< "$clone_info"
    echo ""

    if ask_yn "Promote all clones to sever dependency on VM ${vmid}?"; then
        for clone_vmid in "${!clone_vmids[@]}"; do
            echo ""
            log_msg "INFO: Promoting VM ${clone_vmid}..."
            promote_vm_clone=$(find_zfsutility_script promote-vm-clone)
            "$promote_vm_clone" "$clone_vmid" \
                || { log_msg "FATAL: Promotion failed for VM ${clone_vmid}"; exit 1; }
        done
    else
        log_msg "INFO:   Skipping clone promotion."
        log_msg "WARN: Archiving may fail if snapshots are held by clones."
    fi
else
    log_msg "INFO:   No dependent clones found."
fi
echo ""

# =======================================================================
# Step 2: Archive
# =======================================================================

log_msg "INFO: --- Step 2: Archiving VM ${vmid} ---"

# Always prompt for archive base path
configured_path=$(get_json_archive_path)
if [[ -n "$configured_path" ]]; then
    default_prompt=" [$configured_path]"
else
    default_prompt=""
fi

read -rp "$(build_archive_prompt "$default_prompt")" user_path
archive_base="${user_path:-$configured_path}"

[[ -n "$archive_base" ]] || { log_msg "FATAL: Archive base path is required"; exit 1; }

# Validate the base exists as a ZFS dataset
if is_single_node; then
    if ! zfs list -H -o name "$archive_base" >/dev/null 2>&1; then
        { log_msg "FATAL: Not a ZFS dataset: $archive_base"; exit 1; }
    fi
else
    if ! ssh root@"$storage_host" "zfs list -H -o name '$archive_base'" \
            >/dev/null 2>&1; then
        { log_msg "FATAL: Not a ZFS dataset on $storage_host: $archive_base"; exit 1; }
    fi
fi

# Save the path back to JSON (in case it changed or was empty)
if [[ "$archive_base" != "$configured_path" ]]; then
    save_json_archive_path "$archive_base"
    log_msg "INFO:   ✓ Saved archive path to JSON config"
fi

# Get mountpoint of the base dataset
if is_single_node; then
    archive_mount=$(zfs get -H -o value mountpoint "$archive_base")
else
    archive_mount=$(ssh root@"$storage_host" \
        "zfs get -H -o value mountpoint '$archive_base'")
fi

proxmoxconfig="${pve_conf_dir}/${vmid}.conf"
[[ -f "$proxmoxconfig" ]] || { log_msg "FATAL: Proxmox config not found: $proxmoxconfig"; exit 1; }

# Find only the zvols actually referenced by the VM config.
zvols=$(collect_referenced_zvols | sort -u) \
    || { log_msg "FATAL: Failed to discover referenced zvols"; exit 1; }
[[ -n "$zvols" ]] || { log_msg "FATAL: No referenced zvols found for VM ${vmid}"; exit 1; }

log_msg "INFO:   Archive base: ${archive_base} (mount: ${archive_mount})"
log_msg "INFO:   Zvols to archive:"
while IFS= read -r _zvol; do
    log_msg "INFO:     ${_zvol}"
done <<< "$zvols"
echo ""

if ! ask_yn "Proceed with archive?"; then
    log_msg "INFO: Aborted."
    exit 0
fi

# Archive each zvol
for zvol in $zvols; do
    snap=$(ensure_retire_snapshot "$zvol")
    # ensure_retire_snapshot logs the specific failure before exiting its
    # subshell; an empty result means the failure has already been reported.
    if [[ -z "$snap" || "$snap" == __ARCHIVE_VM_ERROR__ ]]; then
        exit 1
    fi
    snap_name="@${snap##*@}"
    archive_dataset="${archive_base}/${zvol}"

    log_msg "INFO:   Snapshot to archive: ${snap}"

    if is_single_node; then
        # Get original volblocksize and save it immediately
        orig_vbs=$(zfs get -H -o value volblocksize "$zvol")
        log_msg "INFO:   Original volblocksize: ${orig_vbs}"
        parent=$(dirname "$archive_dataset")
        zfs create -p "$parent" 2>/dev/null || true

        log_msg "INFO:   Archiving ${zvol}${snap_name} → ${archive_dataset}"
        if ! zfs send -cw "$zvol$snap_name" \
                | zfs receive -o volblocksize=1M "$archive_dataset"; then
            { log_msg "FATAL: Failed to archive ${zvol}"; exit 1; }
        fi

        # Save original volblocksize
        echo "$orig_vbs" > "${archive_mount}/${zvol}.original_volblocksize"

        # Save disk info sidecar for unarchive
        # Extract the disk number from the zvol path (e.g. "...disk-0" -> "0").
        disknum=$(disk_number_from_zvol "$zvol")
        # Find the Proxmox config disk key (e.g. "scsi0") for this disk
        # number; first matching line wins (as with the old head -1).
        disk_key=""
        while IFS= read -r config_line; do
            key="${config_line%%:*}"
            is_disk_key "$key" || continue
            [[ "$config_line" == "$key:"*":vm-${vmid}-disk-${disknum},"* ]] \
                || continue
            disk_key="$key"
            break
        done < "$proxmoxconfig"
        if [[ -n "$disk_key" ]]; then
            info_file="${archive_mount}/${zvol}.disk_info"
            echo "DISK_KEY=${disk_key}" > "$info_file"
        fi
    else
        # Two-node: delegate to storage host
        log_msg "INFO:   Archiving ${zvol}${snap_name} → ${archive_dataset}"
        if ! ssh root@"$storage_host" bash -s "$zvol" "$snap_name" \
                "$archive_dataset" "$archive_mount" "$vmid" \
                "$proxmoxconfig" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

zvol="$1"
snap_name="$2"
archive_dataset="$3"
archive_mount="$4"
vmid="$5"
proxmoxconfig="$6"

# Get original volblocksize on the storage host
orig_vbs=$(zfs get -H -o value volblocksize "$zvol")
log_msg "INFO:   Original volblocksize: ${orig_vbs}"

parent=$(dirname "$archive_dataset")
zfs create -p "$parent" 2>/dev/null || true

if ! zfs send -cw "${zvol}${snap_name}" | zfs receive -o volblocksize=1M "$archive_dataset"; then
    log_msg "FATAL: Failed to archive ${zvol}"
    exit 1
fi

echo "$orig_vbs" > "${archive_mount}/${zvol}.original_volblocksize"

# Save disk info sidecar for unarchive
# Extract disk number from zvol path (e.g. "...disk-0" -> "0").
disknum=""
if [[ "$zvol" == *-disk-* ]]; then
    disknum="${zvol##*-disk-}"
    [[ "$disknum" =~ ^[0-9]+$ ]] || disknum=""
fi
backstore="vm-${vmid}-disk-${disknum}"

# Find target and LUN for this backstore
target=""
lun=""
# Extract IQN strings from targetcli output: each target name is a whole
# whitespace-delimited token starting with "iqn." (targetcli separates the
# name from its dotted leader with a space).
for t in $(targetcli "/iscsi" ls 2>/dev/null | while IFS= read -r _t_line; do
    read -ra _t_words <<< "$_t_line"
    for _t in "${_t_words[@]}"; do
        case "$_t" in iqn.*) printf '%s\n' "$_t" ;; esac
    done
done | sort -u); do
    # Extract the LUN number for this backstore ("lun0" -> "0").
    found_lun=$(targetcli "/iscsi/${t}/tpg1/luns" ls 2>/dev/null \
        | grep -F " ${backstore} " \
        | grep -oE 'lun[0-9]+' \
        | head -1)
    found_lun="${found_lun#lun}"
    if [[ -n "$found_lun" ]]; then
        target="$t"
        lun="$found_lun"
        break
    fi
done

# Find disk key in config
if [[ -n "$target" && -n "$lun" ]]; then
    disk_key=""
    while IFS= read -r config_line; do
        key="${config_line%%:*}"
        trailing="${key##*[a-z]}"
        leading="${key%"$trailing"}"
        [[ -n "$leading" && "$leading" =~ ^[a-z]+$ && "$trailing" =~ ^[0-9]+$ ]] \
            || continue
        [[ "$config_line" == "$key:"* ]] || continue
        [[ "$config_line" == *"ip-"[0-9.]":3260-iscsi-${target}-lun-${lun}"* ]] \
            || continue
        disk_key="$key"
        break
    done < "$proxmoxconfig"
    if [[ -n "$disk_key" ]]; then
        info_file="${archive_mount}/${zvol}.disk_info"
        echo "DISK_KEY=${disk_key}" > "$info_file"
        echo "LUN=${lun}" >> "$info_file"
        echo "TARGET=${target}" >> "$info_file"
    fi
fi
SSHEOF
        then
            log_msg "FATAL: Failed to archive ${zvol}"
            exit 1
        fi
    fi

    log_msg "INFO:   ✓ Archived: ${archive_dataset}"
done

# Archive Proxmox config — mirror the full path under the base mountpoint
config_dest_mount="${archive_mount}/${proxmoxconfig}"
if is_single_node; then
    mkdir -p "$(dirname "$config_dest_mount")"
    cp "$proxmoxconfig" "$config_dest_mount"
else
    # Two-node: copy config to storage host's archive mount
    ssh root@"$storage_host" "mkdir -p '$(dirname "$config_dest_mount")'"
    scp -q "$proxmoxconfig" "root@${storage_host}:${config_dest_mount}"
fi
log_msg "INFO:   ✓ Config archived: ${proxmoxconfig}"
echo ""

# =======================================================================
# Step 3: Verify archive
# =======================================================================

log_msg "INFO: --- Step 3: Verifying archive ---"

errors=0
for zvol in $zvols; do
    archive_dataset="${archive_base}/${zvol}"
    if is_single_node; then
        if ! zfs list -H "$archive_dataset" >/dev/null 2>&1; then
            log_msg "FATAL: MISSING dataset: ${archive_dataset}"
            ((++errors))
        else
            size=$(zfs get -H -o value volsize "$archive_dataset")
            log_msg "INFO:   ✓ ${archive_dataset} (${size})"
        fi
    else
        if ! ssh root@"$storage_host" "zfs list -H '$archive_dataset'" \
                >/dev/null 2>&1; then
            log_msg "FATAL: MISSING dataset: ${archive_dataset}"
            ((++errors))
        else
            size=$(ssh root@"$storage_host" \
                "zfs get -H -o value volsize '$archive_dataset'")
            log_msg "INFO:   ✓ ${archive_dataset} (${size})"
        fi
    fi
done

config_dest_mount="${archive_mount}/${proxmoxconfig}"

if is_single_node; then
    if [[ ! -f "$config_dest_mount" ]] || [[ ! -s "$config_dest_mount" ]]; then
        log_msg "FATAL: Config archive missing or empty"
        ((++errors))
    else
        log_msg "INFO:   ✓ Config archive OK"
    fi
else
    if ! ssh root@"$storage_host" "[[ -f '$config_dest_mount' && -s '$config_dest_mount' ]]"; then
        log_msg "FATAL: Config archive missing or empty"
        ((++errors))
    else
        log_msg "INFO:   ✓ Config archive OK"
    fi
fi

if [[ $errors -gt 0 ]]; then
    { log_msg "FATAL: Archive verification failed (${errors} errors). VM NOT removed."; exit 1; }
fi

echo ""
log_msg "INFO:   Archive verified."
echo ""

# =======================================================================
# Step 4: Optionally remove the VM
# =======================================================================

log_msg "INFO: --- Step 4: VM removal ---"

if ! ask_yn "Remove VM ${vmid}?"; then
    log_msg "INFO: VM ${vmid} preserved. Archive is under: ${archive_base}"
    exit 0
fi

# Stop the VM if running
vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
if [[ "$vm_status" == "running" ]]; then
    log_msg "INFO:   Stopping VM ${vmid}..."
    qm stop "$vmid" 2>/dev/null || true
    sleep 2
fi

# Remove disks
if is_single_node; then
    log_msg "INFO:   Removing disks..."
    for zvol in $zvols; do
        log_msg "INFO:     Destroying ${zvol}..."
        if ! zfs destroy "$zvol"; then
            source_helper zfs-diagnose-busy
            diagnose_dataset_busy "$zvol"
            log_msg "WARN: Could not destroy ${zvol}"
        fi
    done
else
    log_msg "INFO:   Removing disks and iSCSI resources..."
    for zvol in $zvols; do
        # Extract disk number from zvol path (e.g. "...disk-0" -> "0").
        disknum=$(disk_number_from_zvol "$zvol")
        pool="${zvol%%/*}"
        log_msg "INFO:     Removing disk ${disknum} from pool ${pool}..."
        remote_remove_vm_disk=$(remote_zfsutility_script "$storage_host" "remove-vm-disk")
        ssh root@"$storage_host" \
            "$remote_remove_vm_disk '$pool' '$vmid' '$disknum'" \
            || log_msg "WARN: Could not remove disk ${disknum}"
    done
fi

# Remove Proxmox config
log_msg "INFO:   Removing Proxmox config..."
rm -f "$proxmoxconfig"

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   VM ${vmid} has been archived."
log_msg "INFO:   Archive: ${archive_base}"
