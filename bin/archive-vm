#!/usr/bin/bash
# archive-vm <vmid>
# Archives a VM: verifies it is stopped (never stops it), offers to sever
# dependent clones, archives zvols + config, verifies the archive, and
# optionally removes the VM.
#
# Install to: /usr/local/lib/zfsutilities/bin/archive-vm on BOTH hosts
# Run from:   either host — storage-side and compute-side work run through
#             node-lib's on_storage/on_compute transports

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

# Shared transfer engine — also sourced by the two-node SSH helper on the
# storage host, so both node modes run literally the same archive code.
ARCHIVE_ENGINE_LIB="${ARCHIVE_ENGINE_LIB:-$(find_zfsutility_script archive-engine.sh)}"
[[ -n "$ARCHIVE_ENGINE_LIB" ]] || {
    log_msg "FATAL: Could not locate archive-engine.sh"
    exit 1
}
source "$ARCHIVE_ENGINE_LIB"

source_helper rootcheck

# rootcheck terminates when not root (callers invoke it bare); tests run
# this script as a non-root user with the zfs/qm/ssh binaries mocked, so
# the same knob that skips the two-node root gate below skips this one.
[[ ${ARCHIVE_VM_TEST_NO_ROOT:-0} == "1" ]] || rootcheck

my_host=$(hostname -s)

# qm lives only on the compute host. When this shell IS the storage host
# (two-node), every compute-side operation runs through on_compute instead,
# so the script orchestrates from whichever node it was invoked on.
if ! command -v qm >/dev/null 2>&1 \
    && ! { is_two_node && [[ "$my_host" == "$storage_host" ]]; }; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"
JSON_CONFIG="${JSON_CONFIG:-${ZFSUTILITIES_CONFIG_PATH:-/var/lib/zfsutilities/config.json}}"

source_helper zfslockmanager

usage() {
    log_msg "INFO: Usage: archive-vm <vmid>"
    echo ""
    log_msg "INFO:   vmid   VM ID to retire"
    echo ""
    log_msg "INFO: Steps:"
    log_msg "INFO:   1. Verify the VM is stopped (the script never stops it)"
    log_msg "INFO:   2. Discover ZFS clones that depend on this VM"
    log_msg "INFO:   3. Optionally sever clones (sever-vm-clone)"
    log_msg "INFO:   4. Archive zvols and Proxmox config"
    log_msg "INFO:   5. Verify archive integrity"
    log_msg "INFO:   6. Optionally remove the VM"
    echo ""
    log_msg "INFO: Example: archive-vm 904"
    exit 1
}

# Build the prompt for the archive base dataset. In two-node mode the prompt
# reminds the operator that the dataset must live on the storage host.
build_archive_prompt() {
    local default_prompt="$1"
    if is_two_node; then
        echo "Archive base ZFS dataset (must be on ${storage_host})${default_prompt}: "
    else
        echo "Archive base ZFS dataset${default_prompt}: "
    fi
}

# Return 0 if $1 is a Proxmox disk key: one or more lowercase letters
# followed by one or more digits (e.g. scsi0, virtio12). Implemented with
# parameter expansion so no regex exceeds the 10-character policy limit.
is_disk_key() {
    local key="$1" digits letters
    digits="${key##*[a-z]}"
    letters="${key%"$digits"}"
    [[ -n "$letters" && "$letters" =~ ^[a-z]+$ && "$digits" =~ ^[0-9]+$ ]]
}

# Extract the trailing disk number from a zvol path such as
# threeamigos/proxmox/vm-105-disk-0 (prints nothing when absent).
disk_number_from_zvol() {
    local zvol="$1" disknum
    if [[ "$zvol" == *-disk-* ]]; then
        disknum="${zvol##*-disk-}"
        [[ "$disknum" =~ ^[0-9]+$ ]] && echo "$disknum"
    fi
}

# Resolve the Proxmox config disk key (e.g. "scsi0") referencing this zvol
# on a single-node config line; first matching line wins. Prints nothing
# when unresolved.
disk_key_for_zvol() {
    local zvol="$1" disknum config_line key
    disknum=$(disk_number_from_zvol "$zvol")
    [[ -n "$disknum" ]] || return 0
    while IFS= read -r config_line; do
        key="${config_line%%:*}"
        is_disk_key "$key" || continue
        [[ "$config_line" == "$key:"*":vm-${vmid}-disk-${disknum},"* ]] \
            || continue
        echo "$key"
        return 0
    done < "$proxmoxconfig"
}

# --- Ensure a snapshot exists for archiving -----------------------------
# Returns the full snapshot name (e.g. pool/dataset@snap) on stdout.
# In two-node mode this runs on the storage host.
ensure_retire_snapshot() {
    local zvol="$1"
    local snap snap_name

    if is_single_node; then
        snap=$(zfs list -H -t snapshot -o name -S creation "$zvol" 2>/dev/null | head -1)
        if [[ -z "$snap" ]]; then
            zfslock_init
            if ! zfslock_acquire "$zvol" "w" "archive-vm auto-snapshot"; then
                {
                    log_msg "FATAL: Could not acquire write lock on ${zvol} for snapshot creation"
                    exit 1
                }
            fi
            snap_name="@retire-$(snapname_timestamp)-d"
            if ! zfs snapshot "${zvol}${snap_name}"; then
                zfslock_release "$zfslock_id"
                { log_msg "FATAL: Failed to create snapshot ${zvol}${snap_name}"; exit 1; }
            fi
            zfslock_release "$zfslock_id"
            snap="${zvol}${snap_name}"
            log_msg "INFO:   Created retire snapshot: ${snap}"
        fi
    else
        snap=$(on_storage "$zvol" << 'SSHEOF'
zvol="$1"

mydir="${ZFSUTILITIES_BIN_DIR:-$(realpath /usr/local/lib/zfsutilities/current/bin)}"
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

snap=$(zfs list -H -t snapshot -o name -S creation "$zvol" 2>/dev/null | head -1)
if [[ -z "$snap" ]]; then
    zfslock_init
    if ! zfslock_acquire "$zvol" "w" "archive-vm auto-snapshot"; then
        log_msg "FATAL: Could not acquire write lock on ${zvol} for snapshot creation"
        echo "__ARCHIVE_VM_ERROR__"
        exit 1
    fi
    snap_name="@retire-$(snapname_timestamp)-d"
    if ! zfs snapshot "${zvol}${snap_name}"; then
        zfslock_release "$zfslock_id"
        log_msg "FATAL: Failed to create snapshot ${zvol}${snap_name}"
        echo "__ARCHIVE_VM_ERROR__"
        exit 1
    fi
    zfslock_release "$zfslock_id"
    snap="${zvol}${snap_name}"
    log_msg "INFO:   Created retire snapshot: ${snap}"
fi
echo "$snap"
SSHEOF
        )
        if [[ -z "$snap" || "$snap" == __ARCHIVE_VM_ERROR__ ]]; then
            {
                log_msg "FATAL: Failed to determine snapshot for ${zvol} on ${storage_host}"
                exit 1
            }
        fi
    fi

    echo "$snap"
}

# get_json_archive_path is provided by node-lib.sh (sourced above).
# get_json_archive_rate_limit and save_json_config_key too.

# Collect the zvol paths referenced by the VM's Proxmox config.
# Prints one zvol path per line on stdout. Warnings for unresolved
# references or orphaned zvols are emitted via log_msg on stderr.
collect_referenced_zvols() {
    local config_line disk_num target lun zvol_path
    local key rest_of_line storage disk_part after lun_and_rest
    local vol vol_tail
    local -A referenced_zvols=()

    if is_single_node; then
        while IFS= read -r config_line; do
            [[ "$config_line" =~ ^\[.+\] ]] && break
            # Parse Proxmox ZFS disk lines such as:
            #   scsi0: threeamigos:vm-105-disk-0,size=10G
            # and extract the disk number via parameter expansion.
            key="${config_line%%:*}"
            rest_of_line="${config_line#*:}"
            storage="${rest_of_line%%:*}"
            storage="${storage#"${storage%%[! ]*}"}"  # drop leading spaces
            disk_part="${rest_of_line#*:}"
            disk_num="${disk_part#vm-"${vmid}"-disk-}"
            disk_num="${disk_num%%[!0-9]*}"
            if is_disk_key "$key" \
                && [[ "$config_line" == "$key:"* && "$rest_of_line" == *:* ]] \
                && [[ -n "$storage" && "$disk_part" == "vm-${vmid}-disk-"* ]] \
                && [[ -n "$disk_num" ]]; then
                # Find the zvol whose path ends with this disk reference.
                zvol_path=""
                while IFS= read -r vol; do
                    if [[ "$vol" == *"/proxmox/vm-${vmid}-disk-${disk_num}" ]]; then
                        zvol_path="$vol"
                        break
                    fi
                done < <(zfs list -H -t volume -o name 2>/dev/null)
                if [[ -z "$zvol_path" ]]; then
                    log_msg "WARN: Config references vm-${vmid}-disk-${disk_num}" \
                        "but no zvol was found"
                    continue
                fi
                if [[ -z "${referenced_zvols[$zvol_path]:-}" ]]; then
                    referenced_zvols["$zvol_path"]=1
                    echo "$zvol_path"
                fi
            fi
        done < "$proxmoxconfig"

        # Warn about VM zvols that are not referenced in the config.
        while IFS= read -r vol; do
            vol_tail="${vol##*"/proxmox/vm-${vmid}-disk-"}"
            [[ "$vol_tail" =~ ^[0-9]+$ ]] || continue
            if [[ -z "${referenced_zvols[$vol]:-}" ]]; then
                log_msg "WARN: Orphaned zvol not referenced in config:" "$vol"
            fi
        done < <(zfs list -H -t volume -o name 2>/dev/null)
        return 0
    fi

    # Two-node path: collect target/lun pairs (passed as separate argv
    # entries, since IQNs contain colons) and resolve them on the
    # storage host. The remote helper also warns about orphaned zvols.
    local -a target_lun_refs=()
    while IFS= read -r config_line; do
        [[ "$config_line" =~ ^\[.+\] ]] && break
        # Parse Proxmox iSCSI disk lines such as:
        #   scsi0: ip-192.168.100.1:3260-iscsi-iqn.2026-02.local.stewie:threeamigos-lun-0,size=10G
        # extracting the target IQN and LUN number via parameter expansion.
        key="${config_line%%:*}"
        rest_of_line="${config_line#*:}"
        if is_disk_key "$key" && [[ "$config_line" == "$key:"* ]] \
            && [[ "$rest_of_line" == *"ip-"[0-9.]*":3260-iscsi-iqn."*"-lun-"[0-9]* ]]; then
            after="${rest_of_line##*-iscsi-}"
            target="${after%-lun-*}"
            lun_and_rest="${after##*-lun-}"
            lun="${lun_and_rest%%[!0-9]*}"
            if [[ -n "$lun" && "$target" == iqn.* && "$target" != *,* ]]; then
                # Pass target and lun as separate argv entries: an IQN
                # already contains a colon (iqn.YYYY-MM.domain:pool), so a
                # joined "target:lun" string cannot be split back apart.
                target_lun_refs+=("$target" "$lun")
            fi
        fi
    done < "$proxmoxconfig"

    if [[ ${#target_lun_refs[@]} -gt 0 ]]; then
        on_storage "$vmid" \
            "${target_lun_refs[@]}" << 'SSHEOF'
mydir="${ZFSUTILITIES_BIN_DIR:-$(realpath /usr/local/lib/zfsutilities/current/bin)}"
source "$mydir/bashinit"
bashinit

vmid="$1"
shift

declare -A referenced_zvols=()
while [[ $# -ge 2 ]]; do
    target="$1"
    lun="$2"
    shift 2

    # Find the backstore name mapped to this target/LUN. Match lun0 without
    # matching lun01: the character after "lun${lun}" must not be a digit.
    backstore=""
    while IFS= read -r lun_line; do
        [[ "$lun_line" == *"lun${lun}"* ]] || continue
        after_lun="${lun_line#*"lun${lun}"}"
        [[ -z "$after_lun" || "$after_lun" =~ ^[0-9] ]] && continue
        [[ "$lun_line" == *"block/"* ]] || continue
        backstore="${lun_line#*"block/"}"
        backstore="${backstore%%[[:space:]]*}"
        break
    done < <(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null)
    if [[ -z "$backstore" ]]; then
        log_msg "WARN: Config references target ${target} LUN ${lun}" \
            "but no backstore was found"
        continue
    fi

    # Map the backstore to its /dev/zvol path (pool/dataset).
    zvol_line=$(targetcli /backstores/block ls 2>/dev/null \
        | grep -F " ${backstore} " \
        | head -1)
    zvol=""
    if [[ "$zvol_line" == *"/dev/zvol/"* ]]; then
        zvol="${zvol_line#*"/dev/zvol/"}"
        zvol="${zvol%%[ )]*}"
    fi
    if [[ -z "$zvol" ]]; then
        log_msg "WARN: Backstore ${backstore} has no zvol"
        continue
    fi

    echo "$zvol"
    referenced_zvols["$zvol"]=1
done

# Warn about VM zvols that are not referenced in the config.
while IFS= read -r orphan_zvol; do
    [[ -n "$orphan_zvol" ]] || continue
    if [[ -z "${referenced_zvols[$orphan_zvol]:-}" ]]; then
        log_msg "WARN: Orphaned zvol not referenced in config:" \
            "${orphan_zvol}"
    fi
done < <(zfs list -H -t volume -o name 2>/dev/null | while IFS= read -r vol; do
    vol_tail="${vol##*"/proxmox/vm-${vmid}-disk-"}"
    [[ "$vol_tail" =~ ^[0-9]+$ ]] && echo "$vol"
done)
SSHEOF
    fi
}

[[ $# -eq 1 ]] || usage

vmid="$1"
[[ "$vmid" =~ ^[0-9]+$ ]] || { log_msg "FATAL: vmid must be a number, got: $vmid"; exit 1; }
[[ $EUID -eq 0 || ${ARCHIVE_VM_TEST_NO_ROOT:-0} == "1" ]] || {
    log_msg "FATAL: Must run as root (use sudo)"
    exit 1
}

# --- Node-agnostic orchestration ---------------------------------------
# This script runs wherever it was invoked: storage-side work goes through
# on_storage (local when this IS the storage host) and compute-side work
# through on_compute (local when this IS the compute host). The old
# delegate-to-compute bounce is gone — an invocation on the storage host
# no longer round-trips to the compute host and back per disk.

# --- The VM must already be stopped; archive-vm never stops it ---
vm_status=$(on_compute "$vmid" << 'CPEOF'
qm status "$1" 2>/dev/null | awk '{print $2}'
CPEOF
)
[[ "$vm_status" == "stopped" ]] || {
    log_msg "FATAL: VM ${vmid} is not stopped (status: ${vm_status:-unknown})."
    log_msg "FATAL: The VM must be stopped before it can be archived."
    log_msg "FATAL: Stop the VM (e.g. 'qm stop ${vmid}' or the Proxmox GUI),"
    log_msg "FATAL: then re-run archive-vm."
    exit 1
}

log_msg "INFO: === archive-vm ==="
log_msg "INFO:   VM: ${vmid}"
echo ""

# =======================================================================
# Step 1: Discover clones
# =======================================================================

log_msg "INFO: --- Step 1: Discovering dependent clones ---"

if is_single_node; then
    # index() does a fixed-string substring test (no regex literals).
    clone_info=$(zfs list -H -o name,origin \
        | awk -v v="$vmid" 'index($2, "/proxmox/vm-" v "-disk-") {print $1 "\t" $2}')
else
    clone_info=$(on_storage "$vmid" << 'SSHEOF'
mydir="${ZFSUTILITIES_BIN_DIR:-$(realpath /usr/local/lib/zfsutilities/current/bin)}"
source "$mydir/bashinit"
bashinit

vmid="$1"
# index() does a fixed-string substring test (no regex literals).
zfs list -H -o name,origin \
    | awk -v v="$vmid" 'index($2, "/proxmox/vm-" v "-disk-") {print $1 "\t" $2}'
SSHEOF
    ) || { log_msg "FATAL: Clone discovery failed on ${storage_host}"; exit 1; }
fi

declare -A clone_vmids
if [[ -n "$clone_info" ]]; then
    # Pass 1: collect dependent clones (clone zvol, clone VMID, origin),
    # skipping clones that belong to the VM being archived itself.
    clone_records=""
    while IFS=$'\t' read -r zvol origin; do
        # Extract the VM ID from a zvol path via parameter expansion.
        # Example: "threeamigos/proxmox/vm-105-disk-0" -> "105"
        clone_vmid=""
        if [[ "$zvol" == *"/proxmox/vm-"*"-disk-"* ]]; then
            vm_part="${zvol#*"/proxmox/vm-"}"
            clone_vmid="${vm_part%%-disk-*}"
            [[ "$clone_vmid" =~ ^[0-9]+$ ]] || clone_vmid=""
        fi
        if [[ -n "$clone_vmid" && "$clone_vmid" != "$vmid" ]]; then
            clone_vmids["$clone_vmid"]=1
            clone_records+="${zvol}"$'\t'"${clone_vmid}"$'\t'"${origin}"$'\n'
        fi
    done <<< "$clone_info"

    if [[ -n "$clone_records" ]]; then
        # Pass 2: report each VM disk with the clones that depend on it,
        # grouped by the origin dataset (the disk the clone was made from).
        log_msg "INFO:   Found disks with dependent clones:"
        declare -A reported_disks=()
        while IFS=$'\t' read -r zvol clone_vmid origin; do
            [[ -n "$zvol" ]] || continue
            origin_disk="${origin%%@*}"
            if [[ -z "${reported_disks[$origin_disk]:-}" ]]; then
                reported_disks["$origin_disk"]=1
                log_msg "INFO:     Disk ${origin_disk}:"
            fi
            log_msg "INFO:       clone VM ${clone_vmid}: ${zvol}"
            log_msg "INFO:         origin: ${origin}"
        done <<< "$clone_records"
        echo ""

        # One prompt string via a needle variable: backslash-continued
        # quoted strings would arrive as separate ask_yn arguments (the
        # second is ask_yn's default-answer parameter).
        sever_prompt="Do you want this script to sever these clones"
        sever_prompt+=" (copy them into origin-free zvols)?"
        if ask_yn "$sever_prompt"; then
            # Severance copies each clone zvol in full and swaps the fresh
            # copy in under the original name, so every owning clone VM must
            # already be stopped before any severance work starts.
            for clone_vmid in "${!clone_vmids[@]}"; do
                clone_status=$(qm status "$clone_vmid" 2>/dev/null | awk '{print $2}')
                [[ "$clone_status" == "stopped" ]] || {
                    log_msg "FATAL: Clone VM ${clone_vmid} is not stopped" \
                        "(status: ${clone_status:-unknown})."
                    log_msg "FATAL: Severance copies the clone zvols in full and swaps"
                    log_msg "FATAL: them in under the same names, so the clone VM must be"
                    log_msg "FATAL: stopped. Stop clone VM ${clone_vmid}" \
                        "(e.g. 'qm stop ${clone_vmid}' or the Proxmox GUI)," \
                        "then re-run archive-vm."
                    exit 1
                }
            done
            for clone_vmid in "${!clone_vmids[@]}"; do
                echo ""
                log_msg "INFO: Severing VM ${clone_vmid}..."
                sever_vm_clone=$(find_zfsutility_script sever-vm-clone)
                "$sever_vm_clone" "$clone_vmid" \
                    || { log_msg "FATAL: Severance failed for VM ${clone_vmid}"; exit 1; }
            done
        else
            log_msg "INFO:   Skipping clone severance."
            log_msg "WARN: VM removal may fail while snapshots are held by" \
                "clones; sever them first with sever-vm-clone."
        fi
    else
        log_msg "INFO:   No dependent clones found."
    fi
else
    log_msg "INFO:   No dependent clones found."
fi
echo ""

# =======================================================================
# Step 2: Archive
# =======================================================================

log_msg "INFO: --- Step 2: Archiving VM ${vmid} ---"

# Always prompt for archive base path
configured_path=$(get_json_archive_path)
if [[ -n "$configured_path" ]]; then
    default_prompt=" [$configured_path]"
else
    default_prompt=""
fi

read -rp "$(build_archive_prompt "$default_prompt")" user_path
archive_base="${user_path:-$configured_path}"

[[ -n "$archive_base" ]] || { log_msg "FATAL: Archive base path is required"; exit 1; }

# Validate the base exists as a ZFS dataset
if is_single_node; then
    if ! zfs list -H -o name "$archive_base" >/dev/null 2>&1; then
        { log_msg "FATAL: Not a ZFS dataset: $archive_base"; exit 1; }
    fi
else
    if ! ssh -n root@"$storage_host" "zfs list -H -o name '$archive_base'" \
            >/dev/null 2>&1; then
        { log_msg "FATAL: Not a ZFS dataset on $storage_host: $archive_base"; exit 1; }
    fi
fi

# Save the path back to JSON (in case it changed or was empty)
if [[ "$archive_base" != "$configured_path" ]]; then
    save_json_config_key archive_path "$archive_base"
    log_msg "INFO:   ✓ Saved archive path to JSON config"
fi

# Always prompt for the transfer rate limit (shared JSON key with
# unarchive-vm; empty = unlimited). The saved value is the default, so an
# archive run never saturates a small storage host by accident twice.
configured_rate=$(get_json_archive_rate_limit)
rate_default=""
[[ -n "$configured_rate" ]] && rate_default=" [${configured_rate}]"
ask_line "Transfer rate limit (e.g. 100M; empty = unlimited)${rate_default}: " \
    user_rate
archive_rate="${user_rate:-$configured_rate}"
if ! archive_valid_rate "$archive_rate"; then
    log_msg "FATAL: Invalid rate limit '${archive_rate}' — use a rate value"
    log_msg "FATAL: such as 100M or 500KiB, or leave it empty for unlimited"
    exit 1
fi
# shellcheck disable=SC2034  # used by on_storage/on_compute and lib functions
transfer_rate_limit="$archive_rate"
if [[ "$archive_rate" != "$configured_rate" ]]; then
    save_json_config_key archive_rate_limit "$archive_rate"
    log_msg "INFO:   ✓ Saved transfer rate limit to JSON config"
fi

# Get mountpoint of the base dataset
if is_single_node; then
    archive_mount=$(zfs get -H -o value mountpoint "$archive_base")
else
    archive_mount=$(ssh -n root@"$storage_host" \
        "zfs get -H -o value mountpoint '$archive_base'")
fi

proxmoxconfig="${pve_conf_dir}/${vmid}.conf"
[[ -f "$proxmoxconfig" ]] || { log_msg "FATAL: Proxmox config not found: $proxmoxconfig"; exit 1; }

# Find only the zvols actually referenced by the VM config.
zvols=$(collect_referenced_zvols | sort -u) \
    || { log_msg "FATAL: Failed to discover referenced zvols"; exit 1; }
[[ -n "$zvols" ]] || { log_msg "FATAL: No referenced zvols found for VM ${vmid}"; exit 1; }

log_msg "INFO:   Archive base: ${archive_base} (mount: ${archive_mount})"
log_msg "INFO:   Zvols to archive:"
while IFS= read -r _zvol; do
    log_msg "INFO:     ${_zvol}"
done <<< "$zvols"
echo ""

if ! ask_yn "Proceed with archive?"; then
    log_msg "INFO: Aborted."
    exit 0
fi

# Archive each zvol. Re-runs are idempotent: a per-disk archive that
# already carries its post-verification @archive snapshot is skipped, and
# an unverified leftover from an interrupted run is removed and re-made.
for zvol in $zvols; do
    snap=$(ensure_retire_snapshot "$zvol")
    # ensure_retire_snapshot logs the specific failure before exiting its
    # subshell; an empty result means the failure has already been reported.
    if [[ -z "$snap" || "$snap" == __ARCHIVE_VM_ERROR__ ]]; then
        exit 1
    fi
    snap_name="@${snap##*@}"
    archive_dataset="${archive_base}/${zvol}"

    log_msg "INFO:   Snapshot to archive: ${snap}"

    if is_single_node; then
        state=$(archive_completion_state "$archive_dataset" "$archive_mount" "$zvol")
        if [[ "$state" == "partial" ]]; then
            log_msg "WARN: Incomplete archive dataset from an interrupted run:"
            log_msg "WARN:   removing and re-archiving ${archive_dataset}"
            zfs destroy -r "$archive_dataset"
        elif [[ "$state" == "complete" ]]; then
            log_msg "INFO:   ✓ Already archived (verified) — skipping: ${archive_dataset}"
            # Back-fill the sidecar key lines a prior run may not have
            # appended (it can die between the transfer and this step).
            disk_key=$(disk_key_for_zvol "$zvol")
            if [[ -n "$disk_key" ]] && ! grep -q '^DISK_KEY=' \
                    "${archive_mount}/${zvol}.disk_info" 2>/dev/null; then
                echo "DISK_KEY=${disk_key}" >> "${archive_mount}/${zvol}.disk_info"
            fi
            log_msg "INFO:   ✓ Archived: ${archive_dataset}"
            continue
        fi
        log_msg "INFO:   Archiving ${zvol}${snap_name} → ${archive_dataset}"
        if ! archive_one_zvol "$zvol" "$snap_name" "$archive_dataset" \
                "$archive_mount"; then
            { log_msg "FATAL: Failed to archive ${zvol}"; exit 1; }
        fi

        # Append the disk's config key to the sidecar the engine started.
        disk_key=$(disk_key_for_zvol "$zvol")
        if [[ -n "$disk_key" ]]; then
            echo "DISK_KEY=${disk_key}" >> "${archive_mount}/${zvol}.disk_info"
        fi
    else
        # Two-node: archive work runs on the storage host via the shared
        # engine. The Proxmox config lives on this compute host and its
        # iscsi disk lines only name target/LUN, so key resolution needs
        # the config text on the storage host too — pass it base64-encoded
        # as one ssh argv token (a compute-host path is unreadable on the
        # storage host, and raw multi-line text cannot survive ssh argv
        # joining).
        config_b64=$(base64 -w0 "$proxmoxconfig")
        log_msg "INFO:   Archiving ${zvol}${snap_name} → ${archive_dataset}"
        if ! on_storage "$zvol" "$snap_name" \
                "$archive_dataset" "$archive_mount" "$vmid" "$config_b64" << 'SSHEOF'
mydir="${ZFSUTILITIES_BIN_DIR:-$(realpath /usr/local/lib/zfsutilities/current/bin)}"
source "$mydir/bashinit"
bashinit

engine=$(find_zfsutility_script archive-engine.sh)
[[ -n "$engine" ]] || {
    log_msg "FATAL: Could not locate archive-engine.sh on storage host"
    exit 1
}
source "$engine"

zvol="$1"
snap_name="$2"
archive_dataset="$3"
archive_mount="$4"
vmid="$5"
config_b64="$6"

# Re-run idempotency: a verified archive is skipped; an unverified leftover
# from an interrupted run is removed and re-made below.
state=$(archive_completion_state "$archive_dataset" "$archive_mount" "$zvol")
if [[ "$state" == "partial" ]]; then
    log_msg "WARN: Incomplete archive dataset from an interrupted run:"
    log_msg "WARN:   removing and re-archiving ${archive_dataset}"
    zfs destroy -r "$archive_dataset"
fi
if [[ "$state" == "complete" ]]; then
    log_msg "INFO:   ✓ Already archived (verified) — skipping: ${archive_dataset}"
else
    if ! archive_one_zvol "$zvol" "$snap_name" "$archive_dataset" \
            "$archive_mount"; then
        exit 1
    fi
fi

# Decode the compute host's Proxmox config for disk-key resolution.
config_text=$(printf '%s' "$config_b64" | base64 -d)

# Extract the disk number from the zvol path (e.g. "...disk-0" -> "0").
disknum=""
if [[ "$zvol" == *-disk-* ]]; then
    disknum="${zvol##*-disk-}"
    [[ "$disknum" =~ ^[0-9]+$ ]] || disknum=""
fi
backstore="vm-${vmid}-disk-${disknum}"

# Find target and LUN for this backstore
target=""
lun=""
# Extract IQN strings from targetcli output: each target name is a whole
# whitespace-delimited token starting with "iqn." (targetcli separates the
# name from its dotted leader with a space).
for t in $(targetcli "/iscsi" ls 2>/dev/null | while IFS= read -r _t_line; do
    read -ra _t_words <<< "$_t_line"
    for _t in "${_t_words[@]}"; do
        case "$_t" in iqn.*) printf '%s\n' "$_t" ;; esac
    done
done | sort -u); do
    # Extract the LUN number for this backstore ("lun0" -> "0").
    # The luns-ls line reads "[block/<name> (/dev/...)]" — the name is
    # slash-prefixed, so anchor on "block/<name> " (trailing space). A
    # space-anchored pattern alone never matches, and an unanchored name
    # would also match disk-1's line when disk-10 exists.
    found_lun=$(targetcli "/iscsi/${t}/tpg1/luns" ls 2>/dev/null \
        | grep -F "block/${backstore} " \
        | grep -oE 'lun[0-9]+' \
        | head -1)
    found_lun="${found_lun#lun}"
    if [[ -n "$found_lun" ]]; then
        target="$t"
        lun="$found_lun"
        break
    fi
done

# Find disk key in config
if [[ -n "$target" && -n "$lun" ]]; then
    disk_key=""
    while IFS= read -r config_line; do
        key="${config_line%%:*}"
        trailing="${key##*[a-z]}"
        leading="${key%"$trailing"}"
        [[ -n "$leading" && "$leading" =~ ^[a-z]+$ && "$trailing" =~ ^[0-9]+$ ]] \
            || continue
        [[ "$config_line" == "$key:"* ]] || continue
        [[ "$config_line" == *"ip-"*":3260-iscsi-${target}-lun-${lun}"* ]] \
            || continue
        disk_key="$key"
        break
    done <<< "$config_text"
    if [[ -n "$disk_key" ]]; then
        info_file="${archive_mount}/${zvol}.disk_info"
        # Append each key line only when absent, so a skipped (already
        # archived) disk does not grow duplicate sidecar entries.
        grep -q '^DISK_KEY=' "$info_file" 2>/dev/null \
            || echo "DISK_KEY=${disk_key}" >> "$info_file"
        grep -q '^LUN=' "$info_file" 2>/dev/null \
            || echo "LUN=${lun}" >> "$info_file"
        grep -q '^TARGET=' "$info_file" 2>/dev/null \
            || echo "TARGET=${target}" >> "$info_file"
    fi
fi
SSHEOF
        then
            { log_msg "FATAL: Failed to archive ${zvol}"; exit 1; }
        fi
    fi

    log_msg "INFO:   ✓ Archived: ${archive_dataset}"
done

# Archive Proxmox config — mirror the full path under the base mountpoint
config_dest_mount="$(path_under_mount "$archive_mount" "$proxmoxconfig")"
if is_single_node; then
    mkdir -p "$(dirname "$config_dest_mount")"
    cp "$proxmoxconfig" "$config_dest_mount"
elif [[ "$my_host" == "$storage_host" ]]; then
    # Orchestrating on the storage host: fetch the config from the compute
    # host and write it into the (local) archive mount.
    mkdir -p "$(dirname "$config_dest_mount")"
    on_compute "$proxmoxconfig" << 'CPEOF' > "$config_dest_mount"
cat "$1"
CPEOF
else
    # Orchestrating on the compute host: push the config to the storage
    # host's archive mount.
    ssh -n root@"$storage_host" "mkdir -p '$(dirname "$config_dest_mount")'"
    scp -q "$proxmoxconfig" "root@${storage_host}:${config_dest_mount}"
fi
log_msg "INFO:   ✓ Config archived: ${proxmoxconfig}"
echo ""

# =======================================================================
# Step 3: Verify archive
# =======================================================================

log_msg "INFO: --- Step 3: Verifying archive ---"

errors=0
for zvol in $zvols; do
    archive_dataset="${archive_base}/${zvol}"
    if is_single_node; then
        if ! zfs list -H "$archive_dataset" >/dev/null 2>&1; then
            log_msg "FATAL: MISSING dataset: ${archive_dataset}"
            ((++errors))
        else
            size=$(zfs get -H -o value volsize "$archive_dataset")
            vbs=$(zfs get -H -o value volblocksize "$archive_dataset")
            method=$(archive_method_of "${archive_mount}/${zvol}.disk_info")
            expected_vbs=""
            if [[ "$method" == "copy" ]]; then
                expected_vbs="1M"
            elif [[ -f "${archive_mount}/${zvol}.original_volblocksize" ]]; then
                expected_vbs=$(cat "${archive_mount}/${zvol}.original_volblocksize")
            fi
            if [[ -n "$expected_vbs" && "$vbs" != "$expected_vbs" ]]; then
                log_msg "FATAL: Volblocksize mismatch on ${archive_dataset}: expected" \
                    "${expected_vbs}, got ${vbs}"
                ((++errors))
            else
                log_msg "INFO:   ✓ ${archive_dataset} (${size}, volblocksize ${vbs})"
            fi
        fi
    else
        if ! ssh -n root@"$storage_host" "zfs list -H '$archive_dataset'" \
                >/dev/null 2>&1; then
            log_msg "FATAL: MISSING dataset: ${archive_dataset}"
            ((++errors))
        else
            verify_out=$(ssh root@"$storage_host" bash -s \
                    "$archive_dataset" "$archive_mount" "$zvol" << 'SSHEOF'
archive_dataset="$1"
archive_mount="$2"
zvol="$3"
zfs get -H -o value volsize "$archive_dataset"
zfs get -H -o value volblocksize "$archive_dataset"
grep '^METHOD=' "${archive_mount}/${zvol}.disk_info" 2>/dev/null | cut -d= -f2
cat "${archive_mount}/${zvol}.original_volblocksize" 2>/dev/null
SSHEOF
            )
            mapfile -t vfields <<< "$verify_out"
            size="${vfields[0]:-}"
            vbs="${vfields[1]:-}"
            method="${vfields[2]:-raw}"
            expected_vbs=""
            if [[ "$method" == "copy" ]]; then
                expected_vbs="1M"
            elif [[ -n "${vfields[3]:-}" ]]; then
                expected_vbs="${vfields[3]}"
            fi
            if [[ -n "$expected_vbs" && "$vbs" != "$expected_vbs" ]]; then
                log_msg "FATAL: Volblocksize mismatch on ${archive_dataset}: expected" \
                    "${expected_vbs}, got ${vbs}"
                ((++errors))
            else
                log_msg "INFO:   ✓ ${archive_dataset} (${size}, volblocksize ${vbs})"
            fi
        fi
    fi
done

config_dest_mount="$(path_under_mount "$archive_mount" "$proxmoxconfig")"

if is_single_node; then
    if [[ ! -f "$config_dest_mount" ]] || [[ ! -s "$config_dest_mount" ]]; then
        log_msg "FATAL: Config archive missing or empty"
        ((++errors))
    else
        log_msg "INFO:   ✓ Config archive OK"
    fi
else
    if ! ssh -n root@"$storage_host" \
            "[[ -f '$config_dest_mount' && -s '$config_dest_mount' ]]"; then
        log_msg "FATAL: Config archive missing or empty"
        ((++errors))
    else
        log_msg "INFO:   ✓ Config archive OK"
    fi
fi

if [[ $errors -gt 0 ]]; then
    { log_msg "FATAL: Archive verification failed (${errors} errors). VM NOT removed."; exit 1; }
fi

echo ""
log_msg "INFO:   Archive verified."
echo ""

# =======================================================================
# Step 4: Optionally remove the VM
# =======================================================================

log_msg "INFO: --- Step 4: VM removal ---"

if ! ask_yn "Remove VM ${vmid}?"; then
    log_msg "INFO: VM ${vmid} preserved. Archive is under: ${archive_base}"
    exit 0
fi

# Every disk that survives removal is recorded: the Proxmox config is only
# deleted when all disks are gone, and a partial removal must never report
# success.
declare -a leftover_zvols=()

if is_single_node; then
    log_msg "INFO:   Removing disks..."
    zfsdelfs_path=$(find_zfsutility_script zfsdelfs)
    [[ -n "$zfsdelfs_path" ]] || {
        log_msg "FATAL: Could not locate zfsdelfs"
        exit 1
    }
    for zvol in $zvols; do
        log_msg "INFO:     Destroying ${zvol}..."
        # zfsdelfs deletes snapshot children (releasing their holds) before
        # the zvol itself — a bare `zfs destroy` refuses any VM disk that
        # dailybackup has snapshotted.
        if ! "$zfsdelfs_path" "$zvol" '' '' '' "autoproceed='Y'"; then
            log_msg "WARN: Could not destroy ${zvol}"
            leftover_zvols+=("$zvol")
        fi
    done
else
    log_msg "INFO:   Removing disks and iSCSI resources..."
    for zvol in $zvols; do
        # Extract disk number from zvol path (e.g. "...disk-0" -> "0").
        disknum=$(disk_number_from_zvol "$zvol")
        pool="${zvol%%/*}"
        log_msg "INFO:     Removing disk ${disknum} from pool ${pool}..."
        if [[ "$my_host" == "$storage_host" ]]; then
            # Orchestrating on the storage host: remove-vm-disk runs
            # directly — its confirm prompts appear on this terminal and
            # its own wrapper rescans the compute host.
            rmd_path=$(find_zfsutility_script remove-vm-disk)
            "$rmd_path" "$pool" "$vmid" "$disknum" --skip-rescan \
                || true
        else
            # Over ssh, -t gives the remote confirms a terminal — bash
            # suppresses read -p prompts when stdin is not a tty — and the
            # env prefix carries the numbered input-hold protocol across
            # the hop.
            remote_remove_vm_disk=$(remote_zfsutility_script "$storage_host" "remove-vm-disk")
            remote_cmd="$(input_hold_env_prefix)$remote_remove_vm_disk"
            remote_cmd+=" '$pool' '$vmid' '$disknum' --skip-rescan"
            ssh -t root@"$storage_host" "$remote_cmd" || true
        fi
        # remove-vm-disk exits 0 even when an operator declines its confirm,
        # so judge by outcome: the zvol must actually be gone.
        still_present=$(ssh -n root@"$storage_host" \
            "zfs list -H -o name '$zvol'" 2>/dev/null || true)
        if [[ -n "$still_present" ]]; then
            log_msg "WARN: ${zvol} was not removed"
            leftover_zvols+=("$zvol")
        fi
    done

    log_msg "INFO:   Rescanning iSCSI on ${compute_host}..."
    if ! on_compute << 'CPEOF'
mydir="${ZFSUTILITIES_BIN_DIR:-$(realpath /usr/local/lib/zfsutilities/current/bin)}"
rescan_path=$(find_zfsutility_script rescan-storage)
[[ -n "$rescan_path" ]] || exit 1
"$rescan_path"
CPEOF
    then
        log_msg "WARN: iSCSI rescan failed; run 'rescan-storage' manually"
    fi
fi

if [[ ${#leftover_zvols[@]} -gt 0 ]]; then
    log_msg "FATAL: VM removal incomplete — the following zvols remain:"
    for zvol in "${leftover_zvols[@]}"; do
        log_msg "FATAL:   ${zvol}"
    done
    log_msg "FATAL: The Proxmox config was NOT removed: ${proxmoxconfig}"
    log_msg "FATAL: The verified archive is safe under: ${archive_base}"
    log_msg "FATAL: Run 'remove-vm-disk <pool> ${vmid} <disk-num>' on this host"
    log_msg "FATAL: for each disk above, then delete ${proxmoxconfig}."
    exit 1
fi

# Remove Proxmox config
log_msg "INFO:   Removing Proxmox config..."
rm -f "$proxmoxconfig"

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   VM ${vmid} has been archived."
log_msg "INFO:   Archive: ${archive_base}"
