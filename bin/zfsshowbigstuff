#!/usr/bin/bash
set -euo pipefail
# Show the biggest or smallest datasets in the pool or dataset given in $1

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
rootcheck

usage() {
    log_msg "INFO: Usage: $0 <dataset> [largest|smallest] [count]"
    log_msg "INFO:   dataset   Pool or dataset to examine (required)."
    log_msg "INFO:   sequence  Sort order: 'largest' (default) or 'smallest'."
    log_msg "INFO:   count     Number of datasets to show for smallest (default: 5)."
}

if [[ $# -lt 1 ]]; then
    usage
    die "A dataset must be specified."
fi

target="${1}"
pool="$(echo "$target" | awk -F '/' '{print $1}')"

if [[ -n "${2:-}" ]]; then
    sequence="$2"
    if [[ "$sequence" != 'largest' && "$sequence" != 'smallest' ]]; then
        usage
        die "Sort option must be either 'largest' or 'smallest'."
    fi
else
    sequence='largest'
fi

if [[ -n "${3:-}" ]]; then
    numberofdatasets="$3"
else
    numberofdatasets=5
fi

log_msg "INFO: Sequence=${sequence}."
log_msg "INFO: Number of datasets=${numberofdatasets}."

zpool list -o name,size,alloc,free,freeing,ckpoint,frag,cap,health "$pool"
zfs get -o name,property,value recordsize "$target"

# Show top datasets for each sort column. head truncates the zfs list output,
# so append || true to keep set -e/o pipefail from aborting the loop after the
# first section when zfs list receives SIGPIPE.  stdbuf -oL forces line
# buffering so rows are not lost when stdout is a pipe.
sortbys=('used' 'usedds' 'usedsnap' 'written' 'quota' 'refer' 'refquota' 'reservation')
for sortby in "${sortbys[@]}"; do
    log_msg "INFO: Sorted by: $sequence $sortby"
    if [[ $sequence = 'largest' ]]; then
        stdbuf -oL zfs list -rt all -S "$sortby" \
            -o name,used,usedds,usedsnap,written,quota,refer,refquota,reservation "$target" \
            | head -n 5 || true
    elif [[ $sequence = 'smallest' ]]; then
        stdbuf -oL zfs list -rt all -s "$sortby" \
            -o name,used,usedds,usedsnap,written,quota,refer,refquota,reservation "$target" \
            | head -n "$numberofdatasets" || true
    else
        die "Unexpected sort sequence '${sequence}'."
    fi
done
