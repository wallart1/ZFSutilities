#!/usr/bin/bash
# move-vm-disk [--no-rename] <src-vmid> <src-disk-key> <dst-vmid> [dst-disk-key]
# Moves an existing iSCSI-backed (two-node) or ZFS-backed (single-node) VM disk
# from one VM to another. By default the underlying zvol is renamed to match the
# destination VMID, and the iSCSI backstore/lun are recreated with the new name.
# Use --no-rename to leave the zvol/backstore/lun unchanged and only move the
# Proxmox disk reference. The lun number is preserved whenever possible so
# compute-node by-path symlinks remain stable.
#
# Supports --continue and --rollback for recovery from interrupted moves.
#
# Install to: /usr/local/lib/zfsutilities/bin/move-vm-disk on BOTH the storage and compute hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"
state_dir="/tmp"
ISCSI_MANIFEST="/etc/rtslib-fb-target/expected-backstores.txt"
ISCSI_ENCRYPTED_CONF=\
"${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$ISCSI_ENCRYPTED_CONF" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    ISCSI_ENCRYPTED_CONF="/etc/iscsi-encrypted-luns.conf"
fi

# Build reverse target-short → pool lookup (two-node only)
declare -A target_pool=()
if is_two_node; then
    for _pool in "${!POOL_TARGET[@]}"; do
        target_pool["${POOL_TARGET[$_pool]}"]="$_pool"
    done
    unset _pool
fi

usage() {
    log_msg "INFO: Usage: move-vm-disk [--no-rename]"
    log_msg "INFO:          [--continue <state-file>|--rollback <state-file>]"
    log_msg "INFO:          <src-vmid> <src-disk-key> <dst-vmid> [dst-disk-key]"
    echo ""
    log_msg "INFO:   src-vmid      Source Proxmox VM ID"
    log_msg "INFO:   src-disk-key  Disk key in source VM (e.g. scsi0, scsi1, efidisk0)"
    log_msg "INFO:   dst-vmid      Destination Proxmox VM ID"
    log_msg "INFO:   dst-disk-key  Desired disk key in destination VM"
    log_msg "INFO:                   (optional; auto-selected if omitted)"
    echo ""
    log_msg "INFO: Options:"
    log_msg "INFO:   --no-rename               Move the disk reference only;"
    log_msg "INFO:                             do not rename the zvol"
    echo ""
    log_msg "INFO: Recovery options (use the state file path printed by the failed run):"
    log_msg "INFO:   --continue <state-file>   Resume an interrupted move"
    log_msg "INFO:   --rollback <state-file>   Revert a partially completed move"
    echo ""
    log_msg "INFO: Examples:"
    log_msg "INFO:   move-vm-disk 100 scsi1 200"
    log_msg "INFO:     # move scsi1 from VM 100 → next free scsi on VM 200"
    log_msg "INFO:   move-vm-disk 100 scsi1 200 scsi0"
    log_msg "INFO:     # move scsi1 from VM 100 → scsi0 on VM 200"
    echo ""
    log_msg "WARN: WARNING: Both VMs must be stopped before running this script."
    exit 1
}

# warn is provided by bashinit (sourced above).

# Manifest helpers (duplicated here to keep move-vm-disk self-contained)
# Returns 0 when a line of $2 starts with the literal prefix $1.
prefix_in_file() {
    local prefix="$1" file="$2" _line
    [[ -f "$file" ]] || return 1
    while IFS= read -r _line; do
        [[ "$_line" == "$prefix"* ]] && return 0
    done < "$file"
    return 1
}

manifest_remove() {
    local bsname="$1"
    if [[ -f "$ISCSI_MANIFEST" ]] && grep -qxF -- "$bsname" "$ISCSI_MANIFEST"; then
        grep -vxF -- "$bsname" "$ISCSI_MANIFEST" > "${ISCSI_MANIFEST}.new" || true
        mv "${ISCSI_MANIFEST}.new" "$ISCSI_MANIFEST"
        log_msg "INFO: ✓ Removed ${bsname} from expected-backstores manifest"
    fi
}

manifest_add() {
    local bsname="$1"
    if [[ -f "$ISCSI_MANIFEST" ]] && ! grep -qxF -- "$bsname" "$ISCSI_MANIFEST"; then
        echo "$bsname" >> "$ISCSI_MANIFEST"
        log_msg "INFO: ✓ Added ${bsname} to expected-backstores manifest"
    fi
}

encrypted_remove() {
    local bsname="$1"
    if [[ -f "$ISCSI_ENCRYPTED_CONF" ]] \
        && prefix_in_file "${bsname}:" "$ISCSI_ENCRYPTED_CONF"; then
        awk -v prefix="${bsname}:" 'index($0, prefix) != 1' "$ISCSI_ENCRYPTED_CONF" \
            > "${ISCSI_ENCRYPTED_CONF}.new"
        mv "${ISCSI_ENCRYPTED_CONF}.new" "$ISCSI_ENCRYPTED_CONF"
        log_msg "INFO: ✓ Removed ${bsname} from encrypted LUNs config"
    fi
}

encrypted_add() {
    local bsname="$1" zvol_dev="$2" target_short="$3"
    if [[ -f "$ISCSI_ENCRYPTED_CONF" ]] \
        && ! prefix_in_file "${bsname}:" "$ISCSI_ENCRYPTED_CONF"; then
        echo "${bsname}:${zvol_dev}:${target_short}" >> "$ISCSI_ENCRYPTED_CONF"
        log_msg "INFO: ✓ Added ${bsname} to encrypted LUNs config"
    fi
}

# State file helpers
state_file_path() {
    local src="$1" dst="$2"
    echo "${state_dir}/move-vm-disk-${src}-${dst}-$(date +%s).state"
}

write_state() {
    local file="$1"
    cat > "$file" <<EOF
srcvmid=$srcvmid
srckey=$srckey
dstvmid=$dstvmid
dstkey=$dstkey
srczvol=$srczvol
dstzvol=$dstzvol
srcbackstore=$srcbackstore
dstbackstore=$dstbackstore
target=$target
targetshort=$targetshort
pool=$pool
srclun=$srclun
dstlun=$dstlun
phase=$phase
encrypted=$encrypted
no_rename=$no_rename
EOF
}

read_state() {
    local file="$1"
    [[ -f "$file" ]] || {
        log_msg "FATAL: State file not found: $file"
        exit 1
    }
    # shellcheck source=/dev/null
    source "$file"
}

update_phase() {
    local new_phase="$1"
    phase="$new_phase"
    write_state "$state_file"
}

# Determine the destination disk number from the disk key.
# The disk number matches the numeric suffix of the disk key (scsi2 -> 2).
disk_num_from_key() {
    local key="$1"
    local num="${key##*[a-z]}"
    [[ "$num" =~ ^[0-9]+$ ]] || {
        log_msg "FATAL: Could not derive disk number from ${key}"
        exit 1
    }
    echo "$num"
}

# Auto-select the next free disk key of the same bus type.
auto_select_dst_key() {
    local bus="${srckey%%[0-9]*}"
    local n=0
    if [[ "$bus" == "efidisk" ]]; then
        grep -q "^efidisk0:" "$dst_conf" && {
            log_msg "FATAL: Destination VM $dstvmid already has an efidisk0"
            exit 1
        }
        echo "efidisk0"
        return
    fi
    while grep -q "^${bus}${n}:" "$dst_conf"; do
        n=$((n + 1))
    done
    echo "${bus}${n}"
}

# Validate that the destination zvol name is free.
check_dst_zvol_free() {
    if ssh -o ConnectTimeout=10 root@"$storage_host" \
            "zfs list -H -o name '${dstzvol}' >/dev/null 2>&1"; then
        log_msg "FATAL: Destination zvol already exists: ${dstzvol}"
        exit 1
    fi
}

# Storage-node operations for two-node mode.
# All output is echoed back to the compute host for state capture.
storage_move_script() {
    cat <<'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

set -e
srczvol="$1"; dstzvol="$2"
srcbackstore="$3"; dstbackstore="$4"
target="$5"; srclun="$6"; encrypted="$7"
ISCSI_MANIFEST="/etc/rtslib-fb-target/expected-backstores.txt"
ISCSI_ENCRYPTED_CONF=\
"${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$ISCSI_ENCRYPTED_CONF" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    ISCSI_ENCRYPTED_CONF="/etc/iscsi-encrypted-luns.conf"
fi

manifest_remove() {
    [[ -f "$ISCSI_MANIFEST" ]] || return 0
    grep -qxF -- "$1" "$ISCSI_MANIFEST" || return 0
    grep -vxF -- "$1" "$ISCSI_MANIFEST" > "${ISCSI_MANIFEST}.new" || true
    mv "${ISCSI_MANIFEST}.new" "$ISCSI_MANIFEST"
}
manifest_add() {
    [[ -f "$ISCSI_MANIFEST" ]] || return 0
    grep -qxF -- "$1" "$ISCSI_MANIFEST" || echo "$1" >> "$ISCSI_MANIFEST"
}
# Returns 0 when a line of $2 starts with the literal prefix $1.
prefix_in_file() {
    local prefix="$1" file="$2" _line
    [[ -f "$file" ]] || return 1
    while IFS= read -r _line; do
        [[ "$_line" == "$prefix"* ]] && return 0
    done < "$file"
    return 1
}
encrypted_remove() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] || return 0
    prefix_in_file "$1:" "$ISCSI_ENCRYPTED_CONF" || return 0
    awk -v prefix="$1:" 'index($0, prefix) != 1' "$ISCSI_ENCRYPTED_CONF" \
        > "${ISCSI_ENCRYPTED_CONF}.new"
    mv "${ISCSI_ENCRYPTED_CONF}.new" "$ISCSI_ENCRYPTED_CONF"
}
encrypted_add() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] || return 0
    prefix_in_file "$1:" "$ISCSI_ENCRYPTED_CONF" \
        || echo "${1}:${2}:${3}" >> "$ISCSI_ENCRYPTED_CONF"
}

zfslock_init
if ! zfslock_wait_or_resolve "$srczvol" "x" "move-vm-disk source"; then
    log_msg "FATAL: Could not acquire destroy lock on source zvol ${srczvol}"
    exit 1
fi
lock_src="$zfslock_id"
if ! zfslock_wait_or_resolve "$dstzvol" "x" "move-vm-disk destination"; then
    zfslock_release "$lock_src"
    log_msg "FATAL: Could not acquire destroy lock on destination zvol ${dstzvol}"
    exit 1
fi
lock_dst="$zfslock_id"

# 1. Remove old lun and backstore.
echo "phase=teardown_done"
if targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null | grep -qF " ${srcbackstore} "; then
    targetcli "/iscsi/${target}/tpg1/luns" delete "lun${srclun}"
fi
if targetcli /backstores/block ls 2>/dev/null | grep -qF " ${srcbackstore} "; then
    targetcli /backstores/block delete "${srcbackstore}"
fi
manifest_remove "${srcbackstore}"
encrypted_remove "${srcbackstore}"

# 2. Rename zvol.
echo "phase=rename_done"
zfs rename "${srczvol}" "${dstzvol}"

# 3. Create new backstore.
echo "phase=backstore_done"
zvol_dev="/dev/zvol/${dstzvol}"
# Wait briefly for device node after rename.
for i in $(seq 1 20); do
    [[ -b "$zvol_dev" ]] && break
    sleep 0.5
done
[[ -b "$zvol_dev" ]] || { log_msg "FATAL: device node not found: $zvol_dev"; exit 1; }
targetcli /backstores/block create "${dstbackstore}" "${zvol_dev}"
targetcli "/backstores/block/${dstbackstore}" set attribute emulate_tpu=1

# 4. Create new lun, reusing the original lun number if possible.
echo "phase=lun_done"
dstlun="$srclun"
if ! targetcli "/iscsi/${target}/tpg1/luns" \
        create "/backstores/block/${dstbackstore}" "${dstlun}" 2>/dev/null; then
    # Slot was taken; let targetcli assign a new one.
    targetcli "/iscsi/${target}/tpg1/luns" create "/backstores/block/${dstbackstore}"
    # Strip everything through the first "lun" token and keep the leading
    # digits of the matching line ("... lun3 [block/..." -> "3").
    dstlun=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
        | grep -F "${dstbackstore}" \
        | while IFS= read -r _lun_line; do
            _lun_rest="${_lun_line#*lun}"
            printf '%s\n' "${_lun_rest%%[!0-9]*}"
        done \
        | head -1)
fi
echo "dstlun=${dstlun}"

# 5. Update manifests.
manifest_add "${dstbackstore}"
if [[ "$encrypted" == "Y" ]]; then
    targetshort="${target##*:}"
    encrypted_add "${dstbackstore}" "${zvol_dev}" "${targetshort}"
fi

# 6. Save config.
"$mydir/safe-iscsi-save"
echo "phase=saved"

zfslock_release "$lock_dst"
zfslock_release "$lock_src"
SSHEOF
}

# Perform storage-node move (two-node) or local rename (single-node).
run_storage_move() {
    if [[ "$no_rename" == "Y" ]]; then
        log_msg "INFO: --no-rename set; leaving zvol/backstore/lun unchanged"
        return
    fi

    if is_single_node; then
        zfslock_init
        if ! zfslock_wait_or_resolve "$srczvol" "x" "move-vm-disk source"; then
            log_msg "FATAL: Could not acquire destroy lock on source zvol ${srczvol}"
            exit 1
        fi
        lock_src="$zfslock_id"
        if ! zfslock_wait_or_resolve "$dstzvol" "x" "move-vm-disk destination"; then
            zfslock_release "$lock_src"
            log_msg "FATAL: Could not acquire destroy lock on destination zvol ${dstzvol}"
            exit 1
        fi
        lock_dst="$zfslock_id"

        log_msg "INFO: Renaming zvol ${srczvol} → ${dstzvol}..."
        zfs rename "${srczvol}" "${dstzvol}" || {
            zfslock_release "$lock_dst"
            zfslock_release "$lock_src"
            log_msg "FATAL: zfs rename failed"
            exit 1
        }
        zfslock_release "$lock_dst"
        zfslock_release "$lock_src"
        update_phase "rename_done"
        return
    fi

    log_msg "INFO: Performing storage-node move on ${storage_host}..."
    local result
    result=$(ssh -o ConnectTimeout=10 root@"$storage_host" bash -s \
        "$srczvol" "$dstzvol" "$srcbackstore" "$dstbackstore" "$target" "$srclun" "$encrypted" \
        <<< "$(storage_move_script)" 2>&1) || {
            log_msg "FATAL: Storage-node move failed"
            echo "$result"
            exit 1
        }

    # Parse phase progress and dstlun from remote output.
    local line
    while IFS= read -r line; do
        case "$line" in
            phase=*) phase="${line#phase=}"; write_state "$state_file" ;;
            dstlun=*) dstlun="${line#dstlun=}"; write_state "$state_file" ;;
        esac
    done <<< "$result"

    echo "$result"
}

# Rescan iSCSI on the compute host.
run_rescan() {
    if is_single_node; then
        return
    fi
    log_msg "INFO: Rescanning iSCSI..."
    "$mydir/rescan-storage"
}

# Move the disk line from source to destination VM config.
update_vm_configs() {
    log_msg "INFO: Updating VM configs..."

    # Remove from source config.
    sed -i "/^${srckey}:/d" "$src_conf"
    log_msg "INFO: ✓ Removed ${srckey} from VM ${srcvmid} config"

    # Build destination line by replacing only the key prefix.
    local dest_line="${dstkey}:${src_line#"${srckey}":}"
    echo "$dest_line" >> "$dst_conf"
    log_msg "INFO: ✓ Added ${dstkey} to VM ${dstvmid} config"
}

# Roll back a partially completed move.
rollback() {
    [[ -f "$state_file" ]] || {
        log_msg "FATAL: No state file provided for rollback."
        exit 1
    }
    no_rename="N"
    read_state "$state_file"

    src_conf="$pve_conf_dir/${srcvmid}.conf"
    dst_conf="$pve_conf_dir/${dstvmid}.conf"
    src_line=$(grep "^${srckey}:" "$src_conf" 2>/dev/null || true)

    log_msg "INFO: === Rolling back move-vm-disk ==="
    log_msg "INFO:   State file: $state_file"
    log_msg "INFO:   Phase: $phase"

    # Config rollback first (reverse order).
    if [[ "$phase" == "completed" || "$phase" == "config_done" ]]; then
        if [[ -f "$dst_conf" ]] && grep -q "^${dstkey}:" "$dst_conf"; then
            sed -i "/^${dstkey}:/d" "$dst_conf"
            log_msg "INFO: ✓ Removed ${dstkey} from VM ${dstvmid} config"
        fi
        if [[ -f "$src_conf" ]] && ! grep -q "^${srckey}:" "$src_conf" && [[ -n "$src_line" ]]; then
            echo "${srckey}:${src_line#"${srckey}":}" >> "$src_conf"
            log_msg "INFO: ✓ Restored ${srckey} to VM ${srcvmid} config"
        fi
    fi

    if [[ "$no_rename" == "Y" ]]; then
        log_msg "INFO: --no-rename was set; no storage-side changes to roll back"
    else
        if is_two_node; then
            # Storage rollback.
            ssh -o ConnectTimeout=10 root@"$storage_host" bash -s \
                "$srczvol" "$dstzvol" \
                "$srcbackstore" "$dstbackstore" \
                "$target" "$srclun" "$encrypted" \
                << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

set -e
srczvol="$1"; dstzvol="$2"
srcbackstore="$3"; dstbackstore="$4"
target="$5"; srclun="$6"; encrypted="$7"
ISCSI_MANIFEST="/etc/rtslib-fb-target/expected-backstores.txt"
ISCSI_ENCRYPTED_CONF=\
"${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$ISCSI_ENCRYPTED_CONF" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    ISCSI_ENCRYPTED_CONF="/etc/iscsi-encrypted-luns.conf"
fi

manifest_remove() {
    [[ -f "$ISCSI_MANIFEST" ]] || return 0
    grep -qxF -- "$1" "$ISCSI_MANIFEST" || return 0
    grep -vxF -- "$1" "$ISCSI_MANIFEST" > "${ISCSI_MANIFEST}.new" || true
    mv "${ISCSI_MANIFEST}.new" "$ISCSI_MANIFEST"
}
manifest_add() {
    [[ -f "$ISCSI_MANIFEST" ]] || return 0
    grep -qxF -- "$1" "$ISCSI_MANIFEST" || echo "$1" >> "$ISCSI_MANIFEST"
}
# Returns 0 when a line of $2 starts with the literal prefix $1.
prefix_in_file() {
    local prefix="$1" file="$2" _line
    [[ -f "$file" ]] || return 1
    while IFS= read -r _line; do
        [[ "$_line" == "$prefix"* ]] && return 0
    done < "$file"
    return 1
}
encrypted_remove() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] || return 0
    prefix_in_file "$1:" "$ISCSI_ENCRYPTED_CONF" || return 0
    awk -v prefix="$1:" 'index($0, prefix) != 1' "$ISCSI_ENCRYPTED_CONF" \
        > "${ISCSI_ENCRYPTED_CONF}.new"
    mv "${ISCSI_ENCRYPTED_CONF}.new" "$ISCSI_ENCRYPTED_CONF"
}
encrypted_add() {
    [[ -f "$ISCSI_ENCRYPTED_CONF" ]] || return 0
    prefix_in_file "$1:" "$ISCSI_ENCRYPTED_CONF" \
        || echo "${1}:${2}:${3}" >> "$ISCSI_ENCRYPTED_CONF"
}

# If new backstore/lun exist, tear them down.
if targetcli /backstores/block ls 2>/dev/null | grep -qF " ${dstbackstore} "; then
    # Strip everything through the first "lun" token and keep the leading
    # digits of the matching line ("... lun3 [block/..." -> "3").
    lun=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
        | grep -F "${dstbackstore}" \
        | while IFS= read -r _lun_line; do
            _lun_rest="${_lun_line#*lun}"
            printf '%s\n' "${_lun_rest%%[!0-9]*}"
        done \
        | head -1 || true)
    [[ -n "$lun" ]] && targetcli "/iscsi/${target}/tpg1/luns" delete "lun${lun}" 2>/dev/null || true
    targetcli /backstores/block delete "${dstbackstore}" 2>/dev/null || true
    manifest_remove "${dstbackstore}"
    encrypted_remove "${dstbackstore}"
fi

# Rename zvol back if it exists under the destination name.
zfslock_init
if zfs list -H -o name "${dstzvol}" >/dev/null 2>&1; then
    if ! zfslock_wait_or_resolve "$dstzvol" "x" "move-vm-disk rollback"; then
        log_msg "FATAL: Could not acquire destroy lock on ${dstzvol}"
        exit 1
    fi
    zfs rename "${dstzvol}" "${srczvol}"
    zfslock_release "$zfslock_id"
fi

# Recreate original backstore and lun if the source zvol exists.
zvol_dev="/dev/zvol/${srczvol}"
if [[ -b "$zvol_dev" ]]; then
    targetcli /backstores/block create "${srcbackstore}" "${zvol_dev}" 2>/dev/null || true
    targetcli "/backstores/block/${srcbackstore}" set attribute emulate_tpu=1 2>/dev/null || true
    targetcli "/iscsi/${target}/tpg1/luns" \
        create "/backstores/block/${srcbackstore}" "${srclun}" 2>/dev/null || true
    manifest_add "${srcbackstore}"
    if [[ "$encrypted" == "Y" ]]; then
        targetshort="${target##*:}"
        encrypted_add "${srcbackstore}" "${zvol_dev}" "${targetshort}"
    fi
    "$mydir/safe-iscsi-save" 2>/dev/null || true
fi
SSHEOF
        else
            # Single-node rollback.
            if zfs list -H -o name "${dstzvol}" >/dev/null 2>&1; then
                zfslock_init
                if ! zfslock_wait_or_resolve "$dstzvol" "x" "move-vm-disk rollback"; then
                    log_msg "FATAL: Could not acquire destroy lock on ${dstzvol}"
                    exit 1
                fi
                zfs rename "${dstzvol}" "${srczvol}"
                zfslock_release "$zfslock_id"
                log_msg "INFO: ✓ Renamed zvol back to ${srczvol}"
            fi
        fi

        if is_two_node; then
            log_msg "INFO: Rescanning iSCSI..."
            "$mydir/rescan-storage" 2>/dev/null || true
        fi
    fi

    rm -f "$state_file"
    log_msg "INFO: === Rollback complete ==="
}

# Validation helpers reused below and in unit tests.
_is_valid_vm_id() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

_is_valid_disk_key() {
    local key="$1" bus num
    bus="${key%%[0-9]*}"
    num="${key#"$bus"}"
    [[ -n "$bus" && -n "$num" && "$bus" =~ ^[a-z]+$ && "$num" =~ ^[0-9]+$ ]]
}

# --- Argument parsing ---
mode=""
state_file=""
no_rename="N"
pos_args=()
for _arg in "$@"; do
    case "$_arg" in
        --no-rename)
            no_rename="Y"
            ;;
        --continue|--rollback)
            mode="${_arg#--}"
            ;;
        -*)
            log_msg "FATAL: Unknown option: $_arg"
            usage
            ;;
        *)
            if [[ -n "$mode" && -z "$state_file" ]]; then
                state_file="$_arg"
            else
                pos_args+=("$_arg")
            fi
            ;;
    esac
done

if [[ -n "$mode" && -z "$state_file" ]]; then
    log_msg "FATAL: --${mode} requires a state-file argument"
    usage
fi

if [[ -n "$mode" ]]; then
    no_rename="N"
    if [[ "$mode" == "rollback" ]]; then
        rollback
        exit 0
    fi
    # Continue mode: read state, then fall through to main logic.
    read_state "$state_file"
    src_conf="$pve_conf_dir/${srcvmid}.conf"
    dst_conf="$pve_conf_dir/${dstvmid}.conf"
    src_line=$(grep "^${srckey}:" "$src_conf" 2>/dev/null || true)
else
    # Normal mode.
    [[ ${#pos_args[@]} -ge 3 && ${#pos_args[@]} -le 4 ]] || usage

    srcvmid="${pos_args[0]}"
    srckey="${pos_args[1]}"
    dstvmid="${pos_args[2]}"
    dstkey="${pos_args[3]:-}"

    _is_valid_vm_id "$srcvmid" || {
        log_msg "FATAL: src-vmid must be a number, got: $srcvmid"
        exit 1
    }
    _is_valid_vm_id "$dstvmid" || {
        log_msg "FATAL: dst-vmid must be a number, got: $dstvmid"
        exit 1
    }
    _is_valid_disk_key "$srckey" || {
        log_msg "FATAL: src-disk-key must be like scsi0 or ide1, got: $srckey"
        exit 1
    }
    [[ -z "$dstkey" ]] || _is_valid_disk_key "$dstkey" || {
        log_msg "FATAL: dst-disk-key must be like scsi0 or ide1, got: $dstkey"
        exit 1
    }

    state_file=$(state_file_path "$srcvmid" "$dstvmid")
    phase="started"
fi

# --- Recovery modes must run on the compute host (state file is local) ---
if is_two_node && [[ -n "$mode" && "$my_host" != "$compute_host" ]]; then
    log_msg "FATAL: --${mode} must be run directly on ${compute_host} (state file is local)."
    exit 1
fi

# --- Delegate to compute host if run on storage node (two-node only, normal mode only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "move-vm-disk")
    remote_args=()
    [[ "$no_rename" == "Y" ]] && remote_args+=("--no-rename")
    remote_args+=("${pos_args[0]}" "${pos_args[1]}" "${pos_args[2]}" "${pos_args[3]:-}")
    exec ssh -t root@"$compute_host" "$remote_script" "${remote_args[@]}"
fi

# === Running on the compute host ===

src_conf="$pve_conf_dir/${srcvmid}.conf"
dst_conf="$pve_conf_dir/${dstvmid}.conf"

[[ -f "$src_conf" ]] || {
    log_msg "FATAL: Source VM config not found: $src_conf"
    exit 1
}
[[ -f "$dst_conf" ]] || {
    log_msg "FATAL: Destination VM config not found: $dst_conf"
    exit 1
}

# --- VM state safety checks ---
src_status=$(qm status "$srcvmid" 2>/dev/null | awk '{print $2}')
dst_status=$(qm status "$dstvmid" 2>/dev/null | awk '{print $2}')

[[ "${src_status:-unknown}" == "stopped" ]] || {
    log_msg "FATAL: Source VM $srcvmid must be stopped (status: ${src_status:-unknown})"
    exit 1
}
[[ "${dst_status:-unknown}" == "stopped" ]] || {
    log_msg "FATAL: Destination VM $dstvmid must be stopped (status: ${dst_status:-unknown})"
    exit 1
}

# --- Parse source disk line ---
src_line=$(grep "^${srckey}:" "$src_conf" 2>/dev/null || true)
[[ -n "$src_line" ]] || {
    log_msg "FATAL: Disk key $srckey not found in VM $srcvmid config"
    exit 1
}

pool=""
target=""
targetshort=""
srczvol=""
srcbackstore=""
srclun=""
encrypted="N"

if is_two_node; then
    # by-path disk line: <key>: ...ip-<addr>:3260-iscsi-<iqn>:<target>-lun-<n>...
    marker="ip-${storage_ip}:3260-iscsi-${iqn_prefix}:"
    if [[ "$src_line" == "${srckey}:"*"$marker"* ]]; then
        _rest="${src_line##*"$marker"}"
        _targetshort="${_rest%%-lun-*}"
        _lun="${_rest#*-lun-}"
        _lun="${_lun%%[!0-9]*}"
        if [[ -n "$_lun" && -n "${target_pool[${_targetshort}]:-}" ]]; then
            targetshort="$_targetshort"
            srclun="$_lun"
        fi
    fi
    if [[ -n "$targetshort" ]]; then
        pool="${target_pool[$targetshort]}"
        target="${iqn_prefix}:${targetshort}"
    else
        log_msg "FATAL: Disk line for $srckey does not look like an iSCSI disk in VM $srcvmid:"
        log_msg "INFO:   $src_line"
        exit 1
    fi
else
    # ZFS-backed disk line: <key>: <pool>:vm-<vmid>-disk-<num>
    _rest="${src_line#"${srckey}":}"
    _pool=""
    if [[ "$_rest" != "$src_line" ]]; then
        _rest="${_rest#"${_rest%%[![:space:]]*}"}"
        _pool="${_rest%%:*}"
        if [[ -z "$_pool" || "$_rest" != "$_pool":vm-* ]]; then
            _pool=""
        else
            _base="${_rest#"$_pool":}"
            if [[ "$_base" == vm-*-disk-* ]]; then
                _mid="${_base#vm-}"
                _mid="${_mid%%-disk-*}"
                _tail="${_base##*-disk-}"
                _tail="${_tail%%[!0-9]*}"
                if [[ "$_mid" =~ ^[0-9]+$ && -n "$_tail" ]]; then
                    srcbackstore="vm-${_mid}-disk-${_tail}"
                else
                    _pool=""
                fi
            else
                _pool=""
            fi
        fi
    fi
    if [[ -n "$_pool" ]]; then
        pool="$_pool"
        srczvol=$(zfs list -H -t volume -o name -r "${pool}" 2>/dev/null \
            | while IFS= read -r _zvol; do
                  if [[ "$_zvol" == */"${srcbackstore}" ]]; then
                      printf '%s\n' "$_zvol"
                      break
                  fi
              done)
        [[ -n "$srczvol" ]] || {
            log_msg "FATAL: Could not find zvol ${srcbackstore} under pool ${pool}"
            exit 1
        }
    else
        log_msg "FATAL: Disk line for $srckey does not look like a ZFS-backed disk in VM $srcvmid:"
        log_msg "INFO:   $src_line"
        exit 1
    fi
fi

# --- Storage-node verification (two-node only) ---
if is_two_node; then
    [[ -n "$pool" ]] || {
        log_msg "FATAL: Could not determine pool from target short name: $targetshort"
        exit 1
    }

    storage_info=$(ssh -o ConnectTimeout=10 root@"$storage_host" \
        bash -s "$target" "$srclun" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

set -e
target="$1"
lun="$2"

backstore=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
    | while IFS= read -r _line; do
          # The lun number must not be followed by another digit (lun1 must
          # not match lun13).
          case "$_line" in
              *"lun${lun}"[!0-9]*)
                  _rest="${_line#*block/}"
                  if [[ "$_rest" != "$_line" ]]; then
                      printf '%s\n' "${_rest%%[[:space:]]*}"
                      break
                  fi
                  ;;
          esac
      done)
[[ -n "$backstore" ]] || { log_msg "FATAL:BACKSTORE_NOT_FOUND"; exit 1; }

zvol=$(zfs list -H -t volume -o name -r "${pool}" 2>/dev/null \
    | while IFS= read -r _zvol; do
          if [[ "$_zvol" == */"${backstore}" ]]; then
              printf '%s\n' "$_zvol"
              break
          fi
      done)
[[ -n "$zvol" ]] || { log_msg "FATAL:ZVOL_NOT_FOUND"; exit 1; }

size=$(zfs get -H -o value volsize "$zvol" 2>/dev/null || echo "unknown")
encrypted=$(zfs get -H -o value encryption "$zvol" 2>/dev/null || echo "off")
echo "$backstore $zvol $size $encrypted"
SSHEOF
    ) || {
        log_msg "FATAL: Storage verification failed on $storage_host"
        exit 1
    }

    srcbackstore=$(echo "$storage_info" | awk '{print $1}')
    srczvol=$(echo "$storage_info" | awk '{print $2}')
    zvol_size=$(echo "$storage_info" | awk '{print $3}')
    enc_value=$(echo "$storage_info" | awk '{print $4}')
    [[ "$enc_value" != "off" && "$enc_value" != "-" ]] && encrypted="Y"

    [[ "$srcbackstore" != ERROR:* ]] || {
        log_msg "FATAL: Could not find backstore for lun $srclun in target $targetshort"
        exit 1
    }
    [[ -n "$srczvol" ]] || {
        log_msg "FATAL: Could not determine zvol for backstore $srcbackstore"
        exit 1
    }
fi

# --- Determine destination disk key and number ---
if [[ -z "$dstkey" ]]; then
    dstkey=$(auto_select_dst_key)
fi

if grep -q "^${dstkey}:" "$dst_conf"; then
    log_msg "FATAL: Destination key $dstkey already exists in VM $dstvmid config"
    exit 1
fi

if [[ "$no_rename" == "Y" ]]; then
    dstbackstore="$srcbackstore"
    dstzvol="$srczvol"
else
    disknum=$(disk_num_from_key "$dstkey")
    dstbackstore="vm-${dstvmid}-disk-${disknum}"
    # Place the destination zvol in the same parent dataset as the source zvol.
    src_dataset="${srczvol%/*}"
    dstzvol="${src_dataset}/${dstbackstore}"

    check_dst_zvol_free
fi

# --- Write initial state file (normal mode only) ---
if [[ -z "$mode" ]]; then
    write_state "$state_file"
fi

# --- Confirm before making changes ---
if [[ "$phase" == "started" ]]; then
    log_msg "INFO: === move-vm-disk ==="
    log_msg "INFO:   Source:  VM ${srcvmid}, ${srckey}"
    log_msg "INFO:   Dest:    VM ${dstvmid}, ${dstkey}"
    if [[ "$no_rename" == "Y" ]]; then
        log_msg "INFO:   Zvol:    ${srczvol} (unchanged)"
    else
        log_msg "INFO:   Zvol:    ${srczvol} → ${dstzvol}"
    fi
    if is_two_node; then
        log_msg "INFO:   Size:    ${zvol_size}"
        log_msg "INFO:   lun:     ${srclun}"
    fi
    echo ""
    if [[ "$no_rename" == "Y" ]]; then
        log_msg "WARN: This will move the disk reference to VM ${dstvmid}"
        log_msg "INFO:   without renaming the underlying zvol."
    else
        log_msg "WARN: Both VMs must be stopped. This will rename the underlying zvol"
        log_msg "INFO:   and recreate the iSCSI backstore/lun to match VM ${dstvmid}."
    fi
    echo ""
    read -rp "Proceed? (y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; rm -f "$state_file"; exit 0; }
    echo ""
fi

# --- Execute the move ---
if [[ "$phase" == "started" ]]; then
    run_storage_move
fi

if is_two_node && [[ "$no_rename" != "Y" ]] && [[ -z "$dstlun" ]]; then
    # If continuing and dstlun wasn't captured, discover it now.
    # The while-loop body runs on the storage host: \$ keeps the remote
    # shell expanding _lun_line ("... lun3 [block/..." -> "3").
    dstlun=$(ssh -o ConnectTimeout=10 root@"$storage_host" \
        "targetcli \"/iscsi/${target}/tpg1/luns\" ls 2>/dev/null" \
        " | grep -F '${dstbackstore}'" \
        " | while IFS= read -r _lun_line; do" \
        "     _lun_rest=\"\${_lun_line#*lun}\";" \
        "     printf '%s\\n' \"\${_lun_rest%%[!0-9]*}\";" \
        " done | head -1")
    [[ -n "$dstlun" ]] || {
        log_msg "FATAL: Could not determine new lun number for ${dstbackstore}"
        exit 1
    }
    write_state "$state_file"
fi

if [[ "$phase" != "completed" && "$phase" != "config_done" ]]; then
    update_vm_configs
    update_phase "config_done"
fi

if [[ "$phase" != "completed" ]]; then
    run_rescan
    update_phase "completed"
fi

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   Disk moved: VM ${srcvmid} ${srckey} → VM ${dstvmid} ${dstkey}"
log_msg "INFO:   State file: $state_file"
