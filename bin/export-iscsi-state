#!/usr/bin/bash
# export-iscsi-state
# Record the live iSCSI LUN topology as a pool-resident state map.
#
# A storage-host bare-metal restore regresses /etc/rtslib-fb-target (both
# saveconfig.json and expected-backstores.txt live on the OS disk) while the
# pools re-import current: LUNs created after the backup point vanish and
# repair-iscsi-luns cannot restore them because the manifest regressed with
# the same disk. This script writes the authoritative LUN map — per-target
# LUN → backstore, per-backstore zvol device, ACL initiators, the configured
# pools' GUIDs (pool-identity fence: a renamed or replaced pool reuses a
# name but never a GUID), plus a copy of node.conf — onto every online pool
# at <pool>/zfsutilities/, so any surviving pool can serve recovery.
#
# safe-iscsi-save invokes this script after every successful save, keeping
# the map as fresh as the last LUN change. Pool-wide snapshot/retention
# policies provide the history: the zfsutilities dataset is an ordinary
# child dataset of each pool, so policies without explicit includes pick it
# up automatically.
#
# Usage: sudo export-iscsi-state [--check] [--force] [--print-map]
#   --check   Compare live state against the newest map found on any pool and
#             report drift (manual targetcli edits since the last export).
#             Exits 0 on match, 3 when all drift is keys-pending (every
#             missing-live LUN traces to a locked encrypted dataset — the
#             expected keys-absent-boot shape), 1 on any other drift.
#   --force   Record the live state even when it is degraded (fewer active
#             backstores than the manifest expects) or would drop LUN
#             mappings the newest pool map still records while their
#             backstores remain in the manifest.
#   --print-map
#             Print the newest pool-resident map to stdout, read-only. The
#             compute host fetches the recovery map over ssh this way
#             (repair-vm-disk-refs); no live state is collected and nothing
#             is written.
#
# Install to: /usr/local/lib/zfsutilities/bin/export-iscsi-state on the storage host

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${EXPORT_ISCSI_STATE_NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

# Shared targetcli/zvol parsers (is_vm_backstore_name, parse_backstores,
# parse_target_luns, parse_target_acls, discover_zvols).
ISCSI_LIB="${EXPORT_ISCSI_STATE_ISCSI_LIB:-$(find_zfsutility_script iscsi-lib.sh)}"
source "$ISCSI_LIB"

source_helper rootcheck

rootcheck

# iSCSI-only script — exit silently in single-node mode
is_single_node && exit 0

usage() {
    log_msg "INFO: Usage: export-iscsi-state [--check] [--force] [--print-map]"
    echo ""
    log_msg "INFO:   --check     Compare live state to the newest pool-resident map and report"
    log_msg "INFO:               drift (manual targetcli edits since the last export);"
    log_msg "INFO:               exits 0 on match, 3 when all drift is keys-pending,"
    log_msg "INFO:               1 on any other drift"
    log_msg "INFO:   --force     Record a degraded live state over a healthy map (use with care)"
    log_msg "INFO:   --print-map Print the newest pool-resident map to stdout (read-only;"
    log_msg "INFO:               used by the compute host to fetch the recovery map)"
    exit 1
}

check_only=false
force_write=false
print_map=false
for arg in "$@"; do
    case "$arg" in
        --check) check_only=true ;;
        --force) force_write=true ;;
        --print-map) print_map=true ;;
        -h|--help) usage ;;
        *)
            log_msg "FATAL: Unknown option: $arg"
            usage
            ;;
    esac
done

my_host=$(hostname -s)

# Verify we're on the storage host
if [[ "$my_host" != "$storage_host" ]]; then
    log_msg "FATAL: Must run on the storage host ($storage_host), not $my_host"
    exit 1
fi

# Storage-node dependency: LIO target stack. The compute host needs Proxmox VE,
# but this script runs on the storage host and does not require a local qm
# binary. --print-map only reads pool files and skips this gate (the compute
# host's fetch must not depend on targetcli being installed there).
if [[ "$print_map" != true ]] && ! command -v targetcli >/dev/null 2>&1; then
    log_msg "FATAL: targetcli not found. Install the LIO target stack on this storage host."
    log_msg "FATAL:   On Debian/Ubuntu: apt-get install targetcli-fb"
    exit 1
fi

[[ $EUID -eq 0 ]] || [[ "${EXPORT_ISCSI_STATE_SKIP_ROOT:-}" == "Y" ]] || {
    log_msg "FATAL: Must run as root (use sudo)"
    exit 1
}

# Files written inside each pool's zfsutilities dataset. The map file name
# comes from the shared lib default (ISCSI_STATE_FILENAME) so discovery
# (newest_iscsi_state_map in lib/iscsi-lib.sh) and writes always agree.
STATE_FILENAME="${ISCSI_STATE_FILENAME}"
NODE_CONF_COPY_NAME="node.conf"

# Number of pools the state map was written to (set by write_state_to_pools).
pools_written=0

# ------------------------------------------------------------------
# Live state collection
# ------------------------------------------------------------------

# Collect the live LUN topology into the _state_* globals used by the JSON
# emitter:
#   _state_target_iqns[]     target IQNs (one per configured pool)
#   _state_luns[iqn]         "lun:backstore" lines for the target
#   _state_acls[iqn]         space-separated sorted initiator IQNs
#   _state_grants[iqn]       "<initiator>|<ml>:<tp> <ml>:<tp>" lines (one per
#                            initiator holding grants; the ACL grants
#                            dimension — mapped_lun -> tpg_lun pairs, so a
#                            non-identity grant survives a total wipe)
#   _state_bs_names[]        backstore names from the LIO backstore list
#   _state_bs_devs[bs]       zvol device path of the backstore
#   _state_bs_target[bs]     full IQN of the target that maps the backstore
#   _state_bs_lun[bs]        LUN index on that target (unset when unmapped)
#   _state_pool_guids[pool]  pool GUID (pool-identity fence; a pool whose
#                            GUID cannot be read is simply omitted — an
#                            offline pool must not fail or noise the export)
collect_live_state() {
    _state_target_iqns=()
    _state_bs_names=()
    unset -v _state_luns _state_acls _state_grants _state_bs_devs _state_bs_target \
        _state_bs_lun _state_pool_guids
    declare -gA _state_luns=() _state_acls=() _state_grants=() _state_bs_devs=() \
        _state_bs_target=() _state_bs_lun=() _state_pool_guids=()

    local pool iqn name entries guid grants init
    while IFS= read -r pool; do
        [[ -z "$pool" ]] && continue
        iqn=$(pool_to_target "$pool") || continue
        _state_target_iqns+=("$iqn")

        guid=$(zpool get -H -o value guid "$pool" 2>/dev/null) || guid=""
        [[ -n "$guid" && "$guid" != *[!0-9]* ]] && _state_pool_guids["$pool"]="$guid"

        entries=""
        parse_target_luns "$iqn"
        for name in "${!_lun_indexes[@]}"; do
            entries+="${_lun_indexes[$name]}:${name}"$'\n'
            _state_bs_target["$name"]="$iqn"
            _state_bs_lun["$name"]="${_lun_indexes[$name]}"
        done
        _state_luns["$iqn"]="$entries"

        parse_target_acls "$iqn"
        _state_acls["$iqn"]="${_acl_initiators[*]}"
        grants=""
        for init in "${_acl_initiators[@]}"; do
            [[ -n "${_acl_grants_of[$init]:-}" ]] || continue
            grants+="${init}|${_acl_grants_of[$init]% }"$'\n'
        done
        _state_grants["$iqn"]="$grants"
    done < <(pool_list)

    parse_backstores
    _state_bs_names=("${_bs_names[@]}")
    for name in "${_bs_names[@]}"; do
        _state_bs_devs["$name"]="${_bs_devs[$name]}"
    done
}

# Print the state map as JSON on stdout. Every interpolated value (IQNs,
# backstore names, zvol device paths, IPs, hostnames) is restricted to the
# iSCSI/config alphabets ([A-Za-z0-9.:_/-]) — no JSON escaping is required.
# Sections are emitted sorted so repeated runs against unchanged state are
# byte-identical (apart from the generated timestamp).
emit_state_json() {
    printf '{\n'
    printf '  "version": 2,\n'
    printf '  "generated": "%s",\n' "$(date -Iseconds)"
    printf '  "host": "%s",\n' "$my_host"
    printf '  "iqn_prefix": "%s",\n' "$iqn_prefix"
    printf '  "storage_ip": "%s",\n' "$storage_ip"

    local iqn name line init pr
    local -a tblocks=() litems=() aitems=() gitems=() bblocks=() pitems=()
    local -A pair_of=()

    # Pool identity at export time: name -> GUID. The recorded GUID is what
    # the pool-identity fence compares against later (a renamed or replaced
    # pool reuses a name but never a GUID). Pools whose GUID could not be
    # read are absent by design.
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        pitems+=("    \"${name}\": \"${_state_pool_guids[$name]}\"")
    done < <(printf '%s\n' "${!_state_pool_guids[@]}" | sort -u)

    while IFS= read -r iqn; do
        [[ -z "$iqn" ]] && continue
        litems=()
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            litems+=("      \"${line%%:*}\": \"${line#*:}\"")
        done < <(printf '%s' "${_state_luns[$iqn]}" | sort -n -t: -k1,1)
        # ACL grants dimension: initiator -> {mapped_lun: tpg_lun}. The
        # recorded pairs are what a map-driven rebuild recreates exactly —
        # a non-identity grant (mapped_lun 8 -> tpg_lun 0) otherwise
        # dissolves to identity on every rebuild path.
        pair_of=()
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            pair_of["${line%%|*}"]="${line#*|}"
        done < <(printf '%s' "${_state_grants[$iqn]:-}")
        # Word splitting is intended: _state_acls holds space-separated IQNs,
        # and the IQN alphabet contains no whitespace or glob characters.
        # shellcheck disable=SC2206
        for init in ${_state_acls[$iqn]}; do
            [[ -n "${pair_of[$init]:-}" ]] || pair_of["$init"]=""
        done
        aitems=()
        while IFS= read -r init; do
            [[ -z "$init" ]] && continue
            gitems=()
            if [[ -n "${pair_of[$init]}" ]]; then
                # Word splitting is intended: the pairs string holds
                # space-separated ml:tp tokens, both all-digit.
                # shellcheck disable=SC2086
                while IFS= read -r pr; do
                    [[ -z "$pr" ]] && continue
                    gitems+=("          \"${pr%%:*}\": ${pr##*:}")
                done < <(printf '%s\n' ${pair_of[$init]} | sort -n -t: -k1,1)
            fi
            aitems+=("        \"${init}\": {
$(json_join_args "${gitems[@]}")
        }")
        done < <(printf '%s\n' "${!pair_of[@]}" | sort -u)
        tblocks+=("    \"${iqn}\": {
      \"acls\": {
$(json_join_args "${aitems[@]}")
      },
      \"luns\": {
$(json_join_args "${litems[@]}")
      }
    }")
    done < <(printf '%s\n' "${_state_target_iqns[@]}" | sort -u)

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        if [[ -n "${_state_bs_lun[$name]:-}" ]]; then
            bblocks+=("    \"${name}\": {
      \"dev\": \"${_state_bs_devs[$name]}\",
      \"target\": \"${_state_bs_target[$name]}\",
      \"lun\": ${_state_bs_lun[$name]}
    }")
        else
            # Backstore loaded but not mapped to any LUN: record the device
            # only, without target/lun keys.
            bblocks+=("    \"${name}\": {
      \"dev\": \"${_state_bs_devs[$name]}\"
    }")
        fi
    done < <(printf '%s\n' "${_state_bs_names[@]}" | sort -u)

    printf '  "pools": {\n%s\n  },\n' "$(json_join_args "${pitems[@]}")"
    printf '  "targets": {\n%s\n  },\n' "$(json_join_args "${tblocks[@]}")"
    printf '  "backstores": {\n%s\n  }\n}\n' "$(json_join_args "${bblocks[@]}")"
}

# Print the arguments as JSON members/blocks, one per line, separated by
# commas. Arguments are pre-rendered (already quoted/indented) strings.
json_join_args() {
    local item out="" first=true
    for item in "$@"; do
        if [[ "$first" == true ]]; then
            first=false
        else
            out+=","$'\n'
        fi
        out+="$item"
    done
    printf '%s' "$out"
}

# ------------------------------------------------------------------
# Pool-resident state files
# ------------------------------------------------------------------

# Atomically install src at dst (staged temp file in the destination
# directory + mv, so a reader never sees a partial file).
install_state_file() {
    local src="$1" dst="$2" tmp
    tmp=$(mktemp "${dst}.tmp.XXXXXX") || {
        log_msg "WARN: Could not create a temp file next to ${dst} — skipped"
        return 1
    }
    if ! cp -f -- "$src" "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        log_msg "WARN: Could not stage ${dst} — skipped"
        return 1
    fi
    if ! mv -f -- "$tmp" "$dst"; then
        rm -f "$tmp"
        log_msg "WARN: Could not install ${dst} — skipped"
        return 1
    fi
    return 0
}

# Echo the mountpoint of <pool>/zfsutilities, creating the dataset on first
# use. Prints nothing and returns 1 when the dataset cannot be created or
# resolved to a usable mountpoint.
state_dataset_mountpoint() {
    local pool="$1" ds mnt
    ds="${pool}/zfsutilities"

    if ! zfs list -H -o name "$ds" >/dev/null 2>&1; then
        if ! zfs create "$ds" >/dev/null 2>&1; then
            log_msg "WARN: Could not create dataset ${ds} — pool ${pool} skipped"
            return 1
        fi
        log_msg "INFO:   ✓ Created dataset ${ds} (first use)"
    fi

    mnt=$(zfs list -H -o mountpoint "$ds" 2>/dev/null || true)
    if [[ -z "$mnt" || "$mnt" == "-" || ! -d "$mnt" ]]; then
        log_msg "WARN: Dataset ${ds} has no usable mountpoint (${mnt:-none}) —" \
            "pool ${pool} skipped"
        return 1
    fi
    printf '%s\n' "$mnt"
}

# Write the state map + node.conf copy onto every online pool. Sets
# pools_written to the number of pools that received both files.
write_state_to_pools() {
    local json_tmp="$1"
    local pool online mnt
    pools_written=0
    online=$(zpool list -Ho name 2>/dev/null || true)

    while IFS= read -r pool; do
        [[ -z "$pool" ]] && continue
        if ! grep -qxF -- "$pool" <<< "$online"; then
            log_msg "WARN: Pool ${pool} is offline — state map not written there"
            continue
        fi
        mnt=$(state_dataset_mountpoint "$pool") || continue
        if install_state_file "$json_tmp" "${mnt}/${STATE_FILENAME}" \
            && install_state_file "$NODE_CONF" "${mnt}/${NODE_CONF_COPY_NAME}"; then
            pools_written=$((pools_written + 1))
            log_msg "INFO:   ✓ State map written to ${pool}/zfsutilities"
        fi
    done < <(pool_list)
}

# ------------------------------------------------------------------
# Degraded-state fence
# ------------------------------------------------------------------

# Count valid backstore entries in the expected-backstores manifest
# (same shape validation as safe-iscsi-save: glob test plus fixed-string
# digit checks, no regex). Prints the count.
count_manifest_entries() {
    local entry mid end count=0
    [[ -f "$ISCSI_MANIFEST" ]] || {
        printf '0\n'
        return 0
    }
    while IFS= read -r entry; do
        [[ "$entry" == vm-*-disk-* ]] || continue
        mid="${entry#vm-}"; mid="${mid%%-disk-*}"
        end="${entry##*-disk-}"
        if [[ -n "$mid" && "$mid" != *[!0-9]* \
                && -n "$end" && "$end" != *[!0-9]* \
                && "${entry#*-disk-}" != *-disk-* ]]; then
            count=$((count + 1))
        fi
    done < "$ISCSI_MANIFEST"
    printf '%s\n' "$count"
}

# Compare the recorded map ($1) with the staged new state ($2) under the
# expected-backstores manifest ($3): a recorded (iqn,lun)->backstore mapping
# may disappear only when its backstore left the manifest (the intentional-
# change authority remove-vm-disk / move-vm-disk / archive maintain, and the
# manifest safe-iscsi-save regenerates before its export hook omits removed
# backstores). Any other loss is printed as a LOSS line and fails the check —
# counting backstores alone passes the degraded shape where every backstore
# is loaded but few are mapped. Modeled on report_state_drift.
report_map_losses() {
    python3 - "$1" "$2" "$3" << 'PYEOF'
import json, os, sys

def load(path):
    with open(path) as f:
        return json.load(f)

def valid_bs_name(name):
    # vm-<vmid>-disk-<N>: the same fixed-string shape the bash gates enforce
    if not name.startswith("vm-") or "-disk-" not in name:
        return False
    mid, _, end = name[3:].partition("-disk-")
    return mid.isdigit() and end.isdigit() and "-disk-" not in end

def manifest_expected(path):
    if not os.path.isfile(path):
        return None
    expected = set()
    with open(path) as f:
        for line in f:
            name = line.strip()
            if valid_bs_name(name):
                expected.add(name)
    return expected

try:
    old = load(sys.argv[1])
    new = load(sys.argv[2])
except Exception as exc:
    print("LOSS: could not parse the recorded map or the staged state (%s)" % exc)
    sys.exit(1)
expected = manifest_expected(sys.argv[3])
live_backstores = set(new.get("backstores", {}))

losses = []
for iqn, t in sorted(old.get("targets", {}).items()):
    old_luns = t.get("luns", {})
    new_luns = new.get("targets", {}).get(iqn, {}).get("luns", {})
    def lun_key(s):
        return int(s) if s.isdigit() else 1 << 30
    for idx in sorted(old_luns, key=lun_key):
        bs = old_luns[idx]
        if new_luns.get(idx) == bs:
            continue
        if expected is None:
            # No manifest at all (post-restore regression): the map is the
            # only authority, so no mapping may disappear.
            permitted = False
        elif not expected:
            # An empty manifest is legitimate only for the target-only
            # transition (mirrors safe-iscsi-save's stance); with backstores
            # still live it is a broken manifest.
            permitted = not live_backstores
        else:
            permitted = bs not in expected
        if not permitted:
            losses.append("target %s LUN %s -> %s" % (iqn, idx, bs))

for line in losses:
    print("LOSS: %s would be lost while still expected" % line)
sys.exit(1 if losses else 0)
PYEOF
}

# Refuse to record a live state that would drop still-expected LUN mappings
# from the pool map: a bare-metal restore boots with an empty or partial LIO
# tree, and overwriting the pool map then would destroy the recovery
# authority. The primary fence is the mapping-loss comparison against the
# newest pool-resident map; when no map exists yet (first export after
# install), the manifest-count floor from safe-iscsi-save's degraded guard
# applies instead. Returns 0 when the live state may be recorded.
enforce_not_degraded() {
    local json_tmp="$1"
    local live_count="$2"
    local map_file loss_out rc=0

    map_file=$(newest_iscsi_state_map || true)
    if [[ -n "$map_file" ]]; then
        loss_out=$(report_map_losses "$map_file" "$json_tmp" "$ISCSI_MANIFEST") || rc=$?
        [[ -n "$loss_out" ]] && printf '%s\n' "$loss_out"
        if [[ "$rc" -ne 0 ]]; then
            if [[ "$force_write" == true ]]; then
                log_msg "WARN: $(printf '%s\n' "$loss_out" | grep -c '^LOSS:') LUN mapping(s)" \
                    "would be lost while still expected — recording anyway (--force)"
            else
                log_msg "FATAL: Live state would drop still-expected LUN mapping(s)" \
                    "from the pool map (see LOSS lines)"
                log_msg "FATAL:   The pool state map was NOT overwritten."
                log_msg "FATAL:   Resolve the degradation, or rerun with --force to" \
                    "record it anyway."
                return 1
            fi
        fi
        return 0
    fi

    # No prior map on any pool: the manifest-count floor.
    local expected=""
    if [[ -f "$ISCSI_MANIFEST" ]]; then
        expected=$(count_manifest_entries)
    fi
    [[ -z "$expected" || "$expected" -eq 0 ]] && return 0

    if [[ "$live_count" -lt "$expected" ]]; then
        if [[ "$force_write" == true ]]; then
            log_msg "WARN: Live backstores (${live_count}) below expected (${expected}) —" \
                "recording anyway (--force)"
        else
            log_msg "FATAL: Live state is degraded (${live_count} of ${expected}" \
                "expected backstores active)"
            log_msg "FATAL:   The pool state map was NOT overwritten."
            log_msg "FATAL:   Resolve the degradation, or rerun with --force to record it anyway."
            return 1
        fi
    fi
    return 0
}

# ------------------------------------------------------------------
# Drift check
# ------------------------------------------------------------------

# Compare the live state ($2) with the recorded map ($1). Prints DRIFT lines
# and exits 0 when the recorded LUN topology matches live, 1 on any drift a
# locked key cannot explain, and 2 when every drift line is a map-recorded
# object missing live that traces to a map backstore — the keys-pending
# CANDIDATE. On exit 2 the report additionally carries one
# "KEYSUSPECT: <backstore>=<dataset>" line per implicated backstore (after
# the DRIFT lines) for the bash caller to probe with `zfs get keystatus`;
# only that probe turns the candidate into the keys-pending verdict (exit 3
# from main), because a locked key is the sole drift source the candidate
# covers and only live keystatus can attest the lock.
report_state_drift() {
    python3 - "$1" "$2" << 'PYEOF'
import json, sys

with open(sys.argv[1]) as f:
    old = json.load(f)
with open(sys.argv[2]) as f:
    new = json.load(f)

# Each entry is (drift line, suspect backstore or None): a suspect is the
# map backstore a missing-live line names, directly or through the LUN it
# backs. None marks a line no key state can explain (moved, extra-live,
# renamed, changed attribute, whole target gone) — one such line collapses
# the verdict back to plain drift.
drift = []

def acl_records(a):
    # Normalize the ACL section to {initiator: {ml: tp}}: the grants shape
    # is a dict of dicts; the legacy shape is a bare name list (maps written
    # before the grants dimension) and normalizes to names with no pairs.
    if isinstance(a, dict):
        return {k: v for k, v in a.items() if isinstance(v, dict)}
    if isinstance(a, list):
        return {name: {} for name in a}
    return {}

def grant_pairs(grants):
    # {str(ml): int(tp)} — the writer emits numeric tpg_lun values; anything
    # else is a malformed record, dropped rather than guessed.
    if not isinstance(grants, dict):
        return {}
    out = {}
    for ml, tp in grants.items():
        if isinstance(ml, str) and ml.isdigit() and isinstance(tp, int):
            out[ml] = tp
    return out

if old.get("iqn_prefix") != new.get("iqn_prefix"):
    drift.append(("iqn_prefix: map has %r, live has %r"
                  % (old.get("iqn_prefix"), new.get("iqn_prefix")), None))
if old.get("storage_ip") != new.get("storage_ip"):
    drift.append(("storage_ip: map has %r, live has %r"
                  % (old.get("storage_ip"), new.get("storage_ip")), None))

# Pool identity: a GUID change on a name present in both means the pool was
# renamed or replaced. A name present on one side only is deliberately not
# drift — an offline configured pool simply omits its GUID from the live
# export (and a pool added since the last export has no recorded identity
# yet); neither is a topology change on the LUN map's objects.
old_pools = old.get("pools", {})
new_pools = new.get("pools", {})
for pool in sorted(set(old_pools) & set(new_pools)):
    if old_pools[pool] != new_pools[pool]:
        drift.append(("pools.%s: GUID changed: map has %r, live has %r"
                      " (pool renamed or replaced?)" % (pool, old_pools[pool],
                                                        new_pools[pool]),
                      None))

old_tg = old.get("targets", {})
new_tg = new.get("targets", {})
for iqn in sorted(set(old_tg) | set(new_tg)):
    o, n = old_tg.get(iqn), new_tg.get(iqn)
    if o is None:
        drift.append(("target %s: live target is not in the map" % iqn, None))
        continue
    if n is None:
        drift.append(("target %s: map target no longer exists live" % iqn, None))
        continue
    ol, nl = o.get("luns", {}), n.get("luns", {})
    for idx in sorted(set(ol) | set(nl), key=lambda s: int(s) if s.isdigit() else 0):
        if idx not in nl:
            drift.append(("target %s: map LUN %s -> %s is missing live"
                          % (iqn, idx, ol[idx]), ol[idx]))
        elif idx not in ol:
            drift.append(("target %s: live LUN %s -> %s is not in the map"
                          % (iqn, idx, nl[idx]), None))
        elif ol[idx] != nl[idx]:
            drift.append(("target %s: LUN %s moved: map -> %s, live -> %s"
                          % (iqn, idx, ol[idx], nl[idx]), None))
    oa, na = acl_records(o.get("acls", [])), acl_records(n.get("acls", []))
    for a in sorted(set(oa) - set(na)):
        drift.append(("target %s: ACL initiator %s is missing live" % (iqn, a),
                      None))
    for a in sorted(set(na) - set(oa)):
        drift.append(("target %s: live ACL initiator %s is not in the map"
                      % (iqn, a), None))
    # Grant pairs are compared only when the MAP side records them (the
    # dict shape): a legacy list map carries no grant dimension to compare
    # against, and it is refreshed to the new shape at the next save.
    if isinstance(o.get("acls"), dict) and isinstance(n.get("acls"), dict):
        for a in sorted(set(oa) & set(na)):
            og, ng = grant_pairs(oa[a]), grant_pairs(na[a])
            for ml in sorted(set(og) | set(ng),
                             key=lambda s: int(s) if s.isdigit() else 1 << 30):
                if ml not in ng:
                    # The grant's tpg_lun names the map LUN whose backstore
                    # the missing grant follows; a tpg_lun the map's LUN
                    # section does not record cannot be traced (None).
                    drift.append(("target %s: ACL %s grant mapped_lun %s -> tpg_lun %s"
                                  " is missing live" % (iqn, a, ml, og[ml]),
                                  ol.get(str(og[ml]))))
                elif ml not in og:
                    drift.append(("target %s: ACL %s live grant mapped_lun %s ->"
                                  " tpg_lun %s is not in the map"
                                  % (iqn, a, ml, ng[ml]), None))
                elif og[ml] != ng[ml]:
                    drift.append(("target %s: ACL %s grant mapped_lun %s moved:"
                                  " map -> tpg_lun %s, live -> tpg_lun %s"
                                  % (iqn, a, ml, og[ml], ng[ml]), None))

old_bs = old.get("backstores", {})
new_bs = new.get("backstores", {})
for bs in sorted(set(old_bs) | set(new_bs)):
    o, n = old_bs.get(bs), new_bs.get(bs)
    if o is None:
        drift.append(("backstore %s: live backstore is not in the map" % bs,
                      None))
        continue
    if n is None:
        drift.append(("backstore %s: map backstore no longer exists live" % bs,
                      bs))
        continue
    for k in ("dev", "target", "lun"):
        if o.get(k) != n.get(k):
            drift.append(("backstore %s: %s changed: map %r, live %r"
                          % (bs, k, o.get(k), n.get(k)), None))

for line, _ in drift:
    print("DRIFT: %s" % line)

# Keys-pending candidate: every line traced to a backstore and every traced
# backstore carrying a zvol dev path the bash side can turn into a dataset
# probe. Any failure here stays plain drift (exit 1) — fail closed.
if drift and all(s is not None for _, s in drift):
    prefix = "/dev/zvol/"
    suspects = sorted({s for _, s in drift})
    pairs = []
    for bs in suspects:
        dev = old_bs.get(bs, {}).get("dev")
        if not isinstance(dev, str) or not dev.startswith(prefix) \
                or len(dev) <= len(prefix):
            pairs = None
            break
        pairs.append((bs, dev[len(prefix):]))
    if pairs is not None:
        for bs, ds in pairs:
            print("KEYSUSPECT: %s=%s" % (bs, ds))
        sys.exit(2)
sys.exit(1 if drift else 0)
PYEOF
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------

main() {

if [[ "$print_map" == true && "$check_only" == true ]]; then
    log_msg "FATAL: --print-map and --check are mutually exclusive"
    exit 1
fi

# Read-only map dump for remote consumers: stdout must stay pure JSON (the
# compute host's repair fetches it over ssh), so this runs before any banner.
if [[ "$print_map" == true ]]; then
    local map_file
    map_file=$(newest_iscsi_state_map || true)
    if [[ -z "$map_file" ]]; then
        log_msg "FATAL: No ${STATE_FILENAME} found on any online pool —" \
            "run export-iscsi-state first"
        exit 1
    fi
    cat -- "$map_file"
    exit 0
fi

log_msg "INFO: === export-iscsi-state ==="
echo ""

collect_live_state
log_msg "INFO: Targets: ${#_state_target_iqns[@]}, backstores: ${#_state_bs_names[@]}"

local json_tmp
json_tmp=$(mktemp "${TMPDIR:-/tmp}/iscsi-state.XXXXXX") || {
    log_msg "FATAL: Could not create a temp file for the state map"
    exit 1
}
emit_state_json > "$json_tmp"

if [[ "$check_only" == true ]]; then
    local map_file rc=0 drift_out="" line pair ds ks
    local -a suspects=()
    map_file=$(newest_iscsi_state_map || true)
    if [[ -z "$map_file" ]]; then
        log_msg "FATAL: No ${STATE_FILENAME} found on any online pool —" \
            "run export-iscsi-state first"
        rm -f "$json_tmp"
        exit 1
    fi
    log_msg "INFO: Comparing live state against ${map_file}"
    # Exit protocol from report_state_drift: 0 no drift · 1 drift with a
    # line a locked key cannot explain · 2 every drift line traced to a map
    # backstore missing live (KEYSUSPECT: <name>=<dataset> lines follow the
    # DRIFT lines). The keystatus probes stay in bash on purpose: the test
    # suite mocks zfs as a shell function, which a python-side subprocess
    # would bypass.
    drift_out=$(report_state_drift "$map_file" "$json_tmp") || rc=$?
    # Re-emit the report minus the internal KEYSUSPECT lines; grep exits 1
    # when it filters everything out, so fence it (pipefail is on).
    if [[ -n "$drift_out" ]]; then
        printf '%s\n' "$drift_out" | grep -v '^KEYSUSPECT:' || true
    fi
    if [[ "$rc" -eq 0 ]]; then
        log_msg "INFO:   ✓ No drift — live state matches the newest pool map"
    elif [[ "$rc" -eq 2 ]]; then
        # Keys-pending candidate: the verdict holds only while every suspect
        # dataset exists, is encrypted, and is locked (keystatus
        # "unavailable"). Keys already loaded, an unencrypted dataset ("-"),
        # or an unreadable dataset is unexpected drift — the FAILED verdict.
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            pair="${line#KEYSUSPECT: }"
            ds="${pair#*=}"
            ks=$(zfs get -H -o value keystatus "$ds" 2>/dev/null) || ks=""
            if [[ "$ks" != "unavailable" ]]; then
                rc=1
                break
            fi
            suspects+=("${pair%%=*}")
        done < <(printf '%s\n' "$drift_out" | grep '^KEYSUSPECT:' || true)
        if [[ "$rc" -eq 2 ]]; then
            log_msg "WARN: All drift is keys-pending — encrypted LUN(s)" \
                "${suspects[*]} locked (keystatus unavailable): expected" \
                "on a keys-absent boot"
            log_msg "WARN:   Load keys and run iscsi-recover-encrypted-luns," \
                "then re-check; do NOT save config until reconciled"
            rm -f "$json_tmp"
            exit 3
        fi
    fi
    if [[ "$rc" -ne 0 ]]; then
        log_msg "WARN: Drift detected between live state and the pool map (see DRIFT lines)"
    fi
    rm -f "$json_tmp"
    exit "$rc"
fi

# Never let a live state that would drop still-expected LUN mappings
# overwrite the healthy pool map.
enforce_not_degraded "$json_tmp" "${#_state_bs_names[@]}" || {
    rm -f "$json_tmp"
    exit 1
}

write_state_to_pools "$json_tmp"
rm -f "$json_tmp"

if [[ "$pools_written" -eq 0 ]]; then
    log_msg "FATAL: State map was not written to any pool"
    exit 1
fi
log_msg "INFO:   ✓ State map written to ${pools_written} pool(s)"
echo ""

} # end main

# Run main only when executed directly, not when sourced for tests.
if [[ -z "${EXPORT_ISCSI_STATE_TEST_MODE:-}" ]] && [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main
fi
