#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
# Find an online offsite pool.

source ~/bashinit
bashinit
source "$(find_zfsutility_script rootcheck)"
source "$(find_zfsutility_script zfsconfig)"

function findoffsitepool {

    rootcheck
    local offsitepools
    local onlinepools
    local onlineoffsitepool=''
    local onlinepool
    local offsitepool

    readarray -t offsitepools < <(zfsconfig_get_offsite_candidates)
    if [[ ${#offsitepools[@]} -eq 0 ]]; then
        echo "$onlineoffsitepool"
        return
    fi

    readarray -t onlinepools < <(zpool list -Ho name)
    for onlinepool in "${onlinepools[@]}"; do
        for offsitepool in "${offsitepools[@]}"; do
            if [[ $onlinepool = "$offsitepool" ]]; then
                onlineoffsitepool="$onlinepool"
                break 2
            fi
        done
    done
    echo "$onlineoffsitepool"
}
if calledbybash; then findoffsitepool; fi
