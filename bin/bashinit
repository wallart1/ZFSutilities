#!/usr/bin/bash
# shellcheck disable=SC1090
# Bash script initial processing
# NOTE: This script must be in your home directory and in (or linked from) /root.
# Note: This script must be sourced from another script. Running it independently
#       is not supported.

function bashinit {
    # Get the directory that we were invoked from.
    # Only set mydir if it is not already set and BASH_SOURCE[1] is available.
    # This preserves mydir when called from contexts like bash -c (Python GUI).
    if [[ -z "${mydir:-}" && -n "${BASH_SOURCE[1]:-}" ]]; then
        mydir=$(dirname "$(realpath "${BASH_SOURCE[1]}")")
    fi

    # Auto-create a session log file for directly-executed scripts.
    # Subshells and sourced function scripts inherit ZFSUTILITIES_LOG_FILE
    # so they do not create duplicate logs.
    # When a Python runner explicitly sets ZFSUTILITIES_LOG_INHERIT=Y, the
    # child bash process reuses the runner's session log instead of creating
    # its own (prevents concurrent runners from colliding on the same file).
    if [[ "${BASH_SOURCE[1]:-}" = "${0}" && "${ZFSUTILITIES_LOG_INHERIT:-}" != "Y" ]]; then
        local script_name
        script_name=$(basename "${0}")
        # Sanitize name to alphanumeric, hyphens, underscores
        script_name="${script_name//[^A-Za-z0-9_-]/}"
        local ts
        ts=$(date +%Y-%m-%d_%H-%M-%S)
        local session_log_dir="${ZFSUTILITIES_SESSION_LOG_DIR}"
        local logfile="${session_log_dir}/${ts}_cli_${script_name}.log"
        if mkdir -p "${session_log_dir}" 2>/dev/null; then
            # Touch the file so it exists even if no messages are written.
            # Export the path only when the file is actually writable: as a
            # non-root user the root-owned session dir makes the touch fail,
            # and an exported but unwritable path would make every later
            # log_msg append print a Permission-denied error.
            if touch "${logfile}" 2>/dev/null; then
                export ZFSUTILITIES_LOG_FILE="${logfile}"
            fi
        fi
    fi

    # One-time migration of legacy state/config files to the FHS-aligned layout.
    # Guarded by root check and ZFSUTILITIES_DISABLE_MIGRATION in the helper.
    if declare -f migrate_zfsutilities_state >/dev/null 2>&1; then
        migrate_zfsutilities_state
    fi
}

# find_zfsutility_script <name>
# Locate a sibling script or library when running from the repo or from a
# deployed bin/ directory.  Candidate directories are checked in order; the
# first existing regular file wins.
#   1. $mydir/<name>                         (same directory, e.g. bin/ -> bin/)
#   2. $mydir/../lib/<name>                  (bin/ -> lib/)
#   3. $mydir/../python/<name>               (bin/ -> python/)
#   4. $mydir/../share/<name>                (bin/ -> share/)
#   5. $bin_dir/<name>                       (deployed active PATH bin/)
#   6. $current_bin_dir/<name>               (deployed current version bin/)
#   7. $system_lib_dir/<name>                (system-wide library symlink)
#
# The absolute deployment directories can be overridden via environment
# variables for testing or non-standard layouts:
#   ZFSUTILITIES_BIN_DIR         (default: /usr/local/lib/zfsutilities/bin)
#   ZFSUTILITIES_CURRENT_BIN_DIR (default: /usr/local/lib/zfsutilities/current/bin)
#   ZFSUTILITIES_SYSTEM_LIB_DIR  (default: /usr/local/lib)
# Prints the resolved path and returns 0 on success, otherwise logs a WARN
# message and returns 1.
# Guarded so that test mocks can take precedence when scripts re-source
# bashinit during a test run.
if ! declare -f find_zfsutility_script >/dev/null 2>&1; then
function find_zfsutility_script {
    local name="$1"
    local bin_dir="${ZFSUTILITIES_BIN_DIR:-/usr/local/lib/zfsutilities/bin}"
    local current_bin_dir="${ZFSUTILITIES_CURRENT_BIN_DIR:-/usr/local/lib/zfsutilities/current/bin}"
    local system_lib_dir="${ZFSUTILITIES_SYSTEM_LIB_DIR:-/usr/local/lib}"
    local candidate
    for candidate in \
        "$mydir/$name" \
        "$mydir/lib/$name" \
        "$mydir/python/$name" \
        "$mydir/share/$name" \
        "$mydir/../lib/$name" \
        "$mydir/../python/$name" \
        "$mydir/../share/$name" \
        "$bin_dir/$name" \
        "$current_bin_dir/$name" \
        "$system_lib_dir/$name"; do
        if [[ -f "$candidate" ]]; then
            realpath "$candidate"
            return 0
        fi
    done
    log_msg "WARN: Could not find sibling script: $name"
    return 1
}
fi

# Return true when stderr is connected to a real terminal.
function __log_msg_terminal_p {
    [[ -t 2 && "${TERM}" != "dumb" ]]
}

# Logging function with automatic prefix.
# Usage:
# log_msg "This is a message"
# log_msg "DEBUG: verbose diagnostic"
# log_msg --long-prefix "DEBUG: verbose diagnostic"
# All messages are always emitted to stderr and appended to the session log
# file when one is configured and owned by this process. Message-level
# filtering is performed by the GUI log viewers, not by this function.
#
# By default, when stderr is a terminal the message is emitted without the
# file:line prefix for readability. Pass --long-prefix as the first argument
# to force the file:line prefix even on a terminal. Non-terminal output and
# session log files always use the long file:line prefix.
function log_msg {
    local long_prefix=false
    if [[ "${1:-}" == "--long-prefix" ]]; then
        long_prefix=true
        shift
    fi

    local caller_file="${BASH_SOURCE[1]}"
    local caller_line="${BASH_LINENO[0]}"
    local long_prefix_str
    if [[ -n "$caller_file" ]]; then
        # Fall back to the raw caller path when realpath cannot resolve it
        # (e.g. a relative script path after the script has cd'd elsewhere);
        # an unresolvable prefix must never abort the caller under set -e.
        long_prefix_str="$(realpath "$caller_file" 2>/dev/null || printf '%s' "$caller_file"):$caller_line:"
    else
        long_prefix_str="zfsutilities:"
    fi

    local prefix=""
    if [[ "$long_prefix" == true ]] || ! __log_msg_terminal_p; then
        prefix="$long_prefix_str"
    fi

    local full="${prefix}${prefix:+ }$*"

    # Colorize stderr output when connected to a terminal.
    if __log_msg_terminal_p; then
        local colored="${full}"
        case "$*" in
            WARN:*) colored="\033[38;5;208m${full}\033[0m" ;;
            FATAL:*) colored="\033[1;31m${full}\033[0m" ;;
        esac
        echo -e "${colored}" >&2
    else
        echo -e "${full}" >&2
    fi

    # Append to session log file if one is configured and we own it.
    # The log file always keeps the long file:line prefix.
    if [[ -n "${ZFSUTILITIES_LOG_FILE:-}" && "${ZFSUTILITIES_LOG_INHERIT:-}" != "Y" ]]; then
        local _ts
        _ts=$(date '+%Y-%m-%d %H:%M:%S')
        local long_full="${long_prefix_str} $*"
        # stderr must be redirected BEFORE the append redirection is
        # evaluated: if the log file vanished (e.g. the uninstaller just
        # removed the log dir), bash reports the failed >> open to the
        # then-current stderr, escaping a trailing 2>/dev/null.
        echo -e "${_ts}  ${long_full}" 2>/dev/null >> "${ZFSUTILITIES_LOG_FILE}" || true
    fi
}

# Generate message prefix for when you don't want to use log_msg.
# Pass --long-prefix to force the prefix even when stderr is a terminal.
function msg_prefix {
    local long_prefix=false
    if [[ "${1:-}" == "--long-prefix" ]]; then
        long_prefix=true
        shift
    fi
    if [[ "$long_prefix" == true ]] || ! __log_msg_terminal_p; then
        local caller_file="${BASH_SOURCE[1]}"
        local caller_line="${BASH_LINENO[0]}"
        local msgprefix
        if [[ -n "$caller_file" ]]; then
            msgprefix="$(realpath "$caller_file" 2>/dev/null || printf '%s' "$caller_file"):$caller_line:"
        else
            msgprefix="zfsutilities:"
        fi
        echo -n "$msgprefix" >&2
    fi
}

function calledbybash {
    if [[ "${BASH_SOURCE[1]}" = "${0}" ]]; then return 0; else return 1; fi
}

# Composable EXIT-trap registration.
# bash allows only one EXIT trap per shell, and several parts of this project
# need exit-time cleanup (zfslockmanager's lock release, test-lib's artifact
# removal, per-script temp files). Registering a bare `trap ... EXIT` silently
# discards whatever was registered before it, so exit cleanup must go through
# append_exit_trap instead.
#
# Usage: append_exit_trap '<handler command string>'
# Handlers run in registration order when the shell exits. The shell's
# original exit status is preserved: _run_exit_traps never calls exit.
#
# The trap is armed as `_run_exit_traps <BASHPID of arming shell>`, so the
# handler string itself records whether the arming seen in `trap -p` belongs
# to this shell or was inherited from a parent shell at fork time.
#
# Subshell semantics: a subshell inherits the parent's armed EXIT trap and
# handler list, but bash fires only traps the subshell arms itself. The first
# append inside a subshell resets the inherited list (the parent still runs
# its own handlers at its own exit), so handlers registered in the subshell,
# and only those, run when the subshell exits. A foreign `trap ... EXIT`
# present when append runs — installed earlier in this shell, or inherited —
# is folded into the list so it is not lost to the re-arm. (In the inherited
# case that handler will also run at the parent's exit; exit handlers are
# expected to be idempotent cleanup.)
#
# Known bash quirk (5.2): a trap armed inside a bare `while read` loop that
# is itself a pipeline segment (`cmd | while read ...`) does not fire when
# that segment's subshell exits — brace the loop or register from file scope
# when the handler must run. Per-iteration arming inside such loops (e.g.
# zfslock_init from a delsnap pipe loop) shares this quirk with the direct
# trap it replaces; there is no regression, but no rescue either.
if ! declare -p _EXIT_TRAP_HANDLERS >/dev/null 2>&1; then
    _EXIT_TRAP_HANDLERS=()
fi
function append_exit_trap {
    local handler="$1"
    local armed=""
    armed="$(trap -p EXIT)"
    if [[ -n "$armed" ]]; then
        # `trap -p` prints the canonical form `trap -- '<handler>' EXIT`;
        # strip the wrapper (quotes optional across bash versions).
        armed="${armed#trap -- }"
        armed="${armed% EXIT}"
        armed="${armed#\'}"
        armed="${armed%\'}"
    fi
    if [[ "$armed" = "_run_exit_traps $BASHPID" ]]; then
        : # already armed by this shell; append below
    elif [[ "$armed" = "_run_exit_traps "* ]]; then
        # Inherited our own arming from a parent shell: drop the inherited
        # handlers; the parent runs them at its own exit.
        _EXIT_TRAP_HANDLERS=()
    elif [[ -n "$armed" ]]; then
        # Foreign EXIT trap: fold it so it survives the re-arm below.
        _EXIT_TRAP_HANDLERS+=("$armed")
    fi
    _EXIT_TRAP_HANDLERS+=("$handler")
    # $BASHPID must expand at arm time: the embedded PID in the handler
    # string is what identifies this shell's own arming to later calls.
    # shellcheck disable=SC2064
    trap "_run_exit_traps $BASHPID" EXIT
}
function _run_exit_traps {
    # Args (the arming shell's BASHPID) are ignored; they exist so the armed
    # handler string records which shell installed the trap.
    # Capture $? before any other statement: handlers may read it to inspect
    # the exit status (plain `trap fn EXIT` semantics).
    local rc=$?
    local handler
    # Handlers may read $? to inspect the exit status (plain `trap fn EXIT`
    # semantics), and a failing handler must not abort the remaining ones.
    local eflag="${-//[^e]/}"
    set +e
    for handler in "${_EXIT_TRAP_HANDLERS[@]}"; do
        ( exit "$rc" )   # restore $? for the handler about to run
        eval "$handler"
    done
    [[ -n "$eflag" ]] && set -e
    return 0
}

# Prompt user for yes/no response with input validation.
# Usage: if ask_yn "Do you want to continue?" ["Y"|"N"]; then ...
# Returns 0 for yes, 1 for no. The optional second argument is the default
# answer used when the user presses Enter (N if omitted).
function ask_yn {
    local prompt="${1:-Continue?}"
    local default="${2:-N}"
    local response
    while true; do
        if [[ "$default" == "Y" ]]; then
            read -rp "${prompt} [Y/n]: " response
            response="${response:-Y}"
        else
            read -rp "${prompt} [y/N]: " response
            response="${response:-N}"
        fi
        case "${response,,}" in
            y|yes) return 0 ;;
            n|no)  return 1 ;;
            *)     echo "  Please answer y or n." ;;
        esac
    done
}

# Source a sibling script or library through find_zfsutility_script.
# Defined here so every script that sources bashinit shares one implementation
# instead of duplicating the same helper.
# Usage: source_helper <name>
if ! declare -f source_helper >/dev/null 2>&1; then
function source_helper {
    local name="$1" path
    path=$(find_zfsutility_script "$name")
    if [[ -z "$path" ]]; then
        log_msg "FATAL: Could not locate $name"
        local fatal_path
        fatal_path=$(find_zfsutility_script bashfatal)
        [[ -n "$fatal_path" ]] && source "$fatal_path" 8
        # If bashfatal is missing, fall back to bashreturn so sourced callers
        # regain control instead of killing the parent shell.
        local return_path
        return_path=$(find_zfsutility_script bashreturn)
        [[ -n "$return_path" ]] && source "$return_path" 8
        # Propagate the failure code if neither helper terminated the process.
        return 8
    fi
    source "$path"
}
fi

# Print a fatal message and terminate the process.
# Usage: die "error message"
# Usage: die --long-prefix "error message"
function die {
    if [[ "${1:-}" == "--long-prefix" ]]; then
        shift
        log_msg --long-prefix "FATAL: $*"
    else
        log_msg "FATAL: $*"
    fi
    source "$(find_zfsutility_script bashfatal)" 1
}

# Log a warning message.
# Usage: warn "warning message"
# Usage: warn --long-prefix "warning message"
function warn {
    if [[ "${1:-}" == "--long-prefix" ]]; then
        shift
        log_msg --long-prefix "WARN: $*"
    else
        log_msg "WARN: $*"
    fi
}

# Load the centralized path layout so every script that sources bashinit
# inherits the FHS-aligned directories and legacy-path aliases.
# PATHS_LIB can be set explicitly by tests that need a different layout.
if [[ -z "${PATHS_LIB:-}" ]]; then
    if [[ -n "${mydir:-}" ]]; then
        PATHS_LIB=$(find_zfsutility_script paths.sh)
    elif [[ -n "${BASH_SOURCE[0]}" ]]; then
        # $mydir is not preset (e.g. bash -c from the Python GUI).  Derive a
        # directory from this sourced file so lib/paths.sh can be found in
        # deployed layouts where /root/bashinit is a symlink to
        # /usr/local/lib/zfsutilities/current/bin/bashinit.
        _bashinit_dir=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
        PATHS_LIB=$(mydir="$_bashinit_dir" find_zfsutility_script paths.sh)
        unset _bashinit_dir
    fi
fi
if [[ -n "${PATHS_LIB:-}" ]]; then
    # shellcheck source=/dev/null
    source "$PATHS_LIB"
fi
