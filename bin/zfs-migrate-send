#!/usr/bin/bash
# zfs-migrate-send
# One-shot replication copy for the Migrate Pool data-transfer steps.
#
# Sends one pre-created migration snapshot as a single `zfs send -Rw` stream
# and receives it with `zfs receive -u -F -s -v` so an interrupted transfer
# leaves a receive resume token on the destination: re-running Migrate Pool
# resumes from that token instead of starting over. `-v` makes the receive
# log each dataset as it is processed so progress through the tree is
# visible in the session log. `pv` is placed in the
# pipeline when useful (terminal or GUI-captured output); the optional
# $transfer_rate_limit adds the pace_stream.py rate-limit stage.
#
# With an optional $fromsnap set, the send becomes the cutover catch-up
# incremental: `zfs send -w -I <src>@$fromsnap <src>@$snapname` carries every
# change made since the migration snapshot, intermediary snapshots included
# (`-I`, always a standalone argv word — inside a flag cluster getopt would
# swallow the next character as its argument), into the same destination
# before any destructive cutover step. When the SOURCE IS A CLONE no -R is
# ever used, for the full copy or the catch-up: a replication stream of a
# clone is based on its origin snapshot, and a receive onto a pool where
# that snapshot already exists links the destination as a clone of it
# instead of copying data. Clone copies use zfs-send-receive's two-step
# instead: a plain full send of the source's oldest snapshot, then a
# -w -I incremental to $snapname.
#
# Usage: not intended for direct CLI use; the Migrate Pool wizard executes
#        this script with the variables below assigned.
# Variables assigned by the caller before sourcing/executing:
#   $sourcefs      source dataset (e.g. temp/proxmox)
#   $destfs        destination dataset (e.g. temp_mig/proxmox)
#   $snapname      bare migration snapshot name (no leading @)
#   $fromsnap      optional bare from-snapshot name for the incremental
#                  catch-up send (no leading @); empty = full -Rw send
#   $transfer_rate_limit optional rate limit (e.g. 100m); empty = unlimited
#   $restart_hint optional name of the operation that should be re-run to
#                resume an interrupted transfer, used in the failure
#                remediation text (default: Migrate Pool). Callers that drive
#                this engine for another operation (e.g. sever-vm-clone) set
#                it so the re-run hint names them instead of Migrate Pool.
#
# Returns: 0 on success; 8 on transfer failure (the destination resume token
#          is kept so the transfer can be resumed by a re-run).

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
rootcheck

source_helper transfer-lib.sh

zfs_migrate_send() {
    local sourcefs="${sourcefs:-}" destfs="${destfs:-}" snapname="${snapname:-}"
    local fromsnap="${fromsnap:-}"
    local restart_hint="${restart_hint:-Migrate Pool}"
    if [[ -z "$sourcefs" || -z "$destfs" || -z "$snapname" ]]; then
        log_msg "FATAL: zfs-migrate-send requires sourcefs, destfs, and" \
            "snapname to be set."
        return 8
    fi

    # If the destination already has a receive resume token, resume from it.
    # No locking here: the migration executor holds a pool write lock for the
    # whole run.
    if zfs list "$destfs" > /dev/null 2>&1; then
        local resumetoken
        resumetoken=$(zfs get -H receive_resume_token -o value "$destfs" 2>/dev/null) \
            || resumetoken=""
        if [[ -n "$resumetoken" && "$resumetoken" != '-' ]]; then
            log_msg "INFO: Found resume token for $destfs." \
                "Preparing to resume transfer."
            local resumedata
            if ! resumedata=$(transfer_validate_resume_token "$resumetoken"); then
                if transfer_resume_token_stale "$resumedata"; then
                    log_msg "WARN: Resume token is invalid or stale." \
                        "Aborting resume token."
                    log_msg "WARN: $resumedata"
                else
                    log_msg "WARN: Resume token validation failed with" \
                        "unexpected error:\n\t$resumedata"
                    log_msg "WARN: Aborting resume token and retrying..."
                fi
                transfer_abort_resume_token "$destfs"
            else
                local datatosend=$resumedata
                log_msg "VERB: datatosend=$datatosend"
                log_msg "INFO: Remaining data to transfer:" \
                    "$(echo "$datatosend" | numfmt --to=iec-i)."
                # Mirrors zfs-send-receive's resume receive: verbose, but no
                # -u/-F/-s — the token already encodes the destination state.
                if transfer_do "resume transfer for $destfs" "-t $resumetoken" "-v" \
                        "Y" "$datatosend" "" "$destfs"; then
                    return 0
                fi
                log_msg "FATAL: ${restart_hint} transfer interrupted; re-run" \
                    "${restart_hint} to resume from the receive resume token" \
                    "on $destfs."
                return 8
            fi
        fi
    fi

    # --- Fresh send of the migration snapshot --------------------------------
    # Clone-safe copy: a replication stream (-R) of a CLONE is based on the
    # clone's origin snapshot, and a receive onto a pool where that snapshot
    # already exists (severance copies within the source pool) links the
    # destination as a CLONE of it — receive prints "found clone origin",
    # almost no bytes move, and nothing is severed. A clone source is
    # therefore copied with zfs-send-receive's proven two-step, no -R
    # anywhere: a plain full send of the source's OLDEST snapshot
    # (self-contained), then a -w -I incremental to $snapname carrying the
    # rest of the lineage. Non-clone sources keep the -R replication form.
    local clone_origin=""
    clone_origin=$(zfs get -H -o value origin "$sourcefs" 2>/dev/null) || clone_origin=""
    local is_clone=0
    if [[ -n "$clone_origin" && "$clone_origin" != "-" ]]; then
        is_clone=1
        if [[ -z "$fromsnap" ]]; then
            log_msg "INFO: $sourcefs is a clone of $clone_origin — copying" \
                "origin-free (plain full of the oldest snapshot, then -w -I" \
                "incrementals)."
        fi
    fi

    # awk '/^size/ {print $2}' — Extract byte size from the transfer dry-run.
    local datatosend=0 est="" est_a="" est_b="" have_est=0
    local have_oldest=0 oldest_bare=""
    if [[ -n "$fromsnap" ]]; then
        # Cutover catch-up: a short incremental from the migration snapshot
        # to the cutover snapshot. -I includes intermediary snapshots taken
        # between the two and must be its own argv word (never clustered);
        # -R only for non-clone sources — a clone's stream must not
        # reference its origin.
        if (( is_clone )); then
            if ! est=$(zfs send -nP -w -I "$sourcefs@$fromsnap" \
                    "$sourcefs@$snapname" 2>/dev/null | awk '/^size/ {print $2}'); then
                est=""
                log_msg "WARN: Size estimate dry-run of $sourcefs@$fromsnap" \
                    "to $sourcefs@$snapname failed."
            fi
        else
            if ! est=$(zfs send -nPRw -I "$sourcefs@$fromsnap" \
                    "$sourcefs@$snapname" 2>/dev/null | awk '/^size/ {print $2}'); then
                est=""
                log_msg "WARN: Size estimate dry-run of $sourcefs@$fromsnap" \
                    "to $sourcefs@$snapname failed."
            fi
        fi
        if [[ -n "$est" ]]; then datatosend=$((datatosend + est)); have_est=1; fi
    elif (( is_clone )); then
        # Two-step copy of a clone: full of the oldest snapshot, then
        # incremental to $snapname. A re-run that already delivered @oldest
        # skips the full step; an interrupted receive resumes via the
        # resume-token path above.
        local oldest_full
        oldest_full=$(zfs list -H -t snapshot -o name -s creation -d 1 \
                "$sourcefs" 2>/dev/null | head -1) || oldest_full=""
        if [[ "$oldest_full" == *"@"* ]]; then
            oldest_bare="${oldest_full#*@}"
        else
            oldest_bare="$snapname"
        fi
        if zfs list -H -t snapshot -o name "$destfs@$oldest_bare" >/dev/null 2>&1; then
            have_oldest=1
            log_msg "INFO: Destination already holds @${oldest_bare} —" \
                "skipping the full-copy step."
        fi
        if (( have_oldest == 0 )); then
            if ! est_a=$(zfs send -nP -w "$sourcefs@$oldest_bare" 2>/dev/null \
                    | awk '/^size/ {print $2}'); then
                est_a=""
                log_msg "WARN: Size estimate dry-run of $sourcefs@$oldest_bare" \
                    "failed."
            fi
            if [[ -n "$est_a" ]]; then datatosend=$((datatosend + est_a)); have_est=1; fi
        fi
        if [[ "$snapname" != "$oldest_bare" ]]; then
            if ! est_b=$(zfs send -nP -w -I "$sourcefs@$oldest_bare" \
                    "$sourcefs@$snapname" 2>/dev/null | awk '/^size/ {print $2}'); then
                est_b=""
                log_msg "WARN: Size estimate dry-run of $sourcefs@$oldest_bare" \
                    "to $sourcefs@$snapname failed."
            fi
            if [[ -n "$est_b" ]]; then datatosend=$((datatosend + est_b)); have_est=1; fi
        fi
    else
        if ! est=$(zfs send -nPRw "$sourcefs@$snapname" 2>/dev/null \
                | awk '/^size/ {print $2}'); then
            est=""
            log_msg "WARN: Size estimate dry-run of $sourcefs@$snapname failed."
        fi
        if [[ -n "$est" ]]; then datatosend=$((datatosend + est)); have_est=1; fi
    fi
    # have_est, not the byte total, separates "no estimate obtained" from a
    # genuine zero-byte estimate (an empty incremental dry-run reports 0).
    if (( have_est == 0 )); then
        log_msg "WARN: Unable to get stream size estimate of" \
            "$sourcefs@$snapname."
    else
        log_msg "INFO: Approximately" \
            "$(echo "$datatosend" | numfmt --to=iec-i)" "bytes to transfer."
    fi
    # The wizard already validated capacity; warn only, so a mid-plan abort
    # does not leave partial state the verify step is meant to catch.
    transfer_check_space "$datatosend" "${destfs%%/*}" \
        || log_msg "WARN: Proceeding despite insufficient space."

    # Transfers. -R preserves properties/mountpoints for the cutover
    # re-import (non-clone sources); -w sends raw so encrypted datasets
    # survive; -u keeps received datasets unmounted; -F lets a re-run roll
    # the destination back; -s always, since migration transfers are
    # full-copy-sized; -v logs each dataset as it is received so progress
    # through the tree is visible in the session log. The -I forms are
    # assembled by transfer_do with -I as a standalone argv word.
    if [[ -n "$fromsnap" ]]; then
        local catch_sendopts="-Rw"
        if (( is_clone )); then catch_sendopts="-w"; fi
        if transfer_do "Send/receive" "$catch_sendopts" "-u -F -s -v" "Y" \
                "$datatosend" "$sourcefs@$fromsnap" "$destfs" "$sourcefs@$snapname"; then
            return 0
        fi
    elif (( is_clone )); then
        # Plain sends do not carry dataset properties: give the copy the
        # source's LOCAL compression (inherited sources need nothing — the
        # destination namespace inherits from the same parent). volblocksize,
        # volsize, and encryption are intrinsic to the raw (-w) stream.
        local comp_pair comp_val comp_src comp_recvopts=""
        comp_pair=$(zfs get -H -o source,value compression "$sourcefs" 2>/dev/null) \
            || comp_pair=""
        comp_src="${comp_pair%%$'\t'*}"
        comp_val="${comp_pair##*$'\t'}"
        if [[ "$comp_src" == "local" && -n "$comp_val" && "$comp_val" != "-" ]]; then
            comp_recvopts=" -o compression=${comp_val}"
        fi
        if (( have_oldest == 0 )); then
            if ! transfer_do "Full copy of $sourcefs@$oldest_bare" "-w" \
                    "-u -F -s -v${comp_recvopts}" "Y" "${est_a:-0}" \
                    "$sourcefs@$oldest_bare" "$destfs"; then
                log_msg "FATAL: ${restart_hint} transfer interrupted; re-run" \
                    "${restart_hint} to resume from the receive resume token" \
                    "on $destfs."
                return 8
            fi
        fi
        if [[ "$snapname" != "$oldest_bare" ]]; then
            if ! transfer_do "Incremental to $snapname" "-w" \
                    "-u -F -s -v" "Y" "${est_b:-0}" \
                    "$sourcefs@$oldest_bare" "$destfs" "$sourcefs@$snapname"; then
                log_msg "FATAL: ${restart_hint} transfer interrupted; re-run" \
                    "${restart_hint} to resume from the receive resume token" \
                    "on $destfs."
                return 8
            fi
        fi
        return 0
    else
        if transfer_do "Send/receive" "-Rw" "-u -F -s -v" "Y" "$datatosend" \
                "$sourcefs@$snapname" "$destfs"; then
            return 0
        fi
    fi
    log_msg "FATAL: ${restart_hint} transfer interrupted; re-run" \
        "${restart_hint} to resume from the receive resume token on $destfs."
    return 8
}

if calledbybash; then
    zfs_migrate_send
fi
