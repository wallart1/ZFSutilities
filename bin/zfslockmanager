#!/usr/bin/bash
# ZFS Lock Manager - Hierarchical dataset lock management
#
# This script provides functions for managing locks on ZFS datasets to prevent
# conflicting operations. It supports multiple lock types, hierarchical conflict
# detection, stale lock cleanup, and interactive conflict resolution.
#
# Lock Types:
#   r - Shared Read: Reading metadata, listing. Conflicts with w, x.
#   w - Exclusive Write: Creating/modifying snapshots, send/receive. Conflicts with r, w, x.
#   x - Exclusive Destroy: Destroying datasets/snapshots. Conflicts with all types.
#
# Usage:
#   source zfslockmanager
#   zfslock_init                           # Set up EXIT trap for auto-cleanup
#   zfslock_acquire "pool/dataset" "w" "description"
#   # ... do work ...
#   zfslock_release "$zfslock_id"          # Or let EXIT trap handle it
#
# Multiple Locks:
#   $zfslock_id only holds the most recent lock ID. For multiple locks, save each ID:
#     zfslock_acquire "source/data" "w" "reading source"
#     lock_source="$zfslock_id"
#     zfslock_acquire "dest/data" "w" "writing dest"
#     lock_dest="$zfslock_id"
#     # ... do work ...
#     zfslock_release "$lock_source"
#     zfslock_release "$lock_dest"
#   Note: All locks are tracked internally and released by the EXIT trap regardless.
#
# Functions:
#   zfslock_init                           # Initialize lock manager, set up EXIT trap
#   zfslock_acquire <dataset> <type> [description]
#                                          # Returns: 0=success, 1=conflict, 2=error
#                                          # Sets: $zfslock_id on success
#   zfslock_release <lock_id>              # Release a specific lock
#   zfslock_release_all                    # Release all locks held by current PID
#   zfslock_check <dataset> <type>         # Check for conflicts (0=none, 1=conflict)
#                                          # Sets: $zfslock_conflict_info
#   zfslock_wait_or_resolve <dataset> <type> [description]
#                                          # Returns: 0=acquired, 1=aborted, 2=skipped
#   zfslock_is_stale <lock_file>           # Check if lock is stale (0=stale, 1=active)
#   zfslock_cleanup_stale                  # Remove all stale locks

# ==============================================================================
# Constants and Configuration
# ==============================================================================

ZFSLOCK_DIR="${ZFSLOCK_DIR:-/run/lock/zfsutilities}"
zfslock_locks_dir="$ZFSLOCK_DIR/.locks"
zfslock_pids_dir="$ZFSLOCK_DIR/.pids"
ZFSLOCK_WAIT_INTERVAL=30    # Seconds between retry attempts when waiting

# Global variables set by functions
zfslock_id=""               # Set by zfslock_acquire on success
zfslock_conflict_info=""    # Set by zfslock_check when conflict found

# ==============================================================================
# Two-Node Awareness
# ==============================================================================

# These are populated by _zfslock_load_node_config() the first time they are
# needed.  Tests can override the configuration by setting ZFSLOCK_REMOTE_HOST,
# ZFSLOCK_REMOTE_POOLS, ZFSLOCK_THIS_HOST, or ZFSLOCK_REMOTE_DISABLED=1.
_zfslock_node_mode="single-node"
_zfslock_storage_host=""
_zfslock_compute_host=""
_zfslock_this_host=""
declare -A _zfslock_pool_target=()
declare -A _zfslock_remote_pids=()
declare -A _zfslock_remote_hosts=()
_zfslock_remote_conflict_seq=0

# Extract a scalar value from the right-hand side of a KEY=value line in a
# node config file.  Strips at most one quote character from each end and
# rejects empty values or values that still contain a quote.  Prints the
# value on stdout; returns 1 when the value is invalid, in which case the
# caller keeps the current/default setting.
_zfslock_conf_scalar() {
    local value="$1"
    value="${value#\"}"
    value="${value%\"}"
    value="${value#\'}"
    value="${value%\'}"
    # Reject empty values or values that still contain a quote character.
    [[ -n "$value" ]] || return 1
    [[ "$value" != *'"'* ]] || return 1
    [[ "$value" != *"'"* ]] || return 1
    printf '%s\n' "$value"
}

# Load node configuration from /etc/zfsutilities/node.conf (with legacy
# fallbacks).  If no configuration is found, default to single-node/local mode.
_zfslock_load_node_config() {
    # Test override: disable all remote locking.
    if [[ "${ZFSLOCK_REMOTE_DISABLED:-}" == "1" ]]; then
        _zfslock_node_mode="single-node"
        _zfslock_storage_host=""
        _zfslock_compute_host=""
        _zfslock_this_host="${ZFSLOCK_THIS_HOST:-$(hostname -s)}"
        _zfslock_pool_target=()
        return 0
    fi

    _zfslock_this_host="${ZFSLOCK_THIS_HOST:-$(hostname -s)}"

    local conf_path=""
    local env_conf="${ZFSUTILITIES_NODE_CONF:-}"
    if [[ -n "$env_conf" && -r "$env_conf" ]]; then
        conf_path="$env_conf"
    elif [[ -r "/etc/zfsutilities/node.conf" ]]; then
        conf_path="/etc/zfsutilities/node.conf"
    elif [[ -r "/etc/zfsutilities-node.conf" ]]; then
        conf_path="/etc/zfsutilities-node.conf"
    elif [[ -r "/etc/two-node.conf" ]]; then
        conf_path="/etc/two-node.conf"
    fi

    if [[ -z "$conf_path" ]]; then
        _zfslock_node_mode="single-node"
        _zfslock_storage_host="$_zfslock_this_host"
        _zfslock_compute_host="$_zfslock_this_host"
        _zfslock_pool_target=()
        return 0
    fi

    local node_mode="two-node"
    local storage_host="" compute_host=""
    local line value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Strip comments and trailing whitespace.
        line="${line%%#*}"
        line="${line//[[:space:]]/}"
        [[ -z "$line" ]] && continue

        case "$line" in
            NODE_MODE=*)
                value=$(_zfslock_conf_scalar "${line#NODE_MODE=}") \
                    && node_mode="$value"
                ;;
            STORAGE_HOST=*)
                value=$(_zfslock_conf_scalar "${line#STORAGE_HOST=}") \
                    && storage_host="$value"
                ;;
            COMPUTE_HOST=*)
                value=$(_zfslock_conf_scalar "${line#COMPUTE_HOST=}") \
                    && compute_host="$value"
                ;;
            *POOL_TARGET\[*)
                # Legacy regex was unanchored: match anywhere in the line.
                value="${line#*POOL_TARGET\[}"
                if [[ "$value" == *\]* ]]; then
                    local pt_key="${value%%\]*}"
                    value="${value#*\]}"
                    if [[ -n "$pt_key" && "$value" == =* ]]; then
                        # Value: optional one leading quote, then everything
                        # up to the next quote/space (legacy: unanchored).
                        value="${value#=}"
                        value="${value#\"}"
                        value="${value#\'}"
                        value="${value%%[[:space:]]*}"
                        value="${value%%\"*}"
                        value="${value%%\'*}"
                        if [[ -n "$value" ]]; then
                            _zfslock_pool_target["$pt_key"]="$value"
                        fi
                    fi
                fi
                ;;
        esac
    done < "$conf_path"

    _zfslock_node_mode="$node_mode"
    _zfslock_storage_host="${storage_host:-$_zfslock_this_host}"
    _zfslock_compute_host="${compute_host:-$_zfslock_this_host}"

    # Test override: force a specific remote authority and pool list.
    if [[ -n "${ZFSLOCK_REMOTE_HOST:-}" ]]; then
        _zfslock_storage_host="$ZFSLOCK_REMOTE_HOST"
        _zfslock_node_mode="two-node"
        _zfslock_pool_target=()
        local pool
        for pool in ${ZFSLOCK_REMOTE_POOLS:-}; do
            _zfslock_pool_target["$pool"]="$pool"
        done
    fi
}

# Return the remote host that should hold a lock for this dataset, or empty
# string if the lock should be local.
_zfslock_remote_host_for_dataset() {
    local dataset="$1"
    local pool
    if [[ -z "${_zfslock_this_host:-}" ]]; then
        _zfslock_load_node_config
    fi
    [[ "$_zfslock_node_mode" == "two-node" ]] || return 0
    [[ "$_zfslock_this_host" != "$_zfslock_storage_host" ]] || return 0

    pool="${dataset%%/*}"
    [[ -n "${_zfslock_pool_target[$pool]:-}" ]] || return 0

    echo "$_zfslock_storage_host"
}

# Return the remote bin directory on the given host.
_zfslock_remote_bin() {
    local host="$1"
    if [[ -n "${ZFSLOCK_REMOTE_BIN:-}" ]]; then
        echo "$ZFSLOCK_REMOTE_BIN"
        return 0
    fi
    if declare -f remote_zfsutilities_bin >/dev/null 2>&1; then
        local remote_bin
        remote_bin=$(remote_zfsutilities_bin "$host" 2>/dev/null)
        if [[ -n "$remote_bin" ]]; then
            echo "$remote_bin"
            return 0
        fi
    fi
    echo "/usr/local/lib/zfsutilities/current/bin"
}

# Return the path to the remote lock agent on the given host.
_zfslock_remote_agent() {
    local host="$1"
    local remote_bin
    remote_bin=$(_zfslock_remote_bin "$host")
    echo "$remote_bin/zfslockmanager-remote"
}

# Execute a command on the remote lock authority.  Tests can override this
# function to avoid real SSH.
_zfslock_remote_exec() {
    local host="$1"
    shift
    ssh -n -T -o ConnectTimeout=10 "root@${host}" "$@"
}

# Spawn a remote command in the background, redirecting stdout to outfile.
# The SSH process PID is left in $_zfslock_remote_ssh_pid.
_zfslock_remote_spawn() {
    local host="$1"
    local remote_cmd="$2"
    local outfile="$3"
    _zfslock_remote_exec "$host" "$remote_cmd" > "$outfile" 2>/dev/null &
    _zfslock_remote_ssh_pid=$!
}

# Create a temporary local lock file from remote conflict details so that the
# existing interactive prompt can display it.
_zfslock_remote_conflict_file() {
    local dataset="$1" type="$2" pid="$3" script="$4"
    local acquired="$5" description="$6" remote_host="$7" remote_lockfile="$8"
    _zfslock_remote_conflict_seq=$((_zfslock_remote_conflict_seq + 1))
    local conflict_file=\
"$zfslock_locks_dir/.remote-conflict.$$.${_zfslock_remote_conflict_seq}.lock"
    {
        printf '{"dataset":"%s","type":"%s","pid":"%s","script":"%s",' \
            "$dataset" "$type" "$pid" "$script"
        printf '"acquired":"%s","description":"%s","remote_host":"%s","remote_lockfile":"%s"}' \
            "$acquired" "$description" "$remote_host" "$remote_lockfile"
    } > "$conflict_file"
    echo "$conflict_file"
}

# Extract a JSON string value from a one-line JSON blob.
# Finds the literal "field": prefix, skips whitespace, and captures the
# quoted string value (empty allowed).  The legacy regex was unanchored,
# so if the first "field": occurrence is not followed by a quoted value,
# later occurrences are tried.
_zfslock_json_str_field() {
    local json="$1" field="$2"
    local rest value
    rest="${json#*\"$field\":}"
    [[ "$rest" != "$json" ]] || return 1
    while :; do
        # Skip whitespace after the colon.
        rest="${rest#"${rest%%[![:space:]]*}"}"
        if [[ "$rest" == \"*\"* ]]; then
            rest="${rest#\"}"
            echo "${rest%%\"*}"
            return 0
        fi
        value="${rest#*\"$field\":}"
        [[ "$value" != "$rest" ]] || return 1
        rest="$value"
    done
}

# Extract a token from a remote CONFLICT response line: the run of
# non-whitespace characters after "key=".  The legacy regex was unanchored
# and required at least one non-whitespace character, so a "key=" that is
# immediately followed by whitespace is skipped in favor of any later
# occurrence.  Prints the token; returns 1 when no occurrence matches.
_zfslock_conflict_field() {
    local line="$1" key="$2"
    local rest="$line" value
    while :; do
        value="${rest#*"$key"=}"
        [[ "$value" != "$rest" ]] || return 1
        rest="${value%%[[:space:]]*}"
        if [[ -n "$rest" ]]; then
            printf '%s\n' "$rest"
            return 0
        fi
        rest="$value"
    done
}

# ==============================================================================
# Internal Helper Functions
# ==============================================================================

# URL-encode a dataset path for safe use as filename
# Usage: encoded=$(_zfslock_encode "pool/dataset")
_zfslock_encode() {
    local path="$1"
    # Encode / as %2F and @ as %40
    path="${path//\//%2F}"
    path="${path//@/%40}"
    echo "$path"
}

# Get the lock file path for a dataset
# Usage: lockfile=$(_zfslock_file "pool/dataset")
_zfslock_file() {
    local dataset="$1"
    local encoded
    encoded=$(_zfslock_encode "$dataset")
    echo "$zfslock_locks_dir/${encoded}.lock"
}

# Get the PID tracking file path
# Usage: pidfile=$(_zfslock_pidfile)
_zfslock_pidfile() {
    echo "$zfslock_pids_dir/$$"
}

# Get the script name of the caller
_zfslock_scriptname() {
    local script="${BASH_SOURCE[-1]}"
    basename "$script"
}

# Check if two lock types conflict at the same level
# Usage: _zfslock_types_conflict "w" "r" && echo "conflict"
_zfslock_types_conflict() {
    local type1="$1" type2="$2"
    case "$type1" in
        r)  [[ "$type2" == "w" || "$type2" == "x" ]] ;;
        w|x) [[ "$type2" == "r" || "$type2" == "w" || "$type2" == "x" ]] ;;
        *)  return 1 ;;
    esac
}

# Check if requested type conflicts with existing lock considering hierarchy
# Usage: _zfslock_hierarchy_conflict "requested_type" "existing_type" "relationship"
# relationship: "same", "ancestor", "descendant"
_zfslock_hierarchy_conflict() {
    local requested="$1"
    local existing="$2"
    local relationship="$3"

    case "$relationship" in
        same)
            # Same dataset: use normal conflict rules
            _zfslock_types_conflict "$requested" "$existing"
            ;;
        ancestor)
            # We want to lock a child, check if ancestor lock blocks us
            # x on ancestor blocks everything on descendants
            # w on ancestor blocks w, x on descendants
            # r on ancestor blocks x on descendants
            case "$existing" in
                x)  return 0 ;;  # Ancestor destroy blocks all
                w)  [[ "$requested" == "w" || "$requested" == "x" ]] ;;
                r)  [[ "$requested" == "x" ]] ;;
                *)  return 1 ;;
            esac
            ;;
        descendant)
            # We want to lock a parent, check if descendant lock blocks us
            # Any lock on descendant blocks x on ancestor
            # w, x on descendant blocks w on ancestor
            # x on descendant blocks r on ancestor
            case "$requested" in
                x)  return 0 ;;  # Any descendant lock blocks destroy
                w)  [[ "$existing" == "w" || "$existing" == "x" ]] ;;
                r)  [[ "$existing" == "x" ]] ;;
                *)  return 1 ;;
            esac
            ;;
        *)
            return 1
            ;;
    esac
}

# Read lock file and extract a field using simple parsing (no jq dependency)
# Usage: value=$(_zfslock_read_field "lockfile" "fieldname")
# String values are quoted and non-empty ("field": "value"); numeric values
# are a run of digits after "field": and optional whitespace.  The legacy
# regexes were unanchored, so if the first "field": occurrence does not
# match, later occurrences are tried.  The string form is tried across the
# whole blob before the numeric form.
_zfslock_read_field() {
    local lockfile="$1" field="$2"
    [[ -f "$lockfile" ]] || return 1
    local content
    content=$(<"$lockfile")
    local rest value
    # Pass 1: string values.
    rest="${content#*\"$field\":}"
    [[ "$rest" != "$content" ]] || return 1
    while :; do
        rest="${rest#"${rest%%[![:space:]]*}"}"
        if [[ "$rest" == \"*\"* ]]; then
            value="${rest#\"}"
            value="${value%%\"*}"
            if [[ -n "$value" ]]; then
                echo "$value"
                return 0
            fi
        fi
        value="${rest#*\"$field\":}"
        [[ "$value" != "$rest" ]] || break
        rest="$value"
    done
    # Pass 2: numeric values.
    rest="${content#*\"$field\":}"
    while :; do
        rest="${rest#"${rest%%[![:space:]]*}"}"
        if [[ "$rest" =~ ^[0-9]+ ]]; then
            echo "${BASH_REMATCH[0]}"
            return 0
        fi
        value="${rest#*\"$field\":}"
        [[ "$value" != "$rest" ]] || return 1
        rest="$value"
    done
}

# EXIT trap handler
_zfslock_cleanup_trap() {
    zfslock_release_all
}

# ==============================================================================
# Public Functions
# ==============================================================================

# Initialize the lock manager
# Creates lock directories and sets up EXIT trap for automatic cleanup
zfslock_init() {
    local dir
    for dir in "$zfslock_locks_dir" "$zfslock_pids_dir"; do
        if [[ ! -d "$dir" ]]; then
            mkdir -p "$dir" || { log_msg "WARN: Unable to create directory $dir"; return 2; }
        fi
    done
    # Load two-node configuration on first use.
    if [[ -z "${_zfslock_this_host:-}" ]]; then
        _zfslock_load_node_config
    fi
    trap _zfslock_cleanup_trap EXIT
}

# Check if a lock file represents a stale lock
# Returns: 0 if stale (lock can be removed), 1 if active (lock is valid)
zfslock_is_stale() {
    local lockfile="$1" pid cmdline lock_script
    [[ -f "$lockfile" ]] || return 0
    pid=$(_zfslock_read_field "$lockfile" "pid") || return 0
    kill -0 "$pid" 2>/dev/null || return 0
    lock_script=$(_zfslock_read_field "$lockfile" "script") || return 1
    if [[ -f "/proc/$pid/cmdline" ]]; then
        cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline")
        # A live process may have an empty cmdline briefly after fork. Treat an
        # empty cmdline as inconclusive and leave the lock alone; only mark stale
        # when we can read a non-empty cmdline and the script is absent.
        [[ -z "${cmdline// }" ]] && return 1
        [[ "$cmdline" == *"$lock_script"* ]] || return 0
    fi
    return 1
}

# Remove all stale locks
zfslock_cleanup_stale() {
    local lockfile removed=0
    [[ -d "$zfslock_locks_dir" ]] || return 0
    for lockfile in "$zfslock_locks_dir"/*.lock; do
        [[ -f "$lockfile" ]] || continue
        if zfslock_is_stale "$lockfile"; then
            rm -f "$lockfile"
            ((removed++))
        fi
    done
    local pidfile
    for pidfile in "$zfslock_pids_dir"/*; do
        [[ -f "$pidfile" ]] || continue
        kill -0 "$(basename "$pidfile")" 2>/dev/null || rm -f "$pidfile"
    done
    if [[ $removed -gt 0 ]]; then
        log_msg "INFO: Removed $removed stale lock(s)"
    fi
    return 0
}

# Check a single lock file for conflict or re-entry.
# Returns: 0 = no conflict (keep checking), 1 = conflict, 2 = re-entry
_zfslock_check_file() {
    local lockfile="$1"
    local requested_type="$2"
    local relationship="$3"
    local existing_pid existing_type

    if [[ ! -f "$lockfile" ]]; then
        return 0
    fi

    existing_pid=$(_zfslock_read_field "$lockfile" "pid")
    if [[ "$existing_pid" == "$$" ]]; then
        zfslock_reentry="$lockfile"
        return 2
    fi

    existing_type=$(_zfslock_read_field "$lockfile" "type")
    if _zfslock_hierarchy_conflict "$requested_type" "$existing_type" "$relationship"; then
        zfslock_conflict_info="$lockfile"
        return 1
    fi
    return 0
}

# Check for lock conflicts on a dataset
# Returns: 0 if no conflict, 1 if conflict exists
# Sets: $zfslock_conflict_info with details about the conflicting lock
_zfslock_check_one() {
    local lockfile="$1" type="$2" relationship="$3"
    _zfslock_check_file "$lockfile" "$type" "$relationship"
    local rc=$?
    [[ $rc -ne 0 ]] && return $(( rc == 2 ? 0 : rc ))
    return 0
}

zfslock_check() {
    local dataset="$1" type="$2" lockfile
    local remote_host

    zfslock_conflict_info=""
    zfslock_reentry=""

    if [[ -z "$dataset" || -z "$type" ]]; then
        log_msg "WARN: zfslock_check requires dataset and type"
        return 2
    fi

    # Two-node: storage-owned dataset locks are checked on the storage node.
    remote_host=$(_zfslock_remote_host_for_dataset "$dataset")
    if [[ -n "$remote_host" ]]; then
        _zfslock_remote_check "$dataset" "$type"
        return $?
    fi

    zfslock_cleanup_stale

    lockfile=$(_zfslock_file "$dataset")
    _zfslock_check_one "$lockfile" "$type" "same" || return $?

    local parent="$dataset"
    while [[ "$parent" == */* ]]; do
        parent="${parent%/*}"
        lockfile=$(_zfslock_file "$parent")
        _zfslock_check_one "$lockfile" "$type" "ancestor" || return $?
    done

    if [[ "$dataset" == */* ]]; then
        local pool="${dataset%%/*}"
        lockfile=$(_zfslock_file "$pool")
        _zfslock_check_one "$lockfile" "$type" "ancestor" || return $?
    fi

    local dataset_encoded
    dataset_encoded=$(_zfslock_encode "$dataset")
    for lockfile in "$zfslock_locks_dir"/"${dataset_encoded}%2F"*.lock; do
        [[ -f "$lockfile" ]] || continue
        _zfslock_check_one "$lockfile" "$type" "descendant" || return $?
    done
}

# Acquire a lock on a dataset
# Returns: 0=success, 1=conflict, 2=error
# Sets: $zfslock_id on success (the lock file path)
# Acquire a lock on a remote storage node. This is the compute-side half of
# two-node locking: it asks the storage-side zfslockmanager-remote agent to
# hold the lock and keeps the SSH session alive until release.
_zfslock_remote_acquire() {
    local dataset="$1"
    local type="$2"
    local description="${3:-}"
    local host remote_agent remote_lockfile
    local tmpfile ssh_pid line

    host=$(_zfslock_remote_host_for_dataset "$dataset") || return 2
    if [[ -z "$host" ]]; then
        return 2
    fi

    remote_lockfile="$zfslock_locks_dir/$(_zfslock_encode "$dataset").lock"

    # Re-entrant remote lock (same process already holds it).
    if [[ -n "${_zfslock_remote_pids[$remote_lockfile]:-}" ]]; then
        zfslock_id="REENTRY:REMOTE:$remote_lockfile"
        return 0
    fi

    remote_agent=$(_zfslock_remote_agent "$host") || return 2

    tmpfile=$(mktemp "${zfslock_locks_dir}/.remote-acquire.XXXXXX") || return 2

    local remote_cmd
    remote_cmd=\
"$remote_agent hold $(printf '%q' "$dataset") $(printf '%q' "$type") $(printf '%q' "$description")"

    _zfslock_remote_ssh_pid=""
    _zfslock_remote_spawn "$host" "$remote_cmd" "$tmpfile"
    ssh_pid=$_zfslock_remote_ssh_pid

    # Wait for the agent to respond (up to 30 seconds).
    local elapsed=0 timeout=300
    while [[ $elapsed -lt $timeout ]]; do
        if [[ -s "$tmpfile" ]]; then
            break
        fi
        if ! kill -0 "$ssh_pid" 2>/dev/null; then
            break
        fi
        sleep 0.1
        elapsed=$((elapsed + 1))
    done

    if [[ ! -s "$tmpfile" ]]; then
        kill "$ssh_pid" 2>/dev/null
        wait "$ssh_pid" 2>/dev/null
        rm -f "$tmpfile"
        log_msg "WARN: Remote lock acquisition timed out for $dataset"
        return 2
    fi

    read -r line < "$tmpfile"
    rm -f "$tmpfile"

    if [[ "$line" == LOCKED\ * ]]; then
        remote_lockfile="${line#LOCKED }"
        _zfslock_remote_pids[$remote_lockfile]=$ssh_pid
        _zfslock_remote_hosts[$remote_lockfile]=$host
        zfslock_id="REMOTE:$remote_lockfile"
        return 0
    fi

    if [[ "$line" == CONFLICT* ]]; then
        local c_dataset="" c_type="" c_pid="" c_script=""
        c_dataset=$(_zfslock_conflict_field "$line" "dataset") || c_dataset=""
        c_type=$(_zfslock_conflict_field "$line" "type") || c_type=""
        c_pid=$(_zfslock_conflict_field "$line" "pid") || c_pid=""
        c_script=$(_zfslock_conflict_field "$line" "script") || c_script=""
        zfslock_conflict_info=$(_zfslock_remote_conflict_file \
            "$c_dataset" "$c_type" "$c_pid" "$c_script" "" "" "$host" "")
        return 1
    fi

    kill "$ssh_pid" 2>/dev/null
    wait "$ssh_pid" 2>/dev/null
    log_msg "WARN: Unexpected response from remote lock agent: $line"
    return 2
}

# Check for conflicts on a remote storage node.
_zfslock_remote_check() {
    local dataset="$1"
    local type="$2"
    local host remote_agent output

    host=$(_zfslock_remote_host_for_dataset "$dataset") || return 2
    if [[ -z "$host" ]]; then
        return 2
    fi

    remote_agent=$(_zfslock_remote_agent "$host") || return 2
    output=$(_zfslock_remote_exec "$host" \
        "$remote_agent check $(printf '%q' "$dataset") $(printf '%q' "$type")" \
        2>/dev/null)

    if [[ "$output" == *'"available": true'* ]]; then
        return 0
    fi

    local json="$output"
    local c_dataset c_type c_pid c_script c_acquired c_description
    c_dataset=$(_zfslock_json_str_field "$json" "dataset") || c_dataset=""
    c_type=$(_zfslock_json_str_field "$json" "type") || c_type=""
    c_pid=$(_zfslock_json_str_field "$json" "pid") || c_pid=""
    c_script=$(_zfslock_json_str_field "$json" "script") || c_script=""
    c_acquired=$(_zfslock_json_str_field "$json" "acquired") || c_acquired=""
    c_description=$(_zfslock_json_str_field "$json" "description") || c_description=""

    zfslock_conflict_info=$(_zfslock_remote_conflict_file \
        "$c_dataset" "$c_type" "$c_pid" "$c_script" \
        "$c_acquired" "$c_description" "$host" "")
    return 1
}

# Force-release a lock on the remote storage node.
_zfslock_remote_force_release() {
    local host="$1"
    local lockfile="$2"
    local remote_agent

    remote_agent=$(_zfslock_remote_agent "$host") || return 1
    _zfslock_remote_exec "$host" "$remote_agent release $(printf '%q' "$lockfile")" >/dev/null 2>&1
}

zfslock_acquire() {
    local dataset="$1"
    local type="$2"
    local description="${3:-}"
    local lockfile
    local timestamp
    local script
    local remote_host

    zfslock_id=""
    zfslock_reentry=""

    if [[ -z "$dataset" || -z "$type" ]]; then
        log_msg "WARN: zfslock_acquire requires dataset and type"
        return 2
    fi

    # Regex: ^[rwx]$
    # Purpose: Validate that the lock type is one of the allowed single-letter codes.
    # Examples: "r" -> match; "w" -> match; "x" -> match; "rw" -> no match
    if [[ ! "$type" =~ ^[rwx]$ ]]; then
        log_msg "WARN: Invalid lock type '$type'. Must be r, w, or x."
        return 2
    fi

    # Ensure directories exist
    if [[ ! -d "$zfslock_locks_dir" ]]; then
        zfslock_init || return 2
    fi

    # Two-node: forward storage-owned dataset locks to the storage node.
    remote_host=$(_zfslock_remote_host_for_dataset "$dataset")
    if [[ -n "$remote_host" ]]; then
        _zfslock_remote_acquire "$dataset" "$type" "$description"
        return $?
    fi

    # Check for conflicts
    if ! zfslock_check "$dataset" "$type"; then
        return 1  # Conflict exists
    fi

    # Handle re-entrant locking (same PID already holds the lock)
    if [[ -n "$zfslock_reentry" ]]; then
        # Mark as reentry so release knows not to actually release
        zfslock_id="REENTRY:$zfslock_reentry"
        return 0  # Reuse existing lock
    fi

    lockfile=$(_zfslock_file "$dataset")
    local timestamp script
    timestamp=$(date -Iseconds)
    script=$(_zfslock_scriptname)
    local tmpfile="${lockfile}.tmp.$$"
    {
        printf '{"dataset":"%s","type":"%s","pid":%s,"script":"%s",' \
            "$dataset" "$type" "$$" "$script"
        printf '"acquired":"%s","description":"%s"}\n' \
            "$timestamp" "$description"
    } > "$tmpfile" || {
        rm -f "$tmpfile"
        log_msg "WARN: Failed to create lock file $lockfile"
        return 2
    }
    mv -f "$tmpfile" "$lockfile" || {
        rm -f "$tmpfile"; log_msg "WARN: Failed to install lock file $lockfile"; return 2; }

    # Track this lock in the PID file
    local pidfile
    pidfile=$(_zfslock_pidfile)
    echo "$lockfile" >> "$pidfile"

    zfslock_id="$lockfile"
    return 0
}

# Acquire locks on multiple datasets in a deadlock-free order.
# Returns: 0=success, 1=conflict, 2=error
# Sets: zfslock_ids array with the lock-file paths of all acquired locks.
zfslock_acquire_multiple() {
    local type="$1"
    shift
    local -a datasets=("$@")
    local -a sorted=()
    local -a kept=()
    local -a acquired=()
    local ds i j held
    local depth slashes

    zfslock_ids=()

    if [[ -z "$type" || ${#datasets[@]} -eq 0 ]]; then
        log_msg "WARN: zfslock_acquire_multiple requires a type and at least one dataset"
        return 2
    fi

    if [[ ! "$type" =~ ^[rwx]$ ]]; then
        log_msg "WARN: Invalid lock type '$type'. Must be r, w, or x."
        return 2
    fi

    # Sort by path depth (shallowest first), then lexicographically.
    local -a sort_keys=()
    for ds in "${datasets[@]}"; do
        slashes="${ds//[^\/]/}"
        depth=${#slashes}
        sort_keys+=("$(printf '%08d\t%s' "$depth" "$ds")")
    done

    readarray -t sorted < <(
        printf '%s\n' "${sort_keys[@]}" | sort -k1,1n -k2,2 | cut -f2-
    )

    # Remove ancestor paths that have a descendant also requested.
    # Keep only the most specific (deepest) dataset.
    for ((i = 0; i < ${#sorted[@]}; i++)); do
        ds="${sorted[i]}"
        local redundant=0
        for ((j = i + 1; j < ${#sorted[@]}; j++)); do
            if [[ "${sorted[j]}" == "$ds" || "${sorted[j]}" == "${ds}/"* ]]; then
                redundant=1
                break
            fi
        done
        if [[ $redundant -eq 0 ]]; then
            kept+=("$ds")
        fi
    done

    # Acquire all locks in order, rolling back on any failure.
    for ds in "${kept[@]}"; do
        if zfslock_acquire "$ds" "$type"; then
            acquired+=("$zfslock_id")
        else
            local fail_rc=$?
            for held in "${acquired[@]}"; do
                zfslock_release "$held"
            done
            return "$fail_rc"
        fi
    done

    # shellcheck disable=SC2034
    zfslock_ids=("${acquired[@]}")
    return 0
}

# Release a specific lock
zfslock_release() {
    local lock_id="$1"
    local remote_lockfile ssh_pid

    if [[ -z "$lock_id" ]]; then
        log_msg "WARN: zfslock_release requires a lock_id"
        return 2
    fi

    # Remote locks are held by an SSH session on the storage node.
    if [[ "$lock_id" == REMOTE:* ]]; then
        remote_lockfile="${lock_id#REMOTE:}"
        ssh_pid="${_zfslock_remote_pids[$remote_lockfile]:-}"
        remote_host="${_zfslock_remote_hosts[$remote_lockfile]:-}"
        if [[ -n "$ssh_pid" ]]; then
            kill "$ssh_pid" 2>/dev/null
            wait "$ssh_pid" 2>/dev/null
            unset "_zfslock_remote_pids[$remote_lockfile]"
        fi
        # Ensure the lock file is removed even if the holder process could not
        # be signalled cleanly.
        if [[ -n "$remote_host" ]]; then
            _zfslock_remote_force_release "$remote_host" "$remote_lockfile" 2>/dev/null || true
        fi
        unset "_zfslock_remote_hosts[$remote_lockfile]"
        rm -f "$lock_id"
        return 0
    fi

    [[ "$lock_id" == REENTRY:* ]] && return 0
    [[ -f "$lock_id" ]] || return 0

    local lock_pid
    lock_pid=$(_zfslock_read_field "$lock_id" "pid")
    if [[ "$lock_pid" != "$$" ]]; then
        log_msg "WARN: Cannot release lock owned by PID $lock_pid (we are $$)"
        return 1
    fi

    rm -f "$lock_id"

    local pidfile
    pidfile=$(_zfslock_pidfile)
    if [[ -f "$pidfile" ]]; then
        local temp
        temp=$(grep -v "^${lock_id}$" "$pidfile" 2>/dev/null)
        if [[ -n "$temp" ]]; then
            echo "$temp" > "$pidfile"
        else
            rm -f "$pidfile"
        fi
    fi
}

# Release all locks held by current PID
zfslock_release_all() {
    local pidfile
    pidfile=$(_zfslock_pidfile)
    local lockfile
    [[ -f "$pidfile" ]] || return 0
    while IFS= read -r lockfile; do
        [[ -n "$lockfile" && -f "$lockfile" ]] && rm -f "$lockfile"
    done < "$pidfile"
    rm -f "$pidfile"

    # Terminate any remote lock-holder SSH sessions.
    for remote_lockfile in "${!_zfslock_remote_pids[@]}"; do
        ssh_pid="${_zfslock_remote_pids[$remote_lockfile]}"
        remote_host="${_zfslock_remote_hosts[$remote_lockfile]:-}"
        if [[ -n "$ssh_pid" ]]; then
            kill "$ssh_pid" 2>/dev/null
            wait "$ssh_pid" 2>/dev/null
        fi
        if [[ -n "$remote_host" ]]; then
            _zfslock_remote_force_release "$remote_host" "$remote_lockfile" 2>/dev/null || true
        fi
    done
    _zfslock_remote_pids=()
    _zfslock_remote_hosts=()
}

# Determine whether interactive conflict resolution is safe.
# Returns 0 (true) when stdin is a TTY and headless mode is not forced.
_zfslock_is_interactive() {
    [[ -t 0 && "$ZFSUTILITIES_HEADLESS" != "Y" ]]
}

# Interactive conflict resolution
# Returns: 0=lock acquired, 1=user aborted, 2=user skipped
zfslock_wait_or_resolve() {
    local dataset="$1"
    local type="$2"
    local description="${3:-}"
    local _first_pass=1
    local _wait_interval="${ZFSLOCK_WAIT_INTERVAL:-30}"
    [[ "$_wait_interval" =~ ^[0-9]+$ && $_wait_interval -ge 1 ]] || _wait_interval=1

    # In headless mode, optionally wait up to this many seconds before aborting.
    # A value of 0 (the default) keeps the legacy immediate-abort behavior.
    local _headless_wait_seconds="${ZFSLOCK_HEADLESS_WAIT_SECONDS:-0}"
    [[ "$_headless_wait_seconds" =~ ^[0-9]+$ ]] || _headless_wait_seconds=0
    local _headless_deadline=""
    if [[ $_headless_wait_seconds -gt 0 ]]; then
        _headless_deadline=$(($(date +%s) + _headless_wait_seconds))
    fi

    while true; do
        # Throttle repeated acquisition attempts so a closed stdin or a
        # rapidly-reacquired lock cannot spin the CPU.
        if [[ $_first_pass -eq 0 ]]; then
            sleep 1
        fi

        # Try to acquire the lock
        if zfslock_acquire "$dataset" "$type" "$description"; then
            return 0
        fi
        _first_pass=0

        # Conflict exists
        local lockfile="$zfslock_conflict_info"

        # In non-interactive/headless mode, either wait for the lock or abort.
        if ! _zfslock_is_interactive; then
            if [[ -n "$_headless_deadline" ]]; then
                local _now
                _now=$(date +%s)
                if [[ $_now -ge $_headless_deadline ]]; then
                    log_msg "FATAL: Lock conflict on '$dataset' in non-interactive mode; " \
                        "waited ${_headless_wait_seconds}s. Aborting."
                    return 1
                fi
                sleep "$_wait_interval"
                _first_pass=1
                continue
            fi
            log_msg "FATAL: Lock conflict on '$dataset' in non-interactive mode. Aborting."
            return 1
        fi

        # Before prompting, make sure the conflicting lock is not stale.
        if [[ -n "$lockfile" ]] && zfslock_is_stale "$lockfile"; then
            local stale_dataset
            stale_dataset=$(_zfslock_read_field "$lockfile" "dataset") || stale_dataset="$dataset"
            rm -f "$lockfile"
            log_msg "INFO: Removed stale lock on $stale_dataset; retrying acquisition."
            continue
        fi

        # Display conflict info and prompt user
        local lock_dataset lock_type lock_pid lock_script lock_acquired lock_desc
        local relative_time

        lock_dataset=$(_zfslock_read_field "$lockfile" "dataset")
        lock_type=$(_zfslock_read_field "$lockfile" "type")
        lock_pid=$(_zfslock_read_field "$lockfile" "pid")
        lock_script=$(_zfslock_read_field "$lockfile" "script")
        lock_acquired=$(_zfslock_read_field "$lockfile" "acquired")
        lock_desc=$(_zfslock_read_field "$lockfile" "description")
        local acquired_epoch
        acquired_epoch=$(date -d "$lock_acquired" +%s 2>/dev/null) || acquired_epoch=""
        local diff_seconds
        diff_seconds=$(($(date +%s) - acquired_epoch))
        local relative_time
        if [[ $diff_seconds -lt 60 ]]; then
            relative_time="${diff_seconds} seconds ago"
        elif [[ $diff_seconds -lt 3600 ]]; then
            relative_time="$((diff_seconds / 60)) minutes ago"
        elif [[ $diff_seconds -lt 86400 ]]; then
            relative_time="$((diff_seconds / 3600)) hours ago"
        else
            relative_time="$((diff_seconds / 86400)) days ago"
        fi

        local type_name
        case "$lock_type" in
            r) type_name="read" ;;
            w) type_name="write" ;;
            x) type_name="destroy" ;;
            *) type_name="$lock_type" ;;
        esac

        echo ""
        echo "CONFLICT: A lock could not be acquired for '$dataset' because another task is using" \
            "the dataset or a related dataset."
        echo "  Locked dataset: $lock_dataset"
        echo "  Script: $lock_script (PID $lock_pid)"
        echo "  Type: $type_name"
        echo "  Since: $lock_acquired ($relative_time)"
        if [[ -n "$lock_desc" ]]; then
            echo "  Description: $lock_desc"
        fi
        echo ""
        echo "Options:"
        echo "  [W] Wait and retry (checks every $_wait_interval seconds)"
        echo "  [R] Retry now (re-check immediately)"
        echo "  [S] Skip this dataset and continue"
        echo "  [A] Abort entire operation"
        echo "  [F] Force release lock (DANGEROUS - may corrupt data)"
        echo ""

        local choice
        read -rp "Choice [W/R/S/A/F]: " choice

        case "${choice^^}" in
            W|"")
                echo "Waiting for lock; checking every $_wait_interval seconds. Press Ctrl+C to" \
                    "stop waiting."
                local _wait_interrupted=0
                local _prev_int_trap
                _prev_int_trap=$(trap -p INT)
                trap '_wait_interrupted=1' INT
                while [[ $_wait_interrupted -eq 0 ]]; do
                    sleep "$_wait_interval"
                    if zfslock_check "$dataset" "$type" >/dev/null 2>&1; then
                        echo "Lock is now available."
                        break
                    fi
                done
                eval "$_prev_int_trap" 2>/dev/null || true
                if [[ $_wait_interrupted -eq 1 ]]; then
                    echo "Wait interrupted."
                fi
                # Loop will retry acquisition
                ;;
            R)
                _first_pass=1  # Retry immediately; throttle only on repeated failures
                continue
                ;;
            S)
                return 2  # Skip current dataset only
                ;;
            A)
                return 1  # Abort operation (caller decides scope)
                ;;
            F)
                echo "WARNING: Force-releasing a lock may cause data corruption!"
                read -rp "Are you sure? Type 'yes' to confirm: " confirm
                if [[ "$confirm" == "yes" ]]; then
                    local remote_host="" remote_lockfile=""
                    remote_host=$(_zfslock_read_field "$lockfile" "remote_host") || remote_host=""
                    remote_lockfile=$(_zfslock_read_field "$lockfile" "remote_lockfile") \
                        || remote_lockfile=""
                    if [[ -n "$remote_host" && -n "$remote_lockfile" ]]; then
                        if _zfslock_remote_force_release "$remote_host" "$remote_lockfile"; then
                            log_msg "WARN: Force-released remote lock on $lock_dataset " \
                                "(was held by $lock_script PID $lock_pid on $remote_host)"
                        else
                            echo "Force release of remote lock failed; it may already be gone."
                        fi
                    else
                        rm -f "$lockfile"
                        log_msg "WARN: Force-released lock on $lock_dataset" \
                            "(was held by $lock_script PID $lock_pid)"
                    fi
                    # Loop will retry to acquire
                else
                    echo "Force release cancelled."
                fi
                ;;
            *)
                echo "Invalid choice. Please enter W, R, S, A, or F."
                ;;
        esac
    done
}
