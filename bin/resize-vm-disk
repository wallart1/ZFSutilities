#!/usr/bin/bash
# resize-vm-disk <pool> <vmid> <disk-num> <new-size>
# Grows a zvol and triggers a rescan so the compute host sees the new size.
#
# Install to: /usr/local/lib/zfsutilities/bin/resize-vm-disk on BOTH the storage and compute hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)
#
# NOTE: ZFS supports online growth only. Shrinking is not supported.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)

usage() {
    local pool_choices
    if is_two_node; then
        pool_choices=$(pool_list | paste -sd '|' -)
    else
        pool_choices=$(zpool list -H -o name 2>/dev/null | paste -sd '|' -)
    fi
    log_msg "INFO: Usage: resize-vm-disk <pool> <vmid> <disk-num> <new-size>"
    echo ""
    log_msg "INFO:   pool      ZFS pool name (${pool_choices})"
    log_msg "INFO:   vmid      Proxmox VM ID"
    log_msg "INFO:   disk-num  Disk number"
    log_msg "INFO:   new-size  TOTAL size after resize — not an increment (e.g. 200G, 1T)"
    echo ""
    log_msg "INFO:   NOTE: Specify the final size you want, not the amount to add."
    log_msg "INFO:         This is different from the Proxmox GUI, which asks for an increment."
    log_msg "INFO:         ZFS only supports growing, not shrinking."
    echo ""
    log_msg "INFO:   To find the current size first: sudo list-vm-disks"
    echo ""
    log_msg "INFO: Example: disk is currently 100G, you want it to be 200G:"
    log_msg "INFO:   resize-vm-disk threeamigos 300 1 200G"
    exit 1
}

# Filter --skip-rescan from args
skip_rescan=false
clean_args=()
for arg in "$@"; do
    [[ "$arg" == "--skip-rescan" ]] && skip_rescan=true || clean_args+=("$arg")
done
set -- "${clean_args[@]}"

# --- Argument validation ---
[[ $# -eq 4 ]] || usage

pool="$1"
vmid="$2"
disknum="$3"
newsize="$4"

if is_two_node; then
    is_known_pool "$pool" || {
        log_msg "FATAL: Pool must be one of: $(pool_list | paste -sd ' ' -). Got: $pool"
        exit 1
    }
else
    zpool list -H -o name "$pool" >/dev/null 2>&1 || {
        log_msg "FATAL: Pool '$pool' not found. Available pools:" \
            "$(zpool list -H -o name 2>/dev/null | paste -sd ' ' -)"
        exit 1
    }
fi
[[ "$vmid" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $vmid"
    exit 1
}
[[ "$disknum" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: disk-num must be a number, got: $disknum"
    exit 1
}
# Size must be an integer or decimal number followed by a KMGTP unit
# (e.g. 200G, 1T, 10.5G). Validated with parameter expansion, not regex.
size_unit="${newsize: -1}"
size_number="${newsize%"${size_unit}"}"
size_int="${size_number%%.*}"
size_frac="${size_number#"${size_int}"}"
valid_size=false
if [[ "${size_unit}" == [KMGTP] && "${size_int}" =~ ^[0-9]+$ ]]; then
    if [[ -z "${size_frac}" || "${size_frac}" =~ ^\.[0-9]+$ ]]; then
        valid_size=true
    fi
fi
[[ "${valid_size}" == true ]] || {
    log_msg "FATAL: new-size must be a total size like 200G or 1T (not an increment), got: $newsize"
    exit 1
}

# --- If not on the storage host, delegate storage work via SSH (two-node only) ---
if is_two_node && [[ "$my_host" != "$storage_host" ]]; then
    log_msg "INFO: Connecting to $storage_host for storage operations..."
    remote_script=$(remote_zfsutility_script "$storage_host" "resize-vm-disk")
    ssh root@"$storage_host" "$remote_script '$pool' '$vmid' '$disknum' '$newsize' --skip-rescan" \
        || {
            log_msg "FATAL: Storage operations failed on $storage_host"
            exit 1
        }
    echo ""
    log_msg "INFO: Rescanning iSCSI on $(hostname)..."
    if [[ "$my_host" == "$compute_host" ]]; then
        "$mydir/rescan-storage"
    else
        remote_rescan=$(remote_zfsutility_script "$compute_host" "rescan-storage")
        ssh root@"$compute_host" "$remote_rescan" 2>&1 \
            || log_msg "WARN: Could not rescan $compute_host — run 'sudo rescan-storage'" \
                "on $compute_host manually"
    fi
    exit 0
fi

# === Running on the storage host ===

zvol_name="$pool/proxmox/vm-${vmid}-disk-${disknum}"

log_msg "INFO: === resize-vm-disk ==="
log_msg "INFO:   Zvol:       $zvol_name"
log_msg "INFO:   Total size: $newsize  (this is the final size, not an increment)"
echo ""

# --- Check zvol exists ---
if ! zfs list -H -o name "$zvol_name" 2>/dev/null | grep -q .; then
    log_msg "FATAL: Zvol does not exist: $zvol_name"
    exit 1
fi

current_size=$(zfs get -H -o value volsize "$zvol_name")
log_msg "INFO:   Current size: $current_size"
echo ""

# --- Grow zvol ---
zfslock_init
if ! zfslock_wait_or_resolve "$zvol_name" "w" "resize-vm-disk"; then
    log_msg "FATAL: Could not acquire write lock on ${zvol_name}"
    exit 1
fi

log_msg "INFO: Resizing zvol to $newsize..."
zfs set volsize="$newsize" "$zvol_name"
zfslock_release "$zfslock_id"
log_msg "INFO: ✓ Zvol resized"

new_actual=$(zfs get -H -o value volsize "$zvol_name")
log_msg "INFO:   New size: $new_actual"

# --- Trigger rescan on the compute host (two-node only, unless called remotely) ---
if is_two_node && [[ "$skip_rescan" == false ]]; then
    log_msg "INFO: Triggering iSCSI rescan on $compute_host..."
    remote_rescan=$(remote_zfsutility_script "$compute_host" "rescan-storage")
    if ssh -o ConnectTimeout=10 root@"$compute_host" "$remote_rescan" 2>&1; then
        log_msg "INFO: ✓ Rescan triggered"
    else
        log_msg "WARN: Could not reach $compute_host — run 'sudo rescan-storage'" \
            "on $compute_host manually"
    fi
fi

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   $zvol_name"
log_msg "INFO:   Before: $current_size  →  After: $new_actual"
echo ""
log_msg "INFO: Next steps inside the VM:"
log_msg "INFO:   Resize the partition and filesystem (growpart, resize2fs, etc.)"
