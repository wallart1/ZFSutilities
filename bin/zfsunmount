#!/usr/bin/bash
# $1    The subtree to work with

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
source_helper zfslockmanager

rootcheck
zfslock_init

readarray -t fsarray < <(zfs list -Hrt filesystem -o name "$1")

for fs in "${fsarray[@]}"; do
    lock_rc=""
    zfslock_wait_or_resolve "$fs" "w" "zfsunmount"
    lock_rc=$?
    if [[ $lock_rc -ne 0 ]]; then
        if [[ $lock_rc -eq 2 ]]; then
            log_msg "WARN: Skipping ${fs} (user skipped lock acquisition)."
            continue
        fi
        log_msg "FATAL: Could not acquire write lock on ${fs}; aborting."
        exit 8
    fi
    fs_lock="$ZFSLOCK_ID"
    if ! zfs unmount "$fs"; then
        log_msg "WARN: Unable to unmount ${fs}"
    fi
    zfslock_release "$fs_lock" || true
done
