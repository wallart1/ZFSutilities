#!/usr/bin/bash
# remove-vm-disk <pool> <vmid> <disk-num>
# Removes an iSCSI LUN and destroys the backing zvol.
#
# Install to: /usr/local/lib/zfsutilities/bin/remove-vm-disk on BOTH the storage and compute hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)
#
# WARNING: Stop the VM and detach the disk in Proxmox BEFORE running this script.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)

usage() {
    local pool_choices
    if is_two_node; then
        pool_choices=$(pool_list | paste -sd '|' -)
    else
        pool_choices=$(zpool list -H -o name 2>/dev/null | paste -sd '|' -)
    fi
    log_msg "INFO: Usage: remove-vm-disk <pool> <vmid> <disk-num>"
    echo ""
    log_msg "INFO:   pool      ZFS pool name (${pool_choices})"
    log_msg "INFO:   vmid      Proxmox VM ID"
    log_msg "INFO:   disk-num  Disk number"
    echo ""
    log_msg "INFO:   WARNING: Stop the VM and remove the disk from Proxmox GUI before running."
    echo ""
    log_msg "INFO: Example: remove-vm-disk threeamigos 300 0"
    exit 1
}

# Filter --skip-rescan from args
skip_rescan=false
clean_args=()
for arg in "$@"; do
    [[ "$arg" == "--skip-rescan" ]] && skip_rescan=true || clean_args+=("$arg")
done
set -- "${clean_args[@]}"

# --- Argument validation ---
[[ $# -eq 3 ]] || usage

pool="$1"
vmid="$2"
disknum="$3"

if is_two_node; then
    is_known_pool "$pool" || {
        log_msg "FATAL: Pool must be one of: $(pool_list | paste -sd ' ' -). Got: $pool"
        exit 1
    }
else
    zpool list -H -o name "$pool" >/dev/null 2>&1 || {
        log_msg "FATAL: Pool '$pool' not found. Available pools:" \
            "$(zpool list -H -o name 2>/dev/null | paste -sd ' ' -)"
        exit 1
    }
fi
[[ "$vmid" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $vmid"
    exit 1
}
[[ "$disknum" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: disk-num must be a number, got: $disknum"
    exit 1
}

# --- If not on the storage host, delegate storage work via SSH (two-node only) ---
if is_two_node && [[ "$my_host" != "$storage_host" ]]; then
    log_msg "INFO: Connecting to $storage_host for storage operations..."
    remote_script=$(remote_zfsutility_script "$storage_host" "remove-vm-disk")
    ssh -t root@"$storage_host" "$remote_script '$pool' '$vmid' '$disknum' --skip-rescan" \
        || {
            log_msg "FATAL: Storage operations failed on $storage_host"
            exit 1
        }
    echo ""
    log_msg "INFO: Rescanning iSCSI on $(hostname)..."
    if [[ "$my_host" == "$compute_host" ]]; then
        "$mydir/rescan-storage"
    else
        remote_rescan=$(remote_zfsutility_script "$compute_host" "rescan-storage")
        ssh root@"$compute_host" "$remote_rescan" 2>&1 \
            || log_msg "WARN: Could not rescan $compute_host — run 'sudo rescan-storage'" \
                "on $compute_host manually"
    fi
    exit 0
fi

# === Running on the storage host ===

zvol_name="$pool/proxmox/vm-${vmid}-disk-${disknum}"
backstore_name="vm-${vmid}-disk-${disknum}"

target=""
if is_two_node; then
    target=$(pool_to_target "$pool") || {
        log_msg "FATAL: Failed to map pool to target: $pool"
        exit 1
    }
fi

log_msg "INFO: === remove-vm-disk ==="
log_msg "INFO:   Zvol:      $zvol_name"
log_msg "INFO:   Backstore: $backstore_name"
if is_two_node; then
    log_msg "INFO:   Target:    $target"
fi
echo ""

# --- Check zvol exists ---
if ! zfs list -H -o name "$zvol_name" 2>/dev/null | grep -q .; then
    log_msg "FATAL: Zvol does not exist: $zvol_name"
    exit 1
fi

zvol_size=$(zfs get -H -o value volsize "$zvol_name" 2>/dev/null || echo "unknown")
log_msg "INFO:   Zvol size: $zvol_size"
echo ""

# --- Confirm before destruction ---
log_msg "WARN: This will PERMANENTLY DESTROY the following:"
log_msg "INFO:   - iSCSI LUN for $backstore_name"
log_msg "INFO:   - Zvol $zvol_name (all data lost)"
echo ""
read -rp "  Have you stopped the VM and removed the disk from Proxmox? (y/N): " response
[[ "$response" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }

read -rp "  Are you sure you want to destroy $zvol_name? (y/N): " response2
[[ "$response2" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }

# --- iSCSI teardown (two-node only) ---
if is_two_node; then
    # --- Find and remove LUN from target ---
    # The selected LUN line starts with "lun<n>"; take the digits that follow.
    lun_line=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
        | grep "$backstore_name" | head -1)
    lun_num=""
    if [[ -n "$lun_line" ]]; then
        lun_num="${lun_line#*lun}"
        lun_num="${lun_num%%[!0-9]*}"
    fi

    if [[ -n "$lun_num" ]]; then
        log_msg "INFO: Removing LUN $lun_num from target..."
        targetcli "/iscsi/${target}/tpg1/luns" delete "lun${lun_num}"
        log_msg "INFO: ✓ LUN removed from target"
    else
        log_msg "WARN: LUN not found in target — skipping LUN removal"
    fi

    # --- Remove backstore ---
    if targetcli /backstores/block ls 2>/dev/null | grep -q " ${backstore_name} "; then
        log_msg "INFO: Removing backstore $backstore_name..."
        targetcli /backstores/block delete "$backstore_name"
        log_msg "INFO: ✓ Backstore removed"
    else
        log_msg "WARN: Backstore $backstore_name not found — skipping"
    fi

    # --- Remove from expected-backstores manifest ---
    manifest="/etc/rtslib-fb-target/expected-backstores.txt"
    if [[ -f "$manifest" ]] && grep -q "^${backstore_name}$" "$manifest"; then
        sed -i "/^${backstore_name}$/d" "$manifest"
        log_msg "INFO: ✓ Removed from expected-backstores manifest"
    fi

    # --- Remove from encrypted LUNs conf if present ---
    encrypted_conf="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
    if [[ ! -e "$encrypted_conf" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
        encrypted_conf="/etc/iscsi-encrypted-luns.conf"
    fi
    if [[ -f "$encrypted_conf" ]] && grep -q "^${backstore_name}:" "$encrypted_conf"; then
        sed -i "/^${backstore_name}:/d" "$encrypted_conf"
        log_msg "INFO: ✓ Removed from encrypted LUNs config"
    fi

    # --- Save targetcli config ---
    log_msg "INFO: Saving iSCSI configuration..."
    "$mydir/safe-iscsi-save"
    log_msg "INFO: ✓ Configuration saved"

    # --- Trigger rescan on the compute host (unless called remotely) ---
    if [[ "$skip_rescan" == false ]]; then
        log_msg "INFO: Triggering iSCSI rescan on $compute_host..."
        remote_rescan=$(remote_zfsutility_script "$compute_host" "rescan-storage")
        if ssh -o ConnectTimeout=10 root@"$compute_host" "$remote_rescan" 2>&1; then
            log_msg "INFO: ✓ Rescan triggered"
        else
            log_msg "WARN: Could not reach $compute_host — run 'sudo rescan-storage' on" \
                "$compute_host manually"
        fi
    fi
fi

# --- Destroy zvol ---
log_msg "INFO: Destroying zvol $zvol_name..."

zfslock_init
if ! zfslock_wait_or_resolve "$zvol_name" "x" "remove-vm-disk destroy"; then
    log_msg "FATAL: Could not acquire destroy lock on ${zvol_name}"
    exit 1
fi

if ! zfs destroy "$zvol_name"; then
    source_helper zfs-diagnose-busy
    diagnose_dataset_busy "$zvol_name"
    zfslock_release "$zfslock_id"
    log_msg "FATAL: Could not destroy zvol $zvol_name"
    exit 1
fi
zfslock_release "$zfslock_id"
log_msg "INFO: ✓ Zvol destroyed"

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   Removed: $zvol_name"
