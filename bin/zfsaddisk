#!/usr/bin/bash
set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

usage() {
    log_msg "INFO: Usage: zfsaddisk <vmid> <disk-number> <storage-name> <size-GiB>"
    echo ""
    log_msg "INFO:   vmid          Numeric Proxmox VM ID"
    log_msg "INFO:   disk-number   Disk number for the new disk (higher than any existing disk)"
    log_msg "INFO:   storage-name  Proxmox storage name where the disk will reside"
    log_msg "INFO:   size-GiB      Size of the new disk in GiB"
    exit 1
}

# --- Argument validation ---
[[ $# -eq 4 ]] || usage
[[ "$1" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $1"
    exit 1
}
[[ "$2" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: disk number must be a number, got: $2"
    exit 1
}
[[ -n "$3" ]] || {
    log_msg "FATAL: storage name must not be empty"
    exit 1
}
[[ "$4" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: size (GiB) must be a number, got: $4"
    exit 1
}

# Add a virtual disk to a VM.
# This works around a problem in the Proxmox GUI where it assigns the wrong disk number
# in some situations.

# $1    Numeric Proxmox VM ID.
# $2    Numeric disk number of the new disk. Make it higher than any existing disk in the VM.
# $3    Name of the Proxmox storage where the new disk will reside.
# $4    Size of the new disk in GiB.

_cmd=''
printf -v _cmd 'qm set %s --scsi%s %s:%s' "$1" "$2" "$3" "$4"
log_msg "INFO: Command to be issued: $_cmd"
read -rp 'Press enter to continue.'

$_cmd
