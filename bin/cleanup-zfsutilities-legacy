#!/usr/bin/bash
# cleanup-zfsutilities-legacy [OPTIONS]
#
# Remove the backward-compatibility symlinks left behind by the FHS-aligned
# migration, and optionally uninstall deployed versions that do not support
# the new layout.
#
# Options:
#   --symlinks-only           Remove only legacy symlinks (default).
#   --remove-versions V...    Uninstall the specified deployed versions.
#   --remove-older-than V     Uninstall all deployed versions older than V.
#   --all-orphaned            Uninstall every deployed version except the
#                             currently active one.
#   --yes, -y                 Skip interactive confirmations.
#   --dry-run                 Print actions without executing them.
#   --help, -h                Show this help and exit.
#
# Safety rules:
#   - The currently active version is never removed.
#   - Legacy paths are removed only if they are symlinks. Regular files or
#     directories are left in place with a warning.
#   - /root/.config/zfsutilities/ is removed only if it is empty after its
#     contents have been migrated.

MYDIR=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)

# Point bashinit at the centralized paths helper before it tries to discover it
# (discovery can fail when mydir has not been set yet). This variable is read
# by bashinit when it is sourced below.
# shellcheck disable=SC2034
PATHS_LIB="$MYDIR/../lib/paths.sh"
_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


# Use the project's rootcheck helper if it is not already loaded (tests mock
# this function to run as non-root).
if ! declare -f rootcheck &>/dev/null; then
    source "$MYDIR/rootcheck"
fi
rootcheck

# ------------------------------------------------------------------
# Configuration — override via environment variables in tests.
# ------------------------------------------------------------------
load_cleanup_config() {
    VERSION_BASE="${ZFSUTILITIES_VERSION_BASE:-/usr/local/lib/zfsutilities}"

    # Legacy paths are read from lib/paths.sh; these are the local names used
    # by this script.
    LEGACY_CONFIG_PATH="${ZFSUTILITIES_LEGACY_CONFIG_PATH:-/root/.config/zfsutilities.json}"
    LEGACY_HISTORY_PATH="${ZFSUTILITIES_LEGACY_HISTORY_PATH:-/root/.config/zfsutilities-history.json}"
    LEGACY_PROFILES_DIR="${ZFSUTILITIES_LEGACY_PROFILES_DIR:-/root/.config/profiles}"
    LEGACY_NEXTSNAP_FILE="${ZFSUTILITIES_LEGACY_NEXTSNAP_FILE:-/root/.config/zfsutilities_nextsnap}"
    LEGACY_OFFSITE_NEXTSNAP_FILE="${ZFSUTILITIES_LEGACY_OFFSITE_NEXTSNAP_FILE:-/root/.config/zfsutilities_offsite_nextsnap}"
    LEGACY_NODE_CONF="${ZFSUTILITIES_LEGACY_NODE_CONF:-/etc/zfsutilities-node.conf}"
    LEGACY_DEPLOY_CONF="${ZFSUTILITIES_LEGACY_DEPLOY_CONF:-/etc/zfsutilities-deploy.conf}"
    LEGACY_ISCSI_ENCRYPTED_CONF="${ZFSUTILITIES_LEGACY_ISCSI_ENCRYPTED_CONF:-/etc/iscsi-encrypted-luns.conf}"
    LEGACY_TWO_NODE_CONF="${ZFSUTILITIES_LEGACY_TWO_NODE_CONF:-/etc/two-node.conf}"
    LEGACY_CONFIG_DIR="${ZFSUTILITIES_LEGACY_CONFIG_DIR:-/root/.config/zfsutilities}"
}

# ------------------------------------------------------------------
# State variables
# ------------------------------------------------------------------
DO_SYMLINKS="true"
DO_REMOVE_VERSIONS="false"
REMOVE_VERSIONS_LIST=()
DO_REMOVE_OLDER_THAN="false"
REMOVE_OLDER_THAN=""
DO_ALL_ORPHANED="false"
DO_YES="false"
DO_DRY_RUN="false"

SYMLINKS_REMOVED=0
VERSIONS_REMOVED=0

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------
# die and ask_yn are provided by bashinit.

usage() {
    cat <<EOF
Usage: cleanup-zfsutilities-legacy [OPTIONS]

Remove backward-compatibility symlinks left by the FHS-aligned migration,
and optionally uninstall old deployed versions.

Options:
  --symlinks-only           Remove only legacy symlinks (default).
  --remove-versions V...    Uninstall the specified deployed versions.
  --remove-older-than V     Uninstall all deployed versions older than V.
  --all-orphaned            Uninstall every deployed version except the
                            currently active one.
  --yes, -y                 Skip interactive confirmations.
  --dry-run                 Print actions without executing them.
  --help, -h                Show this help and exit.

Examples:
  sudo cleanup-zfsutilities-legacy
  sudo cleanup-zfsutilities-legacy --yes
  sudo cleanup-zfsutilities-legacy --remove-versions 1.0.0 1.1.0 --yes
  sudo cleanup-zfsutilities-legacy --remove-older-than 2.0.0 --yes
  sudo cleanup-zfsutilities-legacy --all-orphaned --yes
EOF
    exit 0
}

# Print a message, respecting dry-run prefix.
dry_run_prefix() {
    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo -n "[DRY-RUN] "
    fi
}

# Remove a path only if it is a symlink.
remove_symlink_only() {
    local path="$1"
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        return 0
    fi
    if [[ ! -L "$path" ]]; then
        log_msg "WARN: $path is not a symlink; leaving it in place"
        return 0
    fi
    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo "[DRY-RUN] rm -f $path"
    else
        rm -f "$path"
        log_msg "INFO: Removed legacy symlink $path"
    fi
    SYMLINKS_REMOVED=$((SYMLINKS_REMOVED + 1))
}

# Remove a directory only if it is empty.
remove_dir_if_empty() {
    local path="$1"
    if [[ ! -d "$path" ]]; then
        return 0
    fi
    if [[ -n "$(ls -A "$path" 2>/dev/null)" ]]; then
        log_msg "WARN: $path is not empty; leaving it in place"
        return 0
    fi
    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo "[DRY-RUN] rmdir $path"
    else
        rmdir "$path"
        log_msg "INFO: Removed empty directory $path"
    fi
}

# Return the currently active version directory, or empty string.
active_version_dir() {
    readlink -f "$VERSION_BASE/current" 2>/dev/null || true
}

# Return the currently active version name, or empty string.
active_version_name() {
    local active
    active=$(active_version_dir)
    if [[ -n "$active" ]]; then
        basename "$active"
    fi
}

# _version_supports_new_layout <version_dir>
# Return 0 if the deployed version understands the new FHS-aligned layout.
_version_supports_new_layout() {
    local version_dir="$1"
    local bashinit_file="$version_dir/bin/bashinit"
    local paths_file="$version_dir/lib/paths.sh"

    [[ -f "$paths_file" ]] || return 1
    [[ -f "$bashinit_file" ]] || return 1
    # Detect whether this deployed version already understands the FHS-aligned
    # layout by looking for the new path variables or the migration helper.
    # shellcheck disable=SC2091
    grep -qE 'ZFSUTILITIES_STATE_DIR|ZFSUTILITIES_CONFIG_DIR|migrate_zfsutilities_state' "$bashinit_file" 2>/dev/null
}

# List installed version names, sorted with sort -V.
installed_versions() {
    if [[ ! -d "$VERSION_BASE/versions" ]]; then
        return 0
    fi
    local v
    for v in "$VERSION_BASE/versions/"*; do
        [[ -d "$v" ]] || continue
        basename "$v"
    done | sort -V
}

# _version_is_older_than <candidate> <reference>
# Return 0 if candidate sorts before reference with sort -V.
_version_is_older_than() {
    local candidate="$1"
    local reference="$2"
    local first
    first=$(printf '%s\n%s\n' "$candidate" "$reference" | sort -V | head -n1)
    [[ "$first" == "$candidate" && "$candidate" != "$reference" ]]
}

# Resolve the uninstall-version helper to use.
uninstall_version_helper() {
    local helper="$VERSION_BASE/current/bin/uninstall-version"
    if [[ -x "$helper" ]]; then
        echo "$helper"
        return 0
    fi
    if command -v uninstall-version >/dev/null 2>&1; then
        command -v uninstall-version
        return 0
    fi
    echo ""
}

# Uninstall a single deployed version.
uninstall_version() {
    local version="$1"
    local helper
    helper=$(uninstall_version_helper)
    if [[ -z "$helper" ]]; then
        log_msg "WARN: uninstall-version helper not found; cannot remove $version"
        return 1
    fi

    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo "[DRY-RUN] $helper -y $version"
        VERSIONS_REMOVED=$((VERSIONS_REMOVED + 1))
        return 0
    fi

    if "$helper" -y "$version"; then
        log_msg "INFO: Removed deployed version $version"
        VERSIONS_REMOVED=$((VERSIONS_REMOVED + 1))
    else
        log_msg "WARN: uninstall-version failed for $version"
        return 1
    fi
}

# ------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --symlinks-only)
                DO_SYMLINKS="true"
                DO_REMOVE_VERSIONS="false"
                DO_REMOVE_OLDER_THAN="false"
                DO_ALL_ORPHANED="false"
                REMOVE_VERSIONS_LIST=()
                shift
                ;;
            --remove-versions)
                DO_REMOVE_VERSIONS="true"
                DO_SYMLINKS="false"
                shift
                while [[ $# -gt 0 && "$1" != --* ]]; do
                    REMOVE_VERSIONS_LIST+=("$1")
                    shift
                done
                if [[ ${#REMOVE_VERSIONS_LIST[@]} -eq 0 ]]; then
                    die "--remove-versions requires at least one version"
                fi
                ;;
            --remove-older-than)
                DO_REMOVE_OLDER_THAN="true"
                DO_SYMLINKS="false"
                DO_REMOVE_VERSIONS="false"
                DO_ALL_ORPHANED="false"
                REMOVE_VERSIONS_LIST=()
                if [[ $# -lt 2 ]]; then
                    die "--remove-older-than requires a version argument"
                fi
                REMOVE_OLDER_THAN="$2"
                shift 2
                ;;
            --all-orphaned)
                DO_ALL_ORPHANED="true"
                DO_SYMLINKS="false"
                DO_REMOVE_VERSIONS="false"
                DO_REMOVE_OLDER_THAN="false"
                REMOVE_VERSIONS_LIST=()
                shift
                ;;
            --yes|-y)
                DO_YES="true"
                shift
                ;;
            --dry-run)
                DO_DRY_RUN="true"
                shift
                ;;
            --help|-h)
                usage
                ;;
            -*)
                die "Unknown option: $1"
                ;;
            *)
                die "Unexpected argument: $1"
                ;;
        esac
    done
}

# ------------------------------------------------------------------
# Cleanup phases
# ------------------------------------------------------------------
cleanup_symlinks() {
    echo "=== Cleaning up legacy symlinks ==="

    remove_symlink_only "$LEGACY_CONFIG_PATH"
    remove_symlink_only "$LEGACY_HISTORY_PATH"
    remove_symlink_only "$LEGACY_PROFILES_DIR"
    remove_symlink_only "$LEGACY_NEXTSNAP_FILE"
    remove_symlink_only "$LEGACY_OFFSITE_NEXTSNAP_FILE"
    remove_symlink_only "$LEGACY_NODE_CONF"
    remove_symlink_only "$LEGACY_DEPLOY_CONF"
    remove_symlink_only "$LEGACY_ISCSI_ENCRYPTED_CONF"
    remove_symlink_only "$LEGACY_TWO_NODE_CONF"

    remove_dir_if_empty "$LEGACY_CONFIG_DIR"
}

cleanup_versions_explicit() {
    echo "=== Removing specified versions ==="
    local active
    active=$(active_version_name)

    local version
    for version in "${REMOVE_VERSIONS_LIST[@]}"; do
        if [[ "$version" == "$active" ]]; then
            log_msg "WARN: Refusing to remove the currently active version: $version"
            continue
        fi
        if [[ ! -d "$VERSION_BASE/versions/$version" ]]; then
            log_msg "WARN: Version not found: $version"
            continue
        fi
        uninstall_version "$version"
    done
}

cleanup_versions_older_than() {
    echo "=== Removing versions older than $REMOVE_OLDER_THAN ==="
    local active
    active=$(active_version_name)

    local version
    while IFS= read -r version; do
        [[ -n "$version" ]] || continue
        if [[ "$version" == "$active" ]]; then
            continue
        fi
        if _version_is_older_than "$version" "$REMOVE_OLDER_THAN"; then
            uninstall_version "$version"
        fi
    done < <(installed_versions)
}

cleanup_all_orphaned() {
    echo "=== Removing all deployed versions except the active one ==="
    local active
    active=$(active_version_name)

    local version
    while IFS= read -r version; do
        [[ -n "$version" ]] || continue
        if [[ "$version" == "$active" ]]; then
            continue
        fi
        uninstall_version "$version"
    done < <(installed_versions)
}

# ------------------------------------------------------------------
# Confirmation prompts
# ------------------------------------------------------------------
confirm_symlinks() {
    if [[ "$DO_YES" == "true" ]]; then
        return 0
    fi

    echo ""
    echo "The following legacy symlinks will be removed if they exist:"
    echo "  $LEGACY_CONFIG_PATH"
    echo "  $LEGACY_HISTORY_PATH"
    echo "  $LEGACY_PROFILES_DIR"
    echo "  $LEGACY_NEXTSNAP_FILE"
    echo "  $LEGACY_OFFSITE_NEXTSNAP_FILE"
    echo "  $LEGACY_NODE_CONF"
    echo "  $LEGACY_DEPLOY_CONF"
    echo "  $LEGACY_ISCSI_ENCRYPTED_CONF"
    echo "  $LEGACY_TWO_NODE_CONF"
    echo ""
    if ! ask_yn "Remove these legacy symlinks?" "N"; then
        echo "Cancelled."
        exit 0
    fi
}

confirm_version_list() {
    local -n versions_ref=$1
    if [[ "$DO_YES" == "true" ]]; then
        return 0
    fi

    echo ""
    echo "The following deployed versions will be removed:"
    local v
    for v in "${versions_ref[@]}"; do
        echo "  $v"
    done
    echo ""
    if ! ask_yn "Remove these versions?" "N"; then
        echo "Cancelled."
        exit 0
    fi
}

confirm_older_than() {
    local reference="$1"
    if [[ "$DO_YES" == "true" ]]; then
        return 0
    fi

    echo ""
    echo "All deployed versions older than $reference (except the active version)"
    echo "will be removed."
    echo ""
    if ! ask_yn "Remove these versions?" "N"; then
        echo "Cancelled."
        exit 0
    fi
}

confirm_all_orphaned() {
    if [[ "$DO_YES" == "true" ]]; then
        return 0
    fi

    echo ""
    echo "All deployed versions except the currently active one will be removed."
    echo ""
    if ! ask_yn "Remove all non-active versions?" "N"; then
        echo "Cancelled."
        exit 0
    fi
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
main() {
    local old_set_e=0 old_set_u=0 old_set_o=0
    [[ $- == *e* ]] && old_set_e=1
    [[ $- == *u* ]] && old_set_u=1
    [[ $- == *o* ]] && old_set_o=1
    set -euo pipefail

    parse_args "$@"
    load_cleanup_config

    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo "=== DRY RUN — no changes will be made ==="
    fi

    if [[ "$DO_SYMLINKS" == "true" ]]; then
        confirm_symlinks
        cleanup_symlinks
    elif [[ "$DO_REMOVE_VERSIONS" == "true" ]]; then
        confirm_version_list REMOVE_VERSIONS_LIST
        cleanup_versions_explicit
    elif [[ "$DO_REMOVE_OLDER_THAN" == "true" ]]; then
        confirm_older_than "$REMOVE_OLDER_THAN"
        cleanup_versions_older_than
    elif [[ "$DO_ALL_ORPHANED" == "true" ]]; then
        confirm_all_orphaned
        cleanup_all_orphaned
    fi

    echo ""
    echo "=== cleanup-zfsutilities-legacy complete ==="
    if [[ "$DO_DRY_RUN" == "true" ]]; then
        echo "This was a dry run; no changes were made."
    else
        echo "  Legacy symlinks removed: $SYMLINKS_REMOVED"
        echo "  Deployed versions removed: $VERSIONS_REMOVED"
        local active
        active=$(active_version_name)
        [[ -n "$active" ]] && echo "  Active version preserved: $active"
    fi

    if [[ $old_set_e -eq 0 ]]; then
        set +e
    fi
    if [[ $old_set_u -eq 0 ]]; then
        set +u
    fi
    if [[ $old_set_o -eq 0 ]]; then
        set +o pipefail
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
