#!/bin/bash
# check-prerequisites
# Validate that the host environment meets ZFSutilities requirements.
#
# Run from the repository root before installation, or from any directory
# after installation. Must be run as root.
#
# Modes:
#   --single-node      Check only prerequisites needed for single-node operation
#   --two-node         Check prerequisites for two-node (storage+compute) operation
#   --list-failures    Print machine-readable failures and exit
#
# Categories checked:
#   core     — bash, zfs, zpool, pv, rsync
#   proxmox  — pveversion (warn if absent; required only on two-node compute host)
#   gui      — python3, python3-gi, gir1.2-gtk-3.0, DISPLAY
#   two-node — ssh, scp, open-iscsi (only in --two-node mode)
#   docs     — pip3, mkdocs, mkdocs-material (required)
#
# Exit codes:
#   0  All required prerequisites are present
#   1  One or more required prerequisites are missing

set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "✗ ERROR: Must run as root (use sudo)" >&2; exit 1; }

# ------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------

check_mode=""
list_failures=""

for arg in "$@"; do
    case "$arg" in
        --single-node)
            check_mode="single-node"
            ;;
        --two-node)
            check_mode="two-node"
            ;;
        --list-failures)
            list_failures="Y"
            ;;
        --help|-h)
            echo "Usage: $0 [--single-node|--two-node] [--list-failures]"
            exit 0
            ;;
        *)
            echo "✗ ERROR: Unknown argument: $arg" >&2
            echo "Usage: $0 [--single-node|--two-node] [--list-failures]" >&2
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------

pass_count=0
fail_count=0
warn_count=0

# Arrays for structured failure reporting
fail_cats=()
fail_names=()
fail_pkgs=()
fail_msgs=()

pass() {
    if [[ -z "$list_failures" ]]; then
        echo "  ✓ $1"
    fi
    ((++pass_count))
}

fail() {
    local category="${1:-}"
    local name="${2:-}"
    local package="${3:-}"
    local message="${4:-}"

    fail_cats+=("$category")
    fail_names+=("$name")
    fail_pkgs+=("$package")
    fail_msgs+=("$message")

    if [[ -z "$list_failures" ]]; then
        if [[ -n "$package" ]]; then
            echo "  ✗ $name — $message (install: $package)"
        else
            echo "  ✗ $name — $message"
        fi
    fi
    ((++fail_count))
}

warn() {
    if [[ -z "$list_failures" ]]; then
        echo "  ⚠ $1"
    fi
    ((++warn_count))
}

check_cmd() {
    local category="$1"
    local name="$2"
    local package="${3:-$name}"
    if command -v "$name" >/dev/null 2>&1; then
        pass "$name"
    else
        fail "$category" "$name" "$package" "command not found"
    fi
}

check_python_module() {
    local mod="$1"
    if python3 -c "import ${mod}" >/dev/null 2>&1; then
        pass "python3 module: $mod"
    else
        fail "gui" "python3 module: $mod" "python3-$mod" "module not installed"
    fi
}

check_apt_pkg() {
    local category="$1"
    local pkg="$2"
    if dpkg -l "$pkg" 2>/dev/null | grep -q "^ii"; then
        pass "$pkg"
    else
        fail "$category" "$pkg" "$pkg" "package not installed"
    fi
}

check_systemd_service() {
    local category="$1"
    local name="$2"
    local package="${3:-$name}"
    if systemctl cat "$name" >/dev/null 2>&1; then
        pass "$name"
    else
        fail "$category" "$name" "$package" "service not found"
    fi
}

# Check the installed mkdocs version. Returns 0 if mkdocs is absent or
# its major version is < 2, 1 if mkdocs >= 2 is installed.
check_mkdocs_version() {
    local version
    version=$(mkdocs --version 2>/dev/null | awk '{print $3}')
    [[ -n "$version" ]] || return 0
    local major
    major=$(echo "$version" | cut -d. -f1)
    [[ "$major" =~ ^[0-9]+$ ]] || return 0
    (( major < 2 ))
}

# ------------------------------------------------------------------
# Core ZFS utilities
# ------------------------------------------------------------------

if [[ -z "$list_failures" ]]; then
    echo "=== Core ZFS Utilities ==="
fi
check_cmd "core" "bash" "bash"
check_cmd "core" "zfs" "zfsutils-linux"
check_cmd "core" "zpool" "zfsutils-linux"
check_cmd "core" "pv" "pv"
check_cmd "core" "rsync" "rsync"
if [[ -z "$list_failures" ]]; then
    echo ""
fi

# ------------------------------------------------------------------
# Proxmox
# ------------------------------------------------------------------

if [[ -z "$list_failures" ]]; then
    echo "=== Proxmox VE / VM tools ==="
fi
if command -v pveversion >/dev/null 2>&1; then
    pass "pveversion: $(pveversion 2>/dev/null || true)"
else
    warn "pveversion not found — Proxmox VE is required only on a two-node compute host;" \
         "optional on single-node and two-node storage hosts"
fi
if [[ -z "$list_failures" ]]; then
    echo ""
fi

# ------------------------------------------------------------------
# GTK GUI
# ------------------------------------------------------------------

if [[ -z "$list_failures" ]]; then
    echo "=== GTK GUI ==="
fi
check_cmd "gui" "python3" "python3"
check_python_module gi
check_apt_pkg "gui" "gir1.2-gtk-3.0"
check_apt_pkg "gui" "gir1.2-webkit2-4.1"
check_apt_pkg "gui" "libwebkit2gtk-4.1-0"

if [[ -n "${DISPLAY:-}" ]]; then
    pass "DISPLAY=$DISPLAY"
else
    warn "DISPLAY not set — GUI requires an X11 or Wayland session"
fi
if [[ -z "$list_failures" ]]; then
    echo ""
fi

# ------------------------------------------------------------------
# Two-node prerequisites
# ------------------------------------------------------------------

if [[ "$check_mode" == "two-node" ]]; then
    if [[ -z "$list_failures" ]]; then
        echo "=== Two-Node ==="
    fi
    check_cmd "two-node" "ssh" "openssh-client"
    check_cmd "two-node" "scp" "openssh-client"
    check_cmd "two-node" "targetcli" "targetcli-fb"
    check_systemd_service "two-node" "rtslib-fb-targetctl" "python3-rtslib-fb"
    check_cmd "two-node" "iscsiadm" "open-iscsi"
    if [[ -z "$list_failures" ]]; then
        echo ""
    fi
fi

# ------------------------------------------------------------------
# Documentation
# ------------------------------------------------------------------

if [[ -z "$list_failures" ]]; then
    echo "=== Documentation ==="
fi
check_cmd "docs" "pip3" "python3-pip"
if command -v mkdocs >/dev/null 2>&1; then
    if check_mkdocs_version; then
        pass "mkdocs"
    else
        fail "docs" "mkdocs" '"mkdocs<2"' \
            "mkdocs 2.x is incompatible with this project; pin to mkdocs<2"
    fi
else
    fail "docs" "mkdocs" '"mkdocs<2"' "not installed"
fi
if python3 -c "import material" >/dev/null 2>&1; then
    pass "mkdocs-material"
else
    fail "docs" "mkdocs-material" "mkdocs-material" "not installed"
fi
if [[ -z "$list_failures" ]]; then
    echo ""
fi

# ------------------------------------------------------------------
# Machine-readable failure list
# ------------------------------------------------------------------

if [[ -n "$list_failures" ]]; then
    for i in "${!fail_names[@]}"; do
        printf '%s|%s|%s|%s\n' \
            "${fail_cats[$i]}" \
            "${fail_names[$i]}" \
            "${fail_pkgs[$i]}" \
            "${fail_msgs[$i]}"
    done
    if [[ $fail_count -gt 0 ]]; then
        exit 1
    fi
    exit 0
fi

# ------------------------------------------------------------------
# Summary
# ------------------------------------------------------------------

echo "=========================================="
echo "  Pass:  $pass_count"
echo "  Warn:  $warn_count"
echo "  Fail:  $fail_count"
echo "=========================================="

if [[ $fail_count -gt 0 ]]; then
    echo ""
    echo "✗ $fail_count required prerequisite(s) missing. Install them before proceeding."
    exit 1
fi

if [[ $warn_count -gt 0 ]]; then
    echo ""
    echo "⚠ $warn_count optional item(s) missing — installation can continue" \
        "but some features may be unavailable."
fi

echo ""
echo "✓ All required prerequisites are present."
exit 0
