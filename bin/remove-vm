#!/usr/bin/bash
# remove-vm <vmid>
# Removes a VM's zvols and Proxmox config without archiving.
#
# Discovers all vm-<vmid>-disk-* zvols across pools, lists them along with any
# iSCSI target/LUN information, asks for confirmation, then destroys them using
# zfsdelfs (which handles snapshots, holds, clone-dependency checks, and iSCSI
# teardown). Finally removes the VM definition.
#
# Install to: /usr/local/lib/zfsutilities/bin/remove-vm on BOTH hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit


NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="${PVE_CONF_DIR:-/etc/pve/qemu-server}"

usage() {
    log_msg "INFO: Usage: remove-vm <vmid>"
    echo ""
    log_msg "INFO:   vmid   VM ID to remove"
    echo ""
    log_msg "INFO: Steps:"
    log_msg "INFO:   1. Scan pools for vm-<vmid>-disk-* zvols"
    log_msg "INFO:   2. List zvols and any iSCSI target/LUN mappings"
    log_msg "INFO:   3. Stop the VM if it is running"
    log_msg "INFO:   4. Ask for confirmation"
    log_msg "INFO:   5. Destroy zvols using zfsdelfs"
    log_msg "INFO:   6. Remove the Proxmox VM config"
    echo ""
    log_msg "INFO: Example: remove-vm 904"
    exit 1
}

[[ $# -eq 1 ]] || usage

vmid="$1"
[[ "$vmid" =~ ^[0-9]+$ ]] || { log_msg "FATAL: vmid must be a number, got: $vmid"; exit 1; }
[[ $EUID -eq 0 || ${REMOVE_VM_TEST_NO_ROOT:-0} == "1" ]] || {
    log_msg "FATAL: Must run as root (use sudo)"
    exit 1
}

# --- If not on the compute host, delegate (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "remove-vm")
    exec ssh -t root@"$compute_host" \
        "$remote_script '$vmid'"
fi

proxmoxconfig="${pve_conf_dir}/${vmid}.conf"

# =====================================================================
# Discover zvols (and iSCSI info in two-node mode)
# =====================================================================

declare -a zvols=()
declare -a sizes=()
declare -a targets=()
declare -a luns=()

if is_single_node; then
    while IFS= read -r zvol; do
        [[ -n "$zvol" ]] || continue
        zvols+=("$zvol")
        size=$(zfs get -H -o value volsize "$zvol" 2>/dev/null || echo "unknown")
        sizes+=("$size")
        targets+=("")
        luns+=("")
    # Select zvols named <pool>/proxmox/vm-<vmid>-disk-<n> (grep -F for the
    # literal prefix, then anchor the end with a digit check).
    done < <(zfs list -H -t volume -o name 2>/dev/null \
        | grep -F "/proxmox/vm-${vmid}-disk-" \
        | while IFS= read -r zvol; do
            disk_suffix="${zvol##*disk-}"
            [[ "$disk_suffix" =~ ^[0-9]+$ ]] || continue
            [[ "$zvol" == *"/proxmox/vm-${vmid}-disk-${disk_suffix}" ]] || continue
            echo "$zvol"
        done | sort)
else
    # Two-node: discover on the storage host and collect target/LUN info.
    discover_out=$(ssh root@"$storage_host" bash -s "$vmid" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

vmid="$1"

# Feed the loop sorted zvol names; keep only names ending in
# vm-<vmid>-disk-<digits> (grep -F matches the literal prefix; the suffix
# digit check anchors the end).
while IFS= read -r zvol; do
        disk_suffix="${zvol##*disk-}"
        [[ "$disk_suffix" =~ ^[0-9]+$ ]] || continue
        [[ "$zvol" == *"/proxmox/vm-${vmid}-disk-${disk_suffix}" ]] || continue
        size=$(zfs get -H -o value volsize "$zvol" 2>/dev/null || echo "unknown")
        disknum="$disk_suffix"
        backstore="vm-${vmid}-disk-${disknum}"

        target=""
        lun=""
        while IFS= read -r t; do
            # The selected LUN line starts with "lun<n>"; take the digits.
            lun_line=$(targetcli "/iscsi/${t}/tpg1/luns" ls 2>/dev/null \
                | grep " ${backstore} " | head -1)
            found_lun=""
            if [[ -n "$lun_line" ]]; then
                found_lun="${lun_line#*lun}"
                found_lun="${found_lun%%[!0-9]*}"
            fi
            if [[ -n "$found_lun" ]]; then
                target="$t"
                lun="$found_lun"
                break
            fi
        done < <(targetcli /iscsi ls 2>/dev/null | while IFS= read -r _t_line; do
            # targetcli separates each target name from its dotted leader
            # with a space, so the IQN is a whole token.
            read -ra _t_words <<< "$_t_line"
            for _t in "${_t_words[@]}"; do
                case "$_t" in iqn.*) printf '%s\n' "$_t" ;; esac
            done
        done)

        printf '%s\t%s\t%s\t%s\n' "$zvol" "$size" "$target" "$lun"
    done < <(zfs list -H -t volume -o name 2>/dev/null \
        | grep -F "/proxmox/vm-${vmid}-disk-" | sort)
SSHEOF
    ) || { log_msg "FATAL: SSH to $storage_host failed"; exit 1; }

    while IFS=$'\t' read -r zvol size target lun; do
        [[ -n "$zvol" ]] || continue
        zvols+=("$zvol")
        sizes+=("$size")
        targets+=("$target")
        luns+=("$lun")
    done <<< "$discover_out"
fi

if [[ ${#zvols[@]} -eq 0 && ! -f "$proxmoxconfig" ]]; then
    log_msg "INFO: No zvols or Proxmox config found for VM ${vmid}."
    exit 0
fi

# =====================================================================
# Show summary
# =====================================================================

log_msg "INFO: === remove-vm ==="
log_msg "INFO:   VM: ${vmid}"
if [[ -f "$proxmoxconfig" ]]; then
    log_msg "INFO:   Config: ${proxmoxconfig}"
else
    log_msg "INFO:   Config: not found"
fi
echo ""

if [[ ${#zvols[@]} -gt 0 ]]; then
    log_msg "INFO:   Zvols to remove:"
    for i in "${!zvols[@]}"; do
        if is_two_node; then
            if [[ -n "${targets[$i]}" ]]; then
                log_msg "INFO:     ${zvols[$i]} (size: ${sizes[$i]}," \
                    "iSCSI: ${targets[$i]} LUN ${luns[$i]})"
            else
                log_msg "INFO:     ${zvols[$i]} (size: ${sizes[$i]}, iSCSI: not mapped)"
            fi
        else
            log_msg "INFO:     ${zvols[$i]} (size: ${sizes[$i]})"
        fi
    done
    echo ""
else
    log_msg "INFO:   No zvols found."
    echo ""
fi

# Warn if the VM is running.
if [[ -f "$proxmoxconfig" ]]; then
    vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
    if [[ "$vm_status" == "running" ]]; then
        log_msg "INFO:   VM ${vmid} is currently running and will be stopped before removal."
        echo ""
    fi
fi

if ! ask_yn "Proceed with removal?"; then
    log_msg "INFO: Aborted."
    exit 0
fi

# =====================================================================
# Stop the VM if running
# =====================================================================

if [[ -f "$proxmoxconfig" ]]; then
    vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
    if [[ "$vm_status" == "running" ]]; then
        log_msg "INFO:   Stopping VM ${vmid}..."
        qm stop "$vmid" 2>/dev/null || true
        sleep 2
    fi
fi

# =====================================================================
# Remove zvols using zfsdelfs
# =====================================================================

if [[ ${#zvols[@]} -gt 0 ]]; then
    log_msg "INFO:   Removing zvols..."
    if is_single_node; then
        zfsdelfs_path=$(find_zfsutility_script zfsdelfs) || exit 1
        for zvol in "${zvols[@]}"; do
            log_msg "INFO:     Destroying ${zvol}..."
            if ! "$zfsdelfs_path" "$zvol" '' '' '' "autoproceed='Y'"; then
                log_msg "FATAL: Failed to remove ${zvol}"
                exit 1
            fi
        done
    else
        remote_zfsdelfs=$(remote_zfsutility_script "$storage_host" "zfsdelfs")
        for zvol in "${zvols[@]}"; do
            log_msg "INFO:     Destroying ${zvol}..."
            if ! ssh root@"$storage_host" \
                    "$remote_zfsdelfs '$zvol' '' '' '' \"autoproceed='Y'\""; then
                log_msg "FATAL: Failed to remove ${zvol} on $storage_host"
                exit 1
            fi
        done

        log_msg "INFO:   Saving iSCSI configuration..."
        remote_safe_save=$(remote_zfsutility_script "$storage_host" "safe-iscsi-save")
        ssh root@"$storage_host" "$remote_safe_save" \
            || log_msg "WARN: Could not save iSCSI config on $storage_host"

        log_msg "INFO:   Rescanning iSCSI..."
        rescan_path=$(find_zfsutility_script rescan-storage) || exit 1
        if ! "$rescan_path"; then
            log_msg "WARN: iSCSI rescan failed; run rescan-storage manually"
        fi
    fi
fi

# =====================================================================
# Remove Proxmox config
# =====================================================================

if [[ -f "$proxmoxconfig" ]]; then
    log_msg "INFO:   Removing Proxmox config..."
    rm -f "$proxmoxconfig"
fi

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   VM ${vmid} has been removed."
