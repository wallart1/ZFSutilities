#!/usr/bin/bash
set -euo pipefail
# Checks whether /etc/modprobe.d/zfs.conf is active and applied at boot.
# Works with Proxmox VE 8.x + OpenZFS 2.x

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
rootcheck

zfs_conf="/etc/modprobe.d/zfs.conf"
initramfs="/boot/initrd.img-$(uname -r)"
params_pattern="zfs_vdev_scrub_"

log_msg "INFO: === ZFS Tunable Verification Script ==="
log_msg "INFO: Kernel: $(uname -r)"
# awk '/^version:/{print $2}'  —  modinfo prints lines like "version:        2.2.4".
#   Match the "version:" line and extract the version string (second field).
log_msg "INFO: ZFS version: $(modinfo zfs | awk '/^version:/{print $2}')"

# 1. Check configuration file
if [[ -f "$zfs_conf" ]]; then
    log_msg "INFO: [OK] Found $zfs_conf:"
    # awk index() with the fixed string "options zfs"  —  find kernel module
    #   option lines in /etc/modprobe.d/zfs.conf. index()==1 restricts the
    #   match to lines beginning with that string (comments/blanks ignored).
    _options_lines=$(awk 'index($0, "options zfs") == 1' "$zfs_conf")
    if [[ -n "$_options_lines" ]]; then
        printf '%s\n' "$_options_lines"
    else
        log_msg "INFO:   (no 'options zfs' lines found)"
    fi
else
    warn "$zfs_conf not found."
    exit 1
fi

# 2. Verify it's embedded in initramfs
if lsinitramfs "$initramfs" 2>/dev/null | grep -q "etc/modprobe.d/zfs.conf"; then
    log_msg "INFO: [OK] zfs.conf is included in initramfs image ($initramfs)"
else
    die "[FAIL] zfs.conf not found in initramfs! Run: sudo update-initramfs -u -k all"
fi

# 3. Verify parameters at runtime
log_msg "INFO: [INFO] Current ZFS scrub parameters:"
params_found=false
shopt -s nullglob
for p in /sys/module/zfs/parameters/"${params_pattern}"*; do
    if [[ -f "$p" ]]; then
        params_found=true
        printf "  %-40s %s\n" "$(basename "$p"):" "$(cat "$p")"
    fi
done
shopt -u nullglob

if ! $params_found; then
    log_msg "INFO:   (No matching $params_pattern parameters found — possibly renamed or" \
        "unsupported)"
fi

# 4. Optional: dmesg verification
if dmesg | grep -qi "zfs"; then
    log_msg "INFO: [INFO] ZFS module load messages in dmesg:"
    # grep -i "zfs" | awk fixed-string index() tests for "module", "loaded",
    #   or "vdev_scrub"  —  filter dmesg for ZFS-related lines that mention
    #   module loading or scrub events (OR of the three fixed keywords).
    dmesg | grep -i "zfs" \
        | awk 'index($0, "module") || index($0, "loaded") || index($0, "vdev_scrub")' \
        | tail -n 5
else
    warn "No ZFS load messages found in dmesg."
fi

log_msg "INFO: === Verification Complete ==="
