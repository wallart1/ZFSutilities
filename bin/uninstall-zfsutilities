#!/usr/bin/bash
# uninstall-zfsutilities [OPTIONS]
# Completely remove ZFSutilities from this host.
#
# By default this removes the deployed software and production wiring but
# preserves user configuration, logs, and history. Use --purge to also remove
# those remnants. In two-node mode use --all-nodes to run the same uninstall
# on the peer host.
#
# Options:
#   --purge       Also remove configs, logs, history, cron, systemd files, etc.
#   --all-nodes   In two-node mode, also run the uninstall on the peer host.
#   --yes, -y     Skip interactive confirmation prompts.
#   --dry-run     Print actions without executing them.
#   --help, -h    Show this help and exit.

mydir=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)

# Source bashinit, tolerating a missing /root/bashinit symlink so the script
# can finish a partial uninstall.
if [[ -f ~/bashinit ]]; then
    # shellcheck source=/root/bashinit
    source ~/bashinit
elif [[ -f "$mydir/bashinit" ]]; then
    # shellcheck source=bashinit
    source "$mydir/bashinit"
else
    echo "FATAL: bashinit not found" >&2
    exit 1
fi
bashinit

# Use the project's rootcheck helper if it is not already loaded (tests mock
# this function to run as non-root).
if ! declare -f rootcheck &>/dev/null; then
    # shellcheck source=rootcheck
    source "$mydir/rootcheck"
fi
rootcheck

# Source desktop launcher helpers.  In the flat layout the library lives at
# "../lib/desktop-launcher-lib.sh" relative to bin/.
_DESKTOP_LAUNCHER_LIB=""
if [[ -f "$mydir/../lib/desktop-launcher-lib.sh" ]]; then
    _DESKTOP_LAUNCHER_LIB="$mydir/../lib/desktop-launcher-lib.sh"
elif [[ -f "$mydir/lib/desktop-launcher-lib.sh" ]]; then
    _DESKTOP_LAUNCHER_LIB="$mydir/lib/desktop-launcher-lib.sh"
fi

if [[ -n "$_DESKTOP_LAUNCHER_LIB" ]]; then
    # The library path is resolved above; use /dev/null for ShellCheck.
    # shellcheck source=/dev/null
    source "$_DESKTOP_LAUNCHER_LIB"
else
    log_msg "WARN:   desktop-launcher-lib.sh not found; desktop shortcuts will not be removed."
    get_desktop_user() { echo "${SUDO_USER:-}"; }
fi

# Ensure the desktop-removal helper is available even if the launcher library
# could not be sourced.
if ! declare -f remove_desktop_symlinks >/dev/null; then
    remove_desktop_symlinks() { return 0; }
fi

# ------------------------------------------------------------------
# Configuration — override these environment variables in tests.
# ------------------------------------------------------------------
load_uninstall_config() {
    version_base="${ZFSUTILITIES_VERSION_BASE:-/usr/local/lib/zfsutilities}"
    bashinit_link="${ZFSUTILITIES_BASHINIT_LINK:-/root/bashinit}"
    profile_file="${ZFSUTILITIES_PROFILE_FILE:-/etc/profile.d/zfsutilities.sh}"
    sudoers_file="${ZFSUTILITIES_SUDOERS_FILE:-/etc/sudoers.d/zfsutilities}"
    node_lib_link="${ZFSUTILITIES_NODE_LIB_LINK:-/usr/local/lib/node-lib.sh}"
    two_node_lib_link="${ZFSUTILITIES_TWO_NODE_LIB_LINK:-/usr/local/lib/two-node-lib.sh}"
    iscsi_lib_link="${ZFSUTILITIES_ISCSI_LIB_LINK:-/usr/local/lib/iscsi-lib.sh}"
    rootcheck_link="${ZFSUTILITIES_ROOTCHECK_LINK:-/usr/local/lib/rootcheck}"
    local_bin_dir="${ZFSUTILITIES_LOCAL_BIN_DIR:-/usr/local/bin}"
    system_config_dir="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}"
    state_dir="${ZFSUTILITIES_STATE_DIR:-/var/lib/zfsutilities}"
    NODE_CONF="${ZFSUTILITIES_NODE_CONF:-${system_config_dir}/node.conf}"
    legacy_node_conf="${ZFSUTILITIES_LEGACY_NODE_CONF:-/etc/zfsutilities-node.conf}"
    legacy_two_node_conf="${ZFSUTILITIES_LEGACY_TWO_NODE_CONF:-/etc/two-node.conf}"
    deploy_conf="${ZFSUTILITIES_DEPLOY_CONF:-${system_config_dir}/deploy.conf}"
    legacy_deploy_conf="${ZFSUTILITIES_LEGACY_DEPLOY_CONF:-/etc/zfsutilities-deploy.conf}"
    config_path="${ZFSUTILITIES_CONFIG_PATH:-${state_dir}/config.json}"
    config_dir="${ZFSUTILITIES_CONFIG_DIR:-${state_dir}}"
    legacy_config_path="${ZFSUTILITIES_LEGACY_CONFIG_PATH}"
    legacy_config_dir="${ZFSUTILITIES_LEGACY_CONFIG_DIR}"
    history_path="${ZFSUTILITIES_HISTORY_PATH:-${state_dir}/history.json}"
    legacy_history_path="${ZFSUTILITIES_LEGACY_HISTORY_PATH}"
    legacy_profiles_dir="${ZFSUTILITIES_LEGACY_PROFILES_DIR}"
    legacy_nextsnap_file="${ZFSUTILITIES_LEGACY_NEXTSNAP_FILE}"
    legacy_offsite_nextsnap_file="${ZFSUTILITIES_LEGACY_OFFSITE_NEXTSNAP_FILE}"
    cache_dir="${ZFSUTILITIES_CACHE_DIR:-/root/.cache/zfsutilities}"
    log_dir="${ZFSUTILITIES_LOG_DIR:-/var/log/zfsutilities}"
    cron_file="${ZFSUTILITIES_CRON_FILE:-/etc/cron.d/zfsutilities}"
    profile_lock_dir="${ZFSUTILITIES_PROFILE_LOCK_DIR:-/run/lock/zfsutilities/profiles}"
    zfslock_dir="${ZFSUTILITIES_ZFSLOCK_DIR:-/run/lock/zfsutilities}"
    systemd_dir="${ZFSUTILITIES_SYSTEMD_DIR:-/etc/systemd/system}"
    local _def_iscsi_enc="${system_config_dir}/iscsi-encrypted-luns.conf"
    ISCSI_ENCRYPTED_CONF="${ZFSUTILITIES_ISCSI_ENCRYPTED_CONF:-$_def_iscsi_enc}"
    local _d_legacy_iscsi="/etc/iscsi-encrypted-luns.conf"
    legacy_iscsi_encrypted_conf="${ZFSUTILITIES_LEGACY_ISCSI_ENCRYPTED_CONF:-$_d_legacy_iscsi}"
    pve_iscsi_plugin="${ZFSUTILITIES_PVE_ISCSI_PLUGIN:-/usr/share/perl5/PVE/Storage/ISCSIPlugin.pm}"
    cache_warm_log_glob="${ZFSUTILITIES_CACHE_WARM_LOG_GLOB:-/var/log/zfs-cache-warm*.log}"
}

# ------------------------------------------------------------------
# State variables set by argument parsing and interactive prompts.
# ------------------------------------------------------------------
do_purge="false"
do_all_nodes="false"
do_yes="false"
do_dry_run="false"

# ------------------------------------------------------------------
# Helpers
# ------------------------------------------------------------------
# die and ask_yn are provided by bashinit (sourced above).

usage() {
    log_msg "INFO: Usage: uninstall-zfsutilities [OPTIONS]"
    log_msg "INFO:"
    log_msg "INFO: Completely remove ZFSutilities from this host."
    log_msg "INFO:"
    log_msg "INFO: Options:"
    log_msg "INFO:   --purge       Also remove configuration files, logs, history, cron,"
    log_msg "INFO:                 systemd integration, cache-warm, and other remnants."
    log_msg "INFO:   --all-nodes   In two-node mode, also run the uninstall on the peer host."
    log_msg "INFO:   --yes, -y     Skip interactive confirmation prompts."
    log_msg "INFO:   --dry-run     Print actions without executing them."
    log_msg "INFO:   --help, -h    Show this help and exit."
    log_msg "INFO:"
    log_msg "INFO: Examples:"
    log_msg "INFO:   sudo uninstall-zfsutilities"
    log_msg "INFO:   sudo uninstall-zfsutilities --purge --yes"
    log_msg "INFO:   sudo uninstall-zfsutilities --purge --all-nodes"
    exit 0
}

# Remove a file if it exists.
remove_file() {
    local path="$1"
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        return 0
    fi
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] rm -f $path"
        return 0
    fi
    rm -f "$path"
    log_msg "INFO:   Removed $path"
}

# Remove a symlink if it exists.
remove_symlink() {
    local path="$1"
    if [[ ! -L "$path" ]]; then
        return 0
    fi
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] rm -f $path"
        return 0
    fi
    rm -f "$path"
    log_msg "INFO:   Removed $path"
}

# Remove a directory tree if it exists.
remove_dir() {
    local path="$1"
    if [[ ! -d "$path" ]]; then
        return 0
    fi
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] rm -rf $path"
        return 0
    fi
    rm -rf "$path"
    log_msg "INFO:   Removed $path"
}

# Run a systemctl command, tolerating missing units.
systemctl_cmd() {
    local action="$1"
    local unit="$2"
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] systemctl $action $unit"
        return 0
    fi
    systemctl "$action" "$unit" 2>/dev/null || true
}

# Reload systemd daemon, idempotently.
reload_systemd() {
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] systemctl daemon-reload"
        return 0
    fi
    systemctl daemon-reload 2>/dev/null || true
}

# Run a command on the peer node via SSH. Echoes the command for dry-run.
run_on_peer() {
    local peer="$1"
    shift
    local cmd="$*"
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] ssh root@$peer $cmd"
        return 0
    fi
    ssh -o ConnectTimeout=5 "root@$peer" "$cmd"
}

# get_desktop_user is provided by desktop-launcher-lib.sh (sourced above).

# ------------------------------------------------------------------
# Argument parsing
# ------------------------------------------------------------------
parse_args() {
    do_purge="false"
    do_all_nodes="false"
    do_yes="false"
    do_dry_run="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge)
                do_purge="true"
                shift
                ;;
            --all-nodes)
                do_all_nodes="true"
                shift
                ;;
            --yes|-y)
                do_yes="true"
                shift
                ;;
            --dry-run)
                do_dry_run="true"
                shift
                ;;
            --help|-h)
                usage
                ;;
            *)
                log_msg "WARN: Unknown option: $1"
                usage
                ;;
        esac
    done
}

# ------------------------------------------------------------------
# Node-mode detection
# ------------------------------------------------------------------
detect_node_mode() {
    NODE_MODE=""
    STORAGE_HOST=""
    COMPUTE_HOST=""
    this_host=$(hostname -s)

    if [[ -f "$NODE_CONF" ]]; then
        # shellcheck source=/dev/null
        source "$NODE_CONF"
    elif [[ -f "$legacy_node_conf" ]]; then
        # shellcheck source=/dev/null
        source "$legacy_node_conf"
        NODE_MODE="two-node"
    elif [[ -f "$legacy_two_node_conf" ]]; then
        # shellcheck source=/dev/null
        source "$legacy_two_node_conf"
        NODE_MODE="two-node"
    fi

    NODE_MODE="${NODE_MODE:-single-node}"
}

# Return the peer host in two-node mode, or empty string.
peer_host() {
    if [[ "$NODE_MODE" != "two-node" ]]; then
        return 0
    fi
    if [[ "$this_host" == "$STORAGE_HOST" && -n "$COMPUTE_HOST" ]]; then
        echo "$COMPUTE_HOST"
    elif [[ "$this_host" == "$COMPUTE_HOST" && -n "$STORAGE_HOST" ]]; then
        echo "$STORAGE_HOST"
    fi
}

# ------------------------------------------------------------------
# Status detection for the interactive summary.
# ------------------------------------------------------------------
detect_installed_state() {
    has_version_base="false"
    has_current="false"
    has_config="false"
    has_logs="false"
    has_cron="false"
    has_systemd="false"
    has_cachewarm="false"

    if [[ -d "$version_base" ]]; then
        has_version_base="true"
        if [[ -L "$version_base/current" || -e "$version_base/current" ]]; then
            has_current="true"
        fi
    fi

    if [[ -f "$config_path" || -d "$config_dir" || -f "$history_path" ]]; then
        has_config="true"
    fi

    if [[ -d "$log_dir" ]]; then
        has_logs="true"
    fi

    if [[ -f "$cron_file" ]]; then
        has_cron="true"
    fi

    if [[ -d "$systemd_dir/rtslib-fb-targetctl.service.d" || \
          -f "$systemd_dir/zfs-cache-warm.service" ]]; then
        has_systemd="true"
    fi

    if [[ -f "$local_bin_dir/warm-cache.sh" || \
          -f "$systemd_dir/zfs-cache-warm.service" ]]; then
        has_cachewarm="true"
    fi
}

# ------------------------------------------------------------------
# Interactive dialog
# ------------------------------------------------------------------
# ask_yn is provided by bashinit (sourced above).

present_interactive_dialog() {
    log_msg "INFO: === ZFSutilities Uninstall ==="
    log_msg "INFO:"
    log_msg "INFO: This script will remove the ZFSutilities software from this host."
    log_msg "INFO:"
    log_msg "INFO: Detected state:"
    log_msg "INFO:   Deployed software:     $has_version_base"
    log_msg "INFO:   Active version link:   $has_current"
    log_msg "INFO:   Configuration files:   $has_config"
    log_msg "INFO:   Log files:             $has_logs"
    log_msg "INFO:   Cron schedules:        $has_cron"
    log_msg "INFO:   Systemd integration:   $has_systemd"
    log_msg "INFO:   Cache-warm utility:    $has_cachewarm"
    log_msg "INFO:   Node mode:             $NODE_MODE"
    log_msg "INFO:"
    log_msg "INFO: You have two choices:"
    log_msg "INFO:"
    log_msg "INFO:   1) Remove software only"
    log_msg "INFO:      - Removes deployed scripts, PATH wiring, sudoers entry, desktop"
    log_msg "INFO:        shortcuts, cron schedules, and systemd service/drop-in files."
    log_msg "INFO:      - Keeps your configuration, logs, and history."
    log_msg "INFO:"
    log_msg "INFO:   2) Remove software and clean up everything (--purge)"
    log_msg "INFO:      - Also removes configuration files, logs, history, the cache-warm"
    log_msg "INFO:        utility, encrypted-LUN config, and the LUKS keyfile."
    log_msg "INFO:"

    if [[ "$NODE_MODE" == "two-node" ]]; then
        log_msg "INFO: This is a two-node setup. You can also run the uninstall on the peer"
        log_msg "INFO: node ($(peer_host)) using --all-nodes."
        log_msg "INFO:"
    fi

    local choice
    while true; do
        read -rp "Choose 1 (software only) or 2 (clean up everything)," \
            " or c to cancel [1/2/c]: " choice
        case "${choice,,}" in
            1|software)
                do_purge="false"
                break
                ;;
            2|purge|everything)
                do_purge="true"
                break
                ;;
            c|cancel)
                log_msg "INFO: Cancelled."
                exit 0
                ;;
            *)
                log_msg "INFO:   Please enter 1, 2, or c."
                ;;
        esac
    done

    if [[ "$NODE_MODE" == "two-node" && "$do_all_nodes" != "true" ]]; then
        log_msg "INFO:"
        if ask_yn "Also run the uninstall on the peer node ($(peer_host))?" "N"; then
            do_all_nodes="true"
        fi
    fi
}

# ------------------------------------------------------------------
# Final confirmation
# ------------------------------------------------------------------
confirm_uninstall() {
    log_msg "INFO:"
    log_msg "INFO: === Summary of actions ==="
    local _mode_text
    if [[ "$do_purge" == "true" ]]; then
        _mode_text="Remove software and clean up everything"
    else
        _mode_text="Remove software only"
    fi
    log_msg "INFO:   Mode:            $_mode_text"
    local peer
    peer=$(peer_host)
    local _peer_text
    if [[ "$do_all_nodes" == "true" ]]; then
        _peer_text="$peer"
    else
        _peer_text="(local only)"
    fi
    log_msg "INFO:   Peer node:       $_peer_text"
    log_msg "INFO:   Dry run:         $do_dry_run"
    log_msg "INFO:"

    if [[ "$do_purge" == "true" ]]; then
        log_msg "INFO: The following will be removed:"
        log_msg "INFO:   - $version_base"
        log_msg "INFO:   - $bashinit_link"
        log_msg "INFO:   - $node_lib_link"
        log_msg "INFO:   - $two_node_lib_link"
        log_msg "INFO:   - $rootcheck_link"
        log_msg "INFO:   - $profile_file"
        log_msg "INFO:   - $sudoers_file"
        log_msg "INFO:   - $cron_file"
        log_msg "INFO:   - $systemd_dir/rtslib-fb-targetctl.service.d/"
        log_msg "INFO:   - $systemd_dir/zfs-cache-warm.service"
        log_msg "INFO:   - $system_config_dir/"
        log_msg "INFO:   - $state_dir/"
        log_msg "INFO:   - $NODE_CONF"
        log_msg "INFO:   - $legacy_node_conf"
        log_msg "INFO:   - $legacy_two_node_conf"
        log_msg "INFO:   - $deploy_conf"
        log_msg "INFO:   - $config_path"
        log_msg "INFO:   - $config_dir"
        log_msg "INFO:   - $history_path"
        log_msg "INFO:   - $cache_dir"
        log_msg "INFO:   - $log_dir"
        log_msg "INFO:   - $ISCSI_ENCRYPTED_CONF"
        log_msg "INFO:   - Cache-warm scripts in $local_bin_dir and related logs"
        log_msg "INFO:   - Desktop shortcuts for the GUI and documentation viewer"
    else
        log_msg "INFO: The following will be removed:"
        log_msg "INFO:   - $version_base"
        log_msg "INFO:   - $bashinit_link"
        log_msg "INFO:   - $node_lib_link"
        log_msg "INFO:   - $two_node_lib_link"
        log_msg "INFO:   - $rootcheck_link"
        log_msg "INFO:   - $profile_file"
        log_msg "INFO:   - $sudoers_file"
        log_msg "INFO:   - $cron_file"
        log_msg "INFO:   - $systemd_dir/rtslib-fb-targetctl.service.d/"
        log_msg "INFO:   - $systemd_dir/zfs-cache-warm.service"
        log_msg "INFO:   - Desktop shortcuts for the GUI and documentation viewer"
        log_msg "INFO:"
        log_msg "INFO: The following will be preserved:"
        log_msg "INFO:   - Configuration files in /etc/zfsutilities/, /var/lib/zfsutilities/,"
        log_msg "INFO:     and legacy /root/.config/ and /etc/zfsutilities-* paths"
        log_msg "INFO:   - Log files in /var/log/zfsutilities"
        log_msg "INFO:   - History files"
    fi

    log_msg "INFO:"
    log_msg "INFO: ZFS pools, datasets, snapshots, and iSCSI targets will NOT be touched."

    if [[ -f "$pve_iscsi_plugin" ]] && grep -q 'tdiff > 86400' "$pve_iscsi_plugin" 2>/dev/null; then
        log_msg "INFO:"
        log_msg "INFO: Note: The Proxmox iSCSI rescan-rate patch on $pve_iscsi_plugin"
        log_msg "INFO:       will NOT be reversed automatically. To reverse it manually, run:"
        log_msg "INFO:         sed -i 's/86400)/10)/' $pve_iscsi_plugin"
        log_msg "INFO:         systemctl restart pvestatd"
    fi

    log_msg "INFO:"
    if ! ask_yn "Proceed with uninstall?" "N"; then
        log_msg "INFO: Cancelled."
        exit 0
    fi
}

# ------------------------------------------------------------------
# Removal phases
# ------------------------------------------------------------------
uninstall_software() {
    log_msg "INFO:"
    log_msg "INFO: === Removing software and production wiring ==="

    # Stop/disable services before removing their units.
    systemctl_cmd stop zfs-cache-warm.service
    systemctl_cmd disable zfs-cache-warm.service

    # Remove active-version wiring via switch-version if it is still present.
    local switch_version="$version_base/current/bin/switch-version"
    if [[ -x "$switch_version" ]]; then
        if [[ "$do_dry_run" == "true" ]]; then
            log_msg "INFO:   [DRY-RUN] $switch_version --uninstall"
        else
            log_msg "INFO:   Unwiring active version..."
            "$switch_version" --uninstall || \
                log_msg "WARN:   switch-version --uninstall returned non-zero; continuing"
        fi
    fi

    # Remove the entire versioned deployment tree.
    remove_dir "$version_base"

    # Remove any leftover production wiring.
    remove_symlink "$bashinit_link"
    remove_symlink "$node_lib_link"
    remove_symlink "$two_node_lib_link"
    remove_symlink "$iscsi_lib_link"
    remove_symlink "$rootcheck_link"
    remove_file "$profile_file"
    remove_file "$sudoers_file"

    # Remove desktop shortcuts.
    local desktop_user
    desktop_user=$(get_desktop_user)
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO:   [DRY-RUN] remove desktop shortcuts for '$desktop_user'"
    else
        remove_desktop_symlinks "$desktop_user" || true
    fi

    # Remove cron drop-in.
    remove_file "$cron_file"

    # Remove systemd integration.
    remove_dir "$systemd_dir/rtslib-fb-targetctl.service.d"
    remove_file "$systemd_dir/zfs-cache-warm.service"

    reload_systemd

    # Remove transient profile lock directory.
    remove_dir "$profile_lock_dir"
}

uninstall_purge() {
    log_msg "INFO:"
    log_msg "INFO: === Removing configuration, logs, and other remnants ==="

    remove_dir "$system_config_dir"
    remove_dir "$state_dir"
    remove_file "$NODE_CONF"
    remove_file "$legacy_node_conf"
    remove_file "$legacy_two_node_conf"
    remove_file "$deploy_conf"
    remove_file "$legacy_deploy_conf"
    remove_file "$config_path"
    remove_dir "$config_dir"
    remove_file "$legacy_config_path"
    remove_symlink "$legacy_config_path"
    remove_dir "$legacy_config_dir"
    remove_file "$history_path"
    remove_file "$legacy_history_path"
    remove_symlink "$legacy_history_path"
    remove_dir "$legacy_profiles_dir"
    remove_symlink "$legacy_profiles_dir"
    remove_file "$legacy_nextsnap_file"
    remove_file "$legacy_offsite_nextsnap_file"
    remove_dir "$cache_dir"
    remove_dir "$log_dir"
    remove_file "$ISCSI_ENCRYPTED_CONF"
    remove_file "$legacy_iscsi_encrypted_conf"
    remove_symlink "$legacy_node_conf"
    remove_symlink "$legacy_deploy_conf"
    remove_symlink "$legacy_iscsi_encrypted_conf"
    remove_symlink "$legacy_two_node_conf"

    # Cache-warm utility.
    remove_file "$local_bin_dir/warm-cache.sh"
    remove_file "$local_bin_dir/identify-hot-vms.sh"
    remove_file "$local_bin_dir/monitor-cache.sh"
    remove_file "$systemd_dir/zfs-cache-warm.service"
    for log in $cache_warm_log_glob; do
        remove_file "$log"
    done

    # Remove the base lock directory only if it is empty. Do not remove it
    # if other ZFSutilities processes are still running or if it contains
    # unrelated files.
    if [[ -d "$zfslock_dir" && -z "$(ls -A "$zfslock_dir" 2>/dev/null)" ]]; then
        remove_dir "$zfslock_dir"
    fi
}

uninstall_peer() {
    local peer
    peer=$(peer_host)
    if [[ -z "$peer" ]]; then
        return 0
    fi

    log_msg "INFO:"
    log_msg "INFO: === Running uninstall on peer node: $peer ==="

    local remote_flags=""
    [[ "$do_purge" == "true" ]] && remote_flags+=" --purge"
    [[ "$do_yes" == "true" ]] && remote_flags+=" --yes"
    [[ "$do_dry_run" == "true" ]] && remote_flags+=" --dry-run"

    local remote_script
    remote_script="/usr/local/lib/zfsutilities/current/bin/uninstall-zfsutilities"

    # If the peer still has a deployed version, use its copy of the script.
    # Otherwise fall back to running the local copy via stdin.
    if run_on_peer "$peer" "[[ -x '$remote_script' ]]" >/dev/null 2>&1; then
        run_on_peer "$peer" "$remote_script$remote_flags"
    else
        if [[ "$do_dry_run" == "true" ]]; then
            log_msg "INFO:   [DRY-RUN] would run local uninstall-zfsutilities on $peer via ssh"
        else
            log_msg "INFO:   Peer has no deployed uninstall script; running local copy via ssh..."
            ssh -o ConnectTimeout=5 "root@$peer" "bash -s$remote_flags" < "$0"
        fi
    fi
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
main() {
    # Enable strict error handling for this function and its helpers, but
    # restore the caller's settings on return so sourcing tests are not affected.
    local old_set_e=0 old_set_u=0 old_set_o=0
    [[ $- == *e* ]] && old_set_e=1
    [[ $- == *u* ]] && old_set_u=1
    [[ $- == *o* ]] && old_set_o=1
    set -euo pipefail

    parse_args "$@"
    load_uninstall_config
    detect_node_mode
    detect_installed_state

    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO: === DRY RUN — no changes will be made ==="
    fi

    if [[ "$do_yes" != "true" ]]; then
        present_interactive_dialog
        confirm_uninstall
    fi

    uninstall_software

    if [[ "$do_purge" == "true" ]]; then
        uninstall_purge
    fi

    if [[ "$do_all_nodes" == "true" ]]; then
        uninstall_peer
    fi

    log_msg "INFO:"
    log_msg "INFO: === ZFSutilities uninstall complete ==="
    if [[ "$do_dry_run" == "true" ]]; then
        log_msg "INFO: This was a dry run; no changes were made."
    else
        log_msg "INFO: ZFSutilities has been removed from this host."
        if [[ "$do_purge" != "true" ]]; then
            log_msg "INFO: Configuration, logs, and history were preserved."
            log_msg "INFO: Run with --purge to remove them as well."
        fi
    fi

    if [[ $old_set_e -eq 0 ]]; then
        set +e
    fi
    if [[ $old_set_u -eq 0 ]]; then
        set +u
    fi
    if [[ $old_set_o -eq 0 ]]; then
        set +o pipefail
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
