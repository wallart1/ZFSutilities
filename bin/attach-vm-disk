#!/usr/bin/bash
# attach-vm-disk <zvol> <vmid> [dst-disk-key]
# Attaches an existing zvol to a Proxmox VM, rebuilding iSCSI infrastructure
# (two-node) if needed.
#
# Install to: /usr/local/lib/zfsutilities/bin/attach-vm-disk on BOTH hosts
# Run from:   the compute host (or storage host — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="/etc/pve/qemu-server"

usage() {
    log_msg "INFO: Usage: attach-vm-disk <zvol> <vmid> [dst-disk-key]"
    echo ""
    log_msg "INFO:   zvol        Full zvol path (e.g. threeamigos/proxmox/vm-100-disk-0)"
    log_msg "INFO:   vmid        Destination Proxmox VM ID"
    log_msg "INFO:   dst-disk-key  Optional target slot (e.g. scsi1). Auto-detected if omitted."
    echo ""
    log_msg "WARN: WARNING: The destination VM must be stopped."
    echo ""
    log_msg "INFO: Examples:"
    log_msg "INFO:   attach-vm-disk threeamigos/proxmox/vm-100-disk-0 200"
    log_msg "INFO:   attach-vm-disk threeamigos/proxmox/vm-100-disk-0 200 scsi2"
    exit 1
}

# --- Argument validation ---
[[ $# -ge 2 && $# -le 3 ]] || usage

zvol="$1"
dstvmid="$2"
dstkey="${3:-}"

[[ "$dstvmid" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $dstvmid"
    exit 1
}
# Dst-disk-key must be lowercase letters followed by digits (e.g. scsi0, ide1).
if [[ -n "$dstkey" ]]; then
    _dstkey_num="${dstkey##*[a-z]}"
    _dstkey_letters="${dstkey%"${_dstkey_num}"}"
    [[ -n "${_dstkey_letters}" && "${_dstkey_letters}" != *[^a-z]* \
        && -n "${_dstkey_num}" && "${_dstkey_num}" =~ ^[0-9]+$ ]] || {
        log_msg "FATAL: dst-disk-key must be like scsi0 or ide1, got: $dstkey"
        exit 1
    }
fi

# --- Parse zvol path ---
# Expected shape: <pool>/proxmox/vm-<vmid>-disk-<num>
# Parsed with parameter expansion (no regex).
# Example: "threeamigos/proxmox/vm-105-disk-0" -> pool=threeamigos vmid=105 disk=0
pool="${zvol%%/*}"
_zvol_tail="${zvol#"${pool}/"}"   # everything after the first /
_zvol_dir="${_zvol_tail%%/*}"      # component after the pool
_zvol_base="${_zvol_tail#*/}"      # remainder (unchanged if no more /)
srcvmid="${_zvol_base#vm-}"
disknum="${_zvol_base##*-disk-}"
srcvmid="${srcvmid%-disk-*}"
if [[ -z "$pool" || "$zvol" != */* || "$_zvol_dir" != proxmox \
    || "${_zvol_base}" != vm-*-disk-* || "${_zvol_base}" == */* \
    || ! "$srcvmid" =~ ^[0-9]+$ || ! "$disknum" =~ ^[0-9]+$ ]]; then
    log_msg "FATAL: Zvol path must be <pool>/proxmox/vm-<vmid>-disk-<num>, got: $zvol"
    exit 1
fi

backstore_name="vm-${srcvmid}-disk-${disknum}"
zvol_dev="/dev/zvol/${zvol}"

# --- Validate zvol exists ---
if ! zfs list -H -o name "$zvol" 2>/dev/null | grep -q .; then
    log_msg "FATAL: Zvol does not exist: $zvol"
    exit 1
fi

zvol_size=$(zfs get -H -o value volsize "$zvol" 2>/dev/null || echo "unknown")

# --- Delegate to compute host if run on storage node (two-node only) ---
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "attach-vm-disk")
    exec ssh -t root@"$compute_host" \
        "$remote_script '$zvol' '$dstvmid' '$dstkey'"
fi

# === Running on the compute host ===

dst_conf="$pve_conf_dir/${dstvmid}.conf"
[[ -f "$dst_conf" ]] || {
    log_msg "FATAL: VM config not found: $dst_conf"
    exit 1
}

# --- VM state check ---
status=$(qm status "$dstvmid" 2>/dev/null | awk '{print $2}')
if [[ "${status:-unknown}" != "stopped" ]]; then
    log_msg "WARN: VM $dstvmid is currently $status"
    log_msg "INFO:   Attaching a disk to a running VM is allowed but the guest OS may"
    log_msg "INFO:   need to rescan SCSI buses to see the new device."
    echo ""
    read -rp "  Continue anyway? (y/N): " proceed
    [[ "$proceed" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
    echo ""
fi

# --- Determine destination disk key ---
if [[ -n "$dstkey" ]]; then
    if grep -q "^${dstkey}:" "$dst_conf"; then
        log_msg "FATAL: Destination key $dstkey already exists in VM $dstvmid config"
        exit 1
    fi
else
    bus="scsi"
    n=0
    while grep -q "^${bus}${n}:" "$dst_conf"; do
        n=$((n + 1))
    done
    dstkey="${bus}${n}"
fi

log_msg "INFO: === attach-vm-disk ==="
log_msg "INFO:   Zvol:      $zvol"
log_msg "INFO:   Size:      $zvol_size"
log_msg "INFO:   Dest VM:   $dstvmid"
log_msg "INFO:   Dest key:  $dstkey"

# --- Two-node: ensure iSCSI backstore and LUN exist ---
lun_num=""
if is_two_node; then
    target=$(pool_to_target "$pool") || {
        log_msg "FATAL: Failed to map pool to target: $pool"
        exit 1
    }

    echo ""
    log_msg "INFO: Ensuring iSCSI infrastructure on $storage_host..."

    # Check/create backstore and LUN on storage host
    lun_result=$(ssh -o ConnectTimeout=10 root@"$storage_host" bash -s \
        "$zvol" "$zvol_dev" "$backstore_name" "$target" 2>&1 << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

set -e
zvol="$1"
zvol_dev="$2"
backstore_name="$3"
target="$4"

mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)

# Check if backstore exists
if targetcli /backstores/block ls 2>/dev/null | grep -q " ${backstore_name} "; then
    log_msg "INFO: BACKSTORE_EXISTS"
else
    targetcli /backstores/block create "$backstore_name" "$zvol_dev"
    targetcli "/backstores/block/${backstore_name}" set attribute emulate_tpu=1
    log_msg "INFO: BACKSTORE_CREATED"
fi

# Check if LUN is mapped
lun_line=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
    | grep " ${backstore_name} " | head -1)
existing_lun=""
if [[ -n "$lun_line" ]]; then
    existing_lun="${lun_line#*lun}"
    existing_lun="${existing_lun%%[!0-9]*}"
fi

if [[ -n "$existing_lun" ]]; then
    echo "LUN_EXISTS:$existing_lun"
else
    targetcli "/iscsi/${target}/tpg1/luns" create "/backstores/block/${backstore_name}"
    lun_line=$(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null \
        | grep " ${backstore_name} " | head -1)
    new_lun=""
    if [[ -n "$lun_line" ]]; then
        new_lun="${lun_line#*lun}"
        new_lun="${new_lun%%[!0-9]*}"
    fi
    echo "LUN_CREATED:$new_lun"
fi

# Save config
"$mydir/safe-iscsi-save"
SSHEOF
    ) || {
        log_msg "FATAL: Storage operations failed on $storage_host"
        exit 1
    }

    # Parse result
    if echo "$lun_result" | grep -q "LUN_EXISTS:"; then
        lun_num=$(echo "$lun_result" | grep "LUN_EXISTS:" | cut -d: -f2)
        log_msg "INFO: ✓ LUN $lun_num already mapped"
    elif echo "$lun_result" | grep -q "LUN_CREATED:"; then
        lun_num=$(echo "$lun_result" | grep "LUN_CREATED:" | cut -d: -f2)
        log_msg "INFO: ✓ LUN $lun_num created and mapped"
    else
        log_msg "FATAL: Could not determine LUN number from storage host"
        exit 1
    fi

    # Rescan
    log_msg "INFO: Triggering iSCSI rescan..."
    "$mydir/rescan-storage"
    log_msg "INFO: ✓ Rescan complete"
fi

# --- Build disk line ---
if is_two_node; then
    by_path="/dev/disk/by-path/ip-${storage_ip}:3260-iscsi-${target}-lun-${lun_num}"
    disk_line="${dstkey}: ${by_path},format=raw,discard=on,iothread=1,size=${zvol_size}"
else
    # Single-node: use Proxmox storage reference
    disk_line="${dstkey}: ${pool}:vm-${srcvmid}-disk-${disknum},"\
        "format=raw,discard=on,iothread=1,size=${zvol_size}"
fi

# --- Confirmation ---
echo ""
log_msg "INFO: Will add the following line to VM $dstvmid config:"
log_msg "INFO:   $disk_line"
echo ""
read -rp "Proceed? (y/N): " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
echo ""

# --- Add to VM config ---
echo "$disk_line" >> "$dst_conf"
log_msg "INFO: ✓ Added $dstkey to VM $dstvmid config"

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   Attached: $zvol → VM $dstvmid as $dstkey"
