#!/usr/bin/bash
# promote-vm-clone <vmid>
# Promotes a ZFS-cloned VM's disk zvols, cutting the dependency on the source VM.
#
# After promotion:
# - This VM's zvols become independent (no origin snapshot)
# - The shared clone-origin snapshots move to this VM's zvols
# - All other clones of those snapshots re-parent to this VM automatically
# - The former source VM's zvols become clones of this VM
#
# zfs promote is a metadata-only operation — no data is moved and no iSCSI
# reconfiguration is needed. Safe to run while the VM is running.
#
# To destroy the source VM after promotion:
#   Stop the source VM, then use zfsdelfs for each zvol (handles iSCSI teardown).
#
# Install to: /usr/local/lib/zfsutilities/bin/promote-vm-clone on BOTH the storage and compute hosts
# Run from:   the compute host (or the storage host directly — delegates via SSH)

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
source_helper zfslockmanager

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

usage() {
    log_msg "INFO: Usage: promote-vm-clone <vmid>"
    echo ""
    log_msg "INFO:   vmid   VM ID whose zvols should be promoted (must be a ZFS clone)"
    echo ""
    log_msg "INFO: Example: promote-vm-clone 310"
    exit 1
}

[[ $# -eq 1 ]] || usage

vmid="$1"
[[ "$vmid" =~ ^[0-9]+$ ]] || { log_msg "FATAL: vmid must be a number, got: $vmid"; exit 1; }

# --- If not on the compute host, delegate (two-node only) ---
if is_two_node && [[ "$this_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "promote-vm-clone")
    exec ssh -t root@"$compute_host" "$remote_script '$vmid'"
fi

# --- Discover clone zvols ---
if is_single_node; then
    clone_info=$(zfs list -H -o name,origin \
        | awk -v p="/proxmox/vm-${vmid}-disk-" \
            'index($1, p) && $2 != "-" {print $1 "\t" $2}')
else
    clone_info=$(ssh root@"$storage_host" bash -s "$vmid" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

vmid="$1"
zfs list -H -o name,origin \
    | awk -v p="/proxmox/vm-${vmid}-disk-" \
        'index($1, p) && $2 != "-" {print $1 "\t" $2}'
SSHEOF
    ) || { log_msg "FATAL: SSH to $storage_host failed"; exit 1; }
fi

[[ -n "$clone_info" ]] \
    || {
        log_msg "FATAL: No clone zvols found for VM ${vmid} — already promoted or not a ZFS clone"
        exit 1
    }

log_msg "INFO: === promote-vm-clone ==="
log_msg "INFO:   VM: ${vmid}"
echo ""
log_msg "INFO:   Zvols to promote:"
while IFS=$'\t' read -r zvol origin; do
    src_vmid=""
    if [[ "$origin" == *"/proxmox/vm-"*"-disk-"* ]]; then
        src_vmid="${origin#*"/proxmox/vm-"}"
        src_vmid="${src_vmid%%-disk-*}"
        [[ "$src_vmid" =~ ^[0-9]+$ ]] || src_vmid=""
    fi
    log_msg "INFO:     ${zvol}"
    log_msg "INFO:       origin: ${origin}"
    [[ -n "$src_vmid" ]] && log_msg "INFO:       cuts dependency on VM ${src_vmid}"
done <<< "$clone_info"
echo ""

read -rp "Proceed with promotion? (y/N): " confirm
[[ "$confirm" =~ ^[Yy]$ ]] || { log_msg "INFO: Aborted."; exit 0; }
echo ""

# --- Promote each zvol ---
if is_single_node; then
    zfslock_init
    while IFS=$'\t' read -r zvol origin; do
        if ! zfslock_wait_or_resolve "$zvol" "w" "promote-vm-clone"; then
            log_msg "FATAL: Could not acquire write lock on ${zvol}"
            exit 1
        fi
        zfs promote "$zvol" || { log_msg "FATAL: Promotion failed: $zvol"; exit 1; }
        zfslock_release "$zfslock_id"
        log_msg "INFO: ✓ Promoted: ${zvol}"
        log_msg "INFO:   snapshot moved from ${origin%%@*} to ${zvol}"
    done < <(zfs list -H -o name,origin \
        | awk -v p="/proxmox/vm-${vmid}-disk-" \
            'index($1, p) && $2 != "-" {print $1 "\t" $2}')
else
    run_remote_promote() {
        ssh root@"$storage_host" bash -s "$vmid" << 'SSHEOF'
mydir=$(realpath /usr/local/lib/zfsutilities/current/bin)
source "$mydir/bashinit"
bashinit

source_helper zfslockmanager

set -e
vmid="$1"
zfslock_init
while IFS=$'\t' read -r zvol origin; do
    if ! zfslock_wait_or_resolve "$zvol" "w" "promote-vm-clone"; then
        log_msg "FATAL: Could not acquire write lock on ${zvol}"
        exit 1
    fi
    zfs promote "$zvol"
    zfslock_release "$zfslock_id"
    log_msg "INFO: ✓ Promoted: ${zvol}"
    log_msg "INFO:   snapshot moved from ${origin%%@*} to ${zvol}"
done < <(zfs list -H -o name,origin \
    | awk -v p="/proxmox/vm-${vmid}-disk-" \
        'index($1, p) && $2 != "-" {print $1 "\t" $2}')
SSHEOF
    }

    if ! run_remote_promote; then
        log_msg "FATAL: Promotion failed on $storage_host"
        exit 1
    fi
fi

echo ""
log_msg "INFO: === Done ==="
log_msg "INFO:   VM ${vmid} zvols are now independent."
log_msg "INFO:   Other clones of the same snapshots have been re-parented to VM ${vmid}."
log_msg "INFO:   The former source VM can be destroyed when ready:"
log_msg "INFO:     1. Stop the source VM"
log_msg "INFO:     2. Remove its disks from the Proxmox config"
log_msg "INFO:     3. For each source zvol: zfsdelfs <pool>/proxmox/vm-<srcvmid>-disk-<N>"
