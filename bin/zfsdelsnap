#!/usr/bin/bash

# Remove a snapshot
#
# $1    Full dataset@snapshot name to be removed.
# $2    Minimum age in days. If the snapshot is younger than this, deletion is refused.
#       Use 0 to skip the age check.
# $3    (Optional) "releaseholds" means to remove matching holds on the snapshot
#       before destroying it. The holds to release are controlled by the
#       releaseholds_tags array (default: offsite-*). Any remaining holds cause
#       the snapshot to be skipped rather than destroyed.
# $4    (Optional) 'nocheckagainst' means bypass counterpart snap checking.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

# checkagainst's print-once marker (touched when a snapshot has no eligible
# counterpart) is keyed on the checkagainst shell's $PPID: this process when
# delsnap runs in a pipe subshell, or this process's parent when delsnap runs
# at top level. Remove both possible markers at exit so the table stays
# once-per-run without littering /tmp.
append_exit_trap 'rm -f "/tmp/fssalreadyprinted.$PPID" "/tmp/fssalreadyprinted.$$"'


# Print a snapshot's age in whole days (floor division), or -1 when its
# creation property cannot be read. Callers that only need a display value
# can map -1 to 0; gate logic must treat -1 as "age unknown".
snapshot_age_days() {
    local creation
    creation=$(zfs get -Hp -o value creation "$1" 2>/dev/null) || { echo -1; return; }
    [[ "$creation" =~ ^[0-9]+$ ]] || { echo -1; return; }
    echo $(( ($(date +%s) - creation) / 86400 ))
}

# Read-only preview of delsnap's deletion gates, for dry-run previews
# (zfsretain). $1 is the full dataset@snapshot a real run would pass to
# delsnap, $2 the minimum age in days (0 skips the age gate), $3 the
# releaseholds mode ('Y'/'N', delsnap $3 semantics), and $4 a short phase
# context (e.g. "Bucket", "Same-day") folded into the keep messages.
#
# Every gate delsnap can decide without mutating anything is evaluated for
# real: minimum age, the zfscheckagainst counterpart gates (in a subshell,
# so their exit-8 fatals cannot kill the preview), snapshot holds
# (classified exactly like delallholds, but nothing is released), and clone
# dependents. Returns 0 when delsnap would destroy the snapshot; returns 1
# after logging a "Would: Keep" line naming the gate that would hold it.
# Never prompts: the interactive rc-5 confirm maps to the conservative
# answer a non-interactive real run gets (ask_yn on EOF defaults to N).
_delsnap_preview_gate() {
    local _snap="$1" _minage="${2:-0}" _rh="${3:-N}" _ctx="${4:-}"
    local _age _rc _clones _holdline _holdtag _pattern _release_this
    local _held=() _remaining=()
    if [[ -n "$_ctx" ]]; then
        _ctx="$_ctx; "
    fi

    if [[ "$_minage" -gt 0 ]]; then
        _age=$(snapshot_age_days "$_snap")
        if [[ "$_age" -ge 0 && "$_age" -lt "$_minage" ]]; then
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}only ${_age}" \
                "days old (minimum age is ${_minage} days)."
            return 1
        fi
    fi

    # The subshell contains checkagainst's exit-8 fatals; its WARN detail
    # (counterpart dataset, offline pool names) still reaches the log. The
    # || capture keeps a set -e caller alive through non-zero verdicts.
    # rc mapping mirrors delsnap exactly: 0 and 4 proceed, 6/7 block, 5
    # would confirm interactively (the preview takes the conservative
    # non-interactive answer), 8 is fatal, and anything else is outside
    # checkagainst's contract — kept with a WARN rather than guessed at.
    source_helper zfscheckagainst
    _rc=0
    ( checkagainst "$_snap" ) || _rc=$?
    case "$_rc" in
        0|4) ;;
        7)
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}last remaining" \
                "common snapshot with a counterpart."
            return 1
            ;;
        6)
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}counterpart" \
                "pool(s) offline."
            return 1
            ;;
        5)
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}no eligible" \
                "checkagainst entries (an interactive run would confirm)."
            return 1
            ;;
        *)
            log_msg "WARN: checkagainst returned rc=${_rc} for ${_snap};" \
                "keeping it in the preview to stay conservative."
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}unexpected" \
                "checkagainst rc=${_rc}."
            return 1
            ;;
    esac

    if [[ "$_rh" = "Y" ]]; then
        # delallholds would release tags matching releaseholds_tags; the
        # rest survive and delsnap skips the deletion. Nothing is released
        # here — the preview only reads.
        while IFS= read -r _holdline; do
            [[ -z "$_holdline" ]] && continue
            _holdtag=$(echo "$_holdline" | awk '{print $2}')
            _release_this='N'
            if [[ ${#releaseholds_tags[@]} -eq 0 ]]; then
                _release_this='Y'
            else
                for _pattern in "${releaseholds_tags[@]}"; do
                    # shellcheck disable=SC2053
                    if [[ "$_holdtag" == $_pattern ]]; then
                        _release_this='Y'
                        break
                    fi
                done
            fi
            if [[ "$_release_this" = "N" ]]; then
                _remaining+=("$_holdtag")
            fi
        done < <(zfs holds -H "$_snap" 2>/dev/null)
        if [[ ${#_remaining[@]} -gt 0 ]]; then
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}holds remain" \
                "(${_remaining[*]}); a real run releases only matching tags."
            return 1
        fi
    else
        # Holds stay in place; zfs destroy would fail with "dataset is
        # busy" and skipbusy turns that into a skip.
        while IFS= read -r _holdline; do
            [[ -z "$_holdline" ]] && continue
            _holdtag=$(echo "$_holdline" | awk '{print $2}')
            _held+=("$_holdtag")
        done < <(zfs holds -H "$_snap" 2>/dev/null)
        if [[ ${#_held[@]} -gt 0 ]]; then
            log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}held (${_held[*]})."
            return 1
        fi
    fi

    _clones=$(zfs list -H -o clones "$_snap" 2>/dev/null)
    if [[ "$_clones" != "-" && -n "$_clones" ]]; then
        log_msg "INFO: Would: Keep ${_snap} --- ${_ctx}clone dependents."
        return 1
    fi
    return 0
}

function delsnap {
    local _local_bashinit
    _local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
    if [[ -f "$_local_bashinit" ]]; then
        source "$_local_bashinit"
    else
        source ~/bashinit
    fi
    bashinit
    unset _local_bashinit

    source_helper zfscheckagainst
    source_helper zfsdelallholds
    source_helper zfslockmanager
    source_helper zfs-diagnose-busy

    if [[ "$1" != '' ]]; then
        snaptoremove=$1
    else
        log_msg "FATAL: A snapshot to be removed must be given."
        source "$(find_zfsutility_script bashfatal)" 8
    fi

    # Extract parent dataset from snapshot name (everything before @)
    local parent_dataset="${snaptoremove%%@*}"

    # Initialize lock manager and acquire write lock on parent dataset
    zfslock_init
    local lock_rc
    zfslock_wait_or_resolve "$parent_dataset" "w" "deleting snapshot $snaptoremove"
    lock_rc=$?
    if [[ $lock_rc -eq 1 ]]; then
        log_msg "WARN: Lock acquisition aborted by user."
        return 1
    elif [[ $lock_rc -eq 2 ]]; then
        log_msg "INFO: Skipping $snaptoremove (lock conflict)."
        return 0
    fi
    local delsnap_lock="$zfslock_id"

    if [[ "$2" != '' ]]; then
        minage=$2
    else
        log_msg "FATAL: A minimum age (in days) must be specified. Use 0 to skip age check."
        zfslock_release "$delsnap_lock"
        source "$(find_zfsutility_script bashfatal)" 8
    fi

    if [[ $3 = 'releaseholds' ]]; then
        releaseholds='Y'
    else
        releaseholds='N'
    fi

    # Default the set of releasable hold tags if the caller did not set it.
    if [[ ${#releaseholds_tags[@]} -eq 0 ]]; then
        releaseholds_tags=('offsite-*')
    fi

    if ! zfs list -t snapshot "$snaptoremove" >/dev/null; then
        log_msg "FATAL: Snapshot $snaptoremove does not exist."
        zfslock_release "$delsnap_lock"
        source "$(find_zfsutility_script bashfatal)" 8
    fi

    # Check minimum age if minage > 0
    if [[ $minage -gt 0 ]]; then
        age_days=$(snapshot_age_days "$snaptoremove")

        if [[ $age_days -ge 0 && $age_days -lt $minage ]]; then
            log_msg "WARN: Snapshot $snaptoremove is only $age_days days old." \
                "Minimum age is $minage days."
            zfslock_release "$delsnap_lock"
            return 1
        fi
    fi

    if [[ $4 != 'nocheckagainst' ]]; then
        exec 3>&1  # Save stdout to fd 3
        checkagainst "$snaptoremove" >&3
        rc=$?
        exec 3>&-  # Close fd 3
        if [[ $rc -ne 0 ]]; then
#            log_msg $message   # There never seems to be a message here.
            if [[ $rc = 6 ]]; then
                # Counterpart pool offline - block deletion for safety
                log_msg "WARN: Deletion blocked - counterpart pool(s) offline."
                zfslock_release "$delsnap_lock"
                return $rc
            elif [[ $rc = 7 ]]; then
                log_msg "WARN: Deletion blocked - this is the last remaining common snapshot."
                zfslock_release "$delsnap_lock"
                return $rc
            elif [[ $rc = 5 ]]; then
                if ! ask_yn 'Do you want to remove this snapshot?'; then
                    zfslock_release "$delsnap_lock"
                    return $rc
                fi
            fi
        fi
    fi

    if [[ $releaseholds = 'Y' ]]; then
        delallholds "$snaptoremove" "${releaseholds_tags[@]}"
        if [[ -n "$zfs_delallholds_remaining_tags" ]]; then
            log_msg "WARN: Snapshot $snaptoremove still has holds" \
                "($zfs_delallholds_remaining_tags); skipping deletion."
            zfslock_release "$delsnap_lock"
            return 1
        fi
    fi

    # Check for clone dependents before attempting destruction
    local _clone_deps
    _clone_deps=$(zfs list -H -o clones "$snaptoremove" 2>/dev/null)
    if [[ "$_clone_deps" != "-" && -n "$_clone_deps" ]]; then
        log_msg "WARN: Snapshot $snaptoremove has clone dependents. Skipping deletion."
        zfslock_release "$delsnap_lock"
        return 1
    fi

    if ! zfs destroy "$snaptoremove"; then
        rc=$?
        diagnose_dataset_busy "$snaptoremove"
        if [[ $skipbusy = 'Y' ]]; then
            log_msg "WARN: Unable to remove snapshot $snaptoremove (rc=$rc). Skipping."
            zfslock_release "$delsnap_lock"
            return 1
        else
            log_msg "FATAL: Unable to remove snapshot $snaptoremove. rc=$rc."
            zfslock_release "$delsnap_lock"
            source "$(find_zfsutility_script bashfatal)" 8
        fi
    fi

    zfslock_release "$delsnap_lock"
    return 0
}
if calledbybash; then delsnap "$1" "$2" "$3" "$4"; fi
