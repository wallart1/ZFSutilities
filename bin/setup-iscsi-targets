#!/usr/bin/bash
# setup-iscsi-targets
# Create iSCSI targets, TPGs, and portals from the pool-to-target mappings
# defined in /etc/zfsutilities-node.conf.
#
# Idempotent — safe to run multiple times. Skips targets that already exist.
# Adds missing portals to existing targets.
#
# After target setup, runs the post-restore detection (lib/iscsi-lib.sh):
# on a bare-metal-restore signature it prints the evidence and offers to
# run reconcile-iscsi-state (the map-driven LUN rebuild). Pool-identity
# detection runs too, as evidence only — a renamed or replaced pool is
# human-resolved; no identity is ever renamed or repaired automatically.
#
# Usage: setup-iscsi-targets
# Run on the storage host.

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

# Shared targetcli/zvol parsers and the restore-time detection helpers live
# in lib/iscsi-lib.sh (node-lib is already loaded, so the library's own
# dependency bootstrap stays dormant).
ISCSI_LIB="${SETUP_ISCSI_TARGETS_ISCSI_LIB:-$(find_zfsutility_script iscsi-lib.sh)}"
source "$ISCSI_LIB"

source_helper rootcheck
rootcheck

# Exit silently in single-node mode
is_single_node && exit 0

# Verify we're on the storage host
my_host=$(hostname -s)
if [[ "$my_host" != "$storage_host" ]]; then
    log_msg "FATAL: Must run on the storage host ($storage_host), not $my_host"
    exit 1
fi

# Check prerequisite
if ! command -v targetcli >/dev/null 2>&1; then
    log_msg "FATAL: targetcli not found. Install rtslib-fb-targetctl first."
    exit 1
fi

log_msg "INFO: === Setting up iSCSI targets ==="
echo ""

created=0
existing=0
portals_added=0
acls_fixed=0
orphans_removed=0
skipped_for_orphans=0
portal_fatal=0

# Iterate over pool_target values (target short names)
# The target listing is captured once and grepped as a variable: a piped
# `targetcli /iscsi ls | grep -q` under `set -o pipefail` can flip a found
# target to "missing" when grep -q exits on the match while targetcli is
# still writing (SIGPIPE -> 141 -> pipeline failed).
_iscsi_ls_listing=$(targetcli /iscsi ls 2>/dev/null || true)
for pool in "${!pool_target[@]}"; do
    target_short="${pool_target[$pool]}"
    target_iqn="${iqn_prefix}:${target_short}"

    log_msg "INFO:   Pool: $pool → Target: $target_iqn"

    # Check if target already exists
    if grep -q "${target_iqn}" <<< "$_iscsi_ls_listing"; then
        existing=$((existing + 1))
        log_msg "INFO:     ✓ Target already exists"
    else
        # IQN-prefix drift guard: an existing target with the same short
        # name under a DIFFERENT prefix is an orphan (typically from an
        # earlier install in a different month — the default prefix is
        # date-derived). Creating the new-prefix target anyway splits the
        # LUN tree: Proxmox keeps logging in to the old target while LUN
        # tooling maps to the new one. Deletion is offered only after the
        # script itself verified the orphan unused (probe_target_usage:
        # guest configs and live sessions on the compute host); a target
        # in use — or unverifiable — is refused outright. When an orphan
        # remains (kept or refused), duplicate creation is skipped rather
        # than building a split-brain target tree.
        orphan_iqns=()
        while IFS= read -r _orphan; do
            [[ -n "$_orphan" ]] && orphan_iqns+=("$_orphan")
        done < <(targetcli /iscsi ls 2>/dev/null | while IFS= read -r _t_line; do
            read -ra _t_words <<< "$_t_line"
            for _t in "${_t_words[@]}"; do
                case "$_t" in
                    iqn.*)
                        # Same short name, different full IQN = orphan.
                        [[ "$_t" != "$target_iqn" && "$_t" == *":${target_short}" ]] \
                            && printf '%s\n' "$_t"
                        ;;
                esac
            done
        done)

        if [[ ${#orphan_iqns[@]} -gt 0 ]]; then
            log_msg "WARN:     Existing target(s) use the short name" \
                "'${target_short}' under a different IQN prefix:"
            for _orphan in "${orphan_iqns[@]}"; do
                log_msg "WARN:       $_orphan"
            done
            log_msg "WARN:     These are orphans (IQN prefix drift — the default" \
                "prefix is date-derived)."
            for _orphan in "${orphan_iqns[@]}"; do
                # Deletion is offered only for a target the script itself
                # verified unused (no guest config on the compute host
                # references it, no live session). One in use — or one that
                # could not be verified — is never offered for deletion:
                # probe_target_usage printed the evidence above.
                if ! probe_target_usage "$_orphan"; then
                    log_msg "FATAL:   Refusing to delete $_orphan — it is in" \
                        "use or could not be verified."
                    log_msg "FATAL:   Move the guest disks that reference it (or fix" \
                        "IQN_PREFIX in the node config), then re-run."
                    continue
                fi
                read -rp "Delete orphan target $_orphan? (verified unused) (y/N): " _del_answer
                if [[ "$_del_answer" =~ ^[Yy]$ ]]; then
                    if targetcli /iscsi delete "$_orphan" >/dev/null 2>&1; then
                        orphans_removed=$((orphans_removed + 1))
                        log_msg "INFO:     ✓ Deleted orphan target $_orphan"
                    else
                        log_msg "FATAL:   Could not delete orphan target $_orphan"
                    fi
                else
                    log_msg "WARN:     Keeping orphan target $_orphan"
                fi
            done
            # Re-check: only create the new target when no live orphan with
            # this short name remains (a kept orphan keeps the tree split).
            # Fresh capture (orphans may have just been deleted), grepped as
            # a variable — same SIGPIPE law as the listing above.
            _still_orphan=false
            _orphan_recheck=$(targetcli /iscsi ls 2>/dev/null || true)
            for _orphan in "${orphan_iqns[@]}"; do
                if grep -q "$_orphan" <<< "$_orphan_recheck"; then
                    _still_orphan=true
                fi
            done
            if [[ "$_still_orphan" == true ]]; then
                skipped_for_orphans=$((skipped_for_orphans + 1))
                log_msg "FATAL:   Skipping target creation for pool $pool —" \
                    "remove the orphan target(s)"
                log_msg "FATAL:   (targetcli /iscsi delete <iqn>) or fix IQN_PREFIX, then re-run."
                continue
            fi
        fi

        # Create the target
        if targetcli /iscsi create "$target_iqn" >/dev/null 2>&1; then
            created=$((created + 1))
            log_msg "INFO:     ✓ Target created"
        else
            log_msg "FATAL:   Failed to create target"
            continue
        fi
    fi

    # Ensure TPG1 exists (created automatically with target, but verify)
    tpg_path="/iscsi/${target_iqn}/tpg1"

    # Disable authentication (demo mode)
    targetcli "${tpg_path}" set attribute authentication=0 >/dev/null 2>&1
    targetcli "${tpg_path}" set attribute demo_mode_write_protect=0 >/dev/null 2>&1

    # A fresh TPG defaults to explicit-ACL mode with an empty ACL list,
    # which refuses every initiator (iscsiadm error 24 — authorization
    # failure). The dedicated storage network is the isolation boundary
    # in the two-node model, so admit initiators unless this TPG is under
    # explicit ACL management — never flip a TPG that already carries ACLs.
    # Captured and grepped as a variable (the SIGPIPE law at the /iscsi ls
    # probes above): a piped `grep -q` flips present ACL nodes to "none".
    _acls_ls=$(targetcli "${tpg_path}/acls" ls 2>/dev/null || true)
    if ! grep -q "iqn\." <<< "$_acls_ls"; then
        if targetcli "${tpg_path}" get attribute generate_node_acls 2>/dev/null \
            | grep -q "generate_node_acls=0"; then
            if targetcli "${tpg_path}" set attribute generate_node_acls=1 >/dev/null 2>&1; then
                acls_fixed=$((acls_fixed + 1))
                log_msg "INFO:     ✓ Demo-mode ACLs enabled (no explicit ACLs present)"
            else
                log_msg "WARN:   Could not enable demo-mode ACLs on ${target_short}"
            fi
        fi
    fi
done

# ------------------------------------------------------------------
# Portal binding pass. LIO portals are host-level sockets: rtslib's
# default 0.0.0.0:3260 wildcard binds INADDR_ANY:3260, and while ANY
# TPG on the host rides it, no specific :3260 portal can be created
# anywhere ("Could not create NetworkPortal in configFS" — F-034,
# live-verified). A per-target create-then-replace is therefore
# impossible; the specific bind requires purging the wildcard from
# every TPG first — safe only in the all-fresh window below, where no
# TPG can hold a session. Hosts with any pre-existing target keep
# today's posture: no purge, per-target attempt, honest WARN.
# (portals create takes TWO args; the one-token ip:port form is not a
# valid targetcli invocation.)
# ------------------------------------------------------------------

portal_tpgs=()
portal_missing=()
for pool in "${!pool_target[@]}"; do
    _tpg="/iscsi/${iqn_prefix}:${pool_target[$pool]}/tpg1"
    portal_tpgs+=("$_tpg")
    # Captured, not piped (the SIGPIPE law at the /iscsi ls probes).
    _portals_ls=$(targetcli "${_tpg}/portals" ls 2>/dev/null || true)
    if grep -q "${storage_ip}:3260" <<< "$_portals_ls"; then
        log_msg "INFO:     ✓ Portal ${storage_ip}:3260 already exists (${pool_target[$pool]})"
    else
        portal_missing+=("$_tpg")
    fi
done

if (( ${#portal_missing[@]} > 0 )) \
        && (( created > 0 && existing == 0 && skipped_for_orphans == 0 )); then
    # All-fresh window: purge the wildcard from every TPG (all of them
    # are this run's), then bind each missing specific portal.
    for _tpg in "${portal_tpgs[@]}"; do
        # Captured, not piped (the SIGPIPE law at the /iscsi ls probes).
        _portals_ls=$(targetcli "${_tpg}/portals" ls 2>/dev/null || true)
        if grep -q "0.0.0.0:3260" <<< "$_portals_ls"; then
            if targetcli "${_tpg}/portals" delete 0.0.0.0 3260 >/dev/null 2>&1; then
                :
            else
                _short="${_tpg##*:}"; _short="${_short%%/*}"
                log_msg "WARN:   Could not remove the default wildcard on ${_short}" \
                    "— the specific bind needs a host-wide purge; retry after fixing targetcli"
            fi
        fi
    done
    _bind_failed=false
    for _tpg in "${portal_missing[@]}"; do
        _short="${_tpg##*:}"; _short="${_short%%/*}"
        if targetcli "${_tpg}/portals" create "${storage_ip}" 3260 >/dev/null 2>&1; then
            portals_added=$((portals_added + 1))
            log_msg "INFO:     ✓ Portal ${storage_ip}:3260 bound on ${_short}" \
                "(default wildcard removed)"
        else
            _bind_failed=true
            log_msg "WARN:   Could not add portal ${storage_ip}:3260 on ${_short}" \
                "(bind refused — see the wildcard handling below)"
        fi
    done
    if [[ "$_bind_failed" == true ]]; then
        # Rollback: restore the wildcard serving posture on any TPG the
        # purge left portal-less; a TPG that cannot get ANY portal back
        # is fatal (the F-024 law — never strand a TPG portal-less).
        for _tpg in "${portal_missing[@]}"; do
            _short="${_tpg##*:}"; _short="${_short%%/*}"
            # Captured, not piped (the SIGPIPE law at the /iscsi ls probes).
            _portals_ls=$(targetcli "${_tpg}/portals" ls 2>/dev/null || true)
            if ! grep -q ":3260" <<< "$_portals_ls"; then
                if targetcli "${_tpg}/portals" create 0.0.0.0 3260 >/dev/null 2>&1; then
                    log_msg "WARN:   Wildcard restored on ${_short} — the specific bind" \
                        "failed; target serves on 0.0.0.0:3260 (fix targetcli and re-run)"
                else
                    portal_fatal=1
                    log_msg "FATAL: ${_short} left portal-less — the specific bind and" \
                        "the wildcard restore both failed"
                fi
            fi
        done
    fi
elif (( ${#portal_missing[@]} > 0 )); then
    # Mixed or established host: an existing target's portal composition
    # is established state — only the per-target specific add is
    # attempted, never a wildcard removal.
    for _tpg in "${portal_missing[@]}"; do
        _short="${_tpg##*:}"; _short="${_short%%/*}"
        if targetcli "${_tpg}/portals" create "${storage_ip}" 3260 >/dev/null 2>&1; then
            portals_added=$((portals_added + 1))
            log_msg "INFO:     ✓ Portal ${storage_ip}:3260 added on ${_short}"
        else
            log_msg "WARN:   Could not add portal ${storage_ip}:3260 on ${_short} — target" \
                "keeps its current portal (a host-wide 0.0.0.0:3260 wildcard blocks the bind)"
        fi
    done
fi

echo ""

# Save config if anything changed
if [[ $created -gt 0 || $portals_added -gt 0 || $acls_fixed -gt 0 || $orphans_removed -gt 0 ]]; then
    targetcli saveconfig >/dev/null 2>&1
    log_msg "INFO: ✓ iSCSI configuration saved"
else
    log_msg "INFO: ✓ No changes needed (all targets already configured)"
fi

echo ""
log_msg "INFO:   Targets created:   $created"
log_msg "INFO:   Targets existing:  $existing"
log_msg "INFO:   Portals added:     $portals_added"
log_msg "INFO:   Orphans removed:   $orphans_removed"
if [[ $skipped_for_orphans -gt 0 ]]; then
    log_msg "INFO:   Skipped (orphans kept): $skipped_for_orphans"
    log_msg "FATAL: Resolve the orphan targets above, then re-run."
    exit 1
fi
if [[ $portal_fatal -gt 0 ]]; then
    log_msg "FATAL: At least one target was left portal-less — fix targetcli and re-run."
    exit 1
fi

# ------------------------------------------------------------------
# Post-restore detection: with the targets in place, read the live state
# for the bare-metal-restore signatures (lib/iscsi-lib.sh) and offer the
# map-driven reconcile. Same verified-evidence + y/N pattern as orphan
# target deletion: the evidence is printed first, the action is offered
# only afterwards, and declining leaves the system untouched.
# ------------------------------------------------------------------
detect_reset
detect_stale_lio_files
detect_manifest_without_zvols
detect_vm_refs_missing_live

if [[ ${#_detect_lines[@]} -eq 0 ]]; then
    log_msg "INFO: ✓ No post-restore signature found (LIO state is consistent)"
else
    log_msg "WARN: Post-restore signature detected — the OS-disk iSCSI state looks regressed:"
    for _finding in "${_detect_lines[@]}"; do
        log_msg "WARN:   $_finding"
    done
    echo ""
    log_msg "INFO: reconcile-iscsi-state can rebuild the missing LUNs and ACLs from the"
    log_msg "INFO: pool-resident state map, at each LUN's recorded number."
    _reconcile_script="${SETUP_ISCSI_TARGETS_RECONCILE:-$mydir/reconcile-iscsi-state}"
    if [[ ! -f "$_reconcile_script" ]]; then
        log_msg "WARN: reconcile-iscsi-state not found at $_reconcile_script —"
        log_msg "WARN: run it manually once it is installed"
    else
        read -rp "Run reconcile-iscsi-state now? (y/N): " _reconcile_answer
        if [[ "$_reconcile_answer" =~ ^[Yy]$ ]]; then
            echo ""
            if "$_reconcile_script"; then
                log_msg "INFO: ✓ Reconcile complete"
            else
                log_msg "FATAL: reconcile-iscsi-state reported problems — resolve them"
                log_msg "FATAL: and re-run it"
                exit 1
            fi
        else
            log_msg "WARN: Reconcile not run — run 'sudo reconcile-iscsi-state' when ready"
        fi
    fi
fi

# ------------------------------------------------------------------
# Pool-identity detection: its own evidence block, never part of the
# reconcile offer above — reconcile rebuilds LUNs, it cannot resolve a
# renamed or replaced pool. Detection only; identities are human-resolved
# by design.
# ------------------------------------------------------------------
detect_reset
detect_pool_identity

if [[ ${#_detect_lines[@]} -eq 0 ]]; then
    log_msg "INFO: ✓ No pool-identity finding (imported pools match the config and the map)"
else
    log_msg "WARN: Pool-identity finding — a pool name may not be backed by the"
    log_msg "WARN: pool the config expects:"
    for _finding in "${_detect_lines[@]}"; do
        log_msg "WARN:   $_finding"
    done
    log_msg "WARN: Identities are never repaired automatically — verify the pool"
    log_msg "WARN: name/GUID by hand before saving iSCSI state or editing VM disks."
fi

echo ""
log_msg "INFO: === Done ==="
