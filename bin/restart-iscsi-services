#!/usr/bin/bash
# restart-iscsi-services
# Restart iSCSI target services after ZFS keys are loaded.
#
# Does systemctl stop/start. The boot-config.conf drop-in causes ExecStart to
# restore from saveconfig-boot.json (encrypted backstores excluded). After the
# service is up, this script explicitly calls iscsi-add-encrypted-luns to add
# encrypted LUNs back if their backing zvols are available (keys loaded).
#
# Reads encrypted zvol list from /etc/zfsutilities/iscsi-encrypted-luns.conf,
# falling back to the legacy /etc/iscsi-encrypted-luns.conf.
# Format: backstore_name:device_path:target_short_name
#
# Install to: /usr/local/lib/zfsutilities/bin/restart-iscsi-services on the storage host

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck

rootcheck

# Storage-node dependency: LIO target stack. The compute host needs Proxmox VE,
# but this script runs on the storage host and does not require a local qm binary.
if ! command -v targetcli >/dev/null 2>&1; then
    log_msg "FATAL: targetcli not found. Install the LIO target stack on this storage host."
    log_msg "FATAL:   On Debian/Ubuntu: apt-get install targetcli-fb"
    exit 1
fi

if ! systemctl cat rtslib-fb-targetctl >/dev/null 2>&1; then
    log_msg "FATAL: rtslib-fb-targetctl.service not found." \
            "Install the LIO target stack on this storage host."
    log_msg "FATAL:   On Debian/Ubuntu: apt-get install python3-rtslib-fb"
    exit 1
fi

conf="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$conf" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    conf="/etc/iscsi-encrypted-luns.conf"
fi

# ------------------------------------------------------------------
# Safety check: warn if any VMs are running before tearing down iSCSI
# ------------------------------------------------------------------
check_running_vms() {
    is_single_node && return 0

    local backstores
    backstores=$(targetcli /backstores/block ls 2>/dev/null)
    [[ -z "$backstores" ]] && return 0

    local vmids=""

    while IFS= read -r target; do
        [[ -z "$target" ]] && continue
        while IFS= read -r line; do
            # Extract the backstore name after "block/", stopping at the
            # first whitespace or '/' (fixed-string expansion, no regex).
            local bsname=""
            local _rest="${line#*block/}"
            if [[ "$_rest" != "$line" ]]; then
                bsname="${_rest%%[[:space:]/]*}"
            fi
            [[ -z "$bsname" ]] && continue

            # Extract the backing zvol path (/dev/zvol/...), stopping at the
            # first space or ')'.
            local zvol=""
            local _bs_line
            _bs_line=$(echo "$backstores" | grep " ${bsname} " | head -1)
            if [[ -n "$_bs_line" ]]; then
                _rest="${_bs_line#*/dev/zvol/}"
                if [[ "$_rest" != "$_bs_line" ]]; then
                    zvol="/dev/zvol/${_rest%%[ )]*}"
                fi
            fi
            [[ -z "$zvol" ]] && continue

            # Extract the numeric vmid from .../vm-<id>-disk-<n>.
            local vmid=""
            _rest="${zvol#*/vm-}"
            if [[ "$_rest" != "$zvol" && "$_rest" == *-disk-* ]]; then
                local _vmid="${_rest%%-disk-*}"
                [[ -n "$_vmid" && "$_vmid" != *[!0-9]* ]] && vmid="$_vmid"
            fi
            [[ -z "$vmid" ]] && continue

            if [[ -z "$vmids" ]]; then
                vmids="$vmid"
            elif [[ " $vmids " != *" $vmid "* ]]; then
                vmids="$vmids $vmid"
            fi
        done < <(targetcli "/iscsi/${target}/tpg1/luns" ls 2>/dev/null)
    done < <(targetcli /iscsi ls 2>/dev/null | while IFS= read -r _t_line; do
        # targetcli separates each target name from its dotted leader with a
        # space, so the IQN is a whole whitespace-delimited token.
        read -ra _t_words <<< "$_t_line"
        for _t in "${_t_words[@]}"; do
            case "$_t" in iqn.*) printf '%s\n' "$_t" ;; esac
        done
    done)

    [[ -z "$vmids" ]] && return 0

    local running_vms=()
    for vmid in $vmids; do
        local status
        status=$(ssh -o ConnectTimeout=5 -o BatchMode=yes \
            root@"$compute_host" "qm status '$vmid' 2>/dev/null | awk '{print \$2}'" \
            2>/dev/null || true)
        if [[ "$status" == "running" ]]; then
            running_vms+=("$vmid")
        fi
    done

    if [[ ${#running_vms[@]} -gt 0 ]]; then
        echo ""
        log_msg "FATAL: The following VMs are currently running on $compute_host:"
        for vm in "${running_vms[@]}"; do
            log_msg "INFO:     VM $vm"
        done
        echo ""
        log_msg "INFO: Restarting iSCSI will disconnect their disks and cause I/O errors."
        log_msg "FATAL: Stop the VMs first, then re-run this script."
        exit 1
    fi
}

# ------------------------------------------------------------------
# Main
# ------------------------------------------------------------------
main() {
    log_msg "INFO: === Restarting iSCSI Target Services ==="

    check_running_vms

    # Stop the iSCSI target service
    log_msg "INFO: Stopping rtslib-fb-targetctl..."
    systemctl stop rtslib-fb-targetctl

    # Start the iSCSI target service
    # ExecStart restores boot config (encrypted backstores excluded)
    log_msg "INFO: Starting rtslib-fb-targetctl..."
    systemctl start rtslib-fb-targetctl

    # Add encrypted LUNs back if their zvols are now available
    echo ""
    log_msg "INFO: Adding encrypted LUNs if keys are loaded..."
    local add_encrypted_luns
    add_encrypted_luns=$(find_zfsutility_script iscsi-add-encrypted-luns 2>/dev/null || true)
    if [[ -n "$add_encrypted_luns" ]]; then
        "$add_encrypted_luns" || log_msg "WARN: iscsi-add-encrypted-luns returned non-zero"
    else
        log_msg "WARN: iscsi-add-encrypted-luns not found; encrypted LUNs were not added"
    fi

    # Show encrypted LUN status
    echo ""
    log_msg "INFO: Encrypted LUN status:"
    if [[ -f "$conf" ]]; then
        while IFS=: read -r name device _target; do
            [[ -z "$name" || "$name" == \#* ]] && continue
            if targetcli /backstores/block ls 2>/dev/null | grep -q " ${name} "; then
                log_msg "INFO:   ✓ $name configured"
            elif [[ ! -e "$device" ]]; then
                log_msg "WARN:   $name — device not available (keys not loaded?)"
            else
                log_msg "WARN:   $name — missing from iSCSI target"
            fi
        done < "$conf"
    else
        log_msg "INFO:   (no encrypted LUNs config at $conf)"
    fi

    # Save only if all expected LUNs are active
    echo ""
    "$mydir/safe-iscsi-save"

    # Show current status
    echo ""
    log_msg "INFO: === iSCSI Target Status ==="
    targetcli ls /iscsi 2>/dev/null | grep -E "iqn\.|LUNs"

    echo ""
    log_msg "INFO: === Complete ==="
}

# Run main only when executed directly, not when sourced for tests.
if [[ -z "${RESTART_ISCSI_SERVICES_TEST_MODE:-}" ]] && [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main
fi
