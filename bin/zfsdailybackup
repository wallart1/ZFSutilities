#!/usr/bin/bash
# shellcheck disable=SC1090,SC2034,SC2154
#
# Example daily backup orchestration.
#
# This script is intentionally opinionated and contains example hostnames,
# pool names, and paths from the original deployment. Before using it in a
# new environment, edit the variables and paths below (for example,
# `pull_rocky`, `pull_tweety`, `pull_stewie`, and the `/home/dan/` remote
# paths) to match your own infrastructure, or use it as a template for a
# custom daily-backup script.
#
# $1    (Optional) Overrides
#
# No strict mode here by design: this is a user-customizable template
# (the orchestrator exemption in the developer guide's coding policies),
# and site edits must not be subjected to bash strictness.



_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

# Node configuration (single-node or two-node): node-lib owns the conf
# precedence (the FHS conf, then the legacy paths, FATAL with the
# install hint when absent) and resolves the lowercase storage_host /
# compute_host pair for BOTH node modes.  The previous hand-rolled copy
# defined that pair only in single-node mode — two-node runs left
# compute_host unset (found live by the j22 full-function leg,
# run-20261124-004523: the strict-mode site-adapted copy died "unbound
# variable" at the compute pull banner; stock non-strict runs degraded
# to a failed-pull WARN).
NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"

source_helper rootcheck
rootcheck

source_helper zfssnapbuild
source_helper zfs-send-receive
source_helper zfsoverrides

SECONDS=0

_write_trailer() {
    local rc=$?
    if [[ -n "${ZFSUTILITIES_LOG_FILE:-}" && "${ZFSUTILITIES_LOG_INHERIT:-}" != "Y" ]]; then
        echo "# END: rc=${rc}, duration=${SECONDS}s" >> "$ZFSUTILITIES_LOG_FILE"
    fi
}
append_exit_trap _write_trailer
source_helper zfscleanup
source_helper rsync-dailybackup

# rsync-dailybackup is a SITE template (the shipped one carries
# `set -euo pipefail`), and sourcing it leaks that strictness into the
# rest of THIS orchestrator — whose header declares it deliberately
# NON-strict (the coding-policy template exemption).  Restore the
# orchestrator's documented mode at the source point: under the leaked
# set -e, every later rc-checking helper call dies silently — the prune
# leg's checkagainst contract (rc 5/6/7 are designed outcomes
# zfsdelsnap reads) never got to read its rc (found live by the j22
# full-function leg, run-20261124-025349).
set +euo pipefail

autoresume='Y'
includes=()
excludes=()
startwith=''
receive_F_option='F'        # See 'man zfs-receive' for an explaination of the -F option.
                            # Used here to help ensure a faithful backups.
releaseholds='N'
pull_rocky='Y'
pull_tweety='Y'
pull_stewie='Y'
backup_threeamigos_proxmox='Y'
backup_NVME1='Y'
prune='Y'
dryrun='N'
pre_backup_script_enabled='N'
pre_backup_script=''

nextsnap=$(zfssnapbuild)

# Overrides are any quoted sequence of shell commands separated by semicolons. This provides
# a way to adjust parameters from the command line without having to modify the script.
if [[ "${1:-}" != '' ]]; then overrides "$1"; fi
if [[ ${nextsnap:0:1} != '@' ]]; then nextsnap='@'$nextsnap; fi

log_msg "INFO: New snapshot: $nextsnap."
read -rp 'Press enter to continue.'

# Pre-backup script
if [[ $pre_backup_script_enabled = 'Y' && $pre_backup_script != '' ]]; then
    if [[ $dryrun != 'N' ]]; then
        log_msg "INFO: Dry-run: Would run pre-backup script"
    else
        log_msg "INFO: Running pre-backup script..."
        if bash -c "$pre_backup_script"; then
            log_msg "INFO: Pre-backup script completed successfully."
        else
            log_msg "FATAL: Pre-backup script failed (rc=$?). Aborting backup."
            exit 1
        fi
    fi
fi

push_rsync_scripts() {
    local host="$1"
    log_msg "INFO: Pushing rsync scripts and node config to ${host}..."
    scp -q "$mydir/rsync-dailybackup" "root@${host}:/home/dan/" \
        || { log_msg "WARN: Failed to push scripts to ${host}"; return 1; }
    scp -q ~/bashinit "root@${host}:/root/bashinit" \
        || log_msg "WARN: could not push bashinit to ${host}"
    # Push the node config so rsync-dailybackup can find STORAGE_HOST on remote hosts
    scp -q "$NODE_CONF" "root@${host}:/etc/zfsutilities-node.conf" \
        || log_msg "WARN: could not push node config to ${host}"
}

_run_remote_pull() {
    local host="$1"
    local label="$2"
    local rc=0
    if ! push_rsync_scripts "$host"; then
        rc=1
    fi
    if [[ $rc -eq 0 ]]; then
        ssh root@"$host" /home/dan/rsync-dailybackup || rc=$?
    fi
    if [[ $rc -ne 0 ]]; then
        log_msg "WARN: Pull from ${label} failed (rc=${rc}); continuing to next step."
    fi
    return 0
}

_run_local_pull() {
    local rc=0
    ( rsync-dailybackup ) || rc=$?
    if [[ $rc -ne 0 ]]; then
        log_msg "WARN: Local pull failed (rc=${rc}); continuing to next step."
    fi
    return 0
}

if [[ $pull_rocky = 'Y' ]]; then
    log_msg "INFO: ***  Pulling rsync backup from Rocky  ***"
    if [[ $dryrun != 'N' ]]; then
        log_msg "INFO: Dry-run: Would push rsync scripts to rocky and run remote backup"
    else
        _run_remote_pull rocky "Rocky"
    fi
fi

if [[ $pull_tweety = 'Y' && "$node_mode" == "two-node" ]]; then
    log_msg "INFO: ***  Pulling rsync backup from ${compute_host}  ***"
    if [[ $dryrun != 'N' ]]; then
        log_msg "INFO: Dry-run: Would push rsync scripts to ${compute_host} and run remote backup"
    else
        _run_remote_pull "$compute_host" "$compute_host"
    fi
fi

if [[ $pull_stewie = 'Y' ]]; then
    log_msg "INFO: ***  Pulling rsync backup from ${storage_host} (local)  ***"
    if [[ $dryrun != 'N' ]]; then
        log_msg "INFO: Dry-run: Would run local rsync and package backup"
    else
        _run_local_pull
    fi
fi

if [[ $backup_threeamigos_proxmox = 'Y' ]]; then
    log_msg "INFO: ***  Backing up threeamigos/proxmox to fivebays/threeamigos/proxmox  ***"
    sourcefs="threeamigos/proxmox"
    destfs="fivebays"
    send-receive
fi

if [[ $backup_NVME1 = 'Y' ]]; then
    log_msg "INFO: ***  Backing up NVME1 to fivebays/NVME1  ***"
    sourcefs="NVME1"
    destfs="fivebays"
    send-receive
fi

if [[ $dryrun != 'N' ]]; then
    log_msg "INFO: Dry-run: Skipping snapfile cleanup (preserved for real run)"
else
    removesnapfile
fi

if [[ $prune = 'Y' ]]; then
    if [[ $dryrun != 'N' ]]; then
        log_msg "INFO: Dry-run: Would prune snapshots."
    else
        log_msg "INFO: ***  Pruning snapshots.  ***"
        # Re-assert the orchestrator's documented non-strict mode AT THE
        # PRUNE LEG: sourced standalone helpers re-arm strictness in
        # this shell long after the rsync-source containment above
        # (live-traced: source_helper zfsdelfs carries set -euo
        # pipefail), and the prune chain's rc contract predates strict
        # mode — checkagainst's 5/6/7 and the per-snapshot deletion
        # verdicts are designed outcomes the callers must read, not
        # aborts (found live by the j22 full-function leg).
        set +euo pipefail
        cleanup '' '' 'dailybackup'
    fi
fi

log_msg "INFO: ***  zfsdailybackup completed.  ***"

