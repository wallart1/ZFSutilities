#!/usr/bin/bash
# Restore a ZFS stream that was created by the zfs send command

function restoresendstream {
    local _local_bashinit
    _local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
    if [[ -f "$_local_bashinit" ]]; then
        source "$_local_bashinit"
    else
        source ~/bashinit
    fi
    bashinit
    unset _local_bashinit

    source_helper rootcheck
    rootcheck
    source_helper bashsetx
    source_helper zfslockmanager

    zfslock_init
    
    # Source path example:
    #   /temp/archive/proxmox/tari-vm-205/threeamigos/proxmox/vm-205-disk-0.zfssendstream
    
    # Destination path example:
    #   threeamigos/proxmox/vm-205-disk-0
    
    local autoproceed='Y'
    local vm='vm-205'
    local vmname='tari'
    local destfs='threeamigos/proxmox'
    local sourcedir='/temp/archive/proxmox/'"$vmname"'-'"$vm"'/'"$destfs"
        # Example: /temp/archive/proxmox/tari-vm-205/threeamigos/proxmox
    local filepattern="$vm"'-disk-*.zfssendstream'
    
    local files=()
    readarray -t files < <(find "$sourcedir" -maxdepth 1 -name "$filepattern" -print)
    # Get array of file names using the globbing pattern in $filepattern.

    # Check if any files matched
    if [[ ! -e "${files[0]}" ]]; then
        log_msg "FATAL: No matching files found."
        source "$(find_zfsutility_script bashreturn)" 8
    fi

#    # List the files
    log_msg 'INFO: Preparing to process these files:'
    local file

#    printf '\t%s\n' "${files[@]}"
    for file in "${files[@]}"; do
        # Get the text after the last '/'. Then get the text before the '.'.
        local destfile
        destfile=$(echo "$file" | awk -F'/' '{print $NF}' | awk -F'.' '{print $1}')
        local fulldestfs="$destfs"'/'"$destfile"
        log_msg "INFO: \tRestore $file to $fulldestfs."
    done
    if [[ $autoproceed != 'Y' ]]; then
        read -rp 'Press enter to continue.'
    fi

    # Rate governance: pace each receive at the enclosure cap of the
    # destination pool (resolved once for the whole restore; the source is
    # a file, so only the destination pool can be capped). Fail open: a
    # resolver failure WARNs and the restore proceeds unpaced, exactly as
    # before caps existed. With no cap configured the pipeline is
    # byte-identical (no pacer stage).
    local rate_limit="" resolver pacer
    resolver="${ZFSUTILITIES_ENCLOSURE_RATE:-$(
        find_zfsutility_script enclosure_rate.py 2>/dev/null || true)}"
    if [[ -n "$resolver" && -x "$resolver" ]]; then
        if ! rate_limit=$("$resolver" --min-with "" "${destfs%%/*}"); then
            log_msg "WARN: Enclosure rate resolution failed;" \
                "ignoring enclosure caps for this transfer"
            rate_limit=""
        fi
    else
        log_msg "WARN: Enclosure rate resolution failed" \
            "(enclosure_rate.py not found); ignoring enclosure caps for this transfer"
    fi
    local -a pace_argv=()
    if [[ -n "$rate_limit" ]]; then
        pacer=$(find_zfsutility_script pace_stream.py 2>/dev/null || true)
        if [[ -z "$pacer" ]]; then
            log_msg "FATAL: Rate limit set but pace_stream.py not found"
            source "$(find_zfsutility_script bashreturn)" 8
        fi
        log_msg "INFO: Enclosure rate cap applied: ${rate_limit}"
        pace_argv=(python3 "$pacer" "$rate_limit")
    fi

    for file in "${files[@]}"; do
        # Get the text after the last '/'. Then get the text before the '.'.
        local destfile
        destfile=$(echo "$file" | awk -F'/' '{print $NF}' | awk -F'.' '{print $1}')
        local fulldestfs="$destfs"'/'"$destfile"
        log_msg "INFO: cat $file | zfs receive -v $fulldestfs"
        if [[ $autoproceed != 'Y' ]]; then
            read -rp 'Press enter to continue.'
        fi
        if ! zfslock_wait_or_resolve "$fulldestfs" "w" "zfsrestoresendstream"; then
            log_msg "FATAL: Could not acquire write lock on ${fulldestfs}"
            source "$(find_zfsutility_script bashreturn)" 8
        fi
        local receive_lock="$zfslock_id"
        if ! pv "$file" | "${pace_argv[@]}" | zfs receive -v "$fulldestfs"; then
            zfslock_release "$receive_lock" || true
            log_msg 'FATAL: Unable to restore file.'
            source "$(find_zfsutility_script bashreturn)" 8
        fi
        zfslock_release "$receive_lock" || true
    done
}
restoresendstream

