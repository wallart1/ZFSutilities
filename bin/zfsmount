#!/usr/bin/bash
# ZFS unmount all filesystems in a subtree
# $1    = "mount" or "unmount"
# $2    = Filesystem subtree to unmount

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
source_helper zfslockmanager

if [[ $1 != 'mount' ]] && [[ $1 != 'unmount' ]]; then
    log_msg "FATAL: \$1 must be either \"mount\" or \"unmount\""
    exit 8
fi
command=$1
if [[ $command = "mount" ]]; then
    mountedcondition='no'
    dstype='filesystem'
else
    mountedcondition='yes'
    dstype='all'
fi
if [[ $2 = "" ]]; then log_msg "FATAL: A subtree must be specified."; exit 8; fi
subtree=$2
rootcheck

zfslock_init

readarray -t mountarray < <(zfs list -Hrt "$dstype" -o name "$subtree")

if [[ ${#mountarray[@]} -gt 0 ]]; then
    log_msg "INFO: About to $command the following datasets:"
    declare -i x=0
    for fs in "${mountarray[@]}"; do
        if [[ $(zfs get -H mounted "$fs" | awk '{print $3}') = "$mountedcondition" ]]; then
            echo "$fs"
            x=$((x+1))
        fi
    done
    if [[ $x -gt 0 ]]; then
        read -rp "Press enter to proceed."
    else
        log_msg "WARN: No eligible datasets were found in $subtree."
        exit 4
    fi

    for fs in "${mountarray[@]}"; do
        if [[ $(zfs get -H mounted "$fs" | awk '{print $3}') = "$mountedcondition" ]]; then
            lock_rc=""
            zfslock_wait_or_resolve "$fs" "w" "zfsmount $command"
            lock_rc=$?
            if [[ $lock_rc -ne 0 ]]; then
                if [[ $lock_rc -eq 2 ]]; then
                    log_msg "WARN: Skipping ${fs} (user skipped lock acquisition)."
                    continue
                fi
                log_msg "FATAL: Could not acquire write lock on ${fs}; aborting."
                exit 8
            fi
            fs_lock="$zfslock_id"
            zfs "$command" "$fs"
            zfslock_release "$fs_lock" || true
        fi
    done
else
    log_msg "WARN: No elibigle datasets found in $subtree."
    exit 4
fi

