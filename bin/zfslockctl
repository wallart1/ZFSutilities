#!/usr/bin/bash
# zfslockctl - CLI tool for managing ZFS dataset locks
#
# Usage:
#   zfslockctl list [dataset]        # List active locks (optionally filter by dataset)
#   zfslockctl status <dataset>      # Check lock status for a dataset
#   zfslockctl release <lock_id>     # Force release a lock (by lock file path or dataset)
#   zfslockctl cleanup               # Remove stale locks
#   zfslockctl wait <dataset> <type> # Wait for lock availability
#   zfslockctl help                  # Show this help

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

source_helper rootcheck
rootcheck
source_helper zfslockmanager

# ==============================================================================
# Command Implementations
# ==============================================================================

# List active locks
cmd_list() {
    local filter="$1"
    local lockfile
    local found=0

    if [[ ! -d "$ZFSLOCK_LOCKS_DIR" ]]; then
        log_msg "INFO: No locks directory found."
        return 0
    fi

    # Clean up stale locks first
    zfslock_cleanup_stale 2>/dev/null

    printf "%-40s %-6s %-8s %-20s %s\n" "DATASET" "TYPE" "PID" "SCRIPT" "ACQUIRED"
    printf "%-40s %-6s %-8s %-20s %s\n" "-------" "----" "---" "------" "--------"

    for lockfile in "$ZFSLOCK_LOCKS_DIR"/*.lock ; do
        [[ -f "$lockfile" ]] || continue

        local dataset type pid script acquired

        dataset=$(_zfslock_read_field "$lockfile" "dataset")
        type=$(_zfslock_read_field "$lockfile" "type")
        pid=$(_zfslock_read_field "$lockfile" "pid")
        script=$(_zfslock_read_field "$lockfile" "script")
        acquired=$(_zfslock_read_field "$lockfile" "acquired")

        # Apply filter if specified
        if [[ -n "$filter" && "$dataset" != *"$filter"* ]]; then
            continue
        fi

        local type_name
        case "$type" in
            r) type_name="read" ;;
            w) type_name="write" ;;
            x) type_name="destroy" ;;
            *) type_name="$type" ;;
        esac

        # Format timestamp for display
        local display_time
        display_time=$(date -d "$acquired" "+%Y-%m-%d %H:%M" 2>/dev/null) ||
            display_time="$acquired"

        printf "%-40s %-6s %-8s %-20s %s\n" "$dataset" "$type_name" "$pid" "$script" "$display_time"
        ((found++))
    done

    if [[ $found -eq 0 ]]; then
        log_msg "INFO: No active locks found."
    else
        log_msg "INFO: $found active lock(s)"
    fi

    return 0
}

# Check lock status for a dataset
cmd_status() {
    local dataset="$1"

    if [[ -z "$dataset" ]]; then
        log_msg "WARN: Dataset required."
        log_msg "INFO: Usage: zfslockctl status <dataset>"
        return 1
    fi

    # Clean up stale locks first
    zfslock_cleanup_stale 2>/dev/null

    local lockfile
    lockfile=$(_zfslock_file "$dataset")

    if [[ -f "$lockfile" ]]; then
        local type pid script acquired description
        local relative_time

        type=$(_zfslock_read_field "$lockfile" "type")
        pid=$(_zfslock_read_field "$lockfile" "pid")
        script=$(_zfslock_read_field "$lockfile" "script")
        acquired=$(_zfslock_read_field "$lockfile" "acquired")
        description=$(_zfslock_read_field "$lockfile" "description")
        relative_time=$(_zfslock_relative_time "$acquired")

        local type_name
        case "$type" in
            r) type_name="read" ;;
            w) type_name="write" ;;
            x) type_name="destroy" ;;
            *) type_name="$type" ;;
        esac

        log_msg "INFO: Dataset '$dataset' is LOCKED"
        log_msg "INFO:   Type: $type_name"
        log_msg "INFO:   PID: $pid"
        log_msg "INFO:   Script: $script"
        log_msg "INFO:   Acquired: $acquired ($relative_time)"
        if [[ -n "$description" ]]; then
            log_msg "INFO:   Description: $description"
        fi
        log_msg "INFO:   Lock file: $lockfile"

        # Check hierarchy conflicts
        echo ""
        log_msg "INFO: Checking for related locks..."

        # Check ancestors
        local parent="$dataset"
        local ancestor_locks=0
        while [[ "$parent" == */* ]]; do
            parent="${parent%/*}"
            local parent_lock
            parent_lock=$(_zfslock_file "$parent")
            if [[ -f "$parent_lock" ]]; then
                local p_type
                p_type=$(_zfslock_read_field "$parent_lock" "type")
                local p_script
                p_script=$(_zfslock_read_field "$parent_lock" "script")
                log_msg "INFO:   Ancestor lock: $parent (type=$p_type, script=$p_script)"
                ((ancestor_locks++))
            fi
        done

        # Check descendants
        local dataset_encoded
        dataset_encoded=$(_zfslock_encode "$dataset")
        local descendant_locks=0
        for desc_lock in "$ZFSLOCK_LOCKS_DIR"/"${dataset_encoded}%2F"*.lock ; do
            [[ -f "$desc_lock" ]] || continue
            local d_dataset
            d_dataset=$(_zfslock_read_field "$desc_lock" "dataset")
            local d_type
            d_type=$(_zfslock_read_field "$desc_lock" "type")
            local d_script
            d_script=$(_zfslock_read_field "$desc_lock" "script")
            log_msg "INFO:   Descendant lock: $d_dataset (type=$d_type, script=$d_script)"
            ((descendant_locks++))
        done

        if [[ $ancestor_locks -eq 0 && $descendant_locks -eq 0 ]]; then
            log_msg "INFO:   No related locks found."
        fi

        return 1  # Return 1 to indicate locked
    else
        log_msg "INFO: Dataset '$dataset' is not locked"

        # Check if any lock would conflict
        echo ""
        log_msg "INFO: Conflict check:"
        for check_type in r w x; do
            if zfslock_check "$dataset" "$check_type" 2>/dev/null; then
                log_msg "INFO:   Type '$check_type': available"
            else
                local conflict_dataset
                conflict_dataset=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "dataset")
                local conflict_type
                conflict_type=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "type")
                log_msg "INFO:   Type '$check_type': BLOCKED by $conflict_dataset ($conflict_type)"
            fi
        done

        return 0  # Return 0 to indicate not locked
    fi
}

# Force release a lock
cmd_release() {
    local target="$1"

    if [[ -z "$target" ]]; then
        log_msg "WARN: Lock ID or dataset required."
        log_msg "INFO: Usage: zfslockctl release <lock_id|dataset>"
        return 1
    fi

    local lockfile

    # Check if target is a lock file path or a dataset name
    if [[ -f "$target" ]]; then
        lockfile="$target"
    else
        # Assume it's a dataset name
        lockfile=$(_zfslock_file "$target")
    fi

    if [[ ! -f "$lockfile" ]]; then
        log_msg "INFO: No lock found for '$target'"
        return 0
    fi

    # Show lock info before releasing
    local dataset pid script acquired
    dataset=$(_zfslock_read_field "$lockfile" "dataset")
    pid=$(_zfslock_read_field "$lockfile" "pid")
    script=$(_zfslock_read_field "$lockfile" "script")
    acquired=$(_zfslock_read_field "$lockfile" "acquired")

    log_msg "INFO: About to force-release lock:"
    log_msg "INFO:   Dataset: $dataset"
    log_msg "INFO:   PID: $pid"
    log_msg "INFO:   Script: $script"
    log_msg "INFO:   Acquired: $acquired"
    log_msg "WARN: Force-releasing a lock held by an active process may cause data corruption!"

    # Check if the process is still running
    if kill -0 "$pid" 2>/dev/null; then
        log_msg "WARN: PID $pid is still running!"
    else
        log_msg "INFO: PID $pid is no longer running (safe to release)"
    fi

    read -rp "Are you sure you want to release this lock? [y/N]: " confirm

    if [[ "${confirm,,}" == "y" ]]; then
        rm -f "$lockfile"

        # Also remove from PID tracking if exists
        local pidfile="$ZFSLOCK_PIDS_DIR/$pid"
        if [[ -f "$pidfile" ]]; then
            local temp
            temp=$(grep -v "^${lockfile}$" "$pidfile" 2>/dev/null)
            if [[ -n "$temp" ]]; then
                echo "$temp" > "$pidfile"
            else
                rm -f "$pidfile"
            fi
        fi

        log_msg "INFO: Lock released."
        log_msg "WARN: Force-released lock on $dataset (was held by $script PID $pid)"
        return 0
    else
        log_msg "INFO: Release cancelled."
        return 1
    fi
}

# Remove stale locks
cmd_cleanup() {
    log_msg "INFO: Scanning for stale locks..."

    local lockfile
    local removed=0
    local active=0

    if [[ ! -d "$ZFSLOCK_LOCKS_DIR" ]]; then
        log_msg "INFO: No locks directory found."
        return 0
    fi

    for lockfile in "$ZFSLOCK_LOCKS_DIR"/*.lock ; do
        [[ -f "$lockfile" ]] || continue

        local dataset pid script
        dataset=$(_zfslock_read_field "$lockfile" "dataset")
        pid=$(_zfslock_read_field "$lockfile" "pid")
        script=$(_zfslock_read_field "$lockfile" "script")

        if zfslock_is_stale "$lockfile"; then
            log_msg "INFO:   Removing stale lock: $dataset (was $script PID $pid)"
            rm -f "$lockfile"
            ((removed++))
        else
            ((active++))
        fi
    done

    # Clean up stale PID files
    local pidfile
    local pid_removed=0
    for pidfile in "$ZFSLOCK_PIDS_DIR"/* ; do
        [[ -f "$pidfile" ]] || continue

        local pid
        pid=$(basename "$pidfile")
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pidfile"
            ((pid_removed++))
        fi
    done

    log_msg "INFO: Cleanup complete:"
    log_msg "INFO:   Stale locks removed: $removed"
    log_msg "INFO:   Active locks: $active"
    if [[ $pid_removed -gt 0 ]]; then
        log_msg "INFO:   Stale PID files removed: $pid_removed"
    fi

    return 0
}

# Wait for lock availability
cmd_wait() {
    local dataset="$1"
    local type="$2"

    if [[ -z "$dataset" || -z "$type" ]]; then
        log_msg "WARN: Dataset and type required."
        log_msg "INFO: Usage: zfslockctl wait <dataset> <type>"
        log_msg "INFO: Types: r (read), w (write), x (destroy)"
        return 1
    fi

    # Regex: ^[rwx]$
    # Purpose: Validate that the lock type is one of the allowed single-letter codes.
    # Examples: "r" -> match; "w" -> match; "x" -> match; "rw" -> no match
    if [[ ! "$type" =~ ^[rwx]$ ]]; then
        log_msg "WARN: Invalid lock type '$type'. Must be r, w, or x."
        return 1
    fi

    log_msg "INFO: Waiting for lock availability on '$dataset' (type=$type)..."
    log_msg "INFO: Press Ctrl+C to cancel."

    local attempts=0
    local _wait_interval="${ZFSLOCK_WAIT_INTERVAL:-30}"
    [[ "$_wait_interval" =~ ^[0-9]+$ && $_wait_interval -ge 1 ]] || _wait_interval=1

    while true; do
        ((attempts++))

        if zfslock_check "$dataset" "$type"; then
            log_msg "INFO: Lock is now available! (after $attempts attempt(s))"
            return 0
        fi

        local conflict_dataset
        conflict_dataset=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "dataset")
        local conflict_type
        conflict_type=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "type")
        local conflict_script
        conflict_script=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "script")
        local conflict_pid
        conflict_pid=$(_zfslock_read_field "$ZFSLOCK_CONFLICT_INFO" "pid")

        log_msg "INFO: [$attempts] Blocked by: $conflict_dataset ($conflict_type) -" \
            "$conflict_script (PID $conflict_pid)"
        log_msg "INFO:     Retrying in $_wait_interval seconds..."

        sleep "$_wait_interval"
    done
}

# Show help
cmd_help() {
    log_msg "INFO: zfslockctl - CLI tool for managing ZFS dataset locks"
    log_msg "INFO:"
    log_msg "INFO: Usage:"
    log_msg "INFO:   zfslockctl <command> [arguments]"
    log_msg "INFO:"
    log_msg "INFO: Commands:"
    log_msg "INFO:   list [dataset]        List active locks. Optionally filter by dataset" \
        "substring."
    log_msg "INFO:"
    log_msg "INFO:   status <dataset>      Check lock status for a specific dataset. Shows lock" \
        "details"
    log_msg "INFO:                         and any related ancestor/descendant locks."
    log_msg "INFO:"
    log_msg "INFO:   release <target>      Force release a lock. Target can be a lock file path or"
    log_msg "INFO:                         dataset name. WARNING: May cause data corruption if the"
    log_msg "INFO:                         holding process is still active."
    log_msg "INFO:"
    log_msg "INFO:   cleanup               Scan for and remove stale locks (locks held by processes"
    log_msg "INFO:                         that no longer exist)."
    log_msg "INFO:"
    log_msg "INFO:   wait <dataset> <type> Wait until a lock can be acquired on the dataset."
    log_msg "INFO:                         Types: r (read), w (write), x (destroy)"
    log_msg "INFO:"
    log_msg "INFO:   help                  Show this help message."
    log_msg "INFO:"
    log_msg "INFO: Lock Types:"
    log_msg "INFO:   r - Shared Read       For reading metadata, listing. Conflicts with w, x."
    log_msg "INFO:   w - Exclusive Write   For creating/modifying snapshots. Conflicts with r, w," \
        "x."
    log_msg "INFO:   x - Exclusive Destroy For destroying datasets/snapshots. Conflicts with all."
    log_msg "INFO:"
    log_msg "INFO: Examples:"
    log_msg "INFO:   zfslockctl list                       # List all locks"
    log_msg "INFO:   zfslockctl list threeamigos           # List locks on threeamigos pool"
    log_msg "INFO:   zfslockctl status pool/dataset        # Check if dataset is locked"
    log_msg "INFO:   zfslockctl cleanup                    # Remove stale locks"
    log_msg "INFO:   zfslockctl wait pool/dataset w        # Wait for write lock availability"
    log_msg "INFO:   zfslockctl release pool/dataset       # Force release lock on dataset"
    log_msg "INFO:"
    log_msg "INFO: Lock Storage:"
    log_msg "INFO:   Locks are stored in /run/lock/zfsutilities/.locks/ and are automatically" \
        "cleared on reboot."
}

# ==============================================================================
# Main Entry Point
# ==============================================================================

main() {
    local command="$1"
    shift

    case "$command" in
        list)
            cmd_list "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        release)
            cmd_release "$@"
            ;;
        cleanup)
            cmd_cleanup "$@"
            ;;
        wait)
            cmd_wait "$@"
            ;;
        help|--help|-h|"")
            cmd_help
            ;;
        *)
            log_msg "WARN: Unknown command: $command"
            log_msg "INFO: Run 'zfslockctl help' for usage."
            return 1
            ;;
    esac
}

main "$@"
