#!/usr/bin/bash
# safe-iscsi-save
# Save iSCSI target configuration ONLY if no still-expected LUN mapping would
# be lost.
#
# Two gates protect saveconfig.json from being overwritten with a degraded
# (partial) config, e.g. when zvols are temporarily inaccessible (encryption
# keys not yet loaded, ZFS pool not imported, device nodes not yet visible):
#   1. A fast manifest-count check (active backstores vs expected backstores).
#   2. The authoritative mapping gate: the live config is staged to a temp
#      file and every TPG LUN mapping and ACL MappedLUN in the saved config
#      whose backstore the manifest still expects must survive. A mapping may
#      disappear only when its backstore left the manifest (the intentional-
#      change authority remove-vm-disk / move-vm-disk / archive maintain).
#      Counting alone passes the degraded shape where every backstore is
#      defined but few are mapped.
#
# Also generates saveconfig-boot.json — a copy of the config with encrypted backstores
# stripped out. This is used at boot time (via the boot-config.conf systemd drop-in) so
# that targetctl restore does not encounter missing device nodes for encrypted zvols
# whose keys haven't been loaded yet.
#
# IMPORTANT: Expected LUN count is derived from the authoritative manifest file,
# NOT from saveconfig.json or ZFS. This prevents a corrupted config from becoming
# the "expected" baseline.
#
# Manifest file: /etc/rtslib-fb-target/expected-backstores.txt
# Format: one backstore name per line (vm-<vmid>-disk-<N>)
# Maintained by: new-vm-disk (adds), remove-vm-disk (removes), zfsdelfs (removes),
#                zfs-send-receive rebuild (re-adds), move-vm-disk (source removes / dest adds)
#
# Usage: safe-iscsi-save
# Returns: 0 if config was saved, 1 if save was skipped (degraded state)
#
# Install to: /usr/local/lib/zfsutilities/bin/safe-iscsi-save on the storage host

set -euo pipefail

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck
rootcheck

savefile="/etc/rtslib-fb-target/saveconfig.json"
bootfile="/etc/rtslib-fb-target/saveconfig-boot.json"
manifest="/etc/rtslib-fb-target/expected-backstores.txt"
encrypted_conf="${ZFSUTILITIES_SYSTEM_CONFIG_DIR:-/etc/zfsutilities}/iscsi-encrypted-luns.conf"
if [[ ! -e "$encrypted_conf" && -f "/etc/iscsi-encrypted-luns.conf" ]]; then
    encrypted_conf="/etc/iscsi-encrypted-luns.conf"
fi

# Generate saveconfig-boot.json by stripping encrypted backstores from saveconfig.json.
# This config is safe to restore at boot when encryption keys haven't been loaded.
# Regenerate expected-backstores.txt from the currently loaded backstores.
# This keeps the manifest authoritative and prevents stale entries after
# LUNs are moved between VMs or after repair-iscsi-luns adds missing LUNs.
regenerate_expected_backstores_manifest() {
    local tmpfile
    tmpfile=$(mktemp)

    {
        echo "# Expected iSCSI backstores - authoritative manifest"
        echo "# Format: one backstore name per line (vm-<vmid>-disk-<N>)"
        echo "# Updated: $(date -Iseconds)"
        echo "# Source: Generated by safe-iscsi-save from current targetcli state"
        echo ""
        # Extract backstore names (vm-<vmid>-disk-<N>) with fixed-string awk
        # index() tests — no regex literals. Fields starting with "vm-" and
        # containing "-disk-" are the backstore name column of targetcli ls.
        targetcli /backstores/block ls 2>/dev/null \
            | awk '{ for (i = 1; i <= NF; i++) \
                if (index($i, "vm-") == 1 && index($i, "-disk-")) print $i }' \
            | sort -V \
            | uniq
    } > "$tmpfile"

    if [[ -s "$tmpfile" ]]; then
        if ! mv -f "$tmpfile" "$manifest"; then
            rm -f "$tmpfile"
            log_msg "FATAL: safe-iscsi-save: Could not install regenerated manifest at $manifest"
            exit 1
        fi
        log_msg "INFO: ✓ Regenerated expected-backstores manifest"
    else
        rm -f "$tmpfile"
        log_msg "WARN: Could not regenerate expected-backstores manifest (no backstores found)"
    fi
}

generate_boot_config() {
    if [[ ! -f "$encrypted_conf" ]]; then
        cp -f "$savefile" "$bootfile"
        return
    fi

    # Read encrypted backstore names from conf (skip comments and blank lines)
    local csv=""
    local count=0
    while IFS=: read -r name _dev _tgt; do
        [[ -z "$name" || "$name" == \#* ]] && continue
        [[ -n "$csv" ]] && csv+=",$name" || csv="$name"
        count=$((count + 1))
    done < "$encrypted_conf"

    if [[ -z "$csv" ]]; then
        cp -f "$savefile" "$bootfile"
        return
    fi

    if skip_names="$csv" python3 - "$savefile" "$bootfile" << 'PYEOF'
import json, os, sys

skip = set(os.environ["skip_names"].split(","))
src, dst = sys.argv[1], sys.argv[2]

with open(src) as f:
    config = json.load(f)

# Remove encrypted storage objects
config["storage_objects"] = [
    so for so in config.get("storage_objects", [])
    if so.get("name") not in skip
]

# Remove LUN references to encrypted backstores from all targets, and the
# ACL MappedLUNs referencing the stripped LUN indexes: targetctl restore
# warns about MappedLUNs whose TPG LUN no longer exists ("Could not find
# matching TPG LUN"), so the boot config must stay internally consistent.
for target in config.get("targets", []):
    for tpg in target.get("tpgs", []):
        tpg["luns"] = [
            lun for lun in tpg.get("luns", [])
            if not any(n in lun.get("storage_object", "") for n in skip)
        ]
        kept_indexes = {lun.get("index") for lun in tpg["luns"]}
        for acl in tpg.get("acls", []):
            acl["mapped_luns"] = [
                ml for ml in acl.get("mapped_luns", [])
                if ml.get("tpg_lun") in kept_indexes
            ]

with open(dst, "w") as f:
    json.dump(config, f, indent=2)
PYEOF
    then
        log_msg "INFO: ✓ Boot config generated ($count encrypted backstores excluded)"
    else
        log_msg "WARN: Failed to generate boot config"
    fi
}

# Authoritative mapping gate: compare the currently saved config ($1) with
# the staged live config ($2) under the expected-backstores manifest ($3).
# Every TPG LUN mapping and every ACL MappedLUN whose backstore the manifest
# still expects must survive the save; any loss is refused BEFORE anything is
# written. A mapping may disappear only when its backstore left the manifest
# (the intentional-change authority remove-vm-disk / move-vm-disk / archive
# maintain) — and such a permitted loss still draws a WARN when the backstore's
# zvol survives, the stale-manifest signal. Detail FATAL/WARN lines are printed
# by the embedded python (the report_state_drift precedent); returns 1 when
# the save must be refused.
verify_no_expected_lun_loss() {
    python3 - "$1" "$2" "$3" << 'PYEOF'
import json, os, sys

def load(path):
    with open(path) as f:
        return json.load(f)

def valid_bs_name(name):
    # vm-<vmid>-disk-<N>: the same fixed-string shape the bash gates enforce
    if not name.startswith("vm-") or "-disk-" not in name:
        return False
    mid, _, end = name[3:].partition("-disk-")
    return mid.isdigit() and end.isdigit() and "-disk-" not in end

def manifest_expected(path):
    if not os.path.isfile(path):
        return None
    expected = set()
    with open(path) as f:
        for line in f:
            name = line.strip()
            if valid_bs_name(name):
                expected.add(name)
    return expected

def lun_mappings(cfg):
    # (target wwn, lun index) -> backstore name
    out = {}
    for target in cfg.get("targets", []):
        wwn = target.get("wwn", "")
        for tpg in target.get("tpgs", []):
            for lun in tpg.get("luns", []):
                idx = lun.get("index")
                so = lun.get("storage_object", "")
                if isinstance(idx, int) and so:
                    out[(wwn, idx)] = so.rsplit("/", 1)[-1]
    return out

def acl_grants(cfg):
    # (target wwn, initiator, tpg lun index) grants
    out = set()
    for target in cfg.get("targets", []):
        wwn = target.get("wwn", "")
        for tpg in target.get("tpgs", []):
            for acl in tpg.get("acls", []):
                init = acl.get("node_wwn", "")
                for ml in acl.get("mapped_luns", []):
                    tpg_lun = ml.get("tpg_lun")
                    if init and isinstance(tpg_lun, int):
                        out.add((wwn, init, tpg_lun))
    return out

try:
    old = load(sys.argv[1])
    new = load(sys.argv[2])
except Exception as exc:
    print("FATAL: safe-iscsi-save: could not parse the saved or staged config (%s)" % exc)
    sys.exit(1)
expected = manifest_expected(sys.argv[3])

old_map = lun_mappings(old)
new_map = lun_mappings(new)

mapping_losses = []
permitted = []
for (wwn, idx), bs in sorted(old_map.items()):
    if new_map.get((wwn, idx)) == bs:
        continue
    if expected is None or bs in expected:
        mapping_losses.append((wwn, idx, bs))
    else:
        permitted.append((wwn, idx, bs))

grant_losses = []
for wwn, init, tpg_lun in sorted(acl_grants(old) - acl_grants(new)):
    bs = old_map.get((wwn, tpg_lun))
    if bs is None:
        continue
    if expected is None or bs in expected:
        grant_losses.append((wwn, init, tpg_lun, bs))

for wwn, idx, bs in mapping_losses:
    print("FATAL:   target %s LUN %d -> %s would be lost while still expected"
          % (wwn, idx, bs))
for wwn, init, tpg_lun, bs in grant_losses:
    print("FATAL:   ACL %s MappedLUN %d on %s (%s) would be lost while still expected"
          % (init, tpg_lun, wwn, bs))

if mapping_losses or grant_losses:
    if mapping_losses:
        lost = "%d LUN mapping(s)" % len(mapping_losses)
        if grant_losses:
            lost += " (and %d ACL MappedLUN grant(s))" % len(grant_losses)
    else:
        lost = "%d ACL MappedLUN grant(s)" % len(grant_losses)
    print("FATAL: safe-iscsi-save: refusing to save — %s would be lost while"
          " still expected; config untouched." % lost)
    print("FATAL:   Resolve the degradation, or force with: targetcli saveconfig")
    sys.exit(1)

# Permitted losses (backstore left the manifest — intentional removal) still
# draw a WARN when the zvol survives: the removal flows destroy the zvol
# before saving, so an existing device means the manifest line left early.
devs = {so.get("name"): so.get("dev")
        for so in old.get("storage_objects", []) if so.get("name")}
for wwn, idx, bs in permitted:
    dev = devs.get(bs)
    if dev and os.path.exists(dev):
        print("WARN: %s: manifest no longer expects it but zvol %s still exists —"
              " the manifest may be stale" % (bs, dev))
sys.exit(0)
PYEOF
}

[[ -f "$savefile" ]] || {
    log_msg "FATAL: safe-iscsi-save: Config not found: $savefile"
    exit 1
}

[[ -f "$manifest" ]] || {
    log_msg "FATAL: safe-iscsi-save: Manifest not found: $manifest"
    log_msg "FATAL:   Create it with one backstore name per line (vm-N-disk-N format)."
    exit 1
}

# Count expected backstores from manifest (ignore comments and blank lines).
# Each valid entry is exactly vm-<vmid>-disk-<N>; validated with a glob shape
# test plus fixed-string digit checks on the numeric parts (no regex).
expected=0
while IFS= read -r _manifest_entry; do
    [[ "$_manifest_entry" == vm-*-disk-* ]] || continue
    _entry_mid="${_manifest_entry#vm-}"; _entry_mid="${_entry_mid%%-disk-*}"
    _entry_end="${_manifest_entry##*-disk-}"
    if [[ -n "$_entry_mid" && "$_entry_mid" != *[!0-9]* \
            && -n "$_entry_end" && "${_entry_end}" != *[!0-9]* \
            && "${_manifest_entry#*-disk-}" != *-disk-* ]]; then
        expected=$((expected + 1))
    fi
done < "$manifest"

# Count active block backstores — each /dev/zvol/ path = one accessible backstore.
# grep -c returns 1 when there are no matches, so we must NOT append a fallback
# "0" with || or the result becomes a two-line string that breaks arithmetic.
if ! active=$(targetcli /backstores/block ls 2>/dev/null | grep -c '/dev/zvol/'); then
    active=0
fi

if [[ "${expected:-0}" -eq 0 ]]; then
    # An empty manifest is legitimate only when no block backstore is
    # active either — the last VM disk was just removed and the persisted
    # config must move to the target-only state. Backstores active with
    # an empty manifest means the manifest is broken: refuse so the save
    # cannot drop live LUNs from the config.
    if [[ "$active" -eq 0 ]]; then
        log_msg "INFO: safe-iscsi-save: manifest empty and no block backstores" \
            "active — saving the target-only config"
    else
        log_msg "FATAL: safe-iscsi-save: Manifest is empty or has no valid entries"
        log_msg "FATAL:   File: $manifest"
        log_msg "FATAL:   ${active} block backstore(s) are active — the manifest is broken."
        exit 1
    fi
fi

if [[ "$active" -lt "$expected" ]]; then
    log_msg "FATAL: safe-iscsi-save: iSCSI target is degraded ($active of $expected LUNs active)"
    log_msg "FATAL:   Some backstores in manifest are not active."
    log_msg "FATAL:   saveconfig.json NOT overwritten. To force save: targetcli saveconfig"
    exit 1
fi

# Additional check: active should not greatly exceed expected (catches orphaned backstores)
if [[ "$active" -gt "$expected" ]]; then
    log_msg "WARN: safe-iscsi-save: More backstores ($active) than manifest ($expected)"
    log_msg "WARN:   This may indicate orphaned backstores or manifest out of date. Saving anyway."
fi

# Stage the live config to a temp file next to the destination and prove it
# loses no still-expected LUN mapping before anything is written. Counting
# backstores alone passes the boot-incident shape (every backstore defined,
# few mapped), so the staged config is compared mapping-by-mapping against
# the saved one under the manifest's authority.
saveconfig_tmp=$(mktemp "${savefile}.tmp.XXXXXX") || {
    log_msg "FATAL: safe-iscsi-save: Could not stage a temp config next to ${savefile}"
    exit 1
}
if ! targetcli saveconfig "$saveconfig_tmp" >/dev/null 2>&1; then
    rm -f "$saveconfig_tmp"
    log_msg "FATAL: safe-iscsi-save: targetcli saveconfig failed — config untouched"
    exit 1
fi
if ! verify_no_expected_lun_loss "$savefile" "$saveconfig_tmp" "$manifest"; then
    rm -f "$saveconfig_tmp"
    exit 1
fi
# Atomic same-directory rename: a reader never sees a partial config, and a
# refusal above leaves the saved config byte-identical.
mv -f -- "$saveconfig_tmp" "$savefile"
log_msg "INFO: ✓ iSCSI configuration saved ($active/$expected LUNs active)"

generate_boot_config

# Keep the authoritative manifest in sync with the just-saved config so that
# future runs compare against the true current state.
regenerate_expected_backstores_manifest

# Record the pool-resident LUN map (bare-metal restore resilience): the map
# on every online pool stays as fresh as the last LUN change. Best-effort —
# an export failure must never fail the save itself.
# Callers that manage the map refresh themselves (reconcile-iscsi-state)
# set SAFE_ISCSI_SAVE_SKIP_EXPORT_ISCSI_STATE=1: after a partial reconcile,
# refreshing here would overwrite the pool map and drop entries whose zvols
# are still missing, destroying the recovery authority.
export_iscsi_state="${SAFE_ISCSI_SAVE_EXPORT_ISCSI_STATE:-$mydir/export-iscsi-state}"
if [[ "${SAFE_ISCSI_SAVE_SKIP_EXPORT_ISCSI_STATE:-}" == "1" ]]; then
    log_msg "INFO: ✓ Pool LUN map refresh suppressed by caller"
elif type -t "$export_iscsi_state" >/dev/null 2>&1; then
    if "$export_iscsi_state"; then
        log_msg "INFO: ✓ Pool LUN map refreshed"
    else
        log_msg "WARN: export-iscsi-state failed — pool LUN map not refreshed"
    fi
else
    log_msg "WARN: export-iscsi-state not available at ${export_iscsi_state} —" \
        "pool LUN map not refreshed"
fi
