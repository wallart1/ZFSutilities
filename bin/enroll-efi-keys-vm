#!/usr/bin/bash
# enroll-efi-keys-vm <vmid>
# Re-initializes a VM's EFI vars disk with the Microsoft UEFI CA 2023
# certificates.
#
# Grows the backing EFI zvol to 4M if needed, rewrites the EFI vars disk from
# OVMF_VARS_4M.ms.fd, and updates the Proxmox VM config with size=4M and
# ms-cert=2023k.
#
# Run from the compute node (or from the storage node in two-node mode; it
# will delegate via SSH to the compute node).
#
# The VM must be stopped. The script will gracefully shut it down and wait if
# it is running.

_local_bashinit=$(dirname "$(realpath "${BASH_SOURCE[0]}")")/bashinit
if [[ -f "$_local_bashinit" ]]; then
    source "$_local_bashinit"
else
    source ~/bashinit
fi
bashinit
unset _local_bashinit

NODE_LIB="${NODE_LIB:-$(find_zfsutility_script node-lib.sh)}"
source "$NODE_LIB"
source_helper rootcheck

rootcheck

if ! command -v qm >/dev/null 2>&1; then
    log_msg "FATAL: This script requires Proxmox VE (qm command not found)."
    log_msg "FATAL:   On a single node without Proxmox there are no VMs to manage."
    log_msg "FATAL:   Non-Proxmox hypervisors are not supported."
    exit 1
fi

my_host=$(hostname -s)
pve_conf_dir="/etc/pve/qemu-server"

usage() {
    log_msg "INFO: Usage: enroll-efi-keys-vm <vmid>"
    log_msg "INFO:"
    log_msg "INFO:   vmid   Proxmox VM ID whose EFI disk should be enrolled"
    log_msg "INFO:"
    log_msg "INFO: Example: enroll-efi-keys-vm 209"
    exit 1
}

[[ $# -eq 1 ]] || usage

vmid="$1"
[[ "$vmid" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: vmid must be a number, got: $vmid"
    exit 1
}

# In two-node mode, run on the compute host.
if is_two_node && [[ "$my_host" != "$compute_host" ]]; then
    remote_script=$(remote_zfsutility_script "$compute_host" "enroll-efi-keys-vm")
    exec ssh root@"$compute_host" "$remote_script '$vmid'"
fi

conf="$pve_conf_dir/${vmid}.conf"
[[ -f "$conf" ]] || {
    log_msg "FATAL: VM config not found: $conf"
    exit 1
}

# --- Ensure VM is stopped ---
vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
if [[ "$vm_status" == "running" ]]; then
    log_msg "INFO: VM $vmid is running. Shutting down gracefully..."
    qm shutdown "$vmid" >/dev/null 2>&1 || true
    for _ in $(seq 1 120); do
        vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
        [[ "$vm_status" != "running" ]] && break
        sleep 1
    done
    vm_status=$(qm status "$vmid" 2>/dev/null | awk '{print $2}')
    [[ "$vm_status" != "running" ]] || {
        log_msg "FATAL: VM $vmid did not shut down in time"
        exit 1
    }
    log_msg "INFO: ✓ VM $vmid is stopped"
fi

# --- Parse efidisk0 line ---
# Helper: read conf file, echo "by_path size has_ms_cert".
parse_efidisk_line() {
    local conf_file="$1"
    local line by_path size has_ms_cert
    line=$(grep '^efidisk0:' "$conf_file" 2>/dev/null | head -1)
    [[ -n "$line" ]] || { echo ""; return 1; }

    # Volume identifier is the first field after the colon.
    by_path=$(echo "$line" | cut -d: -f2- | cut -d, -f1 | tr -d ' ')
    # Size value: text between the first "size=" and the next comma.
    size=""
    if [[ "$line" == *size=* ]]; then
        size="${line#*size=}"
        size="${size%%,*}"
    fi

    has_ms_cert=no
    if echo "$line" | grep -q 'ms-cert=2023k'; then
        has_ms_cert=yes
    fi

    echo "$by_path $size $has_ms_cert"
}

# Extract iSCSI target and LUN from a compute-node /dev/disk/by-path symlink.
# The kernel by-path name contains colons (IPv4 portal, IQN target); the
# portal is "ip-<IPv4>:<port>" and the target is everything between
# "-iscsi-" and the final "-lun-<n>" segment.
# Echoes "<target> <lun>" and returns 0 on success, 1 otherwise.
parse_iscsi_by_path() {
    local path="$1"
    local portal target lun
    # Expected shape: /dev/disk/by-path/ip-<IPv4>:<port>-iscsi-<target>-lun-<n>
    [[ "$path" == /dev/disk/by-path/ip-*-iscsi-*-lun-* ]] || return 1
    portal="${path#/dev/disk/by-path/ip-}"
    portal="${portal%%-iscsi-*}"
    # Portal host must be dotted decimal digits; port must be digits.
    target="${portal%:*}"
    lun="${portal##*:}"
    [[ -n "$target" && "$target" != *[!0-9.]* && "$target" == *.* \
        && "$lun" =~ ^[0-9]+$ ]] || return 1
    target="${path#*-iscsi-}"
    target="${target%-lun-*}"
    lun="${path##*-lun-}"
    [[ -n "$target" && "$lun" =~ ^[0-9]+$ ]] || return 1
    printf '%s %s\n' "$target" "$lun"
    return 0
}

parsed=$(parse_efidisk_line "$conf")
[[ -n "$parsed" ]] || {
    log_msg "FATAL: VM $vmid has no efidisk0 entry"
    exit 1
}
read -r by_path current_size has_ms_cert <<< "$parsed"

[[ -n "$by_path" ]] || {
    log_msg "FATAL: Could not extract efidisk0 volume ID"
    exit 1
}
[[ -n "$current_size" ]] || {
    log_msg "FATAL: Could not extract efidisk0 size"
    exit 1
}

# --- Resolve backing zvol ---
if [[ "$by_path" == /dev/disk/by-path/* ]]; then
    resolved=$(parse_iscsi_by_path "$by_path") || {
        log_msg "FATAL: Could not parse iSCSI by-path volume ID: $by_path"
        log_msg "FATAL:   (use this script instead of 'qm enroll-efi-keys' for iSCSI EFI disks)"
        exit 1
    }
    read -r target lun <<< "$resolved"

    if is_two_node; then
        log_msg "INFO: Resolving iSCSI LUN $lun in target $target on $storage_host..."
        # Select the LUN line with a fixed-string match, then verify the LUN
        # number is not followed by another digit (lun1 vs lun12), and extract
        # the backstore token that follows "block/" on that line.
        lun_line=$(ssh root@"$storage_host" \
            "targetcli '/iscsi/${target}/tpg1/luns' ls 2>/dev/null \
            | grep -F \"lun${lun}\"" | head -1)
        backstore=""
        if [[ "$lun_line" == *"lun${lun}"* ]]; then
            _efi_after="${lun_line#*"lun${lun}"}"
            if [[ "$_efi_after" != [0-9]* && "$_efi_after" == *block/* ]]; then
                backstore="${_efi_after#*block/}"
                backstore="${backstore%%[[:space:]]*}"
            fi
        fi
        unset _efi_after
        [[ -n "$backstore" ]] || {
            log_msg "FATAL: No iSCSI backstore found for LUN $lun in $target"
            exit 1
        }

        # The backstore line contains "/dev/zvol/<pool>/..."; extract the
        # zvol path with a short match and strip the "zvol/" prefix locally.
        zvol=$(ssh root@"$storage_host" \
            "targetcli /backstores/block ls 2>/dev/null \
            | grep ' ${backstore} ' \
            | grep -oE 'zvol/\\S+' \
            | head -1")
        zvol="${zvol#zvol/}"
        [[ -n "$zvol" ]] || {
            log_msg "FATAL: No zvol found for backstore $backstore"
            exit 1
        }
    else
        log_msg "FATAL: Single-node by-path EFI disk resolution is not supported for: $by_path"
        exit 1
    fi
elif [[ "$by_path" == *":vm-"* ]]; then
    # Proxmox storage reference (single-node only): <storage>:vm-<id>-disk-<n>
    _ref_disk="${by_path#*:}"                 # vm-<id>-disk-<n>
    _ref_vmid="${_ref_disk#vm-}"
    _ref_vmid="${_ref_vmid%-disk-*}"
    _ref_num="${_ref_disk##*-disk-}"
    if [[ -z "${by_path%%:*}" || "$by_path" == *:*:* \
        || ! "$_ref_vmid" =~ ^[0-9]+$ || ! "$_ref_num" =~ ^[0-9]+$ ]]; then
        log_msg "FATAL: Unsupported efidisk0 volume ID format: $by_path"
        log_msg "FATAL:   (for iSCSI by-path EFI disks, use this script instead of" \
            "'qm enroll-efi-keys')"
        exit 1
    fi
    # Find the zvol whose name ends with the vm-<id>-disk-<n> suffix.
    zvol=$(zfs list -H -t volume -o name 2>/dev/null \
        | grep -F "/proxmox/vm-${_ref_vmid}-disk-${_ref_num}" \
        | while IFS= read -r candidate; do
            [[ "$candidate" == *"/proxmox/vm-${_ref_vmid}-disk-${_ref_num}" ]] \
                && { echo "$candidate"; break; }
        done)
    [[ -n "$zvol" ]] || {
        log_msg "FATAL: No zvol found for storage reference: $by_path"
        exit 1
    }
else
    log_msg "FATAL: Unsupported efidisk0 volume ID format: $by_path"
    log_msg "FATAL:   (for iSCSI by-path EFI disks, use this script instead of" \
        "'qm enroll-efi-keys')"
    exit 1
fi

log_msg "INFO:   Backing zvol: $zvol"

# --- Grow zvol to 4M if needed ---
get_zvol_bytes() {
    if is_two_node; then
        ssh root@"$storage_host" "zfs get -Hp -o value volsize '$zvol'"
    else
        zfs get -Hp -o value volsize "$zvol"
    fi
}

current_bytes=$(get_zvol_bytes)
[[ -n "$current_bytes" && "$current_bytes" =~ ^[0-9]+$ ]] || {
    log_msg "FATAL: Could not read zvol size"
    exit 1
}

if [[ "$current_bytes" -lt 4194304 ]]; then
    log_msg "INFO: Growing EFI zvol from ${current_bytes} bytes to 4M..."
    if is_two_node; then
        ssh root@"$storage_host" "zfs set volsize=4M '$zvol'" || {
            log_msg "FATAL: Failed to grow zvol"
            exit 1
        }
    else
        zfs set volsize=4M "$zvol" || {
            log_msg "FATAL: Failed to grow zvol"
            exit 1
        }
    fi
    log_msg "INFO: ✓ Zvol grown to 4M"
else
    log_msg "INFO: EFI zvol is already ${current_bytes} bytes (>= 4M)"
fi

# --- Rescan iSCSI so the compute node sees the new size ---
if is_two_node; then
    log_msg "INFO: Rescanning iSCSI..."
    "$mydir/rescan-storage" || {
        log_msg "FATAL: iSCSI rescan failed"
        exit 1
    }
fi

# --- Wait for device to appear at the new size ---
log_msg "INFO: Waiting for EFI device $by_path at >= 4M..."
device=""
for _ in $(seq 1 20); do
    device=$(readlink -f "$by_path" 2>/dev/null)
    if [[ -b "$device" ]]; then
        dev_size=$(blockdev --getsize64 "$device" 2>/dev/null || echo 0)
        [[ "$dev_size" -ge 4194304 ]] && break
    fi
    sleep 0.5
done

[[ -b "$device" ]] || {
    log_msg "FATAL: EFI device not found: $by_path"
    exit 1
}
dev_size=$(blockdev --getsize64 "$device" 2>/dev/null || echo 0)
[[ "$dev_size" -ge 4194304 ]] || {
    log_msg "FATAL: EFI device size is ${dev_size} bytes, expected >= 4194304"
    exit 1
}
log_msg "INFO: ✓ EFI device ready: $device (${dev_size} bytes)"

# --- Re-initialize EFI vars disk ---
vars_file="/usr/share/pve-edk2-firmware/OVMF_VARS_4M.ms.fd"
[[ -f "$vars_file" ]] || {
    log_msg "FATAL: Firmware file not found: $vars_file"
    exit 1
}

log_msg "INFO: Writing $vars_file to EFI disk..."
dd if="$vars_file" of="$device" bs=1M conv=notrunc status=progress || {
    log_msg "FATAL: Failed to write EFI vars"
    exit 1
}
log_msg "INFO: ✓ EFI disk re-initialized"

# --- Update VM config ---
# Helper: apply ms-cert=2023k and size=4M, drop pending block.
# Rewrites the config with a line loop (no regular expressions):
#   - drop everything from the first "[PENDING]" line to EOF
#   - append ",ms-cert=2023k" to the efidisk0 line when missing
#   - rewrite the first "size=<n><unit>" token on the efidisk0 line to size=4M
#     (only efidisk0 lines are touched, so scsi/sata/virtio data disk
#     sizes are never clobbered)
update_efidisk_config() {
    local conf_file="$1"
    local tmp_file line _pre _num _unit

    tmp_file=$(mktemp) || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Remove any pending change block first.
        [[ "$line" == "[PENDING]" ]] && break
        if [[ "$line" == efidisk0:* ]]; then
            # Ensure ms-cert=2023k is present.
            [[ "$line" == *ms-cert=2023k* ]] || line+=",ms-cert=2023k"
            # Ensure size=4M. Sizes are written as digits (optionally dotted)
            # followed by a single KMGTP unit letter, comma-delimited.
            if [[ "$line" == *size=[0-9]* ]]; then
                _num="${line#*size=}"
                _num="${_num%%[!0-9.]*}"
                _unit="${line#*"size=${_num}"}"
                if [[ "${_unit:0:1}" == [KMGTP] ]]; then
                    _pre="${line%%"size=${_num}${_unit:0:1}"*}"
                    line="${_pre}size=4M${_unit:1}"
                fi
            fi
        fi
        printf '%s\n' "$line"
    done < "$conf_file" > "$tmp_file"
    cat "$tmp_file" > "$conf_file"
    rm -f "$tmp_file"
}

log_msg "INFO: Updating VM $vmid config..."
update_efidisk_config "$conf"
log_msg "INFO: ✓ VM $vmid config updated"
log_msg "INFO: === Done ==="
log_msg "INFO:   VM $vmid is stopped. Start it manually and watch the console."
log_msg "INFO:   The UEFI boot order may have been reset; re-select the boot device"
log_msg "INFO:   in the UEFI firmware setup if the VM drops to a shell."
