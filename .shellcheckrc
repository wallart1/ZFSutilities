# ShellCheck configuration for ZFS Utilities.
# This project uses dynamic sourcing helpers (find_zfsutility_script,
# source_helper) and globals set by sourced libraries (bashinit, node-lib.sh,
# zfsbuildfsarray, etc.).  The rules below are disabled project-wide because
# they are false positives for these intentional patterns.

shell=bash
disable=SC1090,SC1091,SC2015,SC2029,SC2030,SC2031,SC2154,SC2317

# bin/watchall and lib/pace_stream.py are Python utilities; do not run
# ShellCheck on them (watchall via this exclude-path, pace_stream.py by
# the lib/*.sh glob in the documented invocation).
exclude-path=bin/watchall
